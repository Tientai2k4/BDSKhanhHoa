@model BDSKhanhHoa.Models.Banner
@{
    ViewData["Title"] = "Thêm Banner";
    Layout = "_AdminLayout";
}

<style>
    .banner-form-page {
        --bf-primary: #2563eb;
        --bf-dark: #0f172a;
        --bf-muted: #64748b;
        --bf-border: #e2e8f0;
        --bf-soft: #f8fafc;
        padding: 16px;
        overflow-x: hidden;
    }

        .banner-form-page * {
            box-sizing: border-box;
        }

    .banner-shell {
        max-width: 1180px;
        margin: 0 auto;
    }

    .banner-head,
    .banner-panel {
        background: #fff;
        border: 1px solid var(--bf-border);
        border-radius: 20px;
        box-shadow: 0 10px 28px rgba(15,23,42,.055);
    }

    .banner-head {
        padding: 15px 16px;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .banner-title {
        margin: 0;
        color: var(--bf-dark);
        font-size: clamp(1.1rem, 2vw, 1.45rem);
        font-weight: 900;
        letter-spacing: -.03em;
        line-height: 1.2;
    }

    .banner-sub {
        margin: 4px 0 0;
        color: var(--bf-muted);
        font-size: .86rem;
        font-weight: 600;
    }

    .banner-panel {
        padding: 16px;
    }

    .section-box {
        height: 100%;
        background: var(--bf-soft);
        border: 1px solid var(--bf-border);
        border-radius: 18px;
        padding: 15px;
    }

    .section-title {
        color: var(--bf-dark);
        font-weight: 900;
        font-size: .9rem;
        text-transform: uppercase;
        letter-spacing: .045em;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px dashed var(--bf-border);
    }

    .drop-zone {
        min-height: 220px;
        border: 2px dashed #bfdbfe;
        border-radius: 18px;
        background: #eff6ff;
        cursor: pointer;
        display: grid;
        place-items: center;
        text-align: center;
        padding: 22px;
        transition: .2s ease;
    }

        .drop-zone:hover {
            background: #dbeafe;
            border-color: var(--bf-primary);
        }

        .drop-zone i {
            font-size: 2.6rem;
            color: var(--bf-primary);
        }

    .preview-img {
        width: 100%;
        max-height: 320px;
        aspect-ratio: 21 / 9;
        object-fit: cover;
        border-radius: 18px;
        border: 1px solid var(--bf-border);
        background: #fff;
    }

    .banner-form-page .form-label {
        color: #334155;
        font-weight: 850;
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .banner-form-page .form-control {
        min-height: 44px;
        border-radius: 14px;
        border-color: var(--bf-border);
        font-weight: 700;
        box-shadow: none !important;
    }

        .banner-form-page .form-control:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37,99,235,.09) !important;
        }

    .sticky-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px dashed var(--bf-border);
    }

        .sticky-actions .btn {
            min-height: 42px;
            border-radius: 999px;
            font-weight: 850;
            padding-left: 18px;
            padding-right: 18px;
        }

    @@media (max-width: 767.98px) {
        .banner-form-page {
            padding: 10px;
        }

        .banner-head {
            padding: 13px;
            border-radius: 18px;
            display: block;
        }

        .banner-sub {
            display: none;
        }

        .banner-panel {
            padding: 10px;
            border-radius: 18px;
        }

        .section-box {
            padding: 12px;
            border-radius: 16px;
        }

        .drop-zone {
            min-height: 160px;
            padding: 16px;
        }

            .drop-zone i {
                font-size: 2.2rem;
            }

            .drop-zone p {
                font-size: .9rem;
            }

        .preview-img {
            max-height: 210px;
        }

        .sticky-actions {
            position: sticky;
            bottom: 0;
            z-index: 10;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(10px);
            margin-left: -10px;
            margin-right: -10px;
            margin-bottom: -10px;
            padding: 10px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-top: 1px solid var(--bf-border);
        }

            .sticky-actions .btn {
                width: 100%;
                padding-left: 8px;
                padding-right: 8px;
            }
    }
</style>

<div class="banner-form-page">
    <div class="banner-shell">
        <section class="banner-head">
            <div>
                <h5 class="banner-title">
                    <i class="bi bi-cloud-arrow-up text-primary me-2"></i>Thêm Banner Slider
                </h5>
                <p class="banner-sub">Tải ảnh banner và nhập thông tin hiển thị nếu cần.</p>
            </div>
        </section>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <section class="banner-panel">
                <div class="row g-3">
                    <div class="col-lg-7">
                        <div class="section-box">
                            <div class="section-title">Hình ảnh banner</div>

                            <div class="drop-zone" id="dropZone" onclick="document.getElementById('imageInput').click()">
                                <div>
                                    <i class="bi bi-image"></i>
                                    <p class="mt-2 text-muted fw-bold mb-2">Nhấn để chọn ảnh hoặc kéo thả file</p>
                                    <input type="file" name="imageFile" id="imageInput" class="d-none" accept="image/*" required />
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4">Chọn file</button>
                                </div>
                            </div>

                            <div id="previewContainer" class="mt-3 d-none text-center">
                                <img id="imagePreview" src="#" class="preview-img mb-2" alt="Ảnh xem trước">
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill" onclick="resetImage()">
                                    <i class="bi bi-arrow-repeat me-1"></i> Chọn ảnh khác
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="section-box">
                            <div class="section-title">Thông tin phụ</div>

                            <div class="mb-3">
                                <label class="form-label">Tiêu đề chính</label>
                                <input asp-for="Title" class="form-control" placeholder="Ví dụ: Đất nền giá rẻ Diên Khánh" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Link liên kết</label>
                                <input asp-for="LinkURL" class="form-control" placeholder="https://..." />
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label">Thứ tự</label>
                                    <input asp-for="DisplayOrder" class="form-control" type="number" value="0" />
                                </div>

                                <div class="col-6">
                                    <label class="form-label">Trạng thái</label>
                                    <div class="form-check form-switch pt-2">
                                        <input class="form-check-input fs-5" type="checkbox" asp-for="IsActive" checked>
                                        <label class="form-check-label ms-2 fw-bold" for="IsActive">Hiển thị</label>
                                    </div>
                                </div>
                            </div>

                            <div class="sticky-actions">
                                <a asp-action="Index" class="btn btn-light border">Hủy</a>
                                <button type="submit" class="btn btn-primary shadow-sm">
                                    <i class="bi bi-save me-1"></i> Lưu
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const imageInput = document.getElementById('imageInput');
        const imagePreview = document.getElementById('imagePreview');
        const previewContainer = document.getElementById('previewContainer');
        const dropZone = document.getElementById('dropZone');

        imageInput.onchange = function () {
            const [file] = imageInput.files;
            if (file) {
                previewContainer.classList.remove('d-none');
                dropZone.classList.add('d-none');
                imagePreview.src = URL.createObjectURL(file);
            }
        };

        function resetImage() {
            imageInput.value = '';
            previewContainer.classList.add('d-none');
            dropZone.classList.remove('d-none');
            imagePreview.src = '#';
        }
    </script>
}
