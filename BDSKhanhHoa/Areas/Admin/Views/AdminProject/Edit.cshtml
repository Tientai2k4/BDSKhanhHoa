@model BDSKhanhHoa.Models.Project
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Cập nhật Dự án: " + Model.ProjectName;

    var hasMainImage = !string.IsNullOrWhiteSpace(Model.MainImage);
    var hasLegalDocs = !string.IsNullOrWhiteSpace(Model.LegalDocs);

    string mainImageUrl = hasMainImage ? Model.MainImage! : "/images/no-image.jpg";
    string legalDocsUrl = hasLegalDocs ? Model.LegalDocs! : "";
    string legalFileName = hasLegalDocs ? System.IO.Path.GetFileName(Model.LegalDocs) : "";
    string legalExt = hasLegalDocs ? System.IO.Path.GetExtension(Model.LegalDocs).Replace(".", "").ToUpperInvariant() : "";
}

<style>
    .ap-edit-page {
        --ap-primary: #2563eb;
        --ap-warning: #f59e0b;
        --ap-danger: #dc2626;
        --ap-success: #16a34a;
        --ap-dark: #0f172a;
        --ap-muted: #64748b;
        --ap-border: #e2e8f0;
        --ap-soft: #f8fafc;
    }

    .ap-card {
        border: 0;
        border-radius: 24px;
        box-shadow: 0 12px 34px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .ap-card-header {
        padding: 16px 20px;
        border: 0;
    }

    .ap-card-body {
        padding: 24px;
    }

    .ap-label {
        color: #334155;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .ap-required {
        color: var(--ap-danger);
    }

    .ap-input,
    .ap-edit-page .form-control,
    .ap-edit-page .form-select {
        border-radius: 14px;
        border: 1.5px solid var(--ap-border);
        box-shadow: none !important;
        min-height: 46px;
        font-weight: 600;
    }

    .ap-edit-page textarea.form-control {
        min-height: auto;
    }

    .ap-edit-page .form-control:focus,
    .ap-edit-page .form-select:focus {
        border-color: var(--ap-primary);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .12) !important;
    }

    .ap-sticky {
        top: 90px;
        z-index: 100;
    }

    .ap-side-box {
        background: #fff;
        border: 1px solid var(--ap-border);
        border-radius: 22px;
        padding: 16px;
    }

    .ap-side-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--ap-muted);
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        padding-bottom: 12px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--ap-border);
    }

    .ap-current-image {
        width: 100%;
        height: 190px;
        object-fit: cover;
        border-radius: 18px;
        border: 1px solid var(--ap-border);
        background: var(--ap-soft);
        box-shadow: 0 8px 22px rgba(15, 23, 42, .08);
    }

    .ap-file-current {
        border-radius: 20px;
        border: 1.5px solid #fecaca;
        background: linear-gradient(135deg, #fff7ed, #ffffff);
        padding: 15px;
    }

        .ap-file-current.has-file {
            border-color: #bbf7d0;
            background: linear-gradient(135deg, #ecfdf5, #ffffff);
        }

        .ap-file-current.no-file {
            border-color: #fde68a;
            background: linear-gradient(135deg, #fffbeb, #ffffff);
        }

    .ap-file-row {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .ap-file-icon {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 1.35rem;
        color: #fff;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
    }

    .ap-file-current.has-file .ap-file-icon {
        background: linear-gradient(135deg, #16a34a, #059669);
    }

    .ap-file-current.no-file .ap-file-icon {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .ap-file-kicker {
        color: var(--ap-muted);
        font-size: .73rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 4px;
    }

    .ap-file-name {
        color: var(--ap-dark);
        font-weight: 900;
        line-height: 1.35;
        word-break: break-word;
        margin-bottom: 4px;
    }

    .ap-file-note {
        color: var(--ap-muted);
        font-size: .82rem;
        font-weight: 600;
        line-height: 1.45;
        margin: 0;
    }

    .ap-file-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-top: 12px;
    }

        .ap-file-actions .btn {
            border-radius: 14px;
            font-weight: 800;
            min-height: 42px;
        }

    .ap-upload-box {
        margin-top: 14px;
        border-radius: 18px;
        border: 1px dashed #cbd5e1;
        background: #f8fafc;
        padding: 14px;
    }

    .ap-upload-title {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #334155;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .ap-selected-file {
        display: none;
        margin-top: 8px;
        padding: 9px 11px;
        border-radius: 12px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .83rem;
        font-weight: 800;
    }

    .ap-save-btn {
        min-height: 58px;
        border-radius: 18px;
        font-weight: 950;
        letter-spacing: .02em;
    }

    @@media (max-width: 991.98px) {
        .ap-sticky {
            position: static !important;
        }

        .ap-card-body {
            padding: 18px;
        }

        .ap-current-image {
            height: 220px;
        }
    }

    @@media (max-width: 575.98px) {
        .ap-edit-page {
            padding-left: 10px !important;
            padding-right: 10px !important;
        }

        .ap-card {
            border-radius: 18px;
        }

        .ap-card-header {
            padding: 14px 16px;
        }

        .ap-card-body {
            padding: 16px;
        }

        .ap-card-header .d-flex {
            align-items: flex-start !important;
            gap: 12px;
            flex-direction: column;
        }

        .ap-file-row {
            gap: 10px;
        }

        .ap-file-actions {
            grid-template-columns: 1fr;
        }

        .ap-current-image {
            height: 180px;
        }
    }

    /* MOBILE EXTRA COMPACT */
    @@media (max-width: 575.98px) {
        .ap-card {
            box-shadow: 0 6px 16px rgba(15, 23, 42, .045) !important;
            margin-bottom: 12px !important;
        }

        .ap-label {
            font-size: .78rem !important;
            margin-bottom: 5px !important;
        }

        .ap-edit-page .form-control,
        .ap-edit-page .form-select {
            min-height: 40px !important;
            border-radius: 12px !important;
            font-size: .86rem !important;
        }

        .ap-side-box {
            border-radius: 15px !important;
            padding: 11px !important;
        }

        .ap-side-title {
            font-size: .65rem !important;
            padding-bottom: 8px !important;
            margin-bottom: 10px !important;
        }

        .ap-upload-box {
            border-radius: 13px !important;
            padding: 10px !important;
        }

        .ap-save-btn {
            min-height: 44px !important;
            border-radius: 14px !important;
            font-size: .9rem !important;
        }

        .alert {
            border-radius: 13px !important;
            padding: 10px 12px !important;
        }

        .ck-editor__editable {
            min-height: 220px !important;
        }
    }

</style>

<div class="container-fluid px-4 mt-4 pb-5 animate__animated animate__fadeIn ap-edit-page">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ProjectID" />
        <input type="hidden" asp-for="MainImage" />
        <input type="hidden" asp-for="LegalDocs" />
        <input type="hidden" asp-for="CreatedAt" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4 fw-bold mb-3"></div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card ap-card mb-4">
                    <div class="card-header ap-card-header bg-warning text-dark">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold">
                                <i class="bi bi-pencil-square me-2"></i>I. CẬP NHẬT THÔNG TIN CỐT LÕI
                            </h5>
                            <a asp-action="Index" class="btn btn-sm btn-dark rounded-pill px-3 fw-bold">
                                <i class="bi bi-arrow-left me-1"></i>Quay lại kho
                            </a>
                        </div>
                    </div>

                    <div class="card-body ap-card-body">
                        <div class="mb-4">
                            <label class="form-label ap-label">Tên thương mại dự án <span class="ap-required">*</span></label>
                            <input asp-for="ProjectName" class="form-control form-control-lg" required />
                            <span asp-validation-for="ProjectName" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label ap-label">Phân khúc / Loại hình</label>
                                <input asp-for="ProjectType" class="form-control" placeholder="VD: Căn hộ cao cấp, đất nền, đô thị..." />
                                <span asp-validation-for="ProjectType" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label ap-label">Chủ đầu tư chính <span class="ap-required">*</span></label>
                                <input asp-for="Investor" class="form-control" required />
                                <span asp-validation-for="Investor" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label ap-label">Tóm tắt Sapo / Mô tả ngắn</label>
                            <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Description" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="mb-0">
                            <label class="form-label ap-label text-primary">Bài viết giới thiệu chi tiết / Chuẩn SEO</label>
                            <textarea asp-for="ContentHtml" id="editor"></textarea>
                            <span asp-validation-for="ContentHtml" class="text-danger small fw-bold"></span>
                        </div>
                    </div>
                </div>

                <div class="card ap-card">
                    <div class="card-header ap-card-header bg-primary text-white">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-gear-wide-connected me-2"></i>II. THÔNG SỐ KỸ THUẬT & TIỆN ÍCH
                        </h5>
                    </div>

                    <div class="card-body ap-card-body">
                        <div class="row g-4 mb-4">
                            <div class="col-md-4">
                                <label class="form-label ap-label">Giá bán từ</label>
                                <input asp-for="PriceMin" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="PriceMin" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label ap-label">Đến tối đa</label>
                                <input asp-for="PriceMax" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="PriceMax" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label ap-label">Đơn vị giá</label>
                                <select asp-for="PriceUnit" class="form-select fw-bold">
                                    <option value="Tỷ">Tỷ đồng</option>
                                    <option value="Triệu/m2">Triệu / m²</option>
                                    <option value="USD">USD</option>
                                </select>
                                <span asp-validation-for="PriceUnit" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label ap-label">Quy mô khu đất</label>
                                <input asp-for="Scale" class="form-control" placeholder="VD: 5ha, 3 tòa tháp, 1500 căn" />
                                <span asp-validation-for="Scale" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label ap-label">Mật độ xây dựng</label>
                                <input asp-for="ConstructionDensity" class="form-control" placeholder="VD: 35%" />
                                <span asp-validation-for="ConstructionDensity" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label class="form-label ap-label">Diện tích SP nhỏ nhất (m²)</label>
                                <input asp-for="AreaMin" type="number" step="0.1" class="form-control" />
                                <span asp-validation-for="AreaMin" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label ap-label">Diện tích SP lớn nhất (m²)</label>
                                <input asp-for="AreaMax" type="number" step="0.1" class="form-control" />
                                <span asp-validation-for="AreaMax" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label ap-label text-warning">Hệ thống tiện ích nội khu</label>
                            <textarea asp-for="Utilities" class="form-control border-warning" rows="4" placeholder="Liệt kê các tiện ích nổi bật..."></textarea>
                            <span asp-validation-for="Utilities" class="text-danger small fw-bold"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card ap-card mb-4 sticky-top ap-sticky">
                    <div class="card-body ap-card-body">
                        <div class="mb-4">
                            <label class="form-label ap-label text-primary mb-2">
                                <i class="bi bi-person-check me-2"></i>Gán quyền quản lý / CRM Leads
                            </label>
                            <select asp-for="OwnerUserID" class="form-select" asp-items="ViewBag.Owners" required>
                                <option value="">-- Chọn Doanh nghiệp đối tác --</option>
                            </select>
                            <span asp-validation-for="OwnerUserID" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="mb-4 ap-side-box">
                            <div class="ap-side-title">
                                <i class="bi bi-geo-alt-fill text-danger"></i>Vị trí dự án
                            </div>

                            <select asp-for="AreaID" class="form-select mb-2" asp-items="ViewBag.Areas" id="areaDDL" required>
                                <option value="">-- Chọn Khu vực --</option>
                            </select>
                            <span asp-validation-for="AreaID" class="text-danger small fw-bold"></span>

                            <select asp-for="WardID" class="form-select mb-2" asp-items="ViewBag.Wards" id="wardDDL" required>
                                <option value="">-- Chọn Phường/Xã --</option>
                            </select>
                            <span asp-validation-for="WardID" class="text-danger small fw-bold"></span>

                            <input asp-for="AddressDetail" class="form-control" placeholder="Số nhà, tên đường, khu đô thị..." required />
                            <span asp-validation-for="AddressDetail" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="mb-4 ap-side-box">
                            <div class="ap-side-title">
                                <i class="bi bi-images text-primary"></i>Hình ảnh & pháp lý
                            </div>

                            <div class="mb-4">
                                <label class="form-label ap-label">
                                    <i class="bi bi-image me-1 text-primary"></i>Ảnh bìa dự án hiện tại
                                </label>

                                <img src="@mainImageUrl"
                                     class="ap-current-image mb-2"
                                     alt="Ảnh bìa dự án hiện tại"
                                     onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                                <div class="ap-upload-box">
                                    <div class="ap-upload-title">
                                        <i class="bi bi-cloud-arrow-up text-primary"></i>Đổi ảnh bìa mới
                                    </div>
                                    <input type="file" name="MainImageFile" id="MainImageFile" class="form-control" accept="image/*" />
                                    <div class="ap-selected-file" id="mainImageSelected"></div>
                                    <small class="text-muted fst-italic d-block mt-2">
                                        Không chọn file mới thì hệ thống giữ nguyên ảnh bìa hiện tại.
                                    </small>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label ap-label">
                                    <i class="bi bi-file-earmark-lock me-1 text-danger"></i>Hồ sơ pháp lý hiện tại
                                </label>

                                @if (hasLegalDocs)
                                {
                                    <div class="ap-file-current has-file">
                                        <div class="ap-file-row">
                                            <div class="ap-file-icon">
                                                @if (legalExt == "PDF")
                                                {
                                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                                }
                                                else if (legalExt == "ZIP" || legalExt == "RAR")
                                                {
                                                    <i class="bi bi-file-earmark-zip-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-file-earmark-check-fill"></i>
                                                }
                                            </div>

                                            <div class="min-w-0">
                                                <div class="ap-file-kicker">Đã có file pháp lý</div>
                                                <div class="ap-file-name">@legalFileName</div>
                                                <p class="ap-file-note">
                                                    Người nhập không cần tải lại nếu không muốn thay thế hồ sơ này.
                                                </p>
                                            </div>
                                        </div>

                                        <div class="ap-file-actions">
                                            <a href="@legalDocsUrl" target="_blank" rel="noopener" class="btn btn-success">
                                                <i class="bi bi-eye-fill me-1"></i>Xem file
                                            </a>
                                            <a href="@legalDocsUrl" download class="btn btn-outline-success">
                                                <i class="bi bi-download me-1"></i>Tải xuống
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="ap-file-current no-file">
                                        <div class="ap-file-row">
                                            <div class="ap-file-icon">
                                                <i class="bi bi-exclamation-triangle-fill"></i>
                                            </div>

                                            <div class="min-w-0">
                                                <div class="ap-file-kicker">Chưa có file pháp lý</div>
                                                <div class="ap-file-name">Dự án này hiện chưa lưu hồ sơ pháp lý.</div>
                                                <p class="ap-file-note">
                                                    Hãy tải file PDF, ZIP hoặc RAR để hồ sơ dự án đầy đủ hơn.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="ap-upload-box">
                                    <div class="ap-upload-title">
                                        <i class="bi bi-arrow-repeat text-danger"></i>Thay thế / bổ sung file pháp lý
                                    </div>
                                    <input type="file" name="LegalDocsFile" id="LegalDocsFile" class="form-control border-danger" accept=".pdf,.zip,.rar" />
                                    <div class="ap-selected-file" id="legalDocsSelected"></div>
                                    <small class="text-muted fst-italic d-block mt-2">
                                        Chỉ chọn file mới khi muốn thay thế file pháp lý hiện tại. Nếu bỏ trống, hệ thống giữ nguyên file cũ.
                                    </small>
                                </div>
                            </div>

                            <div class="mb-0">
                                <label class="form-label ap-label">Trạng thái dự án</label>
                                <select asp-for="ProjectStatus" class="form-select form-select-lg fw-bold text-success border-success">
                                    <option value="Sắp mở bán">Sắp mở bán (Booking)</option>
                                    <option value="Đang mở bán">Đang mở bán</option>
                                    <option value="Đang bàn giao">Đang bàn giao</option>
                                    <option value="Đã bàn giao">Đã bàn giao hoàn thiện</option>
                                </select>
                                <span asp-validation-for="ProjectStatus" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg w-100 ap-save-btn shadow text-dark">
                            <i class="bi bi-save2-fill me-2"></i>LƯU THAY ĐỔI DỰ ÁN
                        </button>

                        <div class="alert alert-info rounded-4 mt-3 mb-0 small fw-semibold">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            Ảnh bìa và hồ sơ pháp lý cũ sẽ được giữ nguyên nếu bạn không chọn file mới.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>
        ClassicEditor
            .create(document.querySelector('#editor'), {
                ckfinder: {
                    uploadUrl: '/Admin/AdminProject/UploadImageCKEditor'
                }
            })
            .catch(error => {
                console.error(error);
            });

        $('#areaDDL').change(function () {
            var areaId = $(this).val();

            if (areaId) {
                $.getJSON('/Admin/AdminProject/GetWardsByArea?areaId=' + areaId, function (data) {
                    var items = '<option value="">-- Chọn Phường/Xã --</option>';

                    $.each(data, function (i, ward) {
                        items += "<option value='" + ward.id + "'>" + ward.name + "</option>";
                    });

                    $('#wardDDL').html(items);
                });
            } else {
                $('#wardDDL').html('<option value="">-- Chọn Phường/Xã --</option>');
            }
        });

        function showSelectedFile(inputSelector, labelSelector) {
            const input = document.querySelector(inputSelector);
            const label = document.querySelector(labelSelector);

            if (!input || !label) {
                return;
            }

            input.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    label.style.display = 'block';
                    label.innerHTML = '<i class="bi bi-paperclip me-1"></i>Đã chọn: ' + this.files[0].name;
                } else {
                    label.style.display = 'none';
                    label.innerHTML = '';
                }
            });
        }

        showSelectedFile('#MainImageFile', '#mainImageSelected');
        showSelectedFile('#LegalDocsFile', '#legalDocsSelected');
    </script>
}