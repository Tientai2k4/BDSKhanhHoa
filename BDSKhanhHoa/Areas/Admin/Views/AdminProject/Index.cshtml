@model IEnumerable<BDSKhanhHoa.Models.Project>
@{
    ViewData["Title"] = "Quản lý dự án BĐS";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string visibility = ViewBag.Visibility as string ?? "";
    string keyword = ViewBag.Keyword as string ?? "";
    string projectStatus = ViewBag.ProjectStatus as string ?? "";
    string projectType = ViewBag.ProjectType as string ?? "";
    string legal = ViewBag.Legal as string ?? "";
    string price = ViewBag.Price as string ?? "";
    string sort = ViewBag.Sort as string ?? "newest";

    int totalResults = ViewBag.TotalResults is int tr ? tr : 0;
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;

    int allCount = ViewBag.AllCount is int ac ? ac : 0;
    int publicCount = ViewBag.PublicCount is int pc ? pc : 0;
    int hiddenCount = ViewBag.HiddenCount is int hc ? hc : 0;

    int? areaId = ViewBag.AreaId as int?;
    int? wardId = ViewBag.WardId as int?;
    int? ownerId = ViewBag.OwnerId as int?;

    string PageUrl(int p) => Url.Action("Index", "AdminProject", new
    {
        area = "Admin",
        visibility,
        keyword,
        areaId,
        wardId,
        ownerId,
        projectStatus,
        projectType,
        legal,
        price,
        sort,
        page = p
    }) ?? "#";

    string BuildTabUrl(string tabVisibility)
    {
        return Url.Action("Index", "AdminProject", new
        {
            area = "Admin",
            visibility = tabVisibility,
            keyword,
            areaId,
            wardId,
            ownerId,
            projectStatus,
            projectType,
            legal,
            price,
            sort,
            page = 1
        }) ?? "#";
    }
    bool hasActiveFilter = !string.IsNullOrWhiteSpace(keyword)
        || areaId.HasValue
        || wardId.HasValue
        || ownerId.HasValue
        || !string.IsNullOrWhiteSpace(projectStatus)
        || !string.IsNullOrWhiteSpace(projectType)
        || !string.IsNullOrWhiteSpace(legal)
        || !string.IsNullOrWhiteSpace(price)
        || !string.Equals(sort, "newest", StringComparison.OrdinalIgnoreCase);

    string FilterSummaryText()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            parts.Add("Từ khóa");
        }

        if (areaId.HasValue || wardId.HasValue)
        {
            parts.Add("Khu vực");
        }

        if (ownerId.HasValue)
        {
            parts.Add("Tài khoản");
        }

        if (!string.IsNullOrWhiteSpace(projectStatus))
        {
            parts.Add(projectStatus);
        }

        if (!string.IsNullOrWhiteSpace(projectType))
        {
            parts.Add("Loại hình");
        }

        if (!string.IsNullOrWhiteSpace(legal))
        {
            parts.Add(legal == "has" ? "Có pháp lý" : legal == "none" ? "Chưa pháp lý" : "Pháp lý");
        }

        if (!string.IsNullOrWhiteSpace(price))
        {
            parts.Add("Khoảng giá");
        }

        if (!string.Equals(sort, "newest", StringComparison.OrdinalIgnoreCase))
        {
            parts.Add("Sắp xếp");
        }

        return parts.Any() ? string.Join(" · ", parts.Take(3)) + (parts.Count > 3 ? "..." : "") : "Bấm để mở bộ lọc";
    }

}

@functions {
    public string SafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/no-image.jpg";
        }

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
        {
            return image;
        }

        return "/" + image.TrimStart('/');
    }

    public string FormatPrice(decimal? min, decimal? max, string? unit)
    {
        string priceUnit = string.IsNullOrWhiteSpace(unit) ? "" : unit.Trim();

        if (min.HasValue && max.HasValue)
        {
            return $"{min.Value:0.##} - {max.Value:0.##} {priceUnit}".Trim();
        }

        if (min.HasValue)
        {
            return $"Từ {min.Value:0.##} {priceUnit}".Trim();
        }

        if (max.HasValue)
        {
            return $"Đến {max.Value:0.##} {priceUnit}".Trim();
        }

        return "Đang cập nhật";
    }

    public string VisibilityText(string? status)
    {
        bool isPublic = status == "Approved" || status == "Đã duyệt";
        return isPublic ? "Đang công khai" : "Đã ẩn";
    }

    public string VisibilityClass(string? status)
    {
        bool isPublic = status == "Approved" || status == "Đã duyệt";
        return isPublic ? "visibility-public" : "visibility-hidden";
    }
}

