@model BDSKhanhHoa.Areas.Admin.ViewModels.AdminDashboardViewModel
@using System.Text.Json

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Báo cáo thống kê quản trị";

    string labelsJson = JsonSerializer.Serialize(Model.MonthLabels);
    string revenueJson = JsonSerializer.Serialize(Model.RevenueData);
    string propertyCreatedJson = JsonSerializer.Serialize(Model.PropertyCreatedData);
    string propertySoldJson = JsonSerializer.Serialize(Model.PropertySoldData);
    string propertyRentedJson = JsonSerializer.Serialize(Model.PropertyRentedData);
    string userJson = JsonSerializer.Serialize(Model.UserData);
    string chatJson = JsonSerializer.Serialize(Model.ChatData);
    string transactionJson = JsonSerializer.Serialize(Model.TransactionData);
    string auditJson = JsonSerializer.Serialize(Model.AuditLogData);

    decimal totalRevenue = Model.TotalRevenue <= 0 ? 1 : Model.TotalRevenue;
    decimal yearPercent = Math.Round((Model.YearRevenue / totalRevenue) * 100, 1);

    int totalProperties = Model.TotalProperties <= 0 ? 1 : Model.TotalProperties;
    decimal soldPercent = Math.Round(((decimal)Model.SoldProperties / totalProperties) * 100, 1);
    decimal rentedPercent = Math.Round(((decimal)Model.RentedProperties / totalProperties) * 100, 1);
    decimal pendingPercent = Math.Round(((decimal)Model.PendingProperties / totalProperties) * 100, 1);

    string reportType = Convert.ToString(ViewBag.ReportType) ?? "year";
    int? selectedQuarter = ViewBag.SelectedQuarter as int?;
    int? selectedMonth = ViewBag.SelectedMonth as int?;
    string fromDate = Convert.ToString(ViewBag.FromDate) ?? "";
    string toDate = Convert.ToString(ViewBag.ToDate) ?? "";
    string reportRangeText = Convert.ToString(ViewBag.ReportRangeText) ?? $"Năm {Model.SelectedYear}";
}

