                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="filter-label">Kiểu thống kê</div>
                        <select name="reportType" id="reportType" class="form-select">
                            @if (reportType == "year")
                            {
                                <option value="year" selected>Theo năm</option>
                            }
                            else
                            {
                                <option value="year">Theo năm</option>
                            }

                            @if (reportType == "quarter")
                            {
                                <option value="quarter" selected>Theo quý</option>
                            }
                            else
                            {
                                <option value="quarter">Theo quý</option>
                            }

                            @if (reportType == "month")
                            {
                                <option value="month" selected>Theo tháng</option>
                            }
                            else
                            {
                                <option value="month">Theo tháng</option>
                            }

                            @if (reportType == "custom")
                            {
                                <option value="custom" selected>Khoảng ngày</option>
                            }
                            else
                            {
                                <option value="custom">Khoảng ngày</option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="filter-label">Năm</div>
                        <select name="year" class="form-select">
                            @foreach (int year in Model.AvailableYears)
                            {
                                if (year == Model.SelectedYear)
                                {
                                    <option value="@year" selected>Năm @year</option>
                                }
                                else
                                {
                                    <option value="@year">Năm @year</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="filter-label">Quý</div>
                        <select name="quarter" class="form-select">
                            <option value="">Tất cả quý</option>
                            @for (int q = 1; q <= 4; q++)
                            {
                                if (selectedQuarter == q)
                                {
                                    <option value="@q" selected>Quý @q</option>
                                }
                                else
                                {
                                    <option value="@q">Quý @q</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <div class="filter-label">Tháng</div>
                        <select name="month" class="form-select">
                            <option value="">Tất cả tháng</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                if (selectedMonth == i)
                                {
                                    <option value="@i" selected>Tháng @i</option>
                                }
                                else
                                {
                                    <option value="@i">Tháng @i</option>
                                }
                            }
