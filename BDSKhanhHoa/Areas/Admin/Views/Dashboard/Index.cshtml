                                <a class="action-btn btn-word-soft export-link" data-action="@Url.Action("ExportWord", "Dashboard", new { area = "Admin" })">
                                    <i class="bi bi-file-earmark-word"></i>
                                    Word
                                </a>

                                <a class="action-btn btn-success-soft export-link" data-action="@Url.Action("ExportExcel", "Dashboard", new { area = "Admin" })">
                                    <i class="bi bi-file-earmark-excel"></i>
