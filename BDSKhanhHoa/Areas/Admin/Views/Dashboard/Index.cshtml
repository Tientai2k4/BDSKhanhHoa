<script>

    document.addEventListener("DOMContentLoaded", function () {
        const filterPanel = document.querySelector(".filter-panel");
        const toggleBtn = document.getElementById("btnToggleReportFilter");
        const reportType = document.getElementById("reportType");
        const hasActiveFilter = "@reportType" !== "year" || "@(selectedQuarter?.ToString() ?? "")" !== "" || "@(selectedMonth?.ToString() ?? "")" !== "" || "@fromDate" !== "" || "@toDate" !== "";

        if (filterPanel && window.innerWidth > 767) {
            filterPanel.classList.add("filter-open");
        }

        if (filterPanel && window.innerWidth <= 767 && hasActiveFilter) {
            filterPanel.classList.add("filter-open");
            if (toggleBtn) toggleBtn.setAttribute("aria-expanded", "true");
        }

        if (toggleBtn && filterPanel) {
            toggleBtn.addEventListener("click", function () {
                const isOpen = filterPanel.classList.toggle("filter-open");
                toggleBtn.setAttribute("aria-expanded", isOpen ? "true" : "false");
            });
        }

        window.addEventListener("resize", function () {
            if (!filterPanel) return;
            if (window.innerWidth > 767) {
                filterPanel.classList.add("filter-open");
                if (toggleBtn) toggleBtn.setAttribute("aria-expanded", "true");
            } else if (!hasActiveFilter) {
                filterPanel.classList.remove("filter-open");
                if (toggleBtn) toggleBtn.setAttribute("aria-expanded", "false");
            }
        });
    });

    const reportLabels = @Html.Raw(labelsJson);
    const revenueData = @Html.Raw(revenueJson);
    const propertyCreatedData = @Html.Raw(propertyCreatedJson);
    const propertySoldData = @Html.Raw(propertySoldJson);
    const propertyRentedData = @Html.Raw(propertyRentedJson);
    const userData = @Html.Raw(userJson);
    const chatData = @Html.Raw(chatJson);
    const transactionData = @Html.Raw(transactionJson);
    const auditData = @Html.Raw(auditJson);

    const propertyDonutLabels = ["Đang hiển thị", "Chờ duyệt", "Đã bán", "Đã thuê"];
    const propertyDonutData = [
        @Model.ApprovedProperties,
        @Model.PendingProperties,
        @Model.SoldProperties,
        @Model.RentedProperties
    ];

    const healthData = [
        @soldPercent,
        @rentedPercent,
        @(100 - pendingPercent < 0 ? 0 : 100 - pendingPercent)
    ];

    function formatMoney(value) {
        return new Intl.NumberFormat("vi-VN", {
            style: "currency",
            currency: "VND",
            maximumFractionDigits: 0
        }).format(value || 0);
    }

    function compactNumber(value) {
        return new Intl.NumberFormat("vi-VN", {
            notation: "compact",
            maximumFractionDigits: 1
        }).format(value || 0);
    }

    flatpickr(".date-picker", {
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d/m/Y",
        locale: "vn"
    });

    document.querySelectorAll(".export-link").forEach(function (link) {
        link.addEventListener("click", function () {
            const form = document.getElementById("reportFilterForm");
            const params = new URLSearchParams(new FormData(form));
            const action = this.getAttribute("data-action");
            window.location.href = action + "?" + params.toString();
        });
    });

    const commonFont = "Inter, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";

    new ApexCharts(document.querySelector("#revenueComboChart"), {
        chart: {
            height: 295,
            type: "line",
            toolbar: { show: true },
            fontFamily: commonFont
        },
        series: [
            { name: "Doanh thu", type: "column", data: revenueData },
            { name: "Giao dịch", type: "line", data: transactionData }
        ],
        stroke: {
            width: [0, 3],
            curve: "smooth"
        },
        plotOptions: {
            bar: {
                borderRadius: 8,
                columnWidth: "46%"
            }
        },
        colors: ["#2563eb", "#f97316"],
        dataLabels: { enabled: false },
        labels: reportLabels,
        yaxis: [
            {
                labels: {
                    style: { fontSize: "11px" },
                    formatter: function (value) {
                        return compactNumber(value);
                    }
                }
            },
            {
                opposite: true,
                labels: { style: { fontSize: "11px" } }
            }
        ],
        xaxis: {
            labels: { style: { fontSize: "11px" } }
        },
        tooltip: {
            shared: true,
            intersect: false,
            y: [
                {
                    formatter: function (value) {
                        return formatMoney(value);
                    }
                },
                {
                    formatter: function (value) {
                        return value + " giao dịch";
                    }
                }
            ]
        },
        grid: {
            borderColor: "#e5e7eb",
            strokeDashArray: 4
        },
        legend: {
            fontSize: "11px"
        }
    }).render();

    new ApexCharts(document.querySelector("#propertyDonutChart"), {
        chart: {
            height: 245,
            type: "donut",
            fontFamily: commonFont
        },
        series: propertyDonutData,
        labels: propertyDonutLabels,
        colors: ["#2563eb", "#f59e0b", "#16a34a", "#7c3aed"],
        legend: {
            position: "bottom",
            fontSize: "11px"
        },
        plotOptions: {
            pie: {
                donut: {
                    size: "68%",
                    labels: {
                        show: true,
                        total: {
                            show: true,
                            label: "Tổng tin",
                            fontSize: "11px",
                            formatter: function () {
                                return "@Model.TotalProperties";
                            }
                        },
                        value: {
                            fontSize: "18px"
                        }
                    }
                }
            }
        },
        dataLabels: {
            enabled: true,
            style: {
                fontSize: "10px"
            }
        }
    }).render();

    new ApexCharts(document.querySelector("#propertyLineChart"), {
        chart: {
            height: 295,
            type: "area",
            toolbar: { show: true },
            fontFamily: commonFont
        },
        series: [
            { name: "Tin mới", data: propertyCreatedData },
            { name: "Đã bán", data: propertySoldData },
            { name: "Đã thuê", data: propertyRentedData }
        ],
        colors: ["#2563eb", "#16a34a", "#f59e0b"],
        stroke: {
            curve: "smooth",
            width: 2.5
        },
        fill: {
            type: "gradient",
            gradient: {
                shadeIntensity: 1,
                opacityFrom: .28,
                opacityTo: .04,
                stops: [0, 90, 100]
            }
        },
        xaxis: {
            categories: reportLabels,
            labels: { style: { fontSize: "11px" } }
        },
        yaxis: {
            labels: { style: { fontSize: "11px" } }
        },
        grid: {
            borderColor: "#e5e7eb",
            strokeDashArray: 4
        },
        legend: {
            fontSize: "11px"
        }
    }).render();

    new ApexCharts(document.querySelector("#activityAreaChart"), {
        chart: {
            height: 295,
            type: "line",
            toolbar: { show: true },
            fontFamily: commonFont
        },
        series: [
            { name: "Người dùng mới", data: userData },
            { name: "Giao dịch", data: transactionData },
            { name: "Chatbot AI", data: chatData },
            { name: "Nhật ký", data: auditData }
        ],
        colors: ["#2563eb", "#16a34a", "#7c3aed", "#dc2626"],
        stroke: {
            curve: "smooth",
            width: 2.5
        },
        markers: {
            size: 3
        },
        xaxis: {
            categories: reportLabels,
            labels: { style: { fontSize: "11px" } }
        },
        yaxis: {
            labels: { style: { fontSize: "11px" } }
        },
        grid: {
            borderColor: "#e5e7eb",
            strokeDashArray: 4
        },
        legend: {
            fontSize: "11px"
        }
    }).render();

    new ApexCharts(document.querySelector("#healthRadialChart"), {
        chart: {
            height: 245,
            type: "radialBar",
            fontFamily: commonFont
        },
        series: healthData,
        labels: ["Bán", "Cho thuê", "Duyệt tốt"],
        colors: ["#16a34a", "#f59e0b", "#2563eb"],
        plotOptions: {
            radialBar: {
                hollow: { size: "34%" },
                dataLabels: {
                    name: { fontSize: "11px" },
                    value: { fontSize: "15px" },
                    total: {
                        show: true,
                        label: "Vận hành",
                        fontSize: "11px",
                        formatter: function () {
                            return "OK";
                        }
                    }
                }
            }
        },
        legend: {
            fontSize: "11px"
        }
    }).render();

    $("#recentTransactionsTable").DataTable({
        responsive: true,
        pageLength: 8,
        lengthMenu: [8, 15, 25, 50],
        order: [],
        language: {
            search: "Tìm:",
            lengthMenu: "_MENU_ dòng",
            info: "_START_ - _END_ / _TOTAL_ dòng",
            infoEmpty: "Không có dữ liệu",
            zeroRecords: "Không tìm thấy dữ liệu",
            paginate: {
                first: "Đầu",
                last: "Cuối",
                next: "Sau",
                previous: "Trước"
            }
        }
    });
</script>