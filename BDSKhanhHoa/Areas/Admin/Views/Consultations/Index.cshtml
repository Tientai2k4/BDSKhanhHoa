@model IEnumerable<BDSKhanhHoa.Models.Consultation>
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Collections.Generic

@{
    ViewData["Title"] = "Admin - Yêu cầu tư vấn cần thông báo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var items = Model?.ToList() ?? new List<BDSKhanhHoa.Models.Consultation>();

    string keyword = ViewBag.Keyword as string ?? "";
    string source = ViewBag.Source as string ?? "All";
    string dateRange = ViewBag.DateRange as string ?? "all";
    string remindFilter = ViewBag.RemindFilter as string ?? "CanRemind";
    int? currentProjectId = ViewBag.CurrentProjectId is int pid ? pid : null;
    var projectList = ViewBag.ProjectList as SelectList;

    int total = ViewBag.TotalLeads ?? 0;
    int needsReminder = ViewBag.NeedsReminderLeads ?? 0;
    int reminded = ViewBag.RemindedLeads ?? 0;
    int handled = ViewBag.HandledLeads ?? 0;
    int processing = ViewBag.ProcessingLeads ?? 0;
    int closed = ViewBag.ClosedLeads ?? 0;
    int totalFilteredItems = ViewBag.TotalFilteredItems ?? items.Count;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    int pageFrom = totalFilteredItems == 0 ? 0 : ((currentPage - 1) * 12) + 1;
    int pageTo = Math.Min(currentPage * 12, totalFilteredItems);
}

@functions {
    private const string RemindMarker = "[REMIND_SELLER]";

    public bool IsNewStatus(string? status)
    {
        return string.IsNullOrWhiteSpace(status)
            || status == "New"
            || status == "Mới"
            || status == "Mới gửi";
    }

    public bool IsReminded(BDSKhanhHoa.Models.Consultation c)
    {
        return !string.IsNullOrWhiteSpace(c.SellerNote)
            && c.SellerNote.Contains(RemindMarker, StringComparison.OrdinalIgnoreCase);
    }

    public bool CanShowBell(BDSKhanhHoa.Models.Consultation c)
    {
        return IsNewStatus(c.Status) && !IsReminded(c);
    }

    public string StatusText(string? status)
    {
        return status switch
        {
            null => "Mới gửi",
            "" => "Mới gửi",
            "New" => "Mới gửi",
            "Mới" => "Mới gửi",
            "Mới gửi" => "Mới gửi",
            "Contacted" => "Đã tiếp nhận",
            "Đã liên hệ" => "Đã tiếp nhận",
            "Closed" => "Hoàn tất tư vấn",
            "Resolved" => "Hoàn tất tư vấn",
            "Hoàn tất tư vấn" => "Hoàn tất tư vấn",
            "Spam" => "Spam/Rác",
            "Cancelled" => "Khách hủy",
            "Invalid" => "Không hợp lệ",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status
        };
    }

    public string StatusClass(string? status)
    {
        string text = StatusText(status);
        return text switch
        {
            "Mới gửi" => "st-new",
            "Đã tiếp nhận" => "st-processing",
            "Hoàn tất tư vấn" => "st-closed",
            "Spam/Rác" => "st-junk",
            "Khách hủy" => "st-junk",
            "Không hợp lệ" => "st-junk",
            _ => "st-new"
        };
    }

    public string CustomerName(BDSKhanhHoa.Models.Consultation c)
    {
        return string.IsNullOrWhiteSpace(c.FullName) ? "Khách vãng lai" : c.FullName.Trim();
    }

    public string SourceName(BDSKhanhHoa.Models.Consultation c)
    {
        return c.Property?.Title
            ?? c.Project?.ProjectName
            ?? "Bất động sản / dự án đã bị gỡ";
    }

    public string SourceType(BDSKhanhHoa.Models.Consultation c)
    {
        if (c.ProjectID.HasValue) return "Dự án";
        if (c.PropertyID.HasValue) return "Tin lẻ BĐS";
        return "Không xác định";
    }

    public string SourceClass(BDSKhanhHoa.Models.Consultation c)
    {
        return SourceType(c) == "Dự án" ? "src-project" : "src-property";
    }

    public string HandlerName(BDSKhanhHoa.Models.Consultation c)
    {
        return c.AssignedUser?.FullName
            ?? c.Property?.User?.FullName
            ?? c.Project?.Owner?.FullName
            ?? "Chưa phân công";
    }

    public string ShortText(string? value, int max = 96)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Không có lời nhắn";
        value = value.Trim();
        return value.Length <= max ? value : value.Substring(0, max) + "...";
    }
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

