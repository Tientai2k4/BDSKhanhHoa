<div class="notify-admin-page">
    @Html.AntiForgeryToken()

    <section class="na-hero">
        <div>
            <div class="na-kicker"><i class="bi bi-bell-fill"></i> Trung tâm nhắc tư vấn</div>
            <h1 class="na-title">Yêu cầu tư vấn mới cần Admin thông báo</h1>
            <p class="na-desc">
                Admin chỉ bấm chuông nhắc người phụ trách liên hệ khách. Mặc định trang chỉ hiện yêu cầu mới/chưa tiếp nhận và chưa từng nhắc; đã nhắc hoặc đã xử lý sẽ tự ẩn khỏi danh sách cần xử lý.
            </p>
        </div>
        <a class="na-export" asp-area="Admin" asp-controller="Consultations" asp-action="ExportCsv"
           asp-route-projectId="@currentProjectId" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">
            <i class="bi bi-file-earmark-excel-fill"></i> Xuất Excel
        </a>
    </section>

    <section class="na-stats" aria-label="Thống kê yêu cầu tư vấn">
        <div class="na-stat na-stat-hot"><div class="na-stat-label">Cần thông báo</div><div class="na-stat-value" id="stat-needs">@needsReminder.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Tổng theo lọc</div><div class="na-stat-value" id="stat-total">@total.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Đã thông báo</div><div class="na-stat-value" id="stat-reminded">@reminded.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Đã xử lý/ẩn chuông</div><div class="na-stat-value">@handled.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Đang tiếp nhận</div><div class="na-stat-value">@processing.ToString("N0")</div></div>
    </section>

    <form method="get" asp-area="Admin" asp-controller="Consultations" asp-action="Index" class="na-filter row g-2 align-items-end">
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Hiển thị</label>
            <select name="remindFilter" class="form-select na-select">
                <option value="CanRemind" selected="@(remindFilter == "CanRemind" || remindFilter == "NeedNotify")">Cần thông báo</option>
                <option value="Reminded" selected="@(remindFilter == "Reminded")">Đã thông báo</option>
                <option value="Handled" selected="@(remindFilter == "Handled")">Đã tiếp nhận/xử lý</option>
                <option value="All" selected="@(remindFilter == "All")">Tất cả để kiểm tra</option>
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Nguồn</label>
            <select name="source" class="form-select na-select">
                <option value="All" selected="@(source == "All")">Tin lẻ + Dự án</option>
                <option value="Project" selected="@(source == "Project")">Chỉ dự án</option>
                <option value="Property" selected="@(source == "Property")">Chỉ tin lẻ</option>
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Dự án</label>
            <select name="projectId" class="form-select na-select" asp-items="projectList">
                <option value="">Tất cả dự án</option>
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Thời gian tạo</label>
            <select name="dateRange" class="form-select na-select">
                <option value="all" selected="@(dateRange == "all")">Toàn thời gian</option>
                <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                <option value="month" selected="@(dateRange == "month")">1 tháng qua</option>
            </select>
        </div>
        <div class="col-xl-3 col-md-8">
            <label class="na-label">Tìm kiếm</label>
            <input name="keyword" value="@keyword" class="form-control na-input" placeholder="Tên khách, SĐT, email, nguồn, người phụ trách..." />
        </div>
        <div class="col-xl-1 col-md-4 d-grid gap-2">
            <button class="na-btn na-btn-dark" type="submit"><i class="bi bi-funnel-fill"></i>Lọc</button>
        </div>
        <div class="col-12 d-flex gap-2 flex-wrap">
            <a class="na-btn na-btn-light px-3" asp-area="Admin" asp-controller="Consultations" asp-action="Index">
                <i class="bi bi-arrow-counterclockwise"></i>Về danh sách cần thông báo
            </a>
        </div>
    </form>

    <section class="na-list" id="listShell">
        <div class="na-desktop-list">
            <div class="na-list-head">
                <div>Ngày gửi</div>
                <div>Khách hàng</div>
                <div>Nguồn & phụ trách</div>
                <div>Trạng thái</div>
                <div class="text-center">Admin</div>
            </div>

            @foreach (var c in items)
            {
                bool canBell = CanShowBell(c);
                bool wasReminded = IsReminded(c);
                string customer = CustomerName(c);
                string phone = c.Phone ?? "";
                string email = c.Email ?? "";

                <article class="na-row js-admin-row" data-row-id="@c.ConsultID" data-row-kind="desktop">
                    <div>
                        <div class="na-date"><i class="bi bi-clock me-1"></i>@c.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                        <div class="na-date-sub mt-1">Cập nhật: @(c.UpdatedAt?.ToString("HH:mm dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                    </div>
                    <div>
                        <div class="na-name">@customer</div>
                        @if (!string.IsNullOrWhiteSpace(phone))
                        {
                            <div class="na-mini mt-1"><i class="bi bi-telephone me-1"></i><a class="na-phone" href="tel:@phone">@phone</a></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(email))
                        {
                            <div class="na-mini"><i class="bi bi-envelope me-1"></i>@email</div>
                        }
                        <div class="na-note">@ShortText(c.Note, 76)</div>
                    </div>
                    <div>
                        <div class="na-source-title">@SourceName(c)</div>
                        <span class="source-badge @SourceClass(c)"><i class="bi bi-building"></i>@SourceType(c)</span>
                        <div class="na-mini mt-2"><i class="bi bi-person-badge me-1"></i>@HandlerName(c)</div>
                    </div>
                    <div>
                        <span class="status-pill @StatusClass(c.Status)">@StatusText(c.Status)</span>
                        @if (wasReminded)
                        {
                            <div><span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i>Đã thông báo</span></div>
                        }
                        else if (canBell)
                        {
                            <div><span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i>Chưa thông báo</span></div>
                        }
                    </div>
                    <div class="na-actions">
                        <button type="button" class="tool-btn" onclick="openConsultationDetail(@c.ConsultID)" title="Xem chi tiết">
                            <i class="bi bi-eye-fill"></i>
                        </button>
                        @if (canBell)
                        {
                            <button type="button" class="tool-btn bell" onclick="remindConsultation(@c.ConsultID)" title="Bấm chuông thông báo">
                                <i class="bi bi-bell-fill"></i>
                            </button>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="na-mobile-list">
            @foreach (var c in items)
            {
                bool canBell = CanShowBell(c);
                bool wasReminded = IsReminded(c);
                string customer = CustomerName(c);
                string firstLetter = string.IsNullOrWhiteSpace(customer) ? "K" : customer.Trim().Substring(0, 1).ToUpperInvariant();
                string phone = c.Phone ?? "";

                <article class="na-mobile-card js-admin-row" data-row-id="@c.ConsultID" data-row-kind="mobile">
                    <div class="mobile-top">
                        <div class="d-flex gap-2 align-items-start">
                            <div class="avatar">@firstLetter</div>
                            <div>
                                <div class="na-name">@customer</div>
                                @if (!string.IsNullOrWhiteSpace(phone))
                                {
                                    <div class="na-mini"><i class="bi bi-telephone me-1"></i><a class="na-phone" href="tel:@phone">@phone</a></div>
                                }
                            </div>
                        </div>
                        <span class="status-pill @StatusClass(c.Status)">@StatusText(c.Status)</span>
                    </div>
                    <div class="mobile-box">
                        <div class="mobile-label">Ngày gửi</div>
                        <div class="na-date">@c.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                    <div class="mobile-box">
                        <div class="mobile-label">Nguồn</div>
                        <div class="na-source-title">@SourceName(c)</div>
                        <span class="source-badge @SourceClass(c)"><i class="bi bi-building"></i>@SourceType(c)</span>
                        <div class="na-mini mt-1"><i class="bi bi-person-badge me-1"></i>@HandlerName(c)</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (wasReminded)
                        {
                            <span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i>Đã thông báo</span>
                        }
                        else if (canBell)
                        {
                            <span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i>Chưa thông báo</span>
                        }
                    </div>
                    <div class="mobile-actions">
                        <button type="button" class="btn btn-light border mobile-action-btn" onclick="openConsultationDetail(@c.ConsultID)">
                            <i class="bi bi-eye-fill"></i>Chi tiết
                        </button>
                        @if (canBell)
                        {
                            <button type="button" class="btn btn-warning mobile-action-btn" onclick="remindConsultation(@c.ConsultID)">
                                <i class="bi bi-bell-fill"></i>Thông báo
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="na-empty" id="emptyState" style="display:@(items.Any() ? "none" : "block")">
        <i class="bi bi-bell-slash"></i>
        <h5 class="fw-bold text-dark mb-1">Không còn yêu cầu tư vấn cần thông báo</h5>
        <div>Những yêu cầu đã được nhắc hoặc đã tiếp nhận sẽ không hiện chuông lại để tránh làm phiền người phụ trách.</div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="na-pager" aria-label="Phân trang yêu cầu tư vấn">
            <div class="text-muted fw-bold small">Hiển thị @pageFrom - @pageTo / @totalFilteredItems mục</div>
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Consultations" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-projectId="@currentProjectId" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">‹</a>
                </li>
                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Consultations" asp-action="Index" asp-route-page="@p" asp-route-projectId="@currentProjectId" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Consultations" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-projectId="@currentProjectId" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">›</a>
                </li>
            </ul>
        </nav>
    }
</div>

<div class="modal fade" id="adminDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius:22px; overflow:hidden;">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#0f172a,#2563eb);">
                <div>
                    <h5 class="modal-title fw-bold"><i class="bi bi-headset me-2"></i>Chi tiết yêu cầu tư vấn</h5>
                    <div class="small opacity-75">Admin chỉ xem và bấm chuông nhắc nếu yêu cầu còn mới/chưa xử lý.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-person-lines-fill me-1"></i>Khách hàng</div>
                            <div class="detail-row"><div class="detail-label">Họ tên</div><div class="detail-value" id="md-customerName"></div></div>
                            <div class="detail-row"><div class="detail-label">SĐT</div><div class="detail-value" id="md-customerPhone"></div></div>
                            <div class="detail-row"><div class="detail-label">Email</div><div class="detail-value" id="md-customerEmail"></div></div>
                            <div class="detail-row"><div class="detail-label">Lời nhắn</div><div class="detail-value" id="md-note"></div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-building me-1"></i>Nguồn & phụ trách</div>
                            <div class="detail-row"><div class="detail-label">Nguồn</div><div class="detail-value" id="md-sourceName"></div></div>
                            <div class="detail-row"><div class="detail-label">Loại nguồn</div><div class="detail-value" id="md-sourceType"></div></div>
                            <div class="detail-row"><div class="detail-label">Phụ trách</div><div class="detail-value" id="md-handlerName"></div></div>
                            <div class="detail-row"><div class="detail-label">SĐT phụ trách</div><div class="detail-value" id="md-handlerPhone"></div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-clock-history me-1"></i>Tiến độ</div>
                            <div class="detail-row"><div class="detail-label">Ngày gửi</div><div class="detail-value" id="md-createdAt"></div></div>
                            <div class="detail-row"><div class="detail-label">Cập nhật</div><div class="detail-value" id="md-updatedAt"></div></div>
                            <div class="detail-row"><div class="detail-label">Trạng thái</div><div class="detail-value" id="md-status"></div></div>
                            <div class="detail-row"><div class="detail-label">Thông báo</div><div class="detail-value" id="md-remindedText"></div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-journal-text me-1"></i>Ghi chú xử lý</div>
                            <div class="detail-row"><div class="detail-label">Lịch sử</div><div class="detail-value" id="md-sellerNote"></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white">
                <button type="button" class="btn btn-light border fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const consultationRemindUrl = '@Url.Action("RemindSeller", "Consultations", new { area = "Admin" })';
        const consultationDetailUrl = '@Url.Action("GetDetails", "Consultations", new { area = "Admin" })';
        const currentRemindFilter = '@remindFilter';

        function antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function updateCounter(id, delta) {
            const el = document.getElementById(id);
            if (!el) return;
            const current = parseInt((el.innerText || '0').replace(/[^0-9-]/g, ''), 10) || 0;
            el.innerText = Math.max(0, current + delta).toLocaleString('vi-VN');
        }

        function removeRowsAfterRemind(id) {
            document.querySelectorAll('[data-row-id="' + id + '"]').forEach(x => x.remove());
            updateCounter('stat-needs', -1);
            updateCounter('stat-reminded', 1);

            const remainingDesktopRows = document.querySelectorAll('.js-admin-row[data-row-kind="desktop"]').length;
            if (remainingDesktopRows === 0) {
                document.getElementById('listShell')?.remove();
                const empty = document.getElementById('emptyState');
                if (empty) empty.style.display = 'block';
            }
        }

        async function remindConsultation(id) {
            const ask = await Swal.fire({
                title: 'Gửi chuông thông báo?',
                text: 'Admin chỉ gửi một lần cho yêu cầu mới/chưa xử lý. Sau khi gửi, yêu cầu này sẽ không hiện chuông lại.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Gửi thông báo',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#2563eb'
            });

            if (!ask.isConfirmed) return;

            const form = new FormData();
            form.append('id', id);
            form.append('__RequestVerificationToken', antiForgeryToken());

            Swal.fire({ title: 'Đang gửi thông báo...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            try {
                const response = await fetch(consultationRemindUrl, { method: 'POST', body: form });
                const result = await response.json();
                Swal.close();

                if (!result.success) {
                    Swal.fire('Không thể gửi', result.message || 'Yêu cầu không còn đủ điều kiện thông báo.', 'warning');
                    if (result.code === 'ALREADY_REMINDED' || result.code === 'ALREADY_HANDLED') {
                        removeRowsAfterRemind(id);
                    }
                    return;
                }

                await Swal.fire('Đã thông báo', result.message || 'Đã gửi chuông thông báo thành công.', 'success');

                if (currentRemindFilter === 'CanRemind' || currentRemindFilter === 'NeedNotify') {
                    removeRowsAfterRemind(id);
                } else {
                    window.location.reload();
                }
            } catch {
                Swal.close();
                Swal.fire('Lỗi', 'Không thể gửi thông báo. Vui lòng thử lại.', 'error');
            }
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) el.innerText = value || '';
        }

        function setHtml(id, value) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = value || '';
        }

        function openConsultationDetail(id) {
            Swal.fire({ title: 'Đang tải chi tiết...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            fetch(consultationDetailUrl + '?id=' + encodeURIComponent(id))
                .then(r => r.json())
                .then(res => {
                    Swal.close();
                    if (!res.success) {
                        Swal.fire('Không tìm thấy', res.message || 'Không thể tải yêu cầu tư vấn.', 'error');
                        return;
                    }

                    const d = res.data;
                    setText('md-customerName', d.customerName);
                    setText('md-customerPhone', d.customerPhone);
                    setText('md-customerEmail', d.customerEmail);
                    setText('md-note', d.note);
                    setText('md-sourceName', d.sourceName);
                    setText('md-sourceType', d.sourceType);
                    setText('md-handlerName', d.handlerName);
                    setText('md-handlerPhone', d.handlerPhone);
                    setText('md-createdAt', d.createdAt);
                    setText('md-updatedAt', d.updatedAt);
                    setText('md-status', d.status);
                    setText('md-sellerNote', d.sellerNote);

                    setHtml('md-remindedText', d.wasReminded
                        ? '<span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i> Đã thông báo</span>'
                        : '<span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i> Chưa thông báo</span>');

                    new bootstrap.Modal(document.getElementById('adminDetailModal')).show();
                })
                .catch(() => {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể lấy dữ liệu yêu cầu tư vấn.', 'error');
                });
        }
    </script>
}
