@model IEnumerable<BDSKhanhHoa.Models.Consultation>

@{
    ViewData["Title"] = "Giám sát Yêu cầu Tư vấn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string status = ViewBag.Status as string ?? "All";
    string keyword = ViewBag.Keyword as string ?? "";
    string source = ViewBag.Source as string ?? "All";
    string dateRange = ViewBag.DateRange as string ?? "all";

    int total = ViewBag.TotalLeads ?? 0;
    int newLeads = ViewBag.NewLeads ?? 0;
    int processing = ViewBag.ProcessingLeads ?? 0;
    int closed = ViewBag.ClosedLeads ?? 0;
    int junk = ViewBag.JunkLeads ?? 0;
    int reminded = ViewBag.RemindedLeads ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string RemindMarker = "[REMIND_SELLER]";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --lead-primary: #2563eb;
        --lead-dark: #0f172a;
        --lead-muted: #64748b;
        --lead-border: #e2e8f0;
        --lead-bg: #f6f8fc;
        --lead-card: #ffffff;
        --lead-shadow: 0 10px 28px rgba(15, 23, 42, .055);
        --lead-radius: 20px;
    }

    .lead-admin-page,
    .lead-admin-page * {
        box-sizing: border-box;
    }

    .lead-admin-page {
        background: radial-gradient(circle at top left, rgba(37,99,235,.08), transparent 320px), var(--lead-bg);
        min-height: calc(100vh - 80px);
        padding: 18px;
        overflow-x: hidden;
    }

    .fw-black {
        font-weight: 900;
    }

    .lead-card {
        background: var(--lead-card);
        border: 1px solid rgba(226,232,240,.92);
        border-radius: var(--lead-radius);
        box-shadow: var(--lead-shadow);
    }

    .lead-hero {
        padding: 18px;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        background: radial-gradient(circle at top right, rgba(37,99,235,.12), transparent 260px), #fff;
    }

    .lead-kicker {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .72rem;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .lead-title {
        margin: 0;
        color: var(--lead-dark);
        font-size: clamp(1.35rem, 2.4vw, 2rem);
        line-height: 1.15;
        letter-spacing: -.04em;
        font-weight: 950;
    }

    .lead-desc {
        margin: 5px 0 0;
        max-width: 720px;
        color: var(--lead-muted);
        font-weight: 650;
        line-height: 1.55;
        font-size: .9rem;
    }

    .lead-export-btn {
        min-height: 42px;
        padding: 0 16px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        background: linear-gradient(135deg, #16a34a, #059669);
        text-decoration: none;
        font-weight: 900;
        white-space: nowrap;
        box-shadow: 0 10px 22px rgba(22,163,74,.18);
    }

        .lead-export-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .lead-stat-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .lead-stat {
        min-height: 92px;
        border-radius: 18px;
        padding: 13px;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 9px 22px rgba(15,23,42,.07);
    }

        .lead-stat::after {
            content: "";
            position: absolute;
            width: 84px;
            height: 84px;
            right: -34px;
            top: -38px;
            border-radius: 999px;
            background: rgba(255,255,255,.15);
        }

    .lead-stat-label {
        position: relative;
        z-index: 1;
        font-size: .67rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        opacity: .92;
        font-weight: 900;
        margin-bottom: 7px;
    }

    .lead-stat-value {
        position: relative;
        z-index: 1;
        font-size: 1.65rem;
        line-height: 1;
        font-weight: 950;
    }

    .lead-stat-note {
        position: relative;
        z-index: 1;
        margin-top: 7px;
        font-size: .68rem;
        opacity: .82;
        font-weight: 750;
    }

    .bg-total {
        background: linear-gradient(135deg, #0f172a, #334155);
    }

    .bg-new {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .bg-processing {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
    }

    .bg-closed {
        background: linear-gradient(135deg, #047857, #10b981);
    }

    .bg-reminded {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
    }

    .bg-junk {
        background: linear-gradient(135deg, #475569, #94a3b8);
    }

    .filter-shell {
        margin-bottom: 14px;
        overflow: hidden;
    }

    .filter-toggle {
        width: 100%;
        min-height: 46px;
        border: 0;
        background: #fff;
        color: var(--lead-dark);
        padding: 13px 16px;
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-weight: 950;
    }

        .filter-toggle span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

    .filter-body {
        padding: 14px;
    }

    .lead-label {
        margin-bottom: 6px;
        color: var(--lead-muted);
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .07em;
        font-weight: 950;
    }

    .lead-input,
    .lead-select {
        min-height: 42px;
        border-radius: 14px !important;
        border: 1px solid #dbe4ef !important;
        background: #fff;
        color: var(--lead-dark);
        font-weight: 750;
        font-size: .86rem;
        box-shadow: none !important;
    }

        .lead-input:focus,
        .lead-select:focus {
            border-color: #93c5fd !important;
            box-shadow: 0 0 0 4px rgba(37,99,235,.09) !important;
        }

    .lead-search-btn,
    .lead-reset-btn {
        min-height: 42px;
        border-radius: 14px;
        border: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-weight: 950;
        text-decoration: none;
        font-size: .86rem;
    }

    .lead-search-btn {
        background: #0f172a;
        color: #fff;
    }

    .lead-reset-btn {
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .lead-list-card {
        overflow: hidden;
    }

    .list-head {
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        border-bottom: 1px solid var(--lead-border);
    }

    .list-title {
        margin: 0;
        color: var(--lead-dark);
        font-size: 1rem;
        font-weight: 950;
    }

    .list-sub {
        color: var(--lead-muted);
        font-size: .76rem;
        font-weight: 650;
        margin-top: 2px;
    }

    .list-count-pill {
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        padding: 6px 10px;
        font-size: .72rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .lead-table {
        width: 100%;
        margin: 0;
    }

        .lead-table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            font-weight: 950;
            padding: 13px 14px;
            border-bottom: 1px solid var(--lead-border);
            white-space: nowrap;
        }

        .lead-table tbody td {
            padding: 14px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
            font-size: .86rem;
        }

        .lead-table tbody tr:hover {
            background: #f8fafc;
        }

    .customer-name {
        color: var(--lead-dark);
        font-size: .95rem;
        font-weight: 950;
        line-height: 1.25;
    }

    .mini-line {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--lead-muted);
        font-size: .76rem;
        line-height: 1.35;
        font-weight: 700;
        margin-top: 4px;
        min-width: 0;
    }

        .mini-line a {
            color: #059669;
            text-decoration: none;
            font-weight: 900;
        }

    .source-title {
        color: #1d4ed8;
        font-size: .86rem;
        font-weight: 900;
        line-height: 1.35;
        max-width: 290px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .source-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 7px;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .68rem;
        font-weight: 900;
    }

    .source-property {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .source-project {
        background: #ecfeff;
        color: #0e7490;
    }

    .source-none {
        background: #f1f5f9;
        color: #475569;
    }

    .status-pill,
    .remind-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        white-space: nowrap;
        font-weight: 950;
    }

    .status-pill {
        padding: 6px 10px;
        font-size: .68rem;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .st-new {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .st-contacted {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .st-closed {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .st-spam {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .remind-badge {
        padding: 6px 10px;
        font-size: .68rem;
        margin-top: 8px;
    }

    .remind-done {
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ddd6fe;
    }

    .remind-none {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .tool-row {
        display: flex;
        justify-content: center;
        gap: 7px;
    }

    .btn-admin-tool {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        transition: all .18s ease;
        position: relative;
    }

        .btn-admin-tool:hover {
            transform: translateY(-1px);
        }

    .btn-reminded {
        background: #f5f3ff !important;
        border-color: #a78bfa !important;
        color: #7c3aed !important;
    }

    .mini-dot {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 14px;
        height: 14px;
        background: #7c3aed;
        border: 2px solid #fff;
        border-radius: 50%;
    }

    .lead-mobile-list {
        display: none;
    }

    .lead-mobile-card {
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 17px;
        box-shadow: 0 7px 18px rgba(15,23,42,.045);
        padding: 12px;
        margin-bottom: 10px;
    }

    .mobile-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 10px;
    }

    .customer-avatar {
        width: 40px;
        height: 40px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: #1d4ed8;
        font-weight: 950;
        flex: 0 0 auto;
    }

    .mobile-info-box {
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 10px;
        margin: 9px 0;
    }

    .mobile-box-label {
        color: #64748b;
        font-size: .68rem;
        text-transform: uppercase;
        font-weight: 950;
        letter-spacing: .05em;
        margin-bottom: 4px;
    }

    .mobile-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 7px;
        margin-top: 10px;
    }

    .mobile-action-btn {
        min-height: 36px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-size: .75rem;
        font-weight: 900;
    }

    .empty-box {
        padding: 42px 14px;
        text-align: center;
        color: var(--lead-muted);
    }

        .empty-box i {
            font-size: 3rem;
            opacity: .35;
            display: block;
            margin-bottom: 12px;
        }

    .pager-wrap {
        padding: 13px;
        border-top: 1px solid var(--lead-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .pagination .page-link {
        border-radius: 11px;
        margin: 0 2px;
        font-weight: 850;
        color: #334155;
        border: 1px solid #e2e8f0;
        min-width: 36px;
        text-align: center;
    }

    .pagination .active .page-link {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
    }

    .detail-row {
        display: flex;
        padding: 10px 0;
        border-bottom: 1px dashed #e2e8f0;
        gap: 12px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        width: 34%;
        color: #64748b;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 900;
    }

    .detail-value {
        width: 66%;
        color: #0f172a;
        font-size: .9rem;
        font-weight: 750;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .section-title {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #0f172a;
        background: #f1f5f9;
        border-radius: 12px;
        padding: 8px 11px;
        margin: 0 0 10px;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .05em;
        font-weight: 950;
    }

    @@media (max-width: 1199.98px) {
        .lead-stat-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .lead-admin-page {
            padding: 12px;
        }

        .lead-hero {
            align-items: flex-start;
            flex-direction: column;
        }

        .lead-export-btn {
            width: 100%;
        }

        .lead-desktop-table {
            display: none;
        }

        .lead-mobile-list {
            display: block;
            padding: 10px;
            background: #f8fafc;
        }
    }

    @@media (max-width: 767.98px) {
        .lead-admin-page {
            padding: 10px;
            margin-top: -6px;
        }

        .lead-hero {
            padding: 13px;
            border-radius: 18px;
            margin-bottom: 10px;
        }

        .lead-kicker {
            display: none;
        }

        .lead-title {
            font-size: 1.18rem;
            line-height: 1.22;
        }

        .lead-desc {
            display: none;
        }

        .lead-export-btn {
            min-height: 38px;
            font-size: .82rem;
        }

        .lead-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 7px;
            margin-bottom: 10px;
        }

        .lead-stat {
            min-height: 72px;
            border-radius: 15px;
            padding: 10px;
        }

            .lead-stat::after {
                width: 66px;
                height: 66px;
                right: -28px;
                top: -30px;
            }

        .lead-stat-label {
            font-size: .58rem;
            margin-bottom: 5px;
            letter-spacing: .04em;
        }

        .lead-stat-value {
            font-size: 1.25rem;
        }

        .lead-stat-note {
            display: none;
        }

        .filter-toggle {
            display: flex;
        }

        .filter-body {
            padding: 10px;
            display: none;
            border-top: 1px solid var(--lead-border);
        }

        .filter-shell.open .filter-body {
            display: block;
        }

        .filter-shell.open .filter-toggle i.bi-chevron-down {
            transform: rotate(180deg);
        }

        .lead-label {
            font-size: .62rem;
        }

        .lead-input,
        .lead-select,
        .lead-search-btn,
        .lead-reset-btn {
            min-height: 40px;
            border-radius: 13px !important;
            font-size: .8rem;
        }

        .list-head {
            padding: 12px;
        }

        .list-title {
            font-size: .95rem;
        }

        .list-sub {
            display: none;
        }

        .lead-mobile-list {
            padding: 8px;
        }

        .lead-mobile-card {
            padding: 10px;
            border-radius: 16px;
            margin-bottom: 8px;
        }

        .customer-avatar {
            width: 36px;
            height: 36px;
            border-radius: 13px;
            font-size: .86rem;
        }

        .customer-name {
            font-size: .9rem;
        }

        .mini-line {
            font-size: .72rem;
        }

        .source-title {
            max-width: 100%;
            font-size: .82rem;
        }

        .status-pill,
        .remind-badge {
            font-size: .62rem;
            padding: 5px 8px;
            white-space: normal;
            line-height: 1.2;
        }

        .mobile-actions {
            grid-template-columns: 1fr 1fr 42px;
        }

        .pager-wrap {
            justify-content: center;
            padding: 10px;
        }

            .pager-wrap > .text-muted {
                width: 100%;
                text-align: center;
            }

        #adminDetailModal .modal-dialog {
            margin: 10px;
        }

        #adminDetailModal .modal-content {
            border-radius: 18px !important;
        }

        #adminDetailModal .modal-header {
            padding: 14px !important;
        }

        #adminDetailModal .modal-body {
            padding: 12px !important;
        }

        #adminDetailModal .modal-footer {
            padding: 12px !important;
        }

        .detail-row {
            display: block;
            padding: 9px 0;
        }

        .detail-label, .detail-value {
            width: 100%;
        }

        .detail-label {
            margin-bottom: 3px;
            font-size: .68rem;
        }

        .detail-value {
            font-size: .84rem;
        }
    }

    @@media (max-width: 380px) {
        .lead-stat-grid {
            grid-template-columns: 1fr 1fr;
        }

        .lead-stat-label {
            font-size: .54rem;
        }

        .lead-stat-value {
            font-size: 1.15rem;
        }
    }
</style>

<div class="lead-admin-page">
    <section class="lead-card lead-hero">
        <div>
            <div class="lead-kicker">
                <i class="bi bi-headset"></i>
                Trung tâm lead tư vấn
            </div>
            <h1 class="lead-title">Giám sát yêu cầu tư vấn</h1>
            <p class="lead-desc">Kiểm soát lead, trạng thái chăm sóc khách hàng và nhắc người bán/Sales phụ trách đúng lúc.</p>
        </div>

        <a href="/Admin/Consultations/ExportCsv" class="lead-export-btn">
            <i class="bi bi-file-earmark-excel-fill"></i>
            Xuất Excel
        </a>
    </section>

    <section class="lead-stat-grid">
        <div class="lead-stat bg-total">
            <div class="lead-stat-label">Tổng lead</div>
            <div class="lead-stat-value">@total.ToString("N0")</div>
            <div class="lead-stat-note">Tất cả yêu cầu</div>
        </div>
        <div class="lead-stat bg-new">
            <div class="lead-stat-label">Mới</div>
            <div class="lead-stat-value">@newLeads.ToString("N0")</div>
            <div class="lead-stat-note">Chưa chăm sóc</div>
        </div>
        <div class="lead-stat bg-processing">
            <div class="lead-stat-label">Đang CS</div>
            <div class="lead-stat-value">@processing.ToString("N0")</div>
            <div class="lead-stat-note">Đang theo dõi</div>
        </div>
        <div class="lead-stat bg-closed">
            <div class="lead-stat-label">Đã chốt</div>
            <div class="lead-stat-value">@closed.ToString("N0")</div>
            <div class="lead-stat-note">Hoàn tất</div>
        </div>
        <div class="lead-stat bg-reminded">
            <div class="lead-stat-label">Đã nhắc</div>
            <div class="lead-stat-value">@reminded.ToString("N0")</div>
            <div class="lead-stat-note">Đã thông báo</div>
        </div>
        <div class="lead-stat bg-junk">
            <div class="lead-stat-label">Hủy/Spam</div>
            <div class="lead-stat-value">@junk.ToString("N0")</div>
            <div class="lead-stat-note">Không phù hợp</div>
        </div>
    </section>

    <section class="lead-card filter-shell" id="leadFilterShell">
        <button type="button" class="filter-toggle" onclick="toggleLeadFilter()">
            <span><i class="bi bi-funnel-fill text-primary"></i>Bộ lọc lead</span>
            <i class="bi bi-chevron-down"></i>
        </button>

        <div class="filter-body">
            <form method="get"
                  asp-action="Index"
                  asp-controller="Consultations"
                  asp-area="Admin"
                  class="row g-2 align-items-end">

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label class="lead-label">Tình trạng</label>
                    <select name="status" class="form-select lead-select">
                        <option value="All" selected="@(status == "All")">Tất cả trạng thái</option>
                        <option value="New" selected="@(status == "New")">Mới gửi</option>
                        <option value="Contacted" selected="@(status == "Contacted")">Đã liên hệ</option>
                        <option value="Closed" selected="@(status == "Closed")">Đã chốt</option>
                        <option value="Spam" selected="@(status == "Spam")">Spam</option>
                        <option value="Cancelled" selected="@(status == "Cancelled")">Khách hủy</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label class="lead-label">Nguồn</label>
                    <select name="source" class="form-select lead-select">
                        <option value="All" selected="@(source == "All")">Mọi nguồn</option>
                        <option value="Property" selected="@(source == "Property")">Tin lẻ BĐS</option>
                        <option value="Project" selected="@(source == "Project")">Dự án</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label class="lead-label">Thời gian</label>
                    <select name="dateRange" class="form-select lead-select">
                        <option value="all" selected="@(dateRange == "all")">Toàn thời gian</option>
                        <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                        <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                        <option value="month" selected="@(dateRange == "month")">1 tháng qua</option>
                    </select>
                </div>

                <div class="col-xl-4 col-lg-9 col-md-8">
                    <label class="lead-label">Tìm kiếm</label>
                    <input type="text"
                           name="keyword"
                           value="@keyword"
                           class="form-control lead-input"
                           placeholder="Tên khách, SĐT, email, tên BĐS, dự án..." />
                </div>

                <div class="col-xl-2 col-lg-3 col-md-4">
                    <div class="d-grid gap-2" style="grid-template-columns: 1fr 42px;">
                        <button class="lead-search-btn">
                            <i class="bi bi-search"></i>
                            Tìm
                        </button>
                        <a href="/Admin/Consultations/Index" class="lead-reset-btn" title="Xóa lọc">
                            <i class="bi bi-arrow-clockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </section>

    <section class="lead-card lead-list-card">
        <div class="list-head">
            <div>
                <h2 class="list-title"><i class="bi bi-list-check text-primary me-1"></i>Danh sách yêu cầu</h2>
                <div class="list-sub">Lead mới và lead chưa thông báo người bán nên được ưu tiên xử lý.</div>
            </div>
            <span class="list-count-pill">@((Model == null ? 0 : Model.Count()).ToString("N0")) dòng</span>
        </div>

        <div class="lead-desktop-table table-responsive">
            <table class="table lead-table align-middle">
                <thead>
                    <tr>
                        <th style="width:23%">Khách hàng</th>
                        <th style="width:27%">Nguồn quan tâm</th>
                        <th style="width:19%">Phụ trách</th>
                        <th style="width:13%">Trạng thái</th>
                        <th style="width:18%" class="text-center">Công cụ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            var sourceName = c.Property?.Title ?? c.Project?.ProjectName ?? "Nguồn không xác định";
                            var handlerName = c.AssignedUser?.FullName ?? c.Property?.User?.FullName ?? c.Project?.Owner?.FullName ?? "Chưa phân công";

                            bool wasReminded = !string.IsNullOrWhiteSpace(c.SellerNote)
                            && c.SellerNote.Contains(RemindMarker, StringComparison.OrdinalIgnoreCase);

                            string stClass = "st-new";
                            string stText = "Mới gửi";

                            switch (c.Status)
                            {
                                case "Contacted":
                                    stClass = "st-contacted";
                                    stText = "Đang CS";
                                    break;
                                case "Closed":
                                    stClass = "st-closed";
                                    stText = "Đã chốt";
                                    break;
                                case "Cancelled":
                                    stClass = "st-spam";
                                    stText = "Khách hủy";
                                    break;
                                case "Spam":
                                    stClass = "st-spam";
                                    stText = "Spam";
                                    break;
                            }

                            <tr id="lead-row-@c.ConsultID">
                                <td>
                                    <div class="customer-name">@(c.FullName ?? "Khách vãng lai")</div>
