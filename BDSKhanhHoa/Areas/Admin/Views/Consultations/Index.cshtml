@model IEnumerable<BDSKhanhHoa.Models.Consultation>

@{
    ViewData["Title"] = "Giám sát Yêu cầu Tư vấn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string status = ViewBag.Status as string ?? "All";
    string keyword = ViewBag.Keyword as string ?? "";
    string source = ViewBag.Source as string ?? "All";
    string dateRange = ViewBag.DateRange as string ?? "all";

    int total = ViewBag.TotalLeads ?? 0;
    int newLeads = ViewBag.NewLeads ?? 0;
    int processing = ViewBag.ProcessingLeads ?? 0;
    int closed = ViewBag.ClosedLeads ?? 0;
    int junk = ViewBag.JunkLeads ?? 0;
    int reminded = ViewBag.RemindedLeads ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string RemindMarker = "[REMIND_SELLER]";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .admin-box {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(148,163,184,.16);
        box-shadow: 0 10px 30px rgba(15, 23, 42, .04);
        margin-bottom: 24px;
    }

    .fw-black {
        font-weight: 900;
    }

    .stat {
        padding: 24px;
        border-radius: 20px;
        color: #fff;
        min-height: 135px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 25px rgba(15, 23, 42, .06);
        transition: transform .25s ease;
    }

        .stat:hover {
            transform: translateY(-4px);
        }

    .bg-total {
        background: linear-gradient(135deg, #1e293b, #334155);
    }

    .bg-new {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .bg-processing {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
    }

    .bg-closed {
        background: linear-gradient(135deg, #047857, #10b981);
    }

    .bg-junk {
        background: linear-gradient(135deg, #475569, #94a3b8);
    }

    .bg-reminded {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
    }

    .stat .label {
        text-transform: uppercase;
        font-size: .78rem;
        letter-spacing: .08em;
        opacity: .92;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .stat .value {
        font-size: 2.55rem;
        font-weight: 900;
        line-height: 1;
    }

    .soft-input {
        min-height: 48px;
        border-radius: 12px;
        font-weight: 600;
        border: 1px solid #cbd5e1;
        box-shadow: none !important;
        font-size: .95rem;
    }

        .soft-input:focus {
            border-color: #3b82f6;
        }

    .table thead th {
        background: #f8fafc;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        color: #475569;
        white-space: nowrap;
        padding: 18px;
        border-bottom: 2px solid #e2e8f0;
    }

    .table tbody td {
        padding: 18px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .table tbody tr:hover {
        background-color: #f8fafc;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .06em;
        white-space: nowrap;
    }

    .st-new {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .st-contacted {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .st-closed {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .st-spam {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .remind-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 900;
        letter-spacing: .04em;
        white-space: nowrap;
    }

    .remind-done {
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ddd6fe;
    }

    .remind-none {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .btn-admin-tool {
        width: 38px;
        height: 38px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 10px;
        transition: all .2s;
        position: relative;
    }

        .btn-admin-tool:hover {
            transform: translateY(-1px);
        }

    .btn-reminded {
        background: #f5f3ff !important;
        border-color: #a78bfa !important;
        color: #7c3aed !important;
    }

    .mini-dot {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 15px;
        height: 15px;
        background: #7c3aed;
        border: 2px solid #fff;
        border-radius: 50%;
    }

    .detail-row {
        display: flex;
        padding: 12px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        width: 35%;
        font-weight: 800;
        color: #64748b;
        font-size: .86rem;
        text-transform: uppercase;
    }

    .detail-value {
        width: 65%;
        font-weight: 700;
        color: #0f172a;
        font-size: .95rem;
        white-space: pre-wrap;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 900;
        color: #0f172a;
        text-transform: uppercase;
        letter-spacing: .05em;
        background: #f1f5f9;
        padding: 10px 16px;
        border-radius: 8px;
        margin: 20px 0 10px;
    }

    .pagination .page-link {
        border-radius: 10px;
        margin: 0 3px;
        font-weight: 700;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .pagination .active .page-link {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
    }

    .lead-note {
        font-size: .82rem;
        color: #64748b;
        line-height: 1.5;
    }

    @@media (max-width: 768px) {
        .table thead {
            display: none;
        }

        .table tbody tr {
            display: block;
            margin: 14px;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(15,23,42,.05);
        }

        .table tbody td {
            display: block;
            padding: 14px 16px;
        }

        .detail-row {
            display: block;
        }

        .detail-label,
        .detail-value {
            width: 100%;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-black mb-1 text-dark">
            <i class="bi bi-headset text-primary me-2"></i>
            Giám sát Yêu cầu Tư vấn
        </h2>

        <div class="text-muted">
            Kiểm soát leads, theo dõi chăm sóc khách hàng và trạng thái đã thông báo người bán.
        </div>
    </div>

    <a href="/Admin/Consultations/ExportCsv" class="btn btn-success fw-bold rounded-pill shadow-sm px-4 py-2">
        <i class="bi bi-file-earmark-excel-fill me-2"></i>
        Xuất Excel
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-total">
            <div class="label">Tổng Leads</div>
            <div class="value">@total.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-new">
            <div class="label">Mới chưa CS</div>
            <div class="value">@newLeads.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-processing">
            <div class="label">Đang CS</div>
            <div class="value">@processing.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-closed">
            <div class="label">Đã chốt</div>
            <div class="value">@closed.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-reminded">
            <div class="label">Đã nhắc</div>
            <div class="value">@reminded.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-junk">
            <div class="label">Hủy / Spam</div>
            <div class="value">@junk.ToString("N0")</div>
        </div>
    </div>
</div>

<div class="admin-box p-4">
    <form method="get"
          asp-action="Index"
          asp-controller="Consultations"
          asp-area="Admin"
          class="row g-3 align-items-end">

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Tình trạng CS</label>
            <select name="status" class="form-select soft-input">
                <option value="All" selected="@(status == "All")">Tất cả trạng thái</option>
                <option value="New" selected="@(status == "New")">Mới gửi</option>
                <option value="Contacted" selected="@(status == "Contacted")">Đã liên hệ</option>
                <option value="Closed" selected="@(status == "Closed")">Đã chốt</option>
                <option value="Spam" selected="@(status == "Spam")">Spam</option>
                <option value="Cancelled" selected="@(status == "Cancelled")">Khách hủy</option>
            </select>
        </div>

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Nguồn</label>
            <select name="source" class="form-select soft-input">
                <option value="All" selected="@(source == "All")">Mọi nguồn</option>
                <option value="Property" selected="@(source == "Property")">Tin lẻ BĐS</option>
                <option value="Project" selected="@(source == "Project")">Dự án</option>
            </select>
        </div>

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Thời gian</label>
            <select name="dateRange" class="form-select soft-input">
                <option value="all" selected="@(dateRange == "all")">Toàn thời gian</option>
                <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                <option value="month" selected="@(dateRange == "month")">1 tháng qua</option>
            </select>
        </div>

        <div class="col-xl-4 col-lg-9 col-md-8">
            <label class="form-label fw-bold small text-muted text-uppercase">Tìm kiếm</label>
            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control soft-input"
                   placeholder="Tên khách, SĐT, email, tên BĐS, dự án..." />
        </div>

        <div class="col-xl-2 col-lg-3 col-md-4 d-grid">
            <button class="btn btn-dark rounded-3 fw-bold shadow-sm" style="min-height:48px;">
                <i class="bi bi-search me-1"></i>
                Tra cứu
            </button>
        </div>
    </form>
</div>

<div class="admin-box">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:22%">Khách hàng</th>
                    <th style="width:24%">Nguồn BĐS / Dự án</th>
                    <th style="width:18%">Phụ trách</th>
                    <th style="width:16%">Tình trạng</th>
                    <th style="width:20%" class="text-center">Công cụ Admin</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        var sourceName = c.Property?.Title ?? c.Project?.ProjectName ?? "Nguồn không xác định";
                        var handlerName = c.AssignedUser?.FullName ?? c.Property?.User?.FullName ?? c.Project?.Owner?.FullName ?? "Chưa phân công";

                        bool wasReminded = !string.IsNullOrWhiteSpace(c.SellerNote)
                        && c.SellerNote.Contains(RemindMarker, StringComparison.OrdinalIgnoreCase);

                        string stClass = "st-new";
                        string stText = "Mới gửi";

                        switch (c.Status)
                        {
                            case "New":
                                stClass = "st-new";
                                stText = "Mới gửi";
                                break;

                            case "Contacted":
                                stClass = "st-contacted";
                                stText = "Đang CS";
                                break;

                            case "Closed":
                                stClass = "st-closed";
                                stText = "Đã chốt";
                                break;

                            case "Cancelled":
                                stClass = "st-spam";
                                stText = "Khách hủy";
                                break;

                            case "Spam":
                                stClass = "st-spam";
                                stText = "Spam";
                                break;
                        }

                        <tr id="lead-row-@c.ConsultID">
                            <td>
                                <div class="fw-bold text-dark fs-6">
                                    @(c.FullName ?? "Khách vãng lai")
                                </div>

                                <div class="text-success small mt-1 fw-bold">
                                    <i class="bi bi-telephone-fill"></i>
                                    @(c.Phone ?? "N/A")
                                </div>

                                @if (!string.IsNullOrWhiteSpace(c.Email))
                                {
                                    <div class="text-muted small mt-1">
                                        <i class="bi bi-envelope"></i>
                                        @c.Email
                                    </div>
                                }

                                <div class="text-muted small mt-1">
                                    <i class="bi bi-clock"></i>
                                    @c.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                                </div>
                            </td>

                            <td>
                                <div class="fw-semibold text-primary text-truncate"
                                     style="max-width:260px;"
                                     title="@sourceName">
                                    @sourceName
                                </div>

                                @if (c.PropertyID != null)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary mt-2">
                                        Tin rao vặt
                                    </span>
                                }
                                else if (c.ProjectID != null)
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info text-dark mt-2">
                                        Dự án
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary mt-2">
                                        Không rõ nguồn
                                    </span>
                                }

                                <div class="mt-2" id="remind-badge-@c.ConsultID">
                                    @if (wasReminded)
                                    {
                                        <span class="remind-badge remind-done">
                                            <i class="bi bi-check2-circle"></i>
                                            Đã thông báo người bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="remind-badge remind-none">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Chưa thông báo
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="fw-bold text-dark">@handlerName</div>
                                <div class="text-muted small mt-1">Sale / Chủ tin / CĐT</div>

                                @if (c.UpdatedAt != null)
                                {
                                    <div class="lead-note mt-2">
                                        <i class="bi bi-arrow-clockwise"></i>
                                        Cập nhật: @c.UpdatedAt?.ToString("HH:mm dd/MM/yyyy")
                                    </div>
                                }
                            </td>

                            <td>
                                <span class="status-pill @stClass">
                                    @stText
                                </span>
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button"
                                            class="btn btn-outline-info btn-admin-tool"
                                            onclick="openAdminDetailModal(@c.ConsultID)"
                                            title="Xem chi tiết Lead">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>

                                    <form class="m-0" id="frmRemind-@c.ConsultID">
                                        @Html.AntiForgeryToken()

                                        <button type="button"
                                                id="btn-remind-@c.ConsultID"
                                                class="btn btn-outline-warning btn-admin-tool @(wasReminded ? "btn-reminded" : "")"
                                                onclick="postAdminRemind('@Url.Action("RemindSeller", "Consultations", new { area = "Admin" })', @c.ConsultID, false)"
                                                title="@(wasReminded ? "Đã thông báo rồi - bấm để nhắc lại nếu thật sự cần" : "Gửi thông báo nhắc người bán")">
                                            <i class="bi bi-bell-fill"></i>
                                            @if (wasReminded)
                                            {
                                                <span class="mini-dot"></span>
                                            }
                                        </button>
                                    </form>

                                    <form class="m-0" id="frmDel-@c.ConsultID">
                                        @Html.AntiForgeryToken()

                                        <button type="button"
                                                class="btn btn-outline-danger btn-admin-tool"
                                                onclick="postAdminDelete('@Url.Action("Delete", "Consultations", new { area = "Admin" })', @c.ConsultID)"
                                                title="Xóa rác / Spam">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>

                                @if (wasReminded)
                                {
                                    <div class="small text-muted mt-2" id="remind-text-@c.ConsultID">
                                        Đã thông báo
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-warning fw-bold mt-2" id="remind-text-@c.ConsultID">
                                        Chưa thông báo
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <i class="bi bi-headset display-1 opacity-25 d-block mb-3"></i>
                            <h4 class="fw-bold">Không tìm thấy yêu cầu tư vấn</h4>
                            <p>Thử điều chỉnh lại bộ lọc tìm kiếm.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-4 border-top">
            <div class="text-muted small fw-semibold">
                Trang @currentPage / @totalPages
            </div>

            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Consultations"
                           asp-action="Index"
                           asp-route-status="@status"
                           asp-route-keyword="@keyword"
                           asp-route-source="@source"
                           asp-route-dateRange="@dateRange"
                           asp-route-page="@(currentPage - 1)">
                            Trước
                        </a>
                    </li>

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="Consultations"
                               asp-action="Index"
                               asp-route-status="@status"
                               asp-route-keyword="@keyword"
                               asp-route-source="@source"
                               asp-route-dateRange="@dateRange"
                               asp-route-page="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Consultations"
                           asp-action="Index"
                           asp-route-status="@status"
                           asp-route-keyword="@keyword"
                           asp-route-source="@source"
                           asp-route-dateRange="@dateRange"
                           asp-route-page="@(currentPage + 1)">
                            Sau
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<div class="modal fade" id="adminDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-dark text-white border-0 p-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-person-vcard me-2"></i>
                    Hồ sơ Tư vấn
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4 bg-light">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded-4 border shadow-sm h-100">
                            <div class="section-title mt-0">
                                <i class="bi bi-person-bounding-box text-primary me-2"></i>
                                Khách hàng
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Họ tên</div>
                                <div class="detail-value text-primary" id="md-cusName"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Điện thoại</div>
                                <div class="detail-value text-success" id="md-cusPhone"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Email</div>
                                <div class="detail-value" id="md-cusEmail"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Thời gian gửi</div>
                                <div class="detail-value" id="md-createdAt"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded-4 border shadow-sm h-100">
                            <div class="section-title mt-0">
                                <i class="bi bi-buildings text-info me-2"></i>
                                Bất động sản & Sales
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Nguồn BĐS</div>
                                <div class="detail-value text-dark fw-bold" id="md-sourceName"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Phân loại</div>
                                <div class="detail-value text-muted" id="md-sourceType"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Phụ trách</div>
                                <div class="detail-value text-success" id="md-handlerName"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">SĐT Sales</div>
                                <div class="detail-value" id="md-handlerPhone"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Trạng thái nhắc</div>
                                <div class="detail-value" id="md-remindedText"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-4 border shadow-sm">
                    <div class="section-title mt-0 bg-warning bg-opacity-10 text-dark">
                        <i class="bi bi-chat-dots-fill me-2 text-warning"></i>
                        Nội dung & Lịch sử CSKH
                    </div>

                    <h6 class="fw-bold text-dark mb-2 mt-3 text-uppercase" style="font-size:.8rem;">
                        Lời nhắn từ khách:
                    </h6>

                    <div class="p-3 bg-light border rounded-3 text-dark fw-medium mb-4 fst-italic"
                         style="white-space:pre-wrap;"
                         id="md-note"></div>

                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size:.8rem;">
                            Ghi chú Sales / Lịch sử Admin nhắc:
                        </h6>

                        <span class="badge bg-dark" id="md-status"></span>
                    </div>

                    <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 text-dark font-monospace small"
                         style="white-space:pre-wrap; max-height:240px; overflow-y:auto;"
                         id="md-sellerNote"></div>
                </div>
            </div>

            <div class="modal-footer border-0 p-4 pt-0 bg-light">
                <button type="button"
                        class="btn btn-dark rounded-pill px-5 fw-bold shadow-sm"
                        data-bs-dismiss="modal">
                    Đóng cửa sổ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function postAdminRemind(url, id, force) {
            const isForce = force === true;

            Swal.fire({
                title: isForce ? 'Gửi nhắc lại?' : 'Gửi thông báo nhắc người bán?',
                text: isForce
                    ? 'Lead này đã từng được thông báo. Bạn vẫn muốn gửi thêm một thông báo nữa?'
                    : 'Hệ thống sẽ gửi thông báo cho người bán/Sales phụ trách và đánh dấu Lead là đã thông báo.',
                icon: isForce ? 'warning' : 'info',
                showCancelButton: true,
                confirmButtonColor: isForce ? '#7c3aed' : '#f59e0b',
                cancelButtonColor: '#64748b',
                confirmButtonText: isForce ? 'Gửi nhắc lại' : 'Gửi thông báo',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const tokenInput = document.querySelector(`#frmRemind-${id} input[name="__RequestVerificationToken"]`);

                if (!tokenInput) {
                    Swal.fire('Lỗi', 'Không tìm thấy mã xác thực form.', 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('id', id);
                formData.append('force', isForce);
                formData.append('__RequestVerificationToken', tokenInput.value);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            markLeadAsReminded(id);

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message,
                                showConfirmButton: false,
                                timer: 2600
                            });
                        }
                        else if (data.code === 'ALREADY_REMINDED') {
                            Swal.fire({
                                title: 'Đã thông báo rồi',
                                text: data.message,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#7c3aed',
                                cancelButtonColor: '#64748b',
                                confirmButtonText: 'Vẫn gửi nhắc lại',
                                cancelButtonText: 'Không gửi nữa'
                            }).then((confirmAgain) => {
                                if (confirmAgain.isConfirmed) {
                                    postAdminRemind(url, id, true);
                                }
                            });
                        }
                        else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    });
            });
        }

        function markLeadAsReminded(id) {
            const badgeBox = document.getElementById(`remind-badge-${id}`);
            const btn = document.getElementById(`btn-remind-${id}`);
            const text = document.getElementById(`remind-text-${id}`);

            if (badgeBox) {
                badgeBox.innerHTML = `
                    <span class="remind-badge remind-done">
                        <i class="bi bi-check2-circle"></i>
                        Đã thông báo người bán
                    </span>`;
            }

            if (btn) {
                btn.classList.remove('btn-outline-warning');
                btn.classList.add('btn-reminded');
                btn.setAttribute('title', 'Đã thông báo rồi - bấm để nhắc lại nếu thật sự cần');

                if (!btn.querySelector('.mini-dot')) {
                    btn.insertAdjacentHTML('beforeend', '<span class="mini-dot"></span>');
                }
            }

            if (text) {
                text.className = 'small text-muted mt-2';
                text.innerText = 'Đã thông báo';
            }
        }

        function postAdminDelete(url, id) {
            Swal.fire({
                title: 'Xóa VĨNH VIỄN?',
                text: 'Hành động này sẽ xóa yêu cầu tư vấn khỏi hệ thống.',
                icon: 'error',
                input: 'checkbox',
                inputValue: 0,
                inputPlaceholder: ' Đồng thời đánh dấu là Spam?',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xóa ngay',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const tokenInput = document.querySelector(`#frmDel-${id} input[name="__RequestVerificationToken"]`);

                if (!tokenInput) {
                    Swal.fire('Lỗi', 'Không tìm thấy mã xác thực form.', 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('id', id);
                formData.append('blockSpam', result.value ? true : false);
                formData.append('__RequestVerificationToken', tokenInput.value);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Đã xử lý', data.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    });
            });
        }

        function openAdminDetailModal(id) {
            Swal.fire({
                title: 'Đang tải...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            fetch(`/Admin/Consultations/GetDetails?id=${id}`)
                .then(response => response.json())
                .then(res => {
                    Swal.close();

                    if (!res.success) {
                        Swal.fire('Lỗi', res.message, 'error');
                        return;
                    }

                    const d = res.data;

                    document.getElementById('md-cusName').innerText = d.customerName;
                    document.getElementById('md-cusPhone').innerText = d.customerPhone;
                    document.getElementById('md-cusEmail').innerText = d.customerEmail;
                    document.getElementById('md-createdAt').innerText = d.createdAt;

                    document.getElementById('md-sourceName').innerText = d.sourceName;
                    document.getElementById('md-sourceType').innerText = d.sourceType;
                    document.getElementById('md-handlerName').innerText = d.handlerName;
                    document.getElementById('md-handlerPhone').innerText = d.handlerPhone;

                    document.getElementById('md-remindedText').innerHTML = d.wasReminded
                        ? '<span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i> Đã thông báo người bán</span>'
                        : '<span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i> Chưa thông báo</span>';

                    document.getElementById('md-note').innerText = d.note;
                    document.getElementById('md-sellerNote').innerText = d.sellerNote;
                    document.getElementById('md-status').innerText = d.status;

                    new bootstrap.Modal(document.getElementById('adminDetailModal')).show();
                })
                .catch(() => {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể lấy dữ liệu yêu cầu tư vấn.', 'error');
                });
        }
    </script>
}