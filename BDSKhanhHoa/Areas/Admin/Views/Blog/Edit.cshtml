@model BDSKhanhHoa.Models.Blog
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa Bài viết";
}

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .blog-form-page {
        --bf-primary: #2563eb;
        --bf-dark: #0f172a;
        --bf-muted: #64748b;
        --bf-border: #e2e8f0;
        --bf-soft: #f8fafc;
        padding: 16px;
        overflow-x: hidden;
    }

        .blog-form-page * {
            box-sizing: border-box;
        }

    .blog-form-head,
    .blog-form-card,
    .blog-side-card {
        background: #fff;
        border: 1px solid var(--bf-border);
        border-radius: 20px;
        box-shadow: 0 10px 28px rgba(15,23,42,.055);
    }

    .blog-form-head {
        padding: 13px 15px;
        margin-bottom: 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .blog-form-title {
        margin: 0;
        color: var(--bf-dark);
        font-weight: 900;
        letter-spacing: -.03em;
        font-size: clamp(1.1rem, 2vw, 1.45rem);
    }

    .blog-form-page .form-label {
        color: #1e293b;
        font-weight: 850;
        margin-bottom: 7px;
    }

    .blog-form-page .form-control,
    .blog-form-page .form-select {
        min-height: 44px;
        border-radius: 14px;
        border-color: var(--bf-border);
        background: var(--bf-soft);
        font-weight: 700;
        box-shadow: none !important;
    }

    .blog-form-page textarea.form-control {
        min-height: 96px;
        line-height: 1.55;
    }

    .blog-form-card,
    .blog-side-card {
        padding: 16px;
    }

    .img-upload-zone {
        border: 2px dashed #bfdbfe;
        border-radius: 18px;
        height: 190px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        cursor: pointer;
        overflow: hidden;
        position: relative;
        transition: 0.2s ease;
    }

        .img-upload-zone:hover {
            border-color: var(--bf-primary);
            background: #dbeafe;
        }

    #preview {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
        position: absolute;
        top: 0;
        left: 0;
    }

    .ql-toolbar.ql-snow {
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
        background: #f8fafc;
        border-color: #e2e8f0;
        padding: 8px;
    }

    .ql-container.ql-snow {
        border-bottom-left-radius: 14px;
        border-bottom-right-radius: 14px;
        border-color: #e2e8f0;
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
    }

    .ql-editor {
        min-height: 360px;
    }

    .blog-side-card {
        position: sticky;
        top: 88px;
    }

    .save-actions {
        display: grid;
        gap: 8px;
    }

        .save-actions .btn {
            min-height: 44px;
            border-radius: 999px;
            font-weight: 900;
        }

    @@media (max-width: 991.98px) {
        .blog-side-card {
            position: static;
        }
    }

    @@media (max-width: 767.98px) {
        .blog-form-page {
            padding: 10px;
        }

        .blog-form-head {
            padding: 12px;
            border-radius: 18px;
        }

            .blog-form-head .btn {
                min-width: 42px;
                width: 42px;
                height: 42px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .blog-form-head .btn span {
                    display: none;
                }

        .blog-form-card,
        .blog-side-card {
            padding: 12px;
            border-radius: 18px;
        }

        .img-upload-zone {
            height: 155px;
        }

        .ql-toolbar.ql-snow {
            max-height: 106px;
            overflow-y: auto;
        }

        .ql-editor {
            min-height: 280px;
        }

        .save-actions {
            position: sticky;
            bottom: 0;
            z-index: 10;
            background: rgba(255,255,255,.96);
            backdrop-filter: blur(10px);
            margin-left: -12px;
            margin-right: -12px;
            margin-bottom: -12px;
            padding: 10px;
            border-top: 1px solid var(--bf-border);
        }
    }
</style>

<div class="blog-form-page">
    <section class="blog-form-head">
        <h3 class="blog-form-title">
            <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa bài viết
        </h3>

        <a href="/Admin/Blog/Index" class="btn btn-light border fw-bold text-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i><span>Trở về</span>
        </a>
    </section>

    <form asp-area="Admin" asp-controller="Blog" asp-action="Edit" method="post" enctype="multipart/form-data" id="blogForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="BlogID" />
        <input type="hidden" asp-for="ImageURL" />
        <input type="hidden" asp-for="UserID" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="Views" />

        <div class="row g-3">
            <div class="col-lg-8">
                <section class="blog-form-card">
                    <div class="mb-3">
                        <label class="form-label">Danh mục bài viết <span class="text-danger">*</span></label>
                        <select asp-for="Category" asp-items="ViewBag.Categories" class="form-select fw-bold text-primary" required>
                            <option value="">-- Chọn danh mục chuyên trang --</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control form-control-lg" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tóm tắt ngắn</label>
                        <textarea asp-for="Summary" class="form-control" rows="3" placeholder="Đoạn văn ngắn hiển thị ở trang danh sách tin tức..."></textarea>
                        <span asp-validation-for="Summary" class="text-danger small"></span>
                    </div>

                    <div>
                        <label class="form-label">Nội dung chi tiết <span class="text-danger">*</span></label>
                        <input type="hidden" asp-for="Content" id="hiddenContent" />
                        <div id="editor-container">
                            @Html.Raw(Model.Content)
                        </div>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <aside class="blog-side-card">
                    <h6 class="fw-bold mb-3 text-dark">
                        <i class="bi bi-image text-primary me-2"></i>Ảnh đại diện
                    </h6>

                    <div class="mb-3">
                        <label for="imageFile" class="img-upload-zone w-100 d-block">
                            <img id="preview" src="@(string.IsNullOrEmpty(Model.ImageURL) ? "/images/no-image.jpg" : Model.ImageURL)" alt="Ảnh đại diện" onerror="this.src='/images/no-image.jpg'" style="display:block;" />
                            <div id="uploadPlaceholder" class="text-center text-white p-2" style="position:absolute;bottom:0;width:100%;background:rgba(0,0,0,.58);backdrop-filter:blur(2px);">
                                <i class="bi bi-camera me-1"></i> Đổi ảnh khác
                            </div>
                        </label>
                        <input type="file" id="imageFile" name="imageFile" class="d-none" accept="image/*" onchange="previewImage(this)" />
                    </div>

                    <div class="bg-light p-3 rounded-4 mb-3 small border">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted fw-bold">Lượt xem:</span>
                            <span class="text-primary fw-bold">@Model.Views</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted fw-bold">Ngày đăng:</span>
                            <span class="text-dark fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>

                    <div class="save-actions">
                        <button type="submit" class="btn btn-primary shadow-sm">
                            <i class="bi bi-floppy me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </aside>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <script>
        var quill = new Quill('#editor-container', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ 'header': [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                    [{ 'color': [] }, { 'background': [] }],
                    ['link', 'image', 'video'],
                    ['clean']
                ]
            },
                    });

        quill.getModule('toolbar').addHandler('image', function () {
            selectLocalImage();
        });

        function selectLocalImage() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();

            input.onchange = () => {
                const file = input.files[0];
                if (file) {
                    saveToServer(file);
                }
            };
        }

        function saveToServer(file) {
            const fd = new FormData();
            fd.append('file', file);

            fetch('/Admin/Blog/UploadImageContents', {
                method: 'POST',
                body: fd
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    insertToEditor(result.url);
                } else {
                    alert(result.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Tải ảnh thất bại!');
            });
        }

        function insertToEditor(url) {
            const range = quill.getSelection(true);
            quill.insertEmbed(range.index, 'image', url);
            quill.setSelection(range.index + 1);
        }

        document.getElementById('blogForm').onsubmit = function() {
            document.getElementById('hiddenContent').value = quill.root.innerHTML;
        };

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var preview = document.getElementById('preview');
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
