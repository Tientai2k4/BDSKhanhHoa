@model BDSKhanhHoa.Models.StaticPage

@{
    ViewData["Title"] = "Thêm trang tĩnh mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<style>
    .page-form-page {
        padding: 12px 0 40px;
    }

    .page-form-wrap {
        max-width: 1180px;
        margin: 0 auto;
    }

    .form-card {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 12px 32px rgba(15, 23, 42, .07);
        overflow: hidden;
    }

    .form-head {
        padding: 18px 22px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        background: #fff;
    }

    .head-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.22rem;
        line-height: 1.25;
        font-weight: 900;
        letter-spacing: -.02em;
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .head-title i {
            width: 36px;
            height: 36px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: #2563eb;
            font-size: 1rem;
        }

    .head-subtitle {
        margin: 5px 0 0;
        color: #64748b;
        font-size: .92rem;
        font-weight: 500;
    }

    .page-btn {
        min-height: 42px;
        border-radius: 999px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-weight: 900;
    }

    .form-body {
        padding: 22px;
    }

    .page-label {
        color: #334155;
        font-size: .8rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 8px;
    }

    .page-control {
        min-height: 46px;
        border-radius: 14px;
        border: 1.5px solid #dbe4ef;
        background: #f8fafc;
        color: #0f172a;
        font-size: .94rem;
        font-weight: 650;
        box-shadow: none !important;
    }

        .page-control:focus {
            background: #fff;
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .09) !important;
        }

    .help-text {
        display: block;
        margin-top: 7px;
        color: #64748b;
        font-size: .8rem;
        font-weight: 600;
    }

    .field-validation-error,
    .text-danger {
        font-size: .82rem;
        font-weight: 700;
    }

    .editor-box {
        border-radius: 16px;
        overflow: hidden;
        border: 1.5px solid #dbe4ef;
    }

    .ql-toolbar.ql-snow {
        border: 0;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        padding: 10px;
    }

    .ql-container.ql-snow {
        border: 0;
        font-family: Arial, sans-serif;
        font-size: 1rem;
        background: #fff;
    }

    .ql-editor {
        min-height: 380px;
        line-height: 1.75;
        color: #334155;
    }

    .form-actions {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    @@media (max-width: 767.98px) {
        .page-form-page {
            padding-top: 10px;
        }

        .form-head,
        .form-body {
            padding: 16px;
        }

        .head-title {
            font-size: 1.1rem;
        }

        .ql-editor {
            min-height: 300px;
        }

        .form-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

        .page-btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid page-form-page">
    <div class="page-form-wrap">
        <div class="form-card">
            <div class="form-head">
                <div>
                    <h1 class="head-title">
                        <i class="bi bi-plus-lg"></i>
                        Tạo trang tĩnh mới
                    </h1>
                    <p class="head-subtitle">
                        Tạo nội dung cho FAQ, điều khoản, chính sách, báo giá đăng tin hoặc trang hỗ trợ hệ thống.
                    </p>
                </div>

                <a asp-action="Index" class="btn btn-light border page-btn">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại
                </a>
            </div>

            <div class="form-body">
                <form asp-action="Create" method="post" id="pageForm" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-lg-4">
                            <label asp-for="PageKey" class="form-label page-label">
                                Mã định danh <span class="text-danger">*</span>
                            </label>

                            <input asp-for="PageKey"
                                   class="form-control page-control"
                                   placeholder="VD: faq, terms, privacy..."
                                   required />

                            <span asp-validation-for="PageKey" class="text-danger"></span>

                            <small class="help-text">
                                Link sẽ có dạng: <b>/Page/ma-dinh-danh</b>
                            </small>
                        </div>

                        <div class="col-lg-8">
                            <label asp-for="Title" class="form-label page-label">
                                Tiêu đề trang <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Title"
                                   class="form-control page-control"
                                   placeholder="VD: Điều khoản sử dụng dịch vụ"
                                   required />

                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label page-label">
                            Mô tả ngắn
                        </label>

                        <input asp-for="Description"
                               class="form-control page-control"
                               placeholder="Mô tả ngắn dùng để quản lý, SEO hoặc chia sẻ link..." />

                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="Content" class="form-label page-label">
                            Nội dung chi tiết <span class="text-danger">*</span>
                        </label>

                        <input type="hidden" asp-for="Content" id="hiddenContent" />

                        <div class="editor-box">
                            <div id="editor-container">
                                @if (!string.IsNullOrEmpty(Model?.Content))
                                {
                                    @Html.Raw(Model.Content)
                                }
                            </div>
                        </div>

                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn btn-light border page-btn">
                            Hủy
                        </a>

                        <button type="submit" class="btn btn-primary page-btn">
                            <i class="bi bi-plus-circle-fill"></i>
                            Xuất bản trang
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>

    <script>
        let quill;

        function imageHandler() {
            const input = document.createElement('input');
            input.setAttribute('type', 'file');
            input.setAttribute('accept', 'image/*');
            input.click();

            input.onchange = async function () {
                const file = input.files && input.files[0];

                if (!file) {
                    return;
                }

                const formData = new FormData();
                formData.append('upload', file);

                try {
                    const response = await fetch('/Admin/Pages/UploadImage', {
                        method: 'POST',
                        body: formData
                    });

                    const res = await response.json();

                    if (res && res.uploaded) {
                        const range = quill.getSelection(true);
                        quill.insertEmbed(range.index, 'image', res.url);
                        quill.setSelection(range.index + 1);
                    } else {
                        alert(res?.error?.message || 'Lỗi tải ảnh.');
                    }
                } catch {
                    alert('Không thể tải ảnh. Vui lòng thử lại.');
                }
            };
        }

        document.addEventListener('DOMContentLoaded', function () {
            quill = new Quill('#editor-container', {
                theme: 'snow',
                modules: {
                    toolbar: {
                        container: [
                            [{ 'header': [1, 2, 3, false] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                            [{ 'color': [] }, { 'background': [] }],
                            ['link', 'image', 'video'],
                            ['clean']
                        ],
                        handlers: {
                            image: imageHandler
                        }
                    }
                },
                placeholder: 'Nhập nội dung trang tại đây...'
            });

            const form = document.getElementById('pageForm');
            const hiddenContent = document.getElementById('hiddenContent');
            const pageKeyInput = document.getElementById('PageKey');

            form.addEventListener('submit', function () {
                const contentHtml = quill.root.innerHTML;
                hiddenContent.value = contentHtml === '<p><br></p>' ? '' : contentHtml;
            });

            pageKeyInput?.addEventListener('input', function (e) {
                e.target.value = e.target.value
                    .toLowerCase()
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd')
                    .replace(/[^a-z0-9\-]/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '');
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}