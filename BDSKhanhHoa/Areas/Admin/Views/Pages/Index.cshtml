@model IEnumerable<BDSKhanhHoa.Models.StaticPage>

@{
    ViewData["Title"] = "Quản lý Trang tĩnh";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var pages = Model ?? Enumerable.Empty<BDSKhanhHoa.Models.StaticPage>();

    string GetPageIcon(string? key)
    {
        return key switch
        {
            "ai_knowledge_base" => "bi-cpu-fill",
            "anti-spam" => "bi-shield-fill-exclamation",
            "vip-policy" => "bi-gem",
            "rules" => "bi-check2-square",
            "terms" => "bi-file-earmark-text-fill",
            "privacy" => "bi-shield-lock-fill",
            "faq" => "bi-question-circle-fill",
            "about" => "bi-info-circle-fill",
            "contact" => "bi-headset",
            _ => "bi-file-earmark-richtext-fill"
        };
    }

    string GetPageColorClass(string? key)
    {
        return key switch
        {
            "ai_knowledge_base" => "page-blue",
            "anti-spam" => "page-red",
            "vip-policy" => "page-vip",
            "rules" => "page-green",
            "terms" => "page-indigo",
            "privacy" => "page-purple",
            "faq" => "page-orange",
            _ => "page-default"
        };
    }

    string GetShortDescription(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Chưa có mô tả ngắn cho trang này.";
        }

        return value.Trim();
    }
}

<style>
    .static-page-wrap {
        min-height: calc(100vh - 100px);
        background: #f8fafc;
        margin: -24px;
        padding: 20px 24px 40px;
    }

    .static-container {
        max-width: 1480px;
        margin: 0 auto;
    }

    .page-header-card {
        margin-bottom: 18px;
        padding: 20px 22px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 28px rgba(15, 23, 42, .055);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .page-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .header-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #60a5fa);
        font-size: 1.55rem;
        box-shadow: 0 12px 26px rgba(37, 99, 235, .2);
    }

    .page-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.52rem;
        line-height: 1.22;
        letter-spacing: -.025em;
        font-weight: 950;
    }

    .page-subtitle {
        margin: 5px 0 0;
        color: #64748b;
        font-size: .94rem;
        line-height: 1.55;
        font-weight: 550;
    }

    .btn-create-page {
        min-height: 44px;
        border-radius: 999px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-weight: 900;
        white-space: nowrap;
        box-shadow: 0 12px 24px rgba(37, 99, 235, .2);
    }

    .page-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
    }

    .page-card {
        position: relative;
        min-height: 250px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: 22px;
        background: #fff;
        border: 1px solid rgba(148, 163, 184, .22);
        box-shadow: 0 10px 26px rgba(15, 23, 42, .055);
        transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    }

        .page-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 44px rgba(15, 23, 42, .10);
            border-color: rgba(37, 99, 235, .28);
        }

        .page-card::before {
            content: "";
            display: block;
            height: 5px;
            background: #cbd5e1;
        }

        .page-card.page-blue::before {
            background: linear-gradient(90deg, #2563eb, #60a5fa);
        }

        .page-card.page-red::before {
            background: linear-gradient(90deg, #dc2626, #fb7185);
        }

        .page-card.page-vip::before {
            background: linear-gradient(90deg, #f59e0b, #facc15);
        }

        .page-card.page-green::before {
            background: linear-gradient(90deg, #059669, #34d399);
        }

        .page-card.page-indigo::before {
            background: linear-gradient(90deg, #4f46e5, #818cf8);
        }

        .page-card.page-purple::before {
            background: linear-gradient(90deg, #7c3aed, #c084fc);
        }

        .page-card.page-orange::before {
            background: linear-gradient(90deg, #ea580c, #fb923c);
        }

    .page-card-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .page-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 14px;
    }

    .page-info {
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: #eff6ff;
        color: #2563eb;
        font-size: 1.25rem;
    }

    .page-red .page-icon {
        background: #fee2e2;
        color: #dc2626;
    }

    .page-vip .page-icon {
        background: #fef3c7;
        color: #b45309;
    }

    .page-green .page-icon {
        background: #dcfce7;
        color: #059669;
    }

    .page-indigo .page-icon {
        background: #e0e7ff;
        color: #4f46e5;
    }

    .page-purple .page-icon {
        background: #f3e8ff;
        color: #7c3aed;
    }

    .page-orange .page-icon {
        background: #ffedd5;
        color: #ea580c;
    }

    .page-title-line {
        margin: 0;
        color: #0f172a;
        font-size: 1.08rem;
        line-height: 1.28;
        letter-spacing: -.015em;
        font-weight: 950;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .page-key-badge {
        max-width: 145px;
        min-height: 30px;
        padding: 0 10px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
        color: #0f172a;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: .73rem;
        font-weight: 900;
        white-space: nowrap;
        overflow: hidden;
    }

        .page-key-badge span {
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .page-description {
        margin: 0 0 16px;
        color: #64748b;
        font-size: .91rem;
        line-height: 1.58;
        font-weight: 560;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .page-meta {
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px dashed #e2e8f0;
        display: grid;
        gap: 7px;
        color: #64748b;
        font-size: .8rem;
        font-weight: 700;
    }

    .page-meta-row {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .page-meta-row i {
            flex-shrink: 0;
        }

        .page-meta-row span {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

    .page-actions {
        margin-top: 16px;
        display: grid;
        grid-template-columns: 1fr 44px 44px;
        gap: 8px;
    }

    .btn-main-action {
        min-height: 42px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .88rem;
        font-weight: 900;
    }

    .btn-circle-action {
        width: 44px;
        height: 42px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .empty-state {
        grid-column: 1 / -1;
        padding: 54px 18px;
        border-radius: 24px;
        background: #fff;
        border: 1px dashed #cbd5e1;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .045);
        text-align: center;
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 14px;
        border-radius: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        background: #f1f5f9;
        font-size: 2.1rem;
    }

    .empty-title {
        margin-bottom: 7px;
        color: #0f172a;
        font-size: 1.14rem;
        font-weight: 950;
    }

    .empty-desc {
        max-width: 520px;
        margin: 0 auto 18px;
        color: #64748b;
        font-size: .92rem;
        line-height: 1.6;
        font-weight: 560;
    }

    @@media (max-width: 1199.98px) {
        .page-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .static-page-wrap {
            margin: -16px;
            padding: 14px 14px 34px;
        }

        .page-header-card {
            align-items: flex-start;
            border-radius: 20px;
            padding: 16px;
        }

        .page-header-left {
            align-items: flex-start;
        }

        .header-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            font-size: 1.35rem;
        }

        .page-title {
            font-size: 1.25rem;
        }

        .page-subtitle {
            font-size: .88rem;
        }

        .btn-create-page {
            width: 100%;
        }

        .page-grid {
            grid-template-columns: 1fr;
            gap: 13px;
        }

        .page-card {
            min-height: unset;
            border-radius: 20px;
        }

        .page-card-body {
            padding: 16px;
        }

        .page-top {
            flex-direction: column;
        }

        .page-key-badge {
            max-width: 100%;
        }

        .page-actions {
            grid-template-columns: 1fr 42px 42px;
        }

        .btn-circle-action {
            width: 42px;
        }
    }

    @@media (max-width: 420px) {
        .page-info {
            flex-direction: column;
        }

        .page-actions {
            grid-template-columns: 1fr;
        }

        .btn-circle-action {
            width: 100%;
        }
    }
</style>

<div class="static-page-wrap">
    <div class="static-container">
        <section class="page-header-card">
            <div class="page-header-left">
                <div class="header-icon">
                    <i class="bi bi-file-earmark-richtext-fill"></i>
                </div>

                <div>
                    <h1 class="page-title">Quản lý nội dung trang tĩnh</h1>
                    <p class="page-subtitle">
                        Quản lý các trang nội dung như điều khoản, chính sách, FAQ, báo giá và dữ liệu hỗ trợ hệ thống.
                    </p>
                </div>
            </div>

            <a asp-action="Create" class="btn btn-primary btn-create-page">
                <i class="bi bi-plus-circle-fill"></i>
                Tạo trang mới
            </a>
        </section>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <section class="page-grid" id="pageGrid">
            @if (pages.Any())
            {
                foreach (var p in pages)
                {
                    string colorClass = GetPageColorClass(p.PageKey);
                    string iconClass = GetPageIcon(p.PageKey);

                    <div class="page-item" id="page-card-@p.PageID">
                        <article class="page-card @colorClass h-100">
                            <div class="page-card-body">
                                <div class="page-top">
                                    <div class="page-info">
                                        <span class="page-icon">
                                            <i class="bi @iconClass"></i>
                                        </span>

                                        <div class="min-w-0">
                                            <h2 class="page-title-line" title="@p.Title">
                                                @p.Title
                                            </h2>
                                        </div>
                                    </div>

                                    <span class="page-key-badge" title="@p.PageKey">
                                        <i class="bi bi-key-fill"></i>
                                        <span>@p.PageKey</span>
                                    </span>
                                </div>

                                <p class="page-description">
                                    @GetShortDescription(p.Description)
                                </p>

                                <div class="page-meta">
                                    <div class="page-meta-row">
                                        <i class="bi bi-link-45deg text-primary"></i>
                                        <span>/Page/@p.PageKey</span>
                                    </div>

                                    <div class="page-meta-row">
                                        <i class="bi bi-clock-history text-secondary"></i>
                                        <span>Cập nhật: @p.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                </div>

                                <div class="page-actions">
                                    <a asp-action="Edit"
                                       asp-route-id="@p.PageID"
                                       class="btn btn-primary btn-main-action">
                                        <i class="bi bi-pencil-square"></i>
                                        Sửa nội dung
                                    </a>

                                    <a href="/Page/@p.PageKey"
                                       target="_blank"
                                       class="btn btn-outline-secondary btn-circle-action"
                                       title="Xem trang ngoài website">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-outline-danger btn-circle-action btn-delete"
                                            data-id="@p.PageID"
                                            data-title="@p.Title"
                                            title="Xóa trang này">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-file-earmark-x"></i>
                    </div>

                    <div class="empty-title">Chưa có trang tĩnh nào</div>

                    <p class="empty-desc">
                        Bạn có thể tạo các trang như FAQ, chính sách, điều khoản hoặc dữ liệu hỗ trợ hệ thống.
                    </p>

                    <a asp-action="Create" class="btn btn-primary rounded-pill fw-bold px-4">
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        Tạo trang đầu tiên
                    </a>
                </div>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('.btn-delete').click(function () {
                const id = $(this).data('id');
                const title = $(this).data('title') || 'trang tĩnh này';

                Swal.fire({
                    title: 'Xác nhận xóa trang?',
                    html: `
                        <div class="text-start">
                            <p class="mb-2">
                                Bạn đang chuẩn bị xóa trang:
                                <strong>${escapeHtml(title)}</strong>
                            </p>

                            <div class="alert alert-warning rounded-4 mb-0">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Thao tác này không thể hoàn tác sau khi xóa.
                            </div>
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: '<i class="bi bi-trash-fill me-1"></i> Đồng ý xóa',
                    cancelButtonText: 'Hủy bỏ',
                    customClass: {
                        popup: 'rounded-4',
                        confirmButton: 'rounded-pill px-4',
                        cancelButton: 'rounded-pill px-4'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/Admin/Pages/Delete',
                            type: 'POST',
                            data: { id: id },
                            success: function (res) {
                                if (res && res.success) {
                                    $('#page-card-' + id).fadeOut(250, function () {
                                        $(this).remove();

                                        if ($('.page-item').length === 0) {
                                            location.reload();
                                        }
                                    });

                                    Swal.fire({
                                        toast: true,
                                        position: 'top-end',
                                        icon: 'success',
                                        title: res.message || 'Đã xóa trang tĩnh thành công.',
                                        showConfirmButton: false,
                                        timer: 2400,
                                        timerProgressBar: true
                                    });
                                } else {
                                    Swal.fire({
                                        icon: 'error',
                                        title: 'Không thể xóa',
                                        text: res && res.message ? res.message : 'Đã xảy ra lỗi khi xóa trang.',
                                        confirmButtonColor: '#2563eb'
                                    });
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Lỗi hệ thống',
                                    text: 'Không thể gửi yêu cầu xóa trang. Vui lòng thử lại.',
                                    confirmButtonColor: '#2563eb'
                                });
                            }
                        });
                    }
                });
            });

            function escapeHtml(value) {
                return (value || '')
                    .toString()
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }
        });
    </script>
}