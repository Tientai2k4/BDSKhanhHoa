@model IEnumerable<BDSKhanhHoa.Models.PostServicePackage>

@{
    ViewData["Title"] = "Quản lý gói đăng tin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string currentStatus = ViewBag.Status as string ?? "all";
    string keyword = ViewBag.Keyword as string ?? "";

    int totalCount = ViewBag.TotalCount ?? 0;
    int activeCount = ViewBag.ActiveCount ?? 0;
    int inactiveCount = ViewBag.InactiveCount ?? 0;
    int usedInPropertiesCount = ViewBag.UsedInPropertiesCount ?? 0;
    int usedInTransactionsCount = ViewBag.UsedInTransactionsCount ?? 0;

    string GetTierClass(string? type) => type switch { "Kim Cương" => "diamond", "Vàng" => "gold", "Bạc" => "silver", "Đồng" => "bronze", _ => "normal" };
    string GetIconClass(string? type) => type switch { "Kim Cương" => "bi-gem", "Vàng" => "bi-star-fill", "Bạc" => "bi-shield-fill", "Đồng" => "bi-award-fill", _ => "bi-tag-fill" };
    string GetPriorityText(int priority) => priority switch { 1 => "Cao nhất", 2 => "Sau Kim Cương", 3 => "Sau Vàng", 4 => "Sau Bạc", 5 => "Tin thường", _ => "Hạng " + priority };
}

<style>
    :root {
        --p-bg: #f6f8fb;
        --p-card: #fff;
        --p-text: #0f172a;
        --p-muted: #64748b;
        --p-line: #e2e8f0;
        --p-blue: #2563eb;
        --p-shadow: 0 8px 22px rgba(15,23,42,.055);
    }

    .pkg-page {
        background: var(--p-bg);
        min-height: auto;
        padding: 8px;
        overflow-x: hidden;
    }

    .pkg-hero, .stats-strip, .filter-box, .list-box {
        background: var(--p-card);
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 14px;
        box-shadow: none;
    }

    .pkg-hero {
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .hero-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .hero-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: var(--p-blue);
        font-size: 1.25rem;
        flex: 0 0 auto;
    }

    .page-title {
        margin: 0;
        color: var(--p-text);
        font-size: clamp(1.25rem,2vw,1.75rem);
        font-weight: 950;
        letter-spacing: -.035em;
        line-height: 1.12;
    }

    .page-subtitle {
        margin: 4px 0 0;
        color: var(--p-muted);
        font-weight: 650;
        font-size: .9rem;
    }

    .create-btn {
        min-height: 40px;
        border-radius: 999px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        white-space: nowrap;
        padding: 8px 15px;
    }

    .stats-strip {
        padding: 10px;
        margin-bottom: 12px;
        display: grid;
        grid-template-columns: repeat(5,minmax(0,1fr));
        gap: 8px;
    }

    .stat {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 14px;
        padding: 10px;
        min-width: 0;
    }

        .stat .label {
            color: var(--p-muted);
            font-size: .68rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .stat .value {
            margin-top: 5px;
            color: var(--p-text);
            font-size: 1.28rem;
            font-weight: 950;
            line-height: 1;
        }

    .filter-box {
        margin-bottom: 12px;
        overflow: hidden;
    }

    .filter-toggle {
        width: 100%;
        border: 0;
        background: #fff;
        padding: 13px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--p-text);
        font-weight: 950;
        font-size: 1rem;
    }

    .filter-body {
        padding: 0 14px 14px;
    }

    .filter-form {
        display: grid;
        grid-template-columns: 190px minmax(220px,1fr) auto;
        gap: 8px;
        align-items: end;
    }

    .label-mini {
        margin-bottom: 5px;
        color: var(--p-muted);
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 950;
    }

    .soft-input {
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid #dbe4ef;
        background: #f8fafc;
        font-weight: 750;
        box-shadow: none !important;
    }

        .soft-input:focus {
            background: #fff;
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37,99,235,.09) !important;
        }

    .filter-actions {
        display: flex;
        gap: 8px;
    }

        .filter-actions .btn {
            min-height: 40px;
            border-radius: 12px;
            font-weight: 900;
        }

    .list-box {
        overflow: hidden;
    }

    .list-head, .pkg-row {
        display: grid;
        grid-template-columns: minmax(260px,1.6fr) 110px 110px 110px 95px 180px;
        gap: 10px;
        align-items: center;
    }

    .list-head {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        padding: 11px 14px;
        color: var(--p-muted);
        font-size: .68rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .pkg-list {
        display: flex;
        flex-direction: column;
    }

    .pkg-row {
        padding: 12px 14px;
        background: #fff;
        border-bottom: 1px solid #edf2f7;
        border-left: 4px solid #cbd5e1;
        transition: .15s ease;
    }

        .pkg-row:hover {
            background: #fbfdff;
        }

        .pkg-row.inactive {
            opacity: .72;
            background: #f8fafc;
        }

        .pkg-row.diamond {
            border-left-color: #00c6ff;
        }

        .pkg-row.gold {
            border-left-color: #f59e0b;
        }

        .pkg-row.silver {
            border-left-color: #94a3b8;
        }

        .pkg-row.bronze {
            border-left-color: #b45309;
        }

    .pkg-main {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .tier-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        background: #f1f5f9;
        color: #64748b;
        font-size: 1.12rem;
    }

    .diamond .tier-icon {
        background: linear-gradient(135deg,#00c6ff,#2563eb);
        color: #fff;
    }

    .gold .tier-icon {
        background: linear-gradient(135deg,#fde68a,#f59e0b);
        color: #78350f;
    }

    .silver .tier-icon {
        background: linear-gradient(135deg,#f8fafc,#cbd5e1);
        color: #334155;
    }

    .bronze .tier-icon {
        background: linear-gradient(135deg,#fed7aa,#c2410c);
        color: #fff;
    }

    .pkg-name {
        color: var(--p-text);
        font-weight: 950;
        line-height: 1.22;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pkg-desc {
        margin-top: 3px;
        color: var(--p-muted);
        font-size: .78rem;
        font-weight: 650;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .72rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .type-pill {
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
    }

    .active-pill {
        color: #047857;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

    .inactive-pill {
        color: #b91c1c;
        background: #fee2e2;
        border: 1px solid #fecaca;
    }

    .plain-pill {
        color: #334155;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .price {
        color: #dc2626;
        font-weight: 950;
        white-space: nowrap;
        text-align: right;
    }

        .price.free {
            color: #16a34a;
        }

    .cell-center {
        display: flex;
        justify-content: center;
        min-width: 0;
    }

    .cell-end {
        display: flex;
        justify-content: flex-end;
        min-width: 0;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
    }

    .action-btn {
        min-height: 33px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-weight: 850;
        white-space: nowrap;
    }

    .mobile-info {
        display: none;
    }

    .empty {
        padding: 40px 14px;
        text-align: center;
        color: var(--p-muted);
    }

    @@media (max-width:1199.98px) {
        .stats-strip {
            grid-template-columns: repeat(3,minmax(0,1fr));
        }

        .list-head, .pkg-row {
            grid-template-columns: minmax(240px,1.4fr) 105px 95px 105px 80px 160px;
        }
    }

    @@media (max-width:991.98px) {
        .list-head {
            display: none;
        }

        .pkg-list {
            padding: 10px;
            gap: 10px;
            background: #f8fafc;
        }

        .pkg-row {
            display: block;
            border: 1px solid #e2e8f0;
            border-left-width: 4px;
            border-radius: 16px;
            padding: 12px;
            box-shadow: none;
        }

            .pkg-row + .pkg-row {
                border-top: 1px solid #e2e8f0;
            }

        .desktop-cell {
            display: none !important;
        }

        .mobile-info {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 8px;
            margin-top: 10px;
        }

        .m-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 13px;
            padding: 8px;
            min-width: 0;
        }

        .m-label {
            color: var(--p-muted);
            font-size: .66rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .m-value {
            margin-top: 4px;
            color: var(--p-text);
            font-size: .82rem;
            font-weight: 900;
        }

        .actions {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid #edf2f7;
        }

            .actions form, .actions a, .actions button {
                width: 100%;
            }
    }

    @@media (max-width:767.98px) {
        .pkg-page {
            padding: 10px;
            min-height: auto;
        }

        .pkg-hero {
            padding: 13px;
            flex-direction: column;
            align-items: stretch;
            border-radius: 16px;
        }

        .page-title {
            font-size: 1.2rem;
        }

        .page-subtitle {
            font-size: .84rem;
        }

        .create-btn {
            width: 100%;
            min-height: 39px;
        }

        .stats-strip {
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 7px;
            padding: 8px;
            border-radius: 16px;
        }

        .stat {
            text-align: center;
            padding: 9px 6px;
        }

            .stat .label {
                font-size: .62rem;
            }

            .stat .value {
                font-size: 1.12rem;
            }

        .filter-body {
            display: none;
        }

        .filter-box.open .filter-body {
            display: block;
        }

        .filter-form {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            display: grid;
            grid-template-columns: 1fr 44px;
        }

        .mobile-info {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .pkg-main {
            align-items: flex-start;
        }

        .tier-icon {
            width: 38px;
            height: 38px;
            border-radius: 13px;
        }

        .pkg-desc {
            display: none;
        }

        .actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="pkg-page">
    <section class="pkg-hero">
        <div class="hero-title"><span class="hero-icon"><i class="bi bi-tags-fill"></i></span><div class="min-w-0"><h1 class="page-title">Quản lý gói đăng tin</h1><p class="page-subtitle">Quản lý giá, hạng VIP, trạng thái và lịch sử sử dụng.</p></div></div>
        <a href="/Admin/PostServicePackages/Create" class="btn btn-primary create-btn"><i class="bi bi-plus-circle"></i>Tạo gói mới</a>
    </section>

    <section class="stats-strip">
        <article class="stat"><div class="label"><i class="bi bi-collection text-primary me-1"></i>Tổng</div><div class="value">@totalCount.ToString("N0")</div></article>
        <article class="stat"><div class="label"><i class="bi bi-check-circle-fill text-success me-1"></i>Đang dùng</div><div class="value text-success">@activeCount.ToString("N0")</div></article>
        <article class="stat"><div class="label"><i class="bi bi-pause-circle-fill text-danger me-1"></i>Ngừng</div><div class="value text-danger">@inactiveCount.ToString("N0")</div></article>
        <article class="stat d-none d-md-block"><div class="label"><i class="bi bi-house-check-fill text-info me-1"></i>Có tin</div><div class="value">@usedInPropertiesCount.ToString("N0")</div></article>
        <article class="stat d-none d-md-block"><div class="label"><i class="bi bi-receipt-cutoff text-warning me-1"></i>Giao dịch</div><div class="value">@usedInTransactionsCount.ToString("N0")</div></article>
    </section>

    <section class="filter-box" id="pkgFilter">
        <button type="button" class="filter-toggle" onclick="document.getElementById('pkgFilter').classList.toggle('open')"><span><i class="bi bi-funnel-fill text-primary me-2"></i>Bộ lọc</span><i class="bi bi-chevron-down"></i></button>
        <div class="filter-body">
            <form method="get" action="/Admin/PostServicePackages/Index" class="filter-form">
                <div><label class="label-mini">Trạng thái</label><select name="status" class="form-select soft-input"><option value="all" selected="@(currentStatus == "all")">Tất cả</option><option value="active" selected="@(currentStatus == "active")">Đang dùng</option><option value="inactive" selected="@(currentStatus == "inactive")">Ngừng dùng</option></select></div>
                <div><label class="label-mini">Tìm kiếm</label><input type="text" name="keyword" value="@keyword" class="form-control soft-input" placeholder="Tên gói, loại gói hoặc mô tả..." /></div>
                <div class="filter-actions"><button type="submit" class="btn btn-dark"><i class="bi bi-search me-1"></i>Lọc</button><a href="/Admin/PostServicePackages/Index" class="btn btn-light border"><i class="bi bi-arrow-counterclockwise"></i></a></div>
            </form>
        </div>
    </section>

    <section class="list-box">
        <div class="list-head"><div>Gói đăng tin</div><div class="text-center">Trạng thái</div><div class="text-center">Thời hạn</div><div class="text-end">Giá</div><div class="text-center">Hạng</div><div class="text-end">Thao tác</div></div>
        <div class="pkg-list">
            @if (Model == null || !Model.Any())
            {
                <div class="empty"><i class="bi bi-box-seam display-5 opacity-25 d-block mb-2"></i><div class="fw-bold text-dark">Chưa có gói đăng tin nào</div><div>Bạn có thể tạo gói Tin Thường hoặc VIP mới.</div></div>
            }
            else
            {
                foreach (var item in Model)
                {
                    var tierClass = GetTierClass(item.PackageType);
                    var iconClass = GetIconClass(item.PackageType);
                    var isNormal = item.PackageType == "Tin Thường";
                    <article class="pkg-row @tierClass @(item.IsActive ? "" : "inactive")">
                        <div class="pkg-main"><span class="tier-icon"><i class="bi @iconClass"></i></span><div class="min-w-0"><div class="pkg-name">@item.PackageName</div><div class="mt-1"><span class="pill type-pill">@(isNormal ? "Tin thường" : "VIP " + item.PackageType)</span></div>@if (!string.IsNullOrWhiteSpace(item.Description)){
                        <div class="pkg-desc" title="@item.Description">@item.Description</div>
                    }
    </div></div>
                    <div class="cell-center desktop-cell">@if (item.IsActive){
                    <span class="pill active-pill"><i class="bi bi-check-circle-fill"></i>Đang dùng</span>
                }else
                {

                    <span class="pill inactive-pill"><i class="bi bi-pause-circle-fill"></i>Ngừng</span>
                }
</div>
                <div class="cell-center desktop-cell"><span class="pill plain-pill"><i class="bi bi-calendar-event text-primary"></i>@(item.DurationDays == 0 ? "Không hết hạn" : item.DurationDays + " ngày")</span></div>
                <div class="cell-end desktop-cell"><span class="price @(item.Price == 0 ? "free" : "")">@(item.Price == 0 ? "Miễn phí" : item.Price.ToString("N0") + " ₫")</span></div>
                <div class="cell-center desktop-cell"><span class="pill plain-pill"><strong>@item.PriorityLevel</strong> @GetPriorityText(item.PriorityLevel)</span></div>
                <div class="mobile-info"><div class="m-box"><div class="m-label">Giá</div><div class="m-value @(item.Price == 0 ? "text-success" : "text-danger")">@(item.Price == 0 ? "Miễn phí" : item.Price.ToString("N0") + " ₫")</div></div><div class="m-box"><div class="m-label">Thời hạn</div><div class="m-value">@(item.DurationDays == 0 ? "Không hết hạn" : item.DurationDays + " ngày")</div></div><div class="m-box"><div class="m-label">Hạng</div><div class="m-value">@item.PriorityLevel - @GetPriorityText(item.PriorityLevel)</div></div><div class="m-box"><div class="m-label">Trạng thái</div><div class="m-value @(item.IsActive ? "text-success" : "text-danger")">@(item.IsActive ? "Đang dùng" : "Ngừng dùng")</div></div></div>
                <div class="actions"><a href="/Admin/PostServicePackages/Edit/@item.PackageID" class="btn btn-sm btn-light border text-primary action-btn"><i class="bi bi-pencil-square"></i>Sửa</a>@if (item.IsActive){
                <form id="deactivateForm-@item.PackageID" action="/Admin/PostServicePackages/Deactivate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.PackageID" /><button type="button" class="btn btn-sm btn-light border text-warning action-btn" onclick="confirmDeactivate(@item.PackageID, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.PackageName))')"><i class="bi bi-pause-circle-fill"></i>Ngừng</button></form>
                                }else
                {

                    <form id="activateForm-@item.PackageID" action="/Admin/PostServicePackages/Activate" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.PackageID" /><button type="button" class="btn btn-sm btn-light border text-success action-btn" onclick="confirmActivate(@item.PackageID, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.PackageName))')"><i class="bi bi-play-circle-fill"></i>Mở</button></form>
                }
<form id="deleteForm-@item.PackageID" action="/Admin/PostServicePackages/Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.PackageID" /><button type="button" class="btn btn-sm btn-light border text-danger action-btn" onclick="confirmDelete(@item.PackageID, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.PackageName))')"><i class="bi bi-trash3-fill"></i>Xóa</button></form></div>
            </article>
                        }
                        }
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function(){ if (window.innerWidth >= 768) document.getElementById('pkgFilter')?.classList.add('open'); });
        function confirmDeactivate(id, name){ Swal.fire({ title:'Ngừng dùng gói này?', html:`Gói <strong>${name}</strong> sẽ bị ẩn khỏi lựa chọn mới nhưng vẫn giữ lịch sử.`, icon:'warning', showCancelButton:true, confirmButtonColor:'#f59e0b', cancelButtonColor:'#64748b', confirmButtonText:'Ngừng dùng', cancelButtonText:'Hủy' }).then(r=>{ if(r.isConfirmed) document.getElementById('deactivateForm-'+id).submit(); }); }
        function confirmActivate(id, name){ Swal.fire({ title:'Mở lại gói này?', html:`Gói <strong>${name}</strong> sẽ được cho sử dụng lại.`, icon:'question', showCancelButton:true, confirmButtonColor:'#16a34a', cancelButtonColor:'#64748b', confirmButtonText:'Mở lại', cancelButtonText:'Hủy' }).then(r=>{ if(r.isConfirmed) document.getElementById('activateForm-'+id).submit(); }); }
        function confirmDelete(id, name){ Swal.fire({ title:'Xóa gói đăng tin?', html:`Chỉ nên xóa <strong>${name}</strong> khi gói chưa phát sinh dữ liệu. Nếu đã dùng, hãy ngừng dùng.`, icon:'warning', showCancelButton:true, confirmButtonColor:'#ef4444', cancelButtonColor:'#64748b', confirmButtonText:'Kiểm tra và xóa', cancelButtonText:'Hủy' }).then(r=>{ if(r.isConfirmed) document.getElementById('deleteForm-'+id).submit(); }); }
        @if (TempData["Success"] != null)
        {
            <text>Swal.fire({ toast:true, position:'top-end', icon:'success', title:'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]?.ToString() ?? ""))', showConfirmButton:false, timer:3200, timerProgressBar:true });</text>
        }
        @if (TempData["Error"] != null)
        {
            <text>Swal.fire({ icon:'error', title:'Không thể thực hiện', text:'@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]?.ToString() ?? ""))', confirmButtonText:'Đã hiểu', confirmButtonColor:'#2563eb' });</text>
        }
    </script>
}
