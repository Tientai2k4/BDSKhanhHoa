@model BDSKhanhHoa.Models.PostServicePackage

@{
    ViewData["Title"] = "Chỉnh sửa gói đăng tin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-page {
        background: #f8fafc;
        min-height: calc(100vh - 80px);
    }

    .page-title {
        font-weight: 900;
        color: #0f172a;
    }

    .main-card, .preview-card, .guide-card {
        border: 0;
        border-radius: 24px;
        box-shadow: 0 12px 32px rgba(15,23,42,.08);
        background: #fff;
    }

    .field-label {
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .soft-input {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        min-height: 48px;
        font-weight: 700;
    }

        .soft-input:focus {
            background: #fff;
            border-color: #2563eb;
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.12);
        }

    .readonly-box {
        background: #eff6ff !important;
        color: #1d4ed8 !important;
        font-weight: 900 !important;
    }

    .preview-card {
        overflow: hidden;
        position: sticky;
        top: 90px;
    }

    .preview-head {
        padding: 28px;
        text-align: center;
        border-bottom: 1px solid #eef2f7;
    }

    .preview-icon {
        width: 74px;
        height: 74px;
        border-radius: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin-bottom: 16px;
        background: #f1f5f9;
        color: #64748b;
    }

    .preview-card[data-tier="Kim Cương"] {
        border: 2px solid #00c6ff;
    }

        .preview-card[data-tier="Kim Cương"] .preview-icon {
            background: linear-gradient(135deg, #00c6ff, #2563eb);
            color: #fff;
        }

    .preview-card[data-tier="Vàng"] {
        border: 2px solid #f59e0b;
    }

        .preview-card[data-tier="Vàng"] .preview-icon {
            background: linear-gradient(135deg, #fde68a, #f59e0b);
            color: #78350f;
        }

    .preview-card[data-tier="Bạc"] {
        border: 2px solid #94a3b8;
    }

        .preview-card[data-tier="Bạc"] .preview-icon {
            background: linear-gradient(135deg, #f8fafc, #cbd5e1);
            color: #334155;
        }

    .preview-card[data-tier="Đồng"] {
        border: 2px solid #b45309;
    }

        .preview-card[data-tier="Đồng"] .preview-icon {
            background: linear-gradient(135deg, #fed7aa, #c2410c);
            color: #fff;
        }

    .preview-card[data-tier="Tin Thường"] {
        border: 2px solid #cbd5e1;
    }

        .preview-card[data-tier="Tin Thường"] .preview-icon {
            background: #f1f5f9;
            color: #64748b;
            border: 1px solid #e2e8f0;
        }

    .rank-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 8px 14px;
        background: #0f172a;
        color: #fff;
        font-weight: 900;
    }

    .guide-card {
        background: linear-gradient(135deg, #fff7ed, #ffffff);
        border: 1px solid #fed7aa;
    }

    .guide-item {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        font-size: .9rem;
        color: #475569;
        margin-bottom: 10px;
    }

        .guide-item i {
            color: #f59e0b;
            margin-top: 2px;
        }
</style>

<div class="form-page container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="page-title mb-1">
                <i class="bi bi-pencil-square text-warning me-2"></i>Chỉnh sửa gói đăng tin
            </h3>
            <p class="text-muted mb-0">
                Khi đổi phân loại gói, hệ thống sẽ tự cập nhật lại hạng hiển thị cho đúng thứ tự.
            </p>
        </div>

        <a href="/Admin/PostServicePackages/Index" class="btn btn-light border shadow-sm fw-bold rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Trở về danh sách
        </a>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="main-card p-4 p-md-5">
                <form asp-action="Edit" method="post" id="packageForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PackageID" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="field-label">Phân loại gói <span class="text-danger">*</span></label>
                            <select asp-for="PackageType"
                                    asp-items="ViewBag.PackageTypes"
                                    class="form-select form-select-lg soft-input"
                                    id="tierSelect"
                                    required>
                                <option value="">-- Chọn phân loại gói --</option>
                            </select>
                            <span asp-validation-for="PackageType" class="text-danger small d-block mt-1"></span>
                            <small class="text-muted d-block mt-2">
                                Kim Cương là cao nhất, Tin Thường là thấp nhất.
                            </small>
                        </div>

                        <div class="col-md-6">
                            <label class="field-label">Tên hiển thị của gói <span class="text-danger">*</span></label>
                            <input asp-for="PackageName"
                                   class="form-control form-control-lg soft-input"
                                   id="nameInput"
                                   required />
                            <span asp-validation-for="PackageName" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="field-label">Giá tiền</label>
                            <div class="input-group">
                                <input asp-for="Price"
                                       type="number"
                                       min="0"
                                       class="form-control form-control-lg soft-input text-danger"
                                       id="priceInput"
                                       required />
                                <span class="input-group-text soft-input fw-bold">₫</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small d-block mt-1"></span>
                            <small class="text-muted d-block mt-2" id="priceHint">
                                Giá bán của một lượt đăng tin.
                            </small>
                        </div>

                        <div class="col-md-4">
                            <label class="field-label">Thời hạn sử dụng</label>
                            <div class="input-group">
                                <input asp-for="DurationDays"
                                       type="number"
                                       min="0"
                                       class="form-control form-control-lg soft-input"
                                       id="durationInput"
                                       required />
                                <span class="input-group-text soft-input fw-bold" id="durationAddon">ngày</span>
                            </div>
                            <span asp-validation-for="DurationDays" class="text-danger small d-block mt-1"></span>
                            <small class="text-muted d-block mt-2" id="durationHint">
                                Gói VIP phải lớn hơn 0 ngày.
                            </small>
                        </div>

                        <div class="col-md-4">
                            <label class="field-label">Hạng hiển thị</label>
                            <input asp-for="PriorityLevel"
                                   type="number"
                                   class="form-control form-control-lg soft-input readonly-box"
                                   id="priorityInput"
                                   readonly />
                            <span asp-validation-for="PriorityLevel" class="text-danger small d-block mt-1"></span>
                            <small class="text-muted d-block mt-2">
                                Tự gán theo phân loại gói.
                            </small>
                        </div>

                        <div class="col-12">
                            <label class="field-label">Mô tả đặc quyền</label>
                            <textarea asp-for="Description"
                                      class="form-control soft-input"
                                      rows="4"
                                      id="descInput"></textarea>
                            <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="small text-muted">
                            <i class="bi bi-exclamation-circle me-1"></i>
                            Nếu gói đang được tin đăng sử dụng, thay đổi này sẽ ảnh hưởng cách hiển thị của các tin đó.
                        </div>

                        <button type="submit" class="btn btn-warning btn-lg fw-bold rounded-pill px-5 shadow-sm text-dark">
                            <i class="bi bi-floppy-fill me-2"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="preview-card mb-4" id="previewCard" data-tier="@Model.PackageType">
                <div class="preview-head">
                    <div class="preview-icon" id="previewIcon">
                        <i class="bi bi-tag-fill"></i>
                    </div>
                    <div class="text-uppercase fw-bold text-muted small mb-1" id="previewTierText">
                        @Model.PackageType
                    </div>
                    <h4 class="fw-black text-dark mb-0" style="font-weight:900;" id="previewName">
                        @Model.PackageName
                    </h4>
                </div>

                <div class="p-4">
                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                        <span class="fw-bold text-muted">Giá</span>
                        <span class="fs-4 fw-black @(Model.Price == 0 ? "text-success" : "text-danger")" style="font-weight:900;" id="previewPrice">
                            @(Model.Price == 0 ? "Miễn phí" : Model.Price.ToString("N0") + " ₫")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                        <span class="fw-bold text-muted">Thời hạn</span>
                        <span class="fw-bold text-dark" id="previewDuration">
                            @(Model.DurationDays == 0 ? "Không hết hạn" : Model.DurationDays + " ngày")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                        <span class="fw-bold text-muted">Hạng hiển thị</span>
                        <span class="rank-pill">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                            <span id="previewPriority">@Model.PriorityLevel</span>
                        </span>
                    </div>

                    <div>
                        <div class="fw-bold text-muted mb-2">Mô tả</div>
                        <p class="small text-secondary mb-0" id="previewDesc">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "Chưa có mô tả." : Model.Description)
                        </p>
                    </div>
                </div>
            </div>

            <div class="guide-card p-4">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-info-circle-fill text-warning me-1"></i> Lưu ý
                </h6>

                <div class="guide-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Không cần nhập tay hạng hiển thị.</span>
                </div>

                <div class="guide-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Tin thường luôn là hạng 5, giá 0 và thời hạn 0.</span>
                </div>

                <div class="guide-item mb-0">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Gói VIP phải có thời hạn lớn hơn 0 ngày.</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const tierOptions = @Html.Raw(ViewBag.TierOptionsJson ?? "[]");

        const tierSelect = document.getElementById('tierSelect');
        const nameInput = document.getElementById('nameInput');
        const priceInput = document.getElementById('priceInput');
        const durationInput = document.getElementById('durationInput');
        const priorityInput = document.getElementById('priorityInput');
        const descInput = document.getElementById('descInput');

        const priceHint = document.getElementById('priceHint');
        const durationHint = document.getElementById('durationHint');
        const durationAddon = document.getElementById('durationAddon');

        const previewCard = document.getElementById('previewCard');
        const previewIcon = document.getElementById('previewIcon');
        const previewTierText = document.getElementById('previewTierText');
        const previewName = document.getElementById('previewName');
        const previewPrice = document.getElementById('previewPrice');
        const previewDuration = document.getElementById('previewDuration');
        const previewPriority = document.getElementById('previewPriority');
        const previewDesc = document.getElementById('previewDesc');

        function getSelectedTier() {
            return tierOptions.find(x => x.type === tierSelect.value) || null;
        }

        function formatMoney(value) {
            const number = parseInt(value || '0');
            if (isNaN(number) || number <= 0) return 'Miễn phí';
            return new Intl.NumberFormat('vi-VN').format(number) + ' ₫';
        }

               function applyTierDefaults(forceFillText = false) {
            const tier = getSelectedTier();
            if (!tier) return;

            // Chỉ khóa hạng hiển thị, không khóa giá và thời hạn.
            priorityInput.value = tier.priorityLevel;

            priceInput.readOnly = false;
            priceInput.classList.remove('readonly-box');

            durationInput.readOnly = false;
            durationInput.classList.remove('readonly-box');

            durationAddon.innerText = 'ngày';

            if (tier.type === 'Tin Thường') {
                priceHint.innerText = 'Tin thường là gói không VIP. Admin được phép để miễn phí hoặc nhập giá bán.';
                durationHint.innerText = 'Nhập số ngày sử dụng. Nhập 0 nếu muốn hiểu là không hết hạn.';
            } else {
                priceHint.innerText = 'Giá bán của một lượt đăng tin VIP.';
                durationHint.innerText = 'Gói VIP phải có thời hạn lớn hơn 0 ngày để hệ thống tự hạ cấp khi hết hạn.';

                if (!durationInput.value || parseInt(durationInput.value) <= 0) {
                    durationInput.value = tier.defaultDurationDays;
                }
            }

            if (forceFillText || !nameInput.value.trim()) {
                nameInput.value = tier.suggestedPackageName;
            }

            if ((forceFillText || !priceInput.value) && parseInt(priceInput.value || '0') < 0) {
                priceInput.value = tier.suggestedPrice;
            }

            if ((forceFillText || !durationInput.value) && tier.type === 'Tin Thường') {
                durationInput.value = tier.defaultDurationDays;
            }

            if (forceFillText || !descInput.value.trim()) {
                descInput.value = tier.suggestedDescription;
            }
        }
        function updatePreview() {
            const tier = getSelectedTier();

            if (!tier) {
                previewCard.setAttribute('data-tier', '');
                previewIcon.innerHTML = '<i class="bi bi-box"></i>';
                previewTierText.innerText = 'Chưa chọn hạng';
                previewName.innerText = nameInput.value || 'Tên gói sẽ hiển thị ở đây';
                previewPriority.innerText = priorityInput.value || '0';
                previewDesc.innerText = descInput.value || 'Chưa có mô tả.';
                previewPrice.innerText = formatMoney(priceInput.value);
                previewDuration.innerText = (durationInput.value || 0) + ' ngày';
                return;
            }

            previewCard.setAttribute('data-tier', tier.type);
            previewIcon.innerHTML = `<i class="bi ${tier.icon}"></i>`;
            previewTierText.innerText = tier.displayName;
            previewName.innerText = nameInput.value || tier.suggestedPackageName;
            previewPriority.innerText = priorityInput.value || tier.priorityLevel;
            previewDesc.innerText = descInput.value || tier.suggestedDescription;

            const priceText = formatMoney(priceInput.value);
            previewPrice.innerText = priceText;
            previewPrice.className = priceText === 'Miễn phí'
                ? 'fs-4 fw-black text-success'
                : 'fs-4 fw-black text-danger';

            const duration = parseInt(durationInput.value || '0');
            previewDuration.innerText = duration === 0 ? 'Không hết hạn' : duration + ' ngày';
        }

        tierSelect.addEventListener('change', function () {
            applyTierDefaults(false);
            updatePreview();
        });

        [nameInput, priceInput, durationInput, priorityInput, descInput].forEach(el => {
            el.addEventListener('input', updatePreview);
        });

        document.addEventListener('DOMContentLoaded', function () {
            applyTierDefaults(false);
            updatePreview();
        });
    </script>
}