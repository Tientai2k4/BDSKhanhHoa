@model BDSKhanhHoa.Models.PostServicePackage

@{
    ViewData["Title"] = "Tạo gói đăng tin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --f-bg: #f6f8fb;
        --f-card: #fff;
        --f-text: #0f172a;
        --f-muted: #64748b;
        --f-line: #e2e8f0;
        --f-blue: #2563eb;
        --f-shadow: 0 8px 22px rgba(15,23,42,.055);
    }

    .form-page {
        background: var(--f-bg);
        min-height: auto;
        padding: 8px;
        overflow-x: hidden
    }

    .form-head, .form-card, .preview-card {
        background: #fff;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 14px;
        box-shadow: none
    }

    .form-head {
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px
    }

    .head-title {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0
    }

    .head-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: var(--f-blue);
        font-size: 1.2rem;
        flex: 0 0 auto
    }

    .page-title {
        margin: 0;
        color: var(--f-text);
        font-size: clamp(1.2rem,2vw,1.7rem);
        font-weight: 950;
        letter-spacing: -.035em
    }

    .page-subtitle {
        margin: 4px 0 0;
        color: var(--f-muted);
        font-weight: 650;
        font-size: .9rem
    }

    .back-btn {
        min-height: 40px;
        border-radius: 999px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap
    }

    .form-layout {
        display: grid;
        grid-template-columns: minmax(0,1fr) 320px;
        gap: 12px
    }

    .form-card {
        padding: 16px
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(6,minmax(0,1fr));
        gap: 12px
    }

    .col-6x {
        grid-column: span 6
    }

    .col-3x {
        grid-column: span 3
    }

    .col-2x {
        grid-column: span 2
    }

    .field-label {
        font-weight: 900;
        color: var(--f-text);
        font-size: .86rem;
        margin-bottom: 6px
    }

    .soft-input {
        min-height: 42px;
        border-radius: 12px;
        border: 1px solid #dbe4ef;
        background: #f8fafc;
        font-weight: 750;
        box-shadow: none !important
    }

        .soft-input:focus {
            background: #fff;
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37,99,235,.09) !important
        }

    .readonly-box {
        background: #eff6ff !important;
        color: #1d4ed8 !important;
        font-weight: 950 !important
    }

    .active-box {
        border-radius: 14px;
        padding: 12px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0
    }

        .active-box.is-inactive {
            background: #fef2f2;
            border-color: #fecaca
        }

    .actions-line {
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid #edf2f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap
    }

    .save-btn {
        min-height: 42px;
        border-radius: 999px;
        font-weight: 950;
        padding: 8px 22px
    }

    .preview-card {
        padding: 8px;
        position: sticky;
        top: 86px
    }

    .preview-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px
    }

    .preview-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #64748b;
        font-size: 1.15rem
    }

    .preview-name {
        margin: 0;
        color: var(--f-text);
        font-weight: 950;
        font-size: 1rem
    }

    .preview-tier {
        color: var(--f-muted);
        font-size: .72rem;
        text-transform: uppercase;
        font-weight: 900
    }

    .preview-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 0;
        border-bottom: 1px dashed #edf2f7
    }

        .preview-row:last-child {
            border-bottom: 0
        }

    .preview-label {
        color: var(--f-muted);
        font-size: .78rem;
        font-weight: 900
    }

    .preview-value {
        color: var(--f-text);
        font-weight: 950;
        text-align: right
    }

    .rank-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        background: #0f172a;
        color: #fff;
        font-weight: 950
    }

    .preview-card[data-tier="Kim Cương"] {
        border-color: #67e8f9
    }

    .preview-card[data-tier="Vàng"] {
        border-color: #fcd34d
    }

    .preview-card[data-tier="Bạc"] {
        border-color: #cbd5e1
    }

    .preview-card[data-tier="Đồng"] {
        border-color: #fdba74
    }

    .preview-card[data-tier="Kim Cương"] .preview-icon {
        background: linear-gradient(135deg,#00c6ff,#2563eb);
        color: #fff
    }

    .preview-card[data-tier="Vàng"] .preview-icon {
        background: linear-gradient(135deg,#fde68a,#f59e0b);
        color: #78350f
    }

    .preview-card[data-tier="Bạc"] .preview-icon {
        background: linear-gradient(135deg,#f8fafc,#cbd5e1);
        color: #334155
    }

    .preview-card[data-tier="Đồng"] .preview-icon {
        background: linear-gradient(135deg,#fed7aa,#c2410c);
        color: #fff
    }

    @@media(max-width:991.98px) {
        .form-layout {
            grid-template-columns: 1fr
        }

        .preview-card {
            position: static
        }

        .form-grid {
            grid-template-columns: repeat(2,minmax(0,1fr))
        }

        .col-6x, .col-3x, .col-2x {
            grid-column: span 1
        }
    }

    @@media(max-width:767.98px) {
        .form-page {
            padding: 10px;
            min-height: auto
        }

        .form-head {
            padding: 13px;
            flex-direction: column;
            align-items: stretch;
            border-radius: 16px
        }

        .page-title {
            font-size: 1.18rem
        }

        .page-subtitle {
            font-size: .84rem
        }

        .back-btn {
            width: 100%;
            justify-content: center
        }

        .form-card, .preview-card {
            padding: 12px;
            border-radius: 16px
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 10px
        }

        .col-6x, .col-3x, .col-2x {
            grid-column: span 1
        }

        .actions-line {
            align-items: stretch
        }

        .save-btn {
            width: 100%
        }

        .actions-line .text-muted {
            font-size: .78rem
        }

        .preview-card {
            display: none
        }
    }
</style>

<div class="form-page">
    <section class="form-head"><div class="head-title"><span class="head-icon"><i class="bi bi-plus-circle-fill"></i></span><div><h1 class="page-title">Tạo gói đăng tin mới</h1><p class="page-subtitle">Chọn phân loại, hệ thống tự gán hạng để tránh nhập sai.</p></div></div><a href="/Admin/PostServicePackages/Index" class="btn btn-light border back-btn"><i class="bi bi-arrow-left"></i>Trở về danh sách</a></section>
    <div class="form-layout">
        <section class="form-card">
            <form asp-action="Create" method="post" id="packageForm">
                @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-4"></div><div class="form-grid">
                    <div class="col-3x"><label class="field-label">Phân loại gói <span class="text-danger">*</span></label><select asp-for="PackageType" asp-items="ViewBag.PackageTypes" class="form-select soft-input" id="tierSelect" required><option value="">-- Chọn phân loại --</option></select><span asp-validation-for="PackageType" class="text-danger small"></span><small class="text-muted d-block mt-1">Kim Cương → Vàng → Bạc → Đồng → Tin Thường.</small></div>
                    <div class="col-3x"><label class="field-label">Tên hiển thị <span class="text-danger">*</span></label><input asp-for="PackageName" class="form-control soft-input" id="nameInput" placeholder="VD: VIP Kim Cương 30 Ngày" required /><span asp-validation-for="PackageName" class="text-danger small"></span></div>
                    <div class="col-2x"><label class="field-label">Giá tiền</label><div class="input-group"><input asp-for="Price" type="number" min="0" class="form-control soft-input text-danger" id="priceInput" required /><span class="input-group-text soft-input fw-bold">₫</span></div><span asp-validation-for="Price" class="text-danger small"></span><small class="text-muted d-block mt-1" id="priceHint">Giá bán của một lượt đăng tin.</small></div>
                    <div class="col-2x"><label class="field-label">Thời hạn</label><div class="input-group"><input asp-for="DurationDays" type="number" min="0" class="form-control soft-input" id="durationInput" required /><span class="input-group-text soft-input fw-bold" id="durationAddon">ngày</span></div><span asp-validation-for="DurationDays" class="text-danger small"></span><small class="text-muted d-block mt-1" id="durationHint">Gói VIP phải lớn hơn 0 ngày.</small></div>
                    <div class="col-2x"><label class="field-label">Hạng hiển thị</label><input asp-for="PriorityLevel" type="number" class="form-control soft-input readonly-box" id="priorityInput" readonly /><span asp-validation-for="PriorityLevel" class="text-danger small"></span><small class="text-muted d-block mt-1">Tự gán theo loại gói.</small></div>
                    <div class="col-6x"><label class="field-label">Mô tả đặc quyền</label><textarea asp-for="Description" class="form-control soft-input" rows="3" id="descInput" placeholder="Mô tả ngắn quyền lợi của gói..."></textarea><span asp-validation-for="Description" class="text-danger small"></span></div>
                    <div class="col-6x"><div class="active-box"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeSwitch" /><label class="form-check-label fw-bold text-success" for="activeSwitch">Cho phép sử dụng ngay sau khi tạo</label></div><div class="small text-muted mt-1">Nếu tắt, gói được tạo ở trạng thái ngừng dùng.</div></div></div>
                </div><div class="actions-line"><div class="small text-muted"><i class="bi bi-info-circle me-1"></i>Gói đang dùng sẽ xuất hiện trong danh sách mua/chọn gói.</div><button type="submit" class="btn btn-primary save-btn"><i class="bi bi-floppy-fill me-2"></i>Lưu gói mới</button></div>
            </form>
        </section>
        <aside class="preview-card" id="previewCard" data-tier="@Model.PackageType"><div class="preview-title"><span class="preview-icon" id="previewIcon"><i class="bi bi-tag-fill"></i></span><div><div class="preview-tier" id="previewTierText">Tin Thường</div><h2 class="preview-name" id="previewName">Tin Thường 30 Ngày</h2></div></div><div class="preview-row"><span class="preview-label">Giá</span><span class="preview-value text-success" id="previewPrice">Miễn phí</span></div><div class="preview-row"><span class="preview-label">Thời hạn</span><span class="preview-value" id="previewDuration">30 ngày</span></div><div class="preview-row"><span class="preview-label">Hạng</span><span class="rank-pill"><i class="bi bi-arrow-up-circle-fill"></i><span id="previewPriority">5</span></span></div><div class="preview-row"><span class="preview-label">Mô tả</span><span class="preview-value small" id="previewDesc">Gói đăng tin cơ bản.</span></div></aside>
    </div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
        <script>
            const tierOptions=@Html.Raw(ViewBag.TierOptionsJson ?? "[]");const tierSelect=document.getElementById('tierSelect'),nameInput=document.getElementById('nameInput'),priceInput=document.getElementById('priceInput'),durationInput=document.getElementById('durationInput'),priorityInput=document.getElementById('priorityInput'),descInput=document.getElementById('descInput'),priceHint=document.getElementById('priceHint'),durationHint=document.getElementById('durationHint'),previewCard=document.getElementById('previewCard'),previewIcon=document.getElementById('previewIcon'),previewTierText=document.getElementById('previewTierText'),previewName=document.getElementById('previewName'),previewPrice=document.getElementById('previewPrice'),previewDuration=document.getElementById('previewDuration'),previewPriority=document.getElementById('previewPriority'),previewDesc=document.getElementById('previewDesc');
            function tier(){return tierOptions.find(x=>x.type===tierSelect.value)||null}function money(v){const n=parseInt(v||'0');return isNaN(n)||n<=0?'Miễn phí':new Intl.NumberFormat('vi-VN').format(n)+' ₫'}
            function applyDefaults(force=false){const t=tier();if(!t)return;priorityInput.value=t.priorityLevel;if(t.type==='Tin Thường'){priceHint.innerText='Tin thường có thể miễn phí hoặc nhập giá bán.';durationHint.innerText='Nhập 0 nếu muốn hiểu là không hết hạn.'}else{priceHint.innerText='Giá bán một lượt đăng tin VIP.';durationHint.innerText='Gói VIP nên có thời hạn lớn hơn 0 ngày.';if(!durationInput.value||parseInt(durationInput.value)<=0)durationInput.value=t.defaultDurationDays}if(force||!nameInput.value.trim())nameInput.value=t.suggestedPackageName;if(force||!priceInput.value)priceInput.value=t.suggestedPrice;if(force||!durationInput.value)durationInput.value=t.defaultDurationDays;if(force||!descInput.value.trim())descInput.value=t.suggestedDescription}
            function updatePreview(){const t=tier();if(!t){previewCard.setAttribute('data-tier','');previewTierText.innerText='Chưa chọn';previewName.innerText=nameInput.value||'Tên gói';previewPriority.innerText=priorityInput.value||'0';previewDesc.innerText=descInput.value||'Chưa có mô tả.';previewPrice.innerText=money(priceInput.value);previewDuration.innerText=(durationInput.value||0)+' ngày';return}previewCard.setAttribute('data-tier',t.type);previewIcon.innerHTML=`<i class="bi ${t.icon}"></i>`;previewTierText.innerText=t.displayName;previewName.innerText=nameInput.value||t.suggestedPackageName;previewPriority.innerText=priorityInput.value||t.priorityLevel;previewDesc.innerText=descInput.value||t.suggestedDescription;const p=money(priceInput.value);previewPrice.innerText=p;previewPrice.className=p==='Miễn phí'?'preview-value text-success':'preview-value text-danger';const d=parseInt(durationInput.value||'0');previewDuration.innerText=d===0?'Không hết hạn':d+' ngày'}
            tierSelect.addEventListener('change',()=>{applyDefaults(true);updatePreview()});[nameInput,priceInput,durationInput,priorityInput,descInput].forEach(e=>e.addEventListener('input',updatePreview));document.addEventListener('DOMContentLoaded',()=>{applyDefaults(false);updatePreview()});
        </script>
}
