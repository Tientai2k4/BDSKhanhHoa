@model BDSKhanhHoa.Models.Comment

@{
    ViewData["Title"] = "Chi tiết bình luận";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string avatar = string.IsNullOrWhiteSpace(Model.User?.Avatar)
        ? "/images/avatars/default-user.png"
        : Model.User.Avatar;

    string fullName = !string.IsNullOrWhiteSpace(Model.User?.FullName)
        ? Model.User.FullName
        : (!string.IsNullOrWhiteSpace(Model.User?.Username) ? Model.User.Username : "Người dùng");

    string propertyTitle = !string.IsNullOrWhiteSpace(Model.Property?.Title)
        ? Model.Property.Title
        : $"Tin bất động sản #{Model.PropertyID}";

    int riskScore = ViewBag.RiskScore ?? 0;
    string riskLabel = ViewBag.RiskLabel ?? "An toàn";
    string riskClass = ViewBag.RiskClass ?? "risk-safe";
    string riskReasons = ViewBag.RiskReasons ?? "chưa phát hiện dấu hiệu bất thường";
    int userRecentCount = ViewBag.UserRecentCount ?? 0;
    int duplicateCount = ViewBag.DuplicateCount ?? 0;
}

<style>
    :root {
        --detail-bg: #f6f8fc;
        --detail-card: #ffffff;
        --detail-text: #0f172a;
        --detail-muted: #64748b;
        --detail-line: #e2e8f0;
        --detail-blue: #2563eb;
        --detail-green: #16a34a;
        --detail-orange: #f59e0b;
        --detail-red: #dc2626;
        --detail-radius: 18px;
        --detail-shadow: 0 10px 28px rgba(15, 23, 42, .055);
    }

    .comment-detail-page {
        min-height: calc(100vh - 76px);
        padding: 10px 0 30px;
        background: radial-gradient(circle at 0 0, rgba(37,99,235,.07), transparent 28%), linear-gradient(180deg, #f8fafc 0%, var(--detail-bg) 100%);
        color: var(--detail-text);
    }

    .detail-card {
        background: var(--detail-card);
        border: 1px solid var(--detail-line);
        border-radius: var(--detail-radius);
        box-shadow: var(--detail-shadow);
        overflow: hidden;
    }

    .detail-header {
        padding: 14px 16px;
        margin-bottom: 12px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
    }

    .detail-title {
        margin: 0;
        font-size: 1.13rem;
        font-weight: 950;
        line-height: 1.25;
        letter-spacing: -.025em;
    }

    .detail-desc {
        margin: 4px 0 0;
        color: var(--detail-muted);
        font-size: .78rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .detail-header-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .detail-btn {
        border: 0;
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .78rem;
        font-weight: 900;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: .16s ease;
    }

        .detail-btn:hover {
            transform: translateY(-1px);
            text-decoration: none;
        }

    .btn-blue {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .btn-green {
        background: #dcfce7;
        color: #15803d;
    }

    .btn-orange {
        background: #fef3c7;
        color: #b45309;
    }

    .btn-red {
        background: #fee2e2;
        color: #b91c1c;
    }

    .btn-gray {
        background: #e2e8f0;
        color: #0f172a;
    }

    .card-head {
        padding: 14px 16px;
        border-bottom: 1px solid var(--detail-line);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .card-title {
        margin: 0;
        font-size: .96rem;
        font-weight: 950;
    }

    .card-sub {
        margin-top: 3px;
        color: var(--detail-muted);
        font-size: .74rem;
        font-weight: 700;
    }

    .card-body {
        padding: 16px;
    }

    .author-box {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .author-avatar {
        width: 52px;
        height: 52px;
        border-radius: 999px;
        object-fit: cover;
        background: #f1f5f9;
        border: 3px solid #fff;
        box-shadow: 0 10px 22px rgba(15,23,42,.12);
        flex: 0 0 auto;
    }

    .author-name {
        margin: 0;
        color: var(--detail-text);
        font-size: 1rem;
        font-weight: 950;
    }

    .author-meta {
        margin-top: 3px;
        color: var(--detail-muted);
        font-size: .78rem;
        font-weight: 750;
    }

    .status-pill,
    .risk-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .status-visible {
        background: #dcfce7;
        color: #15803d;
    }

    .status-hidden {
        background: #fef3c7;
        color: #b45309;
    }

    .risk-safe {
        background: #dcfce7;
        color: #15803d;
    }

    .risk-low {
        background: #e0f2fe;
        color: #0369a1;
    }

    .risk-medium {
        background: #fef3c7;
        color: #b45309;
    }

    .risk-high {
        background: #fee2e2;
        color: #b91c1c;
    }

    .content-panel {
        background: linear-gradient(180deg, #f8fafc 0%, #fff 100%);
        border: 1px solid var(--detail-line);
        border-radius: 16px;
        padding: 15px;
        color: #334155;
        font-size: .96rem;
        line-height: 1.7;
        font-weight: 650;
        white-space: pre-line;
        word-break: break-word;
    }

    .moderation-box {
        border: 1px solid var(--detail-line);
        border-radius: 16px;
        padding: 14px;
        background: #f8fafc;
        margin-top: 14px;
    }

    .moderation-title {
        margin: 0;
        font-size: .9rem;
        font-weight: 950;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .moderation-desc {
        margin-top: 5px;
        color: var(--detail-muted);
        font-size: .75rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .moderation-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 11px;
    }

    .mini-stat {
        background: #fff;
        border: 1px solid #edf2f7;
        border-radius: 14px;
        padding: 10px;
    }

    .mini-label {
        color: var(--detail-muted);
        font-size: .65rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .mini-value {
        margin-top: 5px;
        color: var(--detail-text);
        font-size: 1.1rem;
        font-weight: 950;
    }

    .action-panel {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid var(--detail-line);
    }

    .reply-list {
        display: grid;
        gap: 10px;
    }

    .reply-item {
        border: 1px solid #eef2f7;
        border-radius: 15px;
        padding: 12px;
        background: #fff;
    }

    .reply-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .reply-user {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }

    .reply-avatar {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        object-fit: cover;
        background: #f1f5f9;
        flex: 0 0 auto;
    }

    .reply-name {
        color: var(--detail-text);
        font-size: .84rem;
        font-weight: 950;
        line-height: 1.2;
    }

    .reply-time {
        color: var(--detail-muted);
        font-size: .7rem;
        font-weight: 750;
        margin-top: 2px;
    }

    .reply-content {
        color: #334155;
        line-height: 1.55;
        font-weight: 650;
        white-space: pre-line;
        word-break: break-word;
        margin-bottom: 10px;
    }

    .reply-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .property-image {
        width: 100%;
        height: 210px;
        object-fit: cover;
        background: #f1f5f9;
    }

    .property-body {
        padding: 15px;
    }

    .property-title {
        margin: 0 0 8px;
        color: var(--detail-text);
        font-size: .98rem;
        font-weight: 950;
        line-height: 1.45;
    }

    .property-price {
        color: var(--detail-blue);
        font-size: 1.08rem;
        font-weight: 950;
        margin-bottom: 7px;
    }

    .property-address {
        color: var(--detail-muted);
        font-size: .8rem;
        font-weight: 700;
        line-height: 1.5;
        margin-bottom: 14px;
    }

    .sticky-side {
        position: sticky;
        top: 92px;
    }

    .empty-replies {
        padding: 28px 14px;
        text-align: center;
        color: var(--detail-muted);
    }

        .empty-replies i {
            font-size: 1.8rem;
            color: #cbd5e1;
            display: block;
            margin-bottom: 8px;
        }

    @@media (max-width: 991.98px) {
        .comment-detail-page {
            padding: 8px 8px 24px;
        }

        .detail-header {
            grid-template-columns: 1fr;
            padding: 12px;
            border-radius: 16px;
        }

        .detail-header-actions {
            display: grid;
            grid-template-columns: 1fr;
            justify-content: stretch;
        }

            .detail-header-actions .detail-btn,
            .action-panel .detail-btn,
            .reply-actions .detail-btn {
                width: 100%;
            }

        .sticky-side {
            position: static;
        }

        .card-head,
        .card-body,
        .property-body {
            padding: 12px;
        }

        .action-panel,
        .reply-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

        .moderation-grid {
            grid-template-columns: 1fr;
        }

        .author-box {
            align-items: flex-start;
        }
    }
</style>

<div class="comment-detail-page">
    <div class="detail-card detail-header">
        <div>
            <h1 class="detail-title">
                <i class="bi bi-chat-square-text-fill text-primary me-2"></i>
                Chi tiết bình luận #@Model.CommentID
            </h1>
            <p class="detail-desc">
                Kiểm tra nội dung, quyết định ẩn/cho hiện, xem phản hồi và mở tin bất động sản liên quan.
            </p>
        </div>

        <div class="detail-header-actions">
            <a href="/Admin/Comments/Index" class="detail-btn btn-gray">
                <i class="bi bi-arrow-left"></i>
                Quay lại danh sách
            </a>

            <a href="/Property/Details/@Model.PropertyID" target="_blank" class="detail-btn btn-blue">
                <i class="bi bi-box-arrow-up-right"></i>
                Mở tin
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-xl-8">
            <div class="detail-card mb-3">
                <div class="card-head">
                    <div>
                        <h5 class="card-title">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Nội dung cần kiểm duyệt
                        </h5>
                        <div class="card-sub">Tạo lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="d-flex gap-2 flex-wrap">
                        <span class="risk-pill @riskClass" title="@riskReasons">
                            <i class="bi @(riskScore >= 70 ? "bi-exclamation-triangle-fill" : riskScore >= 40 ? "bi-shield-exclamation" : "bi-shield-check")"></i>
                            @riskLabel · @riskScore
                        </span>

                        <span class="status-pill @(Model.IsHidden ? "status-hidden" : "status-visible") main-status-badge">
                            <i class="bi @(Model.IsHidden ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            @(Model.IsHidden ? "Đang ẩn" : "Đang hiển thị")
                        </span>
                    </div>
                </div>

                <div class="card-body">
                    <div class="author-box">
                        <img src="@avatar" class="author-avatar" alt="@fullName" onerror="this.src='/images/avatars/default-user.png'" />
                        <div>
                            <h5 class="author-name">@fullName</h5>
                            <div class="author-meta">
                                <i class="bi bi-person-badge me-1"></i>UserID: @Model.UserID
                                <span class="mx-2">·</span>
                                <i class="bi bi-clock me-1"></i>@Model.TimeAgo
                            </div>
                        </div>
                    </div>

                    <div class="content-panel">@Model.Content</div>

                    <div class="moderation-box">
                        <h6 class="moderation-title">
                            <i class="bi bi-robot text-primary"></i>
                            Kiểm duyệt
                        </h6>
                        <div class="moderation-desc">
                            @riskReasons
                        </div>

                        <div class="moderation-grid">
                            <div class="mini-stat">
                                <div class="mini-label">Điểm nghi vấn</div>
                                <div class="mini-value">@riskScore / 100</div>
                            </div>
                            <div class="mini-stat">
                                <div class="mini-label">User gửi trong 24h</div>
                                <div class="mini-value">@userRecentCount.ToString("N0")</div>
                            </div>
                            <div class="mini-stat">
                                <div class="mini-label">Nội dung trùng</div>
                                <div class="mini-value">@duplicateCount.ToString("N0")</div>
                            </div>
                        </div>
                    </div>

                    <div class="action-panel">
                        <button type="button" class="detail-btn @(Model.IsHidden ? "btn-green" : "btn-orange") btn-toggle-admin" data-id="@Model.CommentID">
                            <i class="bi @(Model.IsHidden ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                            <span id="toggleText-@Model.CommentID">
                                @(Model.IsHidden ? "Cho hiện" : "Ẩn")
                            </span>
                        </button>

                        <button type="button" class="detail-btn btn-red btn-delete-admin" data-id="@Model.CommentID">
                            <i class="bi bi-trash-fill"></i>
                            Xóa
                        </button>

                        <a href="/Property/Details/@Model.PropertyID" target="_blank" class="detail-btn btn-blue">
                            <i class="bi bi-house-door-fill"></i>
                            Xem tin liên quan
                        </a>
                    </div>
                </div>
            </div>

            <div class="detail-card">
                <div class="card-head">
                    <div>
                        <h5 class="card-title">
                            <i class="bi bi-reply-all-fill text-primary me-2"></i>
                            Phản hồi trong bình luận này
                        </h5>
                        <div class="card-sub">Ẩn hoặc xóa riêng từng phản hồi khi cần.</div>
                    </div>

                    <span class="status-pill status-visible">@(Model.Replies?.Count ?? 0) phản hồi</span>
                </div>

                <div class="card-body">
                    @if (Model.Replies != null && Model.Replies.Any())
                    {
                        <div class="reply-list">
                            @foreach (var reply in Model.Replies.OrderBy(r => r.CreatedAt))
                            {
                                string replyAvatar = string.IsNullOrWhiteSpace(reply.User?.Avatar) ? "/images/avatars/default-user.png" : reply.User.Avatar;
                                string replyName = !string.IsNullOrWhiteSpace(reply.User?.FullName) ? reply.User.FullName : (!string.IsNullOrWhiteSpace(reply.User?.Username) ? reply.User.Username : "Người dùng");

                                <div class="reply-item" id="reply-row-@reply.CommentID">
                                    <div class="reply-head">
                                        <div class="reply-user">
                                            <img src="@replyAvatar" class="reply-avatar" alt="@replyName" onerror="this.src='/images/avatars/default-user.png'" />
                                            <div>
                                                <div class="reply-name">@replyName</div>
                                                <div class="reply-time">
                                                    <i class="bi bi-clock me-1"></i>
                                                    @reply.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            </div>
                                        </div>

                                        <span class="status-pill @(reply.IsHidden ? "status-hidden" : "status-visible") reply-status-@reply.CommentID">
                                            @(reply.IsHidden ? "Đang ẩn" : "Đang hiện")
                                        </span>
                                    </div>

                                    <div class="reply-content">@reply.Content</div>

                                    <div class="reply-actions">
                                        <button type="button"
                                                class="detail-btn @(reply.IsHidden ? "btn-green" : "btn-orange") btn-toggle-reply"
                                                data-id="@reply.CommentID">
                                            <i class="bi @(reply.IsHidden ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                            <span class="reply-toggle-text-@reply.CommentID">
                                                @(reply.IsHidden ? "Cho hiện" : "Ẩn")
                                            </span>
                                        </button>

                                        <button type="button" class="detail-btn btn-red btn-delete-reply" data-id="@reply.CommentID">
                                            <i class="bi bi-trash-fill"></i>
                                            Xóa
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-replies">
                            <i class="bi bi-chat-left"></i>
                            <div class="fw-bold">Chưa có phản hồi nào</div>
                            <div class="small">Bình luận này hiện chưa có câu trả lời từ người dùng khác.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="detail-card sticky-side">
                <div class="card-head">
                    <div>
                        <h5 class="card-title">
                            <i class="bi bi-house-door-fill text-primary me-2"></i>
                            Tin bất động sản liên quan
                        </h5>
                        <div class="card-sub">Tin mà người dùng đã bình luận.</div>
                    </div>
                </div>

                @if (Model.Property != null)
                {
                    <img src="@(string.IsNullOrWhiteSpace(Model.Property.MainImage) ? "/images/no-image.jpg" : Model.Property.MainImage)"
                         class="property-image"
                         alt="@propertyTitle"
                         onerror="this.src='/images/no-image.jpg'" />

                    <div class="property-body">
                        <h5 class="property-title">@propertyTitle</h5>

                        <div class="property-price">
                            @(Model.Property.Price.HasValue? Model.Property.Price.Value.ToString("N0") + " VNĐ" : "Thỏa thuận")
                        </div>

                        <div class="property-address">
                            <i class="bi bi-geo-alt-fill me-1"></i>
                            @(string.IsNullOrWhiteSpace(Model.Property.AddressDetail) ? "Chưa cập nhật địa chỉ" : Model.Property.AddressDetail)
                        </div>

                        <a href="/Property/Details/@Model.PropertyID" target="_blank" class="detail-btn btn-blue w-100">
                            <i class="bi bi-box-arrow-up-right"></i>
                            Xem chi tiết tin
                        </a>
                    </div>
                }
                else
                {
                    <div class="empty-replies">
                        <i class="bi bi-exclamation-circle"></i>
                        <div class="fw-bold">Tin không còn tồn tại</div>
                        <div class="small">Bất động sản liên quan có thể đã bị xóa khỏi hệ thống.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('.btn-toggle-admin').on('click', function () {
                const id = $(this).data('id');
                const button = $(this);
                const textSpan = $('#toggleText-' + id);

                button.prop('disabled', true);

                $.post('/Admin/Comments/ToggleVisibility', { id: id })
                    .done(function (response) {
                        if (response.success) {
                            updateMainStatus(response.isHidden, button, textSpan);
                            toast('success', response.message || 'Đã cập nhật trạng thái bình luận.');
                        } else {
                            Swal.fire('Lỗi', response.message || 'Không thể cập nhật trạng thái.', 'error');
                        }
                    })
                    .fail(function () {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    })
                    .always(function () {
                        button.prop('disabled', false);
                    });
            });

            $('.btn-delete-admin').on('click', function () {
                const id = $(this).data('id');

                Swal.fire({
                    title: 'Xóa?',
                    text: 'Bình luận chính và toàn bộ phản hồi liên quan sẽ bị xóa vĩnh viễn.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa bình luận',
                    cancelButtonText: 'Không xóa',
                    confirmButtonColor: '#dc2626'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('/Admin/Comments/Delete', { id: id })
                        .done(function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã xóa',
                                    text: response.message || 'Bình luận đã bị xóa khỏi hệ thống.',
                                    timer: 1400,
                                    showConfirmButton: false
                                }).then(function () {
                                    window.location.href = '/Admin/Comments/Index';
                                });
                            } else {
                                Swal.fire('Lỗi', response.message || 'Không thể xóa bình luận.', 'error');
                            }
                        })
                        .fail(function () {
                            Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                        });
                });
            });

            $('.btn-toggle-reply').on('click', function () {
                const id = $(this).data('id');
                const button = $(this);

                button.prop('disabled', true);

                $.post('/Admin/Comments/ToggleVisibility', { id: id })
                    .done(function (response) {
                        if (response.success) {
                            updateReplyStatus(id, response.isHidden, button);
                            toast('success', response.message || 'Đã cập nhật phản hồi.');
                        } else {
                            Swal.fire('Lỗi', response.message || 'Không thể cập nhật phản hồi.', 'error');
                        }
                    })
                    .fail(function () {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    })
                    .always(function () {
                        button.prop('disabled', false);
                    });
            });

            $('.btn-delete-reply').on('click', function () {
                const replyId = $(this).data('id');

                Swal.fire({
                    title: 'Xóa?',
                    text: 'Phản hồi này sẽ bị xóa vĩnh viễn.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa phản hồi',
                    cancelButtonText: 'Không xóa',
                    confirmButtonColor: '#dc2626'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('/Admin/Comments/Delete', { id: replyId })
                        .done(function (response) {
                            if (response.success) {
                                $('#reply-row-' + replyId).fadeOut(200, function () {
                                    $(this).remove();
                                });
                                toast('success', response.message || 'Đã xóa phản hồi.');
                            } else {
                                Swal.fire('Lỗi', response.message || 'Không thể xóa phản hồi.', 'error');
                            }
                        })
                        .fail(function () {
                            Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                        });
                });
            });

            function updateMainStatus(isHidden, button, textSpan) {
                if (isHidden) {
                    textSpan.text('Cho hiện');
                    button.removeClass('btn-orange').addClass('btn-green');
                    button.find('i').removeClass('bi-eye-slash-fill').addClass('bi-eye-fill');

                    $('.main-status-badge')
                        .removeClass('status-visible')
                        .addClass('status-hidden')
                        .html('<i class="bi bi-eye-slash-fill"></i> Đang ẩn');
                } else {
                    textSpan.text('Ẩn');
                    button.removeClass('btn-green').addClass('btn-orange');
                    button.find('i').removeClass('bi-eye-fill').addClass('bi-eye-slash-fill');

                    $('.main-status-badge')
                        .removeClass('status-hidden')
                        .addClass('status-visible')
                        .html('<i class="bi bi-eye-fill"></i> Đang hiển thị');
                }
            }

            function updateReplyStatus(id, isHidden, button) {
                $('.reply-status-' + id)
                    .removeClass('status-visible status-hidden')
                    .addClass(isHidden ? 'status-hidden' : 'status-visible')
                    .text(isHidden ? 'Đang ẩn' : 'Đang hiện');

                button
                    .removeClass('btn-orange btn-green')
                    .addClass(isHidden ? 'btn-green' : 'btn-orange')
                    .find('i')
                    .removeClass('bi-eye-fill bi-eye-slash-fill')
                    .addClass(isHidden ? 'bi-eye-fill' : 'bi-eye-slash-fill');

                $('.reply-toggle-text-' + id).text(isHidden ? 'Cho hiện' : 'Ẩn');
            }

            function toast(icon, title) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: icon,
                    title: title,
                    showConfirmButton: false,
                    timer: 1400
                });
            }
        });
    </script>
}
