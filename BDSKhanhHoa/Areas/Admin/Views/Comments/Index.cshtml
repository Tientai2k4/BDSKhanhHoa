@model IEnumerable<BDSKhanhHoa.Models.Comment>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Quản lý bình luận";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    int totalComments = ViewBag.TotalComments ?? 0;
    int visibleComments = ViewBag.VisibleComments ?? 0;
    int hiddenComments = ViewBag.HiddenComments ?? 0;
    int todayComments = ViewBag.TodayComments ?? 0;
    int riskComments = ViewBag.RiskComments ?? 0;
    int toxicComments = ViewBag.ToxicComments ?? 0;
    int spamComments = ViewBag.SpamComments ?? 0;
    int bulkUserComments = ViewBag.BulkUserComments ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;

    string searchString = ViewBag.SearchString ?? "";
    string status = ViewBag.Status ?? "";
    string dateSort = ViewBag.DateSort ?? "desc";

    Dictionary<int, int> riskScores = ViewBag.RiskScores as Dictionary<int, int> ?? new Dictionary<int, int>();
    Dictionary<int, string> riskLabels = ViewBag.RiskLabels as Dictionary<int, string> ?? new Dictionary<int, string>();
    Dictionary<int, string> riskClasses = ViewBag.RiskClasses as Dictionary<int, string> ?? new Dictionary<int, string>();
    Dictionary<int, string> riskReasons = ViewBag.RiskReasons as Dictionary<int, string> ?? new Dictionary<int, string>();

    int previousPage = currentPage - 1;
    int nextPage = currentPage + 1;
}

<style>
    :root {
        --cmt-bg: #f6f8fc;
        --cmt-card: #ffffff;
        --cmt-text: #0f172a;
        --cmt-muted: #64748b;
        --cmt-line: #e2e8f0;
        --cmt-soft: #f8fafc;
        --cmt-blue: #2563eb;
        --cmt-green: #16a34a;
        --cmt-orange: #f59e0b;
        --cmt-red: #dc2626;
        --cmt-purple: #7c3aed;
        --cmt-radius: 18px;
        --cmt-shadow: 0 10px 28px rgba(15, 23, 42, .055);
    }

    .comments-admin-page {
        min-height: calc(100vh - 76px);
        padding: 10px 0 30px;
        background: radial-gradient(circle at 0 0, rgba(37,99,235,.07), transparent 28%), linear-gradient(180deg, #f8fafc 0%, var(--cmt-bg) 100%);
        color: var(--cmt-text);
    }

    .cmt-card {
        background: var(--cmt-card);
        border: 1px solid var(--cmt-line);
        border-radius: var(--cmt-radius);
        box-shadow: var(--cmt-shadow);
    }

    .cmt-header {
        padding: 14px 16px;
        margin-bottom: 12px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 12px;
    }

    .cmt-title {
        margin: 0;
        font-size: 1.16rem;
        font-weight: 950;
        line-height: 1.25;
        letter-spacing: -.025em;
    }

    .cmt-desc {
        margin: 4px 0 0;
        color: var(--cmt-muted);
        font-size: .78rem;
        font-weight: 700;
        line-height: 1.45;
    }

    .cmt-header-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .cmt-btn {
        border: 0;
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .78rem;
        font-weight: 900;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        transition: .16s ease;
    }

        .cmt-btn:hover {
            transform: translateY(-1px);
            text-decoration: none;
        }

    .btn-blue {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .btn-green {
        background: #dcfce7;
        color: #15803d;
    }

    .btn-orange {
        background: #fef3c7;
        color: #b45309;
    }

    .btn-red {
        background: #fee2e2;
        color: #b91c1c;
    }

    .btn-gray {
        background: #e2e8f0;
        color: #0f172a;
    }

    .btn-purple {
        background: #ede9fe;
        color: #6d28d9;
    }

    .btn-dark {
        background: #0f172a;
        color: #fff;
    }

    .metric-card {
        padding: 13px;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .metric-card::after {
            content: "";
            position: absolute;
            width: 76px;
            height: 76px;
            right: -28px;
            top: -30px;
            border-radius: 999px;
            background: currentColor;
            opacity: .09;
        }

    .metric-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        position: relative;
        z-index: 1;
    }

    .metric-label {
        color: var(--cmt-muted);
        font-size: .64rem;
        font-weight: 950;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .metric-value {
        margin: 0;
        color: var(--cmt-text);
        font-size: 1.34rem;
        font-weight: 950;
        line-height: 1;
        letter-spacing: -.04em;
    }

    .metric-note {
        margin-top: 7px;
        color: var(--cmt-muted);
        font-size: .7rem;
        font-weight: 750;
    }

    .metric-icon {
        width: 36px;
        height: 36px;
        border-radius: 13px;
        display: grid;
        place-items: center;
        color: #fff;
        background: currentColor;
        font-size: 1rem;
    }

    .quick-panel,
    .filter-panel {
        padding: 14px;
        margin-top: 12px;
    }

    .section-title {
        margin: 0;
        font-size: .94rem;
        font-weight: 950;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .section-desc {
        margin-top: 4px;
        color: var(--cmt-muted);
        font-size: .75rem;
        line-height: 1.45;
        font-weight: 700;
    }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 9px;
        margin-top: 12px;
    }

    .quick-card {
        border: 1px solid var(--cmt-line);
        background: #fff;
        border-radius: 15px;
        padding: 11px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--cmt-text);
        transition: .16s ease;
    }

        .quick-card:hover {
            transform: translateY(-1px);
            border-color: #bfdbfe;
            background: #f8fbff;
            color: var(--cmt-text);
            text-decoration: none;
        }

    .quick-name {
        font-size: .78rem;
        font-weight: 950;
        line-height: 1.25;
    }

    .quick-desc {
        margin-top: 2px;
        color: var(--cmt-muted);
        font-size: .67rem;
        font-weight: 700;
        line-height: 1.25;
    }

    .quick-num {
        min-width: 34px;
        height: 34px;
        padding: 0 8px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: .82rem;
        font-weight: 950;
    }

    .filter-title {
        margin: 0 0 10px;
        font-size: .9rem;
        font-weight: 950;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .filter-label {
        color: var(--cmt-muted);
        font-size: .65rem;
        font-weight: 950;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .filter-panel .form-control,
    .filter-panel .form-select {
        min-height: 40px;
        border-radius: 12px;
        border-color: var(--cmt-line);
        background: #fff;
        font-size: .82rem;
        font-weight: 750;
        box-shadow: none !important;
    }

    .bulk-bar {
        display: none;
        margin-top: 12px;
        padding: 11px;
        border-radius: 15px;
        border: 1px solid #bfdbfe;
        background: linear-gradient(135deg, #eff6ff, #ffffff);
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

        .bulk-bar.show {
            display: flex;
        }

    .table-card {
        overflow: hidden;
        margin-top: 12px;
    }

    .table-head {
        padding: 14px 16px;
        border-bottom: 1px solid var(--cmt-line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .table-title {
        margin: 0;
        font-size: .96rem;
        font-weight: 950;
    }

    .table-sub {
        margin-top: 3px;
        color: var(--cmt-muted);
        font-size: .74rem;
        font-weight: 700;
    }

    .comment-table {
        margin: 0;
        font-size: .82rem;
    }

        .comment-table thead th {
            background: #f8fafc;
            color: var(--cmt-muted);
            border-bottom: 1px solid var(--cmt-line);
            padding: 12px 13px;
            font-size: .65rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .06em;
            white-space: nowrap;
        }

        .comment-table tbody td {
            padding: 13px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

    .comment-user {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 165px;
    }

    .comment-avatar {
        width: 36px;
        height: 36px;
        border-radius: 999px;
        object-fit: cover;
        background: #f1f5f9;
        border: 2px solid #fff;
        box-shadow: 0 8px 16px rgba(15,23,42,.1);
        flex: 0 0 auto;
    }

    .comment-name {
        max-width: 150px;
        color: var(--cmt-text);
        font-weight: 950;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .comment-meta {
        margin-top: 2px;
        color: var(--cmt-muted);
        font-size: .68rem;
        font-weight: 750;
    }

    .comment-content-box {
        max-width: 430px;
    }

    .comment-content {
        margin: 0;
        color: #334155;
        line-height: 1.45;
        font-weight: 700;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .comment-note {
        margin-top: 6px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 8px;
        border-radius: 999px;
        background: #f8fafc;
        color: var(--cmt-muted);
        font-size: .66rem;
        font-weight: 850;
    }

    .property-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 250px;
        min-height: 30px;
        padding: 6px 9px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .72rem;
        font-weight: 900;
        text-decoration: none;
    }

        .property-link:hover {
            color: #1d4ed8;
            text-decoration: underline;
        }

        .property-link span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .status-pill,
    .risk-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .status-visible {
        background: #dcfce7;
        color: #15803d;
    }

    .status-hidden {
        background: #fef3c7;
        color: #b45309;
    }

    .risk-safe {
        background: #dcfce7;
        color: #15803d;
    }

    .risk-low {
        background: #e0f2fe;
        color: #0369a1;
    }

    .risk-medium {
        background: #fef3c7;
        color: #b45309;
    }

    .risk-high {
        background: #fee2e2;
        color: #b91c1c;
    }

    .row-actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        flex-wrap: wrap;
    }

    .row-action {
        min-height: 31px;
        padding: 6px 9px;
        border-radius: 10px;
        border: 1px solid var(--cmt-line);
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        font-size: .7rem;
        font-weight: 900;
        text-decoration: none;
        white-space: nowrap;
        transition: .16s ease;
    }

        .row-action:hover {
            transform: translateY(-1px);
            background: #f8fafc;
            text-decoration: none;
        }

    .mobile-comment-list {
        display: none;
    }

    .mobile-comment-card {
        padding: 12px;
        border-bottom: 1px solid #eef2f7;
        background: #fff;
    }

    .mobile-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 7px;
        margin-top: 10px;
    }

        .mobile-actions .row-action {
            width: 100%;
            min-height: 36px;
        }

    .pagination-wrap {
        padding: 14px 16px;
        border-top: 1px solid var(--cmt-line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }

    .page-info {
        color: var(--cmt-muted);
        font-size: .76rem;
        font-weight: 800;
    }

    .pagination .page-link {
        border: 0;
        margin: 0 2px;
        min-width: 34px;
        border-radius: 11px;
        color: #334155;
        font-size: .78rem;
        font-weight: 900;
        text-align: center;
    }

    .pagination .active .page-link {
        background: var(--cmt-blue);
        color: #fff;
    }

    .empty-state {
        padding: 44px 18px;
        text-align: center;
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        border-radius: 22px;
        margin: 0 auto 12px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 1.7rem;
    }

    @@media (max-width: 1199.98px) {
        .quick-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .comments-admin-page {
            padding: 8px 8px 24px;
        }

        .cmt-header {
            grid-template-columns: 1fr;
            padding: 12px;
            border-radius: 16px;
        }

        .cmt-header-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            justify-content: stretch;
        }

            .cmt-header-actions .cmt-btn {
                width: 100%;
            }

        .desktop-comment-table {
            display: none;
        }

        .mobile-comment-list {
            display: block;
        }

        .quick-panel,
        .filter-panel {
            padding: 12px;
            border-radius: 16px;
        }

        .bulk-bar.show {
            display: block;
        }

        .bulk-bar .d-flex {
            display: grid !important;
            grid-template-columns: 1fr;
            width: 100%;
        }

        .bulk-bar .cmt-btn {
            width: 100%;
            margin-top: 7px;
        }

        .table-head {
            padding: 12px;
        }

        .pagination-wrap {
            display: grid;
            justify-content: stretch;
            text-align: center;
            padding: 12px;
        }

        .pagination {
            justify-content: center;
            flex-wrap: wrap;
        }
    }

    @@media (max-width: 575.98px) {
        .comments-admin-page {
            padding: 6px 6px 20px;
        }

        .cmt-title {
            font-size: 1rem;
        }

        .cmt-desc,
        .section-desc {
            font-size: .7rem;
        }

        .cmt-header-actions,
        .quick-grid {
            grid-template-columns: 1fr;
        }

        .metric-card {
            padding: 10px;
            border-radius: 15px;
        }

        .metric-label {
            font-size: .55rem;
            margin-bottom: 4px;
        }

        .metric-value {
            font-size: 1.08rem;
        }

        .metric-note {
            display: none;
        }

        .metric-icon {
            width: 30px;
            height: 30px;
            border-radius: 11px;
            font-size: .82rem;
        }

        .comment-user {
            min-width: 0;
            gap: 8px;
        }

        .comment-avatar {
            width: 33px;
            height: 33px;
        }

        .comment-name {
            max-width: 135px;
            font-size: .82rem;
        }

        .comment-content {
            font-size: .79rem;
        }

        .property-link {
            max-width: 100%;
            border-radius: 11px;
        }

        .filter-actions {
            grid-template-columns: 1fr !important;
        }

        .mobile-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="comments-admin-page">
    <div class="cmt-card cmt-header">
        <div>
            <h1 class="cmt-title">
                <i class="bi bi-chat-square-text-fill text-primary me-2"></i>
                Quản lý bình luận
            </h1>
            <p class="cmt-desc">
                Lọc bình luận, xem chi tiết và xử lý nhanh các nội dung cần kiểm duyệt.
            </p>
        </div>

        <div class="cmt-header-actions">
            <a href="/Admin/Comments" class="cmt-btn btn-gray">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                Xem tất cả
            </a>
        </div>
    </div>

    <div class="row g-2 g-xl-3">
        <div class="col-6 col-md-4 col-xl">
            <div class="cmt-card metric-card" style="color: var(--cmt-blue);">
                <div class="metric-row">
                    <div>
                        <div class="metric-label">Tổng</div>
                        <h2 class="metric-value">@totalComments.ToString("N0")</h2>
                        <div class="metric-note">Tất cả bình luận</div>
                    </div>
                    <div class="metric-icon"><i class="bi bi-chat-dots-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="cmt-card metric-card" style="color: var(--cmt-green);">
                <div class="metric-row">
                    <div>
                        <div class="metric-label">Đang hiện</div>
                        <h2 class="metric-value">@visibleComments.ToString("N0")</h2>
                        <div class="metric-note">Người dùng thấy</div>
                    </div>
                    <div class="metric-icon"><i class="bi bi-eye-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="cmt-card metric-card" style="color: var(--cmt-orange);">
                <div class="metric-row">
                    <div>
                        <div class="metric-label">Đang ẩn</div>
                        <h2 class="metric-value">@hiddenComments.ToString("N0")</h2>
                        <div class="metric-note">Không hiển thị ngoài web</div>
                    </div>
                    <div class="metric-icon"><i class="bi bi-eye-slash-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="cmt-card metric-card" style="color: var(--cmt-purple);">
                <div class="metric-row">
                    <div>
                        <div class="metric-label">Hôm nay</div>
                        <h2 class="metric-value">@todayComments.ToString("N0")</h2>
                        <div class="metric-note">Bình luận mới</div>
                    </div>
                    <div class="metric-icon"><i class="bi bi-lightning-charge-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-8 col-xl">
            <div class="cmt-card metric-card" style="color: var(--cmt-red);">
                <div class="metric-row">
                    <div>
                        <div class="metric-label">Nghi vấn</div>
                        <h2 class="metric-value">@riskComments.ToString("N0")</h2>
                        <div class="metric-note">Nên kiểm tra trước</div>
                    </div>
                    <div class="metric-icon"><i class="bi bi-shield-fill-exclamation"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="cmt-card quick-panel">
        <div>
            <h5 class="section-title">
                <i class="bi bi-funnel-fill text-primary"></i>
                Lọc nhanh
            </h5>
            <div class="section-desc">
                Chọn một nhóm bên dưới để kiểm tra. Muốn xử lý hàng loạt thì tick bình luận rồi dùng thanh thao tác đã chọn.
            </div>
        </div>

        <div class="quick-grid">
            <a class="quick-card" href="@Url.Action("Index", "Comments", new { area = "Admin", status = "risk", dateSort = dateSort, searchString = searchString })">
                <div>
                    <div class="quick-name">Bình luận nghi vấn</div>
                    <div class="quick-desc">Cần ưu tiên kiểm tra</div>
                </div>
                <div class="quick-num btn-red">@riskComments.ToString("N0")</div>
            </a>

            <a class="quick-card" href="@Url.Action("Index", "Comments", new { area = "Admin", status = "toxic", dateSort = dateSort, searchString = searchString })">
                <div>
                    <div class="quick-name">Có từ thô tục</div>
                    <div class="quick-desc">Ngôn từ không phù hợp</div>
                </div>
                <div class="quick-num btn-orange">@toxicComments.ToString("N0")</div>
            </a>

            <a class="quick-card" href="@Url.Action("Index", "Comments", new { area = "Admin", status = "spam", dateSort = dateSort, searchString = searchString })">
                <div>
                    <div class="quick-name">Spam / quảng cáo</div>
                    <div class="quick-desc">Link, Zalo, số điện thoại</div>
                </div>
                <div class="quick-num btn-purple">@spamComments.ToString("N0")</div>
            </a>

            <a class="quick-card" href="@Url.Action("Index", "Comments", new { area = "Admin", status = "bulk", dateSort = dateSort, searchString = searchString })">
                <div>
                    <div class="quick-name">Gửi quá nhiều</div>
                    <div class="quick-desc">Một tài khoản gửi dồn</div>
                </div>
                <div class="quick-num btn-blue">@bulkUserComments.ToString("N0")</div>
            </a>
        </div>
    </div>

    <div class="cmt-card filter-panel">
        <h5 class="filter-title">
            <i class="bi bi-funnel-fill text-primary"></i>
            Tìm và lọc bình luận
        </h5>

        <form method="get" asp-area="Admin" asp-controller="Comments" asp-action="Index">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-xl-5">
                    <div class="filter-label">Tìm kiếm</div>
                    <input type="text"
                           name="searchString"
                           value="@searchString"
                           class="form-control"
                           placeholder="Nhập nội dung, tên người dùng hoặc tiêu đề tin..." />
                </div>

                <div class="col-6 col-xl-2">
                    <div class="filter-label">Nhóm cần xem</div>
                    <select name="status" class="form-select">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(status) ? "selected" : null)">Tất cả bình luận</option>
                        <option value="risk" selected="@(status == "risk" ? "selected" : null)">Nghi vấn</option>
                        <option value="toxic" selected="@(status == "toxic" ? "selected" : null)">Có từ thô tục</option>
                        <option value="spam" selected="@(status == "spam" ? "selected" : null)">Spam / quảng cáo</option>
                        <option value="bulk" selected="@(status == "bulk" ? "selected" : null)">Gửi quá nhiều</option>
                        <option value="duplicate" selected="@(status == "duplicate" ? "selected" : null)">Nội dung trùng lặp</option>
                        <option value="visible" selected="@(status == "visible" ? "selected" : null)">Đang hiển thị</option>
                        <option value="hidden" selected="@(status == "hidden" ? "selected" : null)">Đang ẩn</option>
                        <option value="today" selected="@(status == "today" ? "selected" : null)">Tạo hôm nay</option>
                        <option value="parent" selected="@(status == "parent" ? "selected" : null)">Bình luận gốc</option>
                        <option value="reply" selected="@(status == "reply" ? "selected" : null)">Phản hồi</option>
                    </select>
                </div>

                <div class="col-6 col-xl-2">
                    <div class="filter-label">Sắp xếp</div>
                    <select name="dateSort" class="form-select">
                        <option value="desc" selected="@(dateSort == "desc" ? "selected" : null)">Mới nhất trước</option>
                        <option value="asc" selected="@(dateSort == "asc" ? "selected" : null)">Cũ nhất trước</option>
                    </select>
                </div>

                <div class="col-12 col-xl-3">
                    <div class="d-grid gap-2 filter-actions" style="grid-template-columns: 1fr 1fr;">
                        <button type="submit" class="cmt-btn btn-blue">
                            <i class="bi bi-search"></i>
                            Áp dụng lọc
                        </button>
                        <a href="/Admin/Comments" class="cmt-btn btn-gray">
                            <i class="bi bi-x-circle"></i>
                            Xóa bộ lọc
                        </a>
                    </div>
                </div>
            </div>
        </form>

        <div id="bulkActions" class="bulk-bar">
            <div class="fw-bold text-dark">
                <i class="bi bi-check2-square text-primary me-1"></i>
                Đã chọn <span id="selectedCount">0</span> mục
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="cmt-btn btn-green" onclick="bulkApprove()">
                    <i class="bi bi-eye-fill"></i>
                    Cho hiện
                </button>
                <button type="button" class="cmt-btn btn-orange" onclick="bulkHide()">
                    <i class="bi bi-eye-slash-fill"></i>
                    Ẩn
                </button>
                <button type="button" class="cmt-btn btn-red" onclick="bulkDelete()">
                    <i class="bi bi-trash-fill"></i>
                    Xóa
                </button>
            </div>
        </div>
    </div>

    <div class="cmt-card table-card">
        <div class="table-head">
            <div>
                <h5 class="table-title">
                    <i class="bi bi-list-check text-primary me-2"></i>
                    Danh sách bình luận
                </h5>
                <div class="table-sub">Tìm thấy @totalItems.ToString("N0") kết quả phù hợp.</div>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="desktop-comment-table table-responsive">
                <table class="table table-hover comment-table align-middle">
                    <thead>
                        <tr>
                            <th style="width:42px;">
                                <input type="checkbox" class="form-check-input" id="selectAll" />
                            </th>
                            <th>Người bình luận</th>
                            <th>Nội dung</th>
                            <th>Mức kiểm duyệt</th>
                            <th>Tin liên quan</th>
                            <th>Thời gian</th>
                            <th>Hiển thị</th>
                            <th class="text-end">Nút xử lý</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string avatar = string.IsNullOrWhiteSpace(item.User?.Avatar) ? "/images/avatars/default-user.png" : item.User.Avatar;
                            string fullName = !string.IsNullOrWhiteSpace(item.User?.FullName) ? item.User.FullName : (!string.IsNullOrWhiteSpace(item.User?.Username) ? item.User.Username : "Người dùng");
                            string propertyTitle = !string.IsNullOrWhiteSpace(item.Property?.Title) ? item.Property.Title : $"Tin #{item.PropertyID}";
                            int riskScore = riskScores.ContainsKey(item.CommentID) ? riskScores[item.CommentID] : 0;
                            string riskLabel = riskLabels.ContainsKey(item.CommentID) ? riskLabels[item.CommentID] : "An toàn";
                            string riskClass = riskClasses.ContainsKey(item.CommentID) ? riskClasses[item.CommentID] : "risk-safe";
                            string riskReason = riskReasons.ContainsKey(item.CommentID) ? riskReasons[item.CommentID] : "chưa phát hiện dấu hiệu bất thường";
                            bool isRisky = riskScore >= 40;

                            <tr id="row-@item.CommentID" data-row-id="@item.CommentID">
                                <td>
                                    <input type="checkbox"
                                           class="form-check-input row-checkbox"
                                           data-id="@item.CommentID"
                                           data-risk="@isRisky.ToString().ToLowerInvariant()" />
                                </td>

                                <td>
                                    <div class="comment-user">
                                        <img src="@avatar" class="comment-avatar" alt="@fullName" onerror="this.src='/images/avatars/default-user.png'" />
                                        <div>
                                            <div class="comment-name">@fullName</div>
                                            <div class="comment-meta">User ID: @item.UserID</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="comment-content-box">
                                        <p class="comment-content" title="@item.Content">@item.Content</p>
                                        @if (item.ParentID.HasValue)
                                        {
                                            <span class="comment-note">
                                                <i class="bi bi-reply-fill"></i>
                                                Phản hồi cho #@item.ParentID
                                            </span>
                                        }
                                        else if (item.Replies != null && item.Replies.Any())
                                        {
                                            <span class="comment-note">
                                                <i class="bi bi-chat-left-text"></i>
                                                Có @item.Replies.Count phản hồi
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <span class="risk-pill @riskClass" title="@riskReason">
                                        <i class="bi @(riskScore >= 70 ? "bi-exclamation-triangle-fill" : riskScore >= 40 ? "bi-shield-exclamation" : "bi-shield-check")"></i>
                                        @riskLabel · @riskScore
                                    </span>
                                </td>

                                <td>
                                    <a href="/Property/Details/@item.PropertyID" target="_blank" class="property-link" title="@propertyTitle">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        <span>@propertyTitle</span>
                                    </a>
                                </td>

                                <td>
                                    <div class="fw-bold text-dark">@item.TimeAgo</div>
                                    <div class="text-muted small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>

                                <td>
                                    <span class="status-pill @(item.IsHidden ? "status-hidden" : "status-visible") status-badge-@item.CommentID">
                                        <i class="bi @(item.IsHidden ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                                        @(item.IsHidden ? "Đang ẩn" : "Đang hiện")
                                    </span>
                                </td>

                                <td>
                                    <div class="row-actions">
                                        <a href="/Admin/Comments/Details/@item.CommentID" class="row-action text-primary" title="Mở trang chi tiết bình luận">
                                            <i class="bi bi-card-text"></i>
                                            Chi tiết
                                        </a>

                                        <button type="button" class="row-action text-warning btn-toggle-admin" data-id="@item.CommentID" title="Đổi trạng thái ẩn/hiện">
                                            <i class="bi @(item.IsHidden ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                            @(item.IsHidden ? "Cho hiện" : "Ẩn")
                                        </button>

                                        <button type="button" class="row-action text-danger btn-delete-admin" data-id="@item.CommentID" title="Xóa bình luận">
                                            <i class="bi bi-trash"></i>
                                            Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mobile-comment-list">
                @foreach (var item in Model)
                {
                    string avatar = string.IsNullOrWhiteSpace(item.User?.Avatar) ? "/images/avatars/default-user.png" : item.User.Avatar;
                    string fullName = !string.IsNullOrWhiteSpace(item.User?.FullName) ? item.User.FullName : (!string.IsNullOrWhiteSpace(item.User?.Username) ? item.User.Username : "Người dùng");
                    string propertyTitle = !string.IsNullOrWhiteSpace(item.Property?.Title) ? item.Property.Title : $"Tin #{item.PropertyID}";
                    int riskScore = riskScores.ContainsKey(item.CommentID) ? riskScores[item.CommentID] : 0;
                    string riskLabel = riskLabels.ContainsKey(item.CommentID) ? riskLabels[item.CommentID] : "An toàn";
                    string riskClass = riskClasses.ContainsKey(item.CommentID) ? riskClasses[item.CommentID] : "risk-safe";
                    string riskReason = riskReasons.ContainsKey(item.CommentID) ? riskReasons[item.CommentID] : "chưa phát hiện dấu hiệu bất thường";
                    bool isRisky = riskScore >= 40;

                    <div class="mobile-comment-card" id="mobile-row-@item.CommentID" data-row-id="@item.CommentID">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="comment-user">
                                <input type="checkbox" class="form-check-input row-checkbox" data-id="@item.CommentID" data-risk="@isRisky.ToString().ToLowerInvariant()" />
                                <img src="@avatar" class="comment-avatar" alt="@fullName" onerror="this.src='/images/avatars/default-user.png'" />
                                <div>
                                    <div class="comment-name">@fullName</div>
                                    <div class="comment-meta">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </div>
                            </div>

                            <span class="status-pill @(item.IsHidden ? "status-hidden" : "status-visible") status-badge-@item.CommentID">
                                @(item.IsHidden ? "Đang ẩn" : "Đang hiện")
                            </span>
                        </div>

                        <p class="comment-content mb-2">@item.Content</p>

                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <span class="risk-pill @riskClass" title="@riskReason">@riskLabel · @riskScore</span>
                            <a href="/Property/Details/@item.PropertyID" target="_blank" class="property-link">
                                <i class="bi bi-box-arrow-up-right"></i>
                                <span>@propertyTitle</span>
                            </a>
                        </div>

                        <div class="text-muted small fw-bold">@item.TimeAgo</div>

                        <div class="mobile-actions">
                            <a href="/Admin/Comments/Details/@item.CommentID" class="row-action text-primary">
                                <i class="bi bi-card-text"></i>
                                Chi tiết
                            </a>
                            <button type="button" class="row-action text-warning btn-toggle-admin" data-id="@item.CommentID">
                                <i class="bi @(item.IsHidden ? "bi-eye-fill" : "bi-eye-slash-fill")"></i>
                                @(item.IsHidden ? "Cho hiện" : "Ẩn")
                            </button>
                            <button type="button" class="row-action text-danger btn-delete-admin" data-id="@item.CommentID">
                                <i class="bi bi-trash"></i>
                                Xóa
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="pagination-wrap">
                <div class="page-info">Trang @currentPage / @totalPages · Tổng @totalItems.ToString("N0") bình luận</div>
                <nav aria-label="Phân trang bình luận">
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Comments", new { area = "Admin", page = previousPage, searchString = searchString, status = status, dateSort = dateSort })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Comments", new { area = "Admin", page = i, searchString = searchString, status = status, dateSort = dateSort })">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Comments", new { area = "Admin", page = nextPage, searchString = searchString, status = status, dateSort = dateSort })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon"><i class="bi bi-chat-square-text"></i></div>
                <h5 class="fw-bold mb-2">Không có bình luận phù hợp</h5>
                <p class="text-muted mb-3">Thử đổi từ khóa, chọn nhóm khác hoặc xóa bộ lọc.</p>
                <a href="/Admin/Comments" class="cmt-btn btn-blue">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Xóa bộ lọc
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            const bulkBar = $('#bulkActions');
            const selectedCountText = $('#selectedCount');

            $('#selectAll').on('change', function () {
                $('.row-checkbox').prop('checked', this.checked);
                toggleBulkActions();
            });

            $(document).on('change', '.row-checkbox', function () {
                toggleBulkActions();

                const totalCheckbox = $('.desktop-comment-table .row-checkbox').length;
                const totalChecked = $('.desktop-comment-table .row-checkbox:checked').length;
                $('#selectAll').prop('checked', totalCheckbox > 0 && totalCheckbox === totalChecked);
            });

            $(document).on('click', '.btn-toggle-admin', function () {
                const id = $(this).data('id');
                const button = $(this);
                button.prop('disabled', true);

                $.post('/Admin/Comments/ToggleVisibility', { id: id })
                    .done(function (response) {
                        if (response.success) {
                            updateStatusBadge(id, response.isHidden);
                            updateToggleButtons(id, response.isHidden);
                            toast('success', response.message || 'Đã cập nhật trạng thái.');
                        } else {
                            Swal.fire('Lỗi', response.message || 'Không thể cập nhật trạng thái.', 'error');
                        }
                    })
                    .fail(function () {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    })
                    .always(function () {
                        button.prop('disabled', false);
                    });
            });

            $(document).on('click', '.btn-delete-admin', function () {
                const id = $(this).data('id');

                Swal.fire({
                    title: 'Xóa bình luận này?',
                    text: 'Bình luận và phản hồi liên quan sẽ bị xóa vĩnh viễn.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Xóa bình luận',
                    cancelButtonText: 'Không xóa',
                    confirmButtonColor: '#dc2626'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.post('/Admin/Comments/Delete', { id: id })
                        .done(function (response) {
                            if (response.success) {
                                removeRows([id]);
                                toast('success', response.message || 'Đã xóa bình luận.');
                            } else {
                                Swal.fire('Lỗi', response.message || 'Không thể xóa bình luận.', 'error');
                            }
                        })
                        .fail(function () {
                            Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                        });
                });
            });

            window.bulkApprove = function () {
                confirmBulkAction(
                    '/Admin/Comments/ApproveSelected',
                    'Cho hiển thị các bình luận đã chọn?',
                    'Các bình luận đã chọn sẽ được hiển thị công khai cho người dùng.',
                    'Cho hiển thị',
                    false,
                    function (ids) {
                        ids.forEach(function (id) {
                            updateStatusBadge(id, false);
                            updateToggleButtons(id, false);
                        });
                    });
            };

            window.bulkHide = function () {
                confirmBulkAction(
                    '/Admin/Comments/HideSelected',
                    'Ẩn các bình luận đã chọn?',
                    'Các bình luận đã chọn sẽ không còn hiển thị ngoài website.',
                    'Ẩn bình luận',
                    false,
                    function (ids) {
                        ids.forEach(function (id) {
                            updateStatusBadge(id, true);
                            updateToggleButtons(id, true);
                        });
                    });
            };

            window.bulkDelete = function () {
                confirmBulkAction(
                    '/Admin/Comments/DeleteSelected',
                    'Xóa các bình luận đã chọn?',
                    'Hành động này không thể hoàn tác.',
                    'Xóa bình luận',
                    true,
                    function (ids) {
                        removeRows(ids);
                    });
            };

            function getSelectedIds() {
                const ids = [];

                $('.row-checkbox:checked').each(function () {
                    const id = parseInt($(this).data('id'));
                    if (!isNaN(id) && ids.indexOf(id) === -1) {
                        ids.push(id);
                    }
                });

                return ids;
            }

            function toggleBulkActions() {
                const count = getSelectedIds().length;
                selectedCountText.text(count);
                bulkBar.toggleClass('show', count > 0);
            }

            function confirmBulkAction(url, title, text, confirmText, danger, afterSuccess) {
                const ids = getSelectedIds();

                if (ids.length === 0) {
                    Swal.fire('Chưa chọn bình luận', 'Vui lòng tick chọn ít nhất một bình luận.', 'info');
                    return;
                }

                Swal.fire({
                    title: title,
                    text: text,
                    icon: danger ? 'warning' : 'question',
                    showCancelButton: true,
                    confirmButtonText: confirmText,
                    cancelButtonText: 'Hủy',
                    confirmButtonColor: danger ? '#dc2626' : '#2563eb'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url: url,
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(ids)
                    })
                    .done(function (response) {
                        if (response.success) {
                            afterSuccess(ids);
                            $('.row-checkbox').prop('checked', false);
                            $('#selectAll').prop('checked', false);
                            toggleBulkActions();
                            toast('success', response.message || 'Đã xử lý thành công.');
                        } else {
                            Swal.fire('Thông báo', response.message || 'Không thể xử lý.', 'info');
                        }
                    })
                    .fail(function () {
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    });
                });
            }

            function updateStatusBadge(id, isHidden) {
                const badge = $('.status-badge-' + id);
                badge
                    .removeClass('status-visible status-hidden')
                    .addClass(isHidden ? 'status-hidden' : 'status-visible')
                    .html(isHidden
                        ? '<i class="bi bi-eye-slash-fill"></i> Đang ẩn'
                        : '<i class="bi bi-eye-fill"></i> Đang hiện');
            }

            function updateToggleButtons(id, isHidden) {
                $('[data-id="' + id + '"].btn-toggle-admin').each(function () {
                    const button = $(this);
                    button.html(isHidden
                        ? '<i class="bi bi-eye-fill"></i> Cho hiện'
                        : '<i class="bi bi-eye-slash-fill"></i> Ẩn');
                });
            }

            function removeRows(ids) {
                ids.forEach(function (id) {
                    $('#row-' + id + ', #mobile-row-' + id).fadeOut(180, function () {
                        $(this).remove();
                    });
                });
            }

            function toast(icon, title) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: icon,
                    title: title,
                    showConfirmButton: false,
                    timer: 1400
                });
            }
        });
    </script>
}
