@model BDSKhanhHoa.Models.AIKnowledgeArticle

@{
    ViewData["Title"] = Model.ArticleID > 0 ? "Sửa dữ liệu huấn luyện AI" : "Thêm dữ liệu huấn luyện AI";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string currentCategory = string.IsNullOrWhiteSpace(Model.Category) ? "General" : Model.Category;
    bool currentPublished = Model.ArticleID <= 0 || Model.IsPublished;

    var categoryOptions = ViewBag.CategoryOptions as List<KeyValuePair<string, string>>
        ?? new List<KeyValuePair<string, string>>
        {
            new KeyValuePair<string, string>("Core", "Vai trò & nguyên tắc"),
            new KeyValuePair<string, string>("Buy", "Tư vấn mua"),
            new KeyValuePair<string, string>("Rent", "Tư vấn thuê"),
            new KeyValuePair<string, string>("PropertyDetail", "Phân tích tin đang xem"),
            new KeyValuePair<string, string>("Legal", "Pháp lý cơ bản"),
            new KeyValuePair<string, string>("Transaction", "Giao dịch & công chứng"),
            new KeyValuePair<string, string>("Loan", "Vay vốn"),
            new KeyValuePair<string, string>("Posting", "Đăng tin"),
            new KeyValuePair<string, string>("Project", "Dự án"),
            new KeyValuePair<string, string>("Care", "Chăm sóc khách hàng"),
            new KeyValuePair<string, string>("Market", "Kinh nghiệm thị trường"),
            new KeyValuePair<string, string>("Search", "Quy tắc tìm tin SQL"),
            new KeyValuePair<string, string>("Guardrail", "Giới hạn an toàn"),
            new KeyValuePair<string, string>("Fallback", "Fallback khi thiếu dữ liệu"),
            new KeyValuePair<string, string>("General", "Thông tin chung")
        };
}

<style>
    :root {
        --edit-primary: #2563eb;
        --edit-primary-dark: #1d4ed8;
        --edit-primary-soft: #eff6ff;
        --edit-success: #059669;
        --edit-success-soft: #ecfdf5;
        --edit-dark: #0f172a;
        --edit-text: #334155;
        --edit-muted: #64748b;
        --edit-border: #e2e8f0;
        --edit-soft: #f8fafc;
        --edit-card: #ffffff;
        --edit-radius: 16px;
        --edit-shadow: 0 8px 24px rgba(15, 23, 42, .055);
    }

    .ai-edit-page,
    .ai-edit-page * {
        box-sizing: border-box;
    }

    .ai-edit-page {
        max-width: 1440px;
        margin: 0 auto;
        padding: 14px 0 40px;
        color: var(--edit-text);
        overflow-x: hidden;
    }

    .edit-topbar {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 14px;
        margin-bottom: 14px;
    }

    .edit-kicker {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        color: var(--edit-primary);
        background: var(--edit-primary-soft);
        border: 1px solid #bfdbfe;
        font-size: .76rem;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .edit-title {
        margin: 0;
        color: var(--edit-dark);
        font-size: clamp(1.25rem, 2.1vw, 1.72rem);
        line-height: 1.22;
        font-weight: 900;
        letter-spacing: -.025em;
    }

    .edit-desc {
        margin: 5px 0 0;
        color: var(--edit-muted);
        font-size: .9rem;
        line-height: 1.55;
        font-weight: 500;
        max-width: 860px;
    }

    .edit-back-btn {
        min-height: 40px;
        padding: 0 16px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        color: var(--edit-dark);
        background: #fff;
        border: 1px solid var(--edit-border);
        text-decoration: none;
        font-size: .88rem;
        font-weight: 850;
        white-space: nowrap;
        box-shadow: var(--edit-shadow);
    }

        .edit-back-btn:hover {
            color: var(--edit-primary);
            background: var(--edit-primary-soft);
            border-color: #bfdbfe;
        }

    .edit-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 14px;
        align-items: start;
    }

    .edit-card,
    .edit-side-card {
        background: #fff;
        border: 1px solid var(--edit-border);
        border-radius: var(--edit-radius);
        box-shadow: var(--edit-shadow);
        overflow: hidden;
    }

    .edit-card-head,
    .edit-side-head {
        padding: 14px 16px;
        border-bottom: 1px solid var(--edit-border);
        background: #fff;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .edit-panel-title {
        margin: 0;
        color: var(--edit-dark);
        font-size: .98rem;
        font-weight: 900;
    }

    .edit-panel-sub {
        margin: 3px 0 0;
        color: var(--edit-muted);
        font-size: .8rem;
        line-height: 1.45;
    }

    .edit-card-body,
    .edit-side-body {
        padding: 16px;
    }

    .publish-switch {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-height: 36px;
        padding: 0 12px;
        border-radius: 999px;
        color: #166534;
        background: var(--edit-success-soft);
        border: 1px solid #bbf7d0;
        font-size: .82rem;
        font-weight: 850;
        white-space: nowrap;
    }

        .publish-switch .form-check-input {
            margin: 0;
            width: 2.25em;
            height: 1.2em;
            cursor: pointer;
        }

    .edit-label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: .8rem;
        font-weight: 850;
    }

    .edit-form-control,
    .edit-form-select {
        width: 100%;
        min-height: 44px;
        border-radius: 12px;
        border: 1px solid #dbe4ef;
        background: #f8fafc;
        color: var(--edit-dark);
        font-size: .92rem;
        font-weight: 600;
        padding: 0 12px;
        box-shadow: none !important;
    }

        .edit-form-control:focus,
        .edit-form-select:focus,
        .edit-content-box:focus {
            border-color: #93c5fd;
            background: #fff;
            outline: none;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .08) !important;
        }

    .edit-content-box {
        width: 100%;
        min-height: 520px;
        border-radius: 14px;
        border: 1px solid #dbe4ef;
        background: #fcfdff;
        color: var(--edit-dark);
        padding: 13px 14px;
        font-size: .92rem;
        line-height: 1.65;
        font-family: Consolas, Monaco, 'Courier New', monospace;
        resize: vertical;
    }

    .char-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 7px;
        color: var(--edit-muted);
        font-size: .8rem;
    }

    .save-bar {
        margin-top: 14px;
        padding: 12px;
        border-radius: 14px;
        background: var(--edit-soft);
        border: 1px solid var(--edit-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .save-note {
        color: var(--edit-muted);
        font-size: .82rem;
        line-height: 1.45;
        font-weight: 600;
    }

    .save-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .round-btn {
        min-height: 38px;
        padding: 0 15px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .86rem;
        font-weight: 850;
    }

    .template-list {
        display: grid;
        gap: 8px;
    }

    .template-btn {
        min-height: 38px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        font-size: .86rem;
        font-weight: 850;
        text-align: left;
    }

    .guide-box {
        display: grid;
        gap: 9px;
    }

    .guide-step {
        display: grid;
        grid-template-columns: 28px minmax(0, 1fr);
        gap: 10px;
        padding: 10px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid var(--edit-border);
    }

    .guide-step-num {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        background: var(--edit-primary-soft);
        color: var(--edit-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: .82rem;
    }

    .guide-step b {
        display: block;
        color: var(--edit-dark);
        font-size: .86rem;
        margin-bottom: 2px;
    }

    .guide-step p {
        margin: 0;
        color: var(--edit-muted);
        font-size: .78rem;
        line-height: 1.45;
    }

    .small-alert {
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid #bfdbfe;
        background: var(--edit-primary-soft);
        color: #1e40af;
        font-size: .78rem;
        line-height: 1.5;
    }

    @@media(max-width: 1199.98px) {
        .edit-layout {
            grid-template-columns: minmax(0, 1fr) 300px;
        }
    }

    @@media(max-width: 991.98px) {
        .ai-edit-page {
            padding-top: 10px;
        }

        .edit-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .edit-back-btn {
            width: 100%;
        }

        .edit-layout {
            display: block;
        }

        .edit-side-card {
            margin-top: 14px;
        }

        .edit-content-box {
            min-height: 420px;
        }
    }

    @@media(max-width: 575.98px) {
        .ai-edit-page {
            padding: 8px 0 34px;
        }

        .edit-title {
            font-size: 1.18rem;
        }

        .edit-desc {
            font-size: .84rem;
        }

        .edit-card-head {
            display: block;
        }

        .publish-switch {
            margin-top: 10px;
            width: 100%;
            justify-content: space-between;
        }

        .edit-card-body,
        .edit-side-body {
            padding: 12px;
        }

        .edit-content-box {
            min-height: 360px;
            font-size: .86rem;
        }

        .save-bar {
            display: block;
        }

        .save-actions {
            margin-top: 10px;
            display: grid;
            grid-template-columns: 1fr;
        }

        .round-btn,
        .template-btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid ai-edit-page">
    <section class="edit-topbar">
        <div>
            <div class="edit-kicker">
                <i class="bi bi-robot"></i>
                Dữ liệu huấn luyện nội bộ
            </div>

            <h1 class="edit-title">@ViewData["Title"]</h1>

            <p class="edit-desc">
                Nhập tiêu đề, nhóm nội dung, nội dung huấn luyện và trạng thái bật/tắt. Nội dung càng rõ tình huống, checklist và ví dụ thì Chatbot trả lời càng ổn định.
            </p>
        </div>

        <a asp-action="Index" class="edit-back-btn">
            <i class="bi bi-arrow-left"></i>
            Quay lại danh sách
        </a>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-3">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Save" method="post" id="aiTrainingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ArticleID" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="UpdatedAt" />
        <input type="hidden" asp-for="IsPublished" value="@currentPublished.ToString().ToLowerInvariant()" id="IsPublished" />

        <section class="edit-layout">
            <main class="edit-card">
                <div class="edit-card-head">
                    <div>
                        <h2 class="edit-panel-title">
                            <i class="bi bi-pencil-square text-primary me-1"></i>
                            Nội dung huấn luyện
                        </h2>
                        <p class="edit-panel-sub">Viết theo cấu trúc: tình huống → cách hiểu → cách hỏi → cách trả lời → giới hạn an toàn.</p>
                    </div>

                    <label class="publish-switch" for="PublishSwitch">
                        <input class="form-check-input" type="checkbox" id="PublishSwitch" @(currentPublished ? "checked" : "") />
                        Bật sử dụng
                    </label>
                </div>

                <div class="edit-card-body">
                    <div class="mb-3">
                        <label class="edit-label">Tiêu đề dữ liệu huấn luyện <span class="text-danger">*</span></label>
                        <input asp-for="Title"
                               class="edit-form-control"
                               maxlength="255"
                               required
                               id="Title"
                               placeholder="Ví dụ: Luồng tư vấn người mua bất động sản" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="edit-label">Nhóm nội dung <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="edit-form-select" id="Category" required>
                            @foreach (var item in categoryOptions)
                            {
                                <option value="@item.Key" selected="@(string.Equals(currentCategory, item.Key, StringComparison.OrdinalIgnoreCase))">@item.Value</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="edit-label">Nội dung huấn luyện <span class="text-danger">*</span></label>
                        <textarea asp-for="Content"
                                  class="edit-content-box"
                                  rows="26"
                                  required
                                  id="Content"
                                  placeholder="Nhập nội dung huấn luyện hoặc bấm mẫu nhanh bên phải..."></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>

                        <div class="char-row">
                            <span>Nên có tình huống, checklist, quy tắc hỏi lại và ví dụ trả lời.</span>
                            <b id="aiCharCount">0 ký tự</b>
                        </div>
                    </div>

                    <div class="save-bar">
                        <div class="save-note">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            Không nhập nội dung cam kết chắc chắn về pháp lý, quy hoạch, vay vốn hoặc lợi nhuận.
                        </div>

                        <div class="save-actions">
                            <a asp-action="Index" class="btn btn-light border round-btn">Hủy</a>
                            <button type="submit" class="btn btn-primary round-btn">
                                <i class="bi bi-save"></i>
                                Lưu dữ liệu
                            </button>
                        </div>
                    </div>
                </div>
            </main>

            <aside>
                <div class="edit-side-card mb-3">
                    <div class="edit-side-head">
                        <div>
                            <h2 class="edit-panel-title">
                                <i class="bi bi-magic text-primary me-1"></i>
                                Mẫu nhanh
                            </h2>
                            <p class="edit-panel-sub">Bấm để tự điền tiêu đề, nhóm và nội dung.</p>
                        </div>
                    </div>

                    <div class="edit-side-body">
                        <div class="template-list">
                            <button type="button" class="btn btn-primary template-btn js-load-template" data-template="full"><i class="bi bi-robot"></i>Bộ tổng hợp đầy đủ</button>
                            <button type="button" class="btn btn-outline-primary template-btn js-load-template" data-template="buyer"><i class="bi bi-house-check"></i>Tư vấn người mua</button>
                            <button type="button" class="btn btn-outline-success template-btn js-load-template" data-template="legal"><i class="bi bi-shield-check"></i>Pháp lý - thủ tục</button>
                            <button type="button" class="btn btn-outline-warning template-btn js-load-template" data-template="posting"><i class="bi bi-megaphone"></i>Hỗ trợ đăng tin</button>
                            <button type="button" class="btn btn-outline-info template-btn js-load-template" data-template="strict"><i class="bi bi-funnel"></i>Quy tắc lọc tin</button>
                            <button type="button" class="btn btn-outline-dark template-btn js-load-template" data-template="detail"><i class="bi bi-card-checklist"></i>Phân tích tin đang xem</button>
                            <button type="button" class="btn btn-outline-danger template-btn js-load-template" data-template="guard"><i class="bi bi-exclamation-octagon"></i>Guardrail an toàn</button>
                        </div>

                        <div class="small-alert">
                            Admin chỉ cần nhập 4 phần chính: tiêu đề, nhóm, nội dung và bật/tắt. Không cần nhập mã, thứ tự ưu tiên hoặc khu vực áp dụng.
                        </div>
                    </div>
                </div>

                <div class="edit-side-card">
                    <div class="edit-side-head">
                        <div>
                            <h2 class="edit-panel-title">
                                <i class="bi bi-check2-square text-success me-1"></i>
                                Cách viết tốt
                            </h2>
                        </div>
                    </div>

                    <div class="edit-side-body">
                        <div class="guide-box">
                            <div class="guide-step"><span class="guide-step-num">1</span><div><b>Nêu tình huống thật</b><p>Ví dụ người dùng hỏi mua đất, hỏi pháp lý, hỏi vay vốn.</p></div></div>
                            <div class="guide-step"><span class="guide-step-num">2</span><div><b>Ghi luồng hỏi</b><p>Thiếu thông tin thì hỏi 2-4 ý quan trọng nhất.</p></div></div>
                            <div class="guide-step"><span class="guide-step-num">3</span><div><b>Ghi điều cấm</b><p>Không bịa giá, pháp lý, quy hoạch, lãi suất, lợi nhuận.</p></div></div>
                            <div class="guide-step"><span class="guide-step-num">4</span><div><b>Có mẫu trả lời</b><p>Mẫu cụ thể giúp Gemini diễn đạt ổn định hơn.</p></div></div>
                        </div>
                    </div>
                </div>
            </aside>
        </section>
    </form>
</div>

<template id="tpl-full">
    # BỘ HUẤN LUYỆN TỔNG HỢP CHATBOT AI BĐS KHÁNH HÒA

    ## Vai trò
    Bạn là Trợ lý AI tư vấn bất động sản cho website BĐS Khánh Hòa. Bạn hỗ trợ tìm mua, tìm thuê, pháp lý cơ bản, giao dịch, vay vốn tham khảo, đăng tin, dự án và chăm sóc khách hàng.

    ## Nguyên tắc bắt buộc
    - Trả lời tiếng Việt, lịch sự, rõ ràng, thực tế.
    - Luôn tóm tắt nhu cầu người dùng.
    - Nếu thiếu thông tin, hỏi tối đa 2-4 câu quan trọng nhất.
    - Không hỏi lại thông tin đã có trong phiên chat.
    - Khi đủ khoảng 70% dữ liệu, ưu tiên tư vấn hoặc tìm tin SQL.
    - Nếu có dữ liệu SQL, chỉ dùng tin thật từ hệ thống.
    - Nếu không có tin phù hợp, nói rõ chưa tìm thấy và gợi ý nới tiêu chí.
    - Không tự nhận là luật sư, ngân hàng, công chứng viên, cơ quan nhà nước.
    - Không cam kết chắc chắn lợi nhuận, quy hoạch, pháp lý, lãi suất, khả năng vay.
    - Không bịa giá thị trường, chủ đầu tư, pháp lý, quy hoạch, tình trạng thế chấp.

    ## Luồng mua
    Hỏi theo thứ tự: mục đích, loại BĐS, khu vực, ngân sách, diện tích, pháp lý, đường vào/tiện ích, vay vốn, thời gian mua.
    Ví dụ: “Tôi muốn mua đất Nha Trang dưới 1 tỷ.”
    Trả lời: “Em hiểu Anh/Chị muốn mua đất tại Nha Trang, ngân sách dưới 1 tỷ. Để lọc đúng hơn, Anh/Chị cho em biết thêm 3 ý: mua để ở hay đầu tư, diện tích mong muốn khoảng bao nhiêu m², và có bắt buộc sổ đỏ/sổ hồng riêng không?”

    ## Luồng thuê
    Hỏi: thuê để ở hay kinh doanh, loại tài sản, khu vực, ngân sách/tháng, số người ở/ngành nghề, tiện ích, thời gian thuê. Với mặt bằng kinh doanh, nhắc kiểm tra cọc, tăng giá, sửa chữa, biển hiệu, giấy phép, điện nước, chấm dứt hợp đồng.

    ## Pháp lý
    Trả checklist: sổ gốc, chủ sở hữu, đồng sở hữu, thừa kế, ủy quyền, diện tích, mục đích sử dụng, quy hoạch, lộ giới, tranh chấp, thế chấp, ngăn chặn, hiện trạng thực tế. Luôn nhắc xác minh tại cơ quan đất đai, công chứng, luật sư hoặc cơ quan có thẩm quyền.

    ## Giao dịch
    Quy trình: xác định nhu cầu, tìm tin, xem thực tế, kiểm tra pháp lý, thỏa thuận giá/thuế phí, đặt cọc nếu cần, công chứng, thanh toán an toàn, kê khai thuế phí, sang tên, nhận sổ, bàn giao.

    ## Vay vốn
    Hỏi: giá trị BĐS, vốn tự có, số tiền vay, thu nhập tháng, chi phí cố định, thời hạn vay, pháp lý tài sản. Nói rõ chỉ ước tính tham khảo, ngân hàng quyết định theo hồ sơ.

    ## Đăng tin
    Hỗ trợ tiêu đề, mô tả, ảnh, giá, vị trí, diện tích, pháp lý, đường vào, tiện ích. Không hỗ trợ viết tin sai sự thật, che giấu tranh chấp, cam kết “bao lời”.

    ## Guardrail
    Từ chối làm giả sổ, né thuế, giấu tranh chấp, lừa người mua/bán, hack, cá độ, nội dung ngoài phạm vi. Từ chối lịch sự và chuyển sang hướng hợp pháp/an toàn.
</template>

<template id="tpl-buyer">
    # MẪU HUẤN LUYỆN TƯ VẤN NGƯỜI MUA

    ## Khi người dùng muốn mua
    Cần xác định: mục đích mua, loại bất động sản, khu vực, ngân sách, diện tích, pháp lý, đường vào, tiện ích, vay vốn, thời gian mua.

    ## Ví dụ 1
    Người dùng: “Tôi muốn mua một lô đất ở Diên Khánh nhưng chưa biết nên chọn xã nào, ngân sách khoảng 1,5 tỷ.”
    Bot nên trả: “Em hiểu Anh/Chị muốn mua đất ở Diên Khánh, ngân sách khoảng 1,5 tỷ và chưa chọn xã cụ thể. Để tư vấn sát hơn, Anh/Chị cho em biết thêm 3 ý: mua để ở hay đầu tư, có yêu cầu sổ riêng/sổ đỏ rõ ràng không, và ưu tiên gần trung tâm/trường/chợ hay chấp nhận khu ven yên tĩnh hơn?”

    ## Ví dụ 2
    Người dùng: “Tôi có 900 triệu, muốn mua đất ở Khánh Hòa để sau này xây nhà, có khả thi không?”
    Bot nên nói: “Có thể xem xét nhưng phụ thuộc khu vực, diện tích, pháp lý và hạ tầng. Với ngân sách 900 triệu, khu trung tâm thường ít lựa chọn hơn; Anh/Chị nên ưu tiên pháp lý rõ, đất có mục đích sử dụng phù hợp xây nhà, đường vào hợp pháp, điện nước và khả năng xây dựng sau này.”

    ## Quy tắc
    - Đúng khu vực thì lọc đúng khu vực.
    - Đúng loại đất thì không gợi ý căn hộ/nhà nếu chưa hỏi lại.
    - Nếu thiếu pháp lý trong dữ liệu SQL thì nói cần kiểm tra, không khẳng định có sổ.
    - Không cam kết tăng giá.
</template>

<template id="tpl-legal">
    # MẪU HUẤN LUYỆN PHÁP LÝ - THỦ TỤC

    ## Mua đất lần đầu cần kiểm tra
    1. Sổ đỏ/sổ hồng bản gốc.
    2. Người đứng tên trên sổ và giấy tờ tùy thân.
    3. Tài sản chung riêng, vợ chồng, đồng sở hữu, thừa kế, ủy quyền.
    4. Số thửa, tờ bản đồ, diện tích, mục đích sử dụng, thời hạn sử dụng.
    5. Quy hoạch, lộ giới, hành lang bảo vệ.
    6. Tranh chấp, thế chấp, ngăn chặn giao dịch.
    7. Đường vào hợp pháp.
    8. Ranh giới và hiện trạng thực tế.
    9. Điều kiện công chứng/sang tên.
    10. Điều kiện hoàn cọc nếu pháp lý không đúng cam kết.

    ## Cảnh báo
    Nếu chỉ xem ảnh chụp sổ, không nên đặt cọc ngay. Cần xem sổ gốc và xác minh tại văn phòng công chứng/cơ quan đất đai.

    ## Mẫu kết luận
    “Thông tin này chỉ mang tính tham khảo. Trước khi giao dịch, Anh/Chị nên kiểm tra tại văn phòng đăng ký đất đai, văn phòng công chứng, UBND địa phương hoặc hỏi luật sư/cơ quan có thẩm quyền.”
</template>

<template id="tpl-posting">
    # MẪU HUẤN LUYỆN HỖ TRỢ ĐĂNG TIN

    ## Thông tin cần chuẩn bị
    - Bán hay cho thuê.
    - Loại BĐS.
    - Khu vực/xã phường.
    - Diện tích.
    - Giá.
    - Pháp lý.
    - Đường vào.
    - Hướng.
    - Tiện ích.
    - Ảnh thật.
    - Thông tin liên hệ.

    ## Tiêu đề mẫu
    “Bán đất 100m² tại Diên Khánh, giá 1,2 tỷ, phù hợp xây nhà ở”
    “Cho thuê nhà nguyên căn Nha Trang, vị trí thuận tiện, phù hợp gia đình”

    ## Mô tả tốt
    Mô tả trung thực, rõ vị trí, diện tích, giá, pháp lý, đường vào, tiện ích, hiện trạng và điểm phù hợp. Không dùng thông tin chưa được người bán cung cấp.

    ## Điều cấm
    Không viết tin sai sự thật, không nói quá, không giấu tranh chấp/quy hoạch/thế chấp, không cam kết “bao lời, chắc chắn tăng giá”.
</template>

<template id="tpl-strict">
    # QUY TẮC LỌC TIN ĐÚNG KHU VỰC VÀ ĐÚNG LOẠI

    Khi người dùng yêu cầu tìm tin theo khu vực cụ thể, AI chỉ được lấy tin đúng khu vực đó.

    Ví dụ: “nhà Cam Lâm dưới 3 tỷ” thì chỉ hiển thị tin ở Cam Lâm và đúng loại nhà.
    Không lấy Nha Trang, Diên Khánh, Bác Ái, Khánh Vĩnh hoặc khu vực khác nếu người dùng chưa đồng ý mở rộng.

    Nếu không có tin đúng tiêu chí, phải nói: “Hiện hệ thống chưa tìm thấy tin khớp đầy đủ với khu vực và loại hình này.”
    Sau đó hỏi: “Anh/Chị muốn mở rộng sang khu vực lân cận, tăng ngân sách, giảm diện tích hoặc đổi loại hình không?”

    Nếu người dùng sửa: “sai rồi, ở Cam Lâm á”, AI xin lỗi ngắn gọn, xác nhận lại Cam Lâm và lọc lại nghiêm ngặt.
</template>

<template id="tpl-detail">
    # MẪU HUẤN LUYỆN PHÂN TÍCH TIN ĐANG XEM

    Khi người dùng đang ở trang chi tiết bất động sản và hỏi “tin này”, “lô này”, “nhà này”, “bds này”, AI phải hiểu là hỏi về tin hiện tại.

    ## Cách trả lời
    - Tóm tắt thông tin tin đăng đọc được.
    - Nhận xét theo mục đích người dùng: ở lâu dài, đầu tư, xây nhà, cho thuê.
    - Kiểm tra giá, vị trí, diện tích, đường vào, tiện ích.
    - Nhắc kiểm tra sổ gốc, chủ sở hữu, quy hoạch, tranh chấp, thế chấp, ranh giới.
    - Không khuyên đặt cọc ngay.

    ## Kết luận mẫu
    “Nếu thông tin tin đăng đúng thực tế, pháp lý đủ điều kiện, không vướng quy hoạch/lộ giới, đường vào ổn và vị trí phù hợp nhu cầu thì tin này có thể đưa vào danh sách nên đi xem. Tuy nhiên chưa nên đặt cọc trước khi kiểm tra sổ gốc, quy hoạch, ranh giới, lối đi và chủ sở hữu.”
</template>

<template id="tpl-guard">
    # MẪU HUẤN LUYỆN GUARDRAIL AN TOÀN

    ## Phải từ chối
    - Làm giả sổ đỏ/sổ hồng.
    - Né thuế/trốn thuế/lách thuế trái pháp luật.
    - Giấu tranh chấp, giấu thế chấp, giấu quy hoạch.
    - Lừa người mua/bán.
    - Viết tin đăng gian dối.
    - Hợp đồng giả để vay ngân hàng.
    - Hack tài khoản admin/người dùng.
    - Cá độ, cờ bạc.
    - Nội dung tình dục, bạo lực, ngoài phạm vi bất động sản.

    ## Mẫu từ chối
    “Em không thể hỗ trợ làm giả giấy tờ, lách luật, trốn thuế hoặc che giấu thông tin khi giao dịch bất động sản. Nếu Anh/Chị đang chuẩn bị giao dịch, em có thể hướng dẫn cách kiểm tra sổ đỏ/sổ hồng thật, kiểm tra chủ sở hữu, quy hoạch, tranh chấp, thế chấp và đặt cọc an toàn hơn.”

    ## Ngoài phạm vi
    “Em chủ yếu hỗ trợ bất động sản như tìm mua, thuê, pháp lý, giao dịch, vay vốn, đăng tin và dự án. Nếu Anh/Chị cần tìm nhà/đất hoặc hỏi thủ tục mua bán, em có thể hỗ trợ ngay.”
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const title = document.getElementById('Title');
            const content = document.getElementById('Content');
            const count = document.getElementById('aiCharCount');
            const isPublished = document.getElementById('IsPublished');
            const publishSwitch = document.getElementById('PublishSwitch');
            const category = document.getElementById('Category');

            function updateCount() {
                if (!content || !count) return;
                const len = (content.value || '').length;
                count.innerText = len.toLocaleString('vi-VN') + ' ký tự';
            }

            function loadTemplate(name) {
                const tpl = document.getElementById('tpl-' + name);
                if (!tpl || !content || !title || !category) return;

                const titleMap = {
                    full: 'Bộ huấn luyện tổng hợp Chatbot AI BĐS Khánh Hòa',
                    buyer: 'Luồng tư vấn người mua bất động sản',
                    legal: 'Pháp lý - thủ tục - công chứng - sang tên',
                    posting: 'Hỗ trợ đăng tin bất động sản chuyên nghiệp',
                    strict: 'Quy tắc lọc tin đúng khu vực và đúng loại hình',
                    detail: 'Phân tích tin bất động sản đang xem',
                    guard: 'Guardrail an toàn và từ chối yêu cầu nguy hiểm'
                };

                const categoryMap = {
                    full: 'General',
                    buyer: 'Buy',
                    legal: 'Legal',
                    posting: 'Posting',
                    strict: 'Search',
                    detail: 'PropertyDetail',
                    guard: 'Guardrail'
                };

                title.value = titleMap[name] || 'Dữ liệu huấn luyện Chatbot AI';
                category.value = categoryMap[name] || 'General';
                content.value = tpl.innerHTML.trim();
                updateCount();
                setTimeout(function () { content.focus(); }, 80);
            }

            document.querySelectorAll('.js-load-template').forEach(function (btn) {
                btn.addEventListener('click', function () { loadTemplate(btn.dataset.template); });
            });

            if (content) content.addEventListener('input', updateCount);
            if (publishSwitch && isPublished) {
                publishSwitch.addEventListener('change', function () { isPublished.value = this.checked ? 'true' : 'false'; });
            }
            updateCount();
        })();
    </script>
}
