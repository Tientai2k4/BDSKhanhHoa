@model BDSKhanhHoa.Models.StaticPage
@{
    ViewData["Title"] = "Đào tạo Trí tuệ Nhân tạo (AI RAG)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4 animate__animated animate__fadeIn">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-1"><i class="bi bi-cpu-fill me-2"></i>Đào tạo Kiến thức AI</h4>
            <p class="text-muted mb-0 small">Bơm tài liệu pháp lý, quy hoạch và chính sách nội bộ để AI tự động học và tư vấn khách hàng.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 16px;">
                <div class="card-header bg-white border-0 pt-4 pb-2 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-dark mb-0">Nội dung tài liệu (RAG Data)</h5>
                        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill"><i class="bi bi-robot me-1"></i>Gemini 2.5 Flash</span>
                    </div>
                </div>
                <div class="card-body px-4 pb-4">
                    <form asp-action="Save" method="post">
                        <input type="hidden" asp-for="PageID" />
                        <input type="hidden" asp-for="PageKey" />

                        <div class="mb-3 position-relative">
                            <textarea asp-for="Content" class="form-control" rows="20" id="aiContent"
                                      style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; font-family: 'Consolas', monospace; font-size: 0.95rem; line-height: 1.6; resize: vertical;"
                                      placeholder="Dán các văn bản pháp lý, quy định vay vốn, hoặc kịch bản trả lời vào đây..."></textarea>

                            <div class="text-end mt-2">
                                <small class="text-muted fw-bold" id="charCount">0 ký tự</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-4 mt-2">
                            <div class="text-muted small">
                                <i class="bi bi-shield-check text-success me-1"></i> Hệ thống tự động mã hóa và bảo mật dữ liệu nguồn.
                            </div>
                            <button type="submit" class="btn btn-primary px-5 py-2 shadow-sm" style="border-radius: 10px; font-weight: 700;">
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i>Lưu cấu hình AI
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius: 16px; background: linear-gradient(145deg, #1e3a8a, #3b82f6); color: white;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-lightbulb-fill text-warning me-2"></i>Hướng dẫn viết RAG</h5>
                    <p class="small opacity-75 mb-4">Để AI thông minh và trả lời chính xác nhất, bạn nên trình bày dữ liệu theo cấu trúc rõ ràng.</p>

                    <div class="bg-white bg-opacity-10 p-3 rounded-3 mb-3 border border-light border-opacity-25">
                        <h6 class="fw-bold fs-6 mb-2 text-warning">1. Chính sách chung</h6>
                        <p class="small mb-0 opacity-75">Ghi rõ hoa hồng, phí dịch vụ đăng tin, quy định pháp lý của sàn.</p>
                    </div>

                    <div class="bg-white bg-opacity-10 p-3 rounded-3 mb-3 border border-light border-opacity-25">
                        <h6 class="fw-bold fs-6 mb-2 text-warning">2. Ngân hàng & Vay vốn</h6>
                        <p class="small mb-0 opacity-75">VD: "Vietcombank hỗ trợ vay 70%, lãi suất 6.5%/năm trong 2 năm đầu..."</p>
                    </div>

                    <div class="bg-white bg-opacity-10 p-3 rounded-3 border border-light border-opacity-25">
                        <h6 class="fw-bold fs-6 mb-2 text-warning">3. Kịch bản khéo léo</h6>
                        <p class="small mb-0 opacity-75">Cung cấp lệnh ẩn. VD: "Nếu khách chê giá đắt, hãy phản hồi bằng tiện ích xung quanh để thuyết phục..."</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script đếm số lượng ký tự nhập vào để Admin dễ kiểm soát dung lượng Token gửi cho AI
        document.addEventListener('DOMContentLoaded', function() {
            const textarea = document.getElementById('aiContent');
            const charCount = document.getElementById('charCount');

            function updateCount() {
                const len = textarea.value.length;
                charCount.innerHTML = new Intl.NumberFormat('vi-VN').format(len) + ' ký tự';

                if (len > 50000) {
                    charCount.classList.add('text-danger');
                    charCount.classList.remove('text-muted');
                } else {
                    charCount.classList.remove('text-danger');
                    charCount.classList.add('text-muted');
                }
            }

            textarea.addEventListener('input', updateCount);
            updateCount(); // Gọi lần đầu khi load trang
        });
    </script>
}