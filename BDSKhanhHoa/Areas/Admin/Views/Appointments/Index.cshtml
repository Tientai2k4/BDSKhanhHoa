@model IEnumerable<BDSKhanhHoa.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý Lịch hẹn Hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string status = ViewBag.Status as string ?? "All";
    string resultStatus = ViewBag.ResultStatus as string ?? "All";
    string keyword = ViewBag.Keyword as string ?? "";
    string source = ViewBag.Source as string ?? "All";
    string dateRange = ViewBag.DateRange as string ?? "all";

    int total = ViewBag.TotalAppointments ?? 0;
    int pending = ViewBag.PendingAppointments ?? 0;
    int confirmed = ViewBag.ConfirmedAppointments ?? 0;
    int completed = ViewBag.CompletedAppointments ?? 0;
    int interested = ViewBag.InterestedCount ?? 0;
    int reminded = ViewBag.RemindedAppointments ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string RemindMarker = "[REMIND_SELLER_APPOINTMENT]";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .admin-box {
        background: #fff;
        border-radius: 20px;
        border: 1px solid rgba(148,163,184,.16);
        box-shadow: 0 10px 30px rgba(15, 23, 42, .04);
        margin-bottom: 24px;
    }

    .fw-black {
        font-weight: 900;
    }

    .stat {
        padding: 24px;
        border-radius: 20px;
        color: #fff;
        min-height: 135px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 25px rgba(15, 23, 42, .06);
        transition: transform .25s ease;
    }

        .stat:hover {
            transform: translateY(-4px);
        }

    .bg-total {
        background: linear-gradient(135deg, #1e293b, #334155);
    }

    .bg-pending {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .bg-confirmed {
        background: linear-gradient(135deg, #2563eb, #3b82f6);
    }

    .bg-completed {
        background: linear-gradient(135deg, #047857, #10b981);
    }

    .bg-interested {
        background: linear-gradient(135deg, #be185d, #ec4899);
    }

    .bg-reminded {
        background: linear-gradient(135deg, #7c3aed, #a855f7);
    }

    .stat .label {
        text-transform: uppercase;
        font-size: .78rem;
        letter-spacing: .08em;
        opacity: .92;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .stat .value {
        font-size: 2.55rem;
        font-weight: 900;
        line-height: 1;
    }

    .soft-input {
        min-height: 48px;
        border-radius: 12px;
        font-weight: 600;
        border: 1px solid #cbd5e1;
        box-shadow: none !important;
        font-size: .95rem;
    }

        .soft-input:focus {
            border-color: #3b82f6;
        }

    .table thead th {
        background: #f8fafc;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        color: #475569;
        white-space: nowrap;
        padding: 18px;
        border-bottom: 2px solid #e2e8f0;
    }

    .table tbody td {
        padding: 18px;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9;
    }

    .table tbody tr:hover {
        background-color: #f8fafc;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .06em;
        white-space: nowrap;
    }

    .st-pending {
        background: #fef3c7;
        color: #b45309;
    }

    .st-confirmed {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .st-cancelled {
        background: #f1f5f9;
        color: #64748b;
        text-decoration: line-through;
    }

    .st-completed {
        background: #dcfce7;
        color: #047857;
    }

    .st-rescheduled {
        background: #fee2e2;
        color: #b91c1c;
    }

    .result-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 800;
        background: #fff;
        border: 1px solid #e2e8f0;
        color: #334155;
    }

    .remind-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .72rem;
        font-weight: 900;
        letter-spacing: .04em;
        white-space: nowrap;
    }

    .remind-done {
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ddd6fe;
    }

    .remind-none {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .btn-admin-tool {
        width: 38px;
        height: 38px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 10px;
        transition: all .2s;
        position: relative;
    }

        .btn-admin-tool:hover {
            transform: translateY(-1px);
        }

    .btn-reminded {
        background: #f5f3ff !important;
        border-color: #a78bfa !important;
        color: #7c3aed !important;
    }

    .mini-dot {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 15px;
        height: 15px;
        background: #7c3aed;
        border: 2px solid #fff;
        border-radius: 50%;
    }

    .detail-row {
        display: flex;
        padding: 12px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        width: 35%;
        font-weight: 800;
        color: #64748b;
        font-size: .86rem;
        text-transform: uppercase;
    }

    .detail-value {
        width: 65%;
        font-weight: 700;
        color: #0f172a;
        font-size: .95rem;
        white-space: pre-wrap;
    }

    .section-title {
        font-size: 1rem;
        font-weight: 900;
        color: #0f172a;
        text-transform: uppercase;
        letter-spacing: .05em;
        background: #f1f5f9;
        padding: 10px 16px;
        border-radius: 8px;
        margin: 20px 0 10px;
    }

    .pagination .page-link {
        border-radius: 10px;
        margin: 0 3px;
        font-weight: 700;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .pagination .active .page-link {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
    }

    @@media (max-width: 768px) {
        .table thead {
            display: none;
        }

        .table tbody tr {
            display: block;
            margin: 14px;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 8px 20px rgba(15,23,42,.05);
        }

        .table tbody td {
            display: block;
            padding: 14px 16px;
        }

        .detail-row {
            display: block;
        }

        .detail-label,
        .detail-value {
            width: 100%;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-black mb-1 text-dark">
            <i class="bi bi-calendar-check text-primary me-2"></i>
            Giám sát Lịch hẹn Toàn hệ thống
        </h2>
        <div class="text-muted">
            Theo dõi lịch hẹn, kết quả chốt khách và trạng thái đã nhắc người bán.
        </div>
    </div>

    <a href="/Admin/Appointments/ExportCsv" class="btn btn-success fw-bold rounded-pill shadow-sm px-4 py-2">
        <i class="bi bi-file-earmark-excel-fill me-2"></i>
        Xuất Excel
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-total">
            <div class="label">Tổng số</div>
            <div class="value">@total.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-pending">
            <div class="label">Chờ xử lý</div>
            <div class="value">@pending.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-confirmed">
            <div class="label">Đã xác nhận</div>
            <div class="value">@confirmed.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-interested">
            <div class="label">Ưng / Cọc</div>
            <div class="value">@interested.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-reminded">
            <div class="label">Đã nhắc</div>
            <div class="value">@reminded.ToString("N0")</div>
        </div>
    </div>

    <div class="col-xl-2 col-lg-4 col-sm-6">
        <div class="stat bg-completed">
            <div class="label">Hoàn tất</div>
            <div class="value">@completed.ToString("N0")</div>
        </div>
    </div>
</div>

<div class="admin-box p-4">
    <form method="get"
          asp-action="Index"
          asp-controller="Appointments"
          asp-area="Admin"
          class="row g-3 align-items-end">

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Tiến độ</label>
            <select name="status" class="form-select soft-input">
                <option value="All" selected="@(status == "All")">Tất cả tiến độ</option>
                <option value="Pending" selected="@(status == "Pending")">Chờ xác nhận</option>
                <option value="Rescheduled" selected="@(status == "Rescheduled")">Đang dời lịch</option>
                <option value="Confirmed" selected="@(status == "Confirmed")">Đã xác nhận</option>
                <option value="Completed" selected="@(status == "Completed")">Đã hoàn tất</option>
                <option value="Cancelled" selected="@(status == "Cancelled")">Đã hủy</option>
            </select>
        </div>

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Kết quả</label>
            <select name="resultStatus" class="form-select soft-input">
                <option value="All" selected="@(resultStatus == "All")">Tất cả kết quả</option>
                <option value="Interested" selected="@(resultStatus == "Interested")">Khách ưng ý</option>
                <option value="DepositPending" selected="@(resultStatus == "DepositPending")">Chờ chốt cọc</option>
                <option value="FollowUp" selected="@(resultStatus == "FollowUp")">Cần bám sát</option>
                <option value="NotInterested" selected="@(resultStatus == "NotInterested")">Không ưng</option>
            </select>
        </div>

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Nguồn</label>
            <select name="source" class="form-select soft-input">
                <option value="All" selected="@(source == "All")">Mọi nguồn</option>
                <option value="Property" selected="@(source == "Property")">Tin lẻ BĐS</option>
                <option value="Project" selected="@(source == "Project")">Dự án</option>
                <option value="Lead" selected="@(source == "Lead")">Lead CRM</option>
            </select>
        </div>

        <div class="col-xl-2 col-lg-3 col-md-6">
            <label class="form-label fw-bold small text-muted text-uppercase">Thời gian</label>
            <select name="dateRange" class="form-select soft-input">
                <option value="all" selected="@(dateRange == "all")">Toàn thời gian</option>
                <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                <option value="month" selected="@(dateRange == "month")">1 tháng qua</option>
            </select>
        </div>

        <div class="col-xl-3 col-lg-9 col-md-8">
            <label class="form-label fw-bold small text-muted text-uppercase">Tìm kiếm</label>
            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control soft-input"
                   placeholder="Tên khách, SĐT, BĐS, người phụ trách..." />
        </div>

        <div class="col-xl-1 col-lg-3 col-md-4 d-grid">
            <button class="btn btn-dark rounded-3 fw-bold shadow-sm" style="min-height:48px;">
                <i class="bi bi-funnel-fill me-1"></i>
                Lọc
            </button>
        </div>
    </form>
</div>

<div class="admin-box">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:16%">Thời gian hẹn</th>
                    <th style="width:21%">Người mua</th>
                    <th style="width:25%">Người bán & Nguồn</th>
                    <th style="width:18%">Tiến độ</th>
                    <th style="width:20%" class="text-center">Công cụ Admin</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var a in Model)
                    {
                        var sourceName = a.Property?.Title ?? a.Project?.ProjectName ?? a.Lead?.Project?.ProjectName ?? "Không rõ";
                        var customerName = !string.IsNullOrWhiteSpace(a.CustomerName) ? a.CustomerName : (a.Buyer?.FullName ?? a.Buyer?.Username ?? "Khách vãng lai");
                        var sellerName = a.Seller?.FullName ?? "Chưa xác định";

                        bool wasReminded = !string.IsNullOrWhiteSpace(a.NegotiationNote)
                        && a.NegotiationNote.Contains(RemindMarker, StringComparison.OrdinalIgnoreCase);

                        string statusText = "Chờ xử lý";
                        string statusClass = "st-pending";

                        switch (a.Status)
                        {
                            case "Pending":
                                statusText = "Chờ xác nhận";
                                statusClass = "st-pending";
                                break;

                            case "Confirmed":
                                statusText = "Đã xác nhận";
                                statusClass = "st-confirmed";
                                break;

                            case "Rescheduled":
                                statusText = "Đang dời lịch";
                                statusClass = "st-rescheduled";
                                break;

                            case "Cancelled":
                                statusText = "Đã hủy";
                                statusClass = "st-cancelled";
                                break;

                            case "Completed":
                                statusText = "Hoàn tất";
                                statusClass = "st-completed";
                                break;
                        }

                        string resultText = a.ResultStatus ?? "";

                        switch (a.ResultStatus)
                        {
                            case "Interested":
                                resultText = "Khách ưng ý";
                                break;

                            case "DepositPending":
                                resultText = "Chờ chốt cọc";
                                break;

                            case "FollowUp":
                                resultText = "Cần bám sát";
                                break;

                            case "NotInterested":
                                resultText = "Không ưng";
                                break;
                        }

                        <tr id="appointment-row-@a.AppointmentID">
                            <td>
                                <div class="fw-bold text-primary" style="font-size:1.05rem;">
                                    @a.AppointmentDate.ToString("HH:mm - dd/MM/yyyy")
                                </div>

                                @if (a.ProposedAppointmentDate.HasValue)
                                {
                                    <div class="text-danger fw-bold small mt-1">
                                        <i class="bi bi-arrow-right-circle"></i>
                                        Đổi sang: @a.ProposedAppointmentDate.Value.ToString("HH:mm dd/MM/yyyy")
                                    </div>
                                }

                                <div class="text-muted small mt-2">
                                    Tạo lúc: @a.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                                </div>
                            </td>

                            <td>
                                <div class="fw-bold text-dark fs-6">@customerName</div>

                                <div class="text-success small mt-1 fw-bold">
                                    <i class="bi bi-telephone-fill"></i>
                                    @(a.CustomerPhone ?? "N/A")
                                </div>

                                @if (!string.IsNullOrWhiteSpace(a.MeetingLocation))
                                {
                                    <div class="text-muted small mt-1 text-truncate" style="max-width:220px;" title="@a.MeetingLocation">
                                        <i class="bi bi-geo-alt-fill text-danger"></i>
                                        @a.MeetingLocation
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="fw-bold text-dark">@sellerName</div>

                                <div class="text-muted small mt-1">
                                    <i class="bi bi-headset"></i>
                                    Phụ trách: @(string.IsNullOrWhiteSpace(a.AssignedStaffName) ? "Chính chủ/Sale" : a.AssignedStaffName)
                                </div>

                                <div class="small fw-semibold text-truncate mt-2 bg-light p-2 rounded border" style="max-width:260px;" title="@sourceName">
                                    <i class="bi bi-tag-fill text-muted"></i>
                                    @sourceName
                                </div>

                                <div class="mt-2" id="remind-badge-@a.AppointmentID">
                                    @if (wasReminded)
                                    {
                                        <span class="remind-badge remind-done">
                                            <i class="bi bi-check2-circle"></i>
                                            Đã thông báo người bán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="remind-badge remind-none">
                                            <i class="bi bi-exclamation-circle"></i>
                                            Chưa thông báo
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="mb-2">
                                    <span class="status-pill @statusClass">@statusText</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(a.ResultStatus))
                                {
                                    <div class="result-pill">
                                        <i class="bi bi-bookmark-check-fill text-success"></i>
                                        @resultText
                                    </div>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <button type="button"
                                            class="btn btn-outline-info btn-admin-tool"
                                            onclick="openDetailModal(@a.AppointmentID)"
                                            title="Xem chi tiết lịch hẹn">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>

                                    <form class="m-0" id="frmRemind-@a.AppointmentID">
                                        @Html.AntiForgeryToken()

                                        <button type="button"
                                                id="btn-remind-@a.AppointmentID"
                                                class="btn btn-outline-warning btn-admin-tool @(wasReminded ? "btn-reminded" : "")"
                                                onclick="postAdminRemind('@Url.Action("RemindSeller", "Appointments", new { area = "Admin" })', @a.AppointmentID, false)"
                                                title="@(wasReminded ? "Đã thông báo rồi - bấm để nhắc lại nếu thật sự cần" : "Gửi thông báo nhắc người bán")">
                                            <i class="bi bi-bell-fill"></i>
                                            @if (wasReminded)
                                            {
                                                <span class="mini-dot"></span>
                                            }
                                        </button>
                                    </form>

                                    <form class="m-0" id="frmDel-@a.AppointmentID">
                                        @Html.AntiForgeryToken()

                                        <button type="button"
                                                class="btn btn-outline-danger btn-admin-tool"
                                                onclick="postAdminDelete('@Url.Action("Delete", "Appointments", new { area = "Admin" })', @a.AppointmentID)"
                                                title="Xóa rác / Spam">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>

                                @if (wasReminded)
                                {
                                    <div class="small text-muted mt-2" id="remind-text-@a.AppointmentID">
                                        Đã thông báo
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-warning fw-bold mt-2" id="remind-text-@a.AppointmentID">
                                        Chưa thông báo
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <i class="bi bi-calendar-x display-1 opacity-25 d-block mb-3"></i>
                            <h4 class="fw-bold">Không tìm thấy lịch hẹn</h4>
                            <p>Thử điều chỉnh lại bộ lọc tìm kiếm.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-4 border-top">
            <div class="text-muted small fw-semibold">
                Trang @currentPage / @totalPages
            </div>

            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Appointments"
                           asp-action="Index"
                           asp-route-status="@status"
                           asp-route-resultStatus="@resultStatus"
                           asp-route-keyword="@keyword"
                           asp-route-source="@source"
                           asp-route-dateRange="@dateRange"
                           asp-route-page="@(currentPage - 1)">
                            Trước
                        </a>
                    </li>

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="Appointments"
                               asp-action="Index"
                               asp-route-status="@status"
                               asp-route-resultStatus="@resultStatus"
                               asp-route-keyword="@keyword"
                               asp-route-source="@source"
                               asp-route-dateRange="@dateRange"
                               asp-route-page="@i">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Appointments"
                           asp-action="Index"
                           asp-route-status="@status"
                           asp-route-resultStatus="@resultStatus"
                           asp-route-keyword="@keyword"
                           asp-route-source="@source"
                           asp-route-dateRange="@dateRange"
                           asp-route-page="@(currentPage + 1)">
                            Sau
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<div class="modal fade" id="adminDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-dark text-white border-0 p-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-journal-text me-2"></i>
                    Hồ sơ Lịch hẹn
                    <span id="md-source" class="ms-2 badge bg-light text-dark"></span>
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4 bg-light">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded-4 border shadow-sm h-100">
                            <div class="section-title mt-0">
                                <i class="bi bi-person-bounding-box text-primary me-2"></i>
                                Người mua
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Họ tên</div>
                                <div class="detail-value text-primary" id="md-buyerName"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Điện thoại</div>
                                <div class="detail-value" id="md-buyerPhone"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Nhu cầu</div>
                                <div class="detail-value text-muted fst-italic" id="md-note"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-white p-3 rounded-4 border shadow-sm h-100">
                            <div class="section-title mt-0">
                                <i class="bi bi-person-workspace text-success me-2"></i>
                                Người bán
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Người quản lý</div>
                                <div class="detail-value text-success" id="md-sellerName"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">SĐT</div>
                                <div class="detail-value" id="md-sellerPhone"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Điểm gặp</div>
                                <div class="detail-value text-danger" id="md-location"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Trạng thái nhắc</div>
                                <div class="detail-value" id="md-remindedText"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-4 border shadow-sm mt-4">
                    <div class="section-title mt-0 bg-warning bg-opacity-10 text-dark">
                        <i class="bi bi-clock-history me-2 text-warning"></i>
                        Tiến trình & Kết quả
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="detail-row">
                                <div class="detail-label">Ngày tạo</div>
                                <div class="detail-value" id="md-createdAt"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Giờ hẹn gốc</div>
                                <div class="detail-value fs-5 text-primary" id="md-appointmentDate"></div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Giờ dời lại</div>
                                <div class="detail-value text-danger" id="md-proposedDate"></div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="detail-row">
                                <div class="detail-label">Trạng thái</div>
                                <div class="detail-value">
                                    <span class="badge bg-dark fs-6" id="md-status"></span>
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Kết quả</div>
                                <div class="detail-value">
                                    <span class="badge bg-success fs-6" id="md-resultStatus"></span>
                                </div>
                            </div>

                            <div class="detail-row">
                                <div class="detail-label">Hoàn tất lúc</div>
                                <div class="detail-value" id="md-completedAt"></div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mt-4 mb-2">
                        <i class="bi bi-chat-left-text-fill text-info me-2"></i>
                        Dấu vết thương lượng / Lịch sử admin nhắc:
                    </h6>

                    <div class="p-3 bg-light border rounded-3 text-dark font-monospace small"
                         style="white-space:pre-wrap; max-height:180px; overflow-y:auto;"
                         id="md-negotiationNote"></div>

                    <h6 class="fw-bold text-dark mt-3 mb-2">
                        <i class="bi bi-clipboard-check-fill text-success me-2"></i>
                        Ghi chú kết quả:
                    </h6>

                    <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 text-dark fw-medium"
                         style="white-space:pre-wrap;"
                         id="md-resultNote"></div>
                </div>
            </div>

            <div class="modal-footer border-0 p-4 pt-0 bg-light">
                <button type="button"
                        class="btn btn-dark rounded-pill px-5 fw-bold shadow-sm"
                        data-bs-dismiss="modal">
                    Đóng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function postAdminRemind(url, id, force) {
            const isForce = force === true;

            Swal.fire({
                title: isForce ? 'Gửi nhắc lại?' : 'Gửi thông báo nhắc người bán?',
                text: isForce
                    ? 'Lịch hẹn này đã từng được thông báo. Bạn vẫn muốn gửi thêm một thông báo nữa?'
                    : 'Hệ thống sẽ gửi thông báo cho người bán/Sales phụ trách và đánh dấu lịch hẹn là đã thông báo.',
                icon: isForce ? 'warning' : 'info',
                showCancelButton: true,
                confirmButtonColor: isForce ? '#7c3aed' : '#f59e0b',
                cancelButtonColor: '#64748b',
                confirmButtonText: isForce ? 'Gửi nhắc lại' : 'Gửi thông báo',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const tokenInput = document.querySelector(`#frmRemind-${id} input[name="__RequestVerificationToken"]`);

                if (!tokenInput) {
                    Swal.fire('Lỗi', 'Không tìm thấy mã xác thực form.', 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('id', id);
                formData.append('force', isForce);
                formData.append('__RequestVerificationToken', tokenInput.value);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            markAppointmentAsReminded(id);

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message,
                                showConfirmButton: false,
                                timer: 2600
                            });
                        }
                        else if (data.code === 'ALREADY_REMINDED') {
                            Swal.fire({
                                title: 'Đã thông báo rồi',
                                text: data.message,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#7c3aed',
                                cancelButtonColor: '#64748b',
                                confirmButtonText: 'Vẫn gửi nhắc lại',
                                cancelButtonText: 'Không gửi nữa'
                            }).then((confirmAgain) => {
                                if (confirmAgain.isConfirmed) {
                                    postAdminRemind(url, id, true);
                                }
                            });
                        }
                        else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    });
            });
        }

        function markAppointmentAsReminded(id) {
            const badgeBox = document.getElementById(`remind-badge-${id}`);
            const btn = document.getElementById(`btn-remind-${id}`);
            const text = document.getElementById(`remind-text-${id}`);

            if (badgeBox) {
                badgeBox.innerHTML = `
                    <span class="remind-badge remind-done">
                        <i class="bi bi-check2-circle"></i>
                        Đã thông báo người bán
                    </span>`;
            }

            if (btn) {
                btn.classList.remove('btn-outline-warning');
                btn.classList.add('btn-reminded');
                btn.setAttribute('title', 'Đã thông báo rồi - bấm để nhắc lại nếu thật sự cần');

                if (!btn.querySelector('.mini-dot')) {
                    btn.insertAdjacentHTML('beforeend', '<span class="mini-dot"></span>');
                }
            }

            if (text) {
                text.className = 'small text-muted mt-2';
                text.innerText = 'Đã thông báo';
            }
        }

        function postAdminDelete(url, id) {
            Swal.fire({
                title: 'Xóa VĨNH VIỄN?',
                text: 'Hành động này sẽ xóa dữ liệu lịch hẹn khỏi hệ thống.',
                icon: 'error',
                input: 'checkbox',
                inputValue: 0,
                inputPlaceholder: ' Đồng thời đánh dấu là dữ liệu Spam?',
                showCancelButton: true,
                confirmButtonColor: '#000',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xóa ngay',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const tokenInput = document.querySelector(`#frmDel-${id} input[name="__RequestVerificationToken"]`);

                if (!tokenInput) {
                    Swal.fire('Lỗi', 'Không tìm thấy mã xác thực form.', 'error');
                    return;
                }

                const formData = new FormData();
                formData.append('id', id);
                formData.append('blockSpam', result.value ? true : false);
                formData.append('__RequestVerificationToken', tokenInput.value);

                fetch(url, {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire('Đã xử lý', data.message, 'success').then(() => location.reload());
                        } else {
                            Swal.fire('Lỗi', data.message, 'error');
                        }
                    })
                    .catch(() => {
                        Swal.fire('Lỗi', 'Không thể kết nối đến máy chủ.', 'error');
                    });
            });
        }

        function openDetailModal(id) {
            Swal.fire({
                title: 'Đang tải...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            fetch(`/Admin/Appointments/GetDetails?id=${id}`)
                .then(response => response.json())
                .then(res => {
                    Swal.close();

                    if (!res.success) {
                        Swal.fire('Lỗi', res.message, 'error');
                        return;
                    }

                    const d = res.data;

                    document.getElementById('md-source').innerText = d.source;
                    document.getElementById('md-buyerName').innerText = d.buyerName;
                    document.getElementById('md-buyerPhone').innerText = d.buyerPhone;
                    document.getElementById('md-note').innerText = d.note;

                    document.getElementById('md-sellerName').innerText = d.sellerName;
                    document.getElementById('md-sellerPhone').innerText = d.sellerPhone;
                    document.getElementById('md-location').innerText = d.location;
                    document.getElementById('md-remindedText').innerHTML = d.wasReminded
                        ? '<span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i> Đã thông báo người bán</span>'
                        : '<span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i> Chưa thông báo</span>';

                    document.getElementById('md-createdAt').innerText = d.createdAt;
                    document.getElementById('md-appointmentDate').innerText = d.appointmentDate;
                    document.getElementById('md-proposedDate').innerText = d.proposedDate;
                    document.getElementById('md-completedAt').innerText = d.completedAt;
                    document.getElementById('md-status').innerText = d.status;
                    document.getElementById('md-resultStatus').innerText = d.resultStatus;
                    document.getElementById('md-negotiationNote').innerText = d.negotiationNote;
                    document.getElementById('md-resultNote').innerText = d.resultNote;

                    new bootstrap.Modal(document.getElementById('adminDetailModal')).show();
                })
                .catch(() => {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể lấy dữ liệu lịch hẹn.', 'error');
                });
        }
    </script>
}