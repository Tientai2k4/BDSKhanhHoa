                                    <div class="detail-row"><div class="detail-label">Trạng thái</div><div class="detail-value"><span class="badge bg-dark" id="md-status"></span></div></div>
                                    <div class="detail-row"><div class="detail-label">Kết quả</div><div class="detail-value"><span class="badge bg-success" id="md-resultStatus"></span></div></div>
