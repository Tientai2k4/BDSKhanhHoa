                            </div>
                            <div class="detail-row"><div class="detail-label">Quản lý</div><div class="detail-value text-success" id="md-sellerName"></div></div>
                            <div class="detail-row"><div class="detail-label">SĐT</div><div class="detail-value" id="md-sellerPhone"></div></div>
                            <div class="detail-row"><div class="detail-label">Điểm gặp</div><div class="detail-value text-danger" id="md-location"></div></div>
