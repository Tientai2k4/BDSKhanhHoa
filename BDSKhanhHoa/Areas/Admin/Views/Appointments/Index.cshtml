</style>

<div class="notify-admin-page">
    @Html.AntiForgeryToken()

    <section class="na-hero">
        <div>
            <div class="na-kicker"><i class="bi bi-bell-fill"></i> Trung tâm nhắc lịch hẹn</div>
            <h1 class="na-title">Lịch hẹn mới cần Admin thông báo</h1>
            <p class="na-desc">
                Admin chỉ bấm chuông nhắc người phụ trách. Mặc định trang chỉ hiện lịch hẹn mới/chưa xác nhận và chưa từng nhắc; đã nhắc hoặc đã xử lý sẽ tự ẩn khỏi danh sách cần xử lý.
            </p>
        </div>
        <a class="na-export" asp-area="Admin" asp-controller="Appointments" asp-action="ExportCsv"
           asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">
            <i class="bi bi-file-earmark-excel-fill"></i> Xuất Excel
        </a>
    </section>

    <section class="na-stats" aria-label="Thống kê lịch hẹn">
        <div class="na-stat na-stat-hot"><div class="na-stat-label">Cần thông báo</div><div class="na-stat-value" id="stat-needs">@needsReminder.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Tổng theo lọc</div><div class="na-stat-value" id="stat-total">@total.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Đã thông báo</div><div class="na-stat-value" id="stat-reminded">@reminded.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Đã xử lý/ẩn chuông</div><div class="na-stat-value">@handled.ToString("N0")</div></div>
        <div class="na-stat"><div class="na-stat-label">Đã xác nhận</div><div class="na-stat-value">@confirmed.ToString("N0")</div></div>
    </section>

    <form method="get" asp-area="Admin" asp-controller="Appointments" asp-action="Index" class="na-filter row g-2 align-items-end">
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Hiển thị</label>
            <select name="remindFilter" class="form-select na-select">
                <option value="CanRemind" selected="@(remindFilter == "CanRemind" || remindFilter == "NeedNotify")">Cần thông báo</option>
                <option value="Reminded" selected="@(remindFilter == "Reminded")">Đã thông báo</option>
                <option value="Handled" selected="@(remindFilter == "Handled")">Đã tiếp nhận/xử lý</option>
                <option value="All" selected="@(remindFilter == "All")">Tất cả để kiểm tra</option>
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Nguồn</label>
            <select name="source" class="form-select na-select">
                <option value="All" selected="@(source == "All")">Tin lẻ + Dự án</option>
                <option value="Project" selected="@(source == "Project")">Chỉ dự án</option>
                <option value="Property" selected="@(source == "Property")">Chỉ tin lẻ</option>
                <option value="Lead" selected="@(source == "Lead")">Lead CRM dự án</option>
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="na-label">Thời gian tạo</label>
            <select name="dateRange" class="form-select na-select">
                <option value="all" selected="@(dateRange == "all")">Toàn thời gian</option>
                <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                <option value="month" selected="@(dateRange == "month")">1 tháng qua</option>
                <option value="appointment_today" selected="@(dateRange == "appointment_today")">Hẹn hôm nay</option>
            </select>
        </div>
        <div class="col-xl-4 col-md-8">
            <label class="na-label">Tìm kiếm</label>
            <input name="keyword" value="@keyword" class="form-control na-input" placeholder="Tên khách, SĐT, nguồn BĐS, người phụ trách..." />
        </div>
        <div class="col-xl-2 col-md-4 d-grid gap-2">
            <button class="na-btn na-btn-dark" type="submit"><i class="bi bi-funnel-fill"></i>Lọc</button>
        </div>
        <div class="col-12 d-flex gap-2 flex-wrap">
            <a class="na-btn na-btn-light px-3" asp-area="Admin" asp-controller="Appointments" asp-action="Index">
                <i class="bi bi-arrow-counterclockwise"></i>Về danh sách cần thông báo
            </a>
        </div>
    </form>

    <section class="na-list" id="listShell">
        <div class="na-desktop-list">
            <div class="na-list-head">
                <div>Thời gian</div>
                <div>Khách hàng</div>
                <div>Nguồn & phụ trách</div>
                <div>Trạng thái</div>
                <div class="text-center">Admin</div>
            </div>

            @foreach (var a in items)
            {
                bool canBell = CanShowBell(a);
                bool wasReminded = IsReminded(a);
                string customer = CustomerName(a);
                string phone = a.CustomerPhone ?? "";

                <article class="na-row js-admin-row" data-row-id="@a.AppointmentID" data-row-kind="desktop">
                    <div>
                        <div class="na-date"><i class="bi bi-calendar2-week me-1"></i>@a.AppointmentDate.ToString("HH:mm dd/MM/yyyy")</div>
                        <div class="na-date-sub mt-1">Tạo: @a.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                    <div>
                        <div class="na-name">@customer</div>
                        @if (!string.IsNullOrWhiteSpace(phone))
                        {
                            <div class="na-mini mt-1"><i class="bi bi-telephone me-1"></i><a class="na-phone" href="tel:@phone">@phone</a></div>
                        }
                        <div class="na-note">@ShortText(a.Note, 72)</div>
                    </div>
                    <div>
                        <div class="na-source-title">@SourceName(a)</div>
                        <span class="source-badge @SourceClass(a)"><i class="bi bi-building"></i>@SourceType(a)</span>
                        <div class="na-mini mt-2"><i class="bi bi-person-badge me-1"></i>@SellerName(a)</div>
                    </div>
                    <div>
                        <span class="status-pill @StatusClass(a.Status)">@StatusText(a.Status)</span>
                        <div><span class="result-pill"><i class="bi bi-clipboard-check"></i>@ResultText(a.ResultStatus)</span></div>
                        @if (wasReminded)
                        {
                            <div><span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i>Đã thông báo</span></div>
                        }
                        else if (canBell)
                        {
                            <div><span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i>Chưa thông báo</span></div>
                        }
                    </div>
                    <div class="na-actions">
                        <button type="button" class="tool-btn" onclick="openAppointmentDetail(@a.AppointmentID)" title="Xem chi tiết">
                            <i class="bi bi-eye-fill"></i>
                        </button>
                        @if (canBell)
                        {
                            <button type="button" class="tool-btn bell" onclick="remindAppointment(@a.AppointmentID)" title="Bấm chuông thông báo">
                                <i class="bi bi-bell-fill"></i>
                            </button>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="na-mobile-list">
            @foreach (var a in items)
            {
                bool canBell = CanShowBell(a);
                bool wasReminded = IsReminded(a);
                string customer = CustomerName(a);
                string firstLetter = string.IsNullOrWhiteSpace(customer) ? "K" : customer.Trim().Substring(0, 1).ToUpperInvariant();
                string phone = a.CustomerPhone ?? "";

                <article class="na-mobile-card js-admin-row" data-row-id="@a.AppointmentID" data-row-kind="mobile">
                    <div class="mobile-top">
                        <div class="d-flex gap-2 align-items-start">
                            <div class="avatar">@firstLetter</div>
                            <div>
                                <div class="na-name">@customer</div>
                                @if (!string.IsNullOrWhiteSpace(phone))
                                {
                                    <div class="na-mini"><i class="bi bi-telephone me-1"></i><a class="na-phone" href="tel:@phone">@phone</a></div>
                                }
                            </div>
                        </div>
                        <span class="status-pill @StatusClass(a.Status)">@StatusText(a.Status)</span>
                    </div>
                    <div class="mobile-box">
                        <div class="mobile-label">Thời gian hẹn</div>
                        <div class="na-date">@a.AppointmentDate.ToString("HH:mm dd/MM/yyyy")</div>
                    </div>
                    <div class="mobile-box">
                        <div class="mobile-label">Nguồn</div>
                        <div class="na-source-title">@SourceName(a)</div>
                        <span class="source-badge @SourceClass(a)"><i class="bi bi-building"></i>@SourceType(a)</span>
                        <div class="na-mini mt-1"><i class="bi bi-person-badge me-1"></i>@SellerName(a)</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (wasReminded)
                        {
                            <span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i>Đã thông báo</span>
                        }
                        else if (canBell)
                        {
                            <span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i>Chưa thông báo</span>
                        }
                        <span class="result-pill"><i class="bi bi-clipboard-check"></i>@ResultText(a.ResultStatus)</span>
                    </div>
                    <div class="mobile-actions">
                        <button type="button" class="btn btn-light border mobile-action-btn" onclick="openAppointmentDetail(@a.AppointmentID)">
                            <i class="bi bi-eye-fill"></i>Chi tiết
                        </button>
                        @if (canBell)
                        {
                            <button type="button" class="btn btn-warning mobile-action-btn" onclick="remindAppointment(@a.AppointmentID)">
                                <i class="bi bi-bell-fill"></i>Thông báo
                            </button>
                        }
                    </div>
                </article>
            }
        </div>
    </section>

    <div class="na-empty" id="emptyState" style="display:@(items.Any() ? "none" : "block")">
        <i class="bi bi-bell-slash"></i>
        <h5 class="fw-bold text-dark mb-1">Không còn lịch hẹn cần thông báo</h5>
        <div>Những lịch đã được nhắc hoặc đã xử lý sẽ không hiện chuông lại để tránh làm phiền người phụ trách.</div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="na-pager" aria-label="Phân trang lịch hẹn">
            <div class="text-muted fw-bold small">Hiển thị @pageFrom - @pageTo / @totalFilteredItems mục</div>
            <ul class="pagination">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Appointments" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">‹</a>
                </li>
                @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-area="Admin" asp-controller="Appointments" asp-action="Index" asp-route-page="@p" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="Appointments" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-keyword="@keyword" asp-route-source="@source" asp-route-remindFilter="@remindFilter" asp-route-dateRange="@dateRange">›</a>
                </li>
            </ul>
        </nav>
    }
</div>

<div class="modal fade" id="adminDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius:22px; overflow:hidden;">
            <div class="modal-header text-white" style="background:linear-gradient(135deg,#0f172a,#2563eb);">
                <div>
                    <h5 class="modal-title fw-bold"><i class="bi bi-calendar-check me-2"></i>Chi tiết lịch hẹn</h5>
                    <div class="small opacity-75">Admin chỉ xem và bấm chuông nhắc nếu mục còn mới/chưa xử lý.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-person-lines-fill me-1"></i>Khách hàng</div>
                            <div class="detail-row"><div class="detail-label">Họ tên</div><div class="detail-value" id="md-buyerName"></div></div>
                            <div class="detail-row"><div class="detail-label">SĐT</div><div class="detail-value" id="md-buyerPhone"></div></div>
                            <div class="detail-row"><div class="detail-label">Ghi chú khách</div><div class="detail-value" id="md-note"></div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-building me-1"></i>Nguồn & phụ trách</div>
                            <div class="detail-row"><div class="detail-label">Nguồn</div><div class="detail-value" id="md-source"></div></div>
                            <div class="detail-row"><div class="detail-label">Loại nguồn</div><div class="detail-value" id="md-sourceType"></div></div>
                            <div class="detail-row"><div class="detail-label">Phụ trách</div><div class="detail-value" id="md-sellerName"></div></div>
                            <div class="detail-row"><div class="detail-label">SĐT phụ trách</div><div class="detail-value" id="md-sellerPhone"></div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-clock-history me-1"></i>Tiến độ</div>
                            <div class="detail-row"><div class="detail-label">Ngày tạo</div><div class="detail-value" id="md-createdAt"></div></div>
                            <div class="detail-row"><div class="detail-label">Giờ hẹn</div><div class="detail-value" id="md-appointmentDate"></div></div>
                            <div class="detail-row"><div class="detail-label">Giờ đề xuất</div><div class="detail-value" id="md-proposedDate"></div></div>
                            <div class="detail-row"><div class="detail-label">Trạng thái</div><div class="detail-value" id="md-status"></div></div>
                            <div class="detail-row"><div class="detail-label">Kết quả</div><div class="detail-value" id="md-resultStatus"></div></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white rounded-4 p-3 h-100 border">
                            <div class="fw-bold text-uppercase small text-primary mb-2"><i class="bi bi-bell me-1"></i>Thông báo</div>
                            <div class="detail-row"><div class="detail-label">Tình trạng</div><div class="detail-value" id="md-remindedText"></div></div>
                            <div class="detail-row"><div class="detail-label">Địa điểm</div><div class="detail-value" id="md-location"></div></div>
                            <div class="detail-row"><div class="detail-label">Lịch sử</div><div class="detail-value" id="md-negotiationNote"></div></div>
                            <div class="detail-row"><div class="detail-label">Ghi chú kết quả</div><div class="detail-value" id="md-resultNote"></div></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white">
                <button type="button" class="btn btn-light border fw-bold" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const appointmentRemindUrl = '@Url.Action("RemindSeller", "Appointments", new { area = "Admin" })';
        const appointmentDetailUrl = '@Url.Action("GetDetails", "Appointments", new { area = "Admin" })';
        const currentRemindFilter = '@remindFilter';

        function antiForgeryToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        function updateCounter(id, delta) {
            const el = document.getElementById(id);
            if (!el) return;
            const current = parseInt((el.innerText || '0').replace(/[^0-9-]/g, ''), 10) || 0;
            el.innerText = Math.max(0, current + delta).toLocaleString('vi-VN');
        }

        function removeRowsAfterRemind(id) {
            document.querySelectorAll('[data-row-id="' + id + '"]').forEach(x => x.remove());
            updateCounter('stat-needs', -1);
            updateCounter('stat-reminded', 1);

            const remainingDesktopRows = document.querySelectorAll('.js-admin-row[data-row-kind="desktop"]').length;
            if (remainingDesktopRows === 0) {
                document.getElementById('listShell')?.remove();
                const empty = document.getElementById('emptyState');
                if (empty) empty.style.display = 'block';
            }
        }

        async function remindAppointment(id) {
            const ask = await Swal.fire({
                title: 'Gửi chuông thông báo?',
                text: 'Admin chỉ gửi một lần cho lịch hẹn mới/chưa xử lý. Sau khi gửi, mục này sẽ không hiện chuông lại.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Gửi thông báo',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#2563eb'
            });

            if (!ask.isConfirmed) return;

            const form = new FormData();
            form.append('id', id);
            form.append('__RequestVerificationToken', antiForgeryToken());

            Swal.fire({ title: 'Đang gửi thông báo...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            try {
                const response = await fetch(appointmentRemindUrl, { method: 'POST', body: form });
                const result = await response.json();
                Swal.close();

                if (!result.success) {
                    Swal.fire('Không thể gửi', result.message || 'Lịch hẹn không còn đủ điều kiện thông báo.', 'warning');
                    if (result.code === 'ALREADY_REMINDED' || result.code === 'ALREADY_HANDLED') {
                        removeRowsAfterRemind(id);
                    }
                    return;
                }

                await Swal.fire('Đã thông báo', result.message || 'Đã gửi chuông thông báo thành công.', 'success');

                if (currentRemindFilter === 'CanRemind' || currentRemindFilter === 'NeedNotify') {
                    removeRowsAfterRemind(id);
                } else {
                    window.location.reload();
                }
            } catch {
                Swal.close();
                Swal.fire('Lỗi', 'Không thể gửi thông báo. Vui lòng thử lại.', 'error');
            }
        }

        function setText(id, value) {
            const el = document.getElementById(id);
            if (el) el.innerText = value || '';
        }

        function setHtml(id, value) {
            const el = document.getElementById(id);
            if (el) el.innerHTML = value || '';
        }

        function openAppointmentDetail(id) {
            Swal.fire({ title: 'Đang tải chi tiết...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

            fetch(appointmentDetailUrl + '?id=' + encodeURIComponent(id))
                .then(r => r.json())
                .then(res => {
                    Swal.close();
                    if (!res.success) {
                        Swal.fire('Không tìm thấy', res.message || 'Không thể tải lịch hẹn.', 'error');
                        return;
                    }

                    const d = res.data;
                    setText('md-buyerName', d.buyerName);
                    setText('md-buyerPhone', d.buyerPhone);
                    setText('md-note', d.note);
                    setText('md-source', d.source);
                    setText('md-sourceType', d.sourceType);
                    setText('md-sellerName', d.sellerName);
                    setText('md-sellerPhone', d.sellerPhone);
                    setText('md-createdAt', d.createdAt);
                    setText('md-appointmentDate', d.appointmentDate);
                    setText('md-proposedDate', d.proposedDate);
                    setText('md-status', d.status);
                    setText('md-resultStatus', d.resultStatus);
                    setText('md-location', d.location);
                    setText('md-negotiationNote', d.negotiationNote);
                    setText('md-resultNote', d.resultNote);

                    setHtml('md-remindedText', d.wasReminded
                        ? '<span class="remind-badge remind-done"><i class="bi bi-check2-circle"></i> Đã thông báo</span>'
                        : '<span class="remind-badge remind-none"><i class="bi bi-exclamation-circle"></i> Chưa thông báo</span>');

                    new bootstrap.Modal(document.getElementById('adminDetailModal')).show();
                })
                .catch(() => {
                    Swal.close();
                    Swal.fire('Lỗi', 'Không thể lấy dữ liệu lịch hẹn.', 'error');
                });
        }
    </script>
}
