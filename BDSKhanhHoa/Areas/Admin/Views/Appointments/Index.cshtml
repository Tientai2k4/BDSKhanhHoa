@model IEnumerable<BDSKhanhHoa.Models.Appointment>
@using System.Collections.Generic

@{
    ViewData["Title"] = "Admin - Lịch hẹn cần thông báo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var items = Model?.ToList() ?? new List<BDSKhanhHoa.Models.Appointment>();

    string keyword = ViewBag.Keyword as string ?? "";
    string source = ViewBag.Source as string ?? "All";
    string dateRange = ViewBag.DateRange as string ?? "all";
    string remindFilter = ViewBag.RemindFilter as string ?? "CanRemind";

    int total = ViewBag.TotalAppointments ?? 0;
    int needsReminder = ViewBag.NeedsReminderAppointments ?? 0;
    int reminded = ViewBag.RemindedAppointments ?? 0;
    int handled = ViewBag.HandledAppointments ?? 0;
    int pending = ViewBag.PendingAppointments ?? 0;
    int confirmed = ViewBag.ConfirmedAppointments ?? 0;
    int totalFilteredItems = ViewBag.TotalFilteredItems ?? items.Count;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    int pageFrom = totalFilteredItems == 0 ? 0 : ((currentPage - 1) * 12) + 1;
    int pageTo = Math.Min(currentPage * 12, totalFilteredItems);
}

@functions {
    private const string RemindMarker = "[REMIND_SELLER_APPOINTMENT]";

    public bool IsReminded(BDSKhanhHoa.Models.Appointment a)
    {
        return !string.IsNullOrWhiteSpace(a.NegotiationNote)
            && a.NegotiationNote.Contains(RemindMarker, StringComparison.OrdinalIgnoreCase);
    }

    public bool CanShowBell(BDSKhanhHoa.Models.Appointment a)
    {
        string status = a.Status ?? "";
        return (status == "Pending" || status == "Chờ xác nhận") && !IsReminded(a);
    }

    public string StatusText(string? status)
    {
        return status switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Cancelled" => "Đã hủy",
            "Completed" => "Đã hoàn tất",
            "Rescheduled" => "Đang dời lịch",
            "NoShow" => "Khách không đến",
            "Chờ xác nhận" => "Chờ xác nhận",
            "Đã xác nhận" => "Đã xác nhận",
            "Đã hủy" => "Đã hủy",
            "Đã hoàn tất" => "Đã hoàn tất",
            "Đang dời lịch" => "Đang dời lịch",
            "Khách không đến" => "Khách không đến",
            _ => "Chờ xác nhận"
        };
    }

    public string StatusClass(string? status)
    {
        return StatusText(status) switch
        {
            "Chờ xác nhận" => "st-waiting",
            "Đã xác nhận" => "st-confirmed",
            "Đang dời lịch" => "st-rescheduled",
            "Đã hoàn tất" => "st-completed",
            "Đã hủy" => "st-cancelled",
            "Khách không đến" => "st-cancelled",
            _ => "st-waiting"
        };
    }

    public string ResultText(string? result)
    {
        return result switch
        {
            "Interested" => "Khách quan tâm",
            "NotInterested" => "Khách không quan tâm",
            "DepositPending" => "Chờ đặt cọc",
            "FollowUp" => "Cần chăm sóc thêm",
            "Khách quan tâm" => "Khách quan tâm",
            "Khách không quan tâm" => "Khách không quan tâm",
            "Chờ đặt cọc" => "Chờ đặt cọc",
            "Cần chăm sóc thêm" => "Cần chăm sóc thêm",
            _ => "Chưa có kết quả"
        };
    }

    public string CustomerName(BDSKhanhHoa.Models.Appointment a)
    {
        return !string.IsNullOrWhiteSpace(a.CustomerName)
            ? a.CustomerName.Trim()
            : (a.Buyer?.FullName ?? a.Buyer?.Username ?? "Khách vãng lai");
    }

    public string SellerName(BDSKhanhHoa.Models.Appointment a)
    {
        if (a.Seller != null)
        {
            return a.Seller.FullName ?? a.Seller.Username ?? "Người phụ trách";
        }

        if (!string.IsNullOrWhiteSpace(a.AssignedStaffName))
        {
            return a.AssignedStaffName.Trim();
        }

        return "Chưa xác định";
    }

    public string SourceName(BDSKhanhHoa.Models.Appointment a)
    {
        return a.Property?.Title
            ?? a.Project?.ProjectName
            ?? a.Lead?.Project?.ProjectName
            ?? "Bất động sản / dự án";
    }

    public string SourceType(BDSKhanhHoa.Models.Appointment a)
    {
        if (a.ProjectID.HasValue || a.LeadID.HasValue || a.Property?.ProjectID != null)
        {
            return "Dự án";
        }

        if (a.PropertyID.HasValue)
        {
            return "Tin lẻ BĐS";
        }

        return "Không xác định";
    }

    public string SourceClass(BDSKhanhHoa.Models.Appointment a)
    {
        return SourceType(a) == "Dự án" ? "src-project" : "src-property";
    }

    public string ShortText(string? value, int max = 96)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Không có ghi chú";
        value = value.Trim();
        return value.Length <= max ? value : value.Substring(0, max) + "...";
    }
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
