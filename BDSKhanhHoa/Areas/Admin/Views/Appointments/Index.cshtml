@model IEnumerable<BDSKhanhHoa.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý Lịch hẹn Hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    string keyword = ViewBag.Keyword as string ?? "";
    string source = ViewBag.Source as string ?? "All";
    string dateRange = ViewBag.DateRange as string ?? "all";

    int total = ViewBag.TotalAppointments ?? 0;
    int pending = ViewBag.PendingAppointments ?? 0;
    int confirmed = ViewBag.ConfirmedAppointments ?? 0;
    int completed = ViewBag.CompletedAppointments ?? 0;
    int interested = ViewBag.InterestedCount ?? 0;
    int reminded = ViewBag.RemindedAppointments ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string RemindMarker = "[REMIND_SELLER_APPOINTMENT]";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .appointments-page {
        --ap-dark: #0f172a;
        --ap-muted: #64748b;
        --ap-border: #e2e8f0;
        --ap-soft: #f8fafc;
        --ap-primary: #2563eb;
        max-width: 100%;
        overflow-x: hidden;
    }

        .appointments-page * {
            min-width: 0;
        }

    .ap-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 16px;
    }

    .ap-title {
        margin: 0 0 4px;
        color: var(--ap-dark);
        font-size: 1.7rem;
        font-weight: 900;
        letter-spacing: -.03em;
        line-height: 1.18;
    }

    .ap-subtitle {
        color: var(--ap-muted);
        font-size: .95rem;
    }

    .ap-export {
        flex: 0 0 auto;
        border-radius: 12px;
        font-weight: 800;
        padding: 10px 16px;
    }

    .ap-stats {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .ap-stat {
        border: 1px solid var(--ap-border);
        border-radius: 16px;
        background: #fff;
        padding: 13px 14px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
    }

    .ap-stat-label {
        color: var(--ap-muted);
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .055em;
        white-space: nowrap;
    }

    .ap-stat-value {
        color: var(--ap-dark);
        font-size: 1.55rem;
        line-height: 1;
        font-weight: 950;
        margin-top: 8px;
    }

    .ap-filter,
    .ap-list,
    .ap-pager {
        border: 1px solid var(--ap-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .045);
    }

    .ap-filter {
        padding: 14px;
        margin-bottom: 14px;
    }

        .ap-filter .form-label {
            margin-bottom: 5px;
            color: var(--ap-muted);
            font-size: .74rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .045em;
        }

    .ap-input {
        min-height: 43px;
        border-radius: 12px;
        border-color: #cbd5e1;
        font-weight: 650;
        box-shadow: none !important;
    }

        .ap-input:focus {
            border-color: var(--ap-primary);
        }

    .ap-list {
        overflow: hidden;
    }

    .ap-list-head,
    .ap-row {
        display: grid;
        grid-template-columns: 1.05fr 1.1fr 1.35fr .9fr 1fr;
        gap: 12px;
        align-items: center;
    }

    .ap-list-head {
        padding: 13px 16px;
        background: var(--ap-soft);
        color: #475569;
        border-bottom: 1px solid var(--ap-border);
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .055em;
    }

    .ap-row {
        padding: 15px 16px;
        border-bottom: 1px solid #f1f5f9;
    }

        .ap-row:last-child {
            border-bottom: 0;
        }

        .ap-row:hover {
            background: #fbfdff;
        }

    .ap-cell-title {
        display: none;
    }

    .ap-date {
        color: var(--ap-primary);
        font-size: 1rem;
        font-weight: 900;
    }

    .ap-name {
        color: var(--ap-dark);
        font-weight: 900;
        overflow-wrap: anywhere;
    }

    .ap-text,
    .ap-note {
        color: var(--ap-muted);
        font-size: .84rem;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .ap-note {
        margin-top: 5px;
    }

    .ap-source {
        display: inline-flex;
        max-width: 100%;
        margin-top: 7px;
        padding: 6px 9px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
        color: #334155;
        font-size: .82rem;
        font-weight: 750;
    }

        .ap-source span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .status-pill,
    .result-pill,
    .remind-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
        border-radius: 999px;
        font-size: .73rem;
        font-weight: 900;
        line-height: 1.2;
        white-space: normal;
    }

    .status-pill {
        padding: 7px 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .result-pill {
        margin-top: 8px;
        padding: 6px 10px;
        border: 1px solid var(--ap-border);
        background: #fff;
        color: #334155;
    }

    .remind-badge {
        margin-top: 8px;
        padding: 6px 10px;
    }

    .st-pending {
        background: #fef3c7;
        color: #b45309;
    }

    .st-confirmed {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .st-cancelled {
        background: #f1f5f9;
        color: #64748b;
        text-decoration: line-through;
    }

    .st-completed {
        background: #dcfce7;
        color: #047857;
    }

    .st-rescheduled {
        background: #fee2e2;
        color: #b91c1c;
    }

    .remind-done {
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ddd6fe;
    }

    .remind-none {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .ap-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

        .ap-actions form {
            margin: 0;
        }

    .btn-admin-tool {
        position: relative;
        width: 38px;
        height: 38px;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        border-radius: 12px;
    }

    .btn-reminded {
        background: #f5f3ff !important;
        border-color: #a78bfa !important;
        color: #7c3aed !important;
    }

    .mini-dot {
        position: absolute;
        top: -5px;
        right: -5px;
        width: 14px;
        height: 14px;
        border: 2px solid #fff;
        border-radius: 999px;
        background: #7c3aed;
    }

    .ap-empty {
        padding: 48px 18px;
        text-align: center;
        color: var(--ap-muted);
    }

    .ap-pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px;
        margin-top: 14px;
    }

    .pagination {
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 5px;
    }

        .pagination .page-link {
            border-radius: 10px;
            margin: 0;
            color: #334155;
            font-weight: 800;
            border: 1px solid var(--ap-border);
        }

        .pagination .active .page-link {
            background: var(--ap-dark);
            border-color: var(--ap-dark);
            color: #fff;
        }

    .ap-modal-card {
        border: 1px solid var(--ap-border);
        border-radius: 16px;
        background: #fff;
        padding: 16px;
        height: 100%;
    }

    .ap-modal-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
        color: var(--ap-dark);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-size: .86rem;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px dashed var(--ap-border);
    }

        .detail-row:last-child {
            border-bottom: 0;
        }

    .detail-label {
        color: var(--ap-muted);
        font-size: .78rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .detail-value {
        color: var(--ap-dark);
        font-size: .92rem;
        font-weight: 750;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .ap-log-box {
        max-height: 180px;
        overflow-y: auto;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 1199.98px) {
        .ap-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .ap-list-head,
        .ap-row {
            grid-template-columns: 1fr 1fr 1.2fr .85fr .85fr;
        }
    }

    @@media (max-width: 767.98px) {
        .appointments-page {
            padding-bottom: 12px;
        }

        .ap-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 12px;
        }

        .ap-title {
            font-size: 1.34rem;
        }

        .ap-subtitle {
            font-size: .86rem;
            line-height: 1.45;
        }

        .ap-export {
            width: 100%;
            justify-content: center;
            padding: 9px 12px;
        }

        .ap-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
            margin-bottom: 12px;
        }

        .ap-stat {
            padding: 10px 11px;
            border-radius: 14px;
        }

        .ap-stat-label {
            font-size: .66rem;
        }

        .ap-stat-value {
            margin-top: 5px;
            font-size: 1.28rem;
        }

        .ap-filter {
            padding: 12px;
            border-radius: 15px;
        }

        .ap-input {
            min-height: 40px;
            font-size: .9rem;
        }

        .ap-list {
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
        }

        .ap-list-head {
            display: none;
        }

        .ap-row {
            display: block;
            padding: 13px;
            margin-bottom: 10px;
            border: 1px solid var(--ap-border);
            border-radius: 16px;
            background: #fff;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .045);
        }

            .ap-row:hover {
                background: #fff;
            }

        .ap-cell {
            padding: 8px 0;
            border-bottom: 1px dashed #e5e7eb;
        }

            .ap-cell:last-child {
                border-bottom: 0;
                padding-bottom: 0;
            }

        .ap-cell-title {
            display: block;
            margin-bottom: 5px;
            color: var(--ap-muted);
            font-size: .69rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .ap-date {
            font-size: .98rem;
        }

        .ap-actions {
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .btn-admin-tool {
            width: 36px;
            height: 36px;
            border-radius: 11px;
        }

        .ap-pager {
            align-items: flex-start;
            flex-direction: column;
            padding: 12px;
            border-radius: 15px;
        }

        .pagination {
            justify-content: flex-start;
        }

        .modal-dialog {
            margin: .5rem;
        }

        .modal-header,
        .modal-body,
        .modal-footer {
            padding: 14px !important;
        }

        .detail-row {
            grid-template-columns: 1fr;
            gap: 3px;
        }
    }
</style>

<div class="appointments-page">
    <header class="ap-head">
        <div>
            <h2 class="ap-title">
                <i class="bi bi-calendar-check text-primary me-2"></i>Giám sát Lịch hẹn Toàn hệ thống
            </h2>
            <div class="ap-subtitle">Theo dõi lịch hẹn, kết quả chốt khách và trạng thái đã nhắc người bán.</div>
        </div>

        <a href="/Admin/Appointments/ExportCsv" class="btn btn-success ap-export">
            <i class="bi bi-file-earmark-excel-fill me-2"></i>Xuất Excel
        </a>
    </header>

    <section class="ap-stats" aria-label="Thống kê lịch hẹn">
        <div class="ap-stat"><div class="ap-stat-label">Tổng số</div><div class="ap-stat-value">@total.ToString("N0")</div></div>
        <div class="ap-stat"><div class="ap-stat-label">Chờ xử lý</div><div class="ap-stat-value">@pending.ToString("N0")</div></div>
        <div class="ap-stat"><div class="ap-stat-label">Đã xác nhận</div><div class="ap-stat-value">@confirmed.ToString("N0")</div></div>
        <div class="ap-stat"><div class="ap-stat-label">Ưng / Cọc</div><div class="ap-stat-value">@interested.ToString("N0")</div></div>
        <div class="ap-stat"><div class="ap-stat-label">Đã nhắc</div><div class="ap-stat-value">@reminded.ToString("N0")</div></div>
        <div class="ap-stat"><div class="ap-stat-label">Hoàn tất</div><div class="ap-stat-value">@completed.ToString("N0")</div></div>
    </section>

    <form method="get"
          asp-action="Index"
          asp-controller="Appointments"
          asp-area="Admin"
          class="ap-filter row g-2 align-items-end">
        <div class="col-xl-3 col-md-6">
            <label class="form-label">Nguồn</label>
            <select name="source" class="form-select ap-input">
                <option value="All" selected="@(source == "All")">Mọi nguồn</option>
                <option value="Property" selected="@(source == "Property")">Tin lẻ BĐS</option>
                <option value="Project" selected="@(source == "Project")">Dự án</option>
            </select>
        </div>

        <div class="col-xl-3 col-md-6">
            <label class="form-label">Thời gian</label>
            <select name="dateRange" class="form-select ap-input">
                <option value="all" selected="@(dateRange == "all")">Toàn thời gian</option>
                <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                <option value="month" selected="@(dateRange == "month")">1 tháng qua</option>
            </select>
        </div>

        <div class="col-xl-4 col-md-8">
            <label class="form-label">Tìm kiếm</label>
            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control ap-input"
                   placeholder="Tên khách, SĐT, BĐS, người phụ trách..." />
        </div>

        <div class="col-xl-2 col-md-4 d-grid">
            <button class="btn btn-dark fw-bold ap-input">
                <i class="bi bi-funnel-fill me-1"></i>Lọc
            </button>
        </div>
    </form>

    <section class="ap-list">
        <div class="ap-list-head">
            <div>Thời gian hẹn</div>
            <div>Người mua</div>
            <div>Người bán & Nguồn</div>
            <div>Tiến độ</div>
            <div class="text-center">Công cụ Admin</div>
        </div>

        @if (Model != null && Model.Any())
        {
            foreach (var a in Model)
            {
                var sourceName = a.Property?.Title ?? a.Project?.ProjectName ?? a.Lead?.Project?.ProjectName ?? "Không rõ";
                var customerName = !string.IsNullOrWhiteSpace(a.CustomerName) ? a.CustomerName : (a.Buyer?.FullName ?? a.Buyer?.Username ?? "Khách vãng lai");
                var sellerName = a.Seller?.FullName ?? "Chưa xác định";

                bool wasReminded = !string.IsNullOrWhiteSpace(a.NegotiationNote)
                && a.NegotiationNote.Contains(RemindMarker, StringComparison.OrdinalIgnoreCase);

                string statusText = "Chờ xử lý";
                string statusClass = "st-pending";

                switch (a.Status)
                {
                    case "Pending":
                        statusText = "Chờ xác nhận";
                        statusClass = "st-pending";
                        break;
                    case "Confirmed":
                        statusText = "Đã xác nhận";
                        statusClass = "st-confirmed";
                        break;
                    case "Rescheduled":
                        statusText = "Đang dời lịch";
                        statusClass = "st-rescheduled";
                        break;
                    case "Cancelled":
                        statusText = "Đã hủy";
                        statusClass = "st-cancelled";
                        break;
                    case "Completed":
                        statusText = "Hoàn tất";
                        statusClass = "st-completed";
                        break;
                }

                string resultText = a.ResultStatus ?? "";

                switch (a.ResultStatus)
                {
                    case "Interested":
                        resultText = "Khách ưng ý";
                        break;
                    case "DepositPending":
                        resultText = "Chờ chốt cọc";
                        break;
                    case "FollowUp":
                        resultText = "Cần bám sát";
                        break;
                    case "NotInterested":
                        resultText = "Không ưng";
                        break;
                }

                <article class="ap-row" id="appointment-row-@a.AppointmentID">
                    <div class="ap-cell">
                        <span class="ap-cell-title">Thời gian hẹn</span>
                        <div class="ap-date">@a.AppointmentDate.ToString("HH:mm - dd/MM/yyyy")</div>

                        @if (a.ProposedAppointmentDate.HasValue)
                        {
                            <div class="ap-note text-danger fw-bold">
                                <i class="bi bi-arrow-right-circle"></i>
                                Đổi sang: @a.ProposedAppointmentDate.Value.ToString("HH:mm dd/MM/yyyy")
                            </div>
                        }

                        <div class="ap-note">Tạo lúc: @a.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                    </div>

                    <div class="ap-cell">
                        <span class="ap-cell-title">Người mua</span>
                        <div class="ap-name">@customerName</div>
                        <div class="ap-note text-success fw-bold">
                            <i class="bi bi-telephone-fill"></i> @(a.CustomerPhone ?? "N/A")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(a.MeetingLocation))
                        {
                            <div class="ap-note" title="@a.MeetingLocation">
                                <i class="bi bi-geo-alt-fill text-danger"></i> @a.MeetingLocation
                            </div>
                        }
                    </div>

                    <div class="ap-cell">
                        <span class="ap-cell-title">Người bán & Nguồn</span>
                        <div class="ap-name">@sellerName</div>
                        <div class="ap-note">
                            <i class="bi bi-headset"></i>
                            Phụ trách: @(string.IsNullOrWhiteSpace(a.AssignedStaffName) ? "Chính chủ/Sale" : a.AssignedStaffName)
                        </div>
                        <div class="ap-source" title="@sourceName">
                            <i class="bi bi-tag-fill text-muted me-1"></i><span>@sourceName</span>
                        </div>

                        <div id="remind-badge-@a.AppointmentID">
                            @if (wasReminded)
                            {
                                <span class="remind-badge remind-done">
                                    <i class="bi bi-check2-circle"></i>Đã thông báo người bán
                                </span>
                            }
                            else
                            {
                                <span class="remind-badge remind-none">
                                    <i class="bi bi-exclamation-circle"></i>Chưa thông báo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="ap-cell">
                        <span class="ap-cell-title">Tiến độ</span>
                        <span class="status-pill @statusClass">@statusText</span>

                        @if (!string.IsNullOrWhiteSpace(a.ResultStatus))
                        {
                            <div class="result-pill">
                                <i class="bi bi-bookmark-check-fill text-success"></i>@resultText
                            </div>
                        }
                    </div>

                    <div class="ap-cell">
                        <span class="ap-cell-title">Công cụ Admin</span>
                        <div class="ap-actions">
                            <button type="button"
                                    class="btn btn-outline-info btn-admin-tool"
                                    onclick="openDetailModal(@a.AppointmentID)"
                                    title="Xem chi tiết lịch hẹn">
                                <i class="bi bi-eye-fill"></i>
                            </button>

                            <form id="frmRemind-@a.AppointmentID">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        id="btn-remind-@a.AppointmentID"
                                        class="btn btn-outline-warning btn-admin-tool @(wasReminded ? "btn-reminded" : "")"
                                        onclick="postAdminRemind('@Url.Action("RemindSeller", "Appointments", new { area = "Admin" })', @a.AppointmentID, false)"
                                        title="@(wasReminded ? "Đã thông báo rồi - bấm để nhắc lại nếu thật sự cần" : "Gửi thông báo nhắc người bán")">
                                    <i class="bi bi-bell-fill"></i>
                                    @if (wasReminded)
                                    {
                                        <span class="mini-dot"></span>
                                    }
                                </button>
                            </form>

                            <form id="frmDel-@a.AppointmentID">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        class="btn btn-outline-danger btn-admin-tool"
                                        onclick="postAdminDelete('@Url.Action("Delete", "Appointments", new { area = "Admin" })', @a.AppointmentID)"
                                        title="Xóa rác / Spam">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </form>
                        </div>

                        @if (wasReminded)
                        {
                            <div class="ap-note" id="remind-text-@a.AppointmentID">Đã thông báo</div>
                        }
                        else
                        {
                            <div class="ap-note text-warning fw-bold" id="remind-text-@a.AppointmentID">Chưa thông báo</div>
                        }
                    </div>
                </article>
            }
        }
        else
        {
            <div class="ap-empty">
                <i class="bi bi-calendar-x display-2 opacity-25 d-block mb-3"></i>
                <h4 class="fw-bold text-dark">Không tìm thấy lịch hẹn</h4>
                <p class="mb-0">Thử điều chỉnh lại bộ lọc tìm kiếm.</p>
            </div>
        }
    </section>

    @if (totalPages > 1)
    {
        <div class="ap-pager">
            <div class="text-muted small fw-semibold">Trang @currentPage / @totalPages</div>

            <nav aria-label="Phân trang lịch hẹn">
                <ul class="pagination mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Appointments"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-source="@source"
                           asp-route-dateRange="@dateRange"
                           asp-route-page="@(currentPage - 1)">Trước</a>
                    </li>

                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                               asp-area="Admin"
                               asp-controller="Appointments"
                               asp-action="Index"
                               asp-route-keyword="@keyword"
                               asp-route-source="@source"
                               asp-route-dateRange="@dateRange"
                               asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-area="Admin"
                           asp-controller="Appointments"
                           asp-action="Index"
                           asp-route-keyword="@keyword"
                           asp-route-source="@source"
                           asp-route-dateRange="@dateRange"
                           asp-route-page="@(currentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<div class="modal fade" id="adminDetailModal" tabindex="-1" aria-hidden="true">
