@model IEnumerable<BDSKhanhHoa.Models.Voucher>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chiến dịch khuyến mãi";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    :root {
        --v-bg: #f6f8fb;
        --v-text: #0f172a;
        --v-muted: #64748b;
        --v-line: #e2e8f0;
        --v-green: #059669;
        --v-shadow: 0 8px 22px rgba(15,23,42,.055)
    }

    .voucher-page {
        background: var(--v-bg);
        min-height: auto;
        padding: 8px;
        overflow-x: hidden
    }

    .voucher-head, .voucher-list {
        background: #fff;
        border: 1px solid rgba(148,163,184,.25);
        border-radius: 14px;
        box-shadow: none
    }

    .voucher-head {
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px
    }

    .head-title {
        display: flex;
        align-items: center;
        gap: 10px
    }

    .head-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dcfce7;
        color: var(--v-green);
        font-size: 1.25rem
    }

    .page-title {
        margin: 0;
        color: var(--v-text);
        font-size: clamp(1.2rem,2vw,1.7rem);
        font-weight: 950;
        letter-spacing: -.035em
    }

    .page-subtitle {
        margin: 4px 0 0;
        color: var(--v-muted);
        font-weight: 650;
        font-size: .9rem
    }

    .create-btn {
        min-height: 40px;
        border-radius: 999px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap
    }

    .v-head, .v-row {
        display: grid;
        grid-template-columns: 160px 1.3fr 150px 110px 230px 130px 90px;
        gap: 10px;
        align-items: center
    }

    .v-head {
        padding: 11px 14px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        color: var(--v-muted);
        font-size: .68rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .04em
    }

    .v-row {
        padding: 12px 14px;
        border-bottom: 1px solid #edf2f7
    }

        .v-row:last-child {
            border-bottom: 0
        }

    .code {
        display: inline-flex;
        max-width: 100%;
        border-radius: 999px;
        padding: 6px 10px;
        background: #0f172a;
        color: #fff;
        font-weight: 950;
        letter-spacing: .06em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis
    }

    .money {
        font-weight: 950;
        color: #2563eb;
        white-space: nowrap
    }

    .discount {
        font-size: 1.05rem;
        color: #dc2626;
        font-weight: 950
    }

    .small-muted {
        color: var(--v-muted);
        font-size: .76rem;
        font-weight: 700
    }

    .pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .72rem;
        font-weight: 950;
        white-space: nowrap
    }

    .run {
        color: #047857;
        background: #dcfce7;
        border: 1px solid #86efac
    }

    .wait {
        color: #b45309;
        background: #fef3c7;
        border: 1px solid #fde68a
    }

    .bad {
        color: #b91c1c;
        background: #fee2e2;
        border: 1px solid #fecaca
    }

    .muted {
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #cbd5e1
    }

    .mobile-grid {
        display: none
    }

    .modal-content {
        border-radius: 14px !important
    }

    .modal-body {
        background: #f8fafc
    }

    .modal-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 8px;
        margin-bottom: 12px
    }

    .soft-input {
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid #dbe4ef;
        background: #f8fafc;
        font-weight: 750;
        box-shadow: none !important
    }

        .soft-input:focus {
            background: #fff;
            border-color: #86efac;
            box-shadow: 0 0 0 4px rgba(16,185,129,.1) !important
        }

    .form-label-mini {
        font-size: .74rem;
        font-weight: 900;
        color: #475569;
        text-transform: uppercase;
        letter-spacing: .04em
    }

    @@media(max-width:1199.98px) {
        .v-head, .v-row {
            grid-template-columns: 135px 1.2fr 130px 90px 180px 120px 70px
        }
    }

    @@media(max-width:991.98px) {
        .v-head {
            display: none
        }

        .voucher-list {
            padding: 0;
            background: transparent;
            border: 0;
            box-shadow: none
        }

        .v-row {
            display: block;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            box-shadow: none;
            margin-bottom: 8px;
            padding: 10px
        }

        .desktop-cell {
            display: none
        }

        .mobile-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 8px;
            margin-top: 10px
        }

        .m-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 13px;
            padding: 8px
        }

        .m-label {
            font-size: .66rem;
            color: var(--v-muted);
            font-weight: 950;
            text-transform: uppercase
        }

        .m-value {
            margin-top: 4px;
            color: var(--v-text);
            font-weight: 900;
            font-size: .84rem
        }

        .v-top {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: flex-start
        }
    }

    @@media(max-width:767.98px) {
        .voucher-page {
            padding: 6px;
            min-height: auto
        }

        .voucher-head {
            padding: 12px;
            flex-direction: column;
            align-items: stretch;
            border-radius: 14px;
            box-shadow: none
        }

        .page-title {
            font-size: 1.18rem
        }

        .page-subtitle {
            font-size: .84rem
        }

        .create-btn {
            width: 100%;
            justify-content: center
        }

        .mobile-grid {
            grid-template-columns: 1fr
        }

        .modal-dialog {
            margin: 8px
        }

        .modal-card {
            padding: 12px
        }
    }
</style>
<div class="voucher-page">
    @if (TempData["Success"] != null)
    {
        <script>Swal.fire({toast:true,position:'top-end',icon:'success',title:'@TempData["Success"]',showConfirmButton:false,timer:3000});</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>Swal.fire({toast:true,position:'top-end',icon:'error',title:'@TempData["Error"]',showConfirmButton:false,timer:3000});</script>
    }
    <section class="voucher-head"><div class="head-title"><span class="head-icon"><i class="bi bi-ticket-perforated-fill"></i></span><div><h1 class="page-title">Chiến dịch khuyến mãi</h1><p class="page-subtitle">Quản lý voucher, số lượt sử dụng và thời hạn áp dụng.</p></div></div><button class="btn btn-success create-btn" data-bs-toggle="modal" data-bs-target="#createVoucherModal"><i class="bi bi-plus-lg"></i>Tạo mã mới</button></section>
    <section class="voucher-list">
        <div class="v-head"><div>Mã code</div><div>Chi tiết</div><div>Đơn tối thiểu</div><div>Đã dùng</div><div>Thời hạn</div><div>Trạng thái</div><div>Khóa/Mở</div></div>
        @foreach (var item in Model)
        {
            var isExpired = item.ExpiryDate < DateTime.Now; var isWaiting = item.StartDate > DateTime.Now;
            <article class="v-row">
                <div class="v-top">
                    <span class="code">@item.Code</span><div class="d-lg-none">
                        @if (isExpired)
                        {
                            <span class="pill bad">Hết hạn</span>
                        }
                        else if (isWaiting)
                        {

                            <span class="pill wait">Sắp diễn ra</span>
                        }
                        else if (item.IsActive && item.UsedCount < item.Quantity)
                        {

                            <span class="pill run">Đang chạy</span>
                        }
                        else
                        {

                            <span class="pill muted">Đã khóa / hết lượt</span>
                        }
                    </div>
                </div><div class="desktop-cell"><span class="discount">@item.DiscountPercent.ToString("0.##")%</span><div class="small-muted">Tối đa @item.MaxDiscountAmount.ToString("N0") ₫</div></div><div class="desktop-cell money">@item.MinOrderAmount.ToString("N0") ₫</div><div class="desktop-cell"><span class="pill muted">@item.UsedCount / @item.Quantity</span></div><div class="desktop-cell"><div class="small-muted">Từ: @item.StartDate.ToString("dd/MM/yyyy HH:mm")</div><div class="fw-bold @(isExpired ? "text-danger" : "text-dark")">Đến: @item.ExpiryDate.ToString("dd/MM/yyyy HH:mm")</div></div><div class="desktop-cell">
                    @if (isExpired)
                    {
                        <span class="pill bad">Hết hạn</span>
                    }
                    else if (isWaiting)
                    {

                        <span class="pill wait">Sắp diễn ra</span>
                    }
                    else if (item.IsActive && item.UsedCount < item.Quantity)
                    {

                        <span class="pill run">Đang chạy</span>
                    }
                    else
                    {

                        <span class="pill muted">Đã khóa / hết lượt</span>
                    }
                </div><div class="desktop-cell"><form asp-action="ToggleStatus" method="post"><input type="hidden" name="id" value="@item.VoucherID" /><button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") fw-bold rounded-3" @(isExpired ? "disabled" : "")><i class="bi @(item.IsActive ? "bi-lock" : "bi-unlock")"></i></button></form></div><div class="mobile-grid"><div class="m-box"><div class="m-label">Giảm</div><div class="m-value text-danger">@item.DiscountPercent.ToString("0.##")% - tối đa @item.MaxDiscountAmount.ToString("N0") ₫</div></div><div class="m-box"><div class="m-label">Đơn tối thiểu</div><div class="m-value text-primary">@item.MinOrderAmount.ToString("N0") ₫</div></div><div class="m-box"><div class="m-label">Đã dùng</div><div class="m-value">@item.UsedCount / @item.Quantity</div></div><div class="m-box"><div class="m-label">Thời hạn</div><div class="m-value">@item.StartDate.ToString("dd/MM/yyyy") - @item.ExpiryDate.ToString("dd/MM/yyyy")</div></div><div class="m-box"><div class="m-label">Khóa/Mở</div><div class="m-value"><form asp-action="ToggleStatus" method="post"><input type="hidden" name="id" value="@item.VoucherID" /><button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") fw-bold rounded-3 w-100" @(isExpired ? "disabled" : "")><i class="bi @(item.IsActive ? "bi-lock" : "bi-unlock") me-1"></i>@(item.IsActive ? "Khóa" : "Mở")</button></form></div></div></div>
            </article>
        }
    </section>
</div>
<div class="modal fade" id="createVoucherModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header bg-success text-white"><h5 class="modal-title fw-bold"><i class="bi bi-ticket-detailed me-2"></i>Phát hành Voucher mới</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div><form asp-action="Create" method="post"><div class="modal-body"><div class="modal-card"><h6 class="fw-bold text-success mb-3">Thông tin cơ bản</h6><div class="row g-3"><div class="col-md-6"><label class="form-label-mini">Mã CODE</label><input type="text" name="Code" class="form-control soft-input text-uppercase fw-bold" required placeholder="VD: SIEUSALE"></div><div class="col-md-6"><label class="form-label-mini">Số lượng</label><input type="number" name="Quantity" class="form-control soft-input" required min="1"></div><div class="col-12"><label class="form-label-mini">Mô tả</label><input type="text" name="Description" class="form-control soft-input" placeholder="VD: Ưu đãi ngày lễ"></div></div></div><div class="modal-card"><h6 class="fw-bold text-primary mb-3">Điều kiện áp dụng</h6><div class="row g-3"><div class="col-md-4"><label class="form-label-mini">% Giảm</label><input type="number" name="DiscountPercent" class="form-control soft-input text-danger fw-bold" required min="1" max="100"></div><div class="col-md-4"><label class="form-label-mini">Giảm tối đa</label><input type="number" name="MaxDiscountAmount" class="form-control soft-input" required min="0"></div><div class="col-md-4"><label class="form-label-mini">Đơn tối thiểu</label><input type="number" name="MinOrderAmount" class="form-control soft-input" required min="0"></div></div></div><div class="modal-card mb-0"><h6 class="fw-bold text-warning mb-3">Thời gian</h6><div class="row g-3"><div class="col-md-6"><label class="form-label-mini">Bắt đầu</label><input type="datetime-local" name="StartDate" class="form-control soft-input" required></div><div class="col-md-6"><label class="form-label-mini">Kết thúc</label><input type="datetime-local" name="ExpiryDate" class="form-control soft-input" required></div><div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="IsActive"><label class="form-check-label fw-bold text-success" for="IsActive">Kích hoạt ngay</label></div></div></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light border fw-bold rounded-pill px-4" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-success fw-bold rounded-pill px-4"><i class="bi bi-save me-1"></i>Lưu Voucher</button></div></form></div></div></div>
