            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .action-row {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

</style>

<div class="admin-page">
    <section class="page-hero">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
            <div>
                <h1 class="page-title"><i class="bi bi-shield-check text-primary me-2"></i>Quản lý & kiểm duyệt tin đăng</h1>
                <p class="page-subtitle">Kiểm duyệt nhanh, lọc trạng thái, kiểm tra trùng và xuất dữ liệu.</p>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <form action="/Admin/Properties/RecheckDuplicates" method="post" onsubmit="return confirm('Kiểm tra lại tin trùng có thể mất vài giây nếu dữ liệu nhiều. Tiếp tục?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        Kiểm tra tin trùng
                    </button>
                </form>

                <a href="/Admin/Properties/ExportReport" class="btn btn-success fw-bold rounded-pill px-4">
                    <i class="bi bi-file-earmark-excel me-1"></i>
                    Xuất CSV
                </a>
            </div>
        </div>
    </section>

    <section class="stat-grid">
        <div class="stat-card bg-blue"><div class="stat-label">Tổng tin</div><div class="stat-value">@totalCount</div><div class="stat-desc">Tất cả tin đang có</div></div>
        <div class="stat-card bg-amber"><div class="stat-label">Chờ duyệt</div><div class="stat-value">@pendingCount</div><div class="stat-desc">Cần kiểm tra</div></div>
        <div class="stat-card bg-red"><div class="stat-label">Tin trùng</div><div class="stat-value">@duplicateCount</div><div class="stat-desc">Cần yêu cầu sửa</div></div>
        <div class="stat-card bg-green"><div class="stat-label">Đang hiển thị</div><div class="stat-value">@approvedCount</div><div class="stat-desc">Đã phê duyệt</div></div>
        <div class="stat-card bg-purple"><div class="stat-label">Giao dịch</div><div class="stat-value">@(soldCount + rentedCount)</div><div class="stat-desc">@soldCount bán • @rentedCount thuê</div></div>
        <div class="stat-card bg-slate"><div class="stat-label">Bị từ chối</div><div class="stat-value">@rejectedCount</div><div class="stat-desc">Đã yêu cầu sửa</div></div>
    </section>

    <section class="filter-card">
        <div class="row g-3 align-items-center">
            <div class="col-xl-8">
                <div class="filter-tabs">
                    <a href="/Admin/Properties/Index" class="btn @(string.IsNullOrEmpty(currentStatus) && !duplicateOnly ? "active" : "")"><i class="bi bi-grid-fill me-1"></i>Tất cả</a>
                    <a href="/Admin/Properties/Index?status=Pending" class="btn @(currentStatus == "Pending" && !duplicateOnly ? "active" : "")">
                        <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt @if (pendingCount > 0) {
                        <span class="badge bg-danger ms-1 rounded-pill">@pendingCount</span>
                                                }
                    </a>
                    <a href="/Admin/Properties/Index?duplicateOnly=true" class="btn @(duplicateOnly ? "dup-active" : "")">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Tin trùng @if (duplicateCount > 0) {
                        <span class="badge bg-light text-danger ms-1 rounded-pill">@duplicateCount</span>
                                                }
                    </a>
                    <a href="/Admin/Properties/Index?status=Approved" class="btn @(currentStatus == "Approved" && !duplicateOnly ? "active" : "")"><i class="bi bi-eye-fill me-1"></i>Đang hiển thị</a>
                    <a href="/Admin/Properties/Index?status=Sold" class="btn @(currentStatus == "Sold" && !duplicateOnly ? "active" : "")"><i class="bi bi-bag-check-fill me-1"></i>Đã bán</a>
                    <a href="/Admin/Properties/Index?status=Rented" class="btn @(currentStatus == "Rented" && !duplicateOnly ? "active" : "")"><i class="bi bi-key-fill me-1"></i>Đã cho thuê</a>
                    <a href="/Admin/Properties/Index?status=Expired" class="btn @(currentStatus == "Expired" && !duplicateOnly ? "active" : "")">
                        <i class="bi bi-clock-history me-1"></i>Tin hết hạn @if (expiredCount > 0) {
                        <span class="badge bg-light text-dark ms-1 rounded-pill">@expiredCount</span>
                                                }
                    </a>
                    <a href="/Admin/Properties/Index?status=Rejected" class="btn @(currentStatus == "Rejected" && !duplicateOnly ? "active" : "")"><i class="bi bi-eye-slash-fill me-1"></i>Tạm dừng / Cần sửa</a>
                </div>
            </div>

            <div class="col-xl-4">
                <form method="get" action="/Admin/Properties/Index" class="d-flex gap-2">
                    <input type="hidden" name="status" value="@currentStatus" />
                    <input type="hidden" name="duplicateOnly" value="@duplicateOnly.ToString().ToLower()" />
                    <input type="hidden" name="pageSize" value="@pageSize" />
                    <input type="text" name="keyword" value="@keyword" class="form-control search-input" placeholder="Tìm tiêu đề, người đăng, số điện thoại..." />
                    <button type="submit" class="btn btn-primary rounded-pill fw-bold px-4"><i class="bi bi-search"></i></button>
                </form>
            </div>
        </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mb-3 px-1 text-muted small fw-semibold">
        <span>Đang hiển thị @Model.Count() / @totalFiltered kết quả phù hợp</span>
        <span>Trang @@page / @(totalPages <= 0 ? 1 : totalPages)</span>
    </div>

    @if (!Model.Any())
    {
        <section class="empty-card">
            <div class="empty-icon"><i class="bi bi-inbox"></i></div>
            <h4 class="fw-bold text-dark mb-2">Không có dữ liệu</h4>
            <p class="text-muted fw-semibold mb-0">Chưa có tin đăng nào phù hợp với bộ lọc hiện tại.</p>
        </section>
    }
    else
    {
        <section class="property-list">
            @foreach (var item in Model)
            {
                string image = SafeImage(item.MainImage);
                string cardClass = item.IsDuplicate ? "property-card is-duplicate" : "property-card";
                string duplicateReason = string.IsNullOrWhiteSpace(item.DuplicateReason)
                ? "Tin đăng có dấu hiệu trùng lặp với tin khác. Vui lòng kiểm tra và yêu cầu người đăng chỉnh sửa."
                : item.DuplicateReason;

                <article class="@cardClass">
                    <div class="property-main">
                        <div class="position-relative">
                            <img src="@image" class="property-image" alt="@item.Title" loading="lazy" onerror="this.src='/images/no-image.jpg'" />
                            @if (item.IsAutoApproved)
                            {
                                <span class="position-absolute top-0 start-0 translate-middle p-2 bg-primary border border-light rounded-circle" title="Tin được duyệt tự động"><i class="bi bi-robot text-white small"></i></span>
                            }
                        </div>

                        <div class="property-content">
                            <div class="badge-row">
                                @if (item.IsDuplicate)
                                {
                                    <span class="status-badge badge-duplicate"><i class="bi bi-exclamation-triangle-fill"></i>Trùng lặp</span>
                                }
                                @if (item.Status == "Approved")
                                {
                                    <span class="status-badge badge-approved"><i class="bi bi-eye-fill"></i>Đang hiển thị</span>
                                }
                                else if (item.Status == "Pending")
                                {

                                    <span class="status-badge badge-pending"><i class="bi bi-hourglass-split"></i>Chờ duyệt</span>
                                }
                                else if (item.Status == "Rejected")
                                {

                                    <span class="status-badge badge-rejected"><i class="bi bi-eye-slash-fill"></i>Tạm dừng / Cần sửa</span>
                                }
                                else if (item.Status == "Sold")
                                {

                                    <span class="status-badge badge-sold"><i class="bi bi-bag-check-fill"></i>Đã bán</span>
                                }
                                else if (item.Status == "Rented")
                                {

                                    <span class="status-badge badge-rented"><i class="bi bi-key-fill"></i>Đã cho thuê</span>
                                }
                                else if (item.Status == "Expired")
                                {

                                    <span class="status-badge badge-expired"><i class="bi bi-clock-history"></i>Tin hết hạn</span>
                                }
                                else
                                {

                                    <span class="status-badge badge-rejected"><i class="bi bi-info-circle-fill"></i>@StatusText(item.Status)</span>
                                }

                                @if (item.PostServicePackage != null)
                                {
                                    <span class="status-badge badge-package"><i class="bi bi-star-fill text-warning"></i>@item.PostServicePackage.PackageName</span>
                                }
                            </div>

                            <h2 class="property-title" title="@item.Title">@item.Title</h2>

                            <div class="meta-line"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@SafeText(item.AddressDetail, "Chưa có địa chỉ") — @SafeText(item.Ward?.WardName, "Chưa có phường/xã"), @SafeText(item.Ward?.Area?.AreaName, "Chưa có khu vực")</div>
                            <div class="meta-line"><i class="bi bi-person-circle text-primary me-1"></i>Người đăng: <strong>@SafeText(item.User?.FullName, "Không rõ")</strong> — <i class="bi bi-telephone ms-1 me-1"></i>@SafeText(item.User?.Phone, "Chưa có SĐT")</div>
                            <div class="meta-line">
                                <i class="bi bi-calendar-plus me-1"></i>Ngày đăng: @item.CreatedAt.ToString("dd/MM/yyyy HH:mm") @if (item.SoldAt.HasValue) {
                                <span> — Giao dịch: @item.SoldAt.Value.ToString("dd/MM/yyyy")</span>
                            }
                        </div>

                        <div class="mt-2">
                            <span class="price-text">@FormatPrice(item.Price)</span>
                            <span class="type-text ms-2">
                                • @SafeText(item.PropertyType?.TypeName, "Chưa có loại") @if (item.AreaSize.HasValue) {
                                <span> • @item.AreaSize.Value.ToString("0.##") m²</span>
                            }
                        </span>
                    </div>

                    @if (item.IsDuplicate)
                    {
                        <div class="duplicate-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Lý do nghi trùng:</strong> @duplicateReason</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(item.RejectionReason))
                    {
                        <div class="reject-warning"><i class="bi bi-info-circle-fill me-1"></i><strong>Lý do tạm dừng / cần chỉnh sửa:</strong> @item.RejectionReason</div>
                    }
                </div>

                <div class="action-row">
                    <a href="/Property/Details/@item.PropertyID" target="_blank" class="action-btn btn-view" title="Xem chi tiết"><i class="bi bi-eye-fill"></i><span>Xem</span></a>

                    @if (item.Status != "Sold" && item.Status != "Rented" && item.Status != "Expired")
                    {
                        <a href="/Admin/Properties/Edit/@item.PropertyID?returnUrl=@encodedReturnUrl" class="action-btn btn-edit" title="Admin chỉnh sửa tin đăng"><i class="bi bi-pencil-square"></i><span>Sửa</span></a>
                    }

                    @if ((item.Status == "Pending" || item.Status == "Rejected") && !item.IsDuplicate)
                    {
                        <form action="/Admin/Properties/UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.PropertyID" />
                            <input type="hidden" name="newStatus" value="Approved" />
                            <button type="submit" class="action-btn btn-approve" title="Duyệt hiển thị"><i class="bi bi-check-lg"></i><span>Duyệt</span></button>
                        </form>
                    }

                    @if (item.IsDuplicate)
                    {
                        <button type="button" class="action-btn btn-duplicate" data-id="@item.PropertyID" data-title="@item.Title" data-reason="@duplicateReason" onclick="openDuplicateModal(this)" title="Gửi thông báo yêu cầu sửa tin trùng"><i class="bi bi-bell-fill"></i><span>Yêu cầu sửa</span></button>
                        <form action="/Admin/Properties/ClearDuplicateFlag" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn tin này không trùng và muốn bỏ cảnh báo?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.PropertyID" />
                            <button type="submit" class="action-btn btn-clear-dup" title="Bỏ cảnh báo trùng"><i class="bi bi-shield-check"></i><span>Bỏ cảnh báo</span></button>
                        </form>
                    }

                    @if (item.Status == "Pending" || item.Status == "Approved")
                    {
                        <button type="button" class="action-btn btn-reject" data-id="@item.PropertyID" data-title="@item.Title" onclick="openRejectModal(this)" title="Từ chối tin đăng"><i class="bi bi-x-lg"></i><span>Từ chối</span></button>
                    }

                    <button type="button" class="action-btn btn-delete" onclick="confirmDelete(@item.PropertyID)" title="Xóa tin"><i class="bi bi-trash3-fill"></i><span>Xóa</span></button>
                    <form id="deleteForm-@item.PropertyID" action="/Admin/Properties/Delete" method="post" class="d-none">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.PropertyID" />
                    </form>
                </div>
            </div>
        </article>
                }
    </section>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link" href="/Admin/Properties/Index?status=@currentStatus&duplicateOnly=@duplicateOnly.ToString().ToLower()&keyword=@keyword&page=@(page - 1)&pageSize=@pageSize">Trước</a>
                </li>

                @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link" href="/Admin/Properties/Index?status=@currentStatus&duplicateOnly=@duplicateOnly.ToString().ToLower()&keyword=@keyword&page=@i&pageSize=@pageSize">@i</a>
                    </li>
                }

                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="/Admin/Properties/Index?status=@currentStatus&duplicateOnly=@duplicateOnly.ToString().ToLower()&keyword=@keyword&page=@(page + 1)&pageSize=@pageSize">Sau</a>
                </li>
            </ul>
        </nav>
    }
        }
</div>

<div class="modal fade" id="duplicateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-danger text-white border-0">
                <div>
                    <h5 class="modal-title mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Gửi cảnh báo tin đăng trùng lặp</h5>
                    <div class="small opacity-75">Tin sẽ chuyển sang trạng thái bị từ chối để người đăng sửa lại.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form action="/Admin/Properties/NotifyDuplicate" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="duplicatePropertyId" />
                    <div class="alert alert-danger bg-opacity-10 border-danger border-opacity-25 small mb-3"><i class="bi bi-bell-fill me-1 text-danger"></i>Hệ thống sẽ gửi thông báo cho người đăng, yêu cầu họ chỉnh sửa nội dung để tin không còn trùng lặp.</div>
                    <label class="form-label fw-bold text-secondary">Tin cần yêu cầu sửa</label>
                    <div id="duplicatePropertyTitle" class="fw-bold text-primary p-3 rounded-4 bg-light border mb-3"></div>
                    <label class="form-label fw-bold text-secondary">Nội dung thông báo / lý do trùng lặp <span class="text-danger">*</span></label>
                    <textarea class="form-control rounded-4" name="reason" id="duplicateReason" rows="5" required></textarea>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-white border fw-bold rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm"><i class="bi bi-send-fill me-1"></i>Gửi yêu cầu sửa tin</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg overflow-hidden">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title"><i class="bi bi-shield-x me-2"></i>Từ chối tin đăng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <form action="/Admin/Properties/UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="rejectPropertyId" />
                    <input type="hidden" name="newStatus" value="Rejected" />
                    <div class="alert alert-warning bg-opacity-10 border-warning border-opacity-25 small mb-3"><i class="bi bi-info-circle-fill me-1 text-warning"></i>Hệ thống sẽ hoàn trả lượt đăng nếu đây là lần đầu tin bị từ chối.</div>
                    <label class="form-label fw-bold text-secondary">Tin cần xử lý</label>
                    <div id="rejectPropertyTitle" class="fw-bold text-primary p-3 rounded-4 bg-light border mb-3"></div>
                    <label class="form-label fw-bold text-secondary">Lý do từ chối <span class="text-danger">*</span></label>
                    <textarea class="form-control rounded-4" name="reason" rows="4" placeholder="Nhập nguyên nhân cần người đăng chỉnh sửa..." required></textarea>
                </div>
                <div class="modal-footer border-0 bg-light">
                    <button type="button" class="btn btn-white border fw-bold rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4 shadow-sm">Xác nhận từ chối</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openDuplicateModal(button) {
            const id = button.dataset.id || '';
            const title = button.dataset.title || '';
            const reason = button.dataset.reason || 'Tin đăng có dấu hiệu trùng lặp với tin đã đăng trước đó. Vui lòng chỉnh sửa tiêu đề, mô tả, địa chỉ, giá, hình ảnh hoặc thông tin chi tiết để tránh trùng lặp.';
            document.getElementById('duplicatePropertyId').value = id;
            document.getElementById('duplicatePropertyTitle').innerText = title;
            document.getElementById('duplicateReason').value = reason;
            new bootstrap.Modal(document.getElementById('duplicateModal')).show();
        }

        function openRejectModal(button) {
            const id = button.dataset.id || '';
            const title = button.dataset.title || '';
            document.getElementById('rejectPropertyId').value = id;
            document.getElementById('rejectPropertyTitle').innerText = title;
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        function confirmDelete(id) {
            Swal.fire({
                title: 'Xóa tin đăng?',
                text: 'Dữ liệu sẽ được chuyển vào thùng rác.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Xóa ngay',
                cancelButtonText: 'Hủy bỏ',
                customClass: { confirmButton: 'rounded-pill px-4', cancelButton: 'rounded-pill px-4' }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteForm-' + id).submit();
                }
            });
        }

        @if (TempData["Success"] != null)
        {
                    <text>
                        Swal.fire({ icon: 'success', title: 'Thành công', text: '@Html.Raw(TempData["Success"])', timer: 3200, showConfirmButton: false, toast: true, position: 'top-end' });
                    </text>
        }

        @if (TempData["Error"] != null)
        {
                    <text>
                        Swal.fire({ icon: 'error', title: 'Thất bại', text: '@Html.Raw(TempData["Error"])', timer: 4200, showConfirmButton: false, toast: true, position: 'top-end' });
                    </text>
        }
    </script>
}
