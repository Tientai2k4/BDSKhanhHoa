<div class="admin-edit-page">

    <div class="edit-mini-nav">
        <div class="edit-mini-title">
            <i class="bi bi-pencil-square text-warning"></i>
            <span>Sửa tin #@Model.PropertyID</span>
        </div>
        <div class="edit-mini-actions">
            <a href="@returnUrl" class="edit-mini-btn"><i class="bi bi-arrow-left"></i>Quay lại</a>
            <a href="/Property/Details/@Model.PropertyID" target="_blank" class="edit-mini-btn"><i class="bi bi-eye"></i>Xem tin</a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-3">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <form action="/Admin/Properties/Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="PropertyID" value="@Model.PropertyID" />
        <input type="hidden" name="ReturnUrl" value="@returnUrl" />
        <input type="hidden" name="PackageID" value="@Model.PackageID" />

        <div class="row g-3">
            <div class="col-lg-8">
                <section class="edit-card">
                    <div class="edit-card-head">
                        <div class="edit-card-icon"><i class="bi bi-card-text"></i></div>
                        <div>
                            <h5 class="edit-card-title">Thông tin chính</h5>
                            <p class="edit-card-note">Tiêu đề, mô tả, loại bất động sản và vị trí hiển thị.</p>
                        </div>
                    </div>

                    <div class="edit-card-body">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Tiêu đề tin đăng <span class="text-danger">*</span></label>
                                <input type="text" name="Title" value="@Model.Title" class="form-control" maxlength="255" required />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Hình thức giao dịch</label>
                                <select id="parentTypeSelect" class="form-select" onchange="filterSubTypes(this.value)">
                                    <option value="">-- Chọn hình thức --</option>
                                    @foreach (var parent in parentTypes)
                                    {
                                        bool selected = Model.PropertyType?.ParentID == parent.TypeID || Model.TypeID == parent.TypeID;
                                        <option value="@parent.TypeID" selected="@selected">@parent.TypeName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Loại bất động sản <span class="text-danger">*</span></label>
                                <select name="TypeID" id="subTypeSelect" class="form-select" required>
                                    <option value="@Model.TypeID">@Model.PropertyType?.TypeName</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Khu vực <span class="text-danger">*</span></label>
                                <select id="areaSelect" class="form-select" onchange="loadWards(this.value)" required>
                                    <option value="">-- Chọn khu vực --</option>
                                    @foreach (var area in areas)
                                    {
                                        <option value="@area.AreaID" selected="@(area.AreaID == currentAreaID)">@area.AreaName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Phường / Xã <span class="text-danger">*</span></label>
                                <select name="WardID" id="wardSelect" class="form-select" required>
                                    <option value="">-- Chọn phường / xã --</option>
                                    @foreach (var ward in wards.Where(w => w.AreaID == currentAreaID).OrderBy(w => w.WardName))
                                    {
                                        <option value="@ward.WardID" selected="@(ward.WardID == Model.WardID)">@ward.WardName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Địa chỉ chi tiết</label>
                                <input type="text" name="AddressDetail" value="@Model.AddressDetail" class="form-control" maxlength="255" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Mô tả chi tiết <span class="text-danger">*</span></label>
                                <textarea name="Description" class="form-control" required>@Model.Description</textarea>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="edit-card">
                    <div class="edit-card-head">
                        <div class="edit-card-icon"><i class="bi bi-rulers"></i></div>
                        <div>
                            <h5 class="edit-card-title">Giá & thông số</h5>
                            <p class="edit-card-note">Các số thập phân được hiển thị gọn, không có .00 hoặc số 0 dư.</p>
                        </div>
                    </div>

                    <div class="edit-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Giá</label>
                                <input type="number" name="Price" value="@FormatMoneyInput(Model.Price)" class="form-control js-clean-number" min="0" step="1000" inputmode="decimal" placeholder="Để trống nếu thỏa thuận" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Diện tích</label>
                                <input type="number" name="AreaSize" value="@FormatDecimalInput(Model.AreaSize)" class="form-control js-clean-number" min="0" step="0.01" inputmode="decimal" placeholder="m²" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Chiều ngang</label>
                                <input type="number" name="Width" value="@FormatDecimalInput(Model.Width)" class="form-control js-clean-number" min="0" step="0.01" inputmode="decimal" placeholder="m" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Chiều dài</label>
                                <input type="number" name="Length" value="@FormatDecimalInput(Model.Length)" class="form-control js-clean-number" min="0" step="0.01" inputmode="decimal" placeholder="m" />
                            </div>

                            <div class="col-12">
                                <div class="metric-preview">
                                    <div class="metric-item"><div class="metric-label">Giá hiện tại</div><div class="metric-value">@FormatPrice(Model.Price)</div></div>
                                    <div class="metric-item"><div class="metric-label">Diện tích</div><div class="metric-value">@FormatDecimalText(Model.AreaSize, "m²")</div></div>
                                    <div class="metric-item"><div class="metric-label">Chiều ngang</div><div class="metric-value">@FormatDecimalText(Model.Width, "m")</div></div>
                                    <div class="metric-item"><div class="metric-label">Chiều dài</div><div class="metric-value">@FormatDecimalText(Model.Length, "m")</div></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="edit-card">
                    <div class="edit-card-head">
                        <div class="edit-card-icon"><i class="bi bi-images"></i></div>
                        <div>
                            <h5 class="edit-card-title">Quản lý ảnh tin đăng</h5>
                            <p class="edit-card-note">Admin được phép thêm ảnh, xóa ảnh và chọn ảnh đại diện. Ảnh hỗ trợ: JPG, JPEG, PNG, WEBP; tối đa 5MB/ảnh.</p>
                        </div>
                    </div>

                    <div class="edit-card-body">
                        @if (propertyImages.Any())
                        {
                            <div class="image-manager mb-3">
                                @foreach (var image in propertyImages)
                                {
                                    <div class="image-tile">
                                        @if (image.IsMain == true || image.ImageURL == Model.MainImage)
                                        {
                                            <span class="image-main-badge">Ảnh chính</span>
                                        }

                                        <img src="@SafeImage(image.ImageURL)" alt="Ảnh tin đăng" onerror="this.src='/images/no-image.jpg'" />

                                        <div class="image-actions">
                                            <label class="image-action-line">
                                                <input type="radio" name="MainImageId" value="@image.ImageID" @(image.IsMain == true || image.ImageURL == Model.MainImage ? "checked" : "") />
                                                Chọn làm ảnh đại diện
                                            </label>

                                            <label class="image-action-line text-danger">
                                                <input type="checkbox" name="DeleteImageIds" value="@image.ImageID" />
                                                Xóa ảnh này
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning rounded-4 fw-semibold">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Tin đăng này chưa có ảnh phụ trong bảng PropertyImages. Bạn có thể tải ảnh mới bên dưới.
                            </div>
                        }

                        <div class="upload-box">
                            <label class="form-label mb-2">Thêm ảnh mới</label>
                            <input type="file" name="NewImages" id="NewImages" class="form-control" accept="image/jpeg,image/jpg,image/png,image/webp" multiple />
                            <div class="small text-muted fw-semibold mt-2">Có thể chọn nhiều ảnh cùng lúc. Nếu xóa hết ảnh cũ và không thêm ảnh mới, ảnh đại diện sẽ chuyển về trống.</div>
                            <div id="uploadPreview" class="upload-preview"></div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <aside class="side-card">
                    <img src="@SafeImage(Model.MainImage)" class="property-img mb-3" alt="@Model.Title" onerror="this.src='/images/no-image.jpg'" />

                    <div class="warning-box mb-3"><i class="bi bi-exclamation-triangle-fill me-1"></i>Admin chỉ nên chỉnh sửa lỗi cần thiết. Không thay đổi bản chất tin đăng nếu chưa có căn cứ rõ ràng.</div>
                    <div class="locked-edit-box mb-3"><i class="bi bi-lock-fill me-1"></i>Gói tin của người dùng đã bị khóa trên màn hình chỉnh sửa Admin. Nếu cần thay đổi gói, hãy xử lý bằng nghiệp vụ thanh toán/giao dịch riêng.</div>

                    <div class="package-locked-box mb-3">
                        <div class="package-locked-title"><span><i class="bi bi-gem me-1"></i>Gói tin hiện tại</span><span class="badge bg-primary rounded-pill">Đã khóa</span></div>
                        @if (currentPackage != null)
                        {
                            <div class="package-current-name">@currentPackage.PackageName</div>
                            <div class="package-current-meta">
                                <div><strong>Loại gói:</strong> @currentPackage.PackageType</div>
                                <div><strong>Giá gói:</strong> @FormatPackagePrice(currentPackage.Price)</div>
                                <div><strong>Thời hạn:</strong> @(currentPackage.DurationDays > 0 ? $"{currentPackage.DurationDays} ngày" : "Không xác định")</div>
                            </div>
                        }
                        else
                        {
                            <div class="package-current-name">Chưa xác định gói tin</div>
                            <div class="package-current-meta">Hệ thống vẫn giữ nguyên PackageID hiện tại: #@Model.PackageID.</div>
                        }
                        <div class="package-lock-note"><i class="bi bi-shield-check me-1"></i>Admin không thể chọn gói khác ở form này. Dữ liệu gửi lên chỉ giữ nguyên gói hiện tại.</div>
                    </div>

                    <div class="info-row"><span class="info-label">Mã tin</span><span class="info-value">#@Model.PropertyID</span></div>
                    <div class="info-row"><span class="info-label">Người đăng</span><span class="info-value">@(Model.User?.FullName ?? Model.User?.Username ?? "Không rõ")</span></div>
                    <div class="info-row"><span class="info-label">SĐT</span><span class="info-value">@(Model.User?.Phone ?? "Chưa có")</span></div>
                    <div class="info-row"><span class="info-label">Trạng thái</span><span class="info-value">@StatusText(Model.Status)</span></div>
                    <div class="info-row"><span class="info-label">Giá hiện tại</span><span class="info-value">@FormatPrice(Model.Price)</span></div>
                    <div class="info-row"><span class="info-label">Diện tích</span><span class="info-value">@FormatDecimalText(Model.AreaSize, "m²")</span></div>
                    <div class="info-row"><span class="info-label">Kích thước</span><span class="info-value">@FormatDecimalText(Model.Width, "m") x @FormatDecimalText(Model.Length, "m")</span></div>
                    <div class="info-row"><span class="info-label">Ngày đăng</span><span class="info-value">@Model.CreatedAt.ToString("dd/MM/yyyy")</span></div>
                    @if (Model.VipExpiryDate.HasValue)
                    {
                        <div class="info-row"><span class="info-label">Hết hạn VIP</span><span class="info-value">@Model.VipExpiryDate.Value.ToString("dd/MM/yyyy")</span></div>
                    }

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-save-admin"><i class="bi bi-save2-fill me-1"></i>Lưu chỉnh sửa</button>
                        <a href="/Property/Details/@Model.PropertyID" target="_blank" class="btn btn-outline-info btn-back-admin"><i class="bi bi-eye-fill me-1"></i>Xem tin ngoài website</a>
                        <a href="@returnUrl" class="btn btn-light border btn-back-admin">Hủy bỏ</a>
                    </div>
                </aside>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const subTypes = @Html.Raw(ViewBag.SubTypesJson ?? "[]");
        const currentTypeId = @Model.TypeID;
        const currentWardId = @Model.WardID;

        function filterSubTypes(parentId) {
            const select = document.getElementById('subTypeSelect');
            if (!select) return;
            select.innerHTML = '<option value="">-- Chọn loại bất động sản --</option>';
            if (!parentId) return;

            const filtered = subTypes.filter(x => String(x.ParentID) === String(parentId));
            filtered.forEach(item => {
                const option = document.createElement('option');
                option.value = item.TypeID;
                option.textContent = item.TypeName;
                if (Number(item.TypeID) === Number(currentTypeId)) option.selected = true;
                select.appendChild(option);
            });
        }

        function loadWards(areaId) {
            const wardSelect = document.getElementById('wardSelect');
            if (!wardSelect) return;
            wardSelect.innerHTML = '<option value="">Đang tải...</option>';
            if (!areaId) {
                wardSelect.innerHTML = '<option value="">-- Chọn khu vực trước --</option>';
                return;
            }

            fetch('/Admin/Properties/GetWardsByArea?areaId=' + encodeURIComponent(areaId))
                .then(response => response.json())
                .then(data => {
                    wardSelect.innerHTML = '<option value="">-- Chọn phường / xã --</option>';
                    data.forEach(item => {
                        const option = document.createElement('option');
                        option.value = item.wardID;
                        option.textContent = item.wardName;
                        if (Number(item.wardID) === Number(currentWardId)) option.selected = true;
                        wardSelect.appendChild(option);
                    });
                })
                .catch(() => { wardSelect.innerHTML = '<option value="">Không tải được phường / xã</option>'; });
        }

        function cleanNumberValue(value) {
            if (value === null || value === undefined) return '';
            value = String(value).trim();
            if (!value) return '';
            value = value.replace(',', '.');
            const number = Number(value);
            if (!Number.isFinite(number)) return value;
            if (number <= 0) return '';
            return Number.isInteger(number) ? String(number) : String(parseFloat(number.toFixed(2)));
        }

        function cleanNumberInputs() {
            document.querySelectorAll('.js-clean-number').forEach(input => {
                input.value = cleanNumberValue(input.value);
                input.addEventListener('blur', function () { this.value = cleanNumberValue(this.value); });
            });
        }

        function previewNewImages() {
            const input = document.getElementById('NewImages');
            const preview = document.getElementById('uploadPreview');
            if (!input || !preview) return;

            input.addEventListener('change', function () {
                preview.innerHTML = '';
                Array.from(this.files || []).forEach(file => {
                    if (!file.type.startsWith('image/')) return;
                    const reader = new FileReader();
                    reader.onload = e => {
                        const img = document.createElement('img');
                        img.src = e.target.result;
                        img.alt = file.name;
                        preview.appendChild(img);
                    };
                    reader.readAsDataURL(file);
                });
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const parentSelect = document.getElementById('parentTypeSelect');
            if (parentSelect && parentSelect.value) filterSubTypes(parentSelect.value);
            cleanNumberInputs();
            previewNewImages();
        });
    </script>
}
