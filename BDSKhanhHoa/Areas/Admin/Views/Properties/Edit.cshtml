@model BDSKhanhHoa.Models.Property

@{
    ViewData["Title"] = "Admin chỉnh sửa tin đăng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var parentTypes = ViewBag.ParentTypes as List<BDSKhanhHoa.Models.PropertyType> ?? new List<BDSKhanhHoa.Models.PropertyType>();
    var areas = ViewBag.Areas as List<BDSKhanhHoa.Models.Area> ?? new List<BDSKhanhHoa.Models.Area>();
    var wards = ViewBag.Wards as List<BDSKhanhHoa.Models.Ward> ?? new List<BDSKhanhHoa.Models.Ward>();
    var packages = ViewBag.Packages as List<BDSKhanhHoa.Models.PostServicePackage> ?? new List<BDSKhanhHoa.Models.PostServicePackage>();
    var propertyImages = ViewBag.PropertyImages as List<BDSKhanhHoa.Models.PropertyImage> ?? new List<BDSKhanhHoa.Models.PropertyImage>();

    int currentAreaID = ViewBag.CurrentAreaID is int aid ? aid : 0;
    var currentPackage = packages.FirstOrDefault(p => p.PackageID == Model.PackageID) ?? Model.PostServicePackage;

    string returnUrl = ViewBag.ReturnUrl as string ?? "/Admin/Properties/Index";
}

@functions {
    public string StatusText(string? status)
    {
        return status switch
        {
            "Approved" => "Đang hiển thị",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Sold" => "Đã bán",
            "Rented" => "Đã cho thuê",
            "Expired" => "Tin hết hạn",
            "Deleted" => "Đã xóa",
            _ => string.IsNullOrWhiteSpace(status) ? "Chưa xác định" : status
        };
    }

    public string FormatPrice(decimal? price)
    {
        if (!price.HasValue || price.Value <= 0)
        {
            return "Thỏa thuận";
        }

        return price.Value.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ";
    }

    public string FormatMoneyInput(decimal? value)
    {
        if (!value.HasValue || value.Value <= 0)
        {
            return "";
        }

        return decimal.Truncate(value.Value) == value.Value
            ? value.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)
            : value.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    public string FormatDecimalInput(decimal? value)
    {
        if (!value.HasValue || value.Value <= 0)
        {
            return "";
        }

        return value.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    public string FormatDecimalText(decimal? value, string unit = "")
    {
        if (!value.HasValue || value.Value <= 0)
        {
            return "Chưa cập nhật";
        }

        string text = value.Value.ToString("0.##", new System.Globalization.CultureInfo("vi-VN"));
        return string.IsNullOrWhiteSpace(unit) ? text : $"{text} {unit}";
    }

    public string FormatPackagePrice(decimal? price)
    {
        if (!price.HasValue || price.Value <= 0)
        {
            return "Miễn phí";
        }

        return price.Value.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " đ";
    }

    public string SafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/no-image.jpg";
        }

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
        {
            return image;
        }

        return "/" + image.TrimStart('/');
    }
}

