@model IEnumerable<BDSKhanhHoa.Models.PropertyFeature>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Quản lý danh mục tiện ích";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var featureGroups = ViewBag.FeatureGroups as List<SelectListItem> ?? new List<SelectListItem>();
    string keyword = ViewBag.Keyword as string ?? "";

    var features = Model ?? Enumerable.Empty<BDSKhanhHoa.Models.PropertyFeature>();
    var groupedFeatures = features
        .GroupBy(f => f.FeatureGroup ?? "Chưa phân nhóm")
        .OrderBy(g => g.Key)
        .ToList();

    int totalGroups = groupedFeatures.Count;
    int totalFeatures = features.Count();
}

<style>
    .feature-page {
        padding: 14px 0 42px;
    }

    .feature-wrap {
        max-width: 1380px;
        margin: 0 auto;
    }

    .feature-alert {
        border: 0;
        border-radius: 18px;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .07);
        font-weight: 700;
    }

    .feature-top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 14px;
        align-items: end;
        margin-bottom: 14px;
    }

    .feature-kicker {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 30px;
        padding: 0 12px;
        border-radius: 999px;
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        font-size: .78rem;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .feature-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.45rem;
        font-weight: 900;
        letter-spacing: -.025em;
        line-height: 1.2;
    }

    .feature-subtitle {
        margin: 6px 0 0;
        color: #64748b;
        font-size: .92rem;
        font-weight: 500;
    }

    .feature-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .feature-search {
        width: 360px;
        max-width: 100%;
    }

        .feature-search .input-group {
            border-radius: 999px;
            overflow: hidden;
            border: 1px solid #dbe4ef;
            background: #fff;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .055);
        }

        .feature-search .form-control {
            min-height: 44px;
            border: 0;
            box-shadow: none;
            color: #0f172a;
            font-size: .92rem;
            font-weight: 600;
            padding-left: 16px;
        }

            .feature-search .form-control:focus {
                box-shadow: none;
            }

        .feature-search .btn {
            width: 48px;
            border: 0;
            background: #2563eb;
            color: #fff;
        }

    .feature-btn {
        min-height: 44px;
        padding: 0 18px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .9rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .feature-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 78px;
        padding: 14px 16px;
        border-radius: 20px;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .055);
    }

    .stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #2563eb;
        background: #eff6ff;
        font-size: 1.15rem;
    }

    .stat-label {
        color: #64748b;
        font-size: .76rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .045em;
        margin-bottom: 3px;
    }

    .stat-value {
        color: #0f172a;
        font-size: 1.28rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .group-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .group-card {
        min-width: 0;
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .06);
        overflow: hidden;
    }

    .group-head {
        padding: 16px 18px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .group-title {
        min-width: 0;
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        line-height: 1.35;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .group-title i {
            width: 34px;
            height: 34px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            background: #eff6ff;
            flex-shrink: 0;
        }

        .group-title span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .group-count {
        min-height: 30px;
        padding: 0 11px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #047857;
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        font-size: .8rem;
        font-weight: 900;
        white-space: nowrap;
    }

    .feature-list {
        display: grid;
        gap: 0;
    }

    .feature-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 13px 18px;
        border-bottom: 1px solid #edf2f7;
        transition: .18s ease;
    }

        .feature-item:last-child {
            border-bottom: 0;
        }

        .feature-item:hover {
            background: #f8fafc;
        }

    .feature-name {
        min-width: 0;
        color: #0f172a;
        font-size: .92rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
        word-break: break-word;
    }

        .feature-name i {
            color: #94a3b8;
            flex-shrink: 0;
        }

    .item-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        background: #fff;
        transition: .18s ease;
    }

        .icon-btn.edit {
            color: #2563eb;
        }

            .icon-btn.edit:hover {
                color: #fff;
                background: #2563eb;
                border-color: #2563eb;
            }

        .icon-btn.delete {
            color: #dc2626;
        }

            .icon-btn.delete:hover {
                color: #fff;
                background: #dc2626;
                border-color: #dc2626;
            }

    .empty-card {
        padding: 46px 18px;
        border-radius: 22px;
        background: #fff;
        border: 1px dashed #cbd5e1;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .055);
        text-align: center;
    }

        .empty-card i {
            display: block;
            margin-bottom: 12px;
            color: #94a3b8;
            font-size: 2.4rem;
        }

    .empty-title {
        margin: 0 0 6px;
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
    }

    .empty-text {
        margin: 0;
        color: #64748b;
        font-size: .92rem;
        font-weight: 500;
    }

    .feature-modal .modal-content {
        border: 0;
        border-radius: 22px;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .22);
        overflow: hidden;
    }

    .feature-modal .modal-header {
        padding: 18px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .feature-modal .modal-title {
        color: #0f172a;
        font-size: 1.05rem;
        font-weight: 900;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .feature-modal .modal-body {
        padding: 20px;
    }

    .feature-modal .modal-footer {
        padding: 14px 20px 18px;
        background: #fff;
        border-top: 1px solid #e2e8f0;
    }

    .modal-label {
        color: #334155;
        font-size: .8rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 7px;
    }

    .modal-control {
        min-height: 46px;
        border-radius: 15px;
        border: 1.5px solid #dbe4ef;
        background: #f8fafc;
        color: #0f172a;
        font-size: .94rem;
        font-weight: 650;
        box-shadow: none !important;
    }

        .modal-control:focus {
            background: #fff;
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
        }

    @@media (max-width: 1199.98px) {
        .group-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 991.98px) {
        .feature-top {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .feature-actions {
            justify-content: stretch;
        }

        .feature-search {
            width: 100%;
        }

        .feature-btn {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .feature-page {
            padding-top: 10px;
        }

        .feature-title {
            font-size: 1.24rem;
        }

        .feature-stats {
            grid-template-columns: 1fr;
        }

        .stat-card {
            min-height: 68px;
            padding: 12px;
        }

        .feature-item {
            grid-template-columns: 1fr;
            align-items: stretch;
            padding: 13px 14px;
        }

        .item-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

        .icon-btn {
            width: 100%;
            height: 38px;
        }

        .group-head {
            padding: 14px;
        }

        .group-title span {
            white-space: normal;
        }

        .feature-modal .modal-dialog {
            margin: 12px;
        }

        .feature-modal .modal-footer {
            display: grid;
            grid-template-columns: 1fr;
        }

            .feature-modal .modal-footer .btn {
                width: 100%;
            }
    }


    /* ===== MOBILE COMPACT PATCH - không cuộn ngang ===== */
    .feature-page, .feature-page * {
        box-sizing: border-box;
    }

    .feature-page {
        overflow-x: hidden;
    }

    @@media (max-width: 767.98px) {
        html, body

    {
        overflow-x: hidden !important;
    }

    .container-fluid.feature-page {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .feature-wrap {
        max-width: 100% !important;
    }

    .feature-kicker {
        min-height: 26px;
        padding: 0 9px;
        font-size: .68rem;
        margin-bottom: 6px;
    }

    .feature-title {
        font-size: 1.05rem !important;
        line-height: 1.25;
    }

    .feature-subtitle {
        display: none;
    }

    .feature-top {
        gap: 10px;
        margin-bottom: 10px;
    }

    .feature-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .feature-search .input-group {
        border-radius: 15px;
        box-shadow: 0 5px 16px rgba(15,23,42,.045);
    }

    .feature-search .form-control {
        min-height: 40px;
        font-size: .84rem;
        padding-left: 12px;
    }

    .feature-search .btn {
        width: 44px;
    }

    .feature-btn {
        min-height: 40px;
        border-radius: 14px;
        font-size: .84rem;
    }

    .feature-stats {
        grid-template-columns: repeat(2,minmax(0,1fr)) !important;
        gap: 8px;
        margin-bottom: 10px;
    }

    .stat-card {
        min-height: 58px !important;
        padding: 9px 10px !important;
        border-radius: 15px;
        gap: 8px;
        box-shadow: 0 5px 14px rgba(15,23,42,.04);
    }

    .stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 12px;
        font-size: .95rem;
    }

    .stat-label {
        font-size: .6rem;
        letter-spacing: .025em;
        margin-bottom: 1px;
    }

    .stat-value {
        font-size: 1.05rem;
    }

    .group-grid {
        grid-template-columns: 1fr !important;
        gap: 10px;
    }

    .group-card {
        border-radius: 17px;
        box-shadow: 0 6px 16px rgba(15,23,42,.045);
    }

    .group-head {
        padding: 10px 11px !important;
    }

    .group-title {
        font-size: .88rem;
        gap: 7px;
    }

        .group-title i {
            width: 30px;
            height: 30px;
            border-radius: 11px;
        }

    .group-count {
        min-height: 26px;
        padding: 0 8px;
        font-size: .7rem;
    }

    .feature-item {
        grid-template-columns: minmax(0,1fr) 78px !important;
        gap: 8px;
        padding: 9px 11px !important;
        align-items: center;
    }

    .feature-name {
        font-size: .82rem;
        line-height: 1.35;
    }

    .item-actions {
        display: grid !important;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
    }

    .icon-btn {
        width: 36px !important;
        height: 34px !important;
        border-radius: 11px;
    }

    .empty-card {
        padding: 26px 14px;
        border-radius: 17px;
    }

    .feature-modal .modal-dialog {
