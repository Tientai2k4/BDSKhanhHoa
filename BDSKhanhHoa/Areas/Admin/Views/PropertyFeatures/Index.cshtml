    }

    .feature-modal .modal-header {
        padding: 13px 14px;
    }

    .feature-modal .modal-body {
        padding: 14px;
    }

    .feature-modal .modal-footer {
        padding: 12px 14px;
    }

    }
</style>

<div class="container-fluid feature-page">
    <div class="feature-wrap">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show feature-alert mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show feature-alert mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <section class="feature-top">
            <div>
                <div class="feature-kicker">
                    <i class="bi bi-sliders"></i>
                    Danh mục tiện ích
                </div>

                <h1 class="feature-title">Quản lý danh mục tiện ích gốc</h1>

                <p class="feature-subtitle">
                    Quản lý các tùy chọn hiển thị khi người dùng đăng tin bất động sản.
                </p>
            </div>

            <div class="feature-actions">
                <form action="/Admin/PropertyFeatures/Index" method="get" class="feature-search">
                    <div class="input-group">
                        <input type="text"
                               name="keyword"
                               value="@keyword"
                               class="form-control"
                               placeholder="Tìm tiện ích..." />

                        <button class="btn" type="submit" title="Tìm kiếm">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <button type="button"
                        class="btn btn-success feature-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#addFeatureModal">
                    <i class="bi bi-plus-lg"></i>
                    Thêm dữ liệu
                </button>
            </div>
        </section>

        <section class="feature-stats">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-collection-fill"></i>
                </div>

                <div>
                    <div class="stat-label">Tổng nhóm</div>
                    <div class="stat-value">@totalGroups</div>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon" style="color:#047857;background:#ecfdf5;">
                    <i class="bi bi-list-check"></i>
                </div>

                <div>
                    <div class="stat-label">Tổng tiện ích</div>
                    <div class="stat-value">@totalFeatures</div>
                </div>
            </div>
        </section>

        @if (!features.Any())
        {
            <section class="empty-card">
                <i class="bi bi-inboxes"></i>
                <h3 class="empty-title">Chưa có danh mục tiện ích</h3>
                <p class="empty-text">
                    Bấm “Thêm dữ liệu” để tạo tiện ích đầu tiên cho hệ thống.
                </p>
            </section>
        }
        else
        {
            <section class="group-grid">
                @foreach (var group in groupedFeatures)
                {
                    <article class="group-card">
                        <header class="group-head">
                            <h2 class="group-title" title="@group.Key">
                                <i class="bi bi-folder2-open"></i>
                                <span>@group.Key</span>
                            </h2>

                            <span class="group-count">
                                @group.Count() mục
                            </span>
                        </header>

                        <div class="feature-list">
                            @foreach (var item in group.OrderBy(x => x.FeatureName))
                            {
                                string safeGroup = (item.FeatureGroup ?? "").Replace("\\", "\\\\").Replace("'", "\\'");
                                string safeName = (item.FeatureName ?? "").Replace("\\", "\\\\").Replace("'", "\\'");

                                <div class="feature-item">
                                    <div class="feature-name">
                                        <i class="bi bi-arrow-return-right"></i>
                                        <span>@item.FeatureName</span>
                                    </div>

                                    <div class="item-actions">
                                        <button type="button"
                                                class="icon-btn edit"
                                                title="Sửa"
                                                onclick="openEditModal(@item.FeatureID, '@safeGroup', '@safeName')">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <form action="/Admin/PropertyFeatures/Delete"
                                              method="post"
                                              onsubmit="return confirm('Xóa tiện ích này sẽ làm mất tùy chọn ở trang đăng tin. Bạn chắc chắn muốn xóa?');">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="id" value="@item.FeatureID" />

                                            <button type="submit" class="icon-btn delete" title="Xóa">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    </div>
</div>

<div class="modal fade feature-modal" id="addFeatureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/Admin/PropertyFeatures/Create" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-plus-circle-fill text-success"></i>
                        Thêm tiện ích mới
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label modal-label">
                            Nhóm hiển thị <span class="text-danger">*</span>
                        </label>

                        <select name="FeatureGroup" class="form-select modal-control" required>
                            <option value="">-- Chọn nhóm tiện ích --</option>
                            @foreach (var g in featureGroups)
                            {
                                <option value="@g.Value">@g.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-0">
                        <label class="form-label modal-label">
                            Tên tiện ích <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               name="FeatureName"
                               class="form-control modal-control"
                               placeholder="Ví dụ: Đông Nam, Sổ hồng, Hồ bơi..."
                               maxlength="255"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light border rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>
                        Tạo mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade feature-modal" id="editFeatureModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/Admin/PropertyFeatures/Edit" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <input type="hidden" name="FeatureID" id="edit_FeatureID" />

                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil-square text-primary"></i>
                        Sửa tiện ích
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label modal-label">
                            Nhóm hiển thị <span class="text-danger">*</span>
                        </label>

                        <select name="FeatureGroup" id="edit_FeatureGroup" class="form-select modal-control" required>
                            @foreach (var g in featureGroups)
                            {
                                <option value="@g.Value">@g.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-0">
                        <label class="form-label modal-label">
                            Tên tiện ích <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               name="FeatureName"
                               id="edit_FeatureName"
                               class="form-control modal-control"
                               maxlength="255"
                               required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light border rounded-pill px-4 fw-bold" data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                        <i class="bi bi-check2 me-1"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, group, name) {
            const idInput = document.getElementById('edit_FeatureID');
            const groupInput = document.getElementById('edit_FeatureGroup');
            const nameInput = document.getElementById('edit_FeatureName');
            const modalElement = document.getElementById('editFeatureModal');

            if (!idInput || !groupInput || !nameInput || !modalElement) {
                return;
            }

            idInput.value = id;
            groupInput.value = group;
            nameInput.value = name;

            const editModal = new bootstrap.Modal(modalElement);
            editModal.show();
        }
    </script>
}