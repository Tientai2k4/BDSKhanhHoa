@using BDSKhanhHoa.Models
@using System.Globalization
@{
    ViewData["Title"] = "Quản lý Yêu cầu từ CĐT";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // Tách 2 danh sách Pending và History
    var pendingContacts = ViewBag.PendingContacts as IEnumerable<ContactMessage>;
    var resolvedContacts = ViewBag.ResolvedContacts as IEnumerable<ContactMessage>;

    var projectEditCounts = ViewBag.ProjectEditCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var projectNames = ViewBag.ProjectNames as Dictionary<int, string> ?? new Dictionary<int, string>();

    string activeTab = ViewBag.ActiveTab as string ?? "all";
    string status = ViewBag.Status as string ?? "";
    string keyword = ViewBag.Keyword as string ?? "";

    bool hasActiveFilter = !string.IsNullOrWhiteSpace(status)
        || !string.IsNullOrWhiteSpace(keyword);

    string FilterSummaryText()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(status))
        {
            parts.Add(TranslateStatus(status));
        }

        if (!string.IsNullOrWhiteSpace(keyword))
        {
            parts.Add("Có từ khóa");
        }

        return parts.Any() ? string.Join(" · ", parts) : "Bấm để mở bộ lọc";
    }

    int contactMessageCount = ViewBag.ContactMessageCount ?? 0;
    int pendingSupportCount = pendingContacts?.Count() ?? contactMessageCount;
    int resolvedSupportCount = resolvedContacts?.Count() ?? 0;
    int totalSupportCount = pendingSupportCount + resolvedSupportCount;

    string TranslateStatus(string? st)
    {
        return st switch { "Pending" => "Chờ xử lý", "Processing" => "Đang xử lý", "Done" or "Đã xử lý" => "Đã hoàn tất", "Contacted" => "Đã liên hệ", "Resolved" => "Thành công", _ => st ?? "Chờ xử lý" };
    }

    string GetStatusBadge(string? st)
    {
        return st switch { "Pending" => "bg-danger", "Processing" or "Contacted" => "bg-warning text-dark", "Done" or "Resolved" or "Đã xử lý" => "bg-success", _ => "bg-secondary" };
    }
}

<style>
    .dash-card {
        background: #fff;
        border-radius: 24px;
        border: 1px solid rgba(148,163,184,.16);
        box-shadow: 0 12px 30px rgba(15, 23, 42, .06);
    }

    .stat-box {
        padding: 22px;
        border-radius: 22px;
        color: #fff;
        min-height: 140px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.06);
    }

    .bg-tuvan {
        background: linear-gradient(135deg, #1d4ed8, #3b82f6);
    }

    .bg-hotro {
        background: linear-gradient(135deg, #0f766e, #14b8a6);
    }

    .bg-lead {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .stat-box .label {
        text-transform: uppercase;
        font-size: .8rem;
        letter-spacing: .08em;
        opacity: .9;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .stat-box .value {
        font-size: 2.8rem;
        font-weight: 900;
        line-height: 1;
    }

    .soft-input {
        min-height: 48px;
        border-radius: 14px;
        font-weight: 600;
        border: 1px solid #dbe3ef;
        box-shadow: none !important;
    }

    .table thead th {
        background: #f8fafc;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        color: #475569;
        white-space: nowrap;
        padding: 16px;
    }

    .table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-top: 1px solid #f1f5f9;
    }

    .ticket-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 8px 14px;
        background: #eef2ff;
        color: #4338ca;
        font-weight: 800;
        font-size: .8rem;
        border: 1px solid #c7d2fe;
    }

    .modal-detail-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
    }

    /* Style cho Tab Admin Lịch sử */
    .nav-pills-custom .nav-link {
        color: #64748b;
        font-weight: 700;
        border-radius: 12px;
        padding: 12px 24px;
        transition: all 0.3s;
        margin-right: 10px;
        border: 1px solid transparent;
    }

        .nav-pills-custom .nav-link:hover {
            background-color: #f1f5f9;
        }

        .nav-pills-custom .nav-link.active {
            background-color: #eef2ff;
            color: #4338ca;
            border-color: #c7d2fe;
            box-shadow: 0 4px 10px rgba(67, 56, 202, 0.08);
        }


    /* =========================================================
               MOBILE COMPACT - Cổng hỗ trợ Đối tác / CĐT
               Thu gọn thống kê, bộ lọc có nút thu/mở, bảng chuyển thành card
               để không bị dài dòng và không cần kéo ngang trên mobile.
               ========================================================= */
    .support-filter-details {
        display: block;
    }

    .support-filter-summary {
        display: none;
        list-style: none;
    }

        .support-filter-summary::-webkit-details-marker {
            display: none;
        }

    .support-filter-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: #f59e0b;
        box-shadow: 0 0 0 4px rgba(245, 158, 11, .14);
        display: inline-flex;
        flex: 0 0 auto;
    }

    .support-filter-chevron {
        transition: transform .18s ease;
    }

    .support-filter-details[open] .support-filter-chevron {
        transform: rotate(180deg);
    }

