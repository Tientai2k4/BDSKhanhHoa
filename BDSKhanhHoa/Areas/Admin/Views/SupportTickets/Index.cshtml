        }

        .dash-card h5 {
            font-size: .98rem !important;
            line-height: 1.25 !important;
        }

        .nav-pills-custom {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: 7px !important;
            margin-bottom: 12px !important;
        }

            .nav-pills-custom .nav-item {
