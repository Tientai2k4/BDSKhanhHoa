@model BDSKhanhHoa.Models.Area

@{
    ViewData["Title"] = "Thêm khu vực mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .area-create-page {
        max-width: 960px;
        margin: 0 auto;
        padding: 18px 0 40px;
    }

    .area-alert {
        border-radius: 18px;
        border: 0;
        box-shadow: 0 10px 26px rgba(15, 23, 42, .07);
        font-weight: 700;
    }

    .area-card {
        border: 1px solid #e2e8f0;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 14px 36px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .area-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .area-title {
        margin: 0;
        color: #0f172a;
        font-size: 1.25rem;
        font-weight: 900;
        letter-spacing: -.02em;
    }

    .area-subtitle {
        margin: 4px 0 0;
        color: #64748b;
        font-size: .92rem;
        font-weight: 500;
    }

    .area-icon-title {
        display: inline-flex;
        align-items: center;
        gap: 9px;
    }

        .area-icon-title i {
            width: 34px;
            height: 34px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: #2563eb;
            font-size: 1rem;
        }

    .area-card-body {
        padding: 24px;
    }

    .area-label {
        color: #334155;
        font-size: .82rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 8px;
    }

    .area-control {
        min-height: 48px;
        border-radius: 15px;
        border: 1.5px solid #dbe4ef;
        background: #f8fafc;
        color: #0f172a;
        font-size: .96rem;
        font-weight: 650;
        box-shadow: none !important;
    }

        .area-control:focus {
            background: #fff;
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
        }

    textarea.area-control {
        min-height: 116px;
        resize: vertical;
    }

    .validation-summary-errors {
        padding: 14px 16px;
        border-radius: 16px;
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
        margin-bottom: 18px;
        font-weight: 700;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .field-validation-error {
        display: block;
        margin-top: 7px;
        font-size: .84rem;
        font-weight: 700;
        color: #dc2626;
    }

    .area-note {
        padding: 14px 16px;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: .9rem;
        font-weight: 600;
    }

    .area-actions {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #e2e8f0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .area-btn {
        min-height: 44px;
        border-radius: 999px;
        padding: 0 22px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

    @@media (max-width: 576px) {
        .area-create-page {
            padding: 12px 0 32px;
        }

        .area-card-header,
        .area-card-body {
            padding: 18px;
        }

        .area-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

        .area-btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid">
    <div class="area-create-page">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show area-alert mb-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show area-alert mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        <div class="area-card">
            <div class="area-card-header">
                <div>
                    <h1 class="area-title area-icon-title">
                        <i class="bi bi-plus-lg"></i>
                        Thêm khu vực mới
                    </h1>
                    <p class="area-subtitle">
                        Tạo khu vực/huyện/thành phố để quản lý xã/phường trực thuộc.
                    </p>
                </div>

                <a asp-action="Index" class="btn btn-light border area-btn">
                    <i class="bi bi-arrow-left"></i>
                    Quay lại
                </a>
            </div>

            <div class="area-card-body">
                <form asp-area="Admin" asp-controller="Areas" asp-action="Create" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"></div>

                    <div class="mb-3">
                        <label for="AreaName" class="form-label area-label">
                            Tên khu vực <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               id="AreaName"
                               name="AreaName"
                               value="@Model?.AreaName"
                               class="form-control area-control"
                               placeholder="Ví dụ: Nha Trang, Cam Lâm, Diên Khánh..."
                               maxlength="100"
                               required />

                        @if (ViewData.ModelState["AreaName"]?.Errors.Count > 0)
                        {
                            <span class="field-validation-error">
                                @ViewData.ModelState["AreaName"]!.Errors.First().ErrorMessage
                            </span>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="Description" class="form-label area-label">
                            Mô tả
                        </label>

                        <textarea id="Description"
                                  name="Description"
                                  class="form-control area-control"
                                  placeholder="Ví dụ: Khu vực Khánh Hòa cũ, khu vực Ninh Thuận cũ..."
                                  maxlength="255">@Model?.Description</textarea>

                        @if (ViewData.ModelState["Description"]?.Errors.Count > 0)
                        {
                            <span class="field-validation-error">
                                @ViewData.ModelState["Description"]!.Errors.First().ErrorMessage
                            </span>
                        }
                    </div>

                    <div class="area-note">
                        <i class="bi bi-info-circle me-1"></i>
                        Sau khi tạo khu vực thành công, hệ thống sẽ chuyển sang trang sửa để bạn thêm xã/phường trực thuộc.
                    </div>

                    <div class="area-actions">
                        <a asp-action="Index" class="btn btn-light border area-btn">
                            Hủy
                        </a>

                        <button type="submit" class="btn btn-primary area-btn">
                            <i class="bi bi-check2"></i>
                            Tạo khu vực
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}