@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject BDSKhanhHoa.Data.ApplicationDbContext _context

@{
    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    int.TryParse(userIdStr, out int currentUserId);

    var currentUser = currentUserId > 0
        ? _context.Users.AsNoTracking().FirstOrDefault(u => u.UserID == currentUserId && u.IsDeleted == false)
        : null;

    var avatarUrl = currentUser != null && !string.IsNullOrWhiteSpace(currentUser.Avatar)
        ? currentUser.Avatar
        : "/images/avatars/default-user.png";

    var displayName = currentUser?.FullName
                      ?? User.FindFirst("FullName")?.Value
                      ?? User.Identity?.Name
                      ?? "Tài khoản";

    bool isAdmin = User.IsInRole("Admin");
    bool isStaff = User.IsInRole("Staff");

    var userRoleStr = isAdmin ? "QUẢN TRỊ VIÊN" : "NHÂN VIÊN";
    if (currentUser?.RoleID == 1) userRoleStr = "SUPER ADMIN";
    if (currentUser?.RoleID == 2) userRoleStr = "NHÂN VIÊN STAFF";

    var dashboardLink = isAdmin ? "/Admin/Dashboard" : "/Admin/StaffDashboard";
    var brandText = isAdmin ? "ADMIN BĐS" : "STAFF BĐS";
    var systemSubTitle = isAdmin ? "Hệ thống điều hành trung tâm" : "Không gian xử lý công việc nhân viên";

    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    // ==============================
    // BADGE CÔNG VIỆC DÙNG CHUNG
    // ==============================
    int pendingProperties = _context.Properties.Count(p => p.Status == "Pending" && p.IsDeleted == false);
    int pendingReports = _context.PropertyReports.Count(r => r.Status == "Pending" && r.IsDeleted == false);
    int pendingConsultations = _context.Consultations.Count(c => c.Status == "New");
    int pendingContacts = _context.ContactMessages.Count(c => c.Status == "Pending" || c.Status == "Chưa xử lý");
    int pendingConversationReports = _context.ConversationReports.Count(r => r.Status == "Pending");

    int lockedByConversationReport = _context.Users.Count(u =>
        !u.IsDeleted &&
        u.IsActive == false &&
        u.AdminNote != null &&
        u.AdminNote.Contains("AUTO-KHÓA DO VI PHẠM"));
    // ==============================
    // BADGE CHỈ ADMIN
    // ==============================
    int pendingBusiness = 0;
    int pendingProjects = 0;
    int pendingAppointments = 0;
    int pendingTransactions = 0;

    if (isAdmin)
    {
        pendingBusiness = _context.BusinessProfiles.Count(b => b.VerificationStatus == "Pending");
        pendingProjects = _context.Projects.Count(p => p.ApprovalStatus == "Pending" && p.IsDeleted == false);
        pendingAppointments = _context.Appointments.Count(a => a.Status == "Pending");
        pendingTransactions = _context.Transactions.Count(t => t.Status == "Pending");
    }

    int totalBusinessTasks = pendingBusiness + pendingProjects;
    int totalPropertyTasks = pendingProperties;
    int totalCrmTasks =
        pendingContacts +
        pendingReports +
        pendingConversationReports +
        pendingConsultations +
        pendingAppointments;
    int totalFinanceTasks = pendingTransactions;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - BĐS Khánh Hòa Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --bg-body: #f8fafc;
            --bg-sidebar: #0f172a;
            --bg-sidebar-2: #111827;
            --bg-sidebar-hover: #1e293b;
            --text-sidebar: #94a3b8;
            --text-sidebar-active: #ffffff;
            --border-sidebar: rgba(255,255,255,.07);
            --accent-admin: #3b82f6;
            --accent-staff: #10b981;
            --accent: @(isAdmin ? "#3b82f6" : "#10b981");
            --accent-glow: @(isAdmin ? "rgba(59,130,246,.16)" : "rgba(16,185,129,.16)");
            --header-h: 70px;
            --sidebar-w: 286px;
            --sidebar-w-mini: 82px;
            --transition: background-color .18s ease, color .18s ease, box-shadow .18s ease, opacity .18s ease;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-body);
            color: #334155;
        }

        a {
            text-decoration: none;
        }

        .fw-black {
            font-weight: 900;
        }

        /* ==============================
                           SIDEBAR
                        ============================== */
        .sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: radial-gradient(circle at top left, rgba(59,130,246,.12), transparent 32%), linear-gradient(180deg, var(--bg-sidebar) 0%, var(--bg-sidebar-2) 100%);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1040;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            box-shadow: 8px 0 30px rgba(15,23,42,.08);
            border-right: 1px solid rgba(15,23,42,.18);
        }

            .sidebar.collapsed {
                width: var(--sidebar-w-mini);
            }

        .sidebar-brand {
            height: var(--header-h);
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 18px;
            border-bottom: 1px solid var(--border-sidebar);
            color: #fff;
            overflow: hidden;
            white-space: nowrap;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: var(--accent-glow);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            font-size: 1.35rem;
            flex-shrink: 0;
        }

        .brand-copy {
            min-width: 0;
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

        .brand-title {
            font-size: 1.1rem;
            font-weight: 900;
            letter-spacing: -.02em;
            color: #fff;
        }

        .brand-subtitle {
            margin-top: 3px;
            font-size: .72rem;
            color: #94a3b8;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .sidebar.collapsed .brand-copy {
            display: none;
        }

        .sidebar-menu {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 14px 0 18px;
        }

            .sidebar-menu::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.12);
                border-radius: 999px;
            }

        .menu-title {
            padding: 16px 22px 7px;
            font-size: .7rem;
            font-weight: 900;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .12em;
            white-space: nowrap;
            transition: var(--transition);
        }

        .sidebar.collapsed .menu-title {
            opacity: 0;
            height: 0;
            padding: 0;
            overflow: hidden;
        }

        .nav-item {
            list-style: none;
            margin: 3px 12px;
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-height: 46px;
            padding: 10px 12px;
            color: var(--text-sidebar);
            border-radius: 12px;
            font-weight: 700;
            font-size: .92rem;
            transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;
            white-space: nowrap;
            position: relative;
        }

            .nav-link-custom:hover {
                background: var(--bg-sidebar-hover);
                color: #fff;
            }

            .nav-link-custom.active {
                background: var(--accent-glow);
                color: var(--accent);
                box-shadow: inset 0 0 0 1px rgba(255,255,255,.05);
            }

            .nav-link-custom[aria-expanded="true"] {
                background: var(--bg-sidebar-hover);
                color: #fff;
            }

        .nav-left {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        .nav-link-custom i.icon-main {
            font-size: 1.15rem;
            width: 34px;
            min-width: 34px;
            text-align: center;
            margin-right: 10px;
            transition: color .18s ease;
        }

        .nav-text {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .icon-arrow {
            margin-left: 8px;
            font-size: .78rem;
            transition: transform .25s ease;
            color: #94a3b8;
        }

        .nav-link-custom[aria-expanded="true"] .icon-arrow {
            transform: rotate(90deg);
            color: #fff;
        }

        .sidebar-badge {
            font-size: .68rem;
            font-weight: 900;
            padding: 4px 7px;
            box-shadow: 0 3px 8px rgba(0,0,0,.25);
        }

        .submenu {
            background: rgba(0,0,0,.22);
            border-radius: 12px;
            margin: 6px 0 6px 10px;
            padding: 6px 0;
            list-style: none;
        }

            .submenu .nav-link-custom {
                min-height: 40px;
                padding: 8px 12px 8px 28px;
                font-size: .86rem;
                border-radius: 9px;
                margin: 0 6px;
            }

                .submenu .nav-link-custom:hover {
                    background: rgba(255,255,255,.04);
                }

        .sidebar.collapsed .nav-link-custom {
            justify-content: center;
            padding: 12px 10px;
        }

            .sidebar.collapsed .nav-link-custom i.icon-main {
                margin-right: 0;
                font-size: 1.28rem;
            }

        .sidebar.collapsed .nav-text,
        .sidebar.collapsed .icon-arrow,
        .sidebar.collapsed .sidebar-badge,
        .sidebar.collapsed .submenu {
            display: none !important;
        }

        .sidebar.collapsed .nav-left {
            justify-content: center;
        }

        /* ==============================
                           MAIN WRAPPER
                        ============================== */
        .wrapper {
            margin-left: var(--sidebar-w);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: var(--transition);
        }

            .wrapper.expanded {
                margin-left: var(--sidebar-w-mini);
            }

        .topbar {
            height: var(--header-h);
            background: rgba(255,255,255,.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid #e2e8f0;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .btn-toggle {
            background: #fff;
            border: 1px solid #e2e8f0;
            color: #475569;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: .2s ease;
        }

            .btn-toggle:hover {
                background: #f1f5f9;
                color: var(--accent);
            }

        .page-heading h5 {
            font-size: 1.08rem;
            font-weight: 900;
            color: #0f172a;
        }

        .page-heading small {
            color: #64748b;
            font-weight: 600;
        }

        .global-search {
            width: 360px;
        }

            .global-search .input-group-text {
                background: #f1f5f9;
                border: 1px solid #e2e8f0;
                border-right: none;
                color: #64748b;
            }

            .global-search .form-control {
                background: #f1f5f9;
                border: 1px solid #e2e8f0;
                border-left: none;
                font-size: .9rem;
                font-weight: 600;
                box-shadow: none !important;
            }

            .global-search:focus-within .input-group-text,
            .global-search:focus-within .form-control {
                background: #fff;
                border-color: #cbd5e1;
            }

        .top-icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: .2s ease;
        }

            .top-icon-btn:hover {
                background: #f8fafc;
                color: var(--accent);
            }

        .page-content {
            padding: 24px;
            flex: 1;
        }

        .user-menu-name {
            line-height: 1;
            color: #0f172a;
            font-size: .95rem;
            font-weight: 900;
            max-width: 160px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .role-label {
            font-size: .66rem;
            font-weight: 900;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .bell-shake {
            animation: shake 1.5s infinite cubic-bezier(.36,.07,.19,.97) both;
        }

        @@keyframes shake {
            10%, 90% {
                transform: translate3d(-1px, 0, 0) rotate(-5deg);
            }

            20%, 80% {
                transform: translate3d(2px, 0, 0) rotate(5deg);
            }

            30%, 50%, 70% {
                transform: translate3d(-3px, 0, 0) rotate(-10deg);
            }

            40%, 60% {
                transform: translate3d(3px, 0, 0) rotate(10deg);
            }
        }

        /* ==============================
                           MOBILE
                        ============================== */
        @@media (max-width: 991.98px) {
            .sidebar {
                transform: translateX(-100%);
                width: 286px !important;
            }

                .sidebar.mobile-show {
                    transform: translateX(0);
                    box-shadow: 10px 0 35px rgba(0,0,0,.45);
                }

            .wrapper,
            .wrapper.expanded {
                margin-left: 0;
                width: 100%;
            }

            .global-search {
                display: none !important;
            }

            .sidebar.collapsed .menu-title,
            .sidebar.collapsed .nav-text,
            .sidebar.collapsed .icon-arrow,
            .sidebar.collapsed .submenu {
                display: block !important;
                opacity: 1;
                height: auto;
            }

            .sidebar.collapsed .sidebar-badge {
                display: inline-block !important;
            }

            .sidebar.collapsed .nav-link-custom {
                justify-content: space-between;
                padding: 10px 12px;
            }

                .sidebar.collapsed .nav-link-custom i.icon-main {
                    margin-right: 10px;
                    font-size: 1.15rem;
                }

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.5);
                z-index: 1035;
                backdrop-filter: blur(2px);
            }

                .sidebar-overlay.show {
                    display: block;
                }

            .topbar {
                padding: 0 14px;
            }

            .page-content {
                padding: 16px;
            }
        }

        @@media (max-width: 575.98px) {
            .page-heading {
                display: none;
            }

            .topbar {
                gap: 10px;
            }

            .top-actions {
                gap: 8px !important;
            }

            .user-menu-name {
                max-width: 100px;
            }
        }

        .admin-noti-dropdown {
            width: 390px;
            max-width: calc(100vw - 24px);
            border-radius: 18px;
            overflow: hidden;
        }

        .admin-noti-head {
            background: linear-gradient(135deg, var(--accent), @(isAdmin ? "#2563eb" : "#059669") );
            color: #fff;
            padding: 14px 16px;
        }

        .admin-noti-title {
            font-size: .96rem;
            font-weight: 900;
            margin: 0;
            letter-spacing: -.01em;
        }

        .admin-noti-sub {
            font-size: .76rem;
            opacity: .85;
            font-weight: 600;
            margin-top: 2px;
        }

        .admin-noti-list {
            max-height: 430px;
            overflow-y: auto;
            background: #fff;
        }

            .admin-noti-list::-webkit-scrollbar {
                width: 5px;
            }

            .admin-noti-list::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 999px;
            }

        .admin-noti-item {
            display: flex;
            gap: 11px;
            padding: 12px 14px;
            color: #334155;
            border-bottom: 1px solid #f1f5f9;
            text-decoration: none;
            transition: .18s ease;
            position: relative;
        }

            .admin-noti-item:hover {
                background: #f8fafc;
                color: #0f172a;
            }

            .admin-noti-item.unread {
                background: #eff6ff;
            }

                .admin-noti-item.unread::before {
                    content: "";
                    width: 7px;
                    height: 7px;
                    border-radius: 999px;
                    background: #ef4444;
                    position: absolute;
                    top: 15px;
                    right: 14px;
                }

        .admin-noti-icon {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1rem;
        }

            .admin-noti-icon.system {
                background: #dbeafe;
                color: #2563eb;
            }

            .admin-noti-icon.success {
                background: #dcfce7;
                color: #059669;
            }

            .admin-noti-icon.danger {
                background: #fee2e2;
                color: #dc2626;
            }

            .admin-noti-icon.appointment {
                background: #ecfdf5;
                color: #059669;
            }

            .admin-noti-icon.customer {
                background: #e0f2fe;
                color: #0284c7;
            }

            .admin-noti-icon.action {
                background: #fef3c7;
                color: #d97706;
            }

        .admin-noti-body {
            min-width: 0;
            flex: 1;
            padding-right: 12px;
        }

        .admin-noti-name {
            color: #0f172a;
            font-size: .84rem;
            font-weight: 850;
            line-height: 1.35;
            margin-bottom: 3px;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .admin-noti-text {
            color: #64748b;
            font-size: .76rem;
            line-height: 1.45;
            font-weight: 600;
            margin-bottom: 5px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .admin-noti-time {
            color: #94a3b8;
            font-size: .7rem;
            font-weight: 700;
        }

        .admin-noti-empty {
            padding: 34px 18px;
            text-align: center;
            color: #64748b;
            font-size: .86rem;
            font-weight: 650;
        }

            .admin-noti-empty i {
                display: block;
                font-size: 2.1rem;
                margin-bottom: 8px;
            }

        .admin-noti-footer {
            background: #f8fafc;
            padding: 10px;
            border-top: 1px solid #e2e8f0;
        }

            .admin-noti-footer .btn {
                border-radius: 999px;
                font-weight: 850;
                font-size: .82rem;
            }

        @@media (max-width: 575.98px) {
            .admin-noti-dropdown {
                width: calc(100vw - 18px);
            }

            .admin-noti-list {
                max-height: 360px;
            }
        }

    </style>
</head>

<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="sidebar" id="sidebar">
        <a href="@dashboardLink" class="sidebar-brand">
            <span class="brand-icon">
                <i class="bi @(isAdmin ? "bi-hexagon-fill" : "bi-person-badge-fill")"></i>
            </span>
            <span class="brand-copy">
                <span class="brand-title">@brandText</span>
                <span class="brand-subtitle">BĐS Khánh Hòa</span>
            </span>
        </a>

        <div class="sidebar-menu">

            <div class="menu-title">Giám sát hệ thống</div>

            <li class="nav-item">
                <a href="@dashboardLink"
                   class="nav-link-custom @((currentController == "Dashboard" || currentController == "StaffDashboard") ? "active" : "")">
                    <div class="nav-left">
                        <i class="bi bi-grid-1x2-fill icon-main @(isAdmin ? "text-primary" : "text-success")"></i>
                        <span class="nav-text">Bảng điều khiển</span>
                    </div>
                </a>
            </li>

            @if (isAdmin)
            {
                <li class="nav-item">
                    <a href="/Admin/AuditLogs/Index"
                       class="nav-link-custom @(currentController == "AuditLogs" ? "active" : "")">
                        <div class="nav-left">
                            <i class="bi bi-terminal-fill icon-main text-secondary"></i>
                            <span class="nav-text">Nhật ký hệ thống</span>
                        </div>
                    </a>
                </li>
            }

            @if (isAdmin)
            {
                <div class="menu-title mt-2">Nghiệp vụ cốt lõi</div>

                <li class="nav-item">
                    <a class="nav-link-custom" data-bs-toggle="collapse" href="#menuBusiness" role="button">
                        <div class="nav-left">
                            <i class="bi bi-buildings-fill icon-main text-info"></i>
                            <span class="nav-text">Đối tác & Dự án</span>
                        </div>

                        <div class="d-flex align-items-center">
                            @if (totalBusinessTasks > 0)
                            {
                                <span class="badge bg-danger rounded-pill sidebar-badge me-2">@totalBusinessTasks</span>
                            }
                            <i class="bi bi-chevron-right icon-arrow"></i>
                        </div>
                    </a>

                    <ul class="collapse submenu" id="menuBusiness">
                        <li>
                            <a href="/Admin/AdminBusinessProfile/Index" class="nav-link-custom">
                                <span class="nav-text">
                                    <i class="bi bi-shield-check me-2 text-muted"></i>
                                    Quản lý Pháp nhân
                                </span>

                                @if (pendingBusiness > 0)
                                {
                                    <span class="badge bg-danger rounded-pill sidebar-badge">@pendingBusiness</span>
                                }
                            </a>
                        </li>

                        <li>
                            <a href="/Admin/AdminProject/Index" class="nav-link-custom">
                                <span class="nav-text">
                                    <i class="bi bi-kanban me-2 text-muted"></i>
                                    Duyệt & Quản lý Dự án
                                </span>

                                @if (pendingProjects > 0)
                                {
                                    <span class="badge bg-danger rounded-pill sidebar-badge">@pendingProjects</span>
                                }
                            </a>
                        </li>

                        <li>
                            <a href="/Admin/SupportTickets/Index" class="nav-link-custom">
                                <span class="nav-text">
                                    <i class="bi bi-life-preserver me-2 text-muted"></i>
                                    Yêu cầu từ CĐT
                                </span>
                            </a>
                        </li>

