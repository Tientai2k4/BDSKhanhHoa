    <script>
        $(document).ready(function () {
            const isUserAdmin = @isAdmin.ToString().ToLower();
            const isUserStaff = @isStaff.ToString().ToLower();
            const dashLink = '@dashboardLink';

            const sidebar = $('#sidebar');
            const wrapper = $('#wrapper');
            const overlay = $('#sidebarOverlay');

            $('#btnToggleSidebar').on('click', function () {
                if ($(window).width() >= 992) {
                    sidebar.toggleClass('collapsed');
                    wrapper.toggleClass('expanded');

                    const icon = $(this).find('i');

                    if (sidebar.hasClass('collapsed')) {
                        icon.removeClass('bi-text-indent-right').addClass('bi-text-indent-left');
                        $('.submenu.show').collapse('hide');
                    } else {
                        icon.removeClass('bi-text-indent-left').addClass('bi-text-indent-right');
                    }
                } else {
                    sidebar.toggleClass('mobile-show');
                    overlay.toggleClass('show');
                }
            });

            overlay.on('click', function () {
                sidebar.removeClass('mobile-show');
                overlay.removeClass('show');
            });

                 // ==============================
        // GIỮ ĐÚNG VỊ TRÍ MENU ADMIN ĐANG CHỌN
        // Không cho sidebar tự nhảy về đầu / dashboard sau khi chuyển trang
        // ==============================
        // ==============================
        // GIỮ MENU ĐANG CHỌN - KHÔNG GIẬT
        // Chỉ mở submenu cha và đưa item active vào vùng nhìn thấy
        // ==============================
        const sidebarMenu = $('.sidebar-menu');

        // 1. Mở submenu cha nếu item con đang active
        $('.sidebar-menu .nav-link-custom.active').each(function () {
            const parentCollapse = $(this).closest('.collapse');

            if (parentCollapse.length > 0) {
                parentCollapse.addClass('show');

                const parentToggle = parentCollapse.prev('.nav-link-custom');
                parentToggle.attr('aria-expanded', 'true');
            }
        });



        function getBellIcon(type) {
            switch ((type || '').toLowerCase()) {
                case 'success':
                    return 'bi bi-check-circle-fill';

                case 'danger':
                    return 'bi bi-shield-fill-x';

                case 'appointment':
                    return 'bi bi-calendar2-check-fill';

                case 'customer':
                    return 'bi bi-headset';

                case 'action':
                    return 'bi bi-exclamation-triangle-fill';

                case 'system':
                default:
                    return 'bi bi-info-circle-fill';
            }
        }

        function renderBellNotification(item) {
            const type = item.type || 'system';
            const icon = getBellIcon(type);
            const itemClass = item.isRead ? 'admin-noti-item' : 'admin-noti-item unread';
            const targetUrl = item.hasAction ? item.processUrl : item.detailsUrl;

            return `
                <a href="${targetUrl}" class="${itemClass}">
                    <span class="admin-noti-icon ${type}">
                        <i class="${icon}"></i>
                    </span>

                    <span class="admin-noti-body">
                        <span class="admin-noti-name">${escapeHtml(item.title)}</span>
                        <span class="admin-noti-text">${escapeHtml(item.content)}</span>
                        <span class="admin-noti-time">
                            <i class="bi bi-clock-history me-1"></i>
                            ${escapeHtml(item.createdAt)}
                        </span>
                    </span>
                </a>
            `;
        }

        function escapeHtml(value) {
            return (value || '')
                .toString()
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function fetchAdminNotifications() {
            $.ajax({
                url: '/Admin/Notification/GetBellNotifications',
                type: 'GET',
                success: function (res) {
                    const badge = $('#adminBellBadge');
                    const list = $('#adminBellList');
                    const bellIcon = $('#bellIcon');
                    const summary = $('#adminBellSummary');
                    const markAllBtn = $('#btnBellMarkAllRead');

                    list.empty();

                    if (!res || !res.success) {
                        badge.hide();
                        bellIcon.removeClass('bell-shake').css('color', '#64748b');
                        summary.text('Không thể tải thông báo.');
                        markAllBtn.prop('disabled', true);

                        list.append(`
                            <div class="admin-noti-empty">
                                <i class="bi bi-wifi-off text-danger"></i>
                                Không thể tải dữ liệu thông báo.
                            </div>
                        `);

                        return;
                    }

                    const unreadCount = Number(res.unreadCount || 0);
                    const totalCount = Number(res.totalCount || 0);
                    const items = Array.isArray(res.data) ? res.data : [];

                    if (unreadCount > 0) {
                        badge.show().text(unreadCount > 99 ? '99+' : unreadCount);
                        bellIcon.addClass('bell-shake').css('color', 'var(--accent)');
                        summary.text(`Bạn có ${unreadCount} thông báo chưa đọc trong tổng ${totalCount} thông báo.`);
                        markAllBtn.prop('disabled', false);
                    } else {
                        badge.hide();
                        bellIcon.removeClass('bell-shake').css('color', '#64748b');
                        summary.text(totalCount > 0 ? `Tất cả ${totalCount} thông báo đã được đọc.` : 'Hộp thư hệ thống đang trống.');
                        markAllBtn.prop('disabled', totalCount === 0);
                    }

                    if (items.length > 0) {
                        items.forEach(function (item) {
                            list.append(renderBellNotification(item));
                        });
                    } else {
                        list.append(`
                            <div class="admin-noti-empty">
                                <i class="bi bi-inbox-fill text-success"></i>
                                Chưa có thông báo nào trong hộp thư.
                            </div>
                        `);
                    }
                },
                error: function () {
                    const badge = $('#adminBellBadge');
                    const list = $('#adminBellList');
                    const bellIcon = $('#bellIcon');
                    const summary = $('#adminBellSummary');

                    badge.hide();
                    bellIcon.removeClass('bell-shake').css('color', '#64748b');
                    summary.text('Không thể kết nối máy chủ.');

                    list.empty().append(`
                        <div class="admin-noti-empty">
                            <i class="bi bi-wifi-off text-danger"></i>
                            Không thể kết nối máy chủ.
                        </div>
                    `);
                }
            });
        }

        $('#btnBellMarkAllRead').on('click', function () {
            const btn = $(this);
            const originalText = btn.html();
            const token = $('#adminBellMarkAllForm input[name="__RequestVerificationToken"]').val();

            btn.prop('disabled', true);
            btn.html('<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...');

            $.ajax({
                url: '/Admin/Notification/MarkAllAsRead',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    fetchAdminNotifications();
                    btn.html(originalText);
                },
                error: function () {
                    btn.prop('disabled', false);
                    btn.html(originalText);
                    alert('Không thể đánh dấu thông báo. Vui lòng thử lại.');
                }
            });
        });

        fetchAdminNotifications();
        setInterval(fetchAdminNotifications, 30000);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>