@{
    ViewData["Title"] = "Tổng quan công việc Nhân viên (Staff)";

    // Trỏ đúng vào thư mục Shared của Area Admin
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="fw-bold mb-1">Bảng điều khiển Nhân viên</h4>
            <p class="text-muted mb-0">Theo dõi tiến độ công việc và yêu cầu cần xử lý hôm nay.</p>
        </div>
    </div>

    <h6 class="fw-bold text-uppercase text-secondary mb-3"><i class="bi bi-shield-check me-2"></i>Nhiệm vụ Kiểm duyệt</h6>
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning me-3">
                        <i class="bi bi-house-add-fill fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 fw-medium">Tin rao chờ duyệt</p>
                        <h2 class="mb-0 fw-bolder text-dark">@ViewBag.PendingProperties</h2>
                    </div>
                </div>
                @if (ViewBag.PendingProperties > 0)
                {
                    <a href="/Admin/Properties/Verify" class="stretched-link"></a>
                    <div class="position-absolute bottom-0 start-0 w-100 bg-warning" style="height: 4px;"></div>
                }
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger me-3">
                        <i class="bi bi-flag-fill fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 fw-medium">Báo cáo vi phạm (Chờ xử lý)</p>
                        <h2 class="mb-0 fw-bolder text-dark">@ViewBag.PendingReports</h2>
                    </div>
                </div>
                @if (ViewBag.PendingReports > 0)
                {
                    <a href="/Admin/PropertyReports/Index" class="stretched-link"></a>
                    <div class="position-absolute bottom-0 start-0 w-100 bg-danger" style="height: 4px;"></div>
                }
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success me-3">
                        <i class="bi bi-check-circle-fill fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 fw-medium">Tổng tin đăng an toàn</p>
                        <h2 class="mb-0 fw-bolder text-dark">@ViewBag.TotalProperties</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h6 class="fw-bold text-uppercase text-secondary mb-3 mt-5"><i class="bi bi-headset me-2"></i>Hỗ trợ & Chăm sóc khách hàng</h6>
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info me-3">
                        <i class="bi bi-chat-dots-fill fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 fw-medium">Yêu cầu Tư vấn mới</p>
                        <h2 class="mb-0 fw-bolder text-dark">@ViewBag.PendingConsultations</h2>
                    </div>
                </div>
                @if (ViewBag.PendingConsultations > 0)
                {
                    <a href="/Admin/Consultations/Index" class="stretched-link"></a>
                    <div class="position-absolute bottom-0 start-0 w-100 bg-info" style="height: 4px;"></div>
                }
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 position-relative overflow-hidden">
                <div class="card-body d-flex align-items-center p-4">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary me-3">
                        <i class="bi bi-envelope-paper-fill fs-2"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1 fw-medium">Phản hồi cần giải đáp</p>
                        <h2 class="mb-0 fw-bolder text-dark">@ViewBag.PendingContacts</h2>
                    </div>
                </div>
                @if (ViewBag.PendingContacts > 0)
                {
                    <a href="/Admin/Contact/Index" class="stretched-link"></a>
                    <div class="position-absolute bottom-0 start-0 w-100 bg-primary" style="height: 4px;"></div>
                }
            </div>
        </div>
    </div>

    <h6 class="fw-bold text-uppercase text-secondary mb-3 mt-5"><i class="bi bi-megaphone me-2"></i>Nội dung truyền thông</h6>
    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-10 p-3 rounded-3 text-secondary me-3">
                            <i class="bi bi-newspaper fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 fw-medium">Tổng bài viết (Blog)</p>
                            <h3 class="mb-0 fw-bolder text-dark">@ViewBag.TotalBlogs</h3>
                        </div>
                    </div>
                    <a href="/Admin/Blog/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Quản lý</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-10 p-3 rounded-3 text-secondary me-3">
                            <i class="bi bi-images fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted mb-1 fw-medium">Banner đang kích hoạt</p>
                            <h3 class="mb-0 fw-bolder text-dark">@ViewBag.ActiveBanners</h3>
                        </div>
                    </div>
                    <a href="/Admin/Banners/Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Quản lý</a>
                </div>
            </div>
        </div>
    </div>
</div>