@model IEnumerable<BDSKhanhHoa.Models.AuditLog>
@using System.Globalization

@{
    ViewData["Title"] = "Nhật ký hệ thống";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    int totalLogs = ViewBag.TotalLogs ?? 0;
    int todayLogs = ViewBag.TodayLogs ?? 0;
    int dangerLogs = ViewBag.DangerLogs ?? 0;
    int authLogs = ViewBag.AuthLogs ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string keyword = ViewBag.Keyword as string ?? "";
    string module = ViewBag.Module as string ?? "";
    string severity = ViewBag.Severity as string ?? "";
    string dateRange = ViewBag.DateRange as string ?? "all";

    var moduleOptions = ViewBag.ModuleOptions as IEnumerable<string> ?? Enumerable.Empty<string>();

    string SeverityClass(string? value)
    {
        return value switch
        {
            "Critical" => "bg-dark text-white border-dark",
            "Danger" => "bg-danger bg-opacity-10 text-danger border-danger",
            "Warning" => "bg-warning bg-opacity-10 text-warning-emphasis border-warning",
            _ => "bg-info bg-opacity-10 text-info-emphasis border-info"
        };
    }
}

<style>
    .audit-hero, .audit-panel {
        background: #fff;
        border-radius: 24px;
        border: 1px solid rgba(148,163,184,.16);
        box-shadow: 0 12px 30px rgba(15, 23, 42, .06);
    }

    .audit-hero {
        padding: 24px;
        margin-bottom: 24px;
    }

    .audit-title {
        font-size: 1.5rem;
        font-weight: 900;
        margin-bottom: 4px;
        letter-spacing: -0.03em;
        color: #0f172a;
    }

    .audit-subtitle {
        color: #64748b;
        margin-bottom: 0;
    }

    .audit-stat {
        border-radius: 22px;
        padding: 20px;
        color: #fff;
        min-height: 120px;
        background: linear-gradient(135deg, #0f172a, #1e293b);
        box-shadow: 0 12px 30px rgba(15, 23, 42, .08);
        position: relative;
        overflow: hidden;
    }

        .audit-stat .label {
            font-size: .8rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .85;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .audit-stat .value {
            font-size: 2.5rem;
            line-height: 1;
            font-weight: 900;
        }

        .audit-stat i {
            position: absolute;
            right: -10px;
            bottom: -10px;
            font-size: 6rem;
            opacity: 0.1;
        }

    .soft-input {
        min-height: 48px;
        border-radius: 14px;
        border: 1px solid #dbe3ef;
        font-weight: 600;
        color: #334155;
    }

    .table thead th {
        background: #f8fafc;
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        color: #475569;
        white-space: nowrap;
        padding: 16px;
        border-bottom: 2px solid #e2e8f0;
    }

    .table tbody td {
        padding: 16px;
        vertical-align: middle;
        border-bottom: 1px dashed #e2e8f0;
    }

    .user-pill {
        background: #eff6ff;
        color: #1d4ed8;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: .8rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .module-pill {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #cbd5e1;
        display: inline-flex;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .log-row:hover {
        background: #fafcff;
    }

    .page-link {
        border-radius: 12px !important;
        font-weight: 800;
        margin: 0 4px;
    }
</style>

<div class="audit-hero d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <div class="audit-title"><i class="bi bi-shield-check text-primary me-2"></i>Nhật ký hệ thống & Kiểm toán</div>
        <p class="audit-subtitle">Theo dõi truy vết toàn diện mọi hành vi tương tác dữ liệu trên toàn bộ hệ thống.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="@Url.Action("ExportCsv", "AuditLogs", new { keyword, module, severity, dateRange })" class="btn btn-success rounded-pill fw-bold shadow-sm d-flex align-items-center px-4 py-2">
            <i class="bi bi-file-earmark-excel-fill me-2"></i> Xuất File Kiểm Toán
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6"><div class="audit-stat"><div class="label">Tổng số sự kiện</div><div class="value">@totalLogs.ToString("N0")</div><i class="bi bi-database"></i></div></div>
    <div class="col-xl-3 col-md-6"><div class="audit-stat"><div class="label">Cảnh báo nghiêm trọng</div><div class="value text-danger">@dangerLogs.ToString("N0")</div><i class="bi bi-shield-x"></i></div></div>
    <div class="col-xl-3 col-md-6"><div class="audit-stat"><div class="label">Sự kiện hôm nay</div><div class="value text-info">@todayLogs.ToString("N0")</div><i class="bi bi-calendar-event"></i></div></div>
    <div class="col-xl-3 col-md-6"><div class="audit-stat"><div class="label">Đăng nhập / User</div><div class="value text-warning">@authLogs.ToString("N0")</div><i class="bi bi-person-bounding-box"></i></div></div>
</div>

<div class="audit-panel p-3 p-md-4 mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end mb-4 border-bottom pb-4">
        <div class="col-xl-2 col-md-4">
            <label class="form-label fw-bold small text-muted text-uppercase">Thời gian</label>
            <select name="dateRange" class="form-select soft-input">
                <option value="all" selected="@(dateRange == "all")">Tất cả</option>
                <option value="today" selected="@(dateRange == "today")">Hôm nay</option>
                <option value="week" selected="@(dateRange == "week")">7 ngày qua</option>
                <option value="month" selected="@(dateRange == "month")">Tháng này</option>
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="form-label fw-bold small text-muted text-uppercase">Phân khu (Module)</label>
            <select name="module" class="form-select soft-input">
                <option value="">-- Tất cả --</option>
                @foreach (var opt in moduleOptions)
                {
                    <option value="@opt" selected="@(module == opt)">@opt</option>
                }
            </select>
        </div>
        <div class="col-xl-2 col-md-4">
            <label class="form-label fw-bold small text-muted text-uppercase">Mức độ</label>
            <select name="severity" class="form-select soft-input">
                <option value="">-- Tất cả --</option>
                <option value="Info" selected="@(severity == "Info")">Info</option>
                <option value="Warning" selected="@(severity == "Warning")">Warning</option>
                <option value="Danger" selected="@(severity == "Danger")">Danger</option>
                <option value="Critical" selected="@(severity == "Critical")">Critical</option>
            </select>
        </div>
        <div class="col-xl-4 col-md-8">
            <label class="form-label fw-bold small text-muted text-uppercase">Tra cứu IP, Action, User...</label>
            <input type="text" name="keyword" value="@keyword" class="form-control soft-input" placeholder="Nhập từ khóa cần tìm..." />
        </div>
        <div class="col-xl-2 col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 rounded-14 fw-bold shadow-sm" style="height: 48px;"><i class="bi bi-funnel-fill me-1"></i> Lọc</button>
            <a asp-action="Index" class="btn btn-light border w-100 rounded-14 fw-bold d-flex align-items-center justify-content-center" style="height: 48px;" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Người thực hiện</th>
                    <th>Phân khu & IP</th>
                    <th>Nội dung sự kiện</th>
                    <th class="text-center">Mức độ</th>
                    <th class="text-end">Trích xuất</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="log-row">
                            <td>
                                <div class="fw-bold text-dark fs-6">@item.CreatedAt.ToString("HH:mm:ss")</div>
                                <div class="text-muted small fw-medium">@item.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                @if (item.User != null)
                                {
                                    <div class="user-pill mb-1"><i class="bi bi-person-circle"></i> @item.User.FullName</div>
                                    <div class="text-muted small ms-2 fw-medium">ID: @item.UserID | Vai trò: @(item.User.RoleID == 1 ? "Admin" : item.User.RoleID == 2 ? "Staff" : "Member")</div>
                                }
                                else
                                {
                                    <div class="user-pill mb-1 bg-light text-muted border"><i class="bi bi-robot"></i> Hệ thống tự động</div>
                                }
                            </td>
                            <td>
                                <span class="module-pill mb-1 d-block w-fit-content">@(string.IsNullOrWhiteSpace(item.ModuleName) ? "System" : item.ModuleName)</span>
                                <div class="text-muted small fw-medium"><i class="bi bi-hdd-network me-1"></i>@(item.IPAddress ?? "Unknown IP")</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark mb-1">@item.Action</div>
                                <div class="text-muted small text-truncate" style="max-width: 250px;" title="@item.Target">
                                    Target: <span class="text-primary fw-bold">@(string.IsNullOrWhiteSpace(item.Target) ? "N/A" : item.Target)</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge border px-3 py-2 rounded-pill @SeverityClass(item.Severity)">@item.Severity</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.LogID" class="btn btn-sm btn-outline-primary rounded-pill fw-bold px-3 shadow-sm">Chi tiết</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-shield-check display-1 text-muted opacity-25 d-block mb-3"></i>
                            <h5 class="fw-bold text-dark">Dữ liệu trống</h5>
                            <p class="text-muted">Không tìm thấy bản ghi nhật ký nào khớp với bộ lọc.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="pt-4 mt-2">
            <nav class="d-flex justify-content-center">
                <ul class="pagination mb-0 flex-wrap">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, keyword, module, severity, dateRange })"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, keyword, module, severity, dateRange })">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link border-0">...</span></li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, keyword, module, severity, dateRange })"><i class="bi bi-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>