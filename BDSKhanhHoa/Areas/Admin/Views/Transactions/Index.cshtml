@model IEnumerable<BDSKhanhHoa.Models.Transaction>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tài chính & đối soát";

    var transactions = Model ?? Enumerable.Empty<BDSKhanhHoa.Models.Transaction>();

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal todayRevenue = ViewBag.TodayRevenue ?? 0m;
    decimal thisMonthRevenue = ViewBag.ThisMonthRevenue ?? 0m;
    decimal thisYearRevenue = ViewBag.ThisYearRevenue ?? 0m;

    int pendingCount = ViewBag.PendingCount ?? 0;
    int successCount = ViewBag.SuccessCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
    int totalTransactions = ViewBag.TotalTransactions ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentStatus = ViewBag.CurrentStatus as string ?? "All";
    string startDate = ViewBag.StartDate as string ?? "";
    string endDate = ViewBag.EndDate as string ?? "";

    string FormatMoney(decimal amount)
    {
        return amount.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " ₫";
    }

    string GetStatusText(string? status)
    {
        return status switch
        {
            "Success" => "Thành công",
            "Completed" => "Hoàn tất",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Failed" => "Thất bại",
            "Cancelled" => "Đã hủy",
            null or "" => "Chưa xác định",
            _ => status
        };
    }

    string GetStatusClass(string? status)
    {
        return status switch
        {
            "Success" => "status-success",
            "Completed" => "status-success",
            "Pending" => "status-pending",
            "Rejected" => "status-danger",
            "Failed" => "status-danger",
            "Cancelled" => "status-muted",
            _ => "status-muted"
        };
    }

    string GetStatusIcon(string? status)
    {
        return status switch
        {
            "Success" => "bi-check-circle-fill",
            "Completed" => "bi-check-circle-fill",
            "Pending" => "bi-hourglass-split",
            "Rejected" => "bi-x-circle-fill",
            "Failed" => "bi-x-circle-fill",
            "Cancelled" => "bi-slash-circle-fill",
            _ => "bi-info-circle-fill"
        };
    }

    string GetPaymentMethodText(string? paymentMethod)
    {
        return paymentMethod switch
        {
            "BankTransfer" => "Chuyển khoản",
            "Momo" => "Ví MoMo",
            "VNPay" => "VNPay",
            "Cash" => "Tiền mặt",
            "System Gift" => "Hệ thống tặng",
            "SePay" => "SePay",
            null or "" => "Chưa xác định",
            _ => paymentMethod
        };
    }

    string SafeAvatar(string? avatar)
    {
        return string.IsNullOrWhiteSpace(avatar) ? "/images/avatars/default-user.png" : avatar;
    }

    string GetCustomerName(BDSKhanhHoa.Models.Transaction item)
    {
        return item.User?.FullName ?? item.User?.Username ?? "Không rõ người dùng";
    }

    string GetCustomerPhone(BDSKhanhHoa.Models.Transaction item)
    {
        return string.IsNullOrWhiteSpace(item.User?.Phone) ? "Chưa có SĐT" : item.User.Phone;
    }

    string GetPackageName(BDSKhanhHoa.Models.Transaction item)
    {
        if (!string.IsNullOrWhiteSpace(item.Description))
        {
            return item.Description;
        }

        return item.Package?.PackageName ?? "Gói dịch vụ";
    }
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

