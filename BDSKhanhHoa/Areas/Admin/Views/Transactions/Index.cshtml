            font-size: .64rem;
            padding: 11px 8px;
        }

        .finance-table tbody td {
            padding: 12px 8px;
            font-size: .8rem;
        }

        .customer-avatar {
            width: 36px;
            height: 36px;
        }

        .customer-name {
            font-size: .8rem;
        }

        .customer-phone {
            font-size: .7rem;
        }

        .amount-text {
            font-size: .84rem;
        }

        .package-pill {
            font-size: .7rem;
            padding: 5px 7px;
        }

        .status-pill {
            font-size: .66rem;
            padding: 5px 7px;
        }

        .action-btn {
            width: 28px;
            height: 28px;
            border-radius: 10px;
            font-size: .78rem;
        }
    }

    @@media (max-width: 1199.98px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .finance-hero-inner {
            align-items: flex-start;
            flex-direction: column;
        }

        .hero-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .mini-stat-row {
            grid-template-columns: 1fr;
        }

        .desktop-table-wrap {
            display: none;
        }

        .mobile-list {
            display: block;
            padding: 14px;
            background: #f8fafc;
        }
    }

    @@media (max-width: 575.98px) {
        .finance-page {
            padding: 12px;
        }

        .finance-hero {
            border-radius: 22px;
            padding: 16px;
        }

        .finance-title-wrap {
            align-items: flex-start;
        }

        .finance-hero-icon {
            width: 50px;
            height: 50px;
            border-radius: 18px;
            font-size: 1.38rem;
        }

        .finance-subtitle {
            font-size: .84rem;
        }

        .hero-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

        .hero-btn {
            width: 100%;
        }

        .kpi-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .kpi-card {
            min-height: 124px;
            padding: 16px;
            border-radius: 20px;
        }

        .panel-head,
        .filter-body,
        .chart-wrap {
            padding-left: 14px;
            padding-right: 14px;
        }

        .chart-container {
            height: 240px;
        }

        .reset-btn {
            width: 100%;
        }

        .transaction-card-head {
            display: grid;
            grid-template-columns: 1fr;
        }

        .mobile-amount {
            text-align: left;
        }

        .mobile-actions {
            grid-template-columns: 1fr;
        }

        .mobile-action-btn {
            width: 100%;
        }
    }

    @@media print {
        .hero-actions,
        .filter-card,
        .action-group,
        .mobile-actions,
        .pagination-wrap,
        .chart-panel {
            display: none !important;
        }

        .finance-page {
            background: #fff !important;
            padding: 0 !important;
        }

        .panel-card,
        .finance-hero,
        .kpi-card,
        .mini-stat {
            box-shadow: none !important;
        }

        .desktop-table-wrap {
            display: block !important;
        }

        .mobile-list {
            display: none !important;
        }
    }
</style>

<div class="finance-page">
    <div class="finance-container">

        @if (TempData["Success"] != null)
        {
            <script>
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Success"]?.ToString() ?? ""))',
                    showConfirmButton: false,
                    timer: 3200,
                    timerProgressBar: true
                });
            </script>
        }

        @if (TempData["Error"] != null)
        {
            <script>
                Swal.fire({
                    icon: 'error',
                    title: 'Không thể thực hiện',
                    text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(TempData["Error"]?.ToString() ?? ""))',
                    confirmButtonText: 'Đã hiểu',
                    confirmButtonColor: '#2563eb'
                });
            </script>
        }

        <section class="finance-hero">
            <div class="finance-hero-inner">
                <div class="finance-title-wrap">
                    <div class="finance-hero-icon">
                        <i class="bi bi-bank2"></i>
                    </div>

                    <div>
                        <h1 class="finance-title">Tài chính & đối soát</h1>
                        <p class="finance-subtitle">
                            Theo dõi doanh thu, kiểm tra biên lai, duyệt thanh toán và quản lý hồ sơ giao dịch.
                        </p>
                    </div>
                </div>

                <div class="hero-actions">
                    <button type="button" class="hero-btn hero-btn-light" onclick="window.print()">
                        <i class="bi bi-printer-fill"></i>
                        In trang
                    </button>

                    <a href="@Url.Action("ExportCsv", new { searchString = currentSearch, statusFilter = currentStatus, startDate = startDate, endDate = endDate })"
                       class="hero-btn hero-btn-success">
                        <i class="bi bi-file-earmark-excel-fill"></i>
                        Xuất Excel
                    </a>
                </div>
            </div>
        </section>

        <section class="mini-stat-row">
            <div class="mini-stat">
                <div>
                    <div class="mini-stat-label">Tổng hồ sơ</div>
                    <div class="mini-stat-value">@totalTransactions.ToString("N0")</div>
                </div>
                <i class="bi bi-receipt-cutoff text-primary fs-3"></i>
            </div>

            <div class="mini-stat">
                <div>
                    <div class="mini-stat-label">Chờ duyệt</div>
                    <div class="mini-stat-value text-warning">@pendingCount.ToString("N0")</div>
                </div>
                <i class="bi bi-hourglass-split text-warning fs-3"></i>
            </div>

            <div class="mini-stat">
                <div>
                    <div class="mini-stat-label">Bị từ chối</div>
                    <div class="mini-stat-value text-danger">@rejectedCount.ToString("N0")</div>
                </div>
                <i class="bi bi-x-circle-fill text-danger fs-3"></i>
            </div>
        </section>

        <section class="kpi-grid">
            <article class="kpi-card grad-day">
                <div class="kpi-label">
                    <i class="bi bi-lightning-charge-fill"></i>
                    Doanh thu hôm nay
                </div>
                <h2 class="kpi-value">@FormatMoney(todayRevenue)</h2>
                <div class="kpi-desc">
                    <i class="bi bi-arrow-repeat"></i>
                    Theo giao dịch đã duyệt
                </div>
                <i class="bi bi-lightning-charge-fill kpi-icon-bg"></i>
            </article>

            <article class="kpi-card grad-month">
                <div class="kpi-label">
                    <i class="bi bi-calendar-month-fill"></i>
                    Doanh thu tháng này
                </div>
                <h2 class="kpi-value">@FormatMoney(thisMonthRevenue)</h2>
                <div class="kpi-desc">
                    <i class="bi bi-calendar-check"></i>
                    Tháng @DateTime.Now.Month/@DateTime.Now.Year
                </div>
                <i class="bi bi-wallet2 kpi-icon-bg"></i>
            </article>

            <article class="kpi-card grad-year">
                <div class="kpi-label">
                    <i class="bi bi-bar-chart-fill"></i>
                    Doanh thu năm @DateTime.Now.Year
                </div>
                <h2 class="kpi-value">@FormatMoney(thisYearRevenue)</h2>
                <div class="kpi-desc">
                    <i class="bi bi-graph-up-arrow"></i>
                    Tổng doanh thu trong năm
                </div>
                <i class="bi bi-pie-chart-fill kpi-icon-bg"></i>
            </article>

            <article class="kpi-card grad-total">
                <div class="kpi-label">
                    <i class="bi bi-safe-fill"></i>
                    Tổng lũy kế
                </div>
                <h2 class="kpi-value">@FormatMoney(totalRevenue)</h2>
                <div class="kpi-desc">
                    <i class="bi bi-check-circle-fill"></i>
                    @successCount.ToString("N0") giao dịch thành công
                </div>
                <i class="bi bi-cash-coin kpi-icon-bg"></i>
            </article>
        </section>

        <section class="panel-card chart-panel">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">
                        <i class="bi bi-activity text-primary"></i>
                        Phân tích dòng tiền
                    </h2>
                    <p class="panel-subtitle">Biểu đồ doanh thu 30 ngày gần nhất.</p>
                </div>

                <span class="status-pill status-success">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Doanh thu</span>
                </span>
            </div>

            <div class="chart-wrap">
                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </section>

        <section class="panel-card filter-card">
            <div class="panel-head">
                <div>
                    <h2 class="panel-title">
                        <i class="bi bi-funnel-fill text-primary"></i>
                        Bộ lọc giao dịch
                    </h2>
                    <p class="panel-subtitle">Tìm kiếm theo mã giao dịch, người dùng, số điện thoại, trạng thái và thời gian.</p>
                </div>
            </div>

            <div class="filter-body">
                <form method="get" asp-action="Index" id="filterForm">
                    <div class="row g-3 align-items-end">
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <label class="filter-label">Từ khóa</label>
                            <input type="text"
                                   name="searchString"
                                   value="@currentSearch"
                                   class="form-control soft-input"
                                   placeholder="Mã GD, tên, SĐT..." />
                        </div>

                        <div class="col-xl-2 col-lg-4 col-md-6">
                            <label class="filter-label">Trạng thái</label>
                            <select name="statusFilter" class="form-select soft-input">
                                <option value="All" selected="@(currentStatus == "All" || string.IsNullOrEmpty(currentStatus))">Tất cả</option>
                                <option value="Pending" selected="@(currentStatus == "Pending")">Chờ duyệt (@pendingCount)</option>
                                <option value="Success" selected="@(currentStatus == "Success")">Thành công</option>
                                <option value="Rejected" selected="@(currentStatus == "Rejected")">Bị từ chối</option>
                            </select>
                        </div>

                        <div class="col-xl-2 col-lg-4 col-md-6">
                            <label class="filter-label">Từ ngày</label>
                            <input type="date"
                                   name="startDate"
                                   value="@startDate"
                                   class="form-control soft-input" />
                        </div>

                        <div class="col-xl-2 col-lg-4 col-md-6">
                            <label class="filter-label">Đến ngày</label>
                            <input type="date"
                                   name="endDate"
                                   value="@endDate"
                                   class="form-control soft-input" />
                        </div>

                        <div class="col-xl-3 col-lg-8 col-md-12">
                            <label class="filter-label d-none d-md-block">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-dark filter-btn flex-grow-1">
                                    <i class="bi bi-search me-1"></i>
                                    Lọc giao dịch
                                </button>

                                <a href="/Admin/Transactions/Index"
                                   class="btn btn-light border reset-btn"
                                   title="Đặt lại bộ lọc">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        <section class="panel-card">
            <div class="panel-head">
                <div class="table-toolbar">
                    <div>
                        <h2 class="panel-title">
                            <i class="bi bi-card-list text-primary"></i>
                            Danh sách giao dịch
                        </h2>
                        <p class="panel-subtitle">
                            Tổng cộng @totalTransactions.ToString("N0") hồ sơ giao dịch.
                        </p>
                    </div>

                    @if (pendingCount > 0)
                    {
                        <span class="pending-alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            Có @pendingCount.ToString("N0") hồ sơ chờ duyệt
                        </span>
                    }
                </div>
            </div>

            <div class="desktop-table-wrap">
                <table class="finance-table">
                    <thead>
                        <tr>
                            <th class="col-code">Mã GD</th>
                            <th class="col-user">Khách hàng</th>
                            <th class="col-amount">Số tiền</th>
                            <th class="col-service">Dịch vụ</th>
                            <th class="col-payment">Thanh toán</th>
                            <th class="col-time">Thời gian</th>
                            <th class="col-status">Trạng thái</th>
                            <th class="col-actions text-center">Nút</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (transactions.Any())
                        {
                            foreach (var item in transactions)
                            {
                                <tr>
                                    <td class="col-code">
                                        <span class="transaction-code" title="@item.TransactionCode">
                                            <i class="bi bi-hash"></i>
                                            <span>@item.TransactionCode</span>
                                        </span>
                                    </td>

                                    <td class="col-user">
                                        <div class="customer-box">
                                            <img src="@SafeAvatar(item.User?.Avatar)"
                                                 class="customer-avatar"
                                                 alt="@GetCustomerName(item)"
                                                 onerror="this.src='/images/avatars/default-user.png'" />

                                            <div style="min-width:0;">
                                                <span class="customer-name" title="@GetCustomerName(item)">
                                                    @GetCustomerName(item)
                                                </span>
                                                <span class="customer-phone" title="@GetCustomerPhone(item)">
                                                    <i class="bi bi-telephone me-1"></i>
                                                    @GetCustomerPhone(item)
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="col-amount">
                                        <span class="amount-text">
                                            + @FormatMoney(item.Amount)
                                        </span>
                                    </td>

                                    <td class="col-service">
                                        <span class="package-pill" title="@GetPackageName(item)">
                                            <i class="bi bi-gem"></i>
                                            <span>@GetPackageName(item)</span>
                                            <strong>x@(item.Quantity)</strong>
                                        </span>
                                    </td>

                                    <td class="col-payment">
                                        <span class="payment-text" title="@GetPaymentMethodText(item.PaymentMethod)">
                                            <i class="bi bi-credit-card-2-front"></i>
                                            @GetPaymentMethodText(item.PaymentMethod)
                                        </span>
                                    </td>

                                    <td class="col-time">
                                        <span class="time-main">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        <span class="time-sub">@item.CreatedAt.ToString("HH:mm")</span>
                                    </td>

                                    <td class="col-status">
                                        <span class="status-pill @GetStatusClass(item.Status)" title="@GetStatusText(item.Status)">
                                            <i class="bi @GetStatusIcon(item.Status)"></i>
                                            <span>@GetStatusText(item.Status)</span>
                                        </span>
                                    </td>

                                    <td class="col-actions text-center">
                                        @if (item.Status == "Pending")
                                        {
                                            <div class="action-group">
                                                @if (!string.IsNullOrWhiteSpace(item.BillImageUrl))
                                                {
                                                    <button type="button"
                                                            class="action-btn action-view"
                                                            title="Xem biên lai"
                                                            onclick="viewBill('@item.BillImageUrl')">
                                                        <i class="bi bi-image-fill"></i>
                                                    </button>
                                                }

                                                <button type="button"
                                                        class="action-btn action-approve"
                                                        title="Duyệt giao dịch"
                                                        onclick="confirmApprove('@item.TransactionCode', @item.Amount)">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>

                                                <button type="button"
                                                        class="action-btn action-reject"
                                                        title="Từ chối giao dịch"
                                                        onclick="confirmReject('@item.TransactionCode')">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="locked-pill" title="Giao dịch đã xử lý">
                                                <i class="bi bi-lock-fill"></i>
                                                Khóa
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="empty-icon">
                                            <i class="bi bi-folder-x"></i>
                                        </div>
                                        <h3 class="empty-title">Không có giao dịch</h3>
                                        <p class="empty-desc">Không tìm thấy dữ liệu giao dịch nào khớp với bộ lọc hiện tại.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mobile-list">
                @if (transactions.Any())
                {
                    foreach (var item in transactions)
                    {
                        <article class="transaction-card">
                            <div class="transaction-card-head">
                                <div>
                                    <span class="mobile-code" title="@item.TransactionCode">
                                        <i class="bi bi-hash"></i>
                                        @item.TransactionCode
                                    </span>

                                    <div class="mt-2">
                                        <span class="status-pill @GetStatusClass(item.Status)">
                                            <i class="bi @GetStatusIcon(item.Status)"></i>
                                            <span>@GetStatusText(item.Status)</span>
                                        </span>
                                    </div>
                                </div>

                                <div class="mobile-amount">
                                    + @FormatMoney(item.Amount)
                                </div>
                            </div>

                            <div class="mobile-row">
                                <span class="mobile-label">Khách hàng</span>
                                <div class="mobile-value">
                                    <div class="d-flex align-items-center justify-content-end gap-2">
                                        <div style="min-width:0;">
                                            <div class="fw-bold text-dark">@GetCustomerName(item)</div>
                                            <div class="small text-muted">@GetCustomerPhone(item)</div>
                                        </div>
                                        <img src="@SafeAvatar(item.User?.Avatar)"
                                             width="38"
                                             height="38"
                                             class="rounded-circle border"
                                             style="object-fit:cover;"
                                             onerror="this.src='/images/avatars/default-user.png'" />
                                    </div>
                                </div>
                            </div>

                            <div class="mobile-row">
                                <span class="mobile-label">Dịch vụ</span>
                                <span class="mobile-value">
                                    @GetPackageName(item) x@(item.Quantity)
                                </span>
                            </div>

                            <div class="mobile-row">
                                <span class="mobile-label">Thanh toán</span>
                                <span class="mobile-value">
                                    @GetPaymentMethodText(item.PaymentMethod)
                                </span>
                            </div>

                            <div class="mobile-row">
                                <span class="mobile-label">Thời gian</span>
                                <span class="mobile-value">
                                    @item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                                </span>
                            </div>

                            @if (item.Status == "Pending")
                            {
                                <div class="mobile-actions">
                                    @if (!string.IsNullOrWhiteSpace(item.BillImageUrl))
                                    {
                                        <button type="button"
                                                class="mobile-action-btn action-view"
                                                onclick="viewBill('@item.BillImageUrl')">
                                            <i class="bi bi-image-fill"></i>
                                            Biên lai
                                        </button>
                                    }

                                    <button type="button"
                                            class="mobile-action-btn action-approve"
                                            onclick="confirmApprove('@item.TransactionCode', @item.Amount)">
                                        <i class="bi bi-check-lg"></i>
                                        Duyệt
                                    </button>

                                    <button type="button"
                                            class="mobile-action-btn action-reject"
                                            onclick="confirmReject('@item.TransactionCode')">
                                        <i class="bi bi-x-lg"></i>
                                        Từ chối
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="mt-3">
                                    <span class="locked-pill w-100 justify-content-center">
                                        <i class="bi bi-lock-fill"></i>
                                        Giao dịch đã xử lý, không thể thao tác thêm
                                    </span>
                                </div>
                            }
                        </article>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="bi bi-folder-x"></i>
                        </div>
                        <h3 class="empty-title">Không có giao dịch</h3>
                        <p class="empty-desc">Không tìm thấy dữ liệu giao dịch nào khớp với bộ lọc hiện tại.</p>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination-wrap">
                    <nav aria-label="Phân trang giao dịch">
                        <ul class="pagination flex-wrap mb-0 justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0)" onclick="changePage(@(currentPage - 1))">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link" href="javascript:void(0)" onclick="changePage(@i)">@i</a>
                                    </li>
                                }
                                else if (i == currentPage - 2 || i == currentPage + 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link border-0 bg-transparent">...</span>
                                    </li>
                                }
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" href="javascript:void(0)" onclick="changePage(@(currentPage + 1))">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </section>

        <form id="statusForm" asp-action="UpdateStatus" method="post" style="display:none;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="baseCode" id="formBaseCode" />
            <input type="hidden" name="status" id="formStatus" />
            <input type="hidden" name="adminNote" id="formAdminNote" />
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function changePage(page) {
            if (page < 1) {
                return;
            }

            let url = new URL(window.location.href);
            url.searchParams.set("page", page);
            window.location.href = url.toString();
        }

        function viewBill(imageUrl) {
            if (!imageUrl) {
                Swal.fire({
                    icon: 'info',
                    title: 'Chưa có biên lai',
                    text: 'Giao dịch này chưa có ảnh biên lai để xem.',
                    confirmButtonColor: '#2563eb'
                });
                return;
            }

            Swal.fire({
                title: 'Biên lai chuyển khoản',
                html: `
                    <div class="text-start">
                        <p class="mb-2 text-muted">
                            Vui lòng đối chiếu ảnh biên lai với sao kê ngân hàng trước khi duyệt giao dịch.
                        </p>
                    </div>
                `,
                imageUrl: imageUrl,
                imageAlt: 'Biên lai chuyển khoản',
                imageWidth: '100%',
                showCloseButton: true,
                confirmButtonText: '<i class="bi bi-check-circle"></i> Đóng',
                confirmButtonColor: '#2563eb',
                customClass: {
                    popup: 'rounded-4',
                    image: 'rounded-4 shadow-sm border mt-3'
                }
            });
        }

        function confirmApprove(baseCode, amount) {
            let formattedAmount = new Intl.NumberFormat('vi-VN', {
                style: 'currency',
                currency: 'VND'
            }).format(amount);

            Swal.fire({
                title: 'Duyệt giao dịch?',
                html: `
                    <div class="text-start">
                        <div class="alert alert-success rounded-4 mb-3">
                            <div class="fw-bold mb-1">Số tiền cần đối soát</div>
                            <div class="fs-4 fw-black text-success" style="font-weight:950;">${formattedAmount}</div>
                        </div>

                        <div class="mb-2">
                            Mã giao dịch: <strong>#${baseCode}</strong>
                        </div>

                        <div class="alert alert-warning rounded-4 mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            Chỉ duyệt khi đã chắc chắn tiền đã vào tài khoản. Sau khi duyệt, hệ thống sẽ cấp gói/lượt đăng tương ứng.
                        </div>
                    </div>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: '<i class="bi bi-check-circle-fill"></i> Đã nhận tiền & duyệt',
                cancelButtonText: 'Hủy',
                customClass: {
                    confirmButton: 'rounded-pill px-4',
                    cancelButton: 'rounded-pill px-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('formBaseCode').value = baseCode;
                    document.getElementById('formStatus').value = 'Success';
                    document.getElementById('formAdminNote').value = '';
                    document.getElementById('statusForm').submit();
                }
            });
        }

        function confirmReject(baseCode) {
            Swal.fire({
                title: 'Từ chối giao dịch',
                html: `
                    <div class="text-start">
                        <p class="text-muted mb-2">
                            Nhập lý do từ chối để người dùng biết cần bổ sung hoặc kiểm tra lại.
                        </p>
                    </div>
                `,
                input: 'textarea',
                inputPlaceholder: 'Ví dụ: Biên lai không hợp lệ, chưa nhận được tiền, sai số tiền chuyển khoản...',
                inputAttributes: {
                    maxlength: 500
                },
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: '<i class="bi bi-x-circle-fill"></i> Từ chối giao dịch',
                cancelButtonText: 'Hủy',
                customClass: {
                    confirmButton: 'rounded-pill px-4',
                    cancelButton: 'rounded-pill px-4',
                    input: 'rounded-4'
                },
                inputValidator: (value) => {
                    if (!value || !value.trim()) {
                        return 'Vui lòng nhập lý do từ chối.';
                    }

                    if (value.trim().length < 5) {
                        return 'Lý do từ chối quá ngắn, vui lòng nhập rõ hơn.';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('formBaseCode').value = baseCode;
                    document.getElementById('formStatus').value = 'Rejected';
                    document.getElementById('formAdminNote').value = result.value.trim();
                    document.getElementById('statusForm').submit();
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            const canvas = document.getElementById('revenueChart');

            if (!canvas) {
                return;
            }

            const rawLabels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
            const rawData = @Html.Raw(ViewBag.ChartValues ?? "[]");

            if (!Array.isArray(rawLabels) || !Array.isArray(rawData) || rawLabels.length === 0) {
                const parent = canvas.parentElement;
                parent.innerHTML = `
                    <div class="empty-state py-4">
                        <div class="empty-icon">
                            <i class="bi bi-bar-chart"></i>
                        </div>
                        <h3 class="empty-title">Chưa có dữ liệu biểu đồ</h3>
                        <p class="empty-desc">Khi có giao dịch thành công, biểu đồ doanh thu sẽ được hiển thị tại đây.</p>
                    </div>
                `;
                return;
            }

            const ctx = canvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 360);
            gradient.addColorStop(0, 'rgba(37, 99, 235, 0.32)');
            gradient.addColorStop(1, 'rgba(37, 99, 235, 0.02)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: rawLabels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: rawData,
                        borderColor: '#2563eb',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#2563eb',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        fill: true,
                        tension: 0.42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleColor: '#ffffff',
                            bodyColor: '#ffffff',
                            padding: 13,
                            cornerRadius: 12,
                            displayColors: false,
                            callbacks: {
                                label: function (context) {
                                    return new Intl.NumberFormat('vi-VN', {
                                        style: 'currency',
                                        currency: 'VND'
                                    }).format(context.parsed.y || 0);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#eef2f7',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#64748b',
                                font: {
                                    size: 12,
                                    weight: '600'
                                },
                                callback: function (value) {
                                    if (value >= 1000000000) {
                                        return (value / 1000000000) + ' tỷ';
                                    }

                                    if (value >= 1000000) {
                                        return (value / 1000000) + ' triệu';
                                    }

                                    if (value >= 1000) {
                                        return (value / 1000) + 'K';
                                    }

                                    return value;
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false,
                                drawBorder: false
                            },
                            ticks: {
                                color: '#64748b',
                                maxTicksLimit: 10,
                                font: {
                                    size: 12,
                                    weight: '600'
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}