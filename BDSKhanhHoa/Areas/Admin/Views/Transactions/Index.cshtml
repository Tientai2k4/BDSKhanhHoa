@model IEnumerable<BDSKhanhHoa.Models.Transaction>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Tài chính & đối soát";

    var transactions = Model ?? Enumerable.Empty<BDSKhanhHoa.Models.Transaction>();

    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal todayRevenue = ViewBag.TodayRevenue ?? 0m;
    decimal thisMonthRevenue = ViewBag.ThisMonthRevenue ?? 0m;
    decimal thisYearRevenue = ViewBag.ThisYearRevenue ?? 0m;

    int pendingCount = ViewBag.PendingCount ?? 0;
    int successCount = ViewBag.SuccessCount ?? 0;
    int rejectedCount = ViewBag.RejectedCount ?? 0;
    int totalTransactions = ViewBag.TotalTransactions ?? 0;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentStatus = ViewBag.CurrentStatus as string ?? "All";
    string startDate = ViewBag.StartDate as string ?? "";
    string endDate = ViewBag.EndDate as string ?? "";

    string FormatMoney(decimal amount) => amount.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " ₫";

    string GetStatusText(string? status)
    {
        return status switch
        {
            "Success" => "Thành công",
            "Completed" => "Hoàn tất",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Từ chối",
            "Failed" => "Thất bại",
            "Cancelled" => "Đã hủy",
            null or "" => "Chưa rõ",
            _ => status
        };
    }

    string GetStatusClass(string? status)
    {
        return status switch
        {
            "Success" or "Completed" => "ok",
            "Pending" => "wait",
            "Rejected" or "Failed" => "bad",
            _ => "muted"
        };
    }

    string GetStatusIcon(string? status)
    {
        return status switch
        {
            "Success" or "Completed" => "bi-check-circle-fill",
            "Pending" => "bi-hourglass-split",
            "Rejected" or "Failed" => "bi-x-circle-fill",
            "Cancelled" => "bi-slash-circle-fill",
            _ => "bi-info-circle-fill"
        };
    }

    string GetPaymentMethodText(string? paymentMethod)
    {
        return paymentMethod switch
        {
            "VNPay" => "VNPay",
            "PayOS" => "PayOS",
            "System Gift" => "Tặng",
            "BankTransfer" => "Đã tắt",
            "SePay" => "Đã tắt",
            "Cash" => "Đã tắt",
            null or "" => "Chưa rõ",
            _ => paymentMethod
        };
    }

    string SafeAvatar(string? avatar) => string.IsNullOrWhiteSpace(avatar) ? "/images/avatars/default-user.png" : avatar;
    string GetCustomerName(BDSKhanhHoa.Models.Transaction item) => item.User?.FullName ?? item.User?.Username ?? "Không rõ";
    string GetCustomerPhone(BDSKhanhHoa.Models.Transaction item) => string.IsNullOrWhiteSpace(item.User?.Phone) ? "Chưa có SĐT" : item.User.Phone;
    string GetPackageName(BDSKhanhHoa.Models.Transaction item) => !string.IsNullOrWhiteSpace(item.Description) ? item.Description : item.Package?.PackageName ?? "Gói dịch vụ";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    :root {
        --ad-bg: #f6f8fb;
        --ad-card: #fff;
        --ad-text: #0f172a;
        --ad-muted: #64748b;
        --ad-line: #e2e8f0;
        --ad-blue: #2563eb;
        --ad-green: #059669;
        --ad-red: #dc2626;
        --ad-yellow: #d97706;
        --ad-shadow: 0 8px 22px rgba(15, 23, 42, .055);
    }

    .finance-page {
        background: var(--ad-bg);
        min-height: auto;
        padding: 8px;
        overflow-x: hidden;
    }

    .topbar,
    .card-flat,
    .filter-box,
    .data-box {
        background: var(--ad-card);
        border: 1px solid rgba(148, 163, 184, .25);
        border-radius: 14px;
        box-shadow: var(--ad-shadow);
    }

    .topbar {
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
    }

    .title-line {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .title-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #60a5fa);
        flex: 0 0 auto;
        font-size: 1.2rem;
    }

    .page-title {
        margin: 0;
        color: var(--ad-text);
        font-size: clamp(1.28rem, 2.2vw, 1.85rem);
        font-weight: 950;
        letter-spacing: -.035em;
        line-height: 1.12;
    }

    .page-subtitle {
        margin: 4px 0 0;
        color: var(--ad-muted);
        font-weight: 650;
        font-size: .9rem;
    }

    .top-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        flex: 0 0 auto;
    }

    .btn-soft {
        min-height: 40px;
        border-radius: 999px;
        padding: 8px 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-weight: 900;
        white-space: nowrap;
        text-decoration: none;
    }

    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .kpi {
        min-width: 0;
        border-radius: 14px;
        padding: 12px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .kpi:after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -45px;
            bottom: -55px;
            border-radius: 50%;
            background: rgba(255,255,255,.17);
        }

        .kpi .label {
            display: flex;
            gap: 6px;
            align-items: center;
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            opacity: .92;
        }

        .kpi .value {
            position: relative;
            z-index: 1;
            margin: 10px 0 5px;
            font-size: clamp(1.05rem, 1.65vw, 1.5rem);
            font-weight: 950;
            letter-spacing: -.03em;
            line-height: 1.08;
            word-break: break-word;
        }

        .kpi .desc {
            position: relative;
            z-index: 1;
            font-size: .78rem;
            font-weight: 800;
            opacity: .9;
        }

    .g1 {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .g2 {
        background: linear-gradient(135deg, #10b981, #059669);
    }

    .g3 {
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
    }

    .g4 {
        background: linear-gradient(135deg, #6366f1, #4338ca);
    }

    .mini-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .mini {
        padding: 12px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-width: 0;
    }

        .mini .label {
            color: var(--ad-muted);
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .mini .value {
            margin-top: 3px;
            color: var(--ad-text);
            font-size: 1.2rem;
            font-weight: 950;
        }

    .chart-card {
        margin-bottom: 12px;
    }

    .card-head {
        padding: 13px 15px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .card-title {
        margin: 0;
        color: var(--ad-text);
        font-size: 1rem;
        font-weight: 950;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .card-subtitle {
        margin: 2px 0 0;
        color: var(--ad-muted);
        font-size: .78rem;
        font-weight: 650;
    }

    .chart-wrap {
        height: 250px;
        padding: 12px 14px 16px;
    }

    .filter-box {
        margin-bottom: 12px;
        overflow: hidden;
    }

    .filter-toggle {
        width: 100%;
        border: 0;
        background: #fff;
        padding: 14px 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 950;
        font-size: 1rem;
        color: var(--ad-text);
    }

    .filter-body {
        padding: 0 15px 15px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: minmax(180px, 1.4fr) 170px 150px 150px auto;
        gap: 9px;
        align-items: end;
    }

    .form-label-mini {
        margin-bottom: 5px;
        color: var(--ad-muted);
        font-size: .72rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .soft-input {
        min-height: 40px;
        border-radius: 12px;
        border: 1px solid #dbe4ef;
        background: #f8fafc;
        font-weight: 750;
        box-shadow: none !important;
    }

        .soft-input:focus {
            background: #fff;
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .09) !important;
        }

    .data-box {
        overflow: hidden;
    }

    .section-clean {
        margin-bottom: 12px;
    }

    .data-header {
        padding: 13px 15px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .pending-badge,
    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 999px;
        padding: 5px 9px;
        font-size: .72rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .pending-badge {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fde68a;
    }

    .status-pill.ok {
        color: #047857;
        background: #dcfce7;
        border: 1px solid #86efac;
    }

    .status-pill.wait {
        color: #b45309;
        background: #fef3c7;
        border: 1px solid #fde68a;
    }

    .status-pill.bad {
        color: #b91c1c;
        background: #fee2e2;
        border: 1px solid #fecaca;
    }

    .status-pill.muted {
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
    }

    .finance-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        margin: 0;
    }

        .finance-table th,
        .finance-table td {
            border-bottom: 1px solid #edf2f7;
            padding: 10px 8px;
            vertical-align: middle;
            min-width: 0;
            overflow: hidden;
        }

        .finance-table th {
            background: #f8fafc;
            color: var(--ad-muted);
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .035em;
            font-weight: 950;
            white-space: nowrap;
        }

        .finance-table td {
            color: #334155;
            font-size: .82rem;
        }

        .finance-table tr:hover td {
            background: #fbfdff;
        }

    .c-code {
        width: 12%;
    }

    .c-user {
        width: 19%;
    }

    .c-money {
        width: 12%;
    }

    .c-service {
        width: 22%;
    }

    .c-pay {
        width: 10%;
    }

    .c-time {
        width: 10%;
    }

    .c-status {
        width: 9%;
    }

    .c-act {
        width: 6%;
    }

    .code-pill,
