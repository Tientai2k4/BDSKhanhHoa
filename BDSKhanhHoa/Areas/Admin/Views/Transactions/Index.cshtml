@model IEnumerable<BDSKhanhHoa.Models.Transaction>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal todayRevenue = ViewBag.TodayRevenue ?? 0m;
    decimal thisMonthRevenue = ViewBag.ThisMonthRevenue ?? 0m;
    decimal thisYearRevenue = ViewBag.ThisYearRevenue ?? 0m;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int successCount = ViewBag.SuccessCount ?? 0;
    int totalTransactions = ViewBag.TotalTransactions ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    /* ========================================================
           TỔNG QUAN & BẢNG ĐIỀU KHIỂN
           ======================================================== */
    .glass-panel {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        border: 1px solid #f1f5f9;
        padding: 24px;
        margin-bottom: 24px;
    }

    .finance-kpi-card {
        border-radius: 20px;
        padding: 24px;
        position: relative;
        overflow: hidden;
        color: white;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        z-index: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .finance-kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

        .finance-kpi-card i.bg-icon {
            position: absolute;
            right: -10px;
            bottom: -10px;
            font-size: 8rem;
            opacity: 0.15;
            transform: rotate(-15deg);
            z-index: -1;
            transition: transform 0.5s ease;
        }

        .finance-kpi-card:hover i.bg-icon {
            transform: rotate(0deg) scale(1.1);
        }

    .grad-day {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .grad-month {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    }

    .grad-year {
        background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%);
    }

    .grad-total {
        background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
    }

    .chart-container {
        height: 320px;
        width: 100%;
        margin-top: 20px;
    }

    /* ========================================================
           BẢNG DỮ LIỆU - NGĂN CHẶN CUỘN NGANG TUYỆT ĐỐI
           ======================================================== */
    .data-table-wrapper {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        border: 1px solid #f1f5f9;
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        table-layout: fixed; /* Khóa chiều rộng, ép nội dung phải tuân theo tỷ lệ % */
        border-collapse: collapse;
        margin: 0;
    }

        .data-table thead th {
            background: #f8fafc;
            color: #475569;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 14px;
            border-bottom: 2px solid #e2e8f0;
        }

        .data-table tbody td {
            padding: 16px 14px;
            vertical-align: middle;
            border-bottom: 1px dashed #e2e8f0;
            color: #334155;
            font-size: 0.9rem;
            word-wrap: break-word; /* Tự động bẻ chữ nếu quá dài */
            overflow-wrap: break-word;
        }

        .data-table tbody tr:hover {
            background-color: #f8fafc;
        }

    /* Cắt gọn chữ với dấu ... cho các nội dung dài */
    .text-truncate-custom {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100%;
    }

    /* Nút bấm thao tác */
    .action-group {
        display: flex;
        gap: 6px;
        justify-content: center;
        flex-wrap: wrap; /* Cho phép nút rớt dòng nếu hẹp */
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        border: none;
    }

        .action-btn.approve {
            background: #d1fae5;
            color: #059669;
        }

            .action-btn.approve:hover {
                background: #10b981;
                color: #fff;
                transform: translateY(-2px);
            }

        .action-btn.reject {
            background: #fee2e2;
            color: #dc2626;
        }

            .action-btn.reject:hover {
                background: #ef4444;
                color: #fff;
                transform: translateY(-2px);
            }

        .action-btn.view-bill {
            background: #e0f2fe;
            color: #0284c7;
        }

            .action-btn.view-bill:hover {
                background: #0ea5e9;
                color: #fff;
                transform: translateY(-2px);
            }

    /* Phân trang */
    .pagination .page-link {
        border-radius: 8px;
        margin: 0 4px;
        font-weight: 600;
        color: #64748b;
        border: 1px solid #cbd5e1;
    }

    .pagination .page-item.active .page-link {
        background: #4f46e5;
        border-color: #4f46e5;
        color: white;
    }

    /* ========================================================
           MOBILE RESPONSIVE - GIAO DIỆN THẺ (CARD LAYOUT)
           ======================================================== */
    @@media (max-width: 991.98px) {
        .data-table, .data-table tbody, .data-table tr, .data-table td {
            display: block;
            width: 100%;
        }

            .data-table thead {
                display: none; /* Ẩn thẻ Head trên mobile */
            }

            .data-table tbody tr {
                margin: 16px;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                padding: 12px;
                background: #fff;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            }

            .data-table tbody td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 10px 0;
                border-bottom: 1px dashed #f1f5f9;
                text-align: right;
            }

                .data-table tbody td::before {
                    content: attr(data-label);
                    font-weight: 700;
                    color: #64748b;
                    font-size: 0.75rem;
                    text-transform: uppercase;
                    text-align: left;
                    flex-shrink: 0;
                    margin-right: 15px;
                    width: 35%; /* Nhãn chiếm 35% không gian */
                }

                .data-table tbody td > div,
                .data-table tbody td > span {
                    flex: 1;
                    display: flex;
                    justify-content: flex-end;
                    text-align: right;
                }

                .data-table tbody td:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                    padding-top: 14px;
                }
        /* Tùy chỉnh riêng cho khu vực info khách hàng trên mobile */
        .mobile-user-info {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
        }
    }
</style>

<div class="animate__animated animate__fadeInUp">

    @if (TempData["Success"] != null)
    {
        <script>Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: '@Html.Raw(TempData["Success"])', showConfirmButton: false, timer: 3000 });</script>
    }
    @if (TempData["Error"] != null)
    {
        <script>Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: '@Html.Raw(TempData["Error"])', showConfirmButton: false, timer: 4000 });</script>
    }

    <!-- ĐẦU TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h3 class="fw-black text-dark m-0"><i class="bi bi-bank text-primary me-2"></i>TÀI CHÍNH & ĐỐI SOÁT</h3>
            <p class="text-muted mt-1 mb-0 fs-6">Hệ thống phân tích dòng tiền và kiểm duyệt tự động</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-light border fw-bold rounded-pill px-4 shadow-sm" onclick="window.print()">
                <i class="bi bi-printer me-2"></i>In trang
            </button>
            <a href="@Url.Action("ExportCsv", new { searchString = ViewBag.CurrentSearch, statusFilter = ViewBag.CurrentStatus, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
                <i class="bi bi-file-earmark-excel me-2"></i>Xuất Excel
            </a>
        </div>
    </div>

    <!-- BỘ 4 THẺ KPI -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="finance-kpi-card grad-day">
                <p class="mb-2 opacity-75 fw-bold fs-6">DOANH THU HÔM NAY</p>
                <h3 class="fw-black mb-0 display-6">@todayRevenue.ToString("N0")<span class="fs-5 ms-1">đ</span></h3>
                <div class="mt-auto pt-3 fs-6 opacity-75"><i class="bi bi-arrow-up-circle-fill me-1"></i>Cập nhật Realtime</div>
                <i class="bi bi-lightning-charge-fill bg-icon"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="finance-kpi-card grad-month">
                <p class="mb-2 opacity-75 fw-bold fs-6">DOANH THU THÁNG NÀY</p>
                <h3 class="fw-black mb-0 display-6">@thisMonthRevenue.ToString("N0")<span class="fs-5 ms-1">đ</span></h3>
                <div class="mt-auto pt-3 fs-6 opacity-75"><i class="bi bi-calendar-month me-1"></i>Tháng @DateTime.Now.Month</div>
                <i class="bi bi-wallet2 bg-icon"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="finance-kpi-card grad-year">
                <p class="mb-2 opacity-75 fw-bold fs-6">DOANH THU NĂM @DateTime.Now.Year</p>
                <h3 class="fw-black mb-0 display-6">@thisYearRevenue.ToString("N0")<span class="fs-5 ms-1">đ</span></h3>
                <div class="mt-auto pt-3 fs-6 opacity-75"><i class="bi bi-bar-chart-fill me-1"></i>Tăng trưởng ổn định</div>
                <i class="bi bi-pie-chart-fill bg-icon"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="finance-kpi-card grad-total">
                <p class="mb-2 opacity-75 fw-bold fs-6">TỔNG LŨY KẾ</p>
                <h3 class="fw-black mb-0 display-6">@totalRevenue.ToString("N0")<span class="fs-5 ms-1">đ</span></h3>
                <div class="mt-auto pt-3 fs-6"><span class="badge bg-white text-primary rounded-pill px-3">@successCount GD thành công</span></div>
                <i class="bi bi-safe-fill bg-icon"></i>
            </div>
        </div>
    </div>

    <!-- BIỂU ĐỒ -->
    <div class="glass-panel">
        <h6 class="fw-bold text-dark mb-0"><i class="bi bi-activity text-primary me-2"></i>Phân tích dòng tiền (30 ngày gần nhất)</h6>
        <div class="chart-container">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <!-- BỘ LỌC -->
    <div class="glass-panel">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="row g-3 align-items-end">
                <div class="col-xl-3 col-lg-3 col-md-6">
                    <label class="form-label text-secondary fw-bold small text-uppercase">Từ khóa</label>
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control shadow-sm rounded-3" placeholder="Mã GD, tên...">
                </div>
                <div class="col-xl-2 col-lg-3 col-md-6">
                    <label class="form-label text-secondary fw-bold small text-uppercase">Trạng thái</label>
                    <select name="statusFilter" class="form-select shadow-sm rounded-3">
                        <option value="All" selected="@(ViewBag.CurrentStatus == "All" || string.IsNullOrEmpty(ViewBag.CurrentStatus))">Tất cả</option>
                        <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending")">⏳ Chờ duyệt (@pendingCount)</option>
                        <option value="Success" selected="@(ViewBag.CurrentStatus == "Success")">✅ Thành công</option>
                        <option value="Rejected" selected="@(ViewBag.CurrentStatus == "Rejected")">❌ Bị từ chối</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6">
                    <label class="form-label text-secondary fw-bold small text-uppercase">Từ ngày</label>
                    <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control shadow-sm rounded-3">
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6">
                    <label class="form-label text-secondary fw-bold small text-uppercase">Đến ngày</label>
                    <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control shadow-sm rounded-3">
                </div>
                <div class="col-xl-3 col-lg-2 col-md-12 d-flex gap-2">
                    <button type="submit" class="btn btn-dark fw-bold flex-grow-1 shadow-sm"><i class="bi bi-funnel-fill me-2"></i> Lọc</button>
                    <a href="/Admin/Transactions/Index" class="btn btn-light border fw-bold shadow-sm" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </div>
        </form>
    </div>

    <!-- BẢNG DỮ LIỆU -->
    <div class="data-table-wrapper pb-4 mb-5">
        <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-white flex-wrap gap-2">
            <h5 class="fw-bold m-0 text-dark"><i class="bi bi-card-list text-primary me-2"></i>Danh sách hồ sơ (@totalTransactions)</h5>
            @if (pendingCount > 0)
            {
                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fs-6 animate__animated animate__pulse animate__infinite">
                    Có @pendingCount hồ sơ chờ duyệt
                </span>
            }
        </div>

        <!-- Không dùng div bọc .table-responsive để tránh sinh thanh cuộn ngang -->
        <table class="table data-table mb-0">
            <thead>
                <tr>
                    <th style="width: 12%;">Mã GD</th>
                    <th style="width: 20%;">Đối tác</th>
                    <th style="width: 15%;">Số tiền</th>
                    <th style="width: 20%;">Dịch vụ</th>
                    <th style="width: 12%;">Thời gian</th>
                    <th style="width: 11%;">Trạng thái</th>
                    <th style="width: 10%; text-align: center;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Mã GD">
                                <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-bold">#@item.TransactionCode</span>
                            </td>
                            <td data-label="Đối tác">
                                <div class="mobile-user-info">
                                    <img src="@(item.User?.Avatar ?? "/images/avatars/default-user.png")" class="rounded-circle border" width="40" height="40" style="object-fit:cover; flex-shrink:0;">
                                    <div style="min-width: 0;">
                                        <!-- min-width: 0 giúp text-truncate hoạt động trong flex -->
                                        <span class="d-block fw-bold text-dark text-truncate-custom">@(item.User?.FullName ?? item.User?.Username)</span>
                                        <small class="text-muted text-truncate-custom">@item.User?.Phone</small>
                                    </div>
                                </div>
                            </td>
                            <td data-label="Số tiền">
                                <span class="text-success fw-black fs-6">+ @item.Amount.ToString("N0") ₫</span>
                            </td>
                            <td data-label="Dịch vụ">
                                @if (item.Package != null)
                                {
                                    <div class="text-truncate-custom fw-bold text-primary small bg-primary-subtle border border-primary-subtle rounded-2 px-2 py-1 d-inline-block" style="max-width:100%;">
                                        <i class="bi bi-gem me-1"></i>@item.Package.PackageName (x@(item.Quantity))
                                    </div>
                                }
                            </td>
                            <td data-label="Thời gian">
                                <span class="d-block fw-bold text-dark fs-6">@item.CreatedAt.ToString("dd/MM/yyyy")</span>
                                <small class="text-muted">@item.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td data-label="Trạng thái">
                                @if (item.Status == "Success" || item.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Xong</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>Chờ</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Hủy</span>
                                }
                            </td>
                            <td data-label="Thao tác">
                                @if (item.Status == "Pending")
                                {
                                    <div class="action-group">
                                        @if (!string.IsNullOrEmpty(item.BillImageUrl))
                                        {
                                            <button type="button" class="action-btn view-bill" title="Xem biên lai" onclick="viewBill('@item.BillImageUrl')">
                                                <i class="bi bi-image"></i>
                                            </button>
                                        }
                                        <button type="button" class="action-btn approve" title="Duyệt hồ sơ" onclick="confirmApprove('@item.TransactionCode', @item.Amount)">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="action-btn reject" title="Từ chối" onclick="confirmReject('@item.TransactionCode')">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center text-lg-center w-100">
                                        <span class="text-muted small fw-bold bg-light px-2 py-1 rounded-pill border"><i class="bi bi-lock-fill"></i> Khóa</span>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="bi bi-folder-x display-3 text-muted opacity-25"></i>
                            <h6 class="text-muted fw-bold mt-3">Khu vực trống</h6>
                            <p class="text-muted small">Không tìm thấy dữ liệu giao dịch nào khớp với bộ lọc.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang -->
        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4 pb-2">
                <nav>
                    <ul class="pagination flex-wrap mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(currentPage - 1))"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1))
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link" href="#" onclick="changePage(@i)">@i</a>
                                </li>
                            }
                            else if (i == currentPage - 2 || i == currentPage + 2)
                            {
                                <li class="page-item disabled"><span class="page-link border-0">...</span></li>
                            }
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="#" onclick="changePage(@(currentPage + 1))"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

    <!-- Form ẩn hỗ trợ Update Trạng Thái -->
    <form id="statusForm" asp-action="UpdateStatus" method="post" style="display:none;">
        <input type="hidden" name="baseCode" id="formBaseCode" />
        <input type="hidden" name="status" id="formStatus" />
        <input type="hidden" name="adminNote" id="formAdminNote" />
    </form>
</div>

@section Scripts {
    <script>
        function changePage(page) {
            let url = new URL(window.location.href);
            url.searchParams.set("page", page);
            window.location.href = url.toString();
        }

        // Popup xem Biên Lai
        function viewBill(imageUrl) {
            Swal.fire({
                title: 'BIÊN LAI CHUYỂN KHOẢN',
                text: 'Vui lòng đối chiếu với sao kê ngân hàng trước khi duyệt!',
                imageUrl: imageUrl,
                imageAlt: 'Biên lai',
                imageWidth: '100%',
                showCloseButton: true,
                confirmButtonText: '<i class="bi bi-check-circle"></i> Đóng',
                confirmButtonColor: '#4f46e5',
                customClass: { image: 'rounded-4 shadow-sm border mt-3' }
            });
        }

        // Popup duyệt
        function confirmApprove(baseCode, amount) {
            let formattedAmount = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            Swal.fire({
                title: 'DUYỆT GIAO DỊCH',
                html: `<div class="text-start mt-2">
                        <p class="mb-1">Thu tiền: <b class="text-success fs-5">${formattedAmount}</b></p>
                        <p class="mb-3">Mã GD: <b>#${baseCode}</b></p>
                        <div class="alert alert-warning border-0 small py-2"><i class="bi bi-info-circle me-1"></i>Hệ thống sẽ cấp phát tự động gói tin sau khi duyệt.</div>
                       </div>`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Đã nhận tiền & Duyệt',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('formBaseCode').value = baseCode;
                    document.getElementById('formStatus').value = 'Success';
                    document.getElementById('statusForm').submit();
                }
            });
        }

        // Popup từ chối
        function confirmReject(baseCode) {
            Swal.fire({
                title: 'TỪ CHỐI GIAO DỊCH',
                text: `Nhập lý do từ chối cụm giao dịch #${baseCode}:`,
                input: 'textarea',
                inputPlaceholder: 'Ví dụ: Biên lai không hợp lệ, chưa nhận được tiền...',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#94a3b8',
                confirmButtonText: 'Từ chối hồ sơ',
                cancelButtonText: 'Hủy',
                inputValidator: (value) => { if (!value) return 'Vui lòng nhập lý do từ chối!' }
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('formBaseCode').value = baseCode;
                    document.getElementById('formStatus').value = 'Rejected';
                    document.getElementById('formAdminNote').value = result.value;
                    document.getElementById('statusForm').submit();
                }
            });
        }

        // Biểu đồ
        document.addEventListener("DOMContentLoaded", function () {
            const rawLabels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
            const rawData = @Html.Raw(ViewBag.ChartValues ?? "[]");

            if(rawLabels.length === 0) return; // Nếu không có data thì bỏ qua

            const ctx = document.getElementById('revenueChart').getContext('2d');
            let gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(79, 70, 229, 0.5)');
            gradient.addColorStop(1, 'rgba(79, 70, 229, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: rawLabels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: rawData,
                        borderColor: '#4f46e5',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#4f46e5',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            titleFont: { size: 13, family: "system-ui, -apple-system, sans-serif" },
                            bodyFont: { size: 14, weight: 'bold', family: "system-ui, -apple-system, sans-serif" },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [6, 6], color: '#f1f5f9', drawBorder: false },
                            ticks: {
                                color: '#64748b',
                                font: { family: "system-ui, -apple-system, sans-serif", size: 12 },
                                callback: function(value) {
                                    if(value >= 1000000) return (value / 1000000) + 'M';
                                    if(value >= 1000) return (value / 1000) + 'K';
                                    return value;
                                }
                            }
                        },
                        x: {
                            grid: { display: false, drawBorder: false },
                            ticks: { color: '#64748b', font: { family: "system-ui, -apple-system, sans-serif" }, maxTicksLimit: 12 }
                        }
                    },
                    animation: { y: { duration: 1500, easing: 'easeOutQuart' } }
                }
            });
        });
    </script>
}