        font-weight: 900;
    }

    .phone {
        color: var(--ad-muted);
        font-size: .72rem;
        font-weight: 700;
    }

    .money {
        color: var(--ad-green);
        font-size: .9rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .time-main {
        color: var(--ad-text);
        font-weight: 900;
        white-space: nowrap;
    }

    .time-sub {
        color: var(--ad-muted);
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .actions {
        display: flex;
        gap: 4px;
        justify-content: center;
    }

    .icon-btn {
        width: 29px;
        height: 29px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: #fff;
    }

        .icon-btn.view {
            color: #0369a1;
            background: #e0f2fe;
            border-color: #bae6fd;
        }

        .icon-btn.ok {
            color: #047857;
            background: #dcfce7;
            border-color: #86efac;
        }

        .icon-btn.bad {
            color: #b91c1c;
            background: #fee2e2;
            border-color: #fecaca;
        }

    .lock-note {
        color: #64748b;
        font-size: .7rem;
        font-weight: 850;
    }

    .mobile-list {
        display: none;
    }

    .tx-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 12px;
        box-shadow: none;
    }

        .tx-card + .tx-card {
            margin-top: 10px;
        }

    .tx-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf2f7;
    }

    .tx-money {
        color: var(--ad-green);
        font-size: 1.1rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .tx-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 0;
        border-bottom: 1px dashed #edf2f7;
    }

        .tx-row:last-child {
            border-bottom: 0;
        }

    .tx-label {
        color: var(--ad-muted);
        font-size: .72rem;
        font-weight: 950;
        text-transform: uppercase;
    }

    .tx-value {
        color: var(--ad-text);
        font-size: .86rem;
        font-weight: 760;
        text-align: right;
        min-width: 0;
    }

    .tx-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        margin-top: 10px;
    }

        .tx-actions .btn {
            min-height: 38px;
            border-radius: 12px;
            font-weight: 900;
        }

    .pager {
        padding: 13px 15px;
        border-top: 1px solid #edf2f7;
    }

    .page-link {
        border-radius: 10px !important;
        margin: 2px;
        font-weight: 850;
    }

    .empty-state {
        padding: 28px 14px;
        text-align: center;
        color: var(--ad-muted);
    }

    @@media (max-width: 1199.98px) {
        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-actions {
            grid-column: 1 / -1;
            display: flex;
            gap: 8px;
        }
    }

    @@media (max-width: 991.98px) {
        .desktop-table {
            display: none;
        }

        .data-box {
            background: transparent;
            border: 0;
            box-shadow: none;
            overflow: visible;
        }

        .data-header {
            background: #fff;
            border: 1px solid rgba(148, 163, 184, .25);
            border-radius: 14px;
            margin-bottom: 8px;
            box-shadow: none;
        }

        .mobile-list {
            display: block;
            padding: 0;
            background: transparent;
        }
    }

    @@media (max-width: 767.98px) {
        .finance-page {
            padding: 6px;
            min-height: auto;
        }

        .topbar {
            padding: 12px;
            border-radius: 14px;
            align-items: stretch;
            flex-direction: column;
            box-shadow: none;
        }

        .title-icon {
            width: 38px;
            height: 38px;
            border-radius: 13px;
        }

        .page-title {
            font-size: 1.22rem;
        }

        .page-subtitle {
            font-size: .84rem;
        }

        .top-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .btn-soft {
            width: 100%;
            min-height: 38px;
            padding: 7px 10px;
            font-size: .84rem;
        }

        .kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
        }

        .kpi {
            border-radius: 14px;
            padding: 10px;
            min-height: 92px;
        }

            .kpi .label {
                font-size: .66rem;
            }

            .kpi .value {
                font-size: 1.02rem;
            }

            .kpi .desc {
                font-size: .7rem;
            }

        .mini-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
        }

        .mini {
            border-radius: 14px;
            padding: 10px;
            display: block;
            text-align: center;
        }

            .mini i {
                display: none;
            }

            .mini .label {
                font-size: .66rem;
            }

            .mini .value {
                font-size: 1.05rem;
            }

        .chart-wrap {
            height: 210px;
            padding: 10px;
        }

        .card-head, .data-header {
            padding: 12px;
        }

        .card-title {
            font-size: .98rem;
        }

        .filter-toggle {
            padding: 12px;
        }

        .filter-body {
            display: none;
            padding: 0 12px 12px;
        }

        .filter-box.open .filter-body {
            display: block;
        }

        .filter-grid {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .filter-actions {
            display: grid;
            grid-template-columns: 1fr 44px;
        }

        .soft-input {
            min-height: 38px;
            border-radius: 11px;
        }

        .tx-card {
            padding: 10px;
            border-radius: 14px;
            margin-bottom: 8px;
        }

        .tx-row {
            padding: 7px 0;
        }

        .tx-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="finance-page">
    <section class="topbar">
        <div class="title-line">
            <span class="title-icon"><i class="bi bi-bank2"></i></span>
            <div class="min-w-0">
                <h1 class="page-title">Tài chính & đối soát</h1>
                <p class="page-subtitle">Theo dõi doanh thu, biên lai và duyệt thanh toán.</p>
            </div>
        </div>
        <div class="top-actions">
            <a href="javascript:window.print()" class="btn btn-light border btn-soft"><i class="bi bi-printer-fill"></i>In trang</a>
            <a href="/Admin/Transactions/ExportExcel" class="btn btn-success btn-soft"><i class="bi bi-file-earmark-excel-fill"></i>Xuất Excel</a>
        </div>
    </section>

    <section class="kpi-grid">
        <article class="kpi g1"><div class="label"><i class="bi bi-lightning-charge-fill"></i>Hôm nay</div><div class="value">@FormatMoney(todayRevenue)</div><div class="desc">Doanh thu đã duyệt</div></article>
        <article class="kpi g2"><div class="label"><i class="bi bi-calendar-month-fill"></i>Tháng này</div><div class="value">@FormatMoney(thisMonthRevenue)</div><div class="desc">Tháng @DateTime.Now.Month/@DateTime.Now.Year</div></article>
        <article class="kpi g3"><div class="label"><i class="bi bi-bar-chart-fill"></i>Năm @DateTime.Now.Year</div><div class="value">@FormatMoney(thisYearRevenue)</div><div class="desc">Tổng trong năm</div></article>
        <article class="kpi g4"><div class="label"><i class="bi bi-safe-fill"></i>Lũy kế</div><div class="value">@FormatMoney(totalRevenue)</div><div class="desc">@successCount.ToString("N0") giao dịch thành công</div></article>
    </section>

    <section class="mini-grid">
        <article class="mini card-flat"><div><div class="label">Tổng hồ sơ</div><div class="value">@totalTransactions.ToString("N0")</div></div><i class="bi bi-receipt-cutoff text-primary fs-4"></i></article>
        <article class="mini card-flat"><div><div class="label">Chờ duyệt</div><div class="value text-warning">@pendingCount.ToString("N0")</div></div><i class="bi bi-hourglass-split text-warning fs-4"></i></article>
        <article class="mini card-flat"><div><div class="label">Từ chối</div><div class="value text-danger">@rejectedCount.ToString("N0")</div></div><i class="bi bi-x-circle-fill text-danger fs-4"></i></article>
    </section>

    <section class="card-flat chart-card">
        <div class="card-head">
            <div><h2 class="card-title"><i class="bi bi-activity text-primary"></i>Phân tích dòng tiền</h2><p class="card-subtitle">Doanh thu 30 ngày gần nhất.</p></div>
            <span class="status-pill ok"><i class="bi bi-graph-up-arrow"></i>Doanh thu</span>
        </div>
        <div class="chart-wrap"><canvas id="revenueChart"></canvas></div>
    </section>

    <section class="filter-box" id="filterBox">
        <button type="button" class="filter-toggle" onclick="document.getElementById('filterBox').classList.toggle('open')">
            <span><i class="bi bi-funnel-fill text-primary me-2"></i>Bộ lọc</span>
            <i class="bi bi-chevron-down"></i>
        </button>
        <div class="filter-body">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="filter-grid">
                    <div><label class="form-label-mini">Từ khóa</label><input type="text" name="searchString" value="@currentSearch" class="form-control soft-input" placeholder="Mã GD, tên, SĐT..." /></div>
                    <div><label class="form-label-mini">Trạng thái</label><select name="statusFilter" class="form-select soft-input"><option value="All" selected="@(currentStatus == "All" || string.IsNullOrEmpty(currentStatus))">Tất cả</option><option value="Pending" selected="@(currentStatus == "Pending")">Chờ duyệt</option><option value="Success" selected="@(currentStatus == "Success")">Thành công</option><option value="Rejected" selected="@(currentStatus == "Rejected")">Từ chối</option></select></div>
                    <div><label class="form-label-mini">Từ ngày</label><input type="date" name="startDate" value="@startDate" class="form-control soft-input" /></div>
                    <div><label class="form-label-mini">Đến ngày</label><input type="date" name="endDate" value="@endDate" class="form-control soft-input" /></div>
                    <div class="filter-actions"><button type="submit" class="btn btn-dark fw-bold"><i class="bi bi-search me-1"></i>Lọc</button><a href="/Admin/Transactions/Index" class="btn btn-light border fw-bold"><i class="bi bi-arrow-counterclockwise"></i></a></div>
                </div>
            </form>
        </div>
    </section>

    <section class="data-box">
        <div class="data-header">
            <div><h2 class="card-title"><i class="bi bi-card-list text-primary"></i>Danh sách giao dịch</h2><p class="card-subtitle">Tổng cộng @totalTransactions.ToString("N0") hồ sơ.</p></div>
            @if (pendingCount > 0)
            {
                <span class="pending-badge"><i class="bi bi-exclamation-triangle-fill"></i>@pendingCount.ToString("N0") chờ duyệt</span>
            }
        </div>

        <div class="desktop-table">
            <table class="finance-table">
                <thead><tr><th class="c-code">Mã GD</th><th class="c-user">Khách hàng</th><th class="c-money">Số tiền</th><th class="c-service">Dịch vụ</th><th class="c-pay">Thanh toán</th><th class="c-time">Thời gian</th><th class="c-status">Trạng thái</th><th class="c-act text-center">Nút</th></tr></thead>
                <tbody>
                    @if (transactions.Any())
                    {
                        foreach (var item in transactions)
                        {
                            <tr>
                                <td><span class="code-pill" title="@item.TransactionCode"><i class="bi bi-hash"></i><span class="clip">@item.TransactionCode</span></span></td>
                                <td><div class="user-cell"><img src="@SafeAvatar(item.User?.Avatar)" class="avatar" alt="avatar" /><div class="clip"><div class="name clip">@GetCustomerName(item)</div><div class="phone clip">@GetCustomerPhone(item)</div></div></div></td>
                                <td><span class="money">@FormatMoney(item.Amount)</span><div class="phone">SL: @item.Quantity</div></td>
                                <td><span class="service-pill" title="@GetPackageName(item)"><i class="bi bi-box-seam"></i><span class="clip">@GetPackageName(item)</span></span></td>
                                <td><span class="clip"><i class="bi bi-credit-card-2-front me-1"></i>@GetPaymentMethodText(item.PaymentMethod)</span></td>
                                <td><span class="time-main">@item.CreatedAt.ToString("dd/MM/yyyy")</span><span class="time-sub">@item.CreatedAt.ToString("HH:mm")</span></td>
                                <td><span class="status-pill @GetStatusClass(item.Status)"><i class="bi @GetStatusIcon(item.Status)"></i><span class="clip">@GetStatusText(item.Status)</span></span></td>
                                <td>
                                    <div class="actions">
                                        @if (!string.IsNullOrWhiteSpace(item.BillImageUrl))
                                        {
                                            <button type="button" class="icon-btn view" title="Xem biên lai" onclick="viewBill('@item.BillImageUrl')"><i class="bi bi-image"></i></button>
                                        }
                                        @if (item.Status == "Pending")
                                        {
                                            <button type="button" class="icon-btn ok" title="Duyệt" onclick="confirmApprove('@item.TransactionCode', @item.Amount)"><i class="bi bi-check-lg"></i></button>
                                            <button type="button" class="icon-btn bad" title="Từ chối" onclick="confirmReject('@item.TransactionCode')"><i class="bi bi-x-lg"></i></button>
                                        }
                                        else
                                        {

                                            <span class="lock-note"><i class="bi bi-lock-fill"></i></span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8"><div class="empty-state"><i class="bi bi-folder-x fs-1 opacity-50"></i><div class="fw-bold mt-2">Không có giao dịch</div><div>Không tìm thấy dữ liệu khớp với bộ lọc.</div></div></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mobile-list">
            @if (transactions.Any())
            {
                foreach (var item in transactions)
                {
                    <article class="tx-card">
                        <div class="tx-top"><span class="code-pill"><i class="bi bi-hash"></i><span class="clip">@item.TransactionCode</span></span><span class="tx-money">@FormatMoney(item.Amount)</span></div>
                        <div class="tx-row"><span class="tx-label">Khách</span><span class="tx-value">@GetCustomerName(item)<br /><small class="text-muted">@GetCustomerPhone(item)</small></span></div>
                        <div class="tx-row"><span class="tx-label">Dịch vụ</span><span class="tx-value">@GetPackageName(item)</span></div>
                        <div class="tx-row"><span class="tx-label">Thanh toán</span><span class="tx-value">@GetPaymentMethodText(item.PaymentMethod)</span></div>
                        <div class="tx-row"><span class="tx-label">Thời gian</span><span class="tx-value">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span></div>
                        <div class="tx-row"><span class="tx-label">Trạng thái</span><span class="tx-value"><span class="status-pill @GetStatusClass(item.Status)"><i class="bi @GetStatusIcon(item.Status)"></i>@GetStatusText(item.Status)</span></span></div>
                        @if (item.Status == "Pending")
                        {
                            <div class="tx-actions">
                                @if (!string.IsNullOrWhiteSpace(item.BillImageUrl))
                                {
                                    <button type="button" class="btn btn-outline-primary" onclick="viewBill('@item.BillImageUrl')"><i class="bi bi-image me-1"></i>Biên lai</button>
                                }
                                <button type="button" class="btn btn-outline-success" onclick="confirmApprove('@item.TransactionCode', @item.Amount)"><i class="bi bi-check-lg me-1"></i>Duyệt</button>
                                <button type="button" class="btn btn-outline-danger" onclick="confirmReject('@item.TransactionCode')"><i class="bi bi-x-lg me-1"></i>Từ chối</button>
                            </div>
                        }
                    </article>
                }
            }
            else
            {

                <div class="empty-state"><i class="bi bi-folder-x fs-1 opacity-50"></i><div class="fw-bold mt-2">Không có giao dịch</div></div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="pager">
                <nav aria-label="Phân trang giao dịch">
                    <ul class="pagination flex-wrap justify-content-center mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")"><a class="page-link" href="javascript:void(0)" onclick="changePage(@(currentPage - 1))"><i class="bi bi-chevron-left"></i></a></li>@for (int i = 1; i <= totalPages; i++){ if (i == 1 || i == totalPages || (i >= currentPage - 1 && i <= currentPage + 1)){
                        <li class="page-item @(currentPage == i ? "active" : "")"><a class="page-link" href="javascript:void(0)" onclick="changePage(@i)">@i</a></li>
                    }
                    else if (i == currentPage - 2 || i == currentPage + 2)
                    {

                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                    }}
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")"><a class="page-link" href="javascript:void(0)" onclick="changePage(@(currentPage + 1))"><i class="bi bi-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
                }
    </section>

    <form id="statusForm" asp-action="UpdateStatus" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="baseCode" id="formBaseCode" />
        <input type="hidden" name="status" id="formStatus" />
        <input type="hidden" name="adminNote" id="formAdminNote" />
    </form>
</div>

@section Scripts {
    <script>
        function changePage(page) {
            if (page < 1) return;
            let url = new URL(window.location.href);
            url.searchParams.set('page', page);
            window.location.href = url.toString();
        }

        function viewBill(imageUrl) {
            if (!imageUrl) {
                Swal.fire({ icon: 'info', title: 'Chưa có biên lai', text: 'Giao dịch này chưa có ảnh biên lai.', confirmButtonColor: '#2563eb' });
                return;
            }
            Swal.fire({ title: 'Biên lai chuyển khoản', imageUrl: imageUrl, imageAlt: 'Biên lai chuyển khoản', imageWidth: '100%', showCloseButton: true, confirmButtonText: 'Đóng', confirmButtonColor: '#2563eb', customClass: { popup: 'rounded-4', image: 'rounded-4 shadow-sm border mt-3' } });
        }

        function confirmApprove(baseCode, amount) {
            const formattedAmount = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            Swal.fire({
                title: 'Duyệt giao dịch?',
                html: `<div class="text-start"><div class="alert alert-success rounded-4 mb-3"><div class="fw-bold mb-1">Số tiền đối soát</div><div class="fs-4 fw-bold text-success">${formattedAmount}</div></div><div>Mã giao dịch: <strong>#${baseCode}</strong></div><div class="alert alert-warning rounded-4 mt-3 mb-0">Chỉ duyệt khi đã chắc chắn tiền đã vào tài khoản.</div></div>`,
                icon: 'question', showCancelButton: true, confirmButtonColor: '#059669', cancelButtonColor: '#94a3b8', confirmButtonText: 'Đã nhận tiền & duyệt', cancelButtonText: 'Hủy'
            }).then((result) => { if (result.isConfirmed) { document.getElementById('formBaseCode').value = baseCode; document.getElementById('formStatus').value = 'Success'; document.getElementById('formAdminNote').value = ''; document.getElementById('statusForm').submit(); } });
        }

        function confirmReject(baseCode) {
            Swal.fire({
                title: 'Từ chối giao dịch', input: 'textarea', inputPlaceholder: 'Nhập lý do từ chối...', inputAttributes: { maxlength: 500 }, icon: 'warning', showCancelButton: true, confirmButtonColor: '#dc2626', cancelButtonColor: '#94a3b8', confirmButtonText: 'Từ chối', cancelButtonText: 'Hủy',
                inputValidator: (value) => { if (!value || !value.trim()) return 'Vui lòng nhập lý do từ chối.'; if (value.trim().length < 5) return 'Lý do quá ngắn.'; }
            }).then((result) => { if (result.isConfirmed) { document.getElementById('formBaseCode').value = baseCode; document.getElementById('formStatus').value = 'Rejected'; document.getElementById('formAdminNote').value = result.value.trim(); document.getElementById('statusForm').submit(); } });
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (window.innerWidth >= 768) document.getElementById('filterBox')?.classList.add('open');
            const canvas = document.getElementById('revenueChart');
            if (!canvas) return;
            const rawLabels = @Html.Raw(ViewBag.ChartLabels ?? "[]");
            const rawData = @Html.Raw(ViewBag.ChartValues ?? "[]");
            if (!Array.isArray(rawLabels) || !Array.isArray(rawData) || rawLabels.length === 0) {
                canvas.parentElement.innerHTML = '<div class="empty-state"><i class="bi bi-bar-chart fs-1 opacity-50"></i><div class="fw-bold mt-2">Chưa có dữ liệu biểu đồ</div></div>';
                return;
            }
            const ctx = canvas.getContext('2d');
            const gradient = ctx.createLinearGradient(0, 0, 0, 280);
            gradient.addColorStop(0, 'rgba(37, 99, 235, 0.28)');
            gradient.addColorStop(1, 'rgba(37, 99, 235, 0.02)');
            new Chart(ctx, { type: 'line', data: { labels: rawLabels, datasets: [{ label: 'Doanh thu', data: rawData, borderColor: '#2563eb', backgroundColor: gradient, borderWidth: 3, pointRadius: 3, fill: true, tension: .42 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(c.parsed.y || 0) } } }, scales: { y: { beginAtZero: true, ticks: { callback: v => v >= 1000000 ? (v / 1000000) + ' triệu' : v } }, x: { grid: { display: false }, ticks: { maxTicksLimit: 8 } } } } });
        });
    </script>
}
