@model BDSKhanhHoa.ViewModels.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập | Bất Động Sản Khánh Hòa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --auth-bg: #f4f7fb;
            --auth-card: #ffffff;
            --auth-text: #0f172a;
            --auth-muted: #64748b;
            --auth-border: #e5e7eb;
            --auth-primary: #2563eb;
            --auth-primary-dark: #1d4ed8;
            --auth-purple: #7c3aed;
            --auth-danger: #dc2626;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(rgba(2,6,23,.62), rgba(2,6,23,.66)), url('https://images.unsplash.com/photo-1560518883-ce09059eeffa?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover fixed;
            font-family: 'Inter', sans-serif;
            color: var(--auth-text);
        }

        h1, h2, h3, h4, h5, h6, .btn, .brand-title {
            font-family: 'Sora', sans-serif;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }

        .login-shell {
            width: min(1080px, 100%);
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            background: rgba(255,255,255,.86);
            border: 1px solid rgba(255,255,255,.38);
            border-radius: 32px;
            overflow: hidden;
            box-shadow: 0 28px 80px rgba(0,0,0,.28);
            backdrop-filter: blur(18px);
        }

        .login-left {
            position: relative;
            overflow: hidden;
            padding: 42px;
            min-height: 620px;
            color: #fff;
            background: radial-gradient(circle at 18% 10%, rgba(255,255,255,.22), transparent 20%), radial-gradient(circle at 88% 18%, rgba(14,165,233,.34), transparent 28%), linear-gradient(135deg, rgba(2,6,23,.96), rgba(30,58,138,.96) 54%, rgba(49,46,129,.96));
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .login-left::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
                background-size: 38px 38px;
                opacity: .75;
            }

        .login-left-content {
            position: relative;
            z-index: 2;
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 42px;
        }

            .brand-row img {
                width: 54px;
                height: 54px;
                object-fit: contain;
                border-radius: 18px;
                background: rgba(255,255,255,.96);
                padding: 6px;
            }

        .brand-title {
            margin: 0;
            font-size: 1.08rem;
            font-weight: 850;
            line-height: 1.18;
        }

        .brand-sub {
            color: rgba(255,255,255,.68);
            font-size: .8rem;
            margin-top: 3px;
            font-weight: 650;
        }

        .login-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.16);
            color: rgba(255,255,255,.9);
            font-size: .76rem;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .login-left-title {
            font-size: clamp(1.65rem, 3vw, 2.7rem);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.045em;
            margin-bottom: 12px;
        }

        .login-left-desc {
            color: rgba(255,255,255,.72);
            line-height: 1.7;
            font-size: .94rem;
            max-width: 560px;
            margin-bottom: 28px;
        }

        .quick-stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
        }

        .quick-stat {
            padding: 14px;
            border-radius: 20px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(10px);
        }

            .quick-stat strong {
                display: block;
                font-size: 1.2rem;
                font-weight: 950;
                line-height: 1.1;
            }

            .quick-stat span {
                color: rgba(255,255,255,.66);
                font-size: .76rem;
                font-weight: 700;
            }

        .login-left-footer {
            position: relative;
            z-index: 2;
            color: rgba(255,255,255,.62);
            font-size: .8rem;
            line-height: 1.6;
        }

        .login-right {
            background: #fff;
            padding: 42px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .mobile-brand {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

            .mobile-brand img {
                width: 44px;
                height: 44px;
                object-fit: contain;
                border-radius: 14px;
            }

        .form-title {
            margin: 0;
            font-size: clamp(1.45rem, 2.5vw, 2.1rem);
            font-weight: 950;
            letter-spacing: -.04em;
        }

        .form-sub {
            margin: 7px 0 24px;
            color: var(--auth-muted);
            font-size: .9rem;
            font-weight: 650;
            line-height: 1.55;
        }

        .form-label {
            font-size: .78rem;
            font-weight: 850;
            color: #334155;
            margin-bottom: 6px;
        }

        .input-shell {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 13px;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 3;
            pointer-events: none;
        }

        .auth-control {
            min-height: 48px;
            border-radius: 16px !important;
            border: 1px solid #e2e8f0;
            background: #fff;
            padding: 12px 13px 12px 40px;
            font-size: .9rem;
            font-weight: 650;
            box-shadow: none !important;
        }

            .auth-control:focus {
                border-color: rgba(37,99,235,.55);
                box-shadow: 0 0 0 4px rgba(37,99,235,.10) !important;
            }

        .input-group .auth-control {
            border-radius: 16px 0 0 16px !important;
        }

        .toggle-pass-btn {
            border: 1px solid #e2e8f0;
            border-left: 0;
            border-radius: 0 16px 16px 0 !important;
            background: #fff;
            color: #64748b;
            min-width: 48px;
        }

        .field-validation-error,
        .validation-message {
            display: block;
            margin-top: 5px;
            font-size: .74rem;
            font-weight: 750;
            color: var(--auth-danger);
        }

        .form-check-label {
            color: #475569;
            font-size: .82rem;
            font-weight: 700;
        }

        .forgot-link,
        .register-link {
            color: var(--auth-primary);
            font-size: .82rem;
            font-weight: 900;
            text-decoration: none;
        }

            .forgot-link:hover,
            .register-link:hover {
                color: var(--auth-primary-dark);
            }

        .btn-login {
            min-height: 48px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--auth-primary), var(--auth-purple));
            color: #fff;
            font-weight: 950;
            box-shadow: 0 14px 28px rgba(37,99,235,.22);
            transition: .2s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 18px 34px rgba(37,99,235,.28);
            }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--auth-muted);
            font-size: .78rem;
            font-weight: 750;
            margin: 20px 0;
        }

            .auth-divider::before,
            .auth-divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: #e5e7eb;
            }

        .google-btn {
            min-height: 46px;
            border-radius: 16px;
            border: 1px solid #e2e8f0;
            color: #0f172a;
            font-weight: 850;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            transition: .18s ease;
        }

            .google-btn:hover {
                background: #f8fafc;
                transform: translateY(-1px);
            }

        .alert {
            border-radius: 16px;
            font-size: .84rem;
            font-weight: 700;
        }

        @@media (max-width: 991.98px) {
            .login-shell {
                grid-template-columns: 1fr;
                border-radius: 24px;
            }

            .login-left {
                display: none;
            }

            .login-right {
                padding: 28px;
            }

            .mobile-brand {
                display: flex;
            }
        }

        @@media (max-width: 575.98px) {
            .login-wrapper {
                padding: 14px;
                align-items: flex-start;
            }

            .login-right {
                padding: 20px;
            }

            .d-flex.login-options {
                align-items: flex-start !important;
                flex-direction: column;
                gap: 8px;
            }

            .quick-stats {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-shell animate__animated animate__fadeIn">
            <aside class="login-left">
                <div class="login-left-content">
                    <div class="brand-row">
                        <img src="/images/logo.png" alt="BĐS Khánh Hòa" />
                        <div>
                            <p class="brand-title">BĐS Khánh Hòa</p>
                            <div class="brand-sub">Mua bán · Cho thuê · Dự án</div>
                        </div>
                    </div>

                    <div class="login-badge">
                        <i class="bi bi-shield-check"></i>
                        Đăng nhập an toàn
                    </div>

                    <h1 class="login-left-title">Chào mừng bạn quay lại.</h1>

                    <p class="login-left-desc">
                        Đăng nhập bằng Email hoặc tên đăng nhập để quản lý tin đăng,
                        theo dõi lịch hẹn, lưu tin yêu thích và sử dụng các công cụ hỗ trợ bất động sản.
                    </p>

                    <div class="quick-stats">
                        <div class="quick-stat">
                            <strong>24/7</strong>
                            <span>Hỗ trợ AI</span>
                        </div>
                        <div class="quick-stat">
                            <strong>5+</strong>
                            <span>Lượt đăng tặng</span>
                        </div>
                        <div class="quick-stat">
                            <strong>OTP</strong>
                            <span>Xác thực Email</span>
                        </div>
                    </div>
                </div>

                <div class="login-left-footer">
                    © 2026 BĐS Khánh Hòa · Phát triển bởi Nguyễn Tiến Tài
                </div>
            </aside>

            <main class="login-right">
                <div class="mobile-brand">
                    <img src="/images/logo.png" alt="BĐS Khánh Hòa" />
                    <div>
                        <p class="brand-title text-dark">BĐS Khánh Hòa</p>
                        <div class="brand-sub text-muted">Mua bán · Cho thuê · Dự án</div>
                    </div>
                </div>

                <h2 class="form-title">Đăng nhập</h2>
                <p class="form-sub">
                    Nhập Email hoặc tên đăng nhập cùng mật khẩu để tiếp tục.
                </p>

                <form asp-action="Login" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label">
                            Email hoặc tên đăng nhập
                        </label>
                        <div class="input-shell">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="AccountName"
                                   class="form-control auth-control"
                                   placeholder="Nhập Email hoặc tên đăng nhập"
                                   autocomplete="username" />
                        </div>
                        <span asp-validation-for="AccountName" class="validation-message"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            Mật khẩu
                        </label>
                        <div class="input-group">
                            <div class="input-shell flex-grow-1">
                                <i class="bi bi-lock input-icon"></i>
                                <input asp-for="Password"
                                       type="password"
                                       id="loginPassword"
                                       class="form-control auth-control"
                                       placeholder="Nhập mật khẩu"
                                       autocomplete="current-password" />
                            </div>
                            <button type="button"
                                    class="btn toggle-pass-btn"
                                    onclick="toggleLoginPassword()">
                                <i class="bi bi-eye-slash" id="loginPasswordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="validation-message"></span>
                    </div>

                    <div class="d-flex login-options justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">
                                Duy trì đăng nhập
                            </label>
                        </div>

                        <a href="/Account/ForgotPassword" class="forgot-link">
                            Quên mật khẩu?
                        </a>
                    </div>

                    <button type="submit" class="btn btn-login w-100">
                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Đăng nhập ngay
                    </button>

                    <div class="auth-divider">
                        Hoặc đăng nhập bằng
                    </div>

                    <a href="/Account/LoginGoogle" class="google-btn">
                        <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
                             alt="Google"
                             width="20"
                             height="20" />
                        <span>Đăng nhập với Google</span>
                    </a>

                    <div class="text-center mt-4">
                        <span class="text-muted small">Chưa có tài khoản?</span>
                        <a href="/Account/Register" class="register-link ms-1">Đăng ký ngay</a>
                    </div>
                </form>
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function toggleLoginPassword() {
            const input = document.getElementById("loginPassword");
            const icon = document.getElementById("loginPasswordIcon");

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }
        }

        @if (TempData["Success"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: '@Html.Raw(TempData["Success"])',
                        confirmButtonColor: '#2563eb',
                        timer: 4500
                    });
                </text>
        }

        @if (TempData["Error"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Thông báo',
                        text: '@Html.Raw(TempData["Error"])',
                        confirmButtonColor: '#dc2626'
                    });
                </text>
        }

        @if (TempData["Warning"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'warning',
                        title: 'Cần xác thực Email',
                        text: '@Html.Raw(TempData["Warning"])',
                        confirmButtonColor: '#f59e0b'
                    });
                </text>
        }
    </script>
</body>
</html>