@model BDSKhanhHoa.ViewModels.RegisterViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký thành viên | Bất Động Sản Khánh Hòa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --auth-bg: #f4f7fb;
            --auth-card: #ffffff;
            --auth-text: #0f172a;
            --auth-muted: #64748b;
            --auth-border: #e5e7eb;
            --auth-primary: #2563eb;
            --auth-primary-dark: #1d4ed8;
            --auth-purple: #7c3aed;
            --auth-danger: #dc2626;
            --auth-radius: 26px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: radial-gradient(circle at 12% 0%, rgba(37, 99, 235, .13), transparent 28%), radial-gradient(circle at 92% 8%, rgba(124, 58, 237, .12), transparent 28%), linear-gradient(180deg, #f8fafc 0%, var(--auth-bg) 100%);
            font-family: 'Inter', sans-serif;
            color: var(--auth-text);
        }

        h1, h2, h3, h4, h5, h6, .btn, .brand-title {
            font-family: 'Sora', sans-serif;
        }

        .auth-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 34px 16px;
        }

        .auth-shell {
            width: min(1120px, 100%);
            display: grid;
            grid-template-columns: .92fr 1.25fr;
            background: rgba(255,255,255,.78);
            border: 1px solid rgba(226,232,240,.86);
            border-radius: 32px;
            box-shadow: 0 24px 70px rgba(15,23,42,.13);
            overflow: hidden;
            backdrop-filter: blur(18px);
        }

        .auth-left {
            position: relative;
            overflow: hidden;
            padding: 42px;
            color: #fff;
            background: radial-gradient(circle at 18% 14%, rgba(255,255,255,.22), transparent 20%), radial-gradient(circle at 88% 12%, rgba(14,165,233,.35), transparent 28%), linear-gradient(135deg, #020617 0%, #1e3a8a 54%, #312e81 100%);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 690px;
        }

            .auth-left::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
                background-size: 38px 38px;
                opacity: .76;
            }

        .auth-left-content,
        .auth-left-footer {
            position: relative;
            z-index: 2;
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 36px;
        }

            .brand-row img {
                width: 52px;
                height: 52px;
                object-fit: contain;
                border-radius: 18px;
                background: rgba(255,255,255,.95);
                padding: 6px;
            }

        .brand-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 850;
            line-height: 1.18;
        }

        .brand-sub {
            color: rgba(255,255,255,.68);
            font-size: .8rem;
            margin-top: 3px;
            font-weight: 650;
        }

        .auth-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.16);
            color: rgba(255,255,255,.9);
            font-size: .76rem;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .auth-left-title {
            font-size: clamp(1.6rem, 3vw, 2.55rem);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.045em;
            margin-bottom: 12px;
        }

        .auth-left-desc {
            color: rgba(255,255,255,.72);
            line-height: 1.7;
            font-size: .94rem;
            margin-bottom: 26px;
        }

        .benefit-list {
            display: grid;
            gap: 12px;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 14px;
            border-radius: 18px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(10px);
            font-weight: 750;
            font-size: .88rem;
        }

            .benefit-item i {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                background: rgba(255,255,255,.16);
                color: #bfdbfe;
                flex: 0 0 auto;
            }

        .auth-left-footer {
            color: rgba(255,255,255,.62);
            font-size: .8rem;
            line-height: 1.6;
        }

        .auth-right {
            background: var(--auth-card);
            padding: 34px;
        }

        .mobile-brand {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

            .mobile-brand img {
                width: 44px;
                height: 44px;
                object-fit: contain;
                border-radius: 14px;
                background: #fff;
            }

        .form-heading {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 22px;
        }

        .form-title {
            margin: 0;
            font-size: clamp(1.35rem, 2.4vw, 2rem);
            font-weight: 950;
            letter-spacing: -.04em;
        }

        .form-sub {
            margin: 6px 0 0;
            color: var(--auth-muted);
            font-size: .88rem;
            font-weight: 650;
            line-height: 1.55;
        }

        .step-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 11px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: .76rem;
            font-weight: 850;
            white-space: nowrap;
        }

        .avatar-zone {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 14px;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
            margin-bottom: 18px;
        }

        .avatar-wrapper {
            position: relative;
            flex: 0 0 auto;
        }

        .img-prev {
            width: 72px;
            height: 72px;
            border-radius: 22px;
            object-fit: cover;
            border: 3px solid #fff;
            box-shadow: 0 10px 22px rgba(15,23,42,.12);
            background: #f1f5f9;
        }

        .btn-upload {
            position: absolute;
            right: -7px;
            bottom: -7px;
            width: 32px;
            height: 32px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--auth-primary), var(--auth-purple));
            color: #fff;
            border: 2px solid #fff;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(37,99,235,.25);
        }

        .avatar-info-title {
            font-weight: 900;
            color: var(--auth-text);
            margin-bottom: 3px;
        }

        .avatar-info-sub {
            color: var(--auth-muted);
            font-size: .78rem;
            line-height: 1.5;
            font-weight: 650;
        }

        .form-label {
            font-size: .78rem;
            font-weight: 850;
            color: #334155;
            margin-bottom: 6px;
        }

        .input-shell {
            position: relative;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            left: 13px;
            transform: translateY(-50%);
            color: #94a3b8;
            z-index: 3;
            pointer-events: none;
        }

        .auth-control {
            min-height: 46px;
            border-radius: 15px !important;
            border: 1px solid #e2e8f0;
            background: #fff;
            padding: 11px 13px 11px 40px;
            font-size: .88rem;
            font-weight: 650;
            box-shadow: none !important;
        }

            .auth-control:focus {
                border-color: rgba(37,99,235,.55);
                box-shadow: 0 0 0 4px rgba(37,99,235,.10) !important;
            }

        .password-box {
            position: relative;
        }

        .password-control {
            padding-left: 40px !important;
            padding-right: 48px !important;
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: 999px;
            background: transparent;
            color: #64748b;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            z-index: 5;
        }

            .password-toggle:hover {
                background: #f1f5f9;
                color: #2563eb;
            }

        .validation-message,
        .field-validation-error {
            display: block;
            margin-top: 5px;
            font-size: .74rem;
            font-weight: 750;
            color: var(--auth-danger);
        }

        .password-hint {
            color: var(--auth-muted);
            font-size: .72rem;
            font-weight: 650;
            margin-top: 5px;
        }

        .btn-main {
            min-height: 48px;
            border: none;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--auth-primary), var(--auth-purple));
            color: #fff;
            font-weight: 900;
            letter-spacing: .01em;
            box-shadow: 0 14px 28px rgba(37,99,235,.22);
            transition: .2s ease;
        }

            .btn-main:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 18px 34px rgba(37,99,235,.28);
            }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--auth-muted);
            font-size: .78rem;
            font-weight: 750;
            margin: 18px 0;
        }

            .auth-divider::before,
            .auth-divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: #e5e7eb;
            }

        .login-link {
            color: var(--auth-primary);
            font-weight: 900;
            text-decoration: none;
        }

            .login-link:hover {
                color: var(--auth-primary-dark);
            }

        .mini-policy {
            color: var(--auth-muted);
            font-size: .73rem;
            line-height: 1.55;
            margin-top: 14px;
        }

        #loader {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.82);
            backdrop-filter: blur(8px);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .loader-box {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 24px;
            padding: 26px;
            box-shadow: 0 24px 70px rgba(15,23,42,.16);
        }

        .alert {
            border-radius: 16px;
            font-size: .84rem;
            font-weight: 700;
        }

        @@media (max-width: 991.98px) {
            .auth-shell {
                grid-template-columns: 1fr;
                border-radius: 24px;
            }

            .auth-left {
                display: none;
            }

            .auth-right {
                padding: 24px;
            }

            .mobile-brand {
                display: flex;
            }

            .form-heading {
                flex-direction: column;
            }
        }

        @@media (max-width: 575.98px) {
            .auth-wrapper {
                padding: 14px;
                align-items: flex-start;
            }

            .auth-right {
                padding: 18px;
            }

            .avatar-zone {
                align-items: flex-start;
            }

            .step-pill {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div id="loader">
        <div class="loader-box">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-3 fw-bold">Đang tạo tài khoản và gửi mã OTP...</div>
            <div class="text-muted small mt-1">Vui lòng chờ trong giây lát.</div>
        </div>
    </div>

    <div class="auth-wrapper">
        <div class="auth-shell animate__animated animate__fadeIn">
            <aside class="auth-left">
                <div class="auth-left-content">
                    <div class="brand-row">
                        <img src="/images/logo.png" alt="BĐS Khánh Hòa" />
                        <div>
                            <p class="brand-title">BĐS Khánh Hòa</p>
                            <div class="brand-sub">Mua bán · Cho thuê · Dự án</div>
                        </div>
                    </div>

                    <div class="auth-badge">
                        <i class="bi bi-stars"></i>
                        Thành viên mới
                    </div>

                    <h1 class="auth-left-title">Tạo tài khoản để quản lý bất động sản dễ hơn.</h1>

                    <p class="auth-left-desc">
                        Đăng ký tài khoản để đăng tin, lưu tin yêu thích, đặt lịch xem nhà,
                        theo dõi giao dịch và nhận hỗ trợ từ hệ thống BĐS Khánh Hòa.
                    </p>

                    <div class="benefit-list">
                        <div class="benefit-item">
                            <i class="bi bi-gift-fill"></i>
                            <span>Nhận 5 lượt đăng tin miễn phí sau khi xác thực OTP.</span>
                        </div>

                        <div class="benefit-item">
                            <i class="bi bi-shield-check"></i>
                            <span>Tài khoản được bảo vệ bằng xác thực Email.</span>
                        </div>

                        <div class="benefit-item">
                            <i class="bi bi-house-check-fill"></i>
                            <span>Quản lý tin đăng, lịch hẹn và hồ sơ cá nhân thuận tiện.</span>
                        </div>
                    </div>
                </div>

                <div class="auth-left-footer">
                    © 2026 BĐS Khánh Hòa · Phát triển bởi Nguyễn Tiến Tài
                </div>
            </aside>

            <main class="auth-right">
                <div class="mobile-brand">
                    <img src="/images/logo.png" alt="BĐS Khánh Hòa" />
                    <div>
                        <p class="brand-title text-dark">BĐS Khánh Hòa</p>
                        <div class="brand-sub text-muted">Mua bán · Cho thuê · Dự án</div>
                    </div>
                </div>

                <div class="form-heading">
                    <div>
                        <h2 class="form-title">Tạo tài khoản mới</h2>
                        <p class="form-sub">
                            Điền thông tin chính xác. Email, số điện thoại không được trùng với tài khoản khác.
                        </p>
                    </div>

                    <div class="step-pill">
                        <i class="bi bi-envelope-check"></i>
                        Xác thực OTP
                    </div>
                </div>

                <form asp-action="Register" method="post" enctype="multipart/form-data" id="registerForm" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="avatar-zone">
                        <div class="avatar-wrapper">
                            <img id="imgPreview"
                                 src="/images/avatars/default-user.png"
                                 class="img-prev"
                                 alt="Ảnh đại diện" />

                            <label for="avatarInput" class="btn-upload" title="Chọn ảnh đại diện">
                                <i class="bi bi-camera-fill"></i>
                            </label>

                            <input asp-for="AvatarFile"
                                   type="file"
                                   id="avatarInput"
                                   class="d-none"
                                   accept="image/png,image/jpeg,image/jpg,image/webp" />
                        </div>

                        <div>
                            <div class="avatar-info-title">Ảnh đại diện</div>
                            <div class="avatar-info-sub">
                                Không bắt buộc. Hỗ trợ JPG, PNG, WEBP. Nên dùng ảnh vuông, dung lượng dưới 2MB.
                            </div>
                            <span asp-validation-for="AvatarFile" class="validation-message"></span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label">
                                Họ và tên <span class="text-danger">*</span>
                            </label>

                            <div class="input-shell">
                                <i class="bi bi-person-vcard input-icon"></i>
                                <input asp-for="FullName"
                                       class="form-control auth-control"
                                       placeholder="Ví dụ: Nguyễn Văn An"
                                       maxlength="100"
                                       autocomplete="name" />
                            </div>

                            <span asp-validation-for="FullName" class="validation-message"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Username" class="form-label">
                                Tên đăng nhập <span class="text-danger">*</span>
                            </label>

                            <div class="input-shell">
                                <i class="bi bi-at input-icon"></i>
                                <input asp-for="Username"
                                       class="form-control auth-control"
                                       placeholder="Ví dụ: nguyenvanan"
                                       maxlength="50"
                                       autocomplete="username" />
                            </div>

                            <div class="password-hint">Từ 4 ký tự. Chỉ dùng chữ, số, dấu gạch dưới hoặc dấu chấm.</div>
                            <span asp-validation-for="Username" class="validation-message"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Phone" class="form-label">
                                Số điện thoại <span class="text-danger">*</span>
                            </label>

                            <div class="input-shell">
                                <i class="bi bi-telephone input-icon"></i>
                                <input asp-for="Phone"
                                       class="form-control auth-control num-only"
                                       placeholder="Ví dụ: 0912345678"
                                       maxlength="10"
                                       inputmode="numeric"
                                       autocomplete="tel" />
                            </div>

                            <div class="password-hint">Bắt đầu bằng 03, 05, 07, 08 hoặc 09 và đủ 10 số.</div>
                            <span asp-validation-for="Phone" class="validation-message"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label">
                                Email nhận mã OTP <span class="text-danger">*</span>
                            </label>

                            <div class="input-shell">
                                <i class="bi bi-envelope input-icon"></i>
                                <input asp-for="Email"
                                       class="form-control auth-control"
                                       placeholder="Ví dụ: tenban@gmail.com"
                                       maxlength="100"
                                       autocomplete="email" />
                            </div>

                            <span asp-validation-for="Email" class="validation-message"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Address" class="form-label">
                                Địa chỉ
                            </label>

                            <div class="input-shell">
                                <i class="bi bi-geo-alt input-icon"></i>
                                <input asp-for="Address"
                                       class="form-control auth-control"
                                       placeholder="Nhập địa chỉ liên hệ nếu có"
                                       maxlength="255"
                                       autocomplete="street-address" />
                            </div>

                            <span asp-validation-for="Address" class="validation-message"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Password" class="form-label">
                                Mật khẩu <span class="text-danger">*</span>
                            </label>

                            <div class="password-box">
                                <i class="bi bi-lock input-icon"></i>

                                <input asp-for="Password"
                                       type="password"
                                       id="passwordInput"
                                       class="form-control auth-control password-control"
                                       placeholder="Tối thiểu 6 ký tự"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('passwordInput', 'passwordIcon')"
                                        aria-label="Hiện hoặc ẩn mật khẩu">
                                    <i class="bi bi-eye-slash" id="passwordIcon"></i>
                                </button>
                            </div>

                            <span asp-validation-for="Password" class="validation-message"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">
                                Xác nhận mật khẩu <span class="text-danger">*</span>
                            </label>

                            <div class="password-box">
                                <i class="bi bi-shield-lock input-icon"></i>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       id="confirmPasswordInput"
                                       class="form-control auth-control password-control"
                                       placeholder="Nhập lại mật khẩu"
                                       autocomplete="new-password" />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('confirmPasswordInput', 'confirmPasswordIcon')"
                                        aria-label="Hiện hoặc ẩn xác nhận mật khẩu">
                                    <i class="bi bi-eye-slash" id="confirmPasswordIcon"></i>
                                </button>
                            </div>

                            <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
                        </div>
                    </div>

                    <div class="mini-policy">
                        Bằng việc đăng ký, bạn đồng ý sử dụng thông tin chính xác và tuân thủ quy định đăng tin của BĐS Khánh Hòa.
                    </div>

                    <button type="submit" class="btn btn-main w-100 mt-3">
                        <i class="bi bi-send-fill me-2"></i>
                        Đăng ký & nhận mã OTP
                    </button>

                    <div class="auth-divider">Hoặc</div>

                    <div class="text-center">
                        <span class="text-muted small">Đã có tài khoản?</span>
                        <a href="/Account/Login" class="login-link ms-1">Đăng nhập ngay</a>
                    </div>
                </form>
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        const avatarInput = document.getElementById("avatarInput");
        const imgPreview = document.getElementById("imgPreview");

        if (avatarInput && imgPreview) {
            avatarInput.addEventListener("change", function () {
                const file = this.files && this.files[0];

                if (!file) return;

                const allowedTypes = ["image/jpeg", "image/jpg", "image/png", "image/webp"];

                if (!allowedTypes.includes(file.type)) {
                    alert("Ảnh đại diện chỉ hỗ trợ JPG, PNG hoặc WEBP.");
                    this.value = "";
                    imgPreview.src = "/images/avatars/default-user.png";
                    return;
                }

                if (file.size > 2 * 1024 * 1024) {
                    alert("Ảnh đại diện không được vượt quá 2MB.");
                    this.value = "";
                    imgPreview.src = "/images/avatars/default-user.png";
                    return;
                }

                imgPreview.src = URL.createObjectURL(file);
            });
        }

        function togglePassword(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            if (!input || !icon) return;

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("bi-eye-slash");
                icon.classList.add("bi-eye");
            } else {
                input.type = "password";
                icon.classList.remove("bi-eye");
                icon.classList.add("bi-eye-slash");
            }
        }

        $(".num-only").on("input", function () {
            this.value = this.value.replace(/[^0-9]/g, "").substring(0, 10);
        });

        $("#registerForm").on("submit", function () {
            if ($(this).valid()) {
                $("#loader").css("display", "flex");
            }
        });
    </script>
</body>
</html>