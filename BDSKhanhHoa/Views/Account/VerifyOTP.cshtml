@{
    ViewData["Title"] = "Xác thực Email";
    Layout = null;

    string emailToVerify = Convert.ToString(ViewBag.EmailToVerify);

    if (string.IsNullOrWhiteSpace(emailToVerify))
    {
        emailToVerify = Convert.ToString(TempData["EmailToVerify"]);
    }

    if (string.IsNullOrWhiteSpace(emailToVerify))
    {
        emailToVerify = "Email của bạn";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Xác thực OTP | BĐS Khánh Hòa</title>

    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --otp-bg: #f4f7fb;
            --otp-card: #ffffff;
            --otp-text: #0f172a;
            --otp-muted: #64748b;
            --otp-border: #e5e7eb;
            --otp-primary: #2563eb;
            --otp-primary-dark: #1d4ed8;
            --otp-purple: #7c3aed;
            --otp-success: #16a34a;
            --otp-danger: #dc2626;
            --otp-warning: #f59e0b;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: radial-gradient(circle at 10% 0%, rgba(37,99,235,.13), transparent 28%), radial-gradient(circle at 90% 8%, rgba(124,58,237,.13), transparent 30%), linear-gradient(180deg, #f8fafc 0%, var(--otp-bg) 100%);
            font-family: 'Inter', sans-serif;
            color: var(--otp-text);
        }

        h1,
        h2,
        h3,
        .btn {
            font-family: 'Sora', sans-serif;
        }

        .otp-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 26px 14px;
        }

        .otp-shell {
            width: min(980px, 100%);
            display: grid;
            grid-template-columns: .95fr 1.05fr;
            background: rgba(255,255,255,.82);
            border: 1px solid rgba(226,232,240,.9);
            border-radius: 32px;
            box-shadow: 0 24px 70px rgba(15,23,42,.14);
            overflow: hidden;
            backdrop-filter: blur(18px);
        }

        .otp-left {
            position: relative;
            overflow: hidden;
            color: #fff;
            padding: 42px;
            background: radial-gradient(circle at 18% 12%, rgba(255,255,255,.22), transparent 20%), radial-gradient(circle at 88% 12%, rgba(14,165,233,.32), transparent 28%), linear-gradient(135deg, #020617 0%, #1e3a8a 54%, #312e81 100%);
            min-height: 560px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .otp-left::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
                background-size: 38px 38px;
                opacity: .76;
            }

        .otp-left-content {
            position: relative;
            z-index: 2;
        }

        .brand-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 36px;
        }

        .brand-logo {
            width: 52px;
            height: 52px;
            border-radius: 18px;
            object-fit: contain;
            background: rgba(255,255,255,.96);
            padding: 6px;
        }

        .brand-title {
            margin: 0;
            font-weight: 900;
            font-size: 1.05rem;
            line-height: 1.2;
        }

        .brand-sub {
            color: rgba(255,255,255,.68);
            font-size: .8rem;
            margin-top: 3px;
            font-weight: 650;
        }

        .otp-badge {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.13);
            border: 1px solid rgba(255,255,255,.16);
            color: rgba(255,255,255,.9);
            font-size: .76rem;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .otp-left-title {
            font-size: clamp(1.6rem, 3vw, 2.45rem);
            font-weight: 950;
            line-height: 1.08;
            letter-spacing: -.045em;
            margin-bottom: 12px;
        }

        .otp-left-desc {
            color: rgba(255,255,255,.72);
            line-height: 1.75;
            font-size: .94rem;
            margin: 0;
        }

        .secure-list {
            display: grid;
            gap: 12px;
            margin-top: 26px;
        }

        .secure-item {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 14px;
            border-radius: 18px;
            background: rgba(255,255,255,.10);
            border: 1px solid rgba(255,255,255,.12);
            backdrop-filter: blur(10px);
            font-size: .86rem;
            font-weight: 750;
        }

            .secure-item i {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                display: grid;
                place-items: center;
                background: rgba(255,255,255,.16);
                color: #bfdbfe;
                flex: 0 0 auto;
            }

        .otp-left-footer {
            position: relative;
            z-index: 2;
            color: rgba(255,255,255,.62);
            font-size: .8rem;
            line-height: 1.6;
        }

        .otp-right {
            padding: 42px;
            background: var(--otp-card);
            display: flex;
            align-items: center;
        }

        .otp-form-card {
            width: 100%;
        }

        .mobile-brand {
            display: none;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
        }

            .mobile-brand img {
                width: 44px;
                height: 44px;
                border-radius: 14px;
                object-fit: contain;
            }

        .otp-icon {
            width: 72px;
            height: 72px;
            border-radius: 24px;
            display: grid;
            place-items: center;
            margin-bottom: 18px;
            background: #eff6ff;
            color: var(--otp-primary);
            font-size: 2rem;
        }

        .otp-title {
            margin: 0;
            font-size: clamp(1.45rem, 2.6vw, 2.05rem);
            font-weight: 950;
            letter-spacing: -.04em;
        }

        .otp-desc {
            margin: 8px 0 0;
            color: var(--otp-muted);
            font-size: .9rem;
            line-height: 1.65;
            font-weight: 650;
        }

        .email-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 11px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: .82rem;
            font-weight: 850;
            margin-top: 12px;
            max-width: 100%;
        }

            .email-pill span {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .otp-inputs {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 10px;
            margin: 28px 0 18px;
        }

            .otp-inputs input {
                width: 100%;
                height: 58px;
                text-align: center;
                font-size: 1.35rem;
                font-weight: 900;
                border-radius: 16px;
                border: 2px solid #e2e8f0;
                background: #f8fafc;
                color: var(--otp-text);
                outline: none;
                transition: .18s ease;
            }

                .otp-inputs input:focus {
                    border-color: var(--otp-primary);
                    background: #fff;
                    box-shadow: 0 0 0 4px rgba(37,99,235,.10);
                }

        .btn-verify {
            width: 100%;
            min-height: 50px;
            border: 0;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--otp-primary), var(--otp-purple));
            color: #fff;
            font-weight: 950;
            box-shadow: 0 14px 28px rgba(37,99,235,.22);
            transition: .2s ease;
        }

            .btn-verify:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 18px 34px rgba(37,99,235,.28);
            }

        .otp-actions {
            margin-top: 18px;
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .link-btn {
            border: 0;
            background: transparent;
            color: var(--otp-primary);
            font-weight: 900;
            font-size: .84rem;
            padding: 0;
            text-decoration: none;
        }

            .link-btn:hover {
                color: var(--otp-primary-dark);
            }

        .alert {
            border-radius: 16px;
            font-size: .84rem;
            font-weight: 750;
            margin-top: 18px;
        }

        .note-box {
            margin-top: 18px;
            padding: 12px 14px;
            border-radius: 16px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            font-size: .78rem;
            line-height: 1.55;
            font-weight: 700;
        }

        @@media (max-width: 991.98px) {
            .otp-shell {
                grid-template-columns: 1fr;
                border-radius: 24px;
            }

            .otp-left {
                display: none;
            }

            .otp-right {
                padding: 28px;
            }

            .mobile-brand {
                display: flex;
            }
        }

        @@media (max-width: 575.98px) {
            .otp-wrapper {
                padding: 14px;
                align-items: flex-start;
            }

            .otp-right {
                padding: 20px;
            }

            .otp-inputs {
                gap: 7px;
            }

                .otp-inputs input {
                    height: 50px;
                    font-size: 1.1rem;
                    border-radius: 13px;
                }

            .otp-actions {
                flex-direction: column;
                align-items: stretch;
            }

            .link-btn {
                text-align: center;
            }
        }
    </style>
</head>

<body>
    <div class="otp-wrapper">
        <div class="otp-shell animate__animated animate__fadeIn">
            <aside class="otp-left">
                <div class="otp-left-content">
                    <div class="brand-row">
                        <img src="/images/logo.png" alt="BĐS Khánh Hòa" class="brand-logo" />
                        <div>
                            <p class="brand-title">BĐS Khánh Hòa</p>
                            <div class="brand-sub">Mua bán · Cho thuê · Dự án</div>
                        </div>
                    </div>

                    <div class="otp-badge">
                        <i class="bi bi-shield-lock-fill"></i>
                        Bảo mật tài khoản
                    </div>

                    <h1 class="otp-left-title">Xác thực Email để mở khóa tài khoản.</h1>

                    <p class="otp-left-desc">
                        Tài khoản mới đăng ký sẽ ở trạng thái chưa xác thực và chưa được phép hoạt động
                        cho đến khi nhập đúng mã OTP.
                    </p>

                    <div class="secure-list">
                        <div class="secure-item">
                            <i class="bi bi-envelope-check-fill"></i>
                            <span>OTP được gửi đến Email đăng ký của bạn.</span>
                        </div>
                        <div class="secure-item">
                            <i class="bi bi-person-check-fill"></i>
                            <span>Xác thực thành công thì tài khoản mới được mở khóa.</span>
                        </div>
                        <div class="secure-item">
                            <i class="bi bi-gift-fill"></i>
                            <span>Nhận 5 lượt đăng tin miễn phí sau khi xác thực.</span>
                        </div>
                    </div>
                </div>

                <div class="otp-left-footer">
                    © 2026 BĐS Khánh Hòa · Phát triển bởi Nguyễn Tiến Tài
                </div>
            </aside>

            <main class="otp-right">
                <div class="otp-form-card">
                    <div class="mobile-brand">
                        <img src="/images/logo.png" alt="BĐS Khánh Hòa" />
                        <div>
                            <p class="brand-title text-dark">BĐS Khánh Hòa</p>
                            <div class="brand-sub text-muted">Mua bán · Cho thuê · Dự án</div>
                        </div>
                    </div>

                    <div class="otp-icon">
                        <i class="bi bi-envelope-check-fill"></i>
                    </div>

                    <h2 class="otp-title">Xác thực tài khoản</h2>

                    <p class="otp-desc">
                        Nhập mã OTP gồm 6 số đã được gửi đến Email của bạn.
                    </p>

                    <div class="email-pill">
                        <i class="bi bi-envelope"></i>
                        <span>@emailToVerify</span>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @ViewBag.Error
                        </div>
                    }

                    @if (TempData["Warning"] != null)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-info-circle-fill me-1"></i>
                            @TempData["Warning"]
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle-fill me-1"></i>
                            @TempData["Error"]
                        </div>
                    }

                    <form asp-action="VerifyOTP" method="post" id="otpForm" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="otp" id="fullOtp" />

                        <div class="otp-inputs" id="otpContainer">
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autofocus />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
                            <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" />
                        </div>

                        <button type="submit" class="btn btn-verify">
                            <i class="bi bi-shield-check me-2"></i>
                            Xác thực và mở khóa tài khoản
                        </button>
                    </form>

                    <div class="otp-actions">
                        <form asp-action="ResendOTP" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="link-btn">
                                <i class="bi bi-arrow-repeat me-1"></i>
                                Gửi lại mã OTP
                            </button>
                        </form>

                        <a href="/Account/Login" class="link-btn">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Quay lại đăng nhập
                        </a>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <script>
        const inputs = document.querySelectorAll(".otp-inputs input");
        const hiddenInput = document.getElementById("fullOtp");
        const otpForm = document.getElementById("otpForm");

        function updateHiddenInput() {
            hiddenInput.value = Array.from(inputs).map(input => input.value).join("");
        }

        inputs.forEach((input, index) => {
            input.addEventListener("input", function () {
                this.value = this.value.replace(/[^0-9]/g, "");

                if (this.value.length === 1 && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }

                updateHiddenInput();
            });

            input.addEventListener("keydown", function (event) {
                if (event.key === "Backspace" && this.value === "" && index > 0) {
                    inputs[index - 1].focus();
                }
            });

            input.addEventListener("paste", function (event) {
                event.preventDefault();

                const pastedValue = (event.clipboardData || window.clipboardData)
                    .getData("text")
                    .replace(/[^0-9]/g, "")
                    .slice(0, 6);

                if (!pastedValue) {
                    return;
                }

                inputs.forEach((otpInput, otpIndex) => {
                    otpInput.value = pastedValue[otpIndex] || "";
                });

                updateHiddenInput();

                const nextIndex = Math.min(pastedValue.length, inputs.length) - 1;

                if (nextIndex >= 0) {
                    inputs[nextIndex].focus();
                }
            });
        });

        otpForm.addEventListener("submit", function (event) {
            updateHiddenInput();

            if (!hiddenInput.value || hiddenInput.value.length !== 6) {
                event.preventDefault();
                alert("Vui lòng nhập đầy đủ mã OTP gồm 6 số.");
            }
        });
    </script>
</body>
</html>