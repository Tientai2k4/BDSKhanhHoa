@{
    ViewData["Title"] = "Không tìm thấy nội dung";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .notfound-page {
        min-height: calc(100vh - 90px);
        background: radial-gradient(circle at top right, rgba(37, 99, 235, .10), transparent 360px), #f8fafc;
        display: flex;
        align-items: center;
        padding: 60px 0;
    }

    .notfound-card {
        max-width: 760px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid rgba(148, 163, 184, .24);
        border-radius: 34px;
        padding: 48px;
        text-align: center;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .08);
    }

    .notfound-icon {
        width: 104px;
        height: 104px;
        border-radius: 34px;
        margin: 0 auto 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 3rem;
        box-shadow: 0 16px 36px rgba(37, 99, 235, .14);
    }

    .notfound-title {
        color: #0f172a;
        font-size: clamp(1.8rem, 4vw, 2.8rem);
        font-weight: 950;
        letter-spacing: -.045em;
        margin-bottom: 12px;
    }

    .notfound-desc {
        color: #64748b;
        font-size: 1.02rem;
        font-weight: 600;
        line-height: 1.65;
        max-width: 560px;
        margin: 0 auto 26px;
    }

    .notfound-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .notfound-btn {
        min-height: 46px;
        border-radius: 999px;
        padding: 10px 20px;
        font-weight: 900;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
    }

    @@media (max-width: 575.98px) {
        .notfound-page {
            padding: 36px 12px;
            align-items: flex-start;
        }

        .notfound-card {
            border-radius: 26px;
            padding: 34px 22px;
        }

        .notfound-icon {
            width: 84px;
            height: 84px;
            border-radius: 28px;
            font-size: 2.45rem;
        }

        .notfound-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

        .notfound-btn {
            width: 100%;
            border-radius: 16px;
        }
    }
</style>

<div class="notfound-page">
    <div class="container">
        <div class="notfound-card">
            <div class="notfound-icon">
                <i class="bi bi-file-earmark-x"></i>
            </div>

            <h1 class="notfound-title">Không tìm thấy trang</h1>

            <p class="notfound-desc">
                Nội dung bạn đang tìm kiếm không tồn tại, đã bị gỡ bỏ hoặc đường dẫn đã thay đổi.
                Bạn có thể quay về trang chủ hoặc liên hệ hỗ trợ để được kiểm tra thêm.
            </p>

            <div class="notfound-actions">
                <a href="/" class="btn btn-primary notfound-btn">
                    <i class="bi bi-house-door-fill"></i>
                    Về trang chủ
                </a>

                <a href="/Contact" class="btn btn-light border notfound-btn">
                    <i class="bi bi-headset"></i>
                    Liên hệ hỗ trợ
                </a>
            </div>
        </div>
    </div>
</div>