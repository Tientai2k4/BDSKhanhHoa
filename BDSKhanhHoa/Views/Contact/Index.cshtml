@model BDSKhanhHoa.Models.ContactMessage
@{
    ViewData["Title"] = "Liên Hệ - BĐS Khánh Hòa";
}

<style>
    :root {
        --contact-primary: #2563eb;
        --contact-primary-2: #0ea5e9;
        --contact-dark: #0f172a;
        --contact-muted: #64748b;
        --contact-border: #e2e8f0;
        --contact-soft: #f8fafc;
        --contact-card: #ffffff;
        --contact-radius: 20px;
        --contact-shadow: 0 14px 34px rgba(15, 23, 42, .07);
    }

    .contact-page {
        padding-bottom: 42px;
        color: var(--contact-dark);
    }

    .contact-hero {
        position: relative;
        margin-top: -20px;
        margin-bottom: 22px;
        padding: 56px 0 50px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15, 23, 42, .86), rgba(37, 99, 235, .82)), url('/images/banners/nha-trang-city.jpg') center/cover no-repeat;
        border-radius: 0 0 30px 30px;
    }

        .contact-hero::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -70px;
            top: -80px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .13);
        }

    .contact-hero-inner {
        position: relative;
        z-index: 1;
        max-width: 760px;
        margin: 0 auto;
        text-align: center;
        padding: 0 14px;
    }

    .contact-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 13px;
        border-radius: 999px;
        background: rgba(255, 255, 255, .95);
        color: var(--contact-primary);
        font-size: .78rem;
        font-weight: 900;
        box-shadow: 0 10px 20px rgba(15, 23, 42, .12);
        margin-bottom: 12px;
    }

    .contact-title {
        margin: 0;
        color: #fff;
        font-size: clamp(1.8rem, 4vw, 3rem);
        font-weight: 950;
        letter-spacing: -.04em;
        line-height: 1.12;
    }

    .contact-subtitle {
        max-width: 620px;
        margin: 12px auto 0;
        color: rgba(255, 255, 255, .84);
        font-size: 1rem;
        line-height: 1.65;
        font-weight: 500;
    }

    .contact-wrap {
        max-width: 1160px;
        margin: 0 auto;
        padding: 0 14px;
    }

    .contact-card {
        height: 100%;
        background: var(--contact-card);
        border: 1px solid var(--contact-border);
        border-radius: var(--contact-radius);
        box-shadow: var(--contact-shadow);
        overflow: hidden;
    }

    .contact-card-head {
        padding: 22px 24px 14px;
    }

    .contact-card-title {
        margin: 0;
        color: var(--contact-dark);
        font-size: 1.22rem;
        font-weight: 950;
        letter-spacing: -.02em;
    }

    .contact-card-desc {
        margin: 7px 0 0;
        color: var(--contact-muted);
        font-size: .9rem;
        line-height: 1.55;
    }

    .contact-info-list {
        padding: 0 24px 20px;
    }

    .contact-info-item {
        display: grid;
        grid-template-columns: 46px minmax(0, 1fr);
        gap: 12px;
        align-items: center;
        padding: 13px 0;
        border-top: 1px solid #eef2f7;
    }

    .contact-icon {
        width: 46px;
        height: 46px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        background: #eff6ff;
        color: var(--contact-primary);
        font-size: 1.12rem;
        flex-shrink: 0;
    }

    .contact-info-title {
        margin: 0 0 3px;
        color: var(--contact-dark);
        font-size: .92rem;
        font-weight: 900;
    }

    .contact-info-text {
        margin: 0;
        color: var(--contact-muted);
        font-size: .84rem;
        line-height: 1.45;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .contact-map {
        height: 210px;
        border-top: 1px solid var(--contact-border);
        background: #eef2f7;
    }

        .contact-map iframe {
            width: 100%;
            height: 100%;
            border: 0;
            display: block;
        }

    .contact-form-card {
        padding: 24px;
    }

    .contact-form-title {
        margin: 0;
        color: var(--contact-dark);
        font-size: 1.24rem;
        font-weight: 950;
        letter-spacing: -.02em;
    }

    .contact-form-desc {
        margin: 7px 0 20px;
        color: var(--contact-muted);
        font-size: .9rem;
        line-height: 1.55;
    }

    .contact-label {
        margin-bottom: 7px;
        color: #1e293b;
        font-size: .86rem;
        font-weight: 850;
    }

    .form-control-custom {
        min-height: 46px;
        border-radius: 14px;
        border: 1px solid #dbe4ef;
        padding: 11px 14px;
        font-size: .92rem;
        font-weight: 650;
        color: var(--contact-dark);
        background: var(--contact-soft);
        box-shadow: none !important;
        transition: .18s ease;
    }

        .form-control-custom:focus {
            border-color: #93c5fd;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
        }

    textarea.form-control-custom {
        min-height: 132px;
        line-height: 1.58;
        resize: vertical;
    }

    .contact-submit-btn {
        min-height: 50px;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--contact-primary), var(--contact-primary-2));
        color: #fff;
        font-weight: 950;
        box-shadow: 0 12px 24px rgba(37, 99, 235, .22);
    }

        .contact-submit-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            filter: brightness(1.02);
        }

    .contact-alert {
        border: 0;
        border-radius: 15px;
        padding: 12px 14px;
        font-weight: 800;
        font-size: .9rem;
    }

    @@media (max-width: 991.98px) {
        .contact-hero {
            padding: 44px 0 38px;
            border-radius: 0 0 24px 24px;
            margin-bottom: 16px;
            background-attachment: scroll;
        }

        .contact-card-head,
        .contact-info-list,
        .contact-form-card {
            padding-left: 18px;
            padding-right: 18px;
        }

        .contact-map {
            height: 190px;
        }
    }

    @@media (max-width: 575.98px) {
        .contact-page {
            padding-bottom: 26px;
        }

        .contact-hero {
            margin-top: -12px;
            padding: 28px 0 26px;
            border-radius: 0 0 18px 18px;
        }

        .contact-badge {
            padding: 6px 11px;
            font-size: .72rem;
            margin-bottom: 9px;
        }

        .contact-title {
            font-size: 1.55rem;
        }

        .contact-subtitle {
            margin-top: 8px;
            font-size: .84rem;
            line-height: 1.45;
        }

        .contact-wrap {
            padding: 0 10px;
        }

        .contact-card {
            border-radius: 17px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .055);
        }

        .contact-card-head {
            padding: 16px 16px 8px;
        }

        .contact-card-title,
        .contact-form-title {
            font-size: 1.05rem;
        }

        .contact-card-desc,
        .contact-form-desc {
            font-size: .8rem;
            line-height: 1.45;
        }

        .contact-info-list {
            padding: 0 16px 14px;
        }

        .contact-info-item {
            grid-template-columns: 38px minmax(0, 1fr);
            gap: 10px;
            padding: 10px 0;
        }

        .contact-icon {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            font-size: .98rem;
        }

        .contact-info-title {
            font-size: .84rem;
        }

        .contact-info-text {
            font-size: .76rem;
        }

        .contact-map {
            height: 150px;
        }

        .contact-form-card {
            padding: 16px;
        }

        .contact-form-desc {
            margin-bottom: 14px;
        }

        .contact-label {
            font-size: .8rem;
            margin-bottom: 5px;
        }

        .form-control-custom {
            min-height: 42px;
            border-radius: 12px;
            padding: 9px 12px;
            font-size: .84rem;
        }

        textarea.form-control-custom {
            min-height: 108px;
        }

        .contact-submit-btn {
            min-height: 46px;
            font-size: .9rem !important;
        }

        .contact-alert {
            padding: 10px 12px;
            font-size: .82rem;
        }
    }
</style>

<div class="contact-page">
    <section class="contact-hero animate__animated animate__fadeIn">
        <div class="contact-hero-inner">
            <span class="contact-badge">
                <i class="bi bi-headset"></i>
                Hỗ trợ 24/7
            </span>
            <h1 class="contact-title">Liên hệ BĐS Khánh Hòa</h1>
            <p class="contact-subtitle">
                Cần tư vấn mua bán, ký gửi hoặc hỗ trợ tài khoản? Gửi thông tin, chúng tôi sẽ liên hệ lại sớm nhất.
            </p>
        </div>
    </section>

    <div class="contact-wrap">
        <div class="row g-3 g-lg-4">
            <div class="col-lg-5 animate__animated animate__fadeInLeft">
                <div class="contact-card">
                    <div class="contact-card-head">
                        <h3 class="contact-card-title">Thông tin liên hệ</h3>
                        <p class="contact-card-desc">Các kênh hỗ trợ chính của hệ thống.</p>
                    </div>

                    <div class="contact-info-list">
                        <div class="contact-info-item">
                            <div class="contact-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h6 class="contact-info-title">Trụ sở làm việc</h6>
                                <p class="contact-info-text">Nha Trang, Khánh Hòa.</p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-icon">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <h6 class="contact-info-title">Hotline hỗ trợ</h6>
                                <p class="contact-info-text text-primary fw-bold">1900 1234 - 0987 654 321</p>
                            </div>
                        </div>

                        <div class="contact-info-item">
                            <div class="contact-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div>
                                <h6 class="contact-info-title">Email CSKH</h6>
                                <p class="contact-info-text">support@bdskhanhhoa.vn</p>
                            </div>
                        </div>
                    </div>

                    <div class="contact-map">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3898.749007671239!2d109.20018721475516!3d12.265261491321743!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3170677811cc886f%3A0x5c4bbc0aa81edcb9!2zVHLGsOG7nW5nIMSQ4bqhaSBI4buNYyBOaGEgVHJhbmc!5e0!3m2!1svi!2s!4v1700000000000!5m2!1svi!2s"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 animate__animated animate__fadeInRight">
                <div class="contact-card contact-form-card">
                    <h3 class="contact-form-title">Gửi tin nhắn nhanh</h3>
                    <p class="contact-form-desc">Để lại thông tin, chuyên viên sẽ gọi lại để hỗ trợ.</p>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show contact-alert d-flex align-items-center" role="alert">
                            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger contact-alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-controller="Contact" asp-action="Index" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label contact-label">Họ và tên <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control form-control-custom" placeholder="Nhập họ tên..." />
                                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label contact-label">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control form-control-custom" placeholder="Nhập số điện thoại..." />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label contact-label">Email</label>
                                <input asp-for="Email" class="form-control form-control-custom" placeholder="Nhập email..." />
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label contact-label">Chủ đề</label>
                                <input asp-for="Subject" class="form-control form-control-custom" placeholder="Bạn cần hỏi gì?" />
                            </div>

                            <div class="col-12">
                                <label class="form-label contact-label">Nội dung chi tiết <span class="text-danger">*</span></label>
                                <textarea asp-for="Message" class="form-control form-control-custom" rows="4" placeholder="Viết nội dung cần trao đổi..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small mt-1 d-block fw-semibold"></span>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn contact-submit-btn w-100 d-flex justify-content-center align-items-center">
                                    <i class="bi bi-send-fill me-2"></i>
                                    Gửi yêu cầu
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
