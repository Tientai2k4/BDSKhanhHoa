@model IEnumerable<BDSKhanhHoa.Models.ProjectLead>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Yêu cầu tư vấn từ khách hàng";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    var leads = Model?.ToList() ?? new List<BDSKhanhHoa.Models.ProjectLead>();

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string? currentStatus = ViewBag.CurrentStatus as string;
    string? currentDateRange = ViewBag.CurrentDateRange as string;
    string currentKeyword = ViewBag.CurrentKeyword as string ?? "";
    int? currentProjectId = ViewBag.CurrentProjectId is int pid ? pid : null;

    int totalLeads = ViewBag.TotalLeads ?? leads.Count;
    int newLeads = ViewBag.NewLeads ?? 0;
    int contactedLeads = ViewBag.ContactedLeads ?? 0;
    int resolvedLeads = ViewBag.ResolvedLeads ?? 0;
    int invalidLeads = ViewBag.InvalidLeads ?? 0;
    int totalFilteredItems = ViewBag.TotalFilteredItems ?? leads.Count;

    string currentUrl = Context.Request.Path + Context.Request.QueryString;
}

@functions {
    public string LeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Khách mới";
        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string LeadStatusClass(string? status)
    {
        return LeadStatusText(status) switch
        {
            "Khách mới" => "st-new",
            "Đang chăm sóc" => "st-contacted",
            "Đã chốt" => "st-resolved",
            "Không hợp lệ" => "st-invalid",
            _ => "st-unknown"
        };
    }

    public bool IsClosedLead(string? status)
    {
        string text = LeadStatusText(status);
        return text == "Đã chốt" || text == "Không hợp lệ";
    }

    public string SafeText(string? value, string fallback = "Chưa cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }

    public string ShortText(string? value, int max = 110)
    {
        if (string.IsNullOrWhiteSpace(value)) return "Không có ghi chú.";
        value = value.Trim();
        return value.Length <= max ? value : value.Substring(0, max) + "...";
    }
}

@section Styles {
    <style>
        :root {
            --crm-primary: #2563eb;
            --crm-primary-dark: #1d4ed8;
            --crm-success: #059669;
            --crm-warning: #d97706;
            --crm-danger: #dc2626;
            --crm-dark: #0f172a;
            --crm-muted: #64748b;
            --crm-border: #e2e8f0;
            --crm-soft: #f8fafc;
            --crm-card: #fff;
            --crm-shadow: 0 14px 34px rgba(15,23,42,.07);
        }

        .crm-page {
            display: flex;
            flex-direction: column;
            gap: 16px;
            max-width: 100%;
            overflow-x: hidden;
        }

        .crm-hero, .crm-filter, .crm-list-wrap, .crm-empty {
            background: var(--crm-card);
            border: 1px solid rgba(148,163,184,.24);
            border-radius: 22px;
            box-shadow: var(--crm-shadow);
            overflow: hidden;
        }

        .crm-hero {
            padding: 22px;
            background: radial-gradient(circle at top right,rgba(37,99,235,.14),transparent 280px),#fff;
        }

        .crm-title {
            margin: 0 0 6px;
            color: var(--crm-dark);
            font-weight: 950;
            letter-spacing: -.04em;
            font-size: clamp(1.25rem,2.2vw,1.9rem);
        }

        .crm-subtitle {
            margin: 0;
            color: var(--crm-muted);
            font-weight: 650;
            line-height: 1.55;
            max-width: 900px;
        }

        .crm-top {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .crm-actions {
            display: flex;
            gap: 9px;
            flex-wrap: wrap;
        }

        .crm-pill, .crm-btn {
            min-height: 42px;
            border-radius: 999px;
            padding: 8px 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 900;
            text-decoration: none;
            white-space: nowrap;
        }

        .crm-pill {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1d4ed8;
        }

        .crm-btn {
            border: 1px solid var(--crm-border);
            background: #fff;
            color: #0f172a;
        }

        .crm-btn-primary {
            background: linear-gradient(135deg,var(--crm-primary),var(--crm-primary-dark));
            color: #fff;
            border: 0;
        }

        .crm-stats {
            display: grid;
            grid-template-columns: repeat(5,minmax(0,1fr));
            gap: 12px;
        }

        .crm-stat {
            min-width: 0;
            border-radius: 18px;
            padding: 15px;
            color: #fff;
            box-shadow: 0 10px 24px rgba(15,23,42,.10);
        }

            .crm-stat small {
                display: block;
                font-size: .66rem;
                text-transform: uppercase;
                letter-spacing: .07em;
                font-weight: 950;
                opacity: .9;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .crm-stat strong {
                display: block;
                margin-top: 7px;
                font-size: 1.75rem;
                line-height: 1;
                font-weight: 950;
            }

        .bg-blue {
            background: linear-gradient(135deg,#1d4ed8,#60a5fa)
        }

        .bg-red {
            background: linear-gradient(135deg,#b91c1c,#fb7185)
        }

        .bg-amber {
            background: linear-gradient(135deg,#b45309,#f59e0b)
        }

        .bg-green {
            background: linear-gradient(135deg,#047857,#34d399)
        }

        .bg-gray {
            background: linear-gradient(135deg,#475569,#94a3b8)
        }

        .crm-filter {
            padding: 16px;
        }

        .crm-label {
            color: #475569;
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .07em;
            margin-bottom: 7px;
        }

        .crm-input {
            min-height: 44px;
            border-radius: 14px;
            border: 1px solid #dbe3ef;
            font-weight: 750;
            box-shadow: none !important;
        }

            .crm-input:focus {
                border-color: var(--crm-primary);
                box-shadow: 0 0 0 4px rgba(37,99,235,.08) !important;
            }

        .crm-list-head {
            padding: 16px 18px;
            border-bottom: 1px solid var(--crm-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            background: #f8fafc;
        }

        .crm-list-title {
            font-weight: 950;
            color: var(--crm-dark);
        }

        .crm-list-sub {
            color: var(--crm-muted);
            font-weight: 650;
            font-size: .86rem;
        }

        .crm-card-grid {
            padding: 14px;
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 14px;
            background: #f8fafc;
        }

        .lead-card {
            min-width: 0;
            background: #fff;
            border: 1px solid rgba(148,163,184,.24);
            border-radius: 18px;
            padding: 15px;
            box-shadow: 0 8px 20px rgba(15,23,42,.045);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .lead-main {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: flex-start;
        }

        .lead-name {
            font-weight: 950;
            color: var(--crm-dark);
            font-size: 1rem;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }

        .lead-project {
            color: var(--crm-muted);
            font-weight: 700;
            font-size: .84rem;
            margin-top: 3px;
            overflow-wrap: anywhere;
        }

        .lead-meta {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 8px;
        }

        .meta-box {
            min-width: 0;
            border: 1px solid var(--crm-border);
            background: #f8fafc;
            border-radius: 14px;
            padding: 9px 10px;
            color: #334155;
            font-size: .82rem;
            font-weight: 750;
            overflow-wrap: anywhere;
        }

            .meta-box i {
                color: var(--crm-primary);
                margin-right: 5px;
            }

        .lead-note {
            border-radius: 14px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
            padding: 10px 12px;
            font-size: .83rem;
            line-height: 1.5;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .lead-actions {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 8px;
            margin-top: auto;
        }

            .lead-actions .btn {
                min-height: 40px;
                border-radius: 13px;
                font-weight: 900;
                font-size: .82rem;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
            }

        .crm-status {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 10px;
            border-radius: 999px;
            font-size: .68rem;
            font-weight: 950;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .st-new {
            background: #fee2e2;
            color: #b91c1c;
        }

        .st-contacted {
            background: #fef3c7;
            color: #b45309
        }

        .st-resolved {
            background: #dcfce7;
            color: #047857
        }

        .st-invalid {
            background: #f1f5f9;
            color: #475569;
            text-decoration: line-through
        }

        .st-unknown {
            background: #e0e7ff;
            color: #3730a3
        }

        .crm-empty {
            padding: 45px 18px;
            text-align: center;
            color: #64748b;
            grid-column: 1/-1;
        }

        .crm-empty-icon {
            width: 70px;
            height: 70px;
            border-radius: 24px;
            background: #f1f5f9;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .crm-pagination .page-link {
            border: 1px solid #dbe3ef;
            color: #334155;
            font-weight: 900;
            border-radius: 12px;
            min-width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 2px;
        }

        .crm-pagination .page-item.active .page-link {
            background: var(--crm-primary);
            color: #fff;
            border-color: var(--crm-primary);
        }

        @@media (max-width:1199.98px) {
            .crm-stats {
                grid-template-columns: repeat(3,minmax(0,1fr));
            }
        }

        @@media (max-width:991.98px) {
            .crm-card-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width:575.98px) {
            .crm-page {
                gap: 10px;
            }

            .crm-hero, .crm-filter, .crm-list-wrap {
                border-radius: 18px;
            }

            .crm-hero, .crm-filter {
                padding: 13px;
            }

            .crm-subtitle {
                display: none;
            }

            .crm-actions, .crm-btn, .crm-btn-primary {
                width: 100%;
            }

            .crm-stats {
                grid-template-columns: repeat(2,minmax(0,1fr));
                gap: 8px;
            }

            .crm-stat {
                padding: 10px;
                border-radius: 14px;
            }

                .crm-stat strong {
                    font-size: 1.35rem;
                }

                .crm-stat small {
                    font-size: .55rem;
                }

            .crm-card-grid {
                padding: 9px;
                gap: 9px;
            }

            .lead-card {
                padding: 11px;
                border-radius: 15px;
            }

            .lead-main {
                display: block;
            }

            .crm-status {
                margin-top: 8px;
            }

            .lead-meta {
                grid-template-columns: 1fr;
            }

            .lead-actions {
                grid-template-columns: 1fr 1fr;
            }

                .lead-actions .btn {
                    font-size: .78rem;
                }
        }
    </style>
}

<div class="crm-page">
    <section class="crm-hero">
        <div class="crm-top">
            <div>
                <h1 class="crm-title"><i class="bi bi-funnel-fill text-primary me-2"></i>Phễu khách hàng dự án</h1>
                <p class="crm-subtitle">Quản lý yêu cầu tư vấn theo dạng thẻ, không dùng bảng ngang. Mỗi thẻ hiển thị đủ khách hàng, liên hệ, dự án, ghi chú và thao tác chính.</p>
            </div>
            <div class="crm-actions">
                <span class="crm-pill"><i class="bi bi-shield-check"></i> Lead thuộc dự án của tôi</span>
                <a href="@Url.Action("ExportLeadsToCsv", "MemberProject", new { projectId = currentProjectId, status = currentStatus, daterange = currentDateRange, keyword = currentKeyword })" class="crm-btn crm-btn-primary">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i> Xuất CSV
                </a>
            </div>
        </div>
    </section>

    <section class="crm-stats">
        <div class="crm-stat bg-blue"><small>Tổng lead</small><strong>@totalLeads</strong></div>
        <div class="crm-stat bg-red"><small>Khách mới</small><strong>@newLeads</strong></div>
        <div class="crm-stat bg-amber"><small>Đang chăm sóc</small><strong>@contactedLeads</strong></div>
        <div class="crm-stat bg-green"><small>Đã chốt</small><strong>@resolvedLeads</strong></div>
        <div class="crm-stat bg-gray"><small>Không hợp lệ</small><strong>@invalidLeads</strong></div>
    </section>

    <section class="crm-filter">
        <form method="get" asp-action="Index" asp-controller="MemberProject" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="form-label crm-label">Dự án</label>
                <select name="projectId" asp-items="ViewBag.ProjectList" class="form-select crm-input">
                    <option value="">Tất cả dự án</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label crm-label">Trạng thái</label>
                <select name="status" class="form-select crm-input">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(currentStatus) ? "selected" : null)">Tất cả</option>
                    <option value="New" selected="@(currentStatus == "New" ? "selected" : null)">Khách mới</option>
                    <option value="Contacted" selected="@(currentStatus == "Contacted" ? "selected" : null)">Đang chăm sóc</option>
                    <option value="Resolved" selected="@(currentStatus == "Resolved" ? "selected" : null)">Đã chốt</option>
                    <option value="Invalid" selected="@(currentStatus == "Invalid" ? "selected" : null)">Không hợp lệ</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="form-label crm-label">Thời gian</label>
                <select name="daterange" class="form-select crm-input">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(currentDateRange) ? "selected" : null)">Toàn thời gian</option>
                    <option value="today" selected="@(currentDateRange == "today" ? "selected" : null)">Hôm nay</option>
                    <option value="week" selected="@(currentDateRange == "week" ? "selected" : null)">7 ngày qua</option>
                    <option value="month" selected="@(currentDateRange == "month" ? "selected" : null)">30 ngày qua</option>
                    <option value="quarter" selected="@(currentDateRange == "quarter" ? "selected" : null)">3 tháng qua</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <label class="form-label crm-label">Từ khóa</label>
                <input type="text" name="keyword" value="@currentKeyword" class="form-control crm-input" placeholder="Tên, SĐT, email, dự án..." />
            </div>
            <div class="col-lg-2 col-md-12 d-grid gap-2">
                <button type="submit" class="btn crm-btn-primary"><i class="bi bi-search"></i> Lọc</button>
                <a href="/MemberProject/Index" class="btn crm-btn"><i class="bi bi-arrow-counterclockwise"></i> Đặt lại</a>
            </div>
        </form>
    </section>

    <section class="crm-list-wrap">
        <div class="crm-list-head">
            <div>
                <div class="crm-list-title">Danh sách khách hàng</div>
                <div class="crm-list-sub">Đang hiển thị @leads.Count.ToString("N0") / @totalFilteredItems.ToString("N0") kết quả.</div>
            </div>
            <span class="crm-pill"><i class="bi bi-phone"></i> Chuẩn mobile & desktop</span>
        </div>

        <div class="crm-card-grid">
            @if (leads.Any())
            {
                foreach (var item in leads)
                {
                    bool rowClosed = IsClosedLead(item.LeadStatus);

                    <article class="lead-card">
                        <div class="lead-main">
                            <div>
                                <div class="lead-name">@SafeText(item.Name, "Khách hàng")</div>
                                <div class="lead-project"><i class="bi bi-building me-1"></i>@SafeText(item.Project?.ProjectName, "Không rõ dự án")</div>
                            </div>
                            <span class="crm-status @LeadStatusClass(item.LeadStatus)">
                                <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>@LeadStatusText(item.LeadStatus)
                            </span>
                        </div>

                        <div class="lead-meta">
                            <div class="meta-box"><i class="bi bi-telephone-fill"></i>@SafeText(item.Phone, "Chưa có SĐT")</div>
                            <div class="meta-box"><i class="bi bi-envelope-fill"></i>@SafeText(item.Email, "Chưa có email")</div>
                            <div class="meta-box"><i class="bi bi-clock-history"></i>@item.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                            <div class="meta-box"><i class="bi bi-hash"></i>Lead #@item.LeadID</div>
                        </div>

                        <div class="lead-note"><strong>Nhu cầu:</strong> @ShortText(item.Message, 150)</div>
                        @if (!string.IsNullOrWhiteSpace(item.Note))
                        {
                            <div class="lead-note" style="background:#f8fafc;border-color:#e2e8f0;color:#475569;">
                                <strong>Ghi chú:</strong> @ShortText(item.Note, 130)
                            </div>
                        }

                        <div class="lead-actions">
                            <a href="tel:@item.Phone" class="btn btn-success"><i class="bi bi-telephone-outbound-fill"></i> Gọi</a>

                            @if (!rowClosed)
                            {
                                <a href="@Url.Action("EditLead", "MemberProject", new { id = item.LeadID, returnUrl = currentUrl })" class="btn btn-primary"><i class="bi bi-pencil-square"></i> Chăm sóc</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-light border" disabled><i class="bi bi-lock-fill"></i> Đã khóa</button>
                            }

                            <a href="@Url.Action("LeadHistory", "MemberProject", new { id = item.LeadID })" class="btn btn-light border"><i class="bi bi-clock-history"></i> 360</a>

                            @if (item.Project != null)
                            {
                                <a href="/Project/Details/@item.ProjectID" target="_blank" class="btn btn-light border"><i class="bi bi-building-fill"></i> Dự án</a>
                            }
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="crm-empty">
                    <div class="crm-empty-icon"><i class="bi bi-person-x"></i></div>
                    <h5 class="fw-bold text-dark">Chưa có khách hàng phù hợp</h5>
                    <div>Hãy thử đổi bộ lọc hoặc kiểm tra lại dự án đang được phân quyền.</div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="p-3 border-top bg-white">
                <nav aria-label="Phân trang lead">
                    <ul class="pagination crm-pagination justify-content-center flex-wrap mb-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { projectId = currentProjectId, status = currentStatus, daterange = currentDateRange, keyword = currentKeyword, page = currentPage - 1 })"><i class="bi bi-chevron-left"></i></a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { projectId = currentProjectId, status = currentStatus, daterange = currentDateRange, keyword = currentKeyword, page = i })">@i</a>
                                </li>
                            }
                            else if (i == currentPage - 3 || i == currentPage + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { projectId = currentProjectId, status = currentStatus, daterange = currentDateRange, keyword = currentKeyword, page = currentPage + 1 })"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </section>
</div>
