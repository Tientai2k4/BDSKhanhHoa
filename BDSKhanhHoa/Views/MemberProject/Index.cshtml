@model IEnumerable<BDSKhanhHoa.Models.ProjectLead>
@using System.Globalization

@{
    ViewData["Title"] = "Phễu khách hàng";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;

    string? currentStatus = ViewBag.CurrentStatus as string;
    int? currentProjectId = ViewBag.CurrentProjectId is int pid ? pid : null;
    string keyword = ViewBag.CurrentKeyword as string ?? string.Empty;

    int totalLeads = ViewBag.TotalLeads ?? (Model?.Count() ?? 0);
    int newLeads = ViewBag.NewLeads ?? 0;
    int invalidLeads = ViewBag.InvalidLeads ?? 0;

    int contactedLeads = Model?.Count(x => x.LeadStatus == "Contacted" || x.LeadStatus == "Đã liên hệ") ?? 0;
    int resolvedLeads = Model?.Count(x => x.LeadStatus == "Resolved" || x.LeadStatus == "Đã chốt") ?? 0;
}

@functions {
    public string GetLeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Khách mới";

        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string GetLeadStatusClass(string? status)
    {
        string text = GetLeadStatusText(status);

        return text switch
        {
            "Khách mới" => "crm-status-new",
            "Đang chăm sóc" => "crm-status-contacted",
            "Đã chốt" => "crm-status-resolved",
            "Không hợp lệ" => "crm-status-invalid",
            _ => "crm-status-unknown"
        };
    }
}

@section Styles {
    <style>
        :root {
            --crm-primary: #2563eb;
            --crm-primary-dark: #1d4ed8;
            --crm-success: #059669;
            --crm-warning: #d97706;
            --crm-danger: #dc2626;
            --crm-dark: #0f172a;
            --crm-muted: #64748b;
            --crm-border: #e2e8f0;
            --crm-soft: #f8fafc;
            --crm-card: #ffffff;
            --crm-radius: 24px;
            --crm-shadow: 0 16px 38px rgba(15, 23, 42, .07);
        }

        .crm-hero,
        .crm-filter,
        .crm-table-card,
        .crm-empty {
            background: var(--crm-card);
            border: 1px solid rgba(148, 163, 184, .20);
            border-radius: var(--crm-radius);
            box-shadow: var(--crm-shadow);
        }

        .crm-hero {
            padding: 26px;
            margin-bottom: 22px;
            overflow: hidden;
            position: relative;
        }

            .crm-hero::after {
                content: "";
                position: absolute;
                width: 260px;
                height: 260px;
                right: -110px;
                top: -130px;
                border-radius: 999px;
                background: rgba(37, 99, 235, .09);
            }

        .crm-title {
            font-size: clamp(1.35rem, 2.4vw, 2rem);
            font-weight: 950;
            color: var(--crm-dark);
            margin-bottom: 8px;
            letter-spacing: -.04em;
        }

        .crm-subtitle {
            color: var(--crm-muted);
            font-weight: 650;
            margin-bottom: 0;
            line-height: 1.6;
        }

        .crm-quick-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: flex-end;
        }

        .crm-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 42px;
            padding: 9px 14px;
            border-radius: 999px;
            border: 1px solid var(--crm-border);
            background: #fff;
            color: #334155;
            font-weight: 900;
            white-space: nowrap;
        }

        .crm-stat {
            min-height: 138px;
            border-radius: 24px;
            padding: 22px;
            color: #fff;
            position: relative;
            overflow: hidden;
            box-shadow: 0 16px 32px rgba(15, 23, 42, .12);
        }

            .crm-stat::after {
                content: "";
                position: absolute;
                width: 120px;
                height: 120px;
                right: -36px;
                top: -42px;
                background: rgba(255, 255, 255, .17);
                border-radius: 999px;
            }

        .crm-stat-label {
            font-size: .77rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .92;
            margin-bottom: 12px;
        }

        .crm-stat-value {
            font-size: 2.65rem;
            line-height: 1;
            font-weight: 950;
            letter-spacing: -.05em;
        }

        .crm-blue {
            background: linear-gradient(135deg, #1d4ed8, #60a5fa);
        }

        .crm-red {
            background: linear-gradient(135deg, #b91c1c, #fb7185);
        }

        .crm-amber {
            background: linear-gradient(135deg, #b45309, #f59e0b);
        }

        .crm-green {
            background: linear-gradient(135deg, #047857, #34d399);
        }

        .crm-gray {
            background: linear-gradient(135deg, #475569, #94a3b8);
        }

        .crm-filter {
            padding: 22px;
            margin-bottom: 22px;
        }

        .crm-label {
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #475569;
            font-weight: 950;
            margin-bottom: 8px;
        }

        .crm-input {
            min-height: 50px;
            border-radius: 16px;
            border: 1px solid #dbe3ef;
            background: #fff;
            box-shadow: none !important;
            font-weight: 750;
            color: #1e293b;
        }

            .crm-input:focus {
                border-color: var(--crm-primary);
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .08) !important;
            }

        .btn-crm-primary {
            min-height: 50px;
            border-radius: 16px;
            background: linear-gradient(135deg, var(--crm-primary), var(--crm-primary-dark));
            color: #fff;
            border: 0;
            font-weight: 950;
            box-shadow: 0 12px 24px rgba(37, 99, 235, .18);
        }

            .btn-crm-primary:hover {
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-crm-light {
            min-height: 50px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid var(--crm-border);
            color: var(--crm-dark);
            font-weight: 900;
        }

        .crm-table-card {
            overflow: hidden;
        }

        .crm-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            font-weight: 950;
            padding: 17px 18px;
            border-bottom: 1px solid var(--crm-border);
            white-space: nowrap;
        }

        .crm-table tbody td {
            padding: 18px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .crm-customer-name {
            font-weight: 950;
            color: var(--crm-dark);
            line-height: 1.4;
        }

        .crm-small {
            color: var(--crm-muted);
            font-size: .87rem;
            font-weight: 650;
            line-height: 1.55;
        }

        .crm-contact-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 7px 10px;
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #bbf7d0;
            font-size: .78rem;
            font-weight: 900;
        }

        .crm-message-box {
            border-radius: 15px;
            background: #f8fafc;
            border: 1px solid var(--crm-border);
            padding: 11px 12px;
            color: #334155;
            font-size: .86rem;
            line-height: 1.55;
        }

        .crm-note-box {
            margin-top: 8px;
            border-radius: 13px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            padding: 9px 11px;
            color: #92400e;
            font-size: .82rem;
            font-weight: 700;
            line-height: 1.5;
        }

        .crm-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 8px 13px;
            border-radius: 999px;
            font-size: .76rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
            white-space: nowrap;
        }

        .crm-status-new {
            background: #fee2e2;
            color: #b91c1c;
        }

        .crm-status-contacted {
            background: #fef3c7;
            color: #b45309;
        }

        .crm-status-resolved {
            background: #dcfce7;
            color: #047857;
        }

        .crm-status-invalid {
            background: #f1f5f9;
            color: #475569;
            text-decoration: line-through;
        }

        .crm-status-unknown {
            background: #e0e7ff;
            color: #3730a3;
        }

        .crm-action-btn {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--crm-border);
            background: #fff;
            color: #334155;
            transition: .2s ease;
        }

            .crm-action-btn:hover {
                background: var(--crm-primary);
                color: #fff;
                border-color: var(--crm-primary);
            }

        .crm-mobile-list {
            display: none;
            background: #f8fafc;
            padding: 14px;
        }

        .crm-mobile-card {
            border-radius: 20px;
            border: 1px solid rgba(148, 163, 184, .22);
            background: #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
            padding: 16px;
            margin-bottom: 14px;
        }

        .crm-pagination .page-link {
            border: 1px solid #dbe3ef;
            color: #334155;
            font-weight: 900;
            border-radius: 14px;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin: 0 4px;
        }

        .crm-pagination .page-item.active .page-link {
            background: linear-gradient(135deg, var(--crm-primary), var(--crm-primary-dark));
            color: #fff;
            border-color: transparent;
        }

        .crm-empty {
            padding: 58px 24px;
            text-align: center;
        }

        @@media (max-width: 991.98px) {
            .crm-quick-actions {
                justify-content: flex-start;
            }

            .desktop-table-wrap {
                display: none;
            }

            .crm-mobile-list {
                display: block;
            }

            .crm-stat {
                min-height: 126px;
            }

            .crm-stat-value {
                font-size: 2.2rem;
            }
        }

        @@media (max-width: 575.98px) {
            .crm-hero,
            .crm-filter,
            .crm-table-card {
                border-radius: 20px;
            }

            .crm-hero,
            .crm-filter {
                padding: 18px;
            }

            .crm-chip,
            .btn-crm-light,
            .btn-crm-primary {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
}

<div class="crm-hero">
    <div class="row g-4 align-items-center position-relative" style="z-index:1;">
        <div class="col-xl-7">
            <h1 class="crm-title">Phễu khách hàng</h1>
            <p class="crm-subtitle">
                Theo dõi khách hàng quan tâm dự án, cập nhật trạng thái chăm sóc, điều phối lịch xem và lưu vết lịch sử CRM.
            </p>
        </div>

        <div class="col-xl-5">
            <div class="crm-quick-actions">
                <span class="crm-chip">
                    <i class="bi bi-people-fill text-primary"></i>
                    @totalLeads khách hàng
                </span>

                <span class="crm-chip">
                    <i class="bi bi-lightning-charge-fill text-danger"></i>
                    @newLeads khách mới
                </span>

                <a href="@Url.Action("ExportLeadsToCsv", new { projectId = currentProjectId })" class="btn btn-crm-light">
                    <i class="bi bi-file-earmark-excel-fill text-success me-1"></i>
                    Xuất Excel/CSV
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 g-xl-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="crm-stat crm-blue">
            <div class="crm-stat-label">Tổng khách</div>
            <div class="crm-stat-value">@totalLeads</div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="crm-stat crm-red">
            <div class="crm-stat-label">Khách mới</div>
            <div class="crm-stat-value">@newLeads</div>
        </div>
    </div>

    <div class="col-xl-2 col-md-6">
        <div class="crm-stat crm-amber">
            <div class="crm-stat-label">Đang chăm sóc</div>
            <div class="crm-stat-value">@contactedLeads</div>
        </div>
    </div>

    <div class="col-xl-2 col-md-6">
        <div class="crm-stat crm-green">
            <div class="crm-stat-label">Đã chốt</div>
            <div class="crm-stat-value">@resolvedLeads</div>
        </div>
    </div>

    <div class="col-xl-2 col-md-6">
        <div class="crm-stat crm-gray">
            <div class="crm-stat-label">Không hợp lệ</div>
            <div class="crm-stat-value">@invalidLeads</div>
        </div>
    </div>
</div>

<div class="crm-filter">
    <form method="get" asp-action="Index" asp-controller="MemberProject" class="row g-3 align-items-end">
        <div class="col-xl-4 col-lg-6">
            <label class="form-label crm-label">Dự án quản lý</label>
            <select name="projectId" class="form-select crm-input" asp-items="ViewBag.ProjectList">
                <option value="">Toàn bộ dự án</option>
            </select>
        </div>

        <div class="col-xl-3 col-lg-6">
            <label class="form-label crm-label">Trạng thái chăm sóc</label>
            <select name="status" class="form-select crm-input">
                <option value="">Tất cả trạng thái</option>
                <option value="New" selected="@(currentStatus == "New")">Khách mới</option>
                <option value="Contacted" selected="@(currentStatus == "Contacted")">Đang chăm sóc</option>
                <option value="Resolved" selected="@(currentStatus == "Resolved")">Đã chốt</option>
                <option value="Invalid" selected="@(currentStatus == "Invalid")">Không hợp lệ</option>
            </select>
        </div>

        <div class="col-xl-4 col-lg-9">
            <label class="form-label crm-label">Từ khóa</label>
            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control crm-input"
                   placeholder="Tìm tên khách, số điện thoại, email, ghi chú..." />
        </div>

        <div class="col-xl-1 col-lg-3 d-grid">
            <button type="submit" class="btn btn-crm-primary">
                <i class="bi bi-search"></i>
                Lọc
            </button>
        </div>
    </form>
</div>

<div class="crm-table-card">
    <div class="desktop-table-wrap table-responsive">
        <table class="table crm-table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Khách hàng</th>
                    <th>Dự án quan tâm</th>
                    <th>Nhu cầu & ghi chú</th>
                    <th>Thời gian</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var lead in Model)
                    {
                        string statusText = GetLeadStatusText(lead.LeadStatus);
                        string statusClass = GetLeadStatusClass(lead.LeadStatus);

                        <tr>
                            <td>
                                <div class="crm-customer-name">@lead.Name</div>

                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    <a href="tel:@lead.Phone" class="crm-contact-pill">
                                        <i class="bi bi-telephone-fill"></i>
                                        @lead.Phone
                                    </a>

                                    @if (!string.IsNullOrWhiteSpace(lead.Email))
                                    {
                                        <span class="crm-contact-pill" style="background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe;">
                                            <i class="bi bi-envelope-fill"></i>
                                            Có email
                                        </span>
                                    }
                                </div>
                            </td>

                            <td>
                                <div class="fw-bold text-primary">
                                    @(lead.Project?.ProjectName ?? "Chưa xác định")
                                </div>

                                <div class="crm-small mt-1">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    @(lead.Project?.Ward?.WardName ?? "Đang cập nhật")
                                </div>
                            </td>

                            <td style="min-width:280px;">
                                <div class="crm-message-box">
                                    <strong>Khách nhắn:</strong>
                                    @(string.IsNullOrWhiteSpace(lead.Message) ? "Khách để lại số điện thoại và yêu cầu gọi lại." : lead.Message)
                                </div>

                                @if (!string.IsNullOrWhiteSpace(lead.Note))
                                {
                                    <div class="crm-note-box" title="@lead.Note">
                                        <i class="bi bi-journal-text me-1"></i>
                                        @(lead.Note.Length > 85 ? lead.Note.Substring(0, 85) + "..." : lead.Note)
                                    </div>
                                }
                            </td>

                            <td>
                                <div class="fw-bold text-dark">@lead.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <div class="crm-small">@lead.CreatedAt.ToString("HH:mm")</div>
                            </td>

                            <td>
                                <span class="crm-status @statusClass">
                                    <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                                    @statusText
                                </span>
                            </td>

                            <td class="text-center">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="EditLead" asp-route-id="@lead.LeadID" class="crm-action-btn" title="Cập nhật khách hàng / đặt lịch">
                                        <i class="bi bi-calendar-plus-fill"></i>
                                    </a>

                                    <a asp-action="LeadHistory" asp-route-id="@lead.LeadID" class="crm-action-btn" title="Xem hồ sơ 360">
                                        <i class="bi bi-person-vcard-fill"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="crm-empty">
                                <i class="bi bi-inbox display-1 text-muted opacity-25 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark">Chưa có khách hàng phù hợp</h5>
                                <p class="text-muted mb-0">Hãy thử đổi bộ lọc hoặc chọn dự án khác.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="crm-mobile-list">
        @if (Model != null && Model.Any())
        {
            foreach (var lead in Model)
            {
                string statusText = GetLeadStatusText(lead.LeadStatus);
                string statusClass = GetLeadStatusClass(lead.LeadStatus);

                <div class="crm-mobile-card">
                    <div class="d-flex justify-content-between gap-2 align-items-start">
                        <div>
                            <div class="crm-customer-name">@lead.Name</div>
                            <a href="tel:@lead.Phone" class="crm-contact-pill mt-2">
                                <i class="bi bi-telephone-fill"></i>
                                @lead.Phone
                            </a>
                        </div>

                        <span class="crm-status @statusClass">
                            @statusText
                        </span>
                    </div>

                    <div class="mt-3 crm-small">
                        <i class="bi bi-building-fill text-primary me-1"></i>
                        <strong>@(lead.Project?.ProjectName ?? "Chưa xác định")</strong>
                    </div>

                    <div class="crm-message-box mt-3">
                        @(string.IsNullOrWhiteSpace(lead.Message) ? "Khách để lại số điện thoại và yêu cầu gọi lại." : lead.Message)
                    </div>

                    @if (!string.IsNullOrWhiteSpace(lead.Note))
                    {
                        <div class="crm-note-box">
                            @(lead.Note.Length > 100 ? lead.Note.Substring(0, 100) + "..." : lead.Note)
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <div class="crm-small">
                            @lead.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-action="EditLead" asp-route-id="@lead.LeadID" class="crm-action-btn">
                                <i class="bi bi-calendar-plus-fill"></i>
                            </a>

                            <a asp-action="LeadHistory" asp-route-id="@lead.LeadID" class="crm-action-btn">
                                <i class="bi bi-person-vcard-fill"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="crm-empty">
                <i class="bi bi-inbox display-1 text-muted opacity-25 d-block mb-3"></i>
                <h5 class="fw-bold text-dark">Chưa có khách hàng phù hợp</h5>
                <p class="text-muted mb-0">Hãy thử đổi bộ lọc hoặc chọn dự án khác.</p>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="p-4 border-top bg-white">
            <nav>
                <ul class="pagination crm-pagination justify-content-center mb-0 flex-wrap">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, projectId = currentProjectId, status = currentStatus, keyword = keyword })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, projectId = currentProjectId, status = currentStatus, keyword = keyword })">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, projectId = currentProjectId, status = currentStatus, keyword = keyword })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>