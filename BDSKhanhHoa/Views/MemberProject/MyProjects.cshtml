@model IEnumerable<BDSKhanhHoa.Models.Project>

@{
    ViewData["Title"] = "Quản lý Dự án của tôi";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    var projects = Model?.ToList() ?? new List<BDSKhanhHoa.Models.Project>();

    int totalProjects = projects.Count;
    int approvedCount = projects.Count(x => x.ApprovalStatus == "Approved" || x.ApprovalStatus == "Đã duyệt");
    int pendingCount = projects.Count(x => x.ApprovalStatus == "Pending" || x.ApprovalStatus == "Chờ duyệt");
    int rejectedCount = projects.Count(x => x.ApprovalStatus == "Rejected" || x.ApprovalStatus == "Từ chối");

    int sellingCount = projects.Count(x => x.ProjectStatus == "Đang mở bán");
    int comingSoonCount = projects.Count(x => x.ProjectStatus == "Sắp mở bán");
    int handedCount = projects.Count(x => x.ProjectStatus == "Đã bàn giao");
}

@functions {
    public string GetApprovalText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Chưa xác định";
        }

        return status.Trim() switch
        {
            "Approved" => "Đã phê duyệt",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Đã duyệt" => "Đã phê duyệt",
            "Chờ duyệt" => "Chờ duyệt",
            "Từ chối" => "Bị từ chối",
            _ => status.Trim()
        };
    }

    public string GetApprovalClass(string? status)
    {
        string text = GetApprovalText(status);

        return text switch
        {
            "Đã phê duyệt" => "project-status-approved",
            "Chờ duyệt" => "project-status-pending",
            "Bị từ chối" => "project-status-rejected",
            _ => "project-status-muted"
        };
    }

    public string GetApprovalFilterValue(string? status)
    {
        string text = GetApprovalText(status);

        return text switch
        {
            "Đã phê duyệt" => "approved",
            "Chờ duyệt" => "pending",
            "Bị từ chối" => "rejected",
            _ => "other"
        };
    }

    public string GetProjectStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "project-stage-muted";
        }

        return status.Trim() switch
        {
            "Đang mở bán" => "project-stage-selling",
            "Sắp mở bán" => "project-stage-coming",
            "Đã bàn giao" => "project-stage-handed",
            _ => "project-stage-muted"
        };
    }

    public string SafeText(string? value, string fallback = "Đang cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }
}

<style>
    :root {
        --my-project-primary: #2563eb;
        --my-project-primary-dark: #1d4ed8;
        --my-project-success: #059669;
        --my-project-warning: #d97706;
        --my-project-danger: #dc2626;
        --my-project-dark: #0f172a;
        --my-project-muted: #64748b;
        --my-project-border: #e2e8f0;
        --my-project-soft: #f8fafc;
        --my-project-card: #ffffff;
        --my-project-radius: 22px;
        --my-project-shadow: 0 14px 34px rgba(15, 23, 42, .07);
        --my-project-shadow-hover: 0 20px 46px rgba(15, 23, 42, .12);
    }

    .my-project-page {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .my-project-hero {
        background: radial-gradient(circle at top right, rgba(37, 99, 235, .12), transparent 280px), linear-gradient(135deg, #ffffff, #f8fbff);
        border: 1px solid rgba(148, 163, 184, .22);
        border-radius: 28px;
        box-shadow: var(--my-project-shadow);
        padding: 24px;
        overflow: hidden;
    }

    .my-project-title {
        font-size: clamp(1.35rem, 2vw, 2rem);
        font-weight: 950;
        letter-spacing: -.04em;
        color: var(--my-project-dark);
        margin-bottom: 8px;
    }

    .my-project-subtitle {
        color: var(--my-project-muted);
        font-weight: 650;
        line-height: 1.65;
        margin-bottom: 0;
        max-width: 780px;
    }

    .my-project-note {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
        padding: 9px 14px;
        font-size: .82rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .my-project-stat-card {
        min-height: 118px;
        border-radius: 22px;
        padding: 18px;
        position: relative;
        overflow: hidden;
        color: #ffffff;
        box-shadow: 0 14px 28px rgba(15, 23, 42, .10);
    }

        .my-project-stat-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            top: -42px;
            right: -36px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .18);
        }

    .my-project-stat-label {
        font-size: .74rem;
        font-weight: 950;
        letter-spacing: .08em;
        text-transform: uppercase;
        opacity: .92;
        margin-bottom: 10px;
        position: relative;
        z-index: 1;
    }

    .my-project-stat-value {
        font-size: 2.25rem;
        line-height: 1;
        font-weight: 950;
        letter-spacing: -.04em;
        position: relative;
        z-index: 1;
    }

    .my-project-stat-desc {
        margin-top: 8px;
        font-size: .78rem;
        font-weight: 750;
        opacity: .88;
        position: relative;
        z-index: 1;
    }

    .stat-blue {
        background: linear-gradient(135deg, #1d4ed8, #60a5fa);
    }

    .stat-green {
        background: linear-gradient(135deg, #047857, #34d399);
    }

    .stat-amber {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .stat-red {
        background: linear-gradient(135deg, #b91c1c, #fb7185);
    }

    .my-project-filter {
        background: #ffffff;
        border: 1px solid rgba(148, 163, 184, .22);
        border-radius: 24px;
        box-shadow: var(--my-project-shadow);
        padding: 18px;
    }

    .filter-label {
        display: block;
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #475569;
        font-weight: 950;
        margin-bottom: 8px;
    }

    .filter-control {
        min-height: 48px;
        border-radius: 15px;
        border: 1px solid #dbe3ef;
        background-color: #ffffff;
        color: #1e293b;
        font-weight: 750;
        box-shadow: none !important;
    }

        .filter-control:focus {
            border-color: var(--my-project-primary);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .08) !important;
        }

    .btn-filter-primary {
        min-height: 48px;
        border-radius: 15px;
        border: 0;
        background: linear-gradient(135deg, var(--my-project-primary), var(--my-project-primary-dark));
        color: #ffffff;
        font-weight: 950;
        padding-left: 18px;
        padding-right: 18px;
        box-shadow: 0 12px 24px rgba(37, 99, 235, .18);
    }

        .btn-filter-primary:hover {
            color: #ffffff;
            transform: translateY(-1px);
        }

    .btn-filter-light {
        min-height: 48px;
        border-radius: 15px;
        border: 1px solid var(--my-project-border);
        background: #ffffff;
        color: var(--my-project-dark);
        font-weight: 900;
        padding-left: 18px;
        padding-right: 18px;
    }

    .my-project-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .result-count {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #334155;
        font-weight: 850;
        background: #ffffff;
        border: 1px solid var(--my-project-border);
        border-radius: 999px;
        padding: 9px 14px;
    }

    .view-switch {
        display: inline-flex;
        gap: 6px;
        padding: 5px;
        border-radius: 999px;
        border: 1px solid var(--my-project-border);
        background: #ffffff;
    }

        .view-switch button {
            border: 0;
            width: 38px;
            height: 34px;
            border-radius: 999px;
            background: transparent;
            color: #64748b;
            transition: .2s ease;
        }

            .view-switch button.active {
                background: var(--my-project-primary);
                color: #ffffff;
            }

    .my-project-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

        .my-project-grid.list-mode {
            grid-template-columns: 1fr;
        }

    .project-card {
        background: var(--my-project-card);
        border: 1px solid rgba(148, 163, 184, .22);
        border-radius: var(--my-project-radius);
        box-shadow: var(--my-project-shadow);
        overflow: hidden;
        transition: .25s ease;
        display: flex;
        flex-direction: column;
        min-height: 100%;
    }

        .project-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--my-project-shadow-hover);
            border-color: rgba(37, 99, 235, .28);
        }

    .project-cover-wrap {
        position: relative;
        height: 176px;
        overflow: hidden;
        background: #f1f5f9;
    }

    .project-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s ease;
    }

    .project-card:hover .project-cover {
        transform: scale(1.045);
    }

    .project-status-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .72rem;
        font-weight: 950;
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, .13);
        border: 1px solid rgba(255, 255, 255, .72);
    }

    .project-stage-badge {
        position: absolute;
        right: 12px;
        bottom: 12px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .72rem;
        font-weight: 950;
        color: #ffffff;
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, .18);
    }

    .project-status-approved {
        background: rgba(220, 252, 231, .94);
        color: #047857;
    }

    .project-status-pending {
        background: rgba(254, 243, 199, .94);
        color: #b45309;
    }

    .project-status-rejected {
        background: rgba(254, 226, 226, .94);
        color: #b91c1c;
    }

    .project-status-muted {
        background: rgba(241, 245, 249, .94);
        color: #475569;
    }

    .project-stage-selling {
        background: rgba(5, 150, 105, .92);
    }

    .project-stage-coming {
        background: rgba(217, 119, 6, .92);
    }

    .project-stage-handed {
        background: rgba(79, 70, 229, .92);
    }

    .project-stage-muted {
        background: rgba(71, 85, 105, .90);
    }

    .project-card-body {
        padding: 17px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .project-name {
        font-size: 1.02rem;
        line-height: 1.4;
        font-weight: 950;
        color: var(--my-project-dark);
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-investor {
        color: #475569;
        font-size: .84rem;
        font-weight: 700;
        line-height: 1.5;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .project-meta-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        margin-bottom: 14px;
    }

    .project-meta-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #64748b;
        font-size: .82rem;
        line-height: 1.45;
        font-weight: 700;
    }

        .project-meta-item i {
            color: var(--my-project-primary);
            flex-shrink: 0;
            margin-top: 1px;
        }

    .project-price-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
        margin-top: auto;
        padding-top: 13px;
        border-top: 1px dashed var(--my-project-border);
    }

    .project-price-box {
        border-radius: 15px;
        background: var(--my-project-soft);
        border: 1px solid var(--my-project-border);
        padding: 10px;
        min-width: 0;
    }

        .project-price-box span {
            display: block;
            color: var(--my-project-muted);
            font-size: .68rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 4px;
        }

        .project-price-box strong {
            display: block;
            color: var(--my-project-dark);
            font-size: .86rem;
            font-weight: 950;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .project-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

    .project-action {
        flex: 1;
        min-height: 40px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: .8rem;
        font-weight: 900;
        border: 1px solid var(--my-project-border);
        background: #ffffff;
        color: #334155;
        transition: .2s ease;
    }

        .project-action:hover {
            color: #ffffff;
            background: var(--my-project-primary);
            border-color: var(--my-project-primary);
        }

        .project-action.disabled {
            pointer-events: none;
            opacity: .45;
        }

    .my-project-grid.list-mode .project-card {
        display: grid;
        grid-template-columns: 230px minmax(0, 1fr);
        min-height: auto;
    }

    .my-project-grid.list-mode .project-cover-wrap {
        height: 100%;
        min-height: 190px;
    }

    .my-project-grid.list-mode .project-card-body {
        padding: 20px;
    }

    .my-project-grid.list-mode .project-name {
        -webkit-line-clamp: 1;
        font-size: 1.12rem;
    }

    .my-project-grid.list-mode .project-meta-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .empty-box {
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 24px;
        padding: 58px 20px;
        text-align: center;
        box-shadow: var(--my-project-shadow);
    }

    .empty-icon {
        width: 84px;
        height: 84px;
        display: grid;
        place-items: center;
        margin: 0 auto 18px;
        border-radius: 28px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 2.4rem;
    }

    .empty-title {
        color: var(--my-project-dark);
        font-weight: 950;
        margin-bottom: 8px;
    }

    .empty-desc {
        color: var(--my-project-muted);
        font-weight: 650;
        max-width: 560px;
        margin: 0 auto;
        line-height: 1.65;
    }

    .no-filter-result {
        display: none;
    }

    @@media (max-width: 1199.98px) {
        .my-project-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .my-project-grid.list-mode .project-card {
            grid-template-columns: 1fr;
        }

        .my-project-grid.list-mode .project-cover-wrap {
            min-height: 180px;
        }

        .my-project-grid.list-mode .project-meta-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .my-project-hero,
        .my-project-filter,
        .project-card,
        .empty-box {
            border-radius: 20px;
        }

        .my-project-hero,
        .my-project-filter {
            padding: 16px;
        }

        .my-project-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .project-cover-wrap {
            height: 168px;
        }

        .project-price-row {
            grid-template-columns: 1fr;
        }

        .project-actions {
            flex-direction: column;
        }

        .view-switch {
            display: none;
        }

        .result-count {
            width: 100%;
            justify-content: center;
        }

        .my-project-note {
            width: 100%;
            justify-content: center;
            white-space: normal;
            text-align: center;
        }
    }
</style>

<div class="my-project-page">
    <section class="my-project-hero">
        <div class="row g-4 align-items-center">
            <div class="col-xl-8">
                <h1 class="my-project-title">
                    <i class="bi bi-buildings-fill text-primary me-2"></i>
                    Dự án được phân quyền
                </h1>

                <p class="my-project-subtitle">
                    Theo dõi danh sách dự án, trạng thái phê duyệt, tiến độ mở bán, hồ sơ pháp lý và đường dẫn xem công khai.
                    Giao diện này chỉ dùng để quản lý các dự án đã được hệ thống gán cho tài khoản của bạn.
                </p>
            </div>

            <div class="col-xl-4 text-xl-end">
                <span class="my-project-note">
                    <i class="bi bi-shield-check"></i>
                    Chủ đầu tư không tự tạo dự án mới
                </span>
            </div>
        </div>
    </section>

    <section class="row g-3">
        <div class="col-xl-3 col-md-6">
            <div class="my-project-stat-card stat-blue">
                <div class="my-project-stat-label">Tổng dự án</div>
                <div class="my-project-stat-value">@totalProjects</div>
                <div class="my-project-stat-desc">Dự án đang được phân quyền</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="my-project-stat-card stat-green">
                <div class="my-project-stat-label">Đã phê duyệt</div>
                <div class="my-project-stat-value">@approvedCount</div>
                <div class="my-project-stat-desc">@sellingCount dự án đang mở bán</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="my-project-stat-card stat-amber">
                <div class="my-project-stat-label">Chờ duyệt</div>
                <div class="my-project-stat-value">@pendingCount</div>
                <div class="my-project-stat-desc">@comingSoonCount dự án sắp mở bán</div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="my-project-stat-card stat-red">
                <div class="my-project-stat-label">Bị từ chối</div>
                <div class="my-project-stat-value">@rejectedCount</div>
                <div class="my-project-stat-desc">@handedCount dự án đã bàn giao</div>
            </div>
        </div>
    </section>

    <section class="my-project-filter">
        <div class="row g-3 align-items-end">
            <div class="col-xl-4 col-lg-6">
                <label class="filter-label">Tìm kiếm nhanh</label>
                <input type="text"
                       id="projectKeyword"
                       class="form-control filter-control"
                       placeholder="Nhập tên dự án, chủ đầu tư, khu vực..." />
            </div>

            <div class="col-xl-2 col-lg-6">
                <label class="filter-label">Phê duyệt</label>
                <select id="approvalFilter" class="form-select filter-control">
                    <option value="all">Tất cả</option>
                    <option value="approved">Đã phê duyệt</option>
                    <option value="pending">Chờ duyệt</option>
                    <option value="rejected">Bị từ chối</option>
                    <option value="other">Khác</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-6">
                <label class="filter-label">Tiến độ</label>
                <select id="stageFilter" class="form-select filter-control">
                    <option value="all">Tất cả</option>
                    <option value="Đang mở bán">Đang mở bán</option>
                    <option value="Sắp mở bán">Sắp mở bán</option>
                    <option value="Đã bàn giao">Đã bàn giao</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-6">
                <label class="filter-label">Sắp xếp</label>
                <select id="sortFilter" class="form-select filter-control">
                    <option value="newest">Mới nhất</option>
                    <option value="oldest">Cũ nhất</option>
                    <option value="name-asc">Tên A-Z</option>
                    <option value="name-desc">Tên Z-A</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-12">
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-filter-primary flex-fill" onclick="applyProjectFilters()">
                        <i class="bi bi-funnel-fill me-1"></i>
                        Lọc
                    </button>

                    <button type="button" class="btn btn-filter-light" onclick="resetProjectFilters()" title="Xóa bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>
    </section>

    @if (!projects.Any())
    {
        <section class="empty-box">
            <div class="empty-icon">
                <i class="bi bi-folder-x"></i>
            </div>

            <h3 class="empty-title">Chưa có dự án được phân quyền</h3>

            <p class="empty-desc">
                Khi Admin gán dự án cho tài khoản của bạn, danh sách dự án sẽ hiển thị tại đây.
                Bạn có thể liên hệ bộ phận quản trị nếu cần kiểm tra quyền truy cập.
            </p>

            <div class="mt-4">
                <a href="/SupportTickets/Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                    <i class="bi bi-headset me-1"></i>
                    Gửi yêu cầu hỗ trợ
                </a>
            </div>
        </section>
    }
    else
    {
        <section class="my-project-toolbar">
            <div class="result-count">
                <i class="bi bi-kanban-fill text-primary"></i>
                Đang hiển thị <span id="visibleProjectCount">@projects.Count</span> / @projects.Count dự án
            </div>

            <div class="view-switch" aria-label="Chọn kiểu hiển thị">
                <button type="button" id="btnGridView" class="active" onclick="setProjectView('grid')" title="Dạng lưới">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </button>

                <button type="button" id="btnListView" onclick="setProjectView('list')" title="Dạng danh sách">
                    <i class="bi bi-list-ul"></i>
                </button>
            </div>
        </section>

        <section id="projectGrid" class="my-project-grid">
            @foreach (var item in projects)
            {
                string coverImage = string.IsNullOrWhiteSpace(item.MainImage)
                ? "/images/no-image.jpg"
                : item.MainImage;

                string approvalText = GetApprovalText(item.ApprovalStatus);
                string approvalClass = GetApprovalClass(item.ApprovalStatus);
                string approvalValue = GetApprovalFilterValue(item.ApprovalStatus);

                string projectStatusText = SafeText(item.ProjectStatus, "Chưa cập nhật");
                string projectStatusClass = GetProjectStatusClass(item.ProjectStatus);

                string wardName = item.Ward?.WardName ?? "Chưa cập nhật";
                string areaName = item.Ward?.Area?.AreaName ?? item.Area?.AreaName ?? "Chưa cập nhật";

                string investor = SafeText(item.Investor, "Chưa cập nhật");
                string projectType = SafeText(item.ProjectType, "Chưa cập nhật");

                string priceText = "Liên hệ";
                if (item.PriceMin.HasValue && item.PriceMax.HasValue)
                {
                    priceText = $"{item.PriceMin.Value:0.##} - {item.PriceMax.Value:0.##} {SafeText(item.PriceUnit, "")}";
                }
                else if (item.PriceMin.HasValue)
                {
                    priceText = $"Từ {item.PriceMin.Value:0.##} {SafeText(item.PriceUnit, "")}";
                }

                string areaText = "Đang cập nhật";
                if (item.AreaMin.HasValue && item.AreaMax.HasValue)
                {
                    areaText = $"{item.AreaMin.Value:0.##} - {item.AreaMax.Value:0.##} m²";
                }
                else if (item.AreaMin.HasValue)
                {
                    areaText = $"Từ {item.AreaMin.Value:0.##} m²";
                }

                string searchText = $"{item.ProjectName} {investor} {wardName} {areaName} {projectStatusText} {approvalText} {projectType}".ToLowerInvariant();

                string stageValue = string.IsNullOrWhiteSpace(item.ProjectStatus)
                ? "Khác"
                : item.ProjectStatus.Trim();

                bool hasLegalDocs = !string.IsNullOrWhiteSpace(item.LegalDocs);
                bool isApproved = approvalValue == "approved";

                <article class="project-card js-project-card"
                         data-keyword="@searchText"
                         data-approval="@approvalValue"
                         data-stage="@stageValue"
                         data-name="@SafeText(item.ProjectName, "").ToLowerInvariant()"
                         data-created="@item.CreatedAt.Ticks">
                    <div class="project-cover-wrap">
                        <img src="@coverImage"
                             class="project-cover"
                             alt="@item.ProjectName"
                             loading="lazy"
                             onerror="this.src='/images/no-image.jpg'" />

                        <span class="project-status-badge @approvalClass">
                            <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                            @approvalText
                        </span>

                        <span class="project-stage-badge @projectStatusClass">
                            <i class="bi bi-activity"></i>
                            @projectStatusText
                        </span>
                    </div>

                    <div class="project-card-body">
                        <h2 class="project-name" title="@item.ProjectName">
                            @item.ProjectName
                        </h2>

                        <div class="project-investor" title="@investor">
                            <i class="bi bi-building me-1 text-primary"></i>
                            Chủ đầu tư: <strong>@investor</strong>
                        </div>

                        <div class="project-meta-grid">
                            <div class="project-meta-item">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@wardName, @areaName</span>
                            </div>

                            <div class="project-meta-item">
                                <i class="bi bi-calendar-event-fill"></i>
                                <span>Ngày tạo: @item.CreatedAt.ToString("dd/MM/yyyy")</span>
                            </div>

                            <div class="project-meta-item">
                                <i class="bi bi-layers-fill"></i>
                                <span>Loại hình: @projectType</span>
                            </div>
                        </div>

                        <div class="project-price-row">
                            <div class="project-price-box">
                                <span>Giá tham khảo</span>
                                <strong title="@priceText">@priceText</strong>
                            </div>

                            <div class="project-price-box">
                                <span>Diện tích</span>
                                <strong title="@areaText">@areaText</strong>
                            </div>
                        </div>

                        <div class="project-actions">
                            @if (hasLegalDocs)
                            {
                                <a href="@item.LegalDocs"
                                   target="_blank"
                                   class="project-action"
                                   title="Xem hồ sơ pháp lý">
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                    Hồ sơ
                                </a>
                            }
                            else
                            {
                                <span class="project-action disabled" title="Chưa có hồ sơ pháp lý">
                                    <i class="bi bi-file-earmark-x"></i>
                                    Hồ sơ
                                </span>
                            }

                            @if (isApproved)
                            {
                                <a href="/Project/Details/@item.ProjectID"
                                   target="_blank"
                                   class="project-action"
                                   title="Xem dự án trên website">
                                    <i class="bi bi-eye-fill"></i>
                                    Xem
                                </a>
                            }
                            else
                            {
                                <span class="project-action disabled" title="Dự án chưa được phê duyệt công khai">
                                    <i class="bi bi-eye-slash-fill"></i>
                                    Xem
                                </span>
                            }

                            <a href="/SupportTickets/Index"
                               class="project-action"
                               title="Gửi yêu cầu hỗ trợ">
                                <i class="bi bi-headset"></i>
                                Hỗ trợ
                            </a>
                        </div>
                    </div>
                </article>
            }
        </section>

        <section id="noFilterResult" class="empty-box no-filter-result">
            <div class="empty-icon">
                <i class="bi bi-search"></i>
            </div>

            <h3 class="empty-title">Không tìm thấy dự án phù hợp</h3>

            <p class="empty-desc">
                Không có dự án nào khớp với bộ lọc hiện tại. Hãy thử đổi từ khóa, trạng thái phê duyệt hoặc tiến độ dự án.
            </p>

            <div class="mt-4">
                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold" onclick="resetProjectFilters()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Xóa bộ lọc
                </button>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        const projectGrid = document.getElementById('projectGrid');
        const projectCards = Array.from(document.querySelectorAll('.js-project-card'));
        const visibleProjectCount = document.getElementById('visibleProjectCount');
        const noFilterResult = document.getElementById('noFilterResult');

        const keywordInput = document.getElementById('projectKeyword');
        const approvalFilter = document.getElementById('approvalFilter');
        const stageFilter = document.getElementById('stageFilter');
        const sortFilter = document.getElementById('sortFilter');

        function normalizeText(value) {
            return (value || '')
                .toString()
                .trim()
                .toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '');
        }

        function applyProjectFilters() {
            if (!projectGrid) {
                return;
            }

            const keyword = normalizeText(keywordInput?.value);
            const approval = approvalFilter?.value || 'all';
            const stage = stageFilter?.value || 'all';
            const sortType = sortFilter?.value || 'newest';

            let visibleCards = [];

            projectCards.forEach(card => {
                const cardKeyword = normalizeText(card.dataset.keyword);
                const cardApproval = card.dataset.approval || 'other';
                const cardStage = card.dataset.stage || 'Khác';

                const matchKeyword = !keyword || cardKeyword.includes(keyword);
                const matchApproval = approval === 'all' || cardApproval === approval;
                const matchStage = stage === 'all' || cardStage === stage;

                const isVisible = matchKeyword && matchApproval && matchStage;

                card.style.display = isVisible ? '' : 'none';

                if (isVisible) {
                    visibleCards.push(card);
                }
            });

            sortVisibleCards(visibleCards, sortType);

            if (visibleProjectCount) {
                visibleProjectCount.textContent = visibleCards.length;
            }

            if (noFilterResult) {
                noFilterResult.style.display = visibleCards.length === 0 ? 'block' : 'none';
            }
        }

        function sortVisibleCards(cards, sortType) {
            if (!projectGrid || !cards.length) {
                return;
            }

            const sortedCards = [...cards];

            sortedCards.sort((a, b) => {
                const nameA = a.dataset.name || '';
                const nameB = b.dataset.name || '';
                const createdA = Number(a.dataset.created || 0);
                const createdB = Number(b.dataset.created || 0);

                switch (sortType) {
                    case 'oldest':
                        return createdA - createdB;

                    case 'name-asc':
                        return nameA.localeCompare(nameB);

                    case 'name-desc':
                        return nameB.localeCompare(nameA);

                    case 'newest':
                    default:
                        return createdB - createdA;
                }
            });

            sortedCards.forEach(card => {
                projectGrid.appendChild(card);
            });
        }

        function resetProjectFilters() {
            if (keywordInput) {
                keywordInput.value = '';
            }

            if (approvalFilter) {
                approvalFilter.value = 'all';
            }

            if (stageFilter) {
                stageFilter.value = 'all';
            }

            if (sortFilter) {
                sortFilter.value = 'newest';
            }

            applyProjectFilters();
        }

        function setProjectView(type) {
            if (!projectGrid) {
                return;
            }

            const btnGridView = document.getElementById('btnGridView');
            const btnListView = document.getElementById('btnListView');

            if (type === 'list') {
                projectGrid.classList.add('list-mode');
                btnGridView?.classList.remove('active');
                btnListView?.classList.add('active');
                localStorage.setItem('myProjectViewMode', 'list');
            } else {
                projectGrid.classList.remove('list-mode');
                btnListView?.classList.remove('active');
                btnGridView?.classList.add('active');
                localStorage.setItem('myProjectViewMode', 'grid');
            }
        }

        keywordInput?.addEventListener('input', function () {
            applyProjectFilters();
        });

        approvalFilter?.addEventListener('change', function () {
            applyProjectFilters();
        });

        stageFilter?.addEventListener('change', function () {
            applyProjectFilters();
        });

        sortFilter?.addEventListener('change', function () {
            applyProjectFilters();
        });

        document.addEventListener('DOMContentLoaded', function () {
            const savedViewMode = localStorage.getItem('myProjectViewMode');

            if (savedViewMode === 'list') {
                setProjectView('list');
            }

            applyProjectFilters();
        });
    </script>
}