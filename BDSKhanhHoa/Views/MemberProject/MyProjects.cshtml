@model IEnumerable<BDSKhanhHoa.Models.Project>

@{
    ViewData["Title"] = "Quản lý Dự án của tôi";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    var projects = Model?.ToList() ?? new List<BDSKhanhHoa.Models.Project>();

    int totalProjects = projects.Count;
    int approvedCount = projects.Count(x => x.ApprovalStatus == "Approved" || x.ApprovalStatus == "Đã duyệt");
    int pendingCount = projects.Count(x => x.ApprovalStatus == "Pending" || x.ApprovalStatus == "Chờ duyệt");
    int rejectedCount = projects.Count(x => x.ApprovalStatus == "Rejected" || x.ApprovalStatus == "Từ chối");

    int sellingCount = projects.Count(x => x.ProjectStatus == "Đang mở bán");
    int comingSoonCount = projects.Count(x => x.ProjectStatus == "Sắp mở bán");
    int handedCount = projects.Count(x => x.ProjectStatus == "Đã bàn giao");
}

@functions {
    public string GetApprovalText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Chưa xác định";
        return status.Trim() switch
        {
            "Approved" => "Đã phê duyệt",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Đã duyệt" => "Đã phê duyệt",
            "Chờ duyệt" => "Chờ duyệt",
            "Từ chối" => "Bị từ chối",
            _ => status.Trim()
        };
    }

    public string GetApprovalClass(string? status)
    {
        return GetApprovalText(status) switch
        {
            "Đã phê duyệt" => "ap-approved",
            "Chờ duyệt" => "ap-pending",
            "Bị từ chối" => "ap-rejected",
            _ => "ap-muted"
        };
    }

    public string GetApprovalFilterValue(string? status)
    {
        return GetApprovalText(status) switch
        {
            "Đã phê duyệt" => "approved",
            "Chờ duyệt" => "pending",
            "Bị từ chối" => "rejected",
            _ => "other"
        };
    }

    public string GetProjectStatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "stage-muted";
        return status.Trim() switch
        {
            "Đang mở bán" => "stage-selling",
            "Sắp mở bán" => "stage-coming",
            "Đã bàn giao" => "stage-handed",
            _ => "stage-muted"
        };
    }

    public string SafeText(string? value, string fallback = "Đang cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }
}

@section Styles {
    <style>
        :root {
            --p-primary: #2563eb;
            --p-primary-dark: #1d4ed8;
            --p-success: #059669;
            --p-warning: #d97706;
            --p-danger: #dc2626;
            --p-dark: #0f172a;
            --p-muted: #64748b;
            --p-border: #e2e8f0;
            --p-soft: #f8fafc;
            --p-card: #fff;
            --p-shadow: 0 14px 34px rgba(15,23,42,.07);
            --p-shadow-hover: 0 20px 46px rgba(15,23,42,.12);
        }

        .mp-page {
            max-width: 100%;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .mp-hero, .mp-filter, .project-card, .empty-box {
            background: var(--p-card);
            border: 1px solid rgba(148,163,184,.24);
            border-radius: 22px;
            box-shadow: var(--p-shadow);
            overflow: hidden;
        }

        .mp-hero {
            padding: 22px;
            background: radial-gradient(circle at top right,rgba(37,99,235,.13),transparent 280px),#fff;
        }

        .mp-hero-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 14px;
            flex-wrap: wrap;
        }

        .mp-title {
            color: var(--p-dark);
            font-size: clamp(1.25rem,2.1vw,1.9rem);
            font-weight: 950;
            letter-spacing: -.04em;
            margin: 0 0 7px;
        }

        .mp-subtitle {
            color: var(--p-muted);
            font-weight: 650;
            line-height: 1.6;
            margin: 0;
            max-width: 820px;
        }

        .mp-note {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 42px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 8px 13px;
            font-size: .82rem;
            font-weight: 900;
            white-space: nowrap;
        }

        .mp-stats {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 12px;
        }

        .mp-stat {
            min-width: 0;
            min-height: 100px;
            border-radius: 18px;
            padding: 15px;
            color: #fff;
            box-shadow: 0 10px 24px rgba(15,23,42,.10);
        }

            .mp-stat small {
                display: block;
                font-size: .66rem;
                text-transform: uppercase;
                letter-spacing: .07em;
                font-weight: 950;
                opacity: .9;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .mp-stat strong {
                display: block;
                margin-top: 8px;
                font-size: 1.75rem;
                line-height: 1;
                font-weight: 950;
            }

            .mp-stat span {
                display: block;
                margin-top: 7px;
                font-size: .76rem;
                font-weight: 750;
                opacity: .9;
            }

        .bg-blue {
            background: linear-gradient(135deg,#1d4ed8,#60a5fa)
        }

        .bg-green {
            background: linear-gradient(135deg,#047857,#34d399)
        }

        .bg-amber {
            background: linear-gradient(135deg,#b45309,#f59e0b)
        }

        .bg-red {
            background: linear-gradient(135deg,#b91c1c,#fb7185)
        }

        .mp-filter {
            padding: 16px;
        }

        .filter-label {
            display: block;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #475569;
            font-weight: 950;
            margin-bottom: 7px;
        }

        .filter-control {
            min-height: 44px;
            border-radius: 14px;
            border: 1px solid #dbe3ef;
            color: #1e293b;
            font-weight: 750;
            box-shadow: none !important;
        }

            .filter-control:focus {
                border-color: var(--p-primary);
                box-shadow: 0 0 0 4px rgba(37,99,235,.08) !important;
            }

        .btn-filter-primary, .btn-filter-light {
            min-height: 44px;
            border-radius: 14px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .btn-filter-primary {
            border: 0;
            background: linear-gradient(135deg,var(--p-primary),var(--p-primary-dark));
            color: #fff;
        }

        .btn-filter-light {
            background: #fff;
            border: 1px solid var(--p-border);
            color: var(--p-dark);
        }

        .toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .result-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #334155;
            font-weight: 850;
            background: #fff;
            border: 1px solid var(--p-border);
            border-radius: 999px;
            padding: 9px 14px;
        }

        .project-grid {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 14px;
        }

        .project-card {
            min-width: 0;
            display: flex;
            flex-direction: column;
            transition: .22s ease;
        }

            .project-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--p-shadow-hover);
                border-color: rgba(37,99,235,.28);
            }

        .cover {
            position: relative;
            height: 170px;
            background: #f1f5f9;
            overflow: hidden;
        }

            .cover img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .35s ease;
            }

        .project-card:hover .cover img {
            transform: scale(1.04);
        }

        .badge-approval, .badge-stage {
            position: absolute;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 7px 10px;
            font-size: .68rem;
            font-weight: 950;
            backdrop-filter: blur(12px);
            box-shadow: 0 8px 18px rgba(15,23,42,.13);
        }

        .badge-approval {
            top: 10px;
            left: 10px;
            border: 1px solid rgba(255,255,255,.72);
        }

        .badge-stage {
            right: 10px;
            bottom: 10px;
            color: #fff;
        }

        .ap-approved {
            background: rgba(220,252,231,.94);
            color: #047857
        }

        .ap-pending {
            background: rgba(254,243,199,.94);
            color: #b45309
        }

        .ap-rejected {
            background: rgba(254,226,226,.94);
            color: #b91c1c
        }

        .ap-muted {
            background: rgba(241,245,249,.94);
            color: #475569
        }

        .stage-selling {
            background: rgba(5,150,105,.92)
        }

        .stage-coming {
            background: rgba(217,119,6,.92)
        }

        .stage-handed {
            background: rgba(79,70,229,.92)
        }

        .stage-muted {
            background: rgba(71,85,105,.90)
        }

        .project-body {
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 11px;
            flex: 1;
        }

        .project-name {
            color: var(--p-dark);
            font-size: 1.02rem;
            line-height: 1.4;
            font-weight: 950;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .project-investor, .meta-item {
            color: #475569;
            font-size: .84rem;
            font-weight: 700;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .meta-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
        }

        .meta-item {
            display: flex;
            align-items: flex-start;
            gap: 7px;
        }

            .meta-item i {
                color: var(--p-primary);
                flex-shrink: 0;
                margin-top: 1px;
            }

        .price-row {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 8px;
            margin-top: auto;
            padding-top: 11px;
            border-top: 1px dashed var(--p-border);
        }

        .price-box {
            min-width: 0;
            border-radius: 14px;
            background: #f8fafc;
            border: 1px solid var(--p-border);
            padding: 9px 10px;
        }

            .price-box span {
                display: block;
                color: var(--p-muted);
                font-size: .66rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: .06em;
                margin-bottom: 4px;
            }

            .price-box strong {
                display: block;
                color: var(--p-dark);
                font-size: .84rem;
                font-weight: 950;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .project-actions {
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 8px;
            margin-top: 3px;
        }

        .project-action {
            min-height: 40px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-size: .8rem;
            font-weight: 900;
            border: 1px solid var(--p-border);
            background: #fff;
            color: #334155;
            text-decoration: none;
            transition: .18s ease;
        }

            .project-action:hover {
                color: #fff;
                background: var(--p-primary);
                border-color: var(--p-primary);
            }

            .project-action.disabled {
                pointer-events: none;
                opacity: .45;
            }

        .empty-box {
            padding: 45px 18px;
            text-align: center;
        }

        .empty-icon {
            width: 76px;
            height: 76px;
            display: grid;
            place-items: center;
            margin: 0 auto 14px;
            border-radius: 24px;
            background: #f1f5f9;
            color: #94a3b8;
            font-size: 2.2rem;
        }

        .empty-title {
            color: var(--p-dark);
            font-weight: 950;
            margin-bottom: 8px;
        }

        .empty-desc {
            color: var(--p-muted);
            font-weight: 650;
            max-width: 560px;
            margin: 0 auto;
            line-height: 1.65;
        }

        .no-filter-result {
            display: none;
        }

        @@media (max-width:1199.98px) {
            .project-grid {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }

            .mp-stats {
                grid-template-columns: repeat(2,minmax(0,1fr));
            }
        }

        @@media (max-width:575.98px) {
            .mp-page {
                gap: 10px;
            }

            .mp-hero, .mp-filter, .project-card, .empty-box {
                border-radius: 18px;
            }

            .mp-hero, .mp-filter {
                padding: 13px;
            }

            .mp-subtitle {
                display: none;
            }

            .mp-note, .result-count {
                width: 100%;
                white-space: normal;
                text-align: center;
            }

            .mp-stats {
                gap: 8px;
            }

            .mp-stat {
                min-height: 78px;
                padding: 10px;
                border-radius: 14px;
            }

                .mp-stat strong {
                    font-size: 1.35rem;
                }

                .mp-stat small {
                    font-size: .55rem;
                }

                .mp-stat span {
                    display: none;
                }

            .project-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .cover {
                height: 158px;
            }

            .price-row, .project-actions {
                grid-template-columns: 1fr;
            }

            .toolbar {
                display: block;
            }

            .btn-filter-primary, .btn-filter-light {
                width: 100%;
            }
        }
    </style>
}

<div class="mp-page">
    <section class="mp-hero">
        <div class="mp-hero-row">
            <div>
                <h1 class="mp-title"><i class="bi bi-buildings-fill text-primary me-2"></i>Dự án của tôi</h1>
                <p class="mp-subtitle">Theo dõi dự án, trạng thái phê duyệt, tiến độ mở bán, hồ sơ pháp lý và đường dẫn công khai bằng bố cục thẻ. Không dùng bảng nên không phát sinh thanh lướt ngang.</p>
            </div>
            <span class="mp-note"><i class="bi bi-shield-check"></i> Chủ đầu tư không tự tạo dự án mới</span>
        </div>
    </section>

    <section class="mp-stats">
        <div class="mp-stat bg-blue"><small>Tổng dự án</small><strong>@totalProjects</strong><span>Dự án được phân quyền</span></div>
        <div class="mp-stat bg-green"><small>Đã phê duyệt</small><strong>@approvedCount</strong><span>@sellingCount dự án đang mở bán</span></div>
        <div class="mp-stat bg-amber"><small>Chờ duyệt</small><strong>@pendingCount</strong><span>@comingSoonCount dự án sắp mở bán</span></div>
        <div class="mp-stat bg-red"><small>Bị từ chối</small><strong>@rejectedCount</strong><span>@handedCount dự án đã bàn giao</span></div>
    </section>

    <section class="mp-filter">
        <div class="row g-3 align-items-end">
            <div class="col-xl-4 col-lg-12">
                <label class="filter-label">Tìm kiếm dự án</label>
                <input id="projectKeyword" type="text" class="form-control filter-control" placeholder="Tên dự án, chủ đầu tư, khu vực, loại hình..." />
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4">
                <label class="filter-label">Phê duyệt</label>
                <select id="approvalFilter" class="form-select filter-control">
                    <option value="all">Tất cả</option>
                    <option value="approved">Đã phê duyệt</option>
                    <option value="pending">Chờ duyệt</option>
                    <option value="rejected">Bị từ chối</option>
                    <option value="other">Khác</option>
                </select>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4">
                <label class="filter-label">Tiến độ</label>
                <select id="stageFilter" class="form-select filter-control">
                    <option value="all">Tất cả</option>
                    <option value="Đang mở bán">Đang mở bán</option>
                    <option value="Sắp mở bán">Sắp mở bán</option>
                    <option value="Đã bàn giao">Đã bàn giao</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4">
                <label class="filter-label">Sắp xếp</label>
                <select id="sortFilter" class="form-select filter-control">
                    <option value="newest">Mới nhất</option>
                    <option value="oldest">Cũ nhất</option>
                    <option value="name-asc">Tên A-Z</option>
                    <option value="name-desc">Tên Z-A</option>
                </select>
            </div>
            <div class="col-xl-2 col-lg-12">
                <div class="d-grid gap-2 d-xl-flex">
                    <button type="button" class="btn btn-filter-primary flex-fill" onclick="applyProjectFilters()"><i class="bi bi-funnel-fill"></i> Lọc</button>
                    <button type="button" class="btn btn-filter-light" onclick="resetProjectFilters()" title="Xóa bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></button>
                </div>
            </div>
        </div>
    </section>

    @if (!projects.Any())
    {
        <section class="empty-box">
            <div class="empty-icon"><i class="bi bi-folder-x"></i></div>
            <h3 class="empty-title">Chưa có dự án</h3>
            <p class="empty-desc">Khi Admin gán dự án cho tài khoản của bạn, danh sách dự án sẽ hiển thị tại đây.</p>
            <div class="mt-4">
                <a href="/SupportTickets/Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold"><i class="bi bi-headset me-1"></i>Gửi yêu cầu hỗ trợ</a>
            </div>
        </section>
    }
    else
    {
        <section class="toolbar">
            <div class="result-count">
                <i class="bi bi-kanban-fill text-primary"></i>
                Đang hiển thị <span id="visibleProjectCount">@projects.Count</span> / @projects.Count dự án
            </div>
        </section>

        <section id="projectGrid" class="project-grid">
            @foreach (var item in projects)
            {
                string coverImage = string.IsNullOrWhiteSpace(item.MainImage) ? "/images/no-image.jpg" : item.MainImage;
                string approvalText = GetApprovalText(item.ApprovalStatus);
                string approvalClass = GetApprovalClass(item.ApprovalStatus);
                string approvalValue = GetApprovalFilterValue(item.ApprovalStatus);
                string projectStatusText = SafeText(item.ProjectStatus, "Chưa cập nhật");
                string projectStatusClass = GetProjectStatusClass(item.ProjectStatus);
                string wardName = item.Ward?.WardName ?? "Chưa cập nhật";
                string areaName = item.Ward?.Area?.AreaName ?? item.Area?.AreaName ?? "Chưa cập nhật";
                string investor = SafeText(item.Investor, "Chưa cập nhật");
                string projectType = SafeText(item.ProjectType, "Chưa cập nhật");

                string priceText = "Liên hệ";
                if (item.PriceMin.HasValue && item.PriceMax.HasValue)
                {
                    priceText = $"{item.PriceMin.Value:0.##} - {item.PriceMax.Value:0.##} {SafeText(item.PriceUnit, "")}";
                }
                else if (item.PriceMin.HasValue)
                {
                    priceText = $"Từ {item.PriceMin.Value:0.##} {SafeText(item.PriceUnit, "")}";
                }

                string areaText = "Đang cập nhật";
                if (item.AreaMin.HasValue && item.AreaMax.HasValue)
                {
                    areaText = $"{item.AreaMin.Value:0.##} - {item.AreaMax.Value:0.##} m²";
                }
                else if (item.AreaMin.HasValue)
                {
                    areaText = $"Từ {item.AreaMin.Value:0.##} m²";
                }

                string searchText = $"{item.ProjectName} {investor} {wardName} {areaName} {projectStatusText} {approvalText} {projectType}".ToLowerInvariant();
                string stageValue = string.IsNullOrWhiteSpace(item.ProjectStatus) ? "Khác" : item.ProjectStatus.Trim();
                bool hasLegalDocs = !string.IsNullOrWhiteSpace(item.LegalDocs);
                bool isApproved = approvalValue == "approved";

                <article class="project-card js-project-card"
                         data-keyword="@searchText"
                         data-approval="@approvalValue"
                         data-stage="@stageValue"
                         data-name="@SafeText(item.ProjectName, "").ToLowerInvariant()"
                         data-created="@item.CreatedAt.Ticks">
                    <div class="cover">
                        <img src="@coverImage" alt="@item.ProjectName" loading="lazy" onerror="this.src='/images/no-image.jpg'" />
                        <span class="badge-approval @approvalClass"><i class="bi bi-circle-fill" style="font-size:.45rem;"></i>@approvalText</span>
                        <span class="badge-stage @projectStatusClass"><i class="bi bi-activity"></i>@projectStatusText</span>
                    </div>

                    <div class="project-body">
                        <h2 class="project-name" title="@item.ProjectName">@item.ProjectName</h2>
                        <div class="project-investor" title="@investor"><i class="bi bi-building me-1 text-primary"></i>Chủ đầu tư: <strong>@investor</strong></div>

                        <div class="meta-grid">
                            <div class="meta-item"><i class="bi bi-geo-alt-fill"></i><span>@wardName, @areaName</span></div>
                            <div class="meta-item"><i class="bi bi-calendar-event-fill"></i><span>Ngày tạo: @item.CreatedAt.ToString("dd/MM/yyyy")</span></div>
                            <div class="meta-item"><i class="bi bi-layers-fill"></i><span>Loại hình: @projectType</span></div>
                        </div>

                        <div class="price-row">
                            <div class="price-box"><span>Giá tham khảo</span><strong title="@priceText">@priceText</strong></div>
                            <div class="price-box"><span>Diện tích</span><strong title="@areaText">@areaText</strong></div>
                        </div>

                        <div class="project-actions">
                            @if (hasLegalDocs)
                            {
                                <a href="@item.LegalDocs" target="_blank" class="project-action" title="Xem hồ sơ pháp lý"><i class="bi bi-file-earmark-pdf-fill"></i>Hồ sơ</a>
                            }
                            else
                            {
                                <span class="project-action disabled" title="Chưa có hồ sơ pháp lý"><i class="bi bi-file-earmark-x"></i>Hồ sơ</span>
                            }

                            @if (isApproved)
                            {
                                <a href="/Project/Details/@item.ProjectID" target="_blank" class="project-action" title="Xem dự án trên website"><i class="bi bi-eye-fill"></i>Xem</a>
                            }
                            else
                            {
                                <span class="project-action disabled" title="Dự án chưa được phê duyệt công khai"><i class="bi bi-eye-slash-fill"></i>Xem</span>
                            }

                            <a href="/SupportTickets/Index" class="project-action" title="Gửi yêu cầu hỗ trợ"><i class="bi bi-headset"></i>Hỗ trợ</a>
                        </div>
                    </div>
                </article>
            }
        </section>

        <section id="noFilterResult" class="empty-box no-filter-result">
            <div class="empty-icon"><i class="bi bi-search"></i></div>
            <h3 class="empty-title">Không tìm thấy dự án phù hợp</h3>
            <p class="empty-desc">Không có dự án nào khớp với bộ lọc hiện tại. Hãy thử đổi từ khóa, trạng thái phê duyệt hoặc tiến độ dự án.</p>
            <div class="mt-4">
                <button type="button" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold" onclick="resetProjectFilters()"><i class="bi bi-arrow-counterclockwise me-1"></i>Xóa bộ lọc</button>
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        const projectGrid = document.getElementById('projectGrid');
        const projectCards = Array.from(document.querySelectorAll('.js-project-card'));
        const visibleProjectCount = document.getElementById('visibleProjectCount');
        const noFilterResult = document.getElementById('noFilterResult');
        const keywordInput = document.getElementById('projectKeyword');
        const approvalFilter = document.getElementById('approvalFilter');
        const stageFilter = document.getElementById('stageFilter');
        const sortFilter = document.getElementById('sortFilter');

        function normalizeText(value) {
            return (value || '').toString().trim().toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
        }

        function applyProjectFilters() {
            if (!projectGrid) return;

            const keyword = normalizeText(keywordInput?.value);
            const approval = approvalFilter?.value || 'all';
            const stage = stageFilter?.value || 'all';
            const sortType = sortFilter?.value || 'newest';
            let visibleCards = [];

            projectCards.forEach(card => {
                const cardKeyword = normalizeText(card.dataset.keyword);
                const cardApproval = card.dataset.approval || 'other';
                const cardStage = card.dataset.stage || 'Khác';

                const isVisible =
                    (!keyword || cardKeyword.includes(keyword)) &&
                    (approval === 'all' || cardApproval === approval) &&
                    (stage === 'all' || cardStage === stage);

                card.style.display = isVisible ? '' : 'none';
                if (isVisible) visibleCards.push(card);
            });

            sortVisibleCards(visibleCards, sortType);

            if (visibleProjectCount) visibleProjectCount.textContent = visibleCards.length;
            if (noFilterResult) noFilterResult.style.display = visibleCards.length === 0 ? 'block' : 'none';
        }

        function sortVisibleCards(cards, sortType) {
            if (!projectGrid || !cards.length) return;

            const sortedCards = [...cards];
            sortedCards.sort((a, b) => {
                const nameA = a.dataset.name || '';
                const nameB = b.dataset.name || '';
                const createdA = Number(a.dataset.created || 0);
                const createdB = Number(b.dataset.created || 0);

                switch (sortType) {
                    case 'oldest': return createdA - createdB;
                    case 'name-asc': return nameA.localeCompare(nameB);
                    case 'name-desc': return nameB.localeCompare(nameA);
                    case 'newest':
                    default: return createdB - createdA;
                }
            });

            sortedCards.forEach(card => projectGrid.appendChild(card));
        }

        function resetProjectFilters() {
            if (keywordInput) keywordInput.value = '';
            if (approvalFilter) approvalFilter.value = 'all';
            if (stageFilter) stageFilter.value = 'all';
            if (sortFilter) sortFilter.value = 'newest';
            applyProjectFilters();
        }

        keywordInput?.addEventListener('input', applyProjectFilters);
        approvalFilter?.addEventListener('change', applyProjectFilters);
        stageFilter?.addEventListener('change', applyProjectFilters);
        sortFilter?.addEventListener('change', applyProjectFilters);

        document.addEventListener('DOMContentLoaded', applyProjectFilters);
    </script>
}
