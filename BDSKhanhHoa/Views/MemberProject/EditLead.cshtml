@model BDSKhanhHoa.Models.ProjectLead

@{
    ViewData["Title"] = "Cập nhật khách hàng";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    string returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "MemberProject") ?? "/MemberProject/Index";

    bool isClosed = Model.LeadStatus == "Resolved"
                 || Model.LeadStatus == "Invalid"
                 || Model.LeadStatus == "Đã chốt"
                 || Model.LeadStatus == "Không hợp lệ";

    string customerInitial = string.IsNullOrWhiteSpace(Model.Name)
        ? "K"
        : Model.Name.Substring(0, 1).ToUpper();
}

@functions {
    public string GetLeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Khách mới";

        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string GetLeadStatusClass(string? status)
    {
        string text = GetLeadStatusText(status);

        return text switch
        {
            "Khách mới" => "status-new",
            "Đang chăm sóc" => "status-contacted",
            "Đã chốt" => "status-resolved",
            "Không hợp lệ" => "status-invalid",
            _ => "status-unknown"
        };
    }
}

@section Styles {
    <style>
        :root {
            --lead-primary: #2563eb;
            --lead-primary-dark: #1d4ed8;
            --lead-success: #059669;
            --lead-warning: #d97706;
            --lead-danger: #dc2626;
            --lead-dark: #0f172a;
            --lead-muted: #64748b;
            --lead-border: #e2e8f0;
            --lead-soft: #f8fafc;
            --lead-card: #ffffff;
            --lead-radius: 24px;
            --lead-shadow: 0 16px 38px rgba(15, 23, 42, .07);
        }

        .lead-top-actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .lead-grid {
            display: grid;
            grid-template-columns: 380px minmax(0, 1fr);
            gap: 24px;
            align-items: start;
        }

        .lead-card,
        .lead-panel,
        .lead-alert {
            background: var(--lead-card);
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: var(--lead-radius);
            box-shadow: var(--lead-shadow);
        }

        .lead-card {
            padding: 24px;
            position: sticky;
            top: 96px;
        }

        .lead-avatar {
            width: 92px;
            height: 92px;
            border-radius: 26px;
            display: grid;
            place-items: center;
            margin: 0 auto 16px;
            background: linear-gradient(135deg, var(--lead-primary), #4f46e5);
            color: #fff;
            font-size: 2.8rem;
            font-weight: 950;
            box-shadow: 0 16px 28px rgba(37, 99, 235, .24);
        }

        .lead-name {
            font-size: 1.35rem;
            font-weight: 950;
            color: var(--lead-dark);
            text-align: center;
            margin-bottom: 8px;
            letter-spacing: -.035em;
        }

        .lead-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 8px 13px;
            font-size: .76rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .status-new {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-contacted {
            background: #fef3c7;
            color: #b45309;
        }

        .status-resolved {
            background: #dcfce7;
            color: #047857;
        }

        .status-invalid {
            background: #f1f5f9;
            color: #475569;
            text-decoration: line-through;
        }

        .status-unknown {
            background: #e0e7ff;
            color: #3730a3;
        }

        .lead-info-block {
            margin-top: 20px;
        }

        .lead-info-label {
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #64748b;
            font-weight: 950;
            margin-bottom: 8px;
        }

        .lead-info-value {
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid var(--lead-border);
            padding: 13px 14px;
            color: #1e293b;
            font-weight: 800;
            line-height: 1.55;
            word-break: break-word;
        }

        .lead-panel {
            padding: 24px;
            margin-bottom: 22px;
        }

        .lead-panel-title {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--lead-dark);
            font-size: 1.15rem;
            font-weight: 950;
            margin-bottom: 18px;
        }

        .lead-title-icon {
            width: 42px;
            height: 42px;
            border-radius: 15px;
            display: grid;
            place-items: center;
            color: #fff;
            background: var(--lead-primary);
            flex-shrink: 0;
        }

        .lead-label {
            font-size: .76rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #475569;
            font-weight: 950;
            margin-bottom: 8px;
        }

        .lead-input {
            min-height: 50px;
            border-radius: 16px;
            border: 1px solid #dbe3ef;
            background: #fff;
            box-shadow: none !important;
            font-weight: 750;
            color: #1e293b;
        }

            .lead-input:focus {
                border-color: var(--lead-primary);
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .08) !important;
            }

            .lead-input:disabled {
                background: #f1f5f9;
                color: #94a3b8;
                cursor: not-allowed;
            }

        textarea.lead-input {
            min-height: 138px;
            resize: vertical;
            line-height: 1.65;
        }

        .btn-lead-primary {
            min-height: 50px;
            border-radius: 16px;
            border: 0;
            background: linear-gradient(135deg, var(--lead-primary), var(--lead-primary-dark));
            color: #fff;
            font-weight: 950;
            box-shadow: 0 14px 28px rgba(37, 99, 235, .22);
        }

            .btn-lead-primary:hover {
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-lead-dark {
            min-height: 50px;
            border-radius: 16px;
            border: 0;
            background: #111827;
            color: #fff;
            font-weight: 950;
        }

            .btn-lead-dark:hover {
                color: #fff;
            }

        .btn-lead-light {
            min-height: 44px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid var(--lead-border);
            color: var(--lead-dark);
            font-weight: 900;
        }

        .lead-alert {
            padding: 18px;
            border-left: 5px solid var(--lead-danger);
            margin-bottom: 22px;
        }

        .schedule-panel {
            background: linear-gradient(135deg, #ecfdf5, #ffffff);
            border-color: #bbf7d0;
        }

            .schedule-panel.locked {
                background: #f8fafc;
                border-color: var(--lead-border);
            }

        .lead-note {
            border-radius: 16px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            padding: 14px;
            font-size: .88rem;
            font-weight: 750;
            line-height: 1.6;
        }

        @@media (max-width: 1199.98px) {
            .lead-grid {
                grid-template-columns: 1fr;
            }

            .lead-card {
                position: static;
            }
        }

        @@media (max-width: 575.98px) {
            .lead-card,
            .lead-panel,
            .lead-alert {
                border-radius: 20px;
                padding: 18px;
            }

            .lead-top-actions .btn {
                width: 100%;
            }

            .btn-lead-primary,
            .btn-lead-dark {
                width: 100%;
            }
        }
    </style>
}

<div class="lead-top-actions">
    <a href="@returnUrl" class="btn btn-lead-light">
        <i class="bi bi-arrow-left-circle-fill text-primary me-1"></i>
        Quay lại phễu khách hàng
    </a>

    <a href="@Url.Action("LeadHistory", "MemberProject", new { id = Model.LeadID })" class="btn btn-lead-light">
        <i class="bi bi-clock-history text-success me-1"></i>
        Xem hồ sơ 360
    </a>
</div>

@if (isClosed)
{
    <div class="lead-alert">
        <div class="d-flex gap-3 align-items-start">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger text-white flex-shrink-0" style="width:44px;height:44px;">
                <i class="bi bi-lock-fill fs-5"></i>
            </div>

            <div>
                <h5 class="fw-bold text-danger mb-1">Hồ sơ khách hàng đã đóng</h5>
                <p class="mb-0 text-dark">
                    Khách hàng đã chốt hoặc bị đánh dấu không hợp lệ. Hệ thống khóa thao tác chỉnh sửa và không cho tạo lịch hẹn mới để bảo toàn lịch sử CRM.
                </p>
            </div>
        </div>
    </div>
}

<div class="lead-grid">
    <aside class="lead-card">
        <div class="lead-avatar">@customerInitial</div>

        <h2 class="lead-name">@Model.Name</h2>

        <div class="text-center">
            <span class="lead-status @GetLeadStatusClass(Model.LeadStatus)">
                <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                @GetLeadStatusText(Model.LeadStatus)
            </span>
        </div>

        <div class="lead-info-block">
            <div class="lead-info-label">Số điện thoại</div>
            <div class="lead-info-value d-flex justify-content-between align-items-center gap-2">
                <span>@Model.Phone</span>
                <a href="tel:@Model.Phone" class="btn btn-success rounded-circle flex-shrink-0" style="width:42px;height:42px;display:flex;align-items:center;justify-content:center;">
                    <i class="bi bi-telephone-outbound-fill"></i>
                </a>
            </div>
        </div>

        <div class="lead-info-block">
            <div class="lead-info-label">Email</div>
            <div class="lead-info-value">
                <i class="bi bi-envelope-fill text-primary me-1"></i>
                @(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cung cấp" : Model.Email)
            </div>
        </div>

        <div class="lead-info-block">
            <div class="lead-info-label">Dự án quan tâm</div>
            <div class="lead-info-value text-primary">
                <i class="bi bi-building-fill me-1"></i>
                @(Model.Project?.ProjectName ?? "Chưa xác định")
            </div>
        </div>

        <div class="lead-info-block">
            <div class="lead-info-label">Nội dung khách gửi</div>
            <div class="lead-info-value">
                “@(string.IsNullOrWhiteSpace(Model.Message) ? "Khách gửi yêu cầu tư vấn và chưa để lại lời nhắn chi tiết." : Model.Message)”
            </div>
            <div class="text-end mt-2 text-muted small fw-bold">
                @Model.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
            </div>
        </div>
    </aside>

    <section>
        <div class="lead-panel">
            <div class="lead-panel-title">
                <span class="lead-title-icon">
                    <i class="bi bi-person-lines-fill"></i>
                </span>
                <span>Cập nhật tiến độ chăm sóc</span>
            </div>

            <form asp-action="UpdateLeadStatus" asp-controller="MemberProject" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.LeadID" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="row g-4">
                    <div class="col-lg-5">
                        <label class="form-label lead-label">Trạng thái khách hàng</label>

                        <select name="status" class="form-select lead-input" disabled="@isClosed">
                            <option value="New" selected="@(Model.LeadStatus == "New")">Khách mới</option>
                            <option value="Contacted" selected="@(Model.LeadStatus == "Contacted")">Đang chăm sóc</option>
                            <option value="Resolved" selected="@(Model.LeadStatus == "Resolved")">Đã chốt thành công</option>
                            <option value="Invalid" selected="@(Model.LeadStatus == "Invalid")">Không hợp lệ / hủy</option>
                        </select>

                        @if (!isClosed)
                        {
                            <div class="lead-note mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Khi chọn <strong>Đã chốt</strong> hoặc <strong>Không hợp lệ</strong>, hồ sơ sẽ bị khóa để bảo toàn dữ liệu.
                            </div>
                        }
                    </div>

                    <div class="col-lg-7">
                        <label class="form-label lead-label">Ghi chú chăm sóc mới</label>

                        <textarea name="note"
                                  class="form-control lead-input"
                                  placeholder="Ghi lại nội dung cuộc gọi, nhu cầu, ngân sách, thời điểm khách muốn xem dự án..."
                                  disabled="@isClosed"></textarea>
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-lead-dark px-4" disabled="@isClosed">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i>
                            Lưu nhật ký CRM
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="lead-panel schedule-panel @(isClosed ? "locked" : "")">
            <div class="lead-panel-title">
                <span class="lead-title-icon" style="background:var(--lead-success);">
                    <i class="bi bi-calendar-plus-fill"></i>
                </span>
                <span>Điều phối lịch xem dự án</span>
            </div>

            <p class="text-muted fw-semibold mb-4">
                Tạo lịch hẹn cho khách hàng và phân công nhân viên thực địa phụ trách đón/giới thiệu dự án.
            </p>

            <form asp-action="ScheduleSiteVisit" asp-controller="MemberProject" method="post" class="row g-4">
                @Html.AntiForgeryToken()

                <input type="hidden" name="leadId" value="@Model.LeadID" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <div class="col-md-6 col-xl-4">
                    <label class="form-label lead-label">Ngày xem dự án</label>
                    <input type="date"
                           name="appointmentDate"
                           class="form-control lead-input"
                           min="@DateTime.Now.ToString("yyyy-MM-dd")"
                           required
                           disabled="@isClosed" />
                </div>

                <div class="col-md-6 col-xl-4">
                    <label class="form-label lead-label">Giờ hẹn</label>
                    <input type="time"
                           name="appointmentTime"
                           class="form-control lead-input"
                           required
                           disabled="@isClosed" />
                </div>

                <div class="col-md-12 col-xl-4">
                    <label class="form-label lead-label">Nhân viên phụ trách</label>
                    <input type="text"
                           name="assignedStaffName"
                           class="form-control lead-input"
                           placeholder="Ví dụ: Nguyễn Văn A"
                           required
                           disabled="@isClosed" />
                </div>

                <div class="col-12">
                    <label class="form-label lead-label">Email nhân viên</label>
                    <input type="email"
                           name="assignedStaffEmail"
                           class="form-control lead-input"
                           placeholder="nhanvien@congty.com"
                           required
                           disabled="@isClosed" />
                </div>

                <div class="col-12">
                    <label class="form-label lead-label">Ghi chú điều phối</label>
                    <textarea name="note"
                              class="form-control lead-input"
                              placeholder="Ví dụ: Khách cần xem block A, chuẩn bị bảng giá mới nhất, đón khách tại sảnh chính..."
                              disabled="@isClosed"></textarea>
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-lead-primary px-4" disabled="@isClosed">
                        <i class="bi bi-send-fill me-1"></i>
                        Tạo lịch hẹn
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>