@model BDSKhanhHoa.Models.ProjectLead

@{
    ViewData["Title"] = "Chăm sóc khách hàng";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    string returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "MemberProject") ?? "/MemberProject/Index";

    bool isClosed = Model.LeadStatus == "Resolved"
                 || Model.LeadStatus == "Invalid"
                 || Model.LeadStatus == "Đã chốt"
                 || Model.LeadStatus == "Không hợp lệ";

    var activeAppointments = ViewBag.ActiveAppointments as List<BDSKhanhHoa.Models.Appointment>
        ?? new List<BDSKhanhHoa.Models.Appointment>();

    bool hasActiveAppointment = activeAppointments.Any();

    string customerInitial = string.IsNullOrWhiteSpace(Model.Name)
        ? "K"
        : Model.Name.Substring(0, 1).ToUpper();
}

@functions {
    public string LeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Khách mới";
        }

        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string LeadStatusClass(string? status)
    {
        return LeadStatusText(status) switch
        {
            "Khách mới" => "status-new",
            "Đang chăm sóc" => "status-contacted",
            "Đã chốt" => "status-resolved",
            "Không hợp lệ" => "status-invalid",
            _ => "status-unknown"
        };
    }

    public string SafeText(string? value, string fallback = "Chưa cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }
}

@section Styles {
    <style>
        :root {
            --lead-primary: #2563eb;
            --lead-primary-dark: #1d4ed8;
            --lead-success: #059669;
            --lead-warning: #d97706;
            --lead-danger: #dc2626;
            --lead-dark: #0f172a;
            --lead-muted: #64748b;
            --lead-border: #e2e8f0;
            --lead-soft: #f8fafc;
            --lead-card: #ffffff;
            --lead-radius: 24px;
            --lead-shadow: 0 16px 38px rgba(15, 23, 42, .07);
        }

        .lead-page {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .lead-top-actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .lead-grid {
            display: grid;
            grid-template-columns: 380px minmax(0, 1fr);
            gap: 24px;
            align-items: start;
        }

        .lead-card,
        .lead-panel,
        .lead-alert {
            background: var(--lead-card);
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: var(--lead-radius);
            box-shadow: var(--lead-shadow);
        }

        .lead-card {
            padding: 24px;
            position: sticky;
            top: 96px;
        }

        .lead-avatar {
            width: 92px;
            height: 92px;
            border-radius: 26px;
            display: grid;
            place-items: center;
            margin: 0 auto 16px;
            background: linear-gradient(135deg, var(--lead-primary), #4f46e5);
            color: #fff;
            font-size: 2.8rem;
            font-weight: 950;
            box-shadow: 0 16px 28px rgba(37, 99, 235, .24);
        }

        .lead-name {
            font-size: 1.35rem;
            font-weight: 950;
            color: var(--lead-dark);
            text-align: center;
            margin-bottom: 8px;
            letter-spacing: -.035em;
        }

        .lead-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 8px 13px;
            font-size: .76rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .status-new {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-contacted {
            background: #fef3c7;
            color: #b45309;
        }

        .status-resolved {
            background: #dcfce7;
            color: #047857;
        }

        .status-invalid {
            background: #f1f5f9;
            color: #475569;
            text-decoration: line-through;
        }

        .status-unknown {
            background: #e0e7ff;
            color: #3730a3;
        }

        .lead-info-block {
            margin-top: 20px;
        }

        .lead-info-label,
        .lead-label {
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #64748b;
            font-weight: 950;
            margin-bottom: 8px;
        }

        .lead-info-value {
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid var(--lead-border);
            padding: 13px 14px;
            color: #1e293b;
            font-weight: 800;
            line-height: 1.55;
            word-break: break-word;
        }

        .lead-panel {
            padding: 24px;
            margin-bottom: 22px;
        }

        .lead-panel-title {
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--lead-dark);
            font-size: 1.15rem;
            font-weight: 950;
            margin-bottom: 18px;
        }

        .lead-title-icon {
            width: 42px;
            height: 42px;
            border-radius: 15px;
            display: grid;
            place-items: center;
            color: #fff;
            background: var(--lead-primary);
            flex-shrink: 0;
        }

        .lead-input {
            min-height: 50px;
            border-radius: 16px;
            border: 1px solid #dbe3ef;
            background: #fff;
            box-shadow: none !important;
            font-weight: 750;
            color: #1e293b;
        }

            .lead-input:focus {
                border-color: var(--lead-primary);
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .08) !important;
            }

            .lead-input:disabled {
                background: #f1f5f9;
                color: #94a3b8;
                cursor: not-allowed;
            }

        textarea.lead-input {
            min-height: 138px;
            resize: vertical;
            line-height: 1.65;
        }

        .btn-lead-primary {
            min-height: 50px;
            border-radius: 16px;
            border: 0;
            background: linear-gradient(135deg, var(--lead-primary), var(--lead-primary-dark));
            color: #fff;
            font-weight: 950;
            box-shadow: 0 14px 28px rgba(37, 99, 235, .22);
        }

            .btn-lead-primary:hover {
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-lead-dark {
            min-height: 50px;
            border-radius: 16px;
            border: 0;
            background: #111827;
            color: #fff;
            font-weight: 950;
        }

            .btn-lead-dark:hover {
                color: #fff;
            }

        .btn-lead-light {
            min-height: 44px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid var(--lead-border);
            color: var(--lead-dark);
            font-weight: 900;
        }

        .lead-alert {
            padding: 18px;
            border-left: 5px solid var(--lead-danger);
        }

        .schedule-panel {
            background: linear-gradient(135deg, #ecfdf5, #ffffff);
            border-color: #bbf7d0;
        }

            .schedule-panel.locked {
                background: #f8fafc;
                border-color: var(--lead-border);
            }

        .lead-note {
            border-radius: 16px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            padding: 14px;
            font-size: .88rem;
            font-weight: 750;
            line-height: 1.6;
        }

        .active-appointment-box {
            border-radius: 18px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
            padding: 14px 16px;
            font-weight: 750;
            line-height: 1.55;
        }

        @@media (max-width: 1199.98px) {
            .lead-grid {
                grid-template-columns: 1fr;
            }

            .lead-card {
                position: static;
            }
        }

        @@media (max-width: 575.98px) {
            .lead-card, .lead-panel, .lead-alert {
                border-radius: 20px;
                padding: 18px;
            }

                .lead-top-actions .btn,
                .lead-panel .btn {
                    width: 100%;
                    justify-content: center;
                }
        }
    </style>
}

<div class="lead-page">
    <div class="lead-top-actions">
        <a href="@returnUrl" class="btn btn-lead-light">
            <i class="bi bi-arrow-left-circle-fill text-primary me-1"></i>
            Quay lại phễu khách hàng
        </a>

        <a href="@Url.Action("LeadHistory", "MemberProject", new { id = Model.LeadID })" class="btn btn-lead-light">
            <i class="bi bi-clock-history text-success me-1"></i>
            Xem hồ sơ 360
        </a>
    </div>

    @if (isClosed)
    {
        <div class="lead-alert">
            <div class="d-flex gap-3 align-items-start">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger text-white flex-shrink-0" style="width:44px;height:44px;">
                    <i class="bi bi-lock-fill fs-5"></i>
                </div>

                <div>
                    <h5 class="fw-bold text-danger mb-1">Hồ sơ khách hàng đã đóng</h5>
                    <p class="mb-0 text-dark">
                        Khách hàng đã chốt hoặc bị đánh dấu không hợp lệ. Hệ thống khóa thao tác chỉnh sửa và không cho tạo lịch hẹn mới để bảo toàn lịch sử CRM.
                    </p>
                </div>
            </div>
        </div>
    }

    <div class="lead-grid">
        <aside class="lead-card">
            <div class="lead-avatar">@customerInitial</div>

            <h2 class="lead-name">@Model.Name</h2>

            <div class="text-center">
                <span class="lead-status @LeadStatusClass(Model.LeadStatus)">
                    <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                    @LeadStatusText(Model.LeadStatus)
                </span>
            </div>

            <div class="lead-info-block">
                <div class="lead-info-label">Số điện thoại</div>
                <div class="lead-info-value d-flex justify-content-between align-items-center gap-2">
                    <span>@SafeText(Model.Phone)</span>

                    <a href="tel:@Model.Phone" class="btn btn-success rounded-circle flex-shrink-0" style="width:42px;height:42px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-telephone-outbound-fill"></i>
                    </a>
                </div>
            </div>

            <div class="lead-info-block">
                <div class="lead-info-label">Email</div>
                <div class="lead-info-value">
                    <i class="bi bi-envelope-fill text-primary me-1"></i>
                    @SafeText(Model.Email, "Chưa cung cấp")
                </div>
            </div>

            <div class="lead-info-block">
                <div class="lead-info-label">Dự án quan tâm</div>
                <div class="lead-info-value text-primary">
                    <i class="bi bi-building-fill me-1"></i>
                    @SafeText(Model.Project?.ProjectName, "Không rõ dự án")
                </div>
            </div>

            <div class="lead-info-block">
                <div class="lead-info-label">Khu vực dự án</div>
                <div class="lead-info-value">
                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                    @SafeText(Model.Project?.Ward?.WardName), @SafeText(Model.Project?.Ward?.Area?.AreaName)
                </div>
            </div>

            <div class="lead-info-block">
                <div class="lead-info-label">Ngày gửi yêu cầu</div>
                <div class="lead-info-value">
                    <i class="bi bi-clock-history text-secondary me-1"></i>
                    @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                </div>
            </div>

            @if (Model.Project != null)
            {
                <div class="d-grid gap-2 mt-4">
                    <a href="/Project/Details/@Model.ProjectID" target="_blank" class="btn btn-lead-light">
                        <i class="bi bi-eye-fill text-primary me-1"></i>
                        Xem dự án công khai
                    </a>
                </div>
            }
        </aside>

        <main>
            <section class="lead-panel">
                <div class="lead-panel-title">
                    <span class="lead-title-icon">
                        <i class="bi bi-chat-left-text-fill"></i>
                    </span>
                    <span>Nhu cầu khách hàng</span>
                </div>

                <div class="lead-info-value">
                    @(string.IsNullOrWhiteSpace(Model.Message) ? "Khách chưa để lại nội dung chi tiết." : Model.Message)
                </div>
            </section>

            <section class="lead-panel">
                <div class="lead-panel-title">
                    <span class="lead-title-icon" style="background:#111827;">
                        <i class="bi bi-clipboard2-check-fill"></i>
                    </span>
                    <span>Cập nhật trạng thái CRM</span>
                </div>

                <form asp-action="UpdateLeadStatus"
                      asp-controller="MemberProject"
                      method="post"
                      class="row g-4 js-confirm-form"
                      data-confirm-title="Lưu nhật ký CRM?"
                      data-confirm-text="Hệ thống sẽ cập nhật trạng thái và ghi lại lịch sử chăm sóc khách hàng."
                      data-confirm-icon="question"
                      data-confirm-button="Đồng ý lưu">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.LeadID" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="col-lg-5">
                        <label class="form-label lead-label">Trạng thái chăm sóc</label>

                        <select name="status"
                                id="leadStatusSelect"
                                class="form-select lead-input"
                                disabled="@isClosed"
                                required>
                            <option value="New" selected="@(Model.LeadStatus == "New" || Model.LeadStatus == "Mới")">
                                Khách mới
                            </option>

                            <option value="Contacted" selected="@(Model.LeadStatus == "Contacted" || Model.LeadStatus == "Đã liên hệ")">
                                Đang chăm sóc
                            </option>

                            <option value="Resolved" selected="@(Model.LeadStatus == "Resolved" || Model.LeadStatus == "Đã chốt")">
                                Đã chốt thành công
                            </option>

                            <option value="Invalid" selected="@(Model.LeadStatus == "Invalid" || Model.LeadStatus == "Không hợp lệ")">
                                Không hợp lệ / hủy
                            </option>
                        </select>

                        @if (!isClosed)
                        {
                            <div class="lead-note mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Không được lùi từ <strong>Đang chăm sóc</strong> về <strong>Khách mới</strong>.
                                Khi chọn <strong>Đã chốt</strong> hoặc <strong>Không hợp lệ</strong>, hồ sơ sẽ bị khóa.
                            </div>
                        }
                    </div>

                    <div class="col-lg-7">
                        <label class="form-label lead-label">Ghi chú chăm sóc mới</label>

                        <textarea name="note"
                                  id="leadNoteInput"
                                  class="form-control lead-input"
                                  placeholder="Ví dụ: Đã gọi khách, khách quan tâm căn 2PN, ngân sách khoảng 2 tỷ, muốn xem dự án vào cuối tuần..."
                                  disabled="@isClosed"></textarea>

                        <div class="form-text fw-semibold text-muted">
                            Bắt buộc nhập ghi chú khi chuyển sang Đang chăm sóc, Đã chốt hoặc Không hợp lệ.
                        </div>
                    </div>

                    <div class="col-12 d-flex justify-content-end flex-wrap gap-2">
                        @if (!isClosed)
                        {
                            <button type="button"
                                    class="btn btn-outline-success rounded-pill fw-bold px-4"
                                    onclick="openQuickCallModal()">
                                <i class="bi bi-telephone-outbound-fill me-1"></i>
                                Ghi nhanh đã gọi
                            </button>
                        }

                        <button type="submit"
                                class="btn btn-lead-dark px-4"
                                disabled="@isClosed">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i>
                            Lưu nhật ký CRM
                        </button>
                    </div>
                </form>

                <form id="quickCallForm"
                      asp-action="QuickCall"
                      asp-controller="MemberProject"
                      method="post"
                      class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.LeadID" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="note" id="quickCallNote" />
                </form>
            </section>

            <section class="lead-panel schedule-panel">
                <div class="lead-panel-title">
                    <span class="lead-title-icon" style="background:#059669;">
                        <i class="bi bi-telephone-outbound-fill"></i>
                    </span>
                    <span>Thao tác chăm sóc khách tư vấn</span>
                </div>

                <div class="lead-note mb-4" style="background:#eff6ff;border-color:#bfdbfe;color:#1e40af;">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Đây là hồ sơ khách yêu cầu tư vấn dự án. Chủ đầu tư nên gọi khách, ghi nhận kết quả chăm sóc và cập nhật trạng thái CRM.
                    Việc xác nhận, dời lịch, từ chối hoặc hoàn tất lịch xem dự án được xử lý ở màn hình <strong>Lịch hẹn dự án</strong>.
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <a href="tel:@Model.Phone" class="btn btn-success w-100 rounded-4 fw-bold" style="min-height:52px;display:flex;align-items:center;justify-content:center;gap:8px;">
                            <i class="bi bi-telephone-outbound-fill"></i>
                            Gọi khách ngay
                        </a>
                    </div>

                    <div class="col-md-6">
                        <button type="button"
                                class="btn btn-lead-primary w-100"
                                onclick="openQuickCallModal()"
                                disabled="@isClosed">
                            <i class="bi bi-journal-plus me-1"></i>
                            Ghi nhanh kết quả cuộc gọi
                        </button>
                    </div>

                    <div class="col-md-6">
                        <a href="/Appointments/Index?mode=DoanhNghiep&tab=lich-den&keyword=@Model.Phone"
                           class="btn btn-lead-dark w-100"
                           style="display:flex;align-items:center;justify-content:center;gap:8px;">
                            <i class="bi bi-calendar2-week-fill"></i>
                            Mở lịch hẹn dự án
                        </a>
                    </div>

                    <div class="col-md-6">
                        <a href="@Url.Action("LeadHistory", "MemberProject", new { id = Model.LeadID })"
                           class="btn btn-lead-light w-100"
                           style="display:flex;align-items:center;justify-content:center;gap:8px;min-height:50px;">
                            <i class="bi bi-clock-history text-primary"></i>
                            Xem lịch sử chăm sóc
                        </a>
                    </div>
                </div>

                @if (hasActiveAppointment && !isClosed)
                {
                    <div class="active-appointment-box mt-4">
                        <i class="bi bi-calendar2-exclamation-fill me-1"></i>
                        Khách hàng này đang có lịch hẹn mở. Vui lòng xử lý lịch tại màn hình <strong>Lịch hẹn dự án</strong>.

                        <div class="mt-2">
                            @foreach (var ap in activeAppointments)
                            {
                                <div>
                                    <strong>@ap.AppointmentDate.ToString("HH:mm dd/MM/yyyy")</strong>
                                    - @(string.IsNullOrWhiteSpace(ap.AssignedStaffName) ? "Chưa có nhân viên" : ap.AssignedStaffName)
                                    - @ap.Status
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>

        </main>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function openQuickCallModal() {
            Swal.fire({
                title: 'Ghi nhanh cuộc gọi',
                html: `
                    <div class="text-start">
                        <p class="text-muted mb-2">
                            Nhập ngắn gọn kết quả cuộc gọi để lưu vào lịch sử CRM.
                        </p>
                        <div class="alert alert-info rounded-4 mb-0">
                            Ví dụ: Khách nghe máy, quan tâm dự án, hẹn gọi lại lúc 15h.
                        </div>
                    </div>
                `,
                input: 'textarea',
                inputPlaceholder: 'Nhập ghi chú cuộc gọi...',
                inputAttributes: {
                    maxlength: 1000
                },
                showCancelButton: true,
                confirmButtonText: '<i class="bi bi-telephone-outbound-fill"></i> Lưu cuộc gọi',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                customClass: {
                    popup: 'rounded-4',
                    input: 'rounded-4',
                    confirmButton: 'rounded-pill px-4',
                    cancelButton: 'rounded-pill px-4'
                },
                inputValidator: function (value) {
                    if (!value || value.trim().length < 5) {
                        return 'Vui lòng nhập ghi chú tối thiểu 5 ký tự.';
                    }
                }
            }).then(function (result) {
                if (result.isConfirmed) {
                    document.getElementById('quickCallNote').value = result.value.trim();
                    document.getElementById('quickCallForm').submit();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-confirm-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();

                    const statusSelect = form.querySelector('#leadStatusSelect');
                    const noteInput = form.querySelector('#leadNoteInput');

                    if (statusSelect && noteInput) {
                        const status = statusSelect.value;
                        const note = noteInput.value.trim();

                        if ((status === 'Contacted' && note.length < 5) ||
                            ((status === 'Resolved' || status === 'Invalid') && note.length < 10)) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Thiếu ghi chú CRM',
                                text: status === 'Contacted'
                                    ? 'Khi chuyển sang Đang chăm sóc, vui lòng nhập ghi chú tối thiểu 5 ký tự.'
                                    : 'Khi chốt hoặc hủy hồ sơ, vui lòng nhập ghi chú tối thiểu 10 ký tự.',
                                confirmButtonColor: '#2563eb'
                            });

                            return;
                        }
                    }

                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    const title = form.dataset.confirmTitle || 'Xác nhận thao tác?';
                    const text = form.dataset.confirmText || 'Bạn có chắc chắn muốn thực hiện thao tác này?';
                    const icon = form.dataset.confirmIcon || 'question';
                    const button = form.dataset.confirmButton || 'Đồng ý';

                    Swal.fire({
                        title: title,
                        text: text,
                        icon: icon,
                        showCancelButton: true,
                        confirmButtonText: button,
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#2563eb',
                        cancelButtonColor: '#64748b',
                        customClass: {
                            popup: 'rounded-4',
                            confirmButton: 'rounded-pill px-4',
                            cancelButton: 'rounded-pill px-4'
                        }
                    }).then(function (result) {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}