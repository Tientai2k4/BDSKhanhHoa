@model BDSKhanhHoa.Models.ProjectLead

@{
    ViewData["Title"] = "Chăm sóc khách hàng";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    string returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "MemberProject") ?? "/MemberProject/Index";

    bool isClosed = Model.LeadStatus == "Resolved"
                 || Model.LeadStatus == "Invalid"
                 || Model.LeadStatus == "Đã chốt"
                 || Model.LeadStatus == "Không hợp lệ";

    var activeAppointments = ViewBag.ActiveAppointments as List<BDSKhanhHoa.Models.Appointment>
        ?? new List<BDSKhanhHoa.Models.Appointment>();

    bool hasActiveAppointment = activeAppointments.Any();

    string customerInitial = string.IsNullOrWhiteSpace(Model.Name)
        ? "K"
        : Model.Name.Substring(0, 1).ToUpper();
}

@functions {
    public string LeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Khách mới";
        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string LeadStatusClass(string? status)
    {
        return LeadStatusText(status) switch
        {
            "Khách mới" => "status-new",
            "Đang chăm sóc" => "status-contacted",
            "Đã chốt" => "status-resolved",
            "Không hợp lệ" => "status-invalid",
            _ => "status-unknown"
        };
    }

    public string SafeText(string? value, string fallback = "Chưa cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }
}

@section Styles {
    <style>
        :root {
            --lead-primary: #2563eb;
            --lead-primary-dark: #1d4ed8;
            --lead-success: #059669;
            --lead-danger: #dc2626;
            --lead-dark: #0f172a;
            --lead-muted: #64748b;
            --lead-border: #e2e8f0;
            --lead-soft: #f8fafc;
            --lead-card: #fff;
            --lead-shadow: 0 14px 34px rgba(15,23,42,.07);
        }

        .lead-page {
            max-width: 100%;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .lead-actions-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-lead-light, .btn-lead-primary, .btn-lead-dark {
            min-height: 44px;
            border-radius: 14px;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .btn-lead-light {
            background: #fff;
            border: 1px solid var(--lead-border);
            color: var(--lead-dark);
        }

        .btn-lead-primary {
            border: 0;
            background: linear-gradient(135deg,var(--lead-primary),var(--lead-primary-dark));
            color: #fff;
            box-shadow: 0 12px 24px rgba(37,99,235,.18);
        }

        .btn-lead-dark {
            border: 0;
            background: #111827;
            color: #fff;
        }

            .btn-lead-primary:hover, .btn-lead-dark:hover {
                color: #fff;
            }

        .lead-grid {
            display: grid;
            grid-template-columns: 360px minmax(0,1fr);
            gap: 16px;
            align-items: start;
        }

        .lead-card, .lead-panel, .lead-alert {
            min-width: 0;
            background: var(--lead-card);
            border: 1px solid rgba(148,163,184,.24);
            border-radius: 22px;
            box-shadow: var(--lead-shadow);
            overflow: hidden;
        }

        .lead-card {
            padding: 20px;
            position: sticky;
            top: 92px;
        }

        .lead-profile-head {
            text-align: center;
            padding: 8px 0 16px;
            border-bottom: 1px solid var(--lead-border);
        }

        .lead-avatar {
            width: 84px;
            height: 84px;
            border-radius: 24px;
            display: grid;
            place-items: center;
            margin: 0 auto 12px;
            background: linear-gradient(135deg,var(--lead-primary),#4f46e5);
            color: #fff;
            font-size: 2.35rem;
            font-weight: 950;
        }

        .lead-name {
            color: var(--lead-dark);
            font-size: 1.2rem;
            font-weight: 950;
            margin-bottom: 8px;
            overflow-wrap: anywhere;
        }

        .lead-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .status-new {
            background: #fee2e2;
            color: #b91c1c
        }

        .status-contacted {
            background: #fef3c7;
            color: #b45309
        }

        .status-resolved {
            background: #dcfce7;
            color: #047857
        }

        .status-invalid {
            background: #f1f5f9;
            color: #475569;
            text-decoration: line-through
        }

        .status-unknown {
            background: #e0e7ff;
            color: #3730a3
        }

        .info-list {
            display: grid;
            gap: 10px;
            margin-top: 16px;
        }

        .info-box {
            min-width: 0;
            border-radius: 15px;
            background: #f8fafc;
            border: 1px solid var(--lead-border);
            padding: 11px 12px;
        }

        .info-label, .lead-label {
            display: block;
            margin-bottom: 6px;
            color: #64748b;
            font-size: .7rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        .info-value {
            color: #1e293b;
            font-weight: 800;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .call-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }

        .call-btn {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .lead-panel {
            padding: 20px;
        }

        .panel-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--lead-dark);
            font-size: 1.05rem;
            font-weight: 950;
            margin-bottom: 14px;
        }

        .title-icon {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            color: #fff;
            background: var(--lead-primary);
            flex-shrink: 0;
        }

        .lead-input {
            min-height: 48px;
            border-radius: 14px;
            border: 1px solid #dbe3ef;
            box-shadow: none !important;
            font-weight: 750;
        }

            .lead-input:focus {
                border-color: var(--lead-primary);
                box-shadow: 0 0 0 4px rgba(37,99,235,.08) !important;
            }

        textarea.lead-input {
            min-height: 126px;
            resize: vertical;
            line-height: 1.6;
        }

        .lead-note {
            border-radius: 15px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            color: #92400e;
            padding: 12px;
            font-size: .86rem;
            font-weight: 750;
            line-height: 1.55;
            overflow-wrap: anywhere;
        }

        .lead-message {
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid var(--lead-border);
            color: #334155;
            padding: 14px;
            line-height: 1.65;
            font-weight: 750;
            overflow-wrap: anywhere;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 10px;
        }

        .active-appointment {
            margin-top: 14px;
            border-radius: 16px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
            color: #9a3412;
            padding: 13px;
            font-weight: 750;
            line-height: 1.55;
        }

        .lead-alert {
            padding: 16px;
            border-left: 5px solid var(--lead-danger);
        }

        .closed-mask {
            opacity: .72;
        }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 9px;
        }

        @@media (max-width:1199.98px) {
            .lead-grid {
                grid-template-columns: 1fr;
            }

            .lead-card {
                position: static;
            }
        }

        @@media (max-width:575.98px) {
            .lead-page {
                gap: 10px;
            }

            .lead-card, .lead-panel, .lead-alert {
                border-radius: 18px;
                padding: 14px;
            }

            .lead-actions-top .btn, .form-actions .btn, .quick-grid .btn {
                width: 100%;
            }

            .quick-grid {
                grid-template-columns: 1fr;
            }

            .lead-avatar {
                width: 72px;
                height: 72px;
                font-size: 2rem;
            }

            .lead-panel {
                padding: 15px;
            }

            .panel-title {
                font-size: .98rem;
            }
        }
    </style>
}

<div class="lead-page">
    <div class="lead-actions-top">
        <a href="@returnUrl" class="btn btn-lead-light">
            <i class="bi bi-arrow-left-circle-fill text-primary"></i> Quay lại phễu khách hàng
        </a>
        <a href="@Url.Action("LeadHistory", "MemberProject", new { id = Model.LeadID })" class="btn btn-lead-light">
            <i class="bi bi-clock-history text-success"></i> Hồ sơ 360
        </a>
    </div>

    @if (isClosed)
    {
        <div class="lead-alert">
            <div class="d-flex gap-3 align-items-start">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger text-white flex-shrink-0" style="width:42px;height:42px;">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-danger mb-1">Hồ sơ khách hàng đã đóng</h5>
                    <p class="mb-0 text-dark">Hệ thống khóa chỉnh sửa để bảo toàn lịch sử CRM. Bạn vẫn có thể xem hồ sơ 360 và lịch hẹn đã phát sinh.</p>
                </div>
            </div>
        </div>
    }

    <div class="lead-grid">
        <aside class="lead-card">
            <div class="lead-profile-head">
                <div class="lead-avatar">@customerInitial</div>
                <h2 class="lead-name">@SafeText(Model.Name, "Khách hàng")</h2>
                <span class="lead-status @LeadStatusClass(Model.LeadStatus)">
                    <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>@LeadStatusText(Model.LeadStatus)
                </span>
            </div>

            <div class="info-list">
                <div class="info-box">
                    <span class="info-label">Số điện thoại</span>
                    <div class="call-row">
                        <span class="info-value">@SafeText(Model.Phone)</span>
                        <a href="tel:@Model.Phone" class="btn btn-success call-btn"><i class="bi bi-telephone-outbound-fill"></i></a>
                    </div>
                </div>
                <div class="info-box"><span class="info-label">Email</span><div class="info-value"><i class="bi bi-envelope-fill text-primary me-1"></i>@SafeText(Model.Email, "Chưa cung cấp")</div></div>
                <div class="info-box"><span class="info-label">Dự án quan tâm</span><div class="info-value text-primary"><i class="bi bi-building-fill me-1"></i>@SafeText(Model.Project?.ProjectName, "Không rõ dự án")</div></div>
                <div class="info-box"><span class="info-label">Khu vực dự án</span><div class="info-value"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@SafeText(Model.Project?.Ward?.WardName), @SafeText(Model.Project?.Ward?.Area?.AreaName)</div></div>
                <div class="info-box"><span class="info-label">Ngày gửi yêu cầu</span><div class="info-value"><i class="bi bi-clock-history text-secondary me-1"></i>@Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div></div>
            </div>

            @if (Model.Project != null)
            {
                <div class="d-grid gap-2 mt-3">
                    <a href="/Project/Details/@Model.ProjectID" target="_blank" class="btn btn-lead-primary">
                        <i class="bi bi-box-arrow-up-right"></i> Xem dự án công khai
                    </a>
                </div>
            }
        </aside>

        <main class="@(isClosed ? "closed-mask" : "")">
            <section class="lead-panel">
                <div class="panel-title">
                    <span class="title-icon"><i class="bi bi-chat-left-text-fill"></i></span>
                    <span>Nhu cầu khách hàng</span>
                </div>
                <div class="lead-message">@(string.IsNullOrWhiteSpace(Model.Message) ? "Khách chưa để lại nội dung chi tiết." : Model.Message)</div>
            </section>

            <section class="lead-panel">
                <div class="panel-title">
                    <span class="title-icon" style="background:#111827;"><i class="bi bi-clipboard2-check-fill"></i></span>
                    <span>Cập nhật trạng thái CRM</span>
                </div>

                <form asp-action="UpdateLeadStatus"
                      asp-controller="MemberProject"
                      method="post"
                      class="row g-3 js-confirm-form"
                      data-confirm-title="Lưu nhật ký CRM?"
                      data-confirm-text="Hệ thống sẽ cập nhật trạng thái và ghi lại lịch sử chăm sóc khách hàng."
                      data-confirm-icon="question"
                      data-confirm-button="Đồng ý lưu">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.LeadID" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />

                    <div class="col-lg-5">
                        <label class="form-label lead-label">Trạng thái chăm sóc</label>
                        <select name="status" id="leadStatusSelect" class="form-select lead-input" disabled="@isClosed" required>
                            <option value="New" selected="@(Model.LeadStatus == "New" || Model.LeadStatus == "Mới")">Khách mới</option>
                            <option value="Contacted" selected="@(Model.LeadStatus == "Contacted" || Model.LeadStatus == "Đã liên hệ")">Đang chăm sóc</option>
                            <option value="Resolved" selected="@(Model.LeadStatus == "Resolved" || Model.LeadStatus == "Đã chốt")">Đã chốt thành công</option>
                            <option value="Invalid" selected="@(Model.LeadStatus == "Invalid" || Model.LeadStatus == "Không hợp lệ")">Không hợp lệ / hủy</option>
                        </select>

                        @if (!isClosed)
                        {
                            <div class="lead-note mt-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                Không lùi từ <strong>Đang chăm sóc</strong> về <strong>Khách mới</strong>. Chọn <strong>Đã chốt</strong> hoặc <strong>Không hợp lệ</strong> sẽ khóa hồ sơ.
                            </div>
                        }
                    </div>

                    <div class="col-lg-7">
                        <label class="form-label lead-label">Ghi chú chăm sóc mới</label>
                        <textarea name="note" id="leadNoteInput" class="form-control lead-input" placeholder="Ví dụ: Đã gọi khách, khách quan tâm căn 2PN, ngân sách khoảng 2 tỷ..." disabled="@isClosed"></textarea>
                        <div class="form-text fw-semibold text-muted">Bắt buộc ghi chú khi chuyển sang Đang chăm sóc, Đã chốt hoặc Không hợp lệ.</div>
                    </div>

                    <div class="col-12 form-actions">
                        @if (!isClosed)
                        {
                            <button type="button" class="btn btn-outline-success rounded-pill fw-bold px-4" onclick="openQuickCallModal()">
                                <i class="bi bi-telephone-outbound-fill me-1"></i> Ghi nhanh đã gọi
                            </button>
                        }
                        <button type="submit" class="btn btn-lead-dark px-4" disabled="@isClosed">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Lưu nhật ký CRM
                        </button>
                    </div>
                </form>

                <form id="quickCallForm" asp-action="QuickCall" asp-controller="MemberProject" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.LeadID" />
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="note" id="quickCallNote" />
                </form>
            </section>

            <section class="lead-panel">
                <div class="panel-title">
                    <span class="title-icon" style="background:#059669;"><i class="bi bi-telephone-outbound-fill"></i></span>
                    <span>Thao tác nhanh</span>
                </div>

                <div class="lead-note mb-3" style="background:#eff6ff;border-color:#bfdbfe;color:#1e40af;">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Gọi khách, ghi nhận kết quả chăm sóc và xử lý lịch xem dự án ở màn hình Lịch hẹn dự án.
                </div>

                <div class="quick-grid">
                    <a href="tel:@Model.Phone" class="btn btn-success btn-lg fw-bold">
                        <i class="bi bi-telephone-outbound-fill"></i> Gọi khách ngay
                    </a>
                    <a href="/Appointments/Index?mode=DoanhNghiep&keyword=@Model.Phone" class="btn btn-lead-dark">
                        <i class="bi bi-calendar2-week-fill"></i> Mở lịch hẹn dự án
                    </a>
                    <a href="@Url.Action("LeadHistory", "MemberProject", new { id = Model.LeadID })" class="btn btn-lead-light">
                        <i class="bi bi-clock-history text-primary"></i> Xem lịch sử chăm sóc
                    </a>
                    @if (Model.Project != null)
                    {
                        <a href="/Project/Details/@Model.ProjectID" target="_blank" class="btn btn-lead-light">
                            <i class="bi bi-building-fill text-primary"></i> Xem dự án
                        </a>
                    }
                </div>

                @if (hasActiveAppointment && !isClosed)
                {
                    <div class="active-appointment">
                        <i class="bi bi-calendar2-exclamation-fill me-1"></i>
                        Khách hàng này đang có lịch hẹn mở. Vui lòng xử lý tại màn hình <strong>Lịch hẹn dự án</strong>.
                        <div class="mt-2">
                            @foreach (var ap in activeAppointments)
                            {
                                <div>
                                    <strong>@ap.AppointmentDate.ToString("HH:mm dd/MM/yyyy")</strong>
                                    - @(string.IsNullOrWhiteSpace(ap.AssignedStaffName) ? "Chưa có nhân viên" : ap.AssignedStaffName)
                                    - @ap.Status
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        </main>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openQuickCallModal() {
            Swal.fire({
                title: 'Ghi nhanh cuộc gọi',
                html: `
                    <div class="text-start">
                        <p class="text-muted mb-2">Nhập ngắn gọn kết quả cuộc gọi để lưu vào lịch sử CRM.</p>
                        <div class="alert alert-info rounded-4 mb-0">Ví dụ: Khách nghe máy, quan tâm dự án, hẹn gọi lại lúc 15h.</div>
                    </div>
                `,
                input: 'textarea',
                inputPlaceholder: 'Nhập ghi chú cuộc gọi.',
                inputAttributes: { maxlength: 1000 },
                showCancelButton: true,
                confirmButtonText: '<i class="bi bi-telephone-outbound-fill"></i> Lưu cuộc gọi',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                customClass: { popup: 'rounded-4', input: 'rounded-4', confirmButton: 'rounded-pill px-4', cancelButton: 'rounded-pill px-4' },
                inputValidator: function (value) {
                    if (!value || value.trim().length < 5) return 'Vui lòng nhập ghi chú tối thiểu 5 ký tự.';
                }
            }).then(function (result) {
                if (result.isConfirmed) {
                    document.getElementById('quickCallNote').value = result.value.trim();
                    document.getElementById('quickCallForm').submit();
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-confirm-form').forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();

                    const statusSelect = form.querySelector('#leadStatusSelect');
                    const noteInput = form.querySelector('#leadNoteInput');

                    if (statusSelect && noteInput) {
                        const status = statusSelect.value;
                        const note = noteInput.value.trim();

                        if ((status === 'Contacted' && note.length < 5) ||
                            ((status === 'Resolved' || status === 'Invalid') && note.length < 10)) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Thiếu ghi chú CRM',
                                text: status === 'Contacted'
                                    ? 'Khi chuyển sang Đang chăm sóc, vui lòng nhập ghi chú tối thiểu 5 ký tự.'
                                    : 'Khi chốt hoặc hủy hồ sơ, vui lòng nhập ghi chú tối thiểu 10 ký tự.',
                                confirmButtonColor: '#2563eb'
                            });
                            return;
                        }
                    }

                    if (!form.checkValidity()) {
                        form.reportValidity();
                        return;
                    }

                    Swal.fire({
                        title: form.dataset.confirmTitle || 'Xác nhận thao tác?',
                        text: form.dataset.confirmText || 'Bạn có chắc chắn muốn thực hiện thao tác này?',
                        icon: form.dataset.confirmIcon || 'question',
                        showCancelButton: true,
                        confirmButtonText: form.dataset.confirmButton || 'Đồng ý',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#2563eb',
                        cancelButtonColor: '#64748b',
                        customClass: { popup: 'rounded-4', confirmButton: 'rounded-pill px-4', cancelButton: 'rounded-pill px-4' }
                    }).then(function (result) {
                        if (result.isConfirmed) form.submit();
                    });
                });
            });
        });
    </script>
}
