@model BDSKhanhHoa.Models.ProjectLead

@{
    ViewData["Title"] = "Hồ sơ khách hàng 360";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    var historyAppointments = ViewBag.HistoryAppointments as List<BDSKhanhHoa.Models.Appointment>
        ?? new List<BDSKhanhHoa.Models.Appointment>();

    var noteLines = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        noteLines = Model.Note
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    string customerInitial = string.IsNullOrWhiteSpace(Model.Name)
        ? "K"
        : Model.Name.Substring(0, 1).ToUpper();

    string returnUrl = Url.Action("Index", "MemberProject") ?? "/MemberProject/Index";

    bool isClosed = Model.LeadStatus == "Resolved"
                 || Model.LeadStatus == "Invalid"
                 || Model.LeadStatus == "Đã chốt"
                 || Model.LeadStatus == "Không hợp lệ";
}

@functions {
    public string LeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Khách mới";
        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string AppointmentStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Chờ xác nhận";
        return status.Trim() switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Completed" => "Đã hoàn tất",
            "Cancelled" => "Đã hủy",
            "Rescheduled" => "Đang dời lịch",
            "NoShow" => "Khách không đến",
            "Chờ xác nhận" => "Chờ xác nhận",
            "Đã xác nhận" => "Đã xác nhận",
            "Đã hoàn tất" => "Đã hoàn tất",
            "Đã hủy" => "Đã hủy",
            "Đang dời lịch" => "Đang dời lịch",
            "Khách không đến" => "Khách không đến",
            _ => status.Trim()
        };
    }

    public string SafeText(string? value, string fallback = "Chưa cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }
}

@section Styles {
    <style>
        :root {
            --his-primary: #2563eb;
            --his-success: #059669;
            --his-warning: #d97706;
            --his-danger: #dc2626;
            --his-dark: #0f172a;
            --his-muted: #64748b;
            --his-border: #e2e8f0;
            --his-soft: #f8fafc;
            --his-card: #fff;
            --his-shadow: 0 14px 34px rgba(15,23,42,.07);
        }

        .his-page {
            max-width: 100%;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .his-actions {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap;
        }

        .btn-his-light {
            min-height: 44px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid var(--his-border);
            color: var(--his-dark);
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
        }

        .his-grid {
            display: grid;
            grid-template-columns: 350px minmax(0,1fr);
            gap: 16px;
            align-items: start;
        }

        .his-card, .his-panel {
            min-width: 0;
            background: var(--his-card);
            border: 1px solid rgba(148,163,184,.24);
            border-radius: 22px;
            box-shadow: var(--his-shadow);
            overflow: hidden;
        }

        .his-card {
            padding: 18px;
            position: sticky;
            top: 92px;
        }

        .his-profile {
            border-radius: 20px;
            background: linear-gradient(135deg,#eff6ff,#fff);
            border: 1px solid #dbeafe;
            padding: 20px;
            text-align: center;
            margin-bottom: 14px;
        }

        .his-avatar {
            width: 82px;
            height: 82px;
            border-radius: 24px;
            display: grid;
            place-items: center;
            margin: 0 auto 12px;
            background: linear-gradient(135deg,var(--his-primary),#4f46e5);
            color: #fff;
            font-size: 2.35rem;
            font-weight: 950;
        }

        .his-name {
            color: var(--his-dark);
            font-weight: 950;
            font-size: 1.18rem;
            margin-bottom: 8px;
            overflow-wrap: anywhere;
        }

        .his-status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 7px 12px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: .72rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .his-info {
            display: grid;
            gap: 10px;
        }

        .his-info-block {
            border-radius: 15px;
            background: #f8fafc;
            border: 1px solid var(--his-border);
            padding: 11px 12px;
            min-width: 0;
        }

        .his-label {
            color: #64748b;
            font-size: .7rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .07em;
            margin-bottom: 6px;
        }

        .his-value {
            color: #1e293b;
            font-weight: 800;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .his-panel {
            padding: 20px;
        }

        .his-panel-title {
            color: var(--his-dark);
            font-weight: 950;
            font-size: 1.2rem;
            margin-bottom: 6px;
        }

        .his-panel-subtitle {
            color: var(--his-muted);
            font-weight: 650;
            margin-bottom: 18px;
        }

        .timeline {
            position: relative;
            padding-left: 32px;
        }

            .timeline::before {
                content: "";
                position: absolute;
                left: 12px;
                top: 4px;
                bottom: 4px;
                width: 2px;
                background: linear-gradient(to bottom,#93c5fd,#e2e8f0);
            }

        .tl-item {
            position: relative;
            margin-bottom: 14px;
        }

        .tl-dot {
            position: absolute;
            left: -31px;
            top: 5px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            color: #fff;
            font-size: .78rem;
            border: 4px solid #eff6ff;
            background: var(--his-primary);
            z-index: 1;
        }

            .tl-dot.note {
                background: var(--his-warning);
                border-color: #fef3c7
            }

            .tl-dot.appointment {
                background: #7c3aed;
                border-color: #ede9fe
            }

            .tl-dot.start {
                background: var(--his-success);
                border-color: #dcfce7
            }

        .tl-content {
            min-width: 0;
            border-radius: 17px;
            background: #fff;
            border: 1px solid var(--his-border);
            padding: 14px;
            box-shadow: 0 8px 20px rgba(15,23,42,.04);
            overflow-wrap: anywhere;
        }

        .tl-date {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 10px;
            background: #eff6ff;
            color: var(--his-primary);
            font-size: .74rem;
            font-weight: 900;
            margin-bottom: 8px;
        }

        .tl-title {
            color: var(--his-dark);
            font-weight: 950;
            margin-bottom: 6px;
            line-height: 1.45;
        }

        .tl-desc {
            color: #475569;
            line-height: 1.65;
            white-space: pre-wrap;
            margin: 0;
            font-weight: 650;
        }

        .tl-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 5px 10px;
            font-size: .74rem;
            font-weight: 900;
            background: #f1f5f9;
            color: #475569;
            margin-top: 8px;
        }

        .his-empty {
            border-radius: 18px;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            padding: 28px;
            text-align: center;
            color: var(--his-muted);
            font-weight: 650;
        }

        @@media (max-width:1199.98px) {
            .his-grid {
                grid-template-columns: 1fr;
            }

            .his-card {
                position: static;
            }
        }

        @@media (max-width:575.98px) {
            .his-page {
                gap: 10px;
            }

            .his-card, .his-panel {
                border-radius: 18px;
                padding: 14px;
            }

            .btn-his-light {
                width: 100%;
            }

            .timeline {
                padding-left: 28px;
            }

            .tl-dot {
                left: -28px;
            }

            .his-profile {
                padding: 16px;
            }
        }
    </style>
}

<div class="his-page">
    <div class="his-actions">
        <a href="@returnUrl" class="btn btn-his-light"><i class="bi bi-arrow-left-circle-fill text-primary"></i> Quay lại</a>
        @if (!isClosed)
        {
            <a href="@Url.Action("EditLead", "MemberProject", new { id = Model.LeadID })" class="btn btn-his-light"><i class="bi bi-pencil-square text-success"></i> Tiếp tục chăm sóc</a>
        }
    </div>

    <div class="his-grid">
        <aside class="his-card">
            <div class="his-profile">
                <div class="his-avatar">@customerInitial</div>
                <h2 class="his-name">@SafeText(Model.Name, "Khách hàng")</h2>
                <span class="his-status">@LeadStatusText(Model.LeadStatus)</span>
            </div>

            <div class="his-info">
                <div class="his-info-block"><div class="his-label">Số điện thoại</div><div class="his-value"><i class="bi bi-telephone-fill text-success me-1"></i>@SafeText(Model.Phone)</div></div>
                <div class="his-info-block"><div class="his-label">Email</div><div class="his-value"><i class="bi bi-envelope-fill text-primary me-1"></i>@SafeText(Model.Email, "Chưa cung cấp")</div></div>
                <div class="his-info-block"><div class="his-label">Dự án quan tâm</div><div class="his-value text-primary"><i class="bi bi-building-fill me-1"></i>@SafeText(Model.Project?.ProjectName, "Không rõ dự án")</div></div>
                <div class="his-info-block"><div class="his-label">Ngày gửi yêu cầu</div><div class="his-value"><i class="bi bi-clock-history text-secondary me-1"></i>@Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div></div>
            </div>
        </aside>

        <main>
            <section class="his-panel">
                <h1 class="his-panel-title"><i class="bi bi-person-lines-fill text-primary me-2"></i>Hồ sơ khách hàng 360</h1>
                <p class="his-panel-subtitle">Tổng hợp yêu cầu ban đầu, lịch hẹn xem dự án và nhật ký chăm sóc. Giao diện dạng timeline nên không phát sinh thanh lướt ngang.</p>

                <div class="timeline">
                    <div class="tl-item">
                        <div class="tl-dot start"><i class="bi bi-flag-fill"></i></div>
                        <div class="tl-content">
                            <div class="tl-date"><i class="bi bi-clock-history"></i>@Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</div>
                            <div class="tl-title">Khách gửi yêu cầu tư vấn</div>
                            <p class="tl-desc">@(string.IsNullOrWhiteSpace(Model.Message) ? "Khách chưa để lại nội dung chi tiết." : Model.Message)</p>
                        </div>
                    </div>

                    @if (historyAppointments.Any())
                    {
                        foreach (var ap in historyAppointments)
                        {
                            <div class="tl-item">
                                <div class="tl-dot appointment"><i class="bi bi-calendar2-week-fill"></i></div>
                                <div class="tl-content">
                                    <div class="tl-date"><i class="bi bi-calendar-event"></i>@ap.AppointmentDate.ToString("HH:mm dd/MM/yyyy")</div>
                                    <div class="tl-title">Lịch xem dự án - @AppointmentStatusText(ap.Status)</div>
                                    <p class="tl-desc">
                                        Nhân viên phụ trách: @SafeText(ap.AssignedStaffName, "Chưa cập nhật")
                                        @if (!string.IsNullOrWhiteSpace(ap.MeetingLocation))
                                        {
                                            <text>
                                                Địa điểm: @ap.MeetingLocation
                                            </text>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(ap.Note))
                                        {
                                            <text>
                                                Ghi chú: @ap.Note
                                            </text>
                                        }
                                    </p>
                                    <span class="tl-badge"><i class="bi bi-info-circle"></i>@AppointmentStatusText(ap.Status)</span>
                                </div>
                            </div>
                        }
                    }

                    @if (noteLines.Any())
                    {
                        foreach (var line in noteLines)
                        {
                            <div class="tl-item">
                                <div class="tl-dot note"><i class="bi bi-journal-text"></i></div>
                                <div class="tl-content">
                                    <div class="tl-date"><i class="bi bi-pencil-square"></i>Nhật ký CRM</div>
                                    <div class="tl-title">Ghi chú chăm sóc</div>
                                    <p class="tl-desc">@line</p>
                                </div>
                            </div>
                        }
                    }

                    @if (!historyAppointments.Any() && !noteLines.Any())
                    {
                        <div class="his-empty">
                            <i class="bi bi-journal-x fs-1 d-block mb-3 text-muted"></i>
                            Chưa có lịch sử chăm sóc nào ngoài yêu cầu tư vấn ban đầu.
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>
</div>
