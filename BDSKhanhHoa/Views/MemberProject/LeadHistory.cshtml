@model BDSKhanhHoa.Models.ProjectLead

@{
    ViewData["Title"] = "Hồ sơ khách hàng 360";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    var historyAppointments = ViewBag.HistoryAppointments as List<BDSKhanhHoa.Models.Appointment>
        ?? new List<BDSKhanhHoa.Models.Appointment>();

    var noteLines = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        noteLines = Model.Note
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
    }

    string customerInitial = string.IsNullOrWhiteSpace(Model.Name)
        ? "K"
        : Model.Name.Substring(0, 1).ToUpper();

    string returnUrl = Url.Action("Index", "MemberProject") ?? "/MemberProject/Index";

    bool isClosed = Model.LeadStatus == "Resolved"
                 || Model.LeadStatus == "Invalid"
                 || Model.LeadStatus == "Đã chốt"
                 || Model.LeadStatus == "Không hợp lệ";
}

@functions {
    public string LeadStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Khách mới";
        }

        return status.Trim() switch
        {
            "New" => "Khách mới",
            "Contacted" => "Đang chăm sóc",
            "Resolved" => "Đã chốt",
            "Invalid" => "Không hợp lệ",
            "Mới" => "Khách mới",
            "Đã liên hệ" => "Đang chăm sóc",
            "Đã chốt" => "Đã chốt",
            "Không hợp lệ" => "Không hợp lệ",
            _ => status.Trim()
        };
    }

    public string AppointmentStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "Chờ xác nhận";
        }

        return status.Trim() switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Completed" => "Đã hoàn tất",
            "Cancelled" => "Đã hủy",
            "Rescheduled" => "Đang dời lịch",
            "NoShow" => "Khách không đến",
            "Chờ xác nhận" => "Chờ xác nhận",
            "Đã xác nhận" => "Đã xác nhận",
            "Đã hoàn tất" => "Đã hoàn tất",
            "Đã hủy" => "Đã hủy",
            "Đang dời lịch" => "Đang dời lịch",
            "Khách không đến" => "Khách không đến",
            _ => status.Trim()
        };
    }

    public string SafeText(string? value, string fallback = "Chưa cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }
}

@section Styles {
    <style>
        :root {
            --his-primary: #2563eb;
            --his-success: #059669;
            --his-warning: #d97706;
            --his-danger: #dc2626;
            --his-dark: #0f172a;
            --his-muted: #64748b;
            --his-border: #e2e8f0;
            --his-soft: #f8fafc;
            --his-card: #ffffff;
            --his-radius: 24px;
            --his-shadow: 0 16px 38px rgba(15, 23, 42, .07);
        }

        .his-page {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .his-top-actions {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: center;
            flex-wrap: wrap;
        }

        .his-grid {
            display: grid;
            grid-template-columns: 370px minmax(0, 1fr);
            gap: 24px;
            align-items: start;
        }

        .his-card,
        .his-panel {
            background: var(--his-card);
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: var(--his-radius);
            box-shadow: var(--his-shadow);
        }

        .his-card {
            padding: 24px;
            position: sticky;
            top: 96px;
        }

        .his-profile-head {
            border-radius: 22px;
            background: linear-gradient(135deg, #eff6ff, #ffffff);
            border: 1px solid #dbeafe;
            padding: 22px;
            text-align: center;
            margin-bottom: 20px;
        }

        .his-avatar {
            width: 92px;
            height: 92px;
            border-radius: 26px;
            display: grid;
            place-items: center;
            margin: 0 auto 15px;
            background: linear-gradient(135deg, var(--his-primary), #4f46e5);
            color: #fff;
            font-size: 2.8rem;
            font-weight: 950;
            box-shadow: 0 16px 28px rgba(37, 99, 235, .24);
        }

        .his-name {
            font-size: 1.28rem;
            font-weight: 950;
            color: var(--his-dark);
            margin-bottom: 8px;
        }

        .his-status {
            display: inline-flex;
            align-items: center;
            border-radius: 999px;
            padding: 8px 13px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: .76rem;
            font-weight: 950;
            text-transform: uppercase;
        }

        .his-info-block {
            margin-bottom: 18px;
        }

        .his-info-label {
            font-size: .74rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #64748b;
            font-weight: 950;
            margin-bottom: 8px;
        }

        .his-info-value {
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid var(--his-border);
            padding: 13px 14px;
            color: #1e293b;
            font-weight: 800;
            line-height: 1.55;
            word-break: break-word;
        }

        .his-panel {
            padding: 24px;
        }

        .his-panel-title {
            font-size: 1.25rem;
            font-weight: 950;
            color: var(--his-dark);
            margin-bottom: 8px;
        }

        .his-panel-subtitle {
            color: var(--his-muted);
            font-weight: 650;
            margin-bottom: 22px;
        }

        .his-timeline {
            position: relative;
            padding-left: 34px;
        }

            .his-timeline::before {
                content: "";
                position: absolute;
                left: 12px;
                top: 8px;
                bottom: 8px;
                width: 2px;
                background: linear-gradient(to bottom, #93c5fd, #e2e8f0);
            }

        .his-item {
            position: relative;
            margin-bottom: 18px;
        }

        .his-dot {
            position: absolute;
            left: -34px;
            top: 4px;
            width: 26px;
            height: 26px;
            border-radius: 999px;
            color: #fff;
            display: grid;
            place-items: center;
            font-size: .8rem;
            border: 4px solid #eff6ff;
            z-index: 1;
            background: var(--his-primary);
        }

            .his-dot.note {
                background: var(--his-warning);
                border-color: #fef3c7;
            }

            .his-dot.appointment {
                background: #7c3aed;
                border-color: #ede9fe;
            }

            .his-dot.start {
                background: var(--his-success);
                border-color: #dcfce7;
            }

        .his-content {
            border-radius: 18px;
            background: #fff;
            border: 1px solid var(--his-border);
            padding: 16px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
        }

        .his-date {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 5px 11px;
            background: #eff6ff;
            color: var(--his-primary);
            font-size: .76rem;
            font-weight: 900;
            margin-bottom: 9px;
        }

        .his-title {
            color: var(--his-dark);
            font-weight: 950;
            margin-bottom: 6px;
            line-height: 1.45;
        }

        .his-desc {
            color: #475569;
            line-height: 1.65;
            white-space: pre-wrap;
            margin-bottom: 0;
        }

        .his-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 6px 11px;
            font-size: .75rem;
            font-weight: 900;
            background: #f1f5f9;
            color: #475569;
        }

        .btn-his-light {
            min-height: 44px;
            border-radius: 14px;
            background: #fff;
            border: 1px solid var(--his-border);
            color: var(--his-dark);
            font-weight: 900;
        }

        .his-empty {
            border-radius: 20px;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            padding: 30px;
            text-align: center;
            color: var(--his-muted);
            font-weight: 650;
        }

        @@media (max-width: 1199.98px) {
            .his-grid

        {
            grid-template-columns: 1fr;
        }

        .his-card {
            position: static;
        }

        }

        @@media (max-width: 575.98px) {
            .his-card, .his-panel

        {
            border-radius: 20px;
            padding: 18px;
        }

        .btn-his-light {
            width: 100%;
            justify-content: center;
        }

        .his-timeline {
            padding-left: 30px;
        }

        .his-dot {
            left: -30px;
        }

        }
    </style>
}

<div class="his-page">
    <div class="his-top-actions">
        <a href="@returnUrl" class="btn btn-his-light">
            <i class="bi bi-arrow-left-circle-fill text-primary me-1"></i>
            Quay lại 
        </a>

        @if (!isClosed)
        {
            <a href="@Url.Action("EditLead", "MemberProject", new { id = Model.LeadID, returnUrl = returnUrl })" class="btn btn-primary rounded-pill fw-bold px-4">
                <i class="bi bi-pencil-square me-1"></i>
                Chăm sóc khách hàng
            </a>
        }
        else
        {
            <button type="button" class="btn btn-light border rounded-pill fw-bold px-4" disabled>
                <i class="bi bi-lock-fill me-1"></i>
                Hồ sơ đã khóa
            </button>
        }
    </div>

    <div class="his-grid">
        <aside class="his-card">
            <div class="his-profile-head">
                <div class="his-avatar">@customerInitial</div>

                <h2 class="his-name">@Model.Name</h2>

                <span class="his-status">
                    @LeadStatusText(Model.LeadStatus)
                </span>
            </div>

            <div class="his-info-block">
                <div class="his-info-label">Số điện thoại</div>

                <div class="his-info-value d-flex align-items-center justify-content-between gap-2">
                    <span>@SafeText(Model.Phone)</span>

                    <a href="tel:@Model.Phone" class="btn btn-success rounded-circle flex-shrink-0" style="width:40px;height:40px;display:flex;align-items:center;justify-content:center;">
                        <i class="bi bi-telephone-fill"></i>
                    </a>
                </div>
            </div>

            <div class="his-info-block">
                <div class="his-info-label">Email liên hệ</div>
                <div class="his-info-value">
                    @(string.IsNullOrWhiteSpace(Model.Email) ? "Chưa cung cấp" : Model.Email)
                </div>
            </div>

            <div class="his-info-block">
                <div class="his-info-label">Dự án quan tâm</div>
                <div class="his-info-value text-primary">
                    <i class="bi bi-building-fill me-1"></i>
                    @SafeText(Model.Project?.ProjectName, "Không rõ dự án")
                </div>
            </div>

            <div class="his-info-block">
                <div class="his-info-label">Nhu cầu ban đầu</div>
                <div class="his-info-value">
                    @(string.IsNullOrWhiteSpace(Model.Message) ? "Khách chưa để lại nội dung chi tiết." : Model.Message)
                </div>
            </div>

            <div class="d-grid gap-2 mt-4">
                @if (Model.Project != null)
                {
                    <a href="/Project/Details/@Model.ProjectID" target="_blank" class="btn btn-his-light">
                        <i class="bi bi-eye-fill text-primary me-1"></i>
                        Xem dự án công khai
                    </a>
                }

                <a href="tel:@Model.Phone" class="btn btn-success rounded-pill fw-bold">
                    <i class="bi bi-telephone-outbound-fill me-1"></i>
                    Gọi khách
                </a>
            </div>
        </aside>

        <main>
            <section class="his-panel">
                <h2 class="his-panel-title">
                    <i class="bi bi-activity text-primary me-2"></i>
                    Dòng thời gian chăm sóc
                </h2>

                <p class="his-panel-subtitle">
                    Tổng hợp ghi chú CRM, lịch hẹn xem dự án và thông tin phát sinh trong quá trình chăm sóc khách hàng.
                </p>

                <div class="his-timeline">
                    <div class="his-item">
                        <div class="his-dot start">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>

                        <div class="his-content">
                            <div class="his-date">
                                <i class="bi bi-clock"></i>
                                @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                            </div>

                            <div class="his-title">Khách hàng gửi yêu cầu tư vấn</div>

                            <p class="his-desc">
                                Khách hàng @Model.Name đã gửi yêu cầu tư vấn cho dự án @SafeText(Model.Project?.ProjectName, "không rõ dự án").
                            </p>
                        </div>
                    </div>

                    @if (historyAppointments.Any())
                    {
                        foreach (var ap in historyAppointments)
                        {
                            <div class="his-item">
                                <div class="his-dot appointment">
                                    <i class="bi bi-calendar-event-fill"></i>
                                </div>

                                <div class="his-content">
                                    <div class="his-date">
                                        <i class="bi bi-calendar2-check"></i>
                                        @ap.AppointmentDate.ToString("HH:mm dd/MM/yyyy")
                                    </div>

                                    <div class="his-title">
                                        Lịch xem dự án - @AppointmentStatusText(ap.Status)
                                    </div>

                                    <p class="his-desc">
                                        Nhân viên phụ trách: @SafeText(ap.AssignedStaffName, "Chưa cập nhật")
                                        @if (!string.IsNullOrWhiteSpace(ap.MeetingLocation))
                                        {
                                            <text>
                                                Địa điểm: @ap.MeetingLocation
                                            </text>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(ap.Note))
                                        {
                                            <text>
                                                Ghi chú: @ap.Note
                                            </text>
                                        }
                                    </p>

                                    <div class="mt-2">
                                        <span class="his-badge">
                                            <i class="bi bi-info-circle"></i>
                                            @AppointmentStatusText(ap.Status)
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (noteLines.Any())
                    {
                        foreach (var line in noteLines)
                        {
                            <div class="his-item">
                                <div class="his-dot note">
                                    <i class="bi bi-journal-text"></i>
                                </div>

                                <div class="his-content">
                                    <div class="his-date">
                                        <i class="bi bi-pencil-square"></i>
                                        Nhật ký CRM
                                    </div>

                                    <div class="his-title">Ghi chú chăm sóc</div>

                                    <p class="his-desc">@line</p>
                                </div>
                            </div>
                        }
                    }

                    @if (!historyAppointments.Any() && !noteLines.Any())
                    {
                        <div class="his-empty">
                            <i class="bi bi-journal-x fs-1 d-block mb-3 text-muted"></i>
                            Chưa có lịch sử chăm sóc nào ngoài yêu cầu tư vấn ban đầu.
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>
</div>