@model IEnumerable<BDSKhanhHoa.Models.Transaction>
@using System.Globalization

@{
    var transactions = Model?.ToList() ?? new List<BDSKhanhHoa.Models.Transaction>();

    if (!transactions.Any())
    {
        <div style="font-family:Arial,sans-serif;padding:40px;text-align:center;">
            <h2>Không tìm thấy dữ liệu hóa đơn</h2>
            <p>Vui lòng quay lại lịch sử giao dịch và thử lại.</p>
            <a href="/Payment/History">Quay lại lịch sử giao dịch</a>
        </div>
        return;
    }

    var vi = new CultureInfo("vi-VN");

    var firstTx = transactions.First();
    var user = firstTx.User;

    string baseCode = Convert.ToString(ViewBag.BaseCode) ?? firstTx.TransactionCode ?? firstTx.TransactionID.ToString();
    string invoiceCode = "INV-" + baseCode;
    string customerName = user?.FullName ?? user?.Username ?? "Khách hàng";
    string customerEmail = user?.Email ?? "Chưa cập nhật";
    string customerPhone = user?.Phone ?? "Chưa cập nhật";

    decimal totalOriginalAmount = 0;

    foreach (var item in transactions)
    {
        if (item.Package != null)
        {
            totalOriginalAmount += item.Package.Price * item.Quantity;
        }
        else
        {
            totalOriginalAmount += item.Amount;
        }
    }

    decimal finalPaidAmount = transactions.Sum(x => x.Amount);
    decimal totalDiscount = totalOriginalAmount - finalPaidAmount;

    if (totalDiscount < 0)
    {
        totalDiscount = 0;
    }

    string paymentMethod = string.IsNullOrWhiteSpace(firstTx.PaymentMethod)
        ? "Không xác định"
        : firstTx.PaymentMethod;

    string statusText = firstTx.Status switch
    {
        "Success" => "Đã thanh toán",
        "Pending" => "Đang chờ xử lý",
        "Failed" => "Thanh toán thất bại",
        "Cancelled" => "Đã hủy",
        _ => firstTx.Status ?? "Đã ghi nhận"
    };

    string statusClass = firstTx.Status switch
    {
        "Success" => "status-success",
        "Pending" => "status-pending",
        "Failed" => "status-failed",
        "Cancelled" => "status-cancelled",
        _ => "status-success"
    };

    ViewData["Title"] = "Hóa đơn điện tử #" + invoiceCode;
    Layout = null;

    string Money(decimal value)
    {
        return value.ToString("N0", vi) + " đ";
    }

    string DateTimeText(DateTime value)
    {
        return value.ToString("dd/MM/yyyy HH:mm", vi);
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Arial&display=swap" rel="stylesheet" />

    <style>
        :root {
            --ink: #0f172a;
            --text: #334155;
            --muted: #64748b;
            --line: #e2e8f0;
            --soft: #f8fafc;
            --blue: #2563eb;
            --blue-soft: #eff6ff;
            --green: #16a34a;
            --green-soft: #ecfdf5;
            --red: #dc2626;
            --red-soft: #fef2f2;
            --yellow: #d97706;
            --yellow-soft: #fffbeb;
            --paper: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            color: var(--text);
            background: #e5e7eb;
            font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .no-print {
            width: min(100%, 920px);
            margin: 18px auto;
            padding: 0 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .btn-action {
            min-height: 42px;
            padding: 0 18px;
            border-radius: 999px;
            border: 1px solid var(--line);
            background: #fff;
            color: var(--ink);
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .08);
        }

        .btn-print {
            border-color: var(--blue);
            background: var(--blue);
            color: #fff;
        }

        .invoice-wrap {
            width: min(100%, 920px);
            margin: 0 auto 30px;
            padding: 0 12px;
        }

        .invoice-paper {
            position: relative;
            width: 100%;
            min-height: 1120px;
            background: var(--paper);
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 18px 60px rgba(15, 23, 42, .18);
        }

        .top-strip {
            height: 10px;
            background: linear-gradient(90deg, #0f172a, #2563eb, #0ea5e9);
        }

        .invoice-inner {
            padding: 42px 48px 34px;
        }

        .invoice-header {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 270px;
            gap: 28px;
            align-items: start;
            padding-bottom: 28px;
            border-bottom: 2px solid var(--ink);
        }

        .brand {
            display: flex;
            align-items: flex-start;
            gap: 14px;
        }

        .brand-logo {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            flex-shrink: 0;
        }

        .brand-name {
            margin: 0 0 4px;
            color: var(--ink);
            font-size: 1.35rem;
            font-weight: 900;
            letter-spacing: -.02em;
            text-transform: uppercase;
        }

        .brand-sub {
            color: var(--muted);
            font-size: .86rem;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .company-info {
            color: var(--muted);
            font-size: .86rem;
            line-height: 1.65;
        }

            .company-info b {
                color: var(--text);
            }

        .invoice-title-box {
            text-align: right;
        }

        .invoice-title {
            margin: 0;
            color: var(--ink);
            font-size: 2.05rem;
            font-weight: 900;
            letter-spacing: -.04em;
            text-transform: uppercase;
        }

        .invoice-code {
            display: inline-flex;
            margin-top: 8px;
            padding: 7px 12px;
            border-radius: 999px;
            background: var(--blue-soft);
            color: var(--blue);
            border: 1px solid #bfdbfe;
            font-size: .86rem;
            font-weight: 800;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin-top: 10px;
            min-height: 32px;
            padding: 0 12px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .status-success {
            color: #15803d;
            background: var(--green-soft);
            border: 1px solid #bbf7d0;
        }

        .status-pending {
            color: #b45309;
            background: var(--yellow-soft);
            border: 1px solid #fde68a;
        }

        .status-failed,
        .status-cancelled {
            color: #b91c1c;
            background: var(--red-soft);
            border: 1px solid #fecaca;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-top: 26px;
        }

        .info-card {
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 18px;
            background: #fff;
        }

            .info-card.soft {
                background: var(--soft);
            }

        .info-label {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            color: var(--blue);
            font-size: .78rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

        .info-name {
            margin: 0 0 6px;
            color: var(--ink);
            font-size: 1rem;
            font-weight: 900;
        }

        .info-line {
            color: var(--muted);
            font-size: .9rem;
            margin: 3px 0;
        }

        .meta-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            margin-top: 18px;
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
            background: #fff;
        }

        .meta-item {
            padding: 14px 16px;
            border-right: 1px solid var(--line);
        }

            .meta-item:last-child {
                border-right: 0;
            }

        .meta-label {
            color: var(--muted);
            font-size: .74rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: 5px;
        }

        .meta-value {
            color: var(--ink);
            font-size: .94rem;
            font-weight: 800;
            word-break: break-word;
        }

        .section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 28px 0 12px;
            color: var(--ink);
            font-size: 1rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--line);
            border-radius: 14px;
            overflow: hidden;
        }

            .invoice-table thead th {
                background: #0f172a;
                color: #fff;
                padding: 12px 10px;
                font-size: .76rem;
                font-weight: 900;
                text-transform: uppercase;
                letter-spacing: .045em;
                border-right: 1px solid rgba(255,255,255,.14);
                white-space: nowrap;
            }

                .invoice-table thead th:last-child {
                    border-right: 0;
                }

            .invoice-table tbody td {
                padding: 13px 10px;
                border-bottom: 1px solid var(--line);
                vertical-align: top;
            }

            .invoice-table tbody tr:last-child td {
                border-bottom: 0;
            }

            .invoice-table tbody tr:nth-child(even) {
                background: #f8fafc;
            }

        .text-center {
            text-align: center;
        }

        .text-end {
            text-align: right;
        }

        .service-name {
            color: var(--ink);
            font-weight: 900;
            margin-bottom: 3px;
        }

        .service-desc {
            color: var(--muted);
            font-size: .84rem;
            line-height: 1.5;
        }

        .service-code {
            display: inline-flex;
            margin-top: 5px;
            padding: 3px 8px;
            border-radius: 999px;
            color: var(--blue);
            background: var(--blue-soft);
            border: 1px solid #dbeafe;
            font-size: .74rem;
            font-weight: 800;
        }

        .summary-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 340px;
            gap: 24px;
            margin-top: 26px;
            align-items: start;
        }

        .note-box {
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 16px;
            background: var(--soft);
            color: var(--muted);
            font-size: .86rem;
            line-height: 1.65;
        }

            .note-box b {
                color: var(--ink);
            }

        .paid-stamp {
            width: fit-content;
            margin-top: 18px;
            padding: 9px 18px;
            border: 3px solid var(--green);
            color: var(--green);
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .06em;
            transform: rotate(-7deg);
            opacity: .88;
        }

        .total-box {
            border: 1px solid var(--line);
            border-radius: 16px;
            overflow: hidden;
            background: #fff;
        }

        .total-head {
            padding: 13px 16px;
            color: #fff;
            background: linear-gradient(135deg, #0f172a, #1e293b);
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .045em;
            font-size: .82rem;
        }

        .total-body {
            padding: 16px;
        }

        .total-line {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            padding: 9px 0;
            color: var(--text);
            font-size: .92rem;
            border-bottom: 1px dashed var(--line);
        }

            .total-line:last-child {
                border-bottom: 0;
            }

            .total-line .label {
                color: var(--muted);
                font-weight: 700;
            }

            .total-line .value {
                color: var(--ink);
                font-weight: 900;
                text-align: right;
                white-space: nowrap;
            }

        .discount .label,
        .discount .value {
            color: var(--green);
        }

        .grand-total {
            margin-top: 8px;
            padding-top: 14px;
            border-top: 2px solid var(--ink);
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 12px;
        }

            .grand-total .label {
                color: var(--ink);
                font-size: .9rem;
                font-weight: 900;
                text-transform: uppercase;
            }

            .grand-total .value {
                color: var(--blue);
                font-size: 1.65rem;
                font-weight: 900;
                letter-spacing: -.04em;
                text-align: right;
                white-space: nowrap;
            }

        .signature-area {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            margin-top: 38px;
        }

        .signature-box {
            text-align: center;
            min-height: 120px;
        }

        .signature-title {
            color: var(--ink);
            font-size: .92rem;
            font-weight: 900;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .signature-note {
            color: var(--muted);
            font-size: .78rem;
            font-style: italic;
        }

        .system-sign {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 34px;
            padding: 8px 14px;
            border-radius: 999px;
            color: var(--blue);
            background: var(--blue-soft);
            border: 1px solid #bfdbfe;
            font-size: .82rem;
            font-weight: 900;
        }

        .invoice-footer {
            margin-top: 30px;
            padding-top: 16px;
            border-top: 1px solid var(--line);
            text-align: center;
            color: var(--muted);
            font-size: .8rem;
            line-height: 1.55;
        }

        .watermark {
            position: absolute;
            top: 49%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-26deg);
            color: rgba(37, 99, 235, .045);
            font-size: 5.2rem;
            font-weight: 900;
            letter-spacing: .08em;
            text-transform: uppercase;
            pointer-events: none;
            white-space: nowrap;
            z-index: 0;
        }

        .invoice-inner > * {
            position: relative;
            z-index: 1;
        }

        @@media (max-width: 768px) {
            .no-print {
                flex-direction: column;
                align-items: stretch;
            }

            .btn-action {
                width: 100%;
            }

            .invoice-wrap {
                padding: 0;
            }

            .invoice-paper {
                border-radius: 0;
            }

            .invoice-inner {
                padding: 28px 18px;
            }

            .invoice-header,
            .info-grid,
            .summary-layout,
            .signature-area {
                grid-template-columns: 1fr;
            }

            .invoice-title-box {
                text-align: left;
            }

            .meta-row {
                grid-template-columns: 1fr;
            }

            .meta-item {
                border-right: 0;
                border-bottom: 1px solid var(--line);
            }

                .meta-item:last-child {
                    border-bottom: 0;
                }

            .invoice-table {
                font-size: .86rem;
            }

                .invoice-table thead th,
                .invoice-table tbody td {
                    padding: 10px 7px;
                }

            .grand-total .value {
                font-size: 1.3rem;
            }

            .watermark {
                display: none;
            }
        }

        @@page {
            size: A4;
            margin: 10mm;
        }

        @@media print {
            html,
            body {
                width: 210mm;
                min-height: 297mm;
                background: #fff !important;
                font-size: 12px;
            }

            .no-print {
                display: none !important;
            }

            .invoice-wrap {
                width: 100%;
                max-width: none;
                margin: 0;
                padding: 0;
            }

            .invoice-paper {
                width: 100%;
                min-height: auto;
                border-radius: 0;
                box-shadow: none;
                overflow: visible;
            }

            .invoice-inner {
                padding: 0;
            }

            .top-strip {
                height: 7px;
                margin-bottom: 10px;
            }

            .invoice-header {
                padding-bottom: 18px;
            }

            .info-grid {
                margin-top: 18px;
                gap: 12px;
            }

            .info-card {
                padding: 12px;
            }

            .meta-row {
                margin-top: 12px;
            }

            .meta-item {
                padding: 10px 12px;
            }

            .section-title {
                margin: 18px 0 8px;
            }

            .invoice-table thead th {
                padding: 9px 7px;
            }

            .invoice-table tbody td {
                padding: 9px 7px;
            }

            .summary-layout {
                margin-top: 18px;
                gap: 16px;
                grid-template-columns: minmax(0, 1fr) 310px;
            }

            .note-box {
                padding: 12px;
            }

            .signature-area {
                margin-top: 24px;
            }

            .signature-box {
                min-height: 86px;
            }

            .invoice-footer {
                margin-top: 18px;
                padding-top: 10px;
            }

            .brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 14px;
            }

            .brand-name {
                font-size: 1.15rem;
            }

            .invoice-title {
                font-size: 1.65rem;
            }

            .grand-total .value {
                font-size: 1.35rem;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .invoice-table,
            .total-box,
            .info-card,
            .meta-row {
                break-inside: avoid;
            }
        }
    </style>
</head>

<body>
    <div class="no-print">
        <a href="/Payment/History" class="btn-action">
            <i class="bi bi-arrow-left"></i>
            Quay lại lịch sử
        </a>

        <button type="button" onclick="window.print()" class="btn-action btn-print">
            <i class="bi bi-printer-fill"></i>
            In hóa đơn / Lưu PDF
        </button>
    </div>

    <div class="invoice-wrap">
        <div class="invoice-paper">
            <div class="top-strip"></div>
            <div class="watermark">PAID</div>

            <div class="invoice-inner">
                <header class="invoice-header">
                    <div class="brand">
                        <div class="brand-logo">
                            <i class="bi bi-buildings-fill"></i>
                        </div>

                        <div>
                            <h1 class="brand-name">BĐS Khánh Hòa</h1>
                            <div class="brand-sub">Trung tâm mua bán, cho thuê và đăng tin bất động sản</div>

                            <div class="company-info">
                                <div><b>Đơn vị cung cấp:</b> CÔNG TY BẤT ĐỘNG SẢN KHÁNH HÒA</div>
                                <div><b>Địa chỉ:</b> TP. Nha Trang, Tỉnh Khánh Hòa, Việt Nam</div>
                                <div><b>Hotline:</b> 1900 8888</div>
                                <div><b>Website:</b> batdongsankhanhhoa.com</div>
                                <div><b>Email:</b> support@batdongsankhanhhoa.vn</div>
                            </div>
                        </div>
                    </div>

                    <div class="invoice-title-box">
                        <h2 class="invoice-title">Hóa đơn</h2>

                        <div class="invoice-code">
                            #@invoiceCode
                        </div>

                        <div class="status-badge @statusClass">
                            <i class="bi bi-check-circle-fill"></i>
                            @statusText
                        </div>
                    </div>
                </header>

                <section class="info-grid">
                    <div class="info-card">
                        <div class="info-label">
                            <i class="bi bi-person-badge-fill"></i>
                            Thông tin khách hàng
                        </div>

                        <h3 class="info-name">@customerName</h3>
                        <div class="info-line"><b>Email:</b> @customerEmail</div>
                        <div class="info-line"><b>Số điện thoại:</b> @customerPhone</div>
                        <div class="info-line"><b>Mã người dùng:</b> @(user?.UserID.ToString() ?? "N/A")</div>
                    </div>

                    <div class="info-card soft">
                        <div class="info-label">
                            <i class="bi bi-receipt-cutoff"></i>
                            Thông tin hóa đơn
                        </div>

                        <h3 class="info-name">Hóa đơn dịch vụ đăng tin</h3>
                        <div class="info-line"><b>Ngày lập:</b> @DateTime.Now.ToString("dd/MM/yyyy HH:mm", vi)</div>
                        <div class="info-line"><b>Ngày giao dịch:</b> @DateTimeText(firstTx.CreatedAt)</div>
                        <div class="info-line"><b>Loại hóa đơn:</b> Hóa đơn điện tử</div>
                    </div>
                </section>

                <section class="meta-row">
                    <div class="meta-item">
                        <div class="meta-label">Mã giao dịch</div>
                        <div class="meta-value">#@baseCode</div>
                    </div>

                    <div class="meta-item">
                        <div class="meta-label">Phương thức thanh toán</div>
                        <div class="meta-value">@paymentMethod</div>
                    </div>

                    <div class="meta-item">
                        <div class="meta-label">Số lượng giao dịch</div>
                        <div class="meta-value">@transactions.Count giao dịch</div>
                    </div>
                </section>

                <h3 class="section-title">
                    <i class="bi bi-list-check"></i>
                    Chi tiết dịch vụ
                </h3>

                <table class="invoice-table">
                    <thead>
                        <tr>
                            <th style="width:52px;" class="text-center">STT</th>
                            <th>Dịch vụ / Mô tả</th>
                            <th style="width:120px;" class="text-end">Đơn giá</th>
                            <th style="width:70px;" class="text-center">SL</th>
                            <th style="width:130px;" class="text-end">Thành tiền</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int stt = 1;
                        }

                        @foreach (var item in transactions)
                        {
                            decimal itemPrice = item.Package?.Price ?? item.Amount;
                            decimal lineTotal = item.Package != null
                            ? item.Package.Price * item.Quantity
                            : item.Amount;

                            string packageName = item.Package?.PackageName ?? "Dịch vụ đăng tin";
                            string packageType = item.Package?.PackageType ?? "Dịch vụ";
                            string description = !string.IsNullOrWhiteSpace(item.Description)
                            ? item.Description
                            : "Thanh toán dịch vụ trên hệ thống BĐS Khánh Hòa.";

                            <tr>
                                <td class="text-center">
                                    <b>@stt.ToString("00")</b>
                                </td>

                                <td>
                                    <div class="service-name">@packageName</div>
                                    <div class="service-desc">@description</div>
                                    <span class="service-code">
                                        @packageType
                                        @if (item.Package != null)
                                        {
                                            <text> · @item.Package.DurationDays ngày · Top @item.Package.PriorityLevel</text>
                                        }
                                    </span>
                                </td>

                                <td class="text-end">@Money(itemPrice)</td>
                                <td class="text-center"><b>@item.Quantity</b></td>
                                <td class="text-end"><b>@Money(lineTotal)</b></td>
                            </tr>

                            stt++;
                        }
                    </tbody>
                </table>

                <section class="summary-layout">
                    <div>
                        <div class="note-box">
                            <b>Ghi chú:</b><br />
                            Hóa đơn này được khởi tạo tự động từ hệ thống BĐS Khánh Hòa sau khi giao dịch được ghi nhận.
                            Vui lòng lưu lại mã hóa đơn và mã giao dịch để đối chiếu khi cần hỗ trợ.
                            Hóa đơn dùng cho mục đích xác nhận thanh toán dịch vụ đăng tin trên hệ thống.
                        </div>

                        @if (firstTx.Status == "Success" || string.IsNullOrWhiteSpace(firstTx.Status))
                        {
                            <div class="paid-stamp">
                                Đã thanh toán
                            </div>
                        }
                    </div>

                    <aside class="total-box">
                        <div class="total-head">
                            Tổng kết thanh toán
                        </div>

                        <div class="total-body">
                            <div class="total-line">
                                <span class="label">Tạm tính</span>
                                <span class="value">@Money(totalOriginalAmount)</span>
                            </div>

                            @if (totalDiscount > 0)
                            {
                                <div class="total-line discount">
                                    <span class="label">Giảm giá / Voucher</span>
                                    <span class="value">- @Money(totalDiscount)</span>
                                </div>
                            }

                            <div class="total-line">
                                <span class="label">Thuế / Phí phát sinh</span>
                                <span class="value">0 đ</span>
                            </div>

                            <div class="grand-total">
                                <span class="label">Tổng thanh toán</span>
                                <span class="value">@Money(finalPaidAmount)</span>
                            </div>
                        </div>
                    </aside>
                </section>

                <section class="signature-area">
                    <div class="signature-box">
                        <div class="signature-title">Khách hàng</div>
                        <div class="signature-note">Người mua xác nhận thông tin giao dịch</div>
                    </div>

                    <div class="signature-box">
                        <div class="signature-title">BĐS Khánh Hòa</div>
                        <div class="signature-note">Hóa đơn được ký tự động bởi hệ thống</div>

                        <div class="system-sign">
                            <i class="bi bi-shield-check"></i>
                            Đã xác thực hệ thống
                        </div>
                    </div>
                </section>

                <footer class="invoice-footer">
                    <div>
                        Hóa đơn điện tử được tạo tự động bởi hệ thống BĐS Khánh Hòa - @DateTime.Now.Year.
                    </div>
                    <div>
                        Cảm ơn Quý khách đã sử dụng dịch vụ. Mọi thắc mắc vui lòng liên hệ bộ phận hỗ trợ để được xử lý.
                    </div>
                </footer>
            </div>
        </div>
    </div>
</body>
</html>