@model IEnumerable<BDSKhanhHoa.Models.Transaction>
@{
    ViewData["Title"] = "Hóa Đơn Điện Tử #" + ViewBag.BaseCode;
    Layout = null; // Loại bỏ hoàn toàn Layout để việc in ấn sạch sẽ 100%

    var firstTx = Model.First();
    var user = firstTx.User;

    decimal totalOriginalAmount = 0;
    foreach (var item in Model)
    {
        if (item.Package != null)
        {
            totalOriginalAmount += (item.Package.Price * item.Quantity);
        }
    }
    decimal finalPaidAmount = Model.Sum(x => x.Amount);
    decimal totalDiscount = totalOriginalAmount - finalPaidAmount;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">

    <style>
        :root {
            --invoice-primary: #1e293b;
            --invoice-accent: #2563eb;
            --invoice-text: #334155;
            --invoice-muted: #64748b;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--invoice-text);
            background-color: #f1f5f9;
            -webkit-print-color-adjust: exact;
        }

        .invoice-container {
            max-width: 850px;
            margin: 40px auto;
        }

        .invoice-paper {
            background: #fff;
            padding: 60px;
            border-radius: 4px;
            position: relative;
            min-height: 1100px; /* Chuẩn chiều cao A4 */
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        .invoice-header-line {
            height: 4px;
            background: var(--invoice-primary);
            margin-bottom: 40px;
        }

        .brand-name {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--invoice-primary);
            letter-spacing: -1px;
            text-transform: uppercase;
        }

        .invoice-title {
            font-size: 3rem;
            font-weight: 900;
            color: #e2e8f0;
            position: absolute;
            right: 60px;
            top: 50px;
            letter-spacing: 5px;
        }

        .table-invoice thead th {
            background: #f8fafc;
            border-bottom: 2px solid var(--invoice-primary);
            color: var(--invoice-primary);
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            padding: 15px;
        }

        .table-invoice tbody td {
            padding: 20px 15px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .total-box {
            background: #f8fafc;
            border-radius: 8px;
            padding: 30px;
        }

        .final-amount {
            font-size: 2rem;
            font-weight: 800;
            color: var(--invoice-accent);
        }

        .stamp-authorized {
            border: 3px solid #f87171;
            color: #f87171;
            display: inline-block;
            padding: 10px 20px;
            font-weight: 900;
            text-transform: uppercase;
            border-radius: 8px;
            transform: rotate(-15deg);
            opacity: 0.8;
            font-size: 1.2rem;
            margin-top: 20px;
        }

        .no-print-zone {
            max-width: 850px;
            margin: 20px auto;
        }

        @@media print {
            body {
                background: #fff;
                margin: 0;
            }

            .invoice-container {
                margin: 0;
                max-width: 100%;
            }

            .invoice-paper {
                box-shadow: none;
                padding: 40px;
            }

            .no-print-zone {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="no-print-zone d-flex justify-content-between">
        <a href="/Payment/History" class="btn btn-dark rounded-pill px-4 fw-bold">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-printer me-2"></i>In Hóa Đơn (PDF)
        </button>
    </div>

    <div class="invoice-container">
        <div class="invoice-paper">
            <div class="invoice-title">INVOICE</div>

            <div class="brand-name mb-4">
                <i class="bi bi-buildings-fill me-2"></i>BĐS KHÁNH HÒA
            </div>

            <div class="invoice-header-line"></div>

            <div class="row mb-5">
                <div class="col-6">
                    <p class="mb-1 text-uppercase fw-bold small text-muted">Đơn vị cung cấp:</p>
                    <h6 class="fw-bold mb-1">CÔNG TY BẤT ĐỘNG SẢN KHÁNH HÒA</h6>
                    <p class="text-muted small">
                        TP. Nha Trang, Tỉnh Khánh Hòa, Việt Nam<br>
                        Hotline: 1900 8888 | Website: batdongsankhanhhoa.com
                    </p>
                </div>
                <div class="col-6 text-end">
                    <p class="mb-1 text-uppercase fw-bold small text-muted">Thông tin khách hàng:</p>
                    <h6 class="fw-bold mb-1">@(user?.FullName ?? user?.Username)</h6>
                    <p class="text-muted small">
                        Email: @user?.Email<br>
                        SĐT: @(user?.Phone ?? "N/A")
                    </p>
                </div>
            </div>

            <div class="row mb-5 py-4 px-3 bg-light rounded-3">
                <div class="col-4">
                    <div class="fw-bold small text-muted text-uppercase">Mã Giao Dịch</div>
                    <div class="fw-bold text-dark">#@ViewBag.BaseCode</div>
                </div>
                <div class="col-4 text-center border-start border-end">
                    <div class="fw-bold small text-muted text-uppercase">Ngày Giao Dịch</div>
                    <div class="fw-bold text-dark">@firstTx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-4 text-end">
                    <div class="fw-bold small text-muted text-uppercase">Phương Thức</div>
                    <div class="fw-bold text-dark">@firstTx.PaymentMethod</div>
                </div>
            </div>

            <table class="table table-invoice mb-5">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th>Dịch Vụ & Mô Tả</th>
                        <th class="text-end">Đơn Giá</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Thành Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                    }
                    @foreach (var item in Model)
                    {
                        decimal itemPrice = item.Package?.Price ?? 0;
                        <tr>
                            <td class="text-center text-muted fw-bold">@stt.ToString("00")</td>
                            <td>
                                <div class="fw-bold text-dark">@item.Package?.PackageName</div>
                                <div class="small text-muted">@item.Description</div>
                            </td>
                            <td class="text-end">@itemPrice.ToString("N0") đ</td>
                            <td class="text-center fw-bold">@item.Quantity</td>
                            <td class="text-end fw-bold text-dark">@((itemPrice * item.Quantity).ToString("N0")) đ</td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>

            <div class="row">
                <div class="col-6">
                    <div class="stamp-authorized">ĐÃ THANH TOÁN</div>
                    <p class="text-muted small mt-4">
                        * Ghi chú: Hóa đơn điện tử này có giá trị pháp lý tương đương hóa đơn giấy.
                        Vui lòng giữ lại mã giao dịch để đối chiếu khi cần thiết.
                    </p>
                </div>
                <div class="col-6">
                    <div class="total-box">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted fw-bold small text-uppercase">Tổng giá trị:</span>
                            <span class="fw-bold text-dark">@totalOriginalAmount.ToString("N0") đ</span>
                        </div>

                        @if (totalDiscount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span class="fw-bold small text-uppercase">Chiết khấu (Voucher):</span>
                                <span class="fw-bold">- @totalDiscount.ToString("N0") đ</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                            <span class="text-dark fw-bold text-uppercase mt-2">Tổng Thanh Toán:</span>
                            <span class="final-amount">@finalPaidAmount.ToString("N0") đ</span>
                        </div>
                    </div>
                </div>
            </div>

            <div style="position: absolute; bottom: 60px; left: 60px; right: 60px;">
                <div class="border-top pt-3 text-center">
                    <p class="text-muted small">Hóa đơn được khởi tạo tự động bởi hệ thống BĐS Khánh Hòa - @DateTime.Now.Year</p>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>