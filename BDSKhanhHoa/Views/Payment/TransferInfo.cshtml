@model BDSKhanhHoa.Models.BankAccount

@{
    ViewData["Title"] = "Thanh toán chuyển khoản";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    decimal amount = ViewBag.Amount is decimal ? (decimal)ViewBag.Amount : 0;
    string baseCode = ViewBag.BaseCode?.ToString() ?? "";

    DateTime createdAt = ViewBag.CreatedAt is DateTime ? (DateTime)ViewBag.CreatedAt : DateTime.Now;
    DateTime expireAt = ViewBag.ExpireAt is DateTime ? (DateTime)ViewBag.ExpireAt : createdAt.AddMinutes(15);

    int expireMinutes = ViewBag.PaymentExpireMinutes is int ? (int)ViewBag.PaymentExpireMinutes : 15;

    string qrCodeUrl = $"https://img.vietqr.io/image/{Model.BinCode}-{Model.AccountNumber}-compact2.png?amount={amount}&addInfo={Uri.EscapeDataString(baseCode)}&accountName={Uri.EscapeDataString(Model.AccountName)}";
}

<style>
    .qr-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .qr-card {
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        overflow: hidden;
        border: 1px solid #f1f5f9;
    }

    .qr-header {
        background: radial-gradient(circle at top right, rgba(59,130,246,.25), transparent 320px), linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: white;
        padding: 30px;
        text-align: center;
    }

        .qr-header h3 {
            font-weight: 950;
            letter-spacing: -0.03em;
        }

    .countdown-box {
        margin-top: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 999px;
        padding: 10px 18px;
        backdrop-filter: blur(10px);
    }

    .countdown-label {
        color: rgba(255,255,255,.76);
        font-size: .9rem;
        font-weight: 700;
    }

    .countdown-time {
        color: #facc15;
        font-size: 1.15rem;
        font-weight: 950;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        min-width: 72px;
        display: inline-block;
        text-align: center;
    }

    .countdown-danger {
        color: #fecaca !important;
        animation: pulseTimer 1s infinite;
    }

    @@keyframes pulseTimer {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .55;
        }
    }

    .qr-image-wrapper {
        background: #f8fafc;
        padding: 20px;
        border-radius: 20px;
        display: inline-block;
        border: 2px dashed #cbd5e1;
        position: relative;
    }

        .qr-image-wrapper::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: #3b82f6;
            box-shadow: 0 0 10px #3b82f6, 0 0 20px #3b82f6;
            animation: scan 2.5s infinite linear;
            border-radius: 50%;
        }

    @@keyframes scan {
        0% {
            top: 10px;
            opacity: 0;
        }

        10% {
            opacity: 1;
        }

        90% {
            opacity: 1;
        }

        100% {
            top: calc(100% - 10px);
            opacity: 0;
        }
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 15px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .btn-copy {
        background: #f1f5f9;
        color: #475569;
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 0.85rem;
        font-weight: bold;
        transition: 0.3s;
        white-space: nowrap;
    }

        .btn-copy:hover {
            background: #3b82f6;
            color: white;
        }

    .payment-note {
        border-radius: 18px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        padding: 16px;
    }

    .payment-note-title {
        color: #9a3412;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .payment-note ul {
        margin-bottom: 0;
        padding-left: 18px;
        color: #7c2d12;
        font-size: .9rem;
        font-weight: 650;
        line-height: 1.55;
    }

    .upload-zone {
        border: 2px dashed #94a3b8;
        border-radius: 16px;
        padding: 30px 20px;
        text-align: center;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

        .upload-zone:hover {
            border-color: #3b82f6;
            background: #eff6ff;
        }

        .upload-zone.dragover {
            border-color: #10b981;
            background: #ecfdf5;
            transform: scale(1.02);
        }

        .upload-zone.disabled {
            opacity: .55;
            pointer-events: none;
            cursor: not-allowed;
        }

    .upload-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    #billPreview {
        max-height: 250px;
        border-radius: 12px;
        object-fit: contain;
        display: none;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin: 0 auto;
    }

    .expired-panel {
        display: none;
        border-radius: 18px;
        border: 1px solid #fecaca;
        background: #fef2f2;
        color: #991b1b;
        padding: 18px;
        margin-bottom: 18px;
    }

        .expired-panel h6 {
            font-weight: 950;
            margin-bottom: 6px;
        }

    .back-history-btn {
        min-height: 46px;
        border-radius: 999px;
        font-weight: 900;
    }

    @@media (max-width: 767.98px) {
        .container.my-5 {
            margin-top: 24px !important;
        }

        .qr-header {
            padding: 24px 18px;
        }

            .qr-header h3 {
                font-size: 1.25rem;
            }

        .countdown-box {
            border-radius: 18px;
            flex-direction: column;
            gap: 3px;
            padding: 12px 16px;
        }

        .info-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 6px;
        }

            .info-row > div {
                width: 100%;
                justify-content: space-between;
            }

        .fs-4 {
            font-size: 1.15rem !important;
        }
    }
</style>

<div class="container my-5 pb-5">
    <div class="qr-page">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-12">
                <div class="qr-card animate__animated animate__zoomIn">
                    <div class="qr-header">
                        <h3 class="mb-2">
                            <i class="bi bi-qr-code-scan me-2 text-primary"></i>
                            Chuyển khoản & Tải biên lai
                        </h3>

                        <p class="mb-0 text-white-50">
                            Vui lòng quét mã thanh toán, sau đó chụp màn hình biên lai tải lên để Admin đối soát.
                        </p>

                        <div class="countdown-box" id="countdownBox">
                            <i class="bi bi-hourglass-split text-warning"></i>
                            <span class="countdown-label">Thời gian thanh toán còn lại:</span>
                            <span class="countdown-time" id="countdownTimer">--:--</span>
                        </div>
                    </div>

                    <div class="row g-0">
                        <div class="col-md-6 p-4 p-lg-5 bg-white border-end">
                            <div class="text-center mb-4">
                                <div class="qr-image-wrapper mb-3 bg-white shadow-sm" id="qrWrapper">
                                    <img src="@qrCodeUrl"
                                         alt="QR Code"
                                         class="img-fluid"
                                         style="width: 200px; height: 200px; object-fit: contain;" />
                                </div>
                            </div>

                            <h5 class="fw-bold mb-3 text-dark">
                                <i class="bi bi-receipt text-secondary me-2"></i>
                                Chi tiết nhận tiền
                            </h5>

                            <div class="info-row">
                                <span class="text-muted">Ngân hàng:</span>
                                <strong class="text-dark">@Model.BankName</strong>
                            </div>

                            <div class="info-row">
                                <span class="text-muted">Chủ tài khoản:</span>
                                <strong class="text-dark text-uppercase">@Model.AccountName</strong>
                            </div>

                            <div class="info-row">
                                <span class="text-muted">Số tài khoản:</span>
                                <div class="d-flex align-items-center gap-2">
                                    <strong class="text-primary fs-5 font-monospace" id="txtAccNumber">@Model.AccountNumber</strong>
                                    <button class="btn-copy" type="button" onclick="copyText('txtAccNumber')">
                                        <i class="bi bi-clipboard"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="info-row">
                                <span class="text-muted">Số tiền:</span>
                                <strong class="text-danger fs-4 fw-black">@amount.ToString("N0") đ</strong>
                            </div>

                            <div class="info-row">
                                <span class="text-muted">Tạo lúc:</span>
                                <strong class="text-dark">@createdAt.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>

                            <div class="info-row">
                                <span class="text-muted">Hết hạn lúc:</span>
                                <strong class="text-danger">@expireAt.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>

                            <div class="bg-warning bg-opacity-10 border border-warning p-3 rounded-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 gap-2">
                                    <span class="text-warning-emphasis fw-bold small">
                                        Nội dung chuyển khoản bắt buộc
                                    </span>

                                    <button class="btn-copy bg-warning text-dark" type="button" onclick="copyText('txtContent')">
                                        <i class="bi bi-clipboard"></i>
                                        Copy
                                    </button>
                                </div>

                                <strong class="fs-4 text-dark font-monospace" id="txtContent">@baseCode</strong>
                            </div>

                            <div class="payment-note mt-4">
                                <div class="payment-note-title">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Lưu ý quan trọng
                                </div>

                                <ul>
                                    <li>Chuyển khoản đúng số tiền và đúng nội dung.</li>
                                    <li>Đơn hàng sẽ tự hủy nếu quá @expireMinutes phút chưa gửi biên lai.</li>
                                    <li>Sau khi hết hạn, bạn cần tạo đơn mới hoặc bấm thanh toán lại nếu còn hợp lệ.</li>
                                </ul>
                            </div>
                        </div>

                        <div class="col-md-6 p-4 p-lg-5 bg-light d-flex flex-column justify-content-center">
                            <div class="expired-panel" id="expiredPanel">
                                <h6>
                                    <i class="bi bi-x-octagon-fill me-1"></i>
                                    Đơn hàng đã hết thời gian thanh toán
                                </h6>

                                <div>
                                    Hệ thống sẽ đóng giao dịch chưa thanh toán. Vui lòng tạo đơn mới để tiếp tục mua gói tin.
                                </div>
                            </div>

                            <h5 class="fw-bold mb-3 text-dark">
                                <i class="bi bi-cloud-arrow-up text-primary me-2"></i>
                                Gửi bằng chứng thanh toán
                            </h5>

                            <p class="text-muted small mb-4">
                                Giao dịch của bạn sẽ được đưa vào hàng đợi duyệt ngay sau khi ảnh biên lai được tải lên hệ thống.
                            </p>

                            <form action="/Payment/SubmitBill" method="post" enctype="multipart/form-data" id="uploadForm">
                                @Html.AntiForgeryToken()

                                <input type="hidden" name="baseCode" value="@baseCode" />

                                <div class="upload-zone mb-4" id="dropZone">
                                    <input type="file"
                                           name="billImage"
                                           class="upload-input"
                                           id="billInput"
                                           accept="image/png, image/jpeg, image/jpg, image/webp"
                                           required
                                           onchange="previewFile(this)" />

                                    <div id="uploadPrompt">
                                        <i class="bi bi-image text-muted display-4 mb-3 d-block"></i>
                                        <h6 class="fw-bold text-dark">Click hoặc kéo thả ảnh biên lai vào đây</h6>
                                        <p class="text-muted small mb-0">Hỗ trợ JPG, PNG, WEBP. Tối đa 5MB.</p>
                                    </div>

                                    <img id="billPreview" class="img-fluid w-100 mt-2" />
                                </div>

                                <button type="submit"
                                        class="btn btn-dark btn-lg fw-bold rounded-pill w-100 shadow-sm"
                                        id="btnSubmit"
                                        disabled>
                                    <i class="bi bi-send-check me-2"></i>
                                    XÁC NHẬN ĐÃ CHUYỂN TIỀN
                                </button>
                            </form>

                            <a href="/Payment/History" class="btn btn-outline-secondary back-history-btn mt-3">
                                <i class="bi bi-clock-history me-1"></i>
                                Quay lại lịch sử giao dịch
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const expireAtText = '@expireAt.ToString("yyyy-MM-ddTHH:mm:ss")';
        const expireAt = new Date(expireAtText).getTime();
        const baseCode = '@baseCode';

        let alreadyExpired = false;

        function copyText(elementId) {
            const el = document.getElementById(elementId);

            if (!el) {
                return;
            }

            const text = el.innerText;

            navigator.clipboard.writeText(text).then(function () {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Đã sao chép!',
                    showConfirmButton: false,
                    timer: 1500
                });
            });
        }

        function previewFile(input) {
            const file = input.files[0];
            const preview = document.getElementById('billPreview');
            const prompt = document.getElementById('uploadPrompt');
            const btnSubmit = document.getElementById('btnSubmit');

            if (alreadyExpired) {
                input.value = "";
                return;
            }

            if (file) {
                const allowedTypes = ['image/png', 'image/jpeg', 'image/jpg', 'image/webp'];

                if (!allowedTypes.includes(file.type)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'File không hợp lệ',
                        text: 'Chỉ chấp nhận ảnh JPG, PNG hoặc WEBP.'
                    });

                    input.value = "";
                    preview.src = "";
                    preview.style.display = 'none';
                    prompt.style.display = 'block';
                    btnSubmit.disabled = true;
                    btnSubmit.classList.remove('btn-primary');
                    btnSubmit.classList.add('btn-dark');

                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Ảnh quá lớn',
                        text: 'Ảnh biên lai tối đa 5MB.'
                    });

                    input.value = "";
                    preview.src = "";
                    preview.style.display = 'none';
                    prompt.style.display = 'block';
                    btnSubmit.disabled = true;
                    btnSubmit.classList.remove('btn-primary');
                    btnSubmit.classList.add('btn-dark');

                    return;
                }

                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    prompt.style.display = 'none';

                    btnSubmit.disabled = false;
                    btnSubmit.classList.remove('btn-dark');
                    btnSubmit.classList.add('btn-primary');
                };

                reader.readAsDataURL(file);
            } else {
                preview.src = "";
                preview.style.display = 'none';
                prompt.style.display = 'block';

                btnSubmit.disabled = true;
                btnSubmit.classList.remove('btn-primary');
                btnSubmit.classList.add('btn-dark');
            }
        }

        function lockExpiredUI() {
            alreadyExpired = true;

            const timer = document.getElementById('countdownTimer');
            const countdownBox = document.getElementById('countdownBox');
            const expiredPanel = document.getElementById('expiredPanel');
            const dropZone = document.getElementById('dropZone');
            const billInput = document.getElementById('billInput');
            const btnSubmit = document.getElementById('btnSubmit');
            const qrWrapper = document.getElementById('qrWrapper');

            if (timer) {
                timer.innerText = '00:00';
                timer.classList.add('countdown-danger');
            }

            if (countdownBox) {
                countdownBox.classList.add('bg-danger');
            }

            if (expiredPanel) {
                expiredPanel.style.display = 'block';
            }

            if (dropZone) {
                dropZone.classList.add('disabled');
            }

            if (billInput) {
                billInput.disabled = true;
                billInput.value = "";
            }

            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.classList.remove('btn-primary');
                btnSubmit.classList.add('btn-dark');
                btnSubmit.innerHTML = '<i class="bi bi-lock-fill me-2"></i> ĐƠN HÀNG ĐÃ HẾT HẠN';
            }

            if (qrWrapper) {
                qrWrapper.style.opacity = '.45';
            }
        }

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = expireAt - now;

            const timer = document.getElementById('countdownTimer');

            if (distance <= 0) {
                lockExpiredUI();

                if (!window.__closingPayment) {
                    window.__closingPayment = true;

                    Swal.fire({
                        icon: 'warning',
                        title: 'Đơn hàng đã hết hạn',
                        text: 'Hệ thống sẽ hủy giao dịch chưa thanh toán và chuyển về lịch sử.',
                        confirmButtonText: 'Đã hiểu',
                        timer: 2500,
                        timerProgressBar: true
                    }).then(() => {
                        window.location.href = '/Payment/CloseExpiredPayment?baseCode=' + encodeURIComponent(baseCode);
                    });
                }

                return;
            }

            const minutes = Math.floor(distance / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            const text =
                String(minutes).padStart(2, '0') +
                ':' +
                String(seconds).padStart(2, '0');

            if (timer) {
                timer.innerText = text;

                if (distance <= 2 * 60 * 1000) {
                    timer.classList.add('countdown-danger');
                }
            }
        }

        const dropZone = document.getElementById('dropZone');
        const billInput = document.getElementById('billInput');
        const uploadForm = document.getElementById('uploadForm');

        if (dropZone && billInput) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, preventDefaults, false);
            });

            function preventDefaults(e) {
                e.preventDefault();
                e.stopPropagation();
            }

            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, function () {
                    if (!alreadyExpired) {
                        dropZone.classList.add('dragover');
                    }
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, function () {
                    dropZone.classList.remove('dragover');
                }, false);
            });

            dropZone.addEventListener('drop', function (e) {
                if (alreadyExpired) {
                    return;
                }

                let dt = e.dataTransfer;
                let files = dt.files;

                billInput.files = files;
                previewFile(billInput);
            });
        }

        if (uploadForm) {
            uploadForm.addEventListener('submit', function (e) {
                const now = new Date().getTime();

                if (now >= expireAt || alreadyExpired) {
                    e.preventDefault();
                    lockExpiredUI();

                    Swal.fire({
                        icon: 'error',
                        title: 'Đơn hàng đã hết hạn',
                        text: 'Bạn không thể gửi biên lai cho giao dịch đã quá thời gian thanh toán.'
                    }).then(() => {
                        window.location.href = '/Payment/CloseExpiredPayment?baseCode=' + encodeURIComponent(baseCode);
                    });

                    return;
                }

                const file = billInput.files[0];

                if (!file) {
                    e.preventDefault();

                    Swal.fire({
                        icon: 'warning',
                        title: 'Chưa chọn biên lai',
                        text: 'Vui lòng tải ảnh biên lai trước khi xác nhận.'
                    });

                    return;
                }
            });
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    </script>
}