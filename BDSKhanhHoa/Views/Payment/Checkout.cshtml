@model IEnumerable<BDSKhanhHoa.Models.PostServicePackage>
@{
    ViewData["Title"] = "Thanh toán dịch vụ & Giỏ hàng";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var allPackagesJson = System.Text.Json.JsonSerializer.Serialize(Model.Select(p => new { p.PackageID, p.PackageName, p.Price, p.DurationDays }));
}

<!-- Đồ án: Website kinh doanh Bất động sản tại tỉnh Khánh Hòa tích hợp Chatbot AI hỗ trợ tư vấn -->
<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        --glass-bg: rgba(255, 255, 255, 0.95);
        --glass-shadow: 0 10px 40px 0 rgba(37, 99, 235, 0.08);
    }

    body {
        background-color: #f8fafc;
    }

    .cart-item {
        border: 1px solid #f1f5f9;
        border-radius: 16px;
        padding: 20px;
        background: white;
        transition: all 0.3s ease;
        margin-bottom: 15px;
    }

        .cart-item:hover {
            box-shadow: 0 8px 25px rgba(0,0,0,0.04);
            border-color: #e2e8f0;
        }

    .qty-wrapper {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        padding: 4px;
    }

    .qty-btn {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        border: none;
        background: white;
        color: #475569;
        font-weight: bold;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
    }

        .qty-btn:hover {
            background: #e2e8f0;
        }

    .qty-input {
        width: 45px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 800;
        color: #0f172a;
        outline: none;
    }

    .payment-option {
        display: none;
    }

    .payment-card {
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        padding: 18px;
        cursor: pointer;
        transition: 0.3s;
        background: white;
        display: flex;
        align-items: center;
        position: relative;
    }

        .payment-card:hover {
            border-color: #cbd5e1;
            transform: translateY(-2px);
        }

    .payment-option:checked + .payment-card {
        border-color: #3b82f6;
        background: #eff6ff;
        box-shadow: 0 8px 20px rgba(59, 130, 246, 0.1);
    }

        .payment-option:checked + .payment-card::before {
            content: '\F26A';
            font-family: "bootstrap-icons";
            position: absolute;
            right: 20px;
            color: #3b82f6;
            font-size: 1.5rem;
            font-weight: bold;
        }

    .order-summary-card {
        background: var(--primary-gradient);
        border-radius: 24px;
        color: white;
        padding: 35px;
        position: sticky;
        top: 100px;
        box-shadow: 0 20px 40px rgba(37, 99, 235, 0.2);
    }

    .btn-remove {
        color: #ef4444;
        background: #fef2f2;
        border: none;
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: bold;
        transition: 0.2s;
    }

        .btn-remove:hover {
            background: #fee2e2;
            color: #dc2626;
        }
</style>

<div class="container my-5">
    <div class="d-flex align-items-center justify-content-between mb-5">
        <div class="d-flex align-items-center">
            <a href="/Package/Buy" class="btn btn-white border rounded-circle shadow-sm me-4 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;"><i class="bi bi-arrow-left fs-5 text-dark"></i></a>
            <div>
                <h2 class="fw-black text-dark mb-1" style="font-size: 2rem;">Giỏ hàng & Thanh toán</h2>
                <p class="text-muted mb-0">Hệ thống hỗ trợ nạp trực tiếp, không qua ví nội bộ để đảm bảo an toàn giao dịch.</p>
            </div>
        </div>
    </div>

    <form asp-action="ProcessPayment" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="cartData" id="cartData" value="" />
        <input type="hidden" name="voucherCode" id="hiddenVoucherCode" value="" />

        <div class="row g-5">
            <div class="col-xl-7 col-lg-7">
                <!-- Danh sách sản phẩm trong giỏ -->
                <div class="card border-0 rounded-4 p-4 mb-4" style="background: var(--glass-bg); box-shadow: var(--glass-shadow);">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cart3 text-primary me-2"></i> Sản phẩm đã chọn</h5>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearCart()"><i class="bi bi-trash"></i> Xóa tất cả</button>
                    </div>

                    <div id="cartItemsContainer">
                        <!-- Render qua JS -->
                    </div>
                    <div id="emptyCartMessage" class="text-center py-5" style="display: none;">
                        <i class="bi bi-cart-x display-1 text-muted opacity-25"></i>
                        <h5 class="mt-3 fw-bold text-muted">Giỏ hàng trống</h5>
                        <a href="/Package/Buy" class="btn btn-primary mt-2 rounded-pill px-4">Quay lại chọn gói</a>
                    </div>
                </div>

                <!-- Phương thức thanh toán -->
                <div class="card border-0 rounded-4 p-4" style="background: var(--glass-bg); box-shadow: var(--glass-shadow);">
                    <h5 class="fw-bold mb-4 text-dark"><i class="bi bi-wallet2 text-success me-2"></i> Chọn cổng thanh toán</h5>
                    <div class="d-flex flex-column gap-3">
                        <label>
                            <input class="payment-option" type="radio" name="paymentMethod" value="VNPay" checked>
                            <div class="payment-card">
                                <img src="https://vnpay.vn/wp-content/uploads/2020/07/Logo-VNPAYQR-update.png" height="30" class="me-4" />
                                <div><h6 class="fw-bold mb-1 text-dark">VNPay</h6><small class="text-muted">Quét mã QR qua ứng dụng ngân hàng</small></div>
                            </div>
                        </label>
                        <label>
                            <input class="payment-option" type="radio" name="paymentMethod" value="PayOS">
                            <div class="payment-card">
                                <img src="https://payos.vn/wp-content/uploads/sites/13/2023/07/payos-logo.svg" height="25" class="me-4" />
                                <div><h6 class="fw-bold mb-1 text-dark">PayOS (VietQR)</h6><small class="text-muted">Chuyển khoản chính xác số tiền tự động</small></div>
                            </div>
                        </label>
                        <label>
                            <input class="payment-option" type="radio" name="paymentMethod" value="SePay">
                            <div class="payment-card">
                                <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 40px; height: 40px;"><i class="bi bi-lightning-charge-fill text-warning fs-5"></i></div>
                                <div><h6 class="fw-bold mb-1 text-dark">Chuyển khoản tự động (SePay)</h6><small class="text-muted">Duyệt nhanh 24/7 qua Webhook</small></div>
                            </div>
                        </label>
                        <label>
                            <input class="payment-option" type="radio" name="paymentMethod" value="BankTransfer">
                            <div class="payment-card">
                                <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 40px; height: 40px;"><i class="bi bi-bank fs-5 text-secondary"></i></div>
                                <div><h6 class="fw-bold mb-1 text-dark">Chuyển khoản thủ công</h6><small class="text-muted">Tải biên lai, chờ Admin duyệt</small></div>
                            </div>
                        </label>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded-3 d-flex align-items-start gap-2">
                        <i class="bi bi-shield-check text-success fs-4"></i>
                        <small class="text-muted mt-1">Để đảm bảo an toàn và bảo mật thông tin, hệ thống <strong>không</strong> yêu cầu cung cấp thẻ CCCD hay giấy tờ cá nhân khác. Giao dịch được bảo vệ mã hóa.</small>
                    </div>
                </div>
            </div>

            <!-- Tổng quan -->
            <div class="col-xl-5 col-lg-5">
                <div class="order-summary-card">
                    <h4 class="fw-black mb-4">Tổng quan đơn hàng</h4>

                    <div class="d-flex justify-content-between mb-3 fs-6">
                        <span class="text-white-50">Tổng tiền sản phẩm:</span>
                        <strong class="fw-bold" id="displayTempTotal">0 đ</strong>
                    </div>

                    <div class="mb-4 pt-3 border-top border-light border-opacity-25">
                        <label class="form-label text-white-50 small mb-2 text-uppercase">Mã khuyến mãi</label>
                        <div class="input-group">
                            <input type="text" id="txtVoucher" class="form-control bg-white bg-opacity-10 text-white border-0" placeholder="Nhập mã...">
                            <button type="button" id="btnApplyVoucher" class="btn btn-light fw-bold px-3">Áp dụng</button>
                        </div>
                        <div id="voucherMessage" class="small mt-2 fw-medium"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-warning fs-5" id="discountRow" style="display:none !important;">
                        <span class="fw-bold"><i class="bi bi-tags me-2"></i>Đã giảm:</span>
                        <strong id="discountAmount" class="fw-black">-0 đ</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-end mt-4 pt-4 border-top border-light border-opacity-25">
                        <span class="text-white-50 fw-bold text-uppercase mb-1">Cần thanh toán</span>
                        <strong class="text-white" style="font-size: 2.5rem; line-height: 1; font-weight: 900;" id="finalPrice">0 <span class="fs-4">đ</span></strong>
                    </div>

                    <button type="submit" id="btnSubmitForm" class="btn btn-light w-100 btn-lg fw-bold rounded-pill shadow mt-5 py-3 text-primary fs-5">
                        <i class="bi bi-check-circle me-2"></i> TIẾN HÀNH THANH TOÁN
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const allPackages = @Html.Raw(allPackagesJson);
        const directPackageId = @(ViewBag.DirectPackageId != null ? ViewBag.DirectPackageId : "null");

        let cart = JSON.parse(localStorage.getItem('bds_cart')) || [];

        // Nếu người dùng click Mua Ngay từ trang trước
        if (directPackageId !== null) {
            const existingItem = cart.find(x => x.PackageId === directPackageId);
            if (existingItem) {
                existingItem.Quantity += 1;
            } else {
                cart.push({ PackageId: directPackageId, Quantity: 1 });
            }
            saveCart();
        }

        function saveCart() {
            localStorage.setItem('bds_cart', JSON.stringify(cart));
            renderCart();
        }

        function clearCart() {
            cart = [];
            saveCart();
        }

        function updateQty(id, delta) {
            const item = cart.find(x => x.PackageId === id);
            if (item) {
                item.Quantity += delta;
                if (item.Quantity < 1) item.Quantity = 1;
                saveCart();
            }
        }

        function removeItem(id) {
            cart = cart.filter(x => x.PackageId !== id);
            saveCart();
        }

        function renderCart() {
            const container = document.getElementById('cartItemsContainer');
            const emptyMsg = document.getElementById('emptyCartMessage');
            const btnSubmit = document.getElementById('btnSubmitForm');
            document.getElementById('cartData').value = JSON.stringify(cart);

            container.innerHTML = '';
            let totalOrigin = 0;

            if (cart.length === 0) {
                emptyMsg.style.display = 'block';
                btnSubmit.disabled = true;
                updatePrices(0, 0);
                return;
            }

            emptyMsg.style.display = 'none';
            btnSubmit.disabled = false;

            cart.forEach(item => {
                const pkg = allPackages.find(p => p.PackageID === item.PackageId);
                if(pkg) {
                    totalOrigin += pkg.Price * item.Quantity;
                    container.innerHTML += `
                        <div class="cart-item d-flex flex-wrap align-items-center justify-content-between">
                            <div class="mb-3 mb-md-0 d-flex flex-column">
                                <h6 class="fw-bold mb-1 text-dark">${pkg.PackageName}</h6>
                                <small class="text-muted"><i class="bi bi-clock-history"></i> ${pkg.DurationDays} ngày hiển thị</small>
                                <span class="text-primary fw-bold mt-1">${pkg.Price.toLocaleString('vi-VN')} đ / gói</span>
                            </div>
                            <div class="d-flex align-items-center gap-4">
                                <div class="qty-wrapper">
                                    <button type="button" class="qty-btn" onclick="updateQty(${item.PackageId}, -1)"><i class="bi bi-dash"></i></button>
                                    <input type="number" class="qty-input" value="${item.Quantity}" readonly>
                                    <button type="button" class="qty-btn" onclick="updateQty(${item.PackageId}, 1)"><i class="bi bi-plus"></i></button>
                                </div>
                                <button type="button" class="btn-remove" onclick="removeItem(${item.PackageId})"><i class="bi bi-x-lg"></i></button>
                            </div>
                        </div>
                    `;
                }
            });

            // Khi cập nhật giỏ hàng, cần check lại voucher nếu đang có
            recheckVoucher(totalOrigin);
        }

        function updatePrices(totalOrigin, discount) {
            let final = totalOrigin - discount;
            if(final < 0) final = 0;
            document.getElementById('displayTempTotal').innerText = totalOrigin.toLocaleString('vi-VN') + ' đ';
            document.getElementById('finalPrice').innerHTML = final.toLocaleString('vi-VN') + ' <span class="fs-4">đ</span>';
        }

        function recheckVoucher(totalOrigin) {
            let code = document.getElementById('txtVoucher').value.trim();
            if(code !== '' && cart.length > 0) { applyVoucherLogic(code); }
            else {
                updatePrices(totalOrigin, 0);
                document.getElementById('discountRow').style.setProperty('display', 'none', 'important');
            }
        }

        document.getElementById('btnApplyVoucher').addEventListener('click', () => {
            let code = document.getElementById('txtVoucher').value.trim();
            if (code === '') { document.getElementById('voucherMessage').innerHTML = '<span class="text-white-50">Vui lòng nhập mã!</span>'; return; }
            if (cart.length === 0) { document.getElementById('voucherMessage').innerHTML = '<span class="text-white-50">Giỏ hàng trống!</span>'; return; }

            document.getElementById('btnApplyVoucher').innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            applyVoucherLogic(code);
        });

        function applyVoucherLogic(code) {
            fetch('/Payment/ApplyVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Code: code, CartData: JSON.stringify(cart) })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('btnApplyVoucher').innerText = 'Áp dụng';
                const msgBox = document.getElementById('voucherMessage');
                const discountRow = document.getElementById('discountRow');

                if (data.success) {
                    msgBox.innerHTML = `<span class="text-warning"><i class="bi bi-check-circle-fill"></i> ${data.message}</span>`;
                    document.getElementById('hiddenVoucherCode').value = code;
                    if(data.discountAmount > 0) {
                        discountRow.style.setProperty('display', 'flex', 'important');
                        document.getElementById('discountAmount').innerText = '-' + data.discountAmount.toLocaleString('vi-VN') + ' đ';
                    }
                    document.getElementById('finalPrice').innerHTML = data.finalPrice.toLocaleString('vi-VN') + ' <span class="fs-4">đ</span>';
                } else {
                    msgBox.innerHTML = `<span class="text-danger bg-white px-2 py-1 rounded"><i class="bi bi-x-circle-fill"></i> ${data.message}</span>`;
                    document.getElementById('hiddenVoucherCode').value = '';
                    discountRow.style.setProperty('display', 'none', 'important');
                    // Reset price
                    let total = 0;
                    cart.forEach(i => { const p = allPackages.find(x => x.PackageID === i.PackageId); if(p) total += p.Price * i.Quantity; });
                    updatePrices(total, 0);
                }
            }).catch(err => { console.error(err); document.getElementById('btnApplyVoucher').innerText = 'Áp dụng'; });
        }

        // Khởi tạo ban đầu
        renderCart();

        // Khi form submit thành công, xóa giỏ hàng
        document.getElementById('checkoutForm').addEventListener('submit', function() {
            if(cart.length > 0) { localStorage.removeItem('bds_cart'); }
        });
    </script>
}