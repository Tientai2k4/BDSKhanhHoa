@model IEnumerable<BDSKhanhHoa.Models.PostServicePackage>
@{
    ViewData["Title"] = "Thanh toán dịch vụ & Giỏ hàng";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // Chỉ cho phép thanh toán các gói còn đang mở bán.
    // Nếu Admin ngừng dùng gói thì gói đó không được đưa sang JS/giỏ hàng nữa.
    var activePackages = Model?
        .Where(p => p.IsActive)
        .OrderBy(p => p.PriorityLevel)
        .ThenBy(p => p.Price)
        .ToList() ?? new List<BDSKhanhHoa.Models.PostServicePackage>();

    var allPackagesJson = System.Text.Json.JsonSerializer.Serialize(
        activePackages.Select(p => new
        {
            p.PackageID,
            p.PackageName,
            p.PackageType,
            p.Price,
            p.DurationDays,
            p.PriorityLevel,
            p.IsActive
        })
    );
}

<style>
    :root {
        --checkout-primary: #2563eb;
        --checkout-primary-2: #3b82f6;
        --checkout-bg: #f8fafc;
        --checkout-card: rgba(255, 255, 255, 0.96);
        --checkout-border: #e2e8f0;
        --checkout-muted: #64748b;
        --checkout-dark: #0f172a;
        --checkout-shadow: 0 14px 45px rgba(15, 23, 42, 0.08);
        --checkout-blue-shadow: 0 20px 45px rgba(37, 99, 235, 0.22);
        --checkout-radius: 22px;
        --primary-gradient: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
    }

    body {
        background: var(--checkout-bg);
    }

    .checkout-header {
        gap: 18px;
    }

    .checkout-back-btn {
        width: 50px;
        height: 50px;
        border-radius: 999px;
        background: #ffffff;
        border: 1px solid var(--checkout-border);
        box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--checkout-dark);
        flex: 0 0 auto;
    }

        .checkout-back-btn:hover {
            background: #f1f5f9;
            color: var(--checkout-primary);
        }

    .checkout-title {
        font-size: 2rem;
        font-weight: 900;
        color: var(--checkout-dark);
        margin-bottom: 4px;
        letter-spacing: -0.03em;
    }

    .checkout-subtitle {
        color: var(--checkout-muted);
        margin-bottom: 0;
    }

    .checkout-panel {
        background: var(--checkout-card);
        border: 1px solid rgba(226, 232, 240, 0.75);
        border-radius: var(--checkout-radius);
        box-shadow: var(--checkout-shadow);
        padding: 26px;
    }

    .checkout-panel-title {
        font-size: 1.08rem;
        font-weight: 800;
        color: var(--checkout-dark);
        margin-bottom: 0;
    }

    .cart-item {
        border: 1px solid #eef2f7;
        border-radius: 18px;
        padding: 18px;
        background: #ffffff;
        transition: all 0.25s ease;
        margin-bottom: 14px;
    }

        .cart-item:hover {
            box-shadow: 0 10px 26px rgba(15, 23, 42, 0.06);
            border-color: #dbe4f0;
        }

    .qty-wrapper {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        padding: 4px;
    }

    .qty-btn {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        border: none;
        background: #ffffff;
        color: #475569;
        font-weight: 800;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .qty-btn:hover {
            background: #e2e8f0;
            color: var(--checkout-dark);
        }

    .qty-input {
        width: 46px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 900;
        color: var(--checkout-dark);
        outline: none;
    }

    .btn-remove {
        color: #ef4444;
        background: #fef2f2;
        border: none;
        border-radius: 12px;
        padding: 8px 12px;
        font-size: 0.85rem;
        font-weight: 800;
        transition: 0.2s;
    }

        .btn-remove:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    .payment-list {
        display: grid;
        gap: 14px;
    }

    .payment-label {
        display: block;
        margin: 0;
    }

    .payment-option {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .payment-card {
        border: 2px solid #e2e8f0;
        border-radius: 18px;
        padding: 16px 18px;
        cursor: pointer;
        transition: all 0.25s ease;
        background: #ffffff;
        display: flex;
        align-items: center;
        gap: 16px;
        position: relative;
        overflow: hidden;
        min-height: 82px;
    }

        .payment-card:hover {
            border-color: #bfdbfe;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, 0.08);
        }

    .payment-option:checked + .payment-card {
        border-color: var(--checkout-primary-2);
        background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
        box-shadow: 0 12px 30px rgba(59, 130, 246, 0.14);
    }

        .payment-option:checked + .payment-card::after {
            content: "\F26A";
            font-family: "bootstrap-icons";
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--checkout-primary);
            font-size: 1.45rem;
            font-weight: 900;
        }

    .payment-logo-box {
        width: 92px;
        height: 46px;
        border-radius: 14px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 92px;
        overflow: hidden;
        position: relative;
    }

    .payment-logo-img {
        max-width: 78px;
        max-height: 32px;
        object-fit: contain;
        display: block;
    }

    .payment-logo-fallback {
        font-size: 0.78rem;
        font-weight: 900;
        color: var(--checkout-primary);
        letter-spacing: 0.02em;
        text-align: center;
        line-height: 1.1;
        display: none;
        padding: 0 6px;
    }

    .payment-logo-box.logo-error .payment-logo-img {
        display: none;
    }

    .payment-logo-box.logo-error .payment-logo-fallback {
        display: block;
    }

    .payment-info {
        min-width: 0;
        padding-right: 35px;
    }

    .payment-name {
        font-size: 1rem;
        font-weight: 850;
        color: var(--checkout-dark);
        margin-bottom: 4px;
    }

    .payment-desc {
        color: var(--checkout-muted);
        font-size: 0.9rem;
        line-height: 1.35;
    }

    .secure-note {
        margin-top: 22px;
        padding: 15px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .order-summary-card {
        background: var(--primary-gradient);
        border-radius: 26px;
        color: white;
        padding: 34px;
        position: sticky;
        top: 100px;
        box-shadow: var(--checkout-blue-shadow);
        overflow: hidden;
    }

        .order-summary-card::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            right: -90px;
            top: -90px;
        }

        .order-summary-card > * {
            position: relative;
            z-index: 1;
        }

    .summary-title {
        font-size: 1.35rem;
        font-weight: 900;
        margin-bottom: 24px;
    }

    .voucher-input {
        color: #ffffff !important;
    }

        .voucher-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

    .final-price {
        font-size: 2.45rem;
        line-height: 1;
        font-weight: 950;
        letter-spacing: -0.04em;
    }

    .checkout-submit-btn {
        border-radius: 999px;
        padding: 15px 20px;
        font-size: 1.05rem;
        font-weight: 900;
    }

        .checkout-submit-btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    @@media (max-width: 991.98px) {
        .order-summary-card {
            position: static;
            margin-top: 4px;
        }
    }

    @@media (max-width: 767.98px) {
        .container.my-5 {
            margin-top: 24px !important;
            margin-bottom: 34px !important;
        }

        .checkout-header {
            align-items: flex-start !important;
            margin-bottom: 28px !important;
        }

        .checkout-title {
            font-size: 1.45rem;
            line-height: 1.2;
        }

        .checkout-subtitle {
            font-size: 0.92rem;
        }

        .checkout-back-btn {
            width: 44px;
            height: 44px;
        }

        .checkout-panel {
            padding: 18px;
            border-radius: 20px;
        }

        .cart-item {
            padding: 15px;
        }

            .cart-item .cart-actions {
                width: 100%;
                justify-content: space-between;
                gap: 12px !important;
                margin-top: 12px;
            }

        .payment-card {
            padding: 14px;
            gap: 12px;
            min-height: 78px;
        }

        .payment-logo-box {
            width: 76px;
            height: 42px;
            flex-basis: 76px;
            border-radius: 12px;
        }

        .payment-logo-img {
            max-width: 62px;
            max-height: 28px;
        }

        .payment-name {
            font-size: 0.96rem;
        }

        .payment-desc {
            font-size: 0.84rem;
        }

        .payment-option:checked + .payment-card::after {
            right: 12px;
            font-size: 1.25rem;
        }

        .payment-info {
            padding-right: 28px;
        }

        .order-summary-card {
            padding: 24px;
            border-radius: 22px;
        }

        .final-price {
            font-size: 2rem;
        }
    }
</style>

<div class="container my-5">
    <div class="d-flex align-items-center justify-content-between mb-5 checkout-header">
        <div class="d-flex align-items-center checkout-header">
            <a href="/Package/Buy" class="checkout-back-btn" aria-label="Quay lại chọn gói">
                <i class="bi bi-arrow-left fs-5"></i>
            </a>

            <div>
                <h2 class="checkout-title">Giỏ hàng & Thanh toán</h2>
                <p class="checkout-subtitle">
                    Hệ thống hỗ trợ nạp trực tiếp, không qua ví nội bộ để đảm bảo an toàn giao dịch.
                </p>
            </div>
        </div>
    </div>

    <form asp-action="ProcessPayment" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <input type="hidden" name="cartData" id="cartData" value="" />
        <input type="hidden" name="voucherCode" id="hiddenVoucherCode" value="" />

        <div class="row g-4 g-lg-5">
            <div class="col-xl-7 col-lg-7">
                <div class="checkout-panel mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
                        <h5 class="checkout-panel-title">
                            <i class="bi bi-cart3 text-primary me-2"></i>
                            Sản phẩm đã chọn
                        </h5>

                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="clearCart()">
                            <i class="bi bi-trash me-1"></i>
                            Xóa tất cả
                        </button>
                    </div>

                    <div id="cartItemsContainer"></div>

                    <div id="emptyCartMessage" class="text-center py-5" style="display: none;">
                        <i class="bi bi-cart-x display-1 text-muted opacity-25"></i>
                        <h5 class="mt-3 fw-bold text-muted">Giỏ hàng trống</h5>
                        <a href="/Package/Buy" class="btn btn-primary mt-2 rounded-pill px-4">
                            Quay lại chọn gói
                        </a>
                    </div>
                </div>

                <div class="checkout-panel">
                    <h5 class="checkout-panel-title mb-4">
                        <i class="bi bi-wallet2 text-success me-2"></i>
                        Chọn cổng thanh toán
                    </h5>

                    <div class="payment-list">
                        <label class="payment-label">
                            <input class="payment-option" type="radio" name="paymentMethod" value="VNPay" />
                            <div class="payment-card">
                                <div class="payment-logo-box">
                                    <img src="@Url.Content("~/images/payments/vnpay.png")"
                                         alt="VNPay"
                                         class="payment-logo-img"
                                         onerror="this.closest('.payment-logo-box').classList.add('logo-error');" />
                                    <span class="payment-logo-fallback">VNPAY</span>
                                </div>

                                <div class="payment-info">
                                    <div class="payment-name">VNPay</div>
                                    <div class="payment-desc">Quét mã QR qua ứng dụng ngân hàng, xử lý giao dịch nhanh và an toàn.</div>
                                </div>
                            </div>
                        </label>

                        <label class="payment-label">
                            <input class="payment-option" type="radio" name="paymentMethod" value="PayOS" />
                            <div class="payment-card">
                                <div class="payment-logo-box">
                                    <img src="@Url.Content("~/images/payments/payos.png")"
                                         alt="PayOS"
                                         class="payment-logo-img"
                                         onerror="this.closest('.payment-logo-box').classList.add('logo-error');" />
                                    <span class="payment-logo-fallback">PayOS</span>
                                </div>

                                <div class="payment-info">
                                    <div class="payment-name">PayOS / VietQR</div>
                                    <div class="payment-desc">Chuyển khoản đúng số tiền, đúng nội dung, hỗ trợ xác nhận tự động.</div>
                                </div>
                            </div>
                        </label>

                        <label class="payment-label">
                            <input class="payment-option" type="radio" name="paymentMethod" value="SePay" />
                            <div class="payment-card">
                                <div class="payment-logo-box">
                                    <img src="@Url.Content("~/images/payments/sepay.png")"
                                         alt="SePay"
                                         class="payment-logo-img"
                                         onerror="this.closest('.payment-logo-box').classList.add('logo-error');" />
                                    <span class="payment-logo-fallback">SePay</span>
                                </div>

                                <div class="payment-info">
                                    <div class="payment-name">Chuyển khoản tự động SePay</div>
                                    <div class="payment-desc">Theo dõi giao dịch qua webhook, phù hợp môi trường demo và vận hành 24/7.</div>
                                </div>
                            </div>
                        </label>

                        <label class="payment-label">
                            <input class="payment-option" type="radio" name="paymentMethod" value="BankTransfer" checked />
                            <div class="payment-card">
                                <div class="payment-logo-box">
                                    <img src="@Url.Content("~/images/payments/bank-transfer.png")"
                                         alt="Chuyển khoản ngân hàng"
                                         class="payment-logo-img"
                                         onerror="this.closest('.payment-logo-box').classList.add('logo-error');" />
                                    <span class="payment-logo-fallback">
                                        <i class="bi bi-bank d-block fs-5"></i>
                                        BANK
                                    </span>
                                </div>

                                <div class="payment-info">
                                    <div class="payment-name">Chuyển khoản thủ công</div>
                                    <div class="payment-desc">Người dùng tải biên lai, Admin kiểm tra và duyệt thanh toán.</div>
                                </div>
                            </div>
                        </label>
                    </div>

                    <div class="secure-note">
                        <i class="bi bi-shield-check text-success fs-4"></i>
                        <small class="text-muted mt-1">
                            Để đảm bảo an toàn và bảo mật thông tin, hệ thống
                            <strong>không</strong> yêu cầu cung cấp thẻ CCCD hay giấy tờ cá nhân khác.
                            Giao dịch được bảo vệ bằng mã hóa.
                        </small>
                    </div>
                </div>
            </div>

            <div class="col-xl-5 col-lg-5">
                <div class="order-summary-card">
                    <h4 class="summary-title">Tổng quan đơn hàng</h4>

                    <div class="d-flex justify-content-between mb-3 fs-6">
                        <span class="text-white-50">Tổng tiền sản phẩm:</span>
                        <strong class="fw-bold" id="displayTempTotal">0 đ</strong>
                    </div>

                    <div class="mb-4 pt-3 border-top border-light border-opacity-25">
                        <label class="form-label text-white-50 small mb-2 text-uppercase fw-bold">
                            Mã khuyến mãi
                        </label>

                        <div class="input-group">
                            <input type="text"
                                   id="txtVoucher"
                                   class="form-control bg-white bg-opacity-10 voucher-input border-0"
                                   placeholder="Nhập mã..." />

                            <button type="button" id="btnApplyVoucher" class="btn btn-light fw-bold px-3">
                                Áp dụng
                            </button>
                        </div>

                        <div id="voucherMessage" class="small mt-2 fw-medium"></div>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-warning fs-5" id="discountRow" style="display:none !important;">
                        <span class="fw-bold">
                            <i class="bi bi-tags me-2"></i>
                            Đã giảm:
                        </span>
                        <strong id="discountAmount" class="fw-black">-0 đ</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-end mt-4 pt-4 border-top border-light border-opacity-25">
                        <span class="text-white-50 fw-bold text-uppercase mb-1">Cần thanh toán</span>
                        <strong class="text-white final-price" id="finalPrice">
                            0 <span class="fs-4">đ</span>
                        </strong>
                    </div>

                    <button type="submit"
                            id="btnSubmitForm"
                            class="btn btn-light w-100 btn-lg shadow mt-5 text-primary checkout-submit-btn">
                        <i class="bi bi-check-circle me-2"></i>
                        TIẾN HÀNH THANH TOÁN
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const allPackages = @Html.Raw(allPackagesJson);
        const directPackageId = Number('@(ViewBag.DirectPackageId ?? 0)');
        const activePackageIds = new Set(allPackages.map(x => Number(x.PackageID)));

        let cart = [];

        try {
            cart = JSON.parse(localStorage.getItem('bds_cart')) || [];
        } catch {
            cart = [];
        }

        // Nếu người dùng bấm mua trực tiếp từ trang bảng giá:
        // /Payment/Checkout?packageId=...
        // thì chỉ lấy đúng gói đó, không cộng dồn lung tung với giỏ cũ.
        if (directPackageId > 0 && activePackageIds.has(directPackageId)) {
            cart = [
                {
                    PackageId: directPackageId,
                    Quantity: 1
                }
            ];
        } else {
            // Nếu không mua trực tiếp thì giữ giỏ cũ, nhưng loại gói đã ngừng dùng/xóa.
            cart = cart
                .filter(x => activePackageIds.has(Number(x.PackageId)))
                .map(x => ({
                    PackageId: Number(x.PackageId),
                    Quantity: Math.max(1, Number(x.Quantity || 1))
                }));
        }

        localStorage.setItem('bds_cart', JSON.stringify(cart));

        function saveCart() {
            localStorage.setItem('bds_cart', JSON.stringify(cart));
            renderCart();
        }

        function clearCart() {
            cart = [];
            saveCart();
        }

        function updateQty(id, delta) {
            id = Number(id);
            const item = cart.find(x => Number(x.PackageId) === id);

            if (item) {
                item.Quantity += delta;

                if (item.Quantity < 1) {
                    item.Quantity = 1;
                }

                saveCart();
            }
        }

        function removeItem(id) {
            id = Number(id);
            cart = cart.filter(x => Number(x.PackageId) !== id);
            saveCart();
        }

        function renderCart() {
            const container = document.getElementById('cartItemsContainer');
            const emptyMsg = document.getElementById('emptyCartMessage');
            const btnSubmit = document.getElementById('btnSubmitForm');

            document.getElementById('cartData').value = JSON.stringify(cart);

            container.innerHTML = '';

            let totalOrigin = 0;

            if (cart.length === 0) {
                emptyMsg.style.display = 'block';
                btnSubmit.disabled = true;
                updatePrices(0, 0);
                return;
            }

            emptyMsg.style.display = 'none';
            btnSubmit.disabled = false;

            cart.forEach(item => {
                const pkg = allPackages.find(p => Number(p.PackageID) === Number(item.PackageId));

                if (pkg) {
                    totalOrigin += Number(pkg.Price) * Number(item.Quantity);

                    container.innerHTML += `
                        <div class="cart-item d-flex flex-wrap align-items-center justify-content-between">
                            <div class="mb-2 mb-md-0 d-flex flex-column">
                                <h6 class="fw-bold mb-1 text-dark">${pkg.PackageName}</h6>
                                <small class="text-muted">
                                    <i class="bi bi-clock-history me-1"></i>
                                    ${pkg.DurationDays} ngày hiển thị
                                </small>
                                <span class="text-primary fw-bold mt-1">
                                    ${Number(pkg.Price).toLocaleString('vi-VN')} đ / gói
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-3 cart-actions">
                                <div class="qty-wrapper">
                                    <button type="button" class="qty-btn" onclick="updateQty(${item.PackageId}, -1)">
                                        <i class="bi bi-dash"></i>
                                    </button>

                                    <input type="number" class="qty-input" value="${item.Quantity}" readonly />

                                    <button type="button" class="qty-btn" onclick="updateQty(${item.PackageId}, 1)">
                                        <i class="bi bi-plus"></i>
                                    </button>
                                </div>

                                <button type="button" class="btn-remove" onclick="removeItem(${item.PackageId})">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    `;
                }
            });

            recheckVoucher(totalOrigin);
        }

        function updatePrices(totalOrigin, discount) {
            let final = totalOrigin - discount;

            if (final < 0) {
                final = 0;
            }

            document.getElementById('displayTempTotal').innerText =
                totalOrigin.toLocaleString('vi-VN') + ' đ';

            document.getElementById('finalPrice').innerHTML =
                final.toLocaleString('vi-VN') + ' <span class="fs-4">đ</span>';
        }

        function recheckVoucher(totalOrigin) {
            let code = document.getElementById('txtVoucher').value.trim();

            if (code !== '' && cart.length > 0) {
                applyVoucherLogic(code);
            } else {
                updatePrices(totalOrigin, 0);
                document.getElementById('discountRow').style.setProperty('display', 'none', 'important');
            }
        }

        document.getElementById('btnApplyVoucher').addEventListener('click', function () {
            let code = document.getElementById('txtVoucher').value.trim();

            if (code === '') {
                document.getElementById('voucherMessage').innerHTML =
                    '<span class="text-white-50">Vui lòng nhập mã!</span>';
                return;
            }

            if (cart.length === 0) {
                document.getElementById('voucherMessage').innerHTML =
                    '<span class="text-white-50">Giỏ hàng trống!</span>';
                return;
            }

            document.getElementById('btnApplyVoucher').innerHTML =
                '<span class="spinner-border spinner-border-sm"></span>';

            applyVoucherLogic(code);
        });

        function applyVoucherLogic(code) {
            fetch('/Payment/ApplyVoucher', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    Code: code,
                    CartData: JSON.stringify(cart)
                })
            })
            .then(res => res.json())
            .then(data => {
                document.getElementById('btnApplyVoucher').innerText = 'Áp dụng';

                const msgBox = document.getElementById('voucherMessage');
                const discountRow = document.getElementById('discountRow');

                if (data.success) {
                    msgBox.innerHTML = `
                        <span class="text-warning">
                            <i class="bi bi-check-circle-fill"></i>
                            ${data.message || 'Áp dụng mã thành công.'}
                        </span>
                    `;

                    document.getElementById('hiddenVoucherCode').value = code;

                    if (Number(data.discountAmount) > 0) {
                        discountRow.style.setProperty('display', 'flex', 'important');

                        document.getElementById('discountAmount').innerText =
                            '-' + Number(data.discountAmount).toLocaleString('vi-VN') + ' đ';
                    } else {
                        discountRow.style.setProperty('display', 'none', 'important');
                    }

                    document.getElementById('finalPrice').innerHTML =
                        Number(data.finalPrice).toLocaleString('vi-VN') + ' <span class="fs-4">đ</span>';
                } else {
                    msgBox.innerHTML = `
                        <span class="text-danger bg-white px-2 py-1 rounded">
                            <i class="bi bi-x-circle-fill"></i>
                            ${data.message}
                        </span>
                    `;

                    document.getElementById('hiddenVoucherCode').value = '';
                    discountRow.style.setProperty('display', 'none', 'important');

                    let total = 0;

                    cart.forEach(i => {
                        const p = allPackages.find(x => Number(x.PackageID) === Number(i.PackageId));

                        if (p) {
                            total += Number(p.Price) * Number(i.Quantity);
                        }
                    });

                    updatePrices(total, 0);
                }
            })
            .catch(err => {
                console.error(err);
                document.getElementById('btnApplyVoucher').innerText = 'Áp dụng';
                document.getElementById('voucherMessage').innerHTML =
                    '<span class="text-danger bg-white px-2 py-1 rounded">Không thể kiểm tra mã giảm giá.</span>';
            });
        }

        renderCart();

        document.getElementById('checkoutForm').addEventListener('submit', function (e) {
            cart = cart
                .filter(x => activePackageIds.has(Number(x.PackageId)))
                .map(x => ({
                    PackageId: Number(x.PackageId),
                    Quantity: Math.max(1, Number(x.Quantity || 1))
                }));

            document.getElementById('cartData').value = JSON.stringify(cart);

            if (cart.length === 0) {
                e.preventDefault();
                alert('Giỏ hàng trống hoặc gói đã ngừng sử dụng. Vui lòng chọn lại gói.');
                return;
            }

            const selectedPayment = document.querySelector('input[name="paymentMethod"]:checked');

            if (!selectedPayment) {
                e.preventDefault();
                alert('Vui lòng chọn phương thức thanh toán.');
                return;
            }

            localStorage.removeItem('bds_cart');
        });
    </script>
}