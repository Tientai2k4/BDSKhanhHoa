@model IEnumerable<BDSKhanhHoa.Models.Transaction>

@{
    ViewData["Title"] = "Lịch sử giao dịch";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var transactions = Model ?? Enumerable.Empty<BDSKhanhHoa.Models.Transaction>();

    var groupedTransactions = transactions
        .Where(t => !string.IsNullOrWhiteSpace(t.TransactionCode))
        .GroupBy(t => t.TransactionCode.Contains("_") ? t.TransactionCode.Split('_')[0] : t.TransactionCode)
        .OrderByDescending(g => g.First().CreatedAt)
        .ToList();

    int totalOrders = groupedTransactions.Count;

    int successOrders = groupedTransactions.Count(g =>
        g.Any(x => string.Equals(x.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase)));

    int pendingOrders = groupedTransactions.Count(g =>
        !g.Any(x => string.Equals(x.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase)) &&
         g.Any(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase)));

    decimal totalPaid = groupedTransactions
        .Where(g => g.Any(x => string.Equals(x.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                               string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase)))
        .Sum(g => g.Sum(x => x.Amount));

    string currentStatus = ViewBag.Status as string ?? "All";
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
}

@functions {
    public string GetOrderStatus(IEnumerable<BDSKhanhHoa.Models.Transaction> group)
    {
        var list = group?.ToList() ?? new List<BDSKhanhHoa.Models.Transaction>();

        if (list.Any(x => string.Equals(x.Status, "Success", StringComparison.OrdinalIgnoreCase) ||
                          string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase)))
        {
            return "Success";
        }

        if (list.Any(x => string.Equals(x.Status, "Pending", StringComparison.OrdinalIgnoreCase)))
        {
            return "Pending";
        }

        if (list.Any(x => string.Equals(x.Status, "Failed", StringComparison.OrdinalIgnoreCase)))
        {
            return "Failed";
        }

        if (list.Any(x => string.Equals(x.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)))
        {
            return "Cancelled";
        }

        return list.FirstOrDefault()?.Status ?? "";
    }

    public string StatusText(string? status)
    {
        return status switch
        {
            "Success" => "Thành công",
            "Completed" => "Hoàn tất",
            "Pending" => "Đang chờ",
            "Failed" => "Thất bại",
            "Cancelled" => "Đã hủy",
            null or "" => "Chưa xác định",
            _ => status
        };
    }

    public string StatusClass(string? status)
    {
        return status switch
        {
            "Success" => "status-success",
            "Completed" => "status-success",
            "Pending" => "status-pending",
            "Failed" => "status-danger",
            "Cancelled" => "status-muted",
            _ => "status-muted"
        };
    }

    public string StatusIcon(string? status)
    {
        return status switch
        {
            "Success" => "bi-check-circle-fill",
            "Completed" => "bi-check-circle-fill",
            "Pending" => "bi-hourglass-split",
            "Failed" => "bi-x-circle-fill",
            "Cancelled" => "bi-slash-circle-fill",
            _ => "bi-info-circle-fill"
        };
    }

    public string PaymentText(string? method)
    {
        return method switch
        {
            "VNPay" => "VNPay",
            "PayOS" => "PayOS / VietQR",
            "System Gift" => "Hệ thống tặng",
            "BankTransfer" => "Không sử dụng",
            "SePay" => "Không sử dụng",
            "Cash" => "Không sử dụng",
            null or "" => "Chưa xác định",
            _ => method
        };
    }
}

