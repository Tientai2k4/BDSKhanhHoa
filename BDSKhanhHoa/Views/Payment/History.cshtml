            text-align: left !important;
        }

        .order-total-label {
            font-size: .62rem !important;
        }

        .order-total-value {
            font-size: .9rem !important;
        }

        .status-pill {
            width: auto !important;
            min-height: 30px !important;
            padding: 0 9px !important;
            font-size: .68rem !important;
        }

        .collapse-toggle {
            width: 100% !important;
            grid-column: 1 / -1;
            height: 34px !important;
            border-radius: 11px !important;
        }

        .order-body {
            padding: 10px 11px 12px !important;
        }

        .order-section-title {
            font-size: .68rem !important;
            margin-bottom: 7px !important;
        }

        .item-row {
            padding: 9px !important;
            border-radius: 13px !important;
            gap: 6px !important;
        }

        .item-left {
            gap: 8px !important;
        }

        .item-icon {
            width: 33px !important;
            height: 33px !important;
            border-radius: 11px !important;
            font-size: .85rem !important;
        }

        .item-name {
            font-size: .8rem !important;
            line-height: 1.35 !important;
        }

        .item-desc {
            font-size: .7rem !important;
        }

        .item-price {
            padding-left: 41px !important;
            font-size: .82rem !important;
        }

        .order-footer {
            margin-top: 9px !important;
            padding-top: 9px !important;
            gap: 7px !important;
        }

        .invoice-btn,
        .receipt-btn {
            min-height: 36px !important;
            border-radius: 12px !important;
            font-size: .76rem !important;
        }
    }

</style>

<div class="container history-container">
    <div class="history-page">
        <section class="page-top">
            <div>
                <div class="page-kicker">
                    <i class="bi bi-clock-history"></i>
                    Trung tâm giao dịch
                </div>

                <h1 class="page-title">Lịch sử giao dịch</h1>

                <p class="page-subtitle">
                    Theo dõi trạng thái thanh toán, hóa đơn và các gói dịch vụ đã mua.
                </p>
            </div>

            <a href="/Package/Buy" class="btn-buy-more">
                <i class="bi bi-plus-circle-fill"></i>
                Đăng ký thêm gói
            </a>
        </section>

        <section class="summary-grid">
            <div class="summary-card">
                <div class="summary-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div>
                    <div class="summary-label">Tổng đơn</div>
                    <div class="summary-value">@totalOrders</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon" style="background:#ecfdf5;color:#059669;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="summary-label">Thành công</div>
                    <div class="summary-value">@successOrders</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon" style="background:#fffbeb;color:#d97706;">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="summary-label">Đang chờ</div>
                    <div class="summary-value">@pendingOrders</div>
                </div>
            </div>

            <div class="summary-card">
                <div class="summary-icon" style="background:#fef2f2;color:#dc2626;">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="summary-label">Đã thanh toán</div>
                    <div class="summary-value">@totalPaid.ToString("N0") đ</div>
                </div>
            </div>
        </section>

        <details class="filter-card filter-history-details" open>
            <summary class="filter-history-summary">
                <span>
                    <i class="bi bi-funnel-fill"></i>
                    Bộ lọc giao dịch
                </span>
                <i class="bi bi-chevron-down filter-summary-arrow"></i>
            </summary>

            <form method="get" action="/Payment/History" class="row g-2 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label">
                        <i class="bi bi-activity me-1"></i>
                        Trạng thái
                    </label>
                    <select name="status" class="form-select">
                        <option value="All" selected="@(currentStatus == "All")">Tất cả trạng thái</option>
                        <option value="Success" selected="@(currentStatus == "Success")">Thành công</option>
                        <option value="Completed" selected="@(currentStatus == "Completed")">Hoàn tất</option>
                        <option value="Pending" selected="@(currentStatus == "Pending")">Đang chờ</option>
                        <option value="Failed" selected="@(currentStatus == "Failed")">Thất bại</option>
                        <option value="Cancelled" selected="@(currentStatus == "Cancelled")">Đã hủy / Quá hạn</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">
                        <i class="bi bi-calendar-minus me-1"></i>
                        Từ ngày
                    </label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label">
                        <i class="bi bi-calendar-plus me-1"></i>
                        Đến ngày
                    </label>
                    <input type="date" name="toDate" value="@toDate" class="form-control" />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label d-none d-md-block">&nbsp;</label>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark btn-filter flex-grow-1">
                            <i class="bi bi-funnel-fill me-1"></i>
                            Lọc
                        </button>

                        <a href="/Payment/History" class="btn btn-light border btn-reset" title="Xóa bộ lọc">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </details>

        @if (!groupedTransactions.Any())
        {
            <section class="empty-card">
                <div class="empty-icon">
                    <i class="bi bi-receipt"></i>
                </div>

                <h3 class="empty-title">Không tìm thấy đơn hàng</h3>

                <p class="empty-desc">
                    Chưa có giao dịch nào hoặc bộ lọc hiện tại không có kết quả phù hợp.
                </p>

                <a href="/Package/Buy" class="btn-buy-more d-inline-flex">
                    <i class="bi bi-bag-plus-fill"></i>
                    Xem bảng giá dịch vụ
                </a>
            </section>
        }
        else
        {
            <section class="history-list">
                @foreach (var group in groupedTransactions)
                {
                    var firstItem = group.First();
                    var totalOrderAmount = group.Sum(x => x.Amount);
                    var orderStatus = GetOrderStatus(group);
                    string orderCode = group.Key;
                    string collapseId = "collapse_" + orderCode.Replace("-", "_").Replace(".", "_").Replace(" ", "_").Replace("/", "_");

                    <article class="order-card">
                        <div class="order-header">
                            <div class="order-main">
                                <div class="order-code-line">
                                    <span class="order-code-label">Mã đơn</span>
                                    <span class="order-code">
                                        <i class="bi bi-hash"></i>
                                        @orderCode
                                    </span>
                                </div>

                                <div class="order-meta">
                                    <span>
                                        <i class="bi bi-calendar3"></i>
                                        @firstItem.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                                    </span>

                                    <span>
                                        <i class="bi bi-credit-card-2-front"></i>
                                        @PaymentText(firstItem.PaymentMethod)
                                    </span>

                                    <span>
                                        <i class="bi bi-box-seam"></i>
                                        @group.Count() sản phẩm
                                    </span>
                                </div>
                            </div>

                            <div class="order-side">
                                <div class="order-total">
                                    <span class="order-total-label">Tổng tiền</span>
                                    <span class="order-total-value">@totalOrderAmount.ToString("N0") đ</span>
                                </div>

                                <span class="status-pill @StatusClass(orderStatus)">
                                    <i class="bi @StatusIcon(orderStatus)"></i>
                                    @StatusText(orderStatus)
                                </span>

                                <button class="collapse-toggle"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="true"
                                        aria-controls="@collapseId"
                                        title="Ẩn / hiện chi tiết">
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                            </div>
                        </div>

                        <div class="collapse show" id="@collapseId">
                            <div class="order-body">
                                <h6 class="order-section-title">
                                    <i class="bi bi-list-check me-1"></i>
                                    Chi tiết gói dịch vụ
                                </h6>

                                <div class="order-items">
                                    @foreach (var item in group)
                                    {
                                        <div class="item-row">
                                            <div class="item-left">
                                                <div class="item-icon">
                                                    <i class="bi bi-box-seam"></i>
                                                </div>

                                                <div class="min-w-0">
                                                    <h6 class="item-name">@(item.Package?.PackageName ?? "Gói dịch vụ")</h6>
                                                    <p class="item-desc">
                                                        Mua @item.Quantity lượt
                                                        @if (!string.IsNullOrWhiteSpace(item.Package?.PackageType))
                                                        {
                                                            <span> • @item.Package.PackageType</span>
                                                        }
                                                    </p>
                                                </div>
                                            </div>

                                            <div class="item-price">
                                                @item.Amount.ToString("N0") đ
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="order-footer">
                                    <a href="/Payment/Invoice?baseCode=@orderCode" class="invoice-btn">
                                        <i class="bi bi-printer-fill"></i>
                                        Xem hóa đơn
                                    </a>

                                    @if (orderStatus == "Pending")
                                    {
                                        <a href="/Payment/PayAgain?baseCode=@orderCode" class="receipt-btn">
                                            <i class="bi bi-credit-card-2-front-fill"></i>
                                            Thanh toán lại
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (window.matchMedia('(max-width: 575.98px)').matches) {
            const filterBox = document.querySelector('.filter-history-details');
            if (filterBox) {
                filterBox.removeAttribute('open');
            }

            document.querySelectorAll('.order-card .collapse.show').forEach(function (el) {
                el.classList.remove('show');
            });

            document.querySelectorAll('.order-card .collapse-toggle').forEach(function (btn) {
                btn.setAttribute('aria-expanded', 'false');
            });
        }
    });
</script>
