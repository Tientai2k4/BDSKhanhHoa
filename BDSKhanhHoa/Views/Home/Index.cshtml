<section class="section-wrap" style="padding-bottom:72px; background:#fff;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-flex-end mb-0">
            <div>
                <div class="section-label"><span>Được chọn lọc cho bạn</span></div>
                <h2 class="section-title">Bất Động Sản Dành Cho Bạn</h2>
            </div>
            <a href="/Property/Search" class="view-all d-none d-md-flex">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="d-flex align-items-center justify-content-between mb-4 mt-4 flex-wrap gap-3">
            <div class="prop-tabs">
                <button type="button" class="prop-tab active" onclick="filterProps('all',this)">Tất cả</button>
                <button type="button" class="prop-tab" onclick="filterProps('buy',this)">Mua bán</button>
                <button type="button" class="prop-tab" onclick="filterProps('rent',this)">Cho thuê</button>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <select class="sfield" style="width:auto; padding:0 14px; height:40px; font-size:0.83rem;" onchange="filterByType(this.value)" id="propTypeFilter">
                    <option value="">Tất cả loại</option>
                </select>
                <select class="sfield" id="sortSelect" style="width:auto; padding:0 14px; height:40px; font-size:0.83rem;" onchange="sortProperties(this.value)">
                    <option value="newest">Sắp xếp: Mới nhất</option>
                    <option value="price_asc">Giá thấp → cao</option>
                    <option value="price_desc">Giá cao → thấp</option>
                </select>
            </div>
        </div>

        <div class="row g-3 g-md-4" id="propGrid">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var package = item.PostServicePackage;
                    string packageType = package?.PackageType?.Trim() ?? "Tin Thường";
                    int packagePriority = package?.PriorityLevel ?? 9999;

                    // Nếu vì lý do nào đó tin VIP hết hạn vẫn lọt ra View thì ép hiển thị như tin thường.
                    bool isExpiredVip = item.VipExpiryDate.HasValue && item.VipExpiryDate.Value < DateTime.Now;
                    if (isExpiredVip)
                    {
                        packageType = "Tin Thường";
                        packagePriority = 5;
                    }

                    string tierClass;
                    string tierLabel;
                    string tierIcon;
                    string tierRank;

                    if (packageType == "Kim Cương" || packagePriority == 1)
                    {
                        packagePriority = 1;
                        tierClass = "tier-diamond";
                        tierLabel = "VIP Kim Cương";
                        tierIcon = "bi-gem";
                        tierRank = "Hạng 1";
                    }
                    else if (packageType == "Vàng" || packagePriority == 2)
                    {
                        packagePriority = 2;
                        tierClass = "tier-gold";
                        tierLabel = "VIP Vàng";
                        tierIcon = "bi-star-fill";
                        tierRank = "Hạng 2";
                    }
                    else if (packageType == "Bạc" || packagePriority == 3)
                    {
                        packagePriority = 3;
                        tierClass = "tier-silver";
                        tierLabel = "VIP Bạc";
                        tierIcon = "bi-shield-fill";
                        tierRank = "Hạng 3";
                    }
                    else if (packageType == "Đồng" || packagePriority == 4)
                    {
                        packagePriority = 4;
                        tierClass = "tier-bronze";
                        tierLabel = "VIP Đồng";
                        tierIcon = "bi-award-fill";
                        tierRank = "Hạng 4";
                    }
                    else
                    {
                        packagePriority = 5;
                        tierClass = "tier-normal";
                        tierLabel = "Tin Thường";
                        tierIcon = "bi-tag-fill";
                        tierRank = "Hạng 5";
                    }

                    string priceStr = item.Price.HasValue && item.Price.Value > 0
                    ? (item.Price.Value >= 1000000000m
                    ? (item.Price.Value / 1000000000m).ToString("0.##") + " Tỷ"
                    : (item.Price.Value / 1000000m).ToString("0.##") + " Triệu")
                    : "Thỏa thuận";

                    string typeName = item.PropertyType?.TypeName?.ToLower() ?? "";
                    bool isRent = typeName.Contains("thuê") || typeName.Contains("trọ");
                    string propMode = isRent ? "rent" : "buy";
                    string transTagClass = isRent ? "tag-rent" : "tag-buy";
                    string transTagText = isRent ? "Cho Thuê" : "Bán";

                    decimal rawPrice = item.Price ?? 0;

                    // Dùng yyyyMMddHHmmss để JS sort chính xác, tránh DateTime.Ticks quá lớn gây sai số trên JavaScript.
                    string sortDate = item.CreatedAt.ToString("yyyyMMddHHmmss");

                    bool isFav = favoritedIds.Contains(item.PropertyID);
                    string heartIconClass = isFav ? "bi-heart-fill" : "bi-heart";

                    <div class="col-xl-3 col-lg-4 col-md-6 col-12 prop-item"
                         data-mode="@propMode"
                         data-typeid="@item.TypeID"
                         data-priority="@packagePriority"
                         data-price="@rawPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                         data-date="@sortDate">
                        <a href="/Property/Details/@item.PropertyID" class="text-decoration-none d-block h-100">
                            <div class="prop-card @tierClass">
                                <div class="prop-img-wrap">
                                    <img src="@(string.IsNullOrEmpty(item.MainImage) ? "/images/no-image.jpg" : item.MainImage)"
                                         alt="@item.Title"
                                         loading="lazy"
                                         onerror="this.src='/images/no-image.jpg'">

                                    <span class="prop-tier" title="@tierRank">
                                        <span class="tier-logo">
                                            <i class="bi @tierIcon"></i>
                                        </span>
                                        @tierLabel
                                    </span>

                                    <span class="prop-trans-tag @transTagClass">@transTagText</span>

                                    <button class="prop-fav @(isFav ? "active" : "")"
                                            type="button"
                                            onclick="event.preventDefault(); event.stopPropagation(); toggleFavorite(@item.PropertyID, this)"
                                            title="@(isFav ? "Bỏ lưu tin" : "Lưu tin")">
                                        <i class="bi @heartIconClass"></i>
                                    </button>
                                </div>

                                <div class="prop-body">
                                    <div class="prop-price">@priceStr</div>

                                    <div class="prop-title" title="@item.Title">
                                        @item.Title
                                    </div>

                                    <div class="prop-meta">
                                        <div class="prop-meta-item">
                                            <i class="bi bi-aspect-ratio"></i>
                                            <span>@item.AreaSize m²</span>
                                        </div>

                                        <div class="prop-meta-item prop-location" title="@(item.Ward?.Area?.AreaName ?? "Khánh Hòa")">
                                            <i class="bi bi-geo-alt-fill"></i>
                                            <span>@(item.Ward?.Area?.AreaName ?? "Khánh Hòa")</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="prop-empty">
                        <i class="bi bi-house-slash display-5 d-block mb-3 text-muted"></i>
                        <h5 class="fw-bold text-dark mb-2">Chưa có tin bất động sản phù hợp</h5>
                        <p class="mb-0">Các tin đã duyệt sẽ được hiển thị tại đây theo thứ tự VIP cao nhất và mới nhất.</p>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <a href="/Property/Search" class="btn" style="background:var(--navy);color:#fff;font-family:'Plus Jakarta Sans',sans-serif;font-weight:700;padding:14px 40px;border-radius:100px;font-size:0.9rem;letter-spacing:0.06em;box-shadow:0 4px 18px rgba(11,22,40,0.22);transition:var(--trans);" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform=''">
                <i class="bi bi-grid me-2"></i>Xem tất cả bất động sản
            </a>
        </div>
    </div>
</section>

