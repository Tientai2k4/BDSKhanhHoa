@model IEnumerable<BDSKhanhHoa.Models.Property>
@using BDSKhanhHoa.Models
@{
    ViewData["Title"] = "Trang Chủ - Bất Động Sản Khánh Hòa";
    var banners = ViewBag.Banners as List<Banner>;
    var favoritedIds = ViewBag.FavoritedIds as List<int> ?? new List<int>(); // Nhận danh sách tin đã lưu
}

<style>
    /* ============================================================
               BDS KHÁNH HÒA — HOMEPAGE 2026
               Design: Luxury Real Estate · Coastal Premium · Deep Navy + Gold
               ============================================================ */

    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

    :root {
        --navy: #0b1628;
        --navy-mid: #152340;
        --navy-light: #1e3458;
        --gold: #c9a84c;
        --gold-light: #e8c97a;
        --gold-pale: #fdf6e3;
        --coral: #e8533a;
        --coral-light: #ff6b4a;
        --sky: #3b82f6;
        --sky-light: #60a5fa;
        --surface: #ffffff;
        --bg: #f7f8fc;
        --bg2: #eef1f8;
        --border: #e2e7f0;
        --text: #0f1c35;
        --text-mid: #3d5175;
        --text-soft: #7a8fa8;
        --text-ghost: #b0bfd4;
        --r-sm: 8px;
        --r-md: 14px;
        --r-lg: 20px;
        --r-xl: 28px;
        --r-2xl: 36px;
        --shadow-card: 0 2px 16px rgba(11,22,40,0.08);
        --shadow-hover: 0 12px 40px rgba(11,22,40,0.16);
        --trans: all 0.26s cubic-bezier(0.4,0,0.2,1);
    }

    *, *::before, *::after {
        box-sizing: border-box;
    }
    /* ============================================================
           SMART UTILITY TOOLS — MODERN RESPONSIVE
           CSS viết riêng theo .utility-section để không ảnh hưởng phần khác
           ============================================================ */

    .utility-section {
        position: relative;
        padding: 82px 0 88px !important;
        background: radial-gradient(circle at 12% 10%, rgba(201,168,76,0.13), transparent 28%), radial-gradient(circle at 88% 18%, rgba(59,130,246,0.10), transparent 26%), linear-gradient(180deg, #ffffff 0%, #f8fafc 100%) !important;
        overflow: hidden;
    }

        .utility-section::before {
            content: '';
            position: absolute;
            inset: auto -120px -220px auto;
            width: 420px;
            height: 420px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(232,83,58,0.08), transparent 68%);
            pointer-events: none;
        }

    .utility-head {
        max-width: 760px;
        margin: 0 auto 34px;
        text-align: center;
        position: relative;
        z-index: 2;
    }

        .utility-head .section-label {
            justify-content: center;
        }

    .utility-highlight {
        color: var(--coral);
    }

    .utility-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(11,22,40,0.04);
        border: 1px solid rgba(226,231,240,0.9);
        color: var(--text-mid);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: .78rem;
        font-weight: 700;
    }

        .utility-kicker i {
            color: var(--gold);
        }

    .smart-util-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
        position: relative;
        z-index: 2;
    }

    .smart-util-card {
        position: relative;
        min-height: 218px;
        padding: 24px 22px 20px;
        border: 1px solid rgba(226,231,240,0.95);
        border-radius: 26px;
        background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(255,255,255,0.92));
        box-shadow: 0 14px 34px rgba(11,22,40,0.07);
        cursor: pointer;
        overflow: hidden;
        text-align: left;
        width: 100%;
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: var(--text);
    }

        .smart-util-card::before {
            content: '';
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity .28s ease;
            pointer-events: none;
        }

        .smart-util-card::after {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            right: -42px;
            top: -42px;
            border-radius: 999px;
            background: rgba(255,255,255,0.45);
            border: 1px solid rgba(255,255,255,0.5);
            pointer-events: none;
        }

        .smart-util-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 22px 54px rgba(11,22,40,0.15);
            border-color: rgba(11,22,40,0.18);
        }

            .smart-util-card:hover::before {
                opacity: 1;
            }

        .smart-util-card:focus-visible {
            outline: 4px solid rgba(59,130,246,0.18);
            outline-offset: 3px;
        }

        .smart-util-card .util-icon {
            position: relative;
            z-index: 2;
            width: 62px;
            height: 62px;
            margin: 0 0 18px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.55rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), 0 12px 28px rgba(11,22,40,0.12);
            transition: transform .28s ease;
        }

        .smart-util-card:hover .util-icon {
            transform: rotate(-4deg) scale(1.08);
        }

        .smart-util-card .util-name {
            position: relative;
            z-index: 2;
            font-size: 1rem;
            font-weight: 900;
            letter-spacing: -0.02em;
            color: var(--text);
            margin-bottom: 8px;
        }

        .smart-util-card .util-desc {
            position: relative;
            z-index: 2;
            min-height: 43px;
            font-size: .82rem;
            color: var(--text-mid);
            line-height: 1.6;
            margin-bottom: 16px;
        }

    .util-card-foot {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 14px;
        border-top: 1px solid rgba(226,231,240,0.9);
        font-size: .78rem;
        font-weight: 800;
        color: var(--text-soft);
    }

        .util-card-foot span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .util-card-foot i {
            transition: transform .24s ease;
        }

    .smart-util-card:hover .util-card-foot i {
        transform: translateX(4px);
    }

    .util-age::before {
        background: linear-gradient(135deg, rgba(201,168,76,0.14), rgba(253,246,227,0.32));
    }

    .util-cost::before {
        background: linear-gradient(135deg, rgba(232,83,58,0.12), rgba(255,237,213,0.34));
    }

    .util-loan::before {
        background: linear-gradient(135deg, rgba(59,130,246,0.12), rgba(219,234,254,0.36));
    }

    .util-feng::before {
        background: linear-gradient(135deg, rgba(22,163,74,0.12), rgba(220,252,231,0.38));
    }

    .util-age .util-icon {
        background: linear-gradient(135deg, #fff7d6, #f3c94d);
        color: #9a6208;
    }

    .util-cost .util-icon {
        background: linear-gradient(135deg, #fff1eb, #ff8a65);
        color: #b91c1c;
    }

    .util-loan .util-icon {
        background: linear-gradient(135deg, #eaf4ff, #60a5fa);
        color: #0f4fa8;
    }

    .util-feng .util-icon {
        background: linear-gradient(135deg, #ecfdf5, #86efac);
        color: #166534;
    }

    /* Modal modern */
    .modal-util .modal-dialog {
        max-width: 560px;
    }

    .modal-util .modal-content {
        border: none;
        border-radius: 30px;
        overflow: hidden;
        box-shadow: 0 28px 80px rgba(11,22,40,0.28);
        background: #fff;
    }

    .modal-util .modal-header {
        position: relative;
        padding: 22px 24px;
        background: radial-gradient(circle at 10% 10%, rgba(201,168,76,0.22), transparent 32%), linear-gradient(135deg, var(--navy), var(--navy-mid));
        border: none;
    }

        .modal-util .modal-header::after {
            content: '';
            position: absolute;
            right: -42px;
            top: -52px;
            width: 160px;
            height: 160px;
            border-radius: 999px;
            background: rgba(255,255,255,0.08);
            pointer-events: none;
        }

    .modal-util .modal-title {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #fff;
        font-family: 'Playfair Display', serif;
        font-size: 1.16rem;
        font-weight: 800;
        margin: 0;
    }

        .modal-util .modal-title i {
            color: var(--gold-light);
        }

    .modal-util .btn-close {
        position: relative;
        z-index: 3;
        filter: invert(1);
        opacity: .85;
    }

    .modal-util .modal-body {
        padding: 24px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcff 100%);
    }

    .util-form-note {
        margin: 0 0 18px;
        padding: 12px 14px;
        border-radius: 16px;
        background: rgba(59,130,246,0.07);
        border: 1px solid rgba(59,130,246,0.13);
        color: var(--text-mid);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: .84rem;
        line-height: 1.55;
    }

    .util-field {
        margin-bottom: 15px;
    }

        .util-field label {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 8px;
            color: var(--text);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: .84rem;
            font-weight: 800;
        }

            .util-field label i {
                color: var(--coral);
            }

    .modal-util .form-control,
    .modal-util .form-select {
        height: 48px;
        border-radius: 14px;
        border: 1.5px solid var(--border);
        background-color: #fff;
        color: var(--text);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: .9rem;
        font-weight: 600;
        box-shadow: none;
        transition: border-color .22s ease, box-shadow .22s ease;
    }

        .modal-util .form-control:focus,
        .modal-util .form-select:focus {
            border-color: var(--navy);
            box-shadow: 0 0 0 4px rgba(11,22,40,0.08);
        }

    .util-action {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 16px;
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: .9rem;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
        transition: transform .24s ease, box-shadow .24s ease;
    }

        .util-action:hover {
            transform: translateY(-2px);
            color: #fff;
        }

    .btn-age {
        background: linear-gradient(135deg, var(--navy), #1d2f52);
        box-shadow: 0 12px 26px rgba(11,22,40,0.22);
    }

    .btn-cost {
        background: linear-gradient(135deg, var(--coral), #c9371f);
        box-shadow: 0 12px 26px rgba(232,83,58,0.24);
    }

    .btn-loan {
        background: linear-gradient(135deg, #2563eb, #0f4fa8);
        box-shadow: 0 12px 26px rgba(37,99,235,0.24);
    }

    .btn-feng {
        background: linear-gradient(135deg, #15803d, #14532d);
        box-shadow: 0 12px 26px rgba(21,128,61,0.22);
    }

    .calc-result {
        display: none;
        margin-top: 18px;
        padding: 18px;
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(253,246,227,0.95), rgba(255,255,255,0.95));
        border: 1px solid rgba(201,168,76,0.32);
        box-shadow: 0 12px 34px rgba(11,22,40,0.07);
        animation: utilResultIn .24s ease both;
    }

    @@keyframes utilResultIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .calc-result.is-error {
        background: #fff1f2;
        border-color: rgba(225,29,72,0.24);
    }

    .result-label {
        color: var(--text-mid);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: .82rem;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .calc-result .result-val {
        color: var(--coral);
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.35rem, 4vw, 1.8rem);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1.2;
    }

    .result-sub {
        margin-top: 8px;
        color: var(--text-soft);
        font-size: .82rem;
        line-height: 1.55;
    }

    .result-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 14px;
    }

    .result-mini {
        padding: 11px 12px;
        border-radius: 14px;
        background: rgba(255,255,255,0.72);
        border: 1px solid rgba(226,231,240,0.92);
    }

        .result-mini b {
            display: block;
            color: var(--text);
            font-size: .86rem;
            margin-bottom: 3px;
        }

        .result-mini span {
            color: var(--text-soft);
            font-size: .77rem;
            line-height: 1.45;
        }

    .feng-result {
        background: linear-gradient(180deg, #f0fdf4, #ffffff) !important;
        border-color: rgba(22,163,74,0.28) !important;
    }

        .feng-result .result-val {
            color: #15803d;
            font-size: 1.3rem;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

    @@media(max-width: 991px) {
        .smart-util-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .utility-section {
            padding: 68px 0 76px !important;
        }
    }

    @@media(max-width: 575px) {
        .utility-head {
            margin-bottom: 24px;
        }

        .smart-util-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .smart-util-card {
            min-height: auto;
            padding: 20px;
            border-radius: 22px;
        }

            .smart-util-card .util-icon {
                width: 54px;
                height: 54px;
                border-radius: 17px;
                font-size: 1.35rem;
                margin-bottom: 14px;
            }

            .smart-util-card .util-desc {
                min-height: auto;
            }

        .modal-util .modal-dialog {
            margin: 12px;
        }

        .modal-util .modal-content {
            border-radius: 24px;
        }

        .modal-util .modal-body {
            padding: 20px;
        }

        .result-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ─── HERO ─────────────────────────────────────────────── */
    .hero {
        position: relative;
        height: 640px;
        overflow: hidden;
        background: var(--navy);
    }

    @@media(max-width:767px) {
        .hero {
            height: 700px;
        }
    }

    .hero-carousel {
        height: 100%;
    }

        .hero-carousel .carousel-item {
            height: 640px;
        }

    @@media(max-width:767px) {
        .hero-carousel .carousel-item {
            height: 700px;
        }
    }

    .hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -55%);
        text-align: center;
        width: 100%;
        max-width: 860px;
        padding: 0 24px;
        z-index: 10;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(201,168,76,0.18);
        border: 1px solid rgba(201,168,76,0.45);
        color: var(--gold-light);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 6px 18px;
        border-radius: 100px;
        margin-bottom: 22px;
    }

        .hero-eyebrow::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--gold);
            border-radius: 50%;
            animation: pulse-gold 2s ease-in-out infinite;
        }

    @@keyframes pulse-gold {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(201,168,76,0.5);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(201,168,76,0);
        }
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.4rem, 5.5vw, 4.2rem);
        font-weight: 900;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -0.02em;
        text-shadow: 0 4px 32px rgba(0,0,0,0.4);
        margin-bottom: 18px;
    }

        .hero-title span {
            color: var(--gold-light);
        }

    .hero-sub {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(1rem, 2vw, 1.2rem);
        color: rgba(255,255,255,0.78);
        font-weight: 400;
        line-height: 1.6;
        margin-bottom: 0;
    }

    .btn-hero-link {
        display: inline-block;
        background: linear-gradient(135deg, var(--coral), #c9371f);
        color: #fff;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        padding: 14px 36px;
        border-radius: 100px;
        font-size: 0.95rem;
        letter-spacing: 0.06em;
        text-decoration: none;
        text-transform: uppercase;
        margin-top: 12px;
        transition: var(--trans);
        box-shadow: 0 4px 18px rgba(232,83,58,0.35);
    }

        .btn-hero-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(232,83,58,0.45);
            color: #fff;
        }

    /* ─── SEARCH BOX ─────────────────────────────────────────── */
    .search-float {
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 100%;
        max-width: 1160px;
        padding: 0 24px;
        z-index: 20;
    }

    .search-glass {
        background: rgba(255,255,255,0.97);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.9);
        border-radius: var(--r-xl) var(--r-xl) 0 0;
        padding: 24px 28px 18px;
        box-shadow: 0 -8px 40px rgba(11,22,40,0.18);
    }

    .stabs {
        display: flex;
        gap: 6px;
        margin-bottom: 18px;
    }

    .stab {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        padding: 9px 24px;
        border-radius: 100px;
        border: 2px solid transparent;
        cursor: pointer;
        transition: var(--trans);
        letter-spacing: 0.04em;
        background: var(--bg2);
        color: var(--text-mid);
    }

        .stab.active {
            background: var(--navy);
            color: #fff;
            border-color: var(--navy);
            box-shadow: 0 4px 16px rgba(11,22,40,0.25);
        }

        .stab:not(.active):hover {
            background: var(--border);
            color: var(--text);
        }

    .sfield {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: var(--r-md);
        padding: 0 14px;
        height: 48px;
        transition: var(--trans);
    }

        .sfield:focus-within {
            border-color: var(--navy);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(11,22,40,0.07);
        }

        .sfield i {
            color: var(--text-soft);
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .sfield select, .sfield input {
            border: none;
            background: transparent;
            width: 100%;
            outline: none;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.88rem;
            color: var(--text);
        }

            .sfield select option {
                color: var(--text);
            }

    .btn-search {
        background: linear-gradient(135deg, var(--coral), #c9371f);
        color: #fff;
        border: none;
        border-radius: var(--r-md);
        height: 48px;
        width: 100%;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: var(--trans);
        box-shadow: 0 4px 18px rgba(232,83,58,0.35);
    }

        .btn-search:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(232,83,58,0.45);
            color: #fff;
        }

    /* ─── GENERAL SECTION ─────────────────────────────────── */
    .section-wrap {
        padding: 72px 0 0;
    }

        .section-wrap.bg-alt {
            background: var(--bg);
        }

        .section-wrap.bg-navy {
            background: var(--navy);
        }

    .section-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--coral);
        margin-bottom: 10px;
    }

        .section-label::before {
            content: '';
            width: 24px;
            height: 2px;
            background: var(--coral);
            border-radius: 2px;
        }

    .section-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin-bottom: 6px;
    }

        .section-title.on-dark {
            color: #fff;
        }

    .section-sub {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.92rem;
        color: var(--text-soft);
        font-weight: 400;
    }

        .section-sub.on-dark {
            color: rgba(255,255,255,0.55);
        }

    .view-all {
