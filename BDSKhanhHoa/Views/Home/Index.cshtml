@section Scripts {
    <!-- Thư viện SweetAlert2 cho thông báo đẹp mắt -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ─── LƯU TIN (YÊU THÍCH) BẰNG AJAX ────────────────────────
        async function toggleFavorite(propertyId, btnElement) {
            try {
                // Gọi API ToggleFavorite trên HomeController
                const response = await fetch('/Home/ToggleFavorite', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `propertyId=${propertyId}`
                });

                const result = await response.json();

                if (result.success) {
                    const icon = btnElement.querySelector('i');
                    if (result.isSaved) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill', 'text-danger');
                        btnElement.classList.add('active');
                        btnElement.title = "Bỏ lưu tin";
                        Swal.fire({ icon: 'success', title: 'Đã lưu', text: 'Bất động sản đã được lưu vào danh sách yêu thích!', timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
                    } else {
                        icon.classList.remove('bi-heart-fill', 'text-danger');
                        icon.classList.add('bi-heart');
                        btnElement.classList.remove('active');
                        btnElement.title = "Lưu tin";
                        Swal.fire({ icon: 'info', title: 'Đã bỏ lưu', text: 'Đã xóa bất động sản khỏi danh sách yêu thích.', timer: 2000, showConfirmButton: false, toast: true, position: 'top-end' });
                    }
                } else {
                    // Cảnh báo nếu chưa đăng nhập
                    Swal.fire({ icon: 'warning', title: 'Chưa đăng nhập', text: result.message, showConfirmButton: true, confirmButtonText: 'Đăng nhập ngay' }).then((res) => {
                        if(res.isConfirmed) { window.location.href = '/Account/Login'; }
                    });
                }
            } catch (error) {
                console.error("Lỗi khi lưu tin:", error);
            }
        }

        // ─── Search Mode ───────────────────────────────────────
        const allTypes = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Types));
        function setMode(mode) {
                    document.getElementById('transactionType').value = mode;
                    document.getElementById('stab-buy').classList.toggle('active', mode === 'buy');
                    document.getElementById('stab-rent').classList.toggle('active', mode === 'rent');

                    const sel = document.getElementById('typeSelect');
                    sel.innerHTML = '<option value="">Loại nhà đất</option>';

                    // ĐÃ SỬA: Lọc chính xác theo ID nghiệp vụ thay vì dò chữ (1 = Mua Bán, 2 = Cho Thuê)
                    const filteredTypes = allTypes.filter(t => {
                        if (mode === 'buy') {
                            return t.ParentID === 1 || t.TypeID === 1;
                        } else {
                            return t.ParentID === 2 || t.TypeID === 2;
                        }
                    });

                    // Đổ dữ liệu đã lọc chuẩn vào Select Box tìm kiếm
                    filteredTypes.forEach(t => sel.add(new Option(t.TypeName, t.TypeID)));

                    // Sync the filter dropdown (Tất cả loại) ở section dưới
                    const pf = document.getElementById('propTypeFilter');
                    if(pf) {
                        pf.innerHTML = '<option value="">Tất cả loại</option>';
                        filteredTypes.forEach(t => pf.add(new Option(t.TypeName, t.TypeID)));
                    }
                }

        async function loadWards(areaId) {
            const ws = document.getElementById('wardSelect');
            if(!ws) return;
            if (!areaId) { ws.innerHTML = '<option value="">Phường/Xã</option>'; return; }
            try {
                const r = await fetch(`/Home/GetWardsByArea?areaId=${areaId}`);
                const d = await r.json();
                ws.innerHTML = '<option value="">Phường/Xã</option>';
                d.forEach(w => ws.add(new Option(w.wardName, w.wardId)));
            } catch(e) { console.error(e); }
        }

        function filterProps(mode, btn) {
            document.querySelectorAll('.prop-tab').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.getElementById('propTypeFilter').value = "";

            document.querySelectorAll('.prop-item').forEach(item => {
                if (mode === 'all') {
                    item.style.display = 'block';
                } else {
                    item.style.display = item.getAttribute('data-mode') === mode ? 'block' : 'none';
                }
            });

            const currentSort = document.getElementById('sortSelect').value;
            sortProperties(currentSort);
        }

        function filterByType(typeId) {
            const activeTabMode = document.querySelector('.prop-tab.active').getAttribute('onclick').match(/'([^']+)'/)[1];

            document.querySelectorAll('.prop-item').forEach(item => {
                const itemMode = item.getAttribute('data-mode');
                const itemType = item.getAttribute('data-typeid');

                const matchMode = (activeTabMode === 'all') || (itemMode === activeTabMode);
                const matchType = (typeId === "") || (itemType === typeId);

                item.style.display = (matchMode && matchType) ? 'block' : 'none';
            });

            const currentSort = document.getElementById('sortSelect').value;
            sortProperties(currentSort);
        }

        // ─── Counter animation ───────────────────────────────
        function animateCounters() {
            document.querySelectorAll('.stat-num[data-target]').forEach(el => {
                const target = parseInt(el.dataset.target);
                let current = 0;
                const step = Math.ceil(target / 60);
                const timer = setInterval(() => {
                    current = Math.min(current + step, target);
                    el.textContent = current.toLocaleString('vi-VN') + (target > 1000 ? '+' : '+');
                    if (current >= target) clearInterval(timer);
                }, 24);
            });
        }

        const statsBar = document.querySelector('.stats-bar');
        if(statsBar) {
            const obs = new IntersectionObserver(entries => {
                if(entries[0].isIntersecting) { animateCounters(); obs.disconnect(); }
            }, {threshold:0.3});
            obs.observe(statsBar);
        }

      
        document.addEventListener('DOMContentLoaded', () => {
            setMode('buy');
        });

        function sortProperties(sortType) {
            const grid = document.getElementById('propGrid');
            if (!grid) return;

            const items = Array.from(grid.querySelectorAll('.prop-item'));

            items.sort((a, b) => {
                const priorityA = Number(a.dataset.priority || 9999);
                const priorityB = Number(b.dataset.priority || 9999);

                // Lớp ưu tiên cao nhất: VIP cao hơn luôn đứng trước.
                if (priorityA !== priorityB) {
                    return priorityA - priorityB;
                }

                // Cùng một hạng VIP mới xét theo lựa chọn sort.
                if (sortType === 'price_asc') {
                    return Number(a.dataset.price || 0) - Number(b.dataset.price || 0);
                }

                if (sortType === 'price_desc') {
                    return Number(b.dataset.price || 0) - Number(a.dataset.price || 0);
                }

                // Mặc định: trong cùng hạng VIP, tin mới nhất đứng trước.
                return Number(b.dataset.date || 0) - Number(a.dataset.date || 0);
            });

            items.forEach(item => grid.appendChild(item));
        }

        document.addEventListener('DOMContentLoaded', () => {
            const sortSelect = document.getElementById('sortSelect');
            sortProperties(sortSelect ? sortSelect.value : 'newest');
        });
