                8: {
                    name: 'Cấn',
                    element: 'Thổ',
                    group: 'Tây tứ mệnh',
                    good: ['Đông Bắc', 'Tây Nam', 'Tây Bắc', 'Tây'],
                    colors: 'Vàng đất, nâu, cam đất, be',
                    material: 'Đá, gạch, gốm, vật liệu ổn định'
                },
                9: {
                    name: 'Ly',
                    element: 'Hỏa',
                    group: 'Đông tứ mệnh',
                    good: ['Nam', 'Bắc', 'Đông Nam', 'Đông'],
                    colors: 'Đỏ, hồng, tím, cam, xanh lá',
                    material: 'Ánh sáng, gỗ, vật liệu ấm'
                }
            };

            function numberValue(id) {
                const el = document.getElementById(id);
                if (!el) return NaN;
                return Number(String(el.value).replace(',', '.'));
            }

            function stringValue(id) {
                const el = document.getElementById(id);
                return el ? String(el.value || '').trim() : '';
            }

            function showResult(resultId, valId, value, note, rowsHtml, isError) {
                const result = document.getElementById(resultId);
                const val = document.getElementById(valId);

                if (!result || !val) return;

                result.classList.toggle('is-error', !!isError);
                val.textContent = value || '—';

                const noteEl = result.querySelector('.result-sub');
                if (noteEl) noteEl.innerHTML = note || '';

                const grid = result.querySelector('.result-grid');
                if (grid) grid.innerHTML = rowsHtml || '';

                result.style.display = 'block';
            }

            function miniRow(title, text) {
                return `<div class="result-mini"><b>${title}</b><span>${text}</span></div>`;
            }

            function formatVnd(amount) {
                if (!isFinite(amount) || amount <= 0) return '0 đ';

                if (amount >= 1000000000) {
                    return (amount / 1000000000)
                        .toLocaleString('vi-VN', { maximumFractionDigits: 2 })
                        + ' tỷ';
                }

                if (amount >= 1000000) {
                    return (amount / 1000000)
                        .toLocaleString('vi-VN', { maximumFractionDigits: 1 })
                        + ' triệu';
                }

                return amount.toLocaleString('vi-VN') + ' đ';
            }

            function reduceDigit(num) {
                let n = Math.abs(Number(num));
                while (n > 9) {
                    n = String(n).split('').reduce((sum, x) => sum + Number(x), 0);
                }
                return n;
            }

            function getBranch(year) {
                return branches[(year + 8) % 12];
            }

            function isTamTai(birthYear, buildYear) {
                const birthBranch = getBranch(birthYear);
                const buildBranch = getBranch(buildYear);

                const groups = {
                    'Thân,Tý,Thìn': ['Dần', 'Mão', 'Thìn'],
                    'Dần,Ngọ,Tuất': ['Thân', 'Dậu', 'Tuất'],
                    'Hợi,Mão,Mùi': ['Tỵ', 'Ngọ', 'Mùi'],
                    'Tỵ,Dậu,Sửu': ['Hợi', 'Tý', 'Sửu']
                };

                for (const key in groups) {
                    if (key.split(',').includes(birthBranch)) {
                        return groups[key].includes(buildBranch);
                    }
                }

                return false;
            }

            function getHoangOc(ageMu) {
                const mod = ageMu % 6;
                const data = {
                    1: { name: 'Nhất Cát', good: true },
                    2: { name: 'Nhì Nghi', good: true },
                    3: { name: 'Tam Địa Sát', good: false },
                    4: { name: 'Tứ Tấn Tài', good: true },
                    5: { name: 'Ngũ Thọ Tử', good: false },
                    0: { name: 'Lục Hoang Ốc', good: false }
                };

                return data[mod];
            }

            function isKimLau(ageMu) {
                return [1, 3, 6, 8].includes(ageMu % 9);
            }

            function findGoodBuildYears(birthYear, startYear) {
                const goodYears = [];

                for (let y = startYear; y <= startYear + 12; y++) {
                    const ageMu = y - birthYear + 1;
                    if (ageMu <= 0) continue;

                    const tamTai = isTamTai(birthYear, y);
                    const kimLau = isKimLau(ageMu);
                    const hoangOc = getHoangOc(ageMu);

                    if (!tamTai && !kimLau && hoangOc.good) {
                        goodYears.push(y);
                    }

                    if (goodYears.length >= 4) break;
                }

                return goodYears;
            }

            function calcKuaNumber(year, gender) {
                const lastTwo = year % 100;
                const digit = reduceDigit(lastTwo);

                let kua;

                if (gender === 'male') {
                    kua = year >= 2000 ? 9 - digit : 10 - digit;
                    if (kua <= 0) kua += 9;
                    kua = reduceDigit(kua);
                    if (kua === 5) kua = 2;
                } else {
                    kua = year >= 2000 ? digit + 6 : digit + 5;
                    kua = reduceDigit(kua);
                    if (kua === 5) kua = 8;
                }

                return kua;
            }

            window.calcTuoi = function () {
                const birthYear = numberValue('birthYear');
                const buildYear = numberValue('buildYear') || new Date().getFullYear();

                if (!birthYear || birthYear < 1900 || birthYear > 2100) {
                    showResult(
                        'tuoiResult',
                        'tuoiVal',
                        'Năm sinh chưa hợp lệ',
                        'Vui lòng nhập năm sinh dương lịch từ 1900 đến 2100.',
                        '',
                        true
                    );
                    return;
                }

                if (!buildYear || buildYear < 2020 || buildYear > 2100 || buildYear <= birthYear) {
                    showResult(
                        'tuoiResult',
                        'tuoiVal',
                        'Năm xây chưa hợp lệ',
                        'Năm dự kiến xây phải lớn hơn năm sinh và nằm trong khoảng hợp lý.',
                        '',
                        true
                    );
                    return;
                }

                const ageMu = buildYear - birthYear + 1;
                const tamTai = isTamTai(birthYear, buildYear);
                const kimLau = isKimLau(ageMu);
                const hoangOc = getHoangOc(ageMu);
                const goodYears = findGoodBuildYears(birthYear, buildYear);
                const isGood = !tamTai && !kimLau && hoangOc.good;

                const value = isGood
                    ? `${buildYear} khá tốt để xây nhà`
                    : `${buildYear} nên cân nhắc thêm`;

                const note = isGood
                    ? `Gia chủ ${ageMu} tuổi mụ, không phạm Tam Tai, Kim Lâu và Hoang Ốc xấu theo cách tính tham khảo.`
                    : `Gia chủ ${ageMu} tuổi mụ. Có yếu tố phong thủy cần cân nhắc trước khi khởi công. Năm gợi ý gần nhất: <b>${goodYears.length ? goodYears.join(', ') : 'chưa tìm thấy trong 12 năm tới'}</b>.`;

                const rows = [
                    miniRow('Tuổi mụ', `${ageMu} tuổi`),
                    miniRow('Tam Tai', tamTai ? 'Có phạm' : 'Không phạm'),
                    miniRow('Kim Lâu', kimLau ? 'Có phạm' : 'Không phạm'),
                    miniRow('Hoang Ốc', `${hoangOc.name} · ${hoangOc.good ? 'Tốt' : 'Xấu'}`)
                ].join('');

                showResult('tuoiResult', 'tuoiVal', value, note, rows, false);
            };

            window.calcChiPhi = function () {
                const area = numberValue('dtXayDung');
                const floors = numberValue('soTang');
                const unitMillion = numberValue('tieuchuan');
                const foundation = numberValue('heSoMong');
                const roof = numberValue('heSoMai');

                if (!area || area <= 0) {
                    showResult(
                        'chiPhiResult',
                        'chiPhiVal',
                        'Thiếu diện tích',
                        'Vui lòng nhập diện tích xây dựng mỗi sàn lớn hơn 0.',
                        '',
                        true
                    );
                    return;
                }

                if (!floors || floors <= 0) {
                    showResult(
                        'chiPhiResult',
                        'chiPhiVal',
                        'Thiếu số tầng',
                        'Vui lòng nhập số tầng hợp lệ.',
                        '',
                        true
                    );
                    return;
                }

                const floorArea = area * floors;
                const foundationArea = area * foundation;
                const roofArea = area * roof;
                const convertedArea = floorArea + foundationArea + roofArea;
                const total = convertedArea * unitMillion * 1000000;

                const low = total * 0.92;
                const high = total * 1.12;

                const note = `Tổng diện tích quy đổi khoảng <b>${convertedArea.toLocaleString('vi-VN', { maximumFractionDigits: 1 })} m²</b>. Khoảng dự phòng thực tế nên tính từ <b>${formatVnd(low)}</b> đến <b>${formatVnd(high)}</b>.`;

                const rows = [
                    miniRow('Diện tích sàn', `${floorArea.toLocaleString('vi-VN', { maximumFractionDigits: 1 })} m²`),
                    miniRow('Móng + mái', `${(foundationArea + roofArea).toLocaleString('vi-VN', { maximumFractionDigits: 1 })} m² quy đổi`),
                    miniRow('Đơn giá', `${unitMillion.toLocaleString('vi-VN')} triệu/m²`),
                    miniRow('Chưa gồm', 'Nội thất rời, thiết kế, giấy phép, phát sinh đặc thù')
                ].join('');

                showResult('chiPhiResult', 'chiPhiVal', formatVnd(total), note, rows, false);
            };

            window.calcLaiSuat = function () {
                const loanMillion = numberValue('soTienVay');
                const annualRate = numberValue('laiSuat');
                const years = numberValue('thoiHan');
                const method = stringValue('loanMethod') || 'equal';

                if (!loanMillion || loanMillion <= 0) {
                    showResult(
                        'laiSuatResult',
                        'laiSuatVal',
                        'Thiếu số tiền vay',
                        'Vui lòng nhập số tiền vay theo đơn vị triệu đồng.',
                        '',
                        true
                    );
                    return;
                }

                if (annualRate < 0 || !isFinite(annualRate)) {
                    showResult(
                        'laiSuatResult',
                        'laiSuatVal',
                        'Lãi suất chưa hợp lệ',
                        'Vui lòng nhập lãi suất/năm hợp lệ.',
                        '',
                        true
                    );
                    return;
                }

                if (!years || years <= 0 || years > 35) {
                    showResult(
                        'laiSuatResult',
                        'laiSuatVal',
                        'Thời hạn chưa hợp lệ',
                        'Thời hạn vay nên nằm trong khoảng 1 đến 35 năm.',
                        '',
                        true
                    );
                    return;
                }

                const principal = loanMillion * 1000000;
                const months = Math.round(years * 12);
                const monthlyRate = annualRate / 100 / 12;

                let mainPayment = 0;
                let totalPayment = 0;
                let totalInterest = 0;
                let note = '';
                let rows = '';

                if (method === 'declining') {
                    const principalMonthly = principal / months;
                    const firstMonth = principalMonthly + principal * monthlyRate;
                    const lastMonth = principalMonthly + principalMonthly * monthlyRate;

                    totalInterest = principal * monthlyRate * (months + 1) / 2;
                    totalPayment = principal + totalInterest;
                    mainPayment = firstMonth;

                    note = `Theo dư nợ giảm dần, tháng đầu trả cao nhất khoảng <b>${formatVnd(firstMonth)}</b>, sau đó giảm dần về khoảng <b>${formatVnd(lastMonth)}</b> ở tháng cuối.`;

                    rows = [
                        miniRow('Gốc mỗi tháng', formatVnd(principalMonthly)),
                        miniRow('Tháng cuối', formatVnd(lastMonth)),
                        miniRow('Tổng lãi dự kiến', formatVnd(totalInterest)),
                        miniRow('Tổng phải trả', formatVnd(totalPayment))
                    ].join('');
                } else {
                    if (monthlyRate === 0) {
                        mainPayment = principal / months;
                    } else {
                        mainPayment = principal * monthlyRate * Math.pow(1 + monthlyRate, months) / (Math.pow(1 + monthlyRate, months) - 1);
                    }

                    totalPayment = mainPayment * months;
                    totalInterest = totalPayment - principal;

                    note = `Theo phương án trả đều, khoản thanh toán dự kiến ổn định mỗi tháng trong <b>${months} tháng</b>.`;

                    rows = [
                        miniRow('Thời hạn', `${years} năm · ${months} tháng`),
                        miniRow('Lãi suất tháng', `${(monthlyRate * 100).toLocaleString('vi-VN', { maximumFractionDigits: 3 })}%`),
                        miniRow('Tổng lãi dự kiến', formatVnd(totalInterest)),
                        miniRow('Tổng phải trả', formatVnd(totalPayment))
                    ].join('');
                }

                showResult('laiSuatResult', 'laiSuatVal', formatVnd(mainPayment) + '/tháng', note, rows, false);
            };

            window.calcPhongThuy = function () {
                const year = numberValue('ptBirthYear');
                const gender = stringValue('ptGender') || 'male';
                const houseDirection = stringValue('ptHouseDirection');

                if (!year || year < 1900 || year > 2100) {
                    showResult(
                        'ptResult',
                        'ptMenh',
                        'Năm sinh chưa hợp lệ',
                        'Vui lòng nhập năm sinh dương lịch từ 1900 đến 2100.',
                        '',
                        true
                    );
                    return;
                }

                const kua = calcKuaNumber(year, gender);
                const data = fengData[kua];

                if (!data) {
                    showResult(
                        'ptResult',
                        'ptMenh',
                        'Chưa tính được cung phi',
                        'Vui lòng kiểm tra lại năm sinh và giới tính.',
                        '',
                        true
                    );
                    return;
                }

                const directionText = data.good.join(', ');
                const selectedDirectionText = houseDirection
                    ? data.good.includes(houseDirection)
                        ? `Hướng <b>${houseDirection}</b> đang chọn thuộc nhóm hướng tốt với gia chủ.`
                        : `Hướng <b>${houseDirection}</b> chưa nằm trong nhóm hướng tốt chính, nên cân nhắc bố trí cửa, bếp, phòng ngủ để cân bằng.`
                    : 'Bạn có thể chọn thêm hướng nhà để công cụ đánh giá nhanh mức phù hợp.';

                const value = `Cung ${data.name} · Mệnh ${data.element}`;
                const note = `${gender === 'male' ? 'Nam' : 'Nữ'} sinh năm ${year} thuộc <b>${data.group}</b>. Hướng tốt tham khảo: <b>${directionText}</b>. ${selectedDirectionText}`;

                const rows = [
                    miniRow('Cung phi', `Số ${kua} · Cung ${data.name}`),
                    miniRow('Nhóm mệnh', data.group),
                    miniRow('Màu hợp', data.colors),
                    miniRow('Vật liệu gợi ý', data.material)
                ].join('');

                showResult('ptResult', 'ptMenh', value, note, rows, false);
            };

            document.addEventListener('DOMContentLoaded', function () {
                const currentYear = new Date().getFullYear();

                const buildYear = document.getElementById('buildYear');
                if (buildYear && !buildYear.value) {
                    buildYear.value = currentYear;
                }

                const utilityModals = document.querySelectorAll('.modal-util');
                utilityModals.forEach(function (modal) {
                    modal.addEventListener('shown.bs.modal', function () {
                        const firstInput = modal.querySelector('input, select, button');
                        if (firstInput) firstInput.focus({ preventScroll: true });
                    });
                });
            });
        })();
    </script>
}