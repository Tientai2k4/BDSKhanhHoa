<section class="section-wrap" style="padding-bottom:72px; background:#fff;">
    <div class="container">
        <div class="text-center mb-4">
            <div class="section-label d-inline-flex"><span>Khám phá theo vùng</span></div>
            <h2 class="section-title">Bất Động Sản Theo Địa Điểm</h2>
            <p class="section-sub">Những khu vực đang có lượng giao dịch và tin đăng sôi động nhất</p>
        </div>

        @{
            var areasList = ViewBag.Areas as List<BDSKhanhHoa.Models.Area> ?? new List<BDSKhanhHoa.Models.Area>();
            var areaCounts = ViewBag.AreaPropertyCounts as Dictionary<int, int> ?? new Dictionary<int, int>();

            // Lấy danh sách Khu Vực sắp xếp từ cao tới thấp theo số lượng tin
            var topAreas = areasList
            .Select(a => new { Area = a, Count = areaCounts.ContainsKey(a.AreaID) ? areaCounts[a.AreaID] : 0 })
            .OrderByDescending(x => x.Count)
            .ToList();

            // Ảnh mồi Khánh Hòa - Nha Trang
            var defaultImages = new string[] {
                "https://images.unsplash.com/photo-1573843981267-be1999ff37cd?q=80&w=1200&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1528127269322-539801943592?q=80&w=1200&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1583417319070-4a69db38a482?q=80&w=1200&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1200&auto=format&fit=crop",
                "https://images.unsplash.com/photo-1519046904884-53103b34b206?q=80&w=1200&auto=format&fit=crop"
                };
        }

        <div class="row g-3">
            @if (topAreas.Count >= 1)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="/Property/Search?areaId=@topAreas[0].Area.AreaID" class="loc-card">
                        <img class="loc-img tall w-100" src="@defaultImages[0]" alt="@topAreas[0].Area.AreaName" loading="lazy">
                        <div class="loc-overlay"></div>
                        <div class="loc-caption">
                            <div class="loc-name">@topAreas[0].Area.AreaName</div>
                            <div class="loc-count">@topAreas[0].Count tin đăng</div>
                        </div>
                    </a>
                </div>
            }

            <div class="col-md-6 col-lg-4">
                <div class="d-flex flex-column gap-3 h-100">
                    @if (topAreas.Count >= 2)
                    {
                        <a href="/Property/Search?areaId=@topAreas[1].Area.AreaID" class="loc-card">
                            <img class="loc-img short w-100" src="@defaultImages[1]" alt="@topAreas[1].Area.AreaName" loading="lazy">
                            <div class="loc-overlay"></div>
                            <div class="loc-caption">
                                <div class="loc-name">@topAreas[1].Area.AreaName</div>
                                <div class="loc-count">@topAreas[1].Count tin đăng</div>
                            </div>
                        </a>
                    }
                    @if (topAreas.Count >= 3)
                    {
                        <a href="/Property/Search?areaId=@topAreas[2].Area.AreaID" class="loc-card">
                            <img class="loc-img short w-100" src="@defaultImages[2]" alt="@topAreas[2].Area.AreaName" loading="lazy">
                            <div class="loc-overlay"></div>
                            <div class="loc-caption">
                                <div class="loc-name">@topAreas[2].Area.AreaName</div>
                                <div class="loc-count">@topAreas[2].Count tin đăng</div>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <div class="col-md-12 col-lg-4">
                <div class="d-flex flex-column gap-3 h-100">
                    @if (topAreas.Count >= 4)
                    {
                        <a href="/Property/Search?areaId=@topAreas[3].Area.AreaID" class="loc-card">
                            <img class="loc-img short w-100" src="@defaultImages[3]" alt="@topAreas[3].Area.AreaName" loading="lazy">
                            <div class="loc-overlay"></div>
                            <div class="loc-caption">
                                <div class="loc-name">@topAreas[3].Area.AreaName</div>
                                <div class="loc-count">@topAreas[3].Count tin đăng</div>
                            </div>
