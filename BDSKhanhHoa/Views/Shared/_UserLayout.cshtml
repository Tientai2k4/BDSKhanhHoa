            @if (hasListings || isAdminOrStaff)
            {
                <div class="menu-section">
                    <button class="menu-section-header" type="button" data-bs-toggle="collapse" data-bs-target="#menuVip" aria-expanded="false" aria-controls="menuVip" data-default-state="closed">
