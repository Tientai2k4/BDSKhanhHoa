            </div>
        </div>
    </aside>

    <div class="main-panel">
        <header class="top-header">
            <div class="d-flex align-items-center gap-3 min-w-0">
                <button class="btn-toggle-sidebar" id="btnToggleSidebar" type="button" aria-label="Đóng mở thanh menu">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <div class="header-title min-w-0">
                    <h4 class="text-truncate">@ViewData["Title"]</h4>
                    <small>Trung tâm mua bán BĐS</small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a href="/" target="_blank" class="top-icon-btn d-none d-md-inline-flex" title="Xem website công khai">
                    <i class="bi bi-globe fs-5"></i>
                </a>

                <a href="/Notification/Index" class="top-icon-btn position-relative" title="Thông báo">
                    <i class="bi bi-bell-fill fs-5 @(totalSystemAlerts > 0 ? "bell-shake text-warning" : "text-secondary")"></i>
                    @if (totalSystemAlerts > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white">
                            @(totalSystemAlerts > 99 ? "99+" : totalSystemAlerts)
                        </span>
                    }
                </a>

                <div class="vr bg-secondary opacity-25 d-none d-sm-block" style="height:30px;"></div>

                <div class="dropdown">
                    <div class="user-profile-pill" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-meta text-end d-none d-sm-block">
                            <h6>@userName</h6>
                            <small>@userRole</small>
                        </div>
                        <img src="@userAvatar" class="rounded-circle border border-2 border-white shadow-sm" width="36" height="36" style="object-fit:cover;" alt="Avatar" />
                        <i class="bi bi-chevron-down text-muted d-none d-md-block" style="font-size:0.8rem;"></i>
                    </div>

                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-3 p-2 rounded-4 animate__animated animate__fadeIn" style="min-width:240px;">
                        <li><div class="dropdown-header text-dark fw-bold pb-2">TÀI KHOẢN CỦA TÔI</div></li>
                        <li>
                            <a class="dropdown-item rounded-3 py-2 fw-medium" href="/Account/Profile">
                                <i class="bi bi-person-circle me-2 text-primary"></i> Quản lý hồ sơ
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item rounded-3 py-2 fw-medium" href="/Property/MyAds">
                                <i class="bi bi-card-list me-2 text-success"></i> Tin BĐS của tôi
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-2" /></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger rounded-3 py-2 fw-bold">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 animate__animated animate__fadeInDown" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>
                    <span class="fw-bold">@TempData["Success"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 animate__animated animate__shakeX" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>
                    <span class="fw-bold">@TempData["Error"]</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (ViewData["ShowActionButtons"] as bool? == true)
            {
                <div class="quick-actions animate__animated animate__fadeInUp">
                    <button type="button" class="btn-quick btn-q-consult" data-bs-toggle="modal" data-bs-target="#consultationModal">
                        <i class="bi bi-headset fs-5"></i> Gửi yêu cầu tư vấn
                    </button>

                    @if (!isOwner)
                    {
                        <button type="button" class="btn-quick btn-q-chat" data-bs-toggle="modal" data-bs-target="#internalChatModal">
                            <i class="bi bi-chat-dots-fill fs-5"></i> Chat với người đăng tin
                        </button>
                        <button type="button" class="btn-quick btn-q-appt" data-bs-toggle="modal" data-bs-target="#appointmentModal">
                            <i class="bi bi-calendar2-check-fill fs-5"></i> Đặt lịch đi xem
                        </button>
                    }
                </div>
            }

            <div class="animate__animated animate__fadeIn" style="animation-delay:0.08s;">
                @RenderBody()
            </div>
        </main>
    </div>

    <div class="modal fade" id="consultationModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-warning border-0 text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-headset me-2"></i>Gửi yêu cầu tư vấn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form id="frmConsultation">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="phoneNumber" class="form-control form-control-lg bg-light border-0 shadow-sm" required placeholder="Nhập số điện thoại để được gọi lại..." />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-bold text-muted small text-uppercase">Nội dung cần hỏi</label>
                            <textarea name="message" class="form-control bg-light border-0 shadow-sm" rows="3" placeholder="Ví dụ: Tôi muốn hỏi pháp lý, giá, lịch xem nhà..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-3">
                        <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-5 shadow-sm">Gửi yêu cầu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="internalChatModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-chat-dots-fill me-2"></i>Chat tư vấn mua/bán</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form id="frmInternalChat">
                    <div class="modal-body p-4">
                        <label class="form-label fw-bold text-muted small text-uppercase">Nội dung tin nhắn <span class="text-danger">*</span></label>
                        <textarea name="chatMessage" class="form-control bg-light border-0 shadow-sm" rows="4" required placeholder="Nhập nội dung cần trao đổi với người đăng tin..."></textarea>
                    </div>
                    <div class="modal-footer border-0 p-3">
                        <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary fw-bold rounded-pill px-5 shadow-sm"><i class="bi bi-send-fill me-1"></i>Gửi tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="appointmentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-calendar-check-fill me-2"></i>Đặt lịch đi xem</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form id="frmAppointment">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Ngày hẹn</label>
                                <input type="date" name="appointmentDate" class="form-control bg-light border-0 shadow-sm" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small text-uppercase">Giờ hẹn</label>
                                <input type="time" name="appointmentTime" class="form-control bg-light border-0 shadow-sm" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold text-muted small text-uppercase">Ghi chú</label>
                                <textarea name="notes" class="form-control bg-light border-0 shadow-sm" rows="2" placeholder="Ví dụ: Tới nơi xin hãy gọi trước..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 p-3">
                        <button type="button" class="btn btn-light fw-bold rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success fw-bold rounded-pill px-5 shadow-sm">Xác nhận đặt lịch</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $('.alert-dismissible').fadeOut('slow');
            }, 5000);

            const $sidebar = $('#sidebar');
            const $overlay = $('#mobileOverlay');
            const $body = $('body');

            const sidebarStateKey = 'BDS_SidebarState_2026';
            const menuStatePrefix = 'BDS_MenuState_2026_';
            const collapseMenus = ['menuBuyer', 'menuSeller', 'menuInteraction', 'menuVip', 'menuAdmin', 'menuAccount'];

            if (window.innerWidth >= 1200 && localStorage.getItem(sidebarStateKey) === 'collapsed') {
                $body.addClass('sidebar-collapsed');
            }

            function openMobileSidebar() {
                $sidebar.addClass('show');
                $overlay.addClass('active');
                $body.addClass('sidebar-open');
            }

            function closeMobileSidebar() {
                $sidebar.removeClass('show');
                $overlay.removeClass('active');
                $body.removeClass('sidebar-open');
            }

            $('#btnToggleSidebar').on('click', function () {
                if (window.innerWidth >= 1200) {
                    $body.toggleClass('sidebar-collapsed');
                    localStorage.setItem(sidebarStateKey, $body.hasClass('sidebar-collapsed') ? 'collapsed' : 'expanded');
                } else {
                    openMobileSidebar();
                }
            });

            $('#btnCloseSidebar, #mobileOverlay').on('click', closeMobileSidebar);

            collapseMenus.forEach(function (menuId) {
                const $menuEl = $('#' + menuId);
                if (!$menuEl.length) return;

                const $headerBtn = $('button[data-bs-target="#' + menuId + '"]');
                const savedState = localStorage.getItem(menuStatePrefix + menuId);
                const defaultState = $headerBtn.data('default-state') || 'closed';
                const shouldOpen = savedState ? savedState === 'open' : defaultState === 'open';

                if (shouldOpen) {
                    $menuEl.addClass('show');
                    $headerBtn.attr('aria-expanded', 'true');
                } else {
                    $menuEl.removeClass('show');
                    $headerBtn.attr('aria-expanded', 'false');
                }

                $menuEl.on('shown.bs.collapse', function () {
                    localStorage.setItem(menuStatePrefix + menuId, 'open');
                    $headerBtn.attr('aria-expanded', 'true');
                });

                $menuEl.on('hidden.bs.collapse', function () {
                    localStorage.setItem(menuStatePrefix + menuId, 'closed');
                    $headerBtn.attr('aria-expanded', 'false');
                });
            });

            $('.menu-item').on('click', function () {
                if (window.innerWidth < 1200) {
                    closeMobileSidebar();
                }
            });

            $('#frmConsultation').on('submit', function (e) {
                e.preventDefault();
                alert('Hệ thống đã ghi nhận yêu cầu tư vấn. Hãy nối form này với API Consultation thật của bạn.');
                $('#consultationModal').modal('hide');
                this.reset();
            });

            $('#frmInternalChat').on('submit', function (e) {
                e.preventDefault();
                alert('Tin nhắn demo đã được ghi nhận. Nếu đang ở trang chi tiết BĐS, nên chuyển nút này sang link /UserMessage/Index?receiverId=...&propertyId=...');
                $('#internalChatModal').modal('hide');
                this.reset();
            });

            $('#frmAppointment').on('submit', function (e) {
                e.preventDefault();
                alert('Hệ thống đã ghi nhận yêu cầu đặt lịch demo. Hãy nối form này với API Appointment thật của bạn.');
                $('#appointmentModal').modal('hide');
                this.reset();
            });

            $(window).on('resize', function () {
                if (window.innerWidth >= 1200) {
                    closeMobileSidebar();
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
