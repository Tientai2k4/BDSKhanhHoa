@using BDSKhanhHoa.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using BDSKhanhHoa.Models
@inject ApplicationDbContext _context

@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int currentUserId);

    var userName = User.Identity?.Name ?? "Thành viên hệ thống";
    var userAvatar = User.FindFirst("Avatar")?.Value ?? "/images/avatars/default-user.png";
    var userRole = User.FindFirstValue(ClaimTypes.Role) ?? "Member";

    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff") || User.IsInRole("SuperAdmin");
    bool isOwner = ViewData["IsOwner"] as bool? ?? false;

    bool hasListings = false;
    int unreadMessages = 0;
    int pendingAppointments = 0;
    int newLeadsCount = 0;
    int unreadComments = 0;
    int totalSystemAlerts = 0;

    if (isAuthenticated && currentUserId > 0)
    {
        hasListings = _context.Properties.Any(p => p.UserID == currentUserId && p.IsDeleted == false);

        unreadMessages = _context.UserMessages.Count(m => m.ReceiverID == currentUserId && m.IsRead == false);

        pendingAppointments = _context.Appointments.Count(a =>
            a.SellerID == currentUserId &&
            a.Status == "Pending");

        if (hasListings)
        {
            newLeadsCount = _context.Consultations.Count(c =>
                c.Property != null &&
                c.Property.UserID == currentUserId &&
                c.Status == "New");

            unreadComments = _context.Comments.Count(c =>
                c.Property != null &&
                c.Property.UserID == currentUserId &&
                c.IsHidden == false);
        }

        totalSystemAlerts = unreadMessages + pendingAppointments + newLeadsCount + unreadComments;
    }

    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    string currentTab = ViewContext.HttpContext.Request.Query["tab"].ToString() ?? "";
}

<!DOCTYPE html>
<html lang="vi" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewData["Title"] - Cổng Thành Viên | BDS KHÁNH HÒA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --primary-color: #2563eb;
            --primary-hover: #1d4ed8;
            --primary-soft: #eff6ff;
            --primary-border: #bfdbfe;
            --success: #059669;
            --success-soft: #ecfdf5;
            --danger: #dc2626;
            --danger-soft: #fef2f2;
            --warning: #d97706;
            --warning-soft: #fffbeb;
            --info: #0284c7;
            --info-soft: #f0f9ff;
            --bg-body-color: #f4f7fb;
            --bg-sidebar: #ffffff;
            --text-main: #0f172a;
            --text-body: #334155;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --sidebar-width: 298px;
            --sidebar-collapsed-width: 86px;
            --header-height: 76px;
            --radius-sm: 10px;
            --radius-md: 14px;
            --radius-lg: 18px;
            --radius-xl: 22px;
            --shadow-soft: 0 10px 35px rgba(15, 23, 42, 0.06);
            --shadow-card: 0 14px 40px rgba(37, 99, 235, 0.08);
            --transition-fast: 0.16s ease;
            --transition-smooth: 0.28s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: radial-gradient(circle at top left, #eef6ff 0, #f4f7fb 35%, #f8fafc 100%);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        h1, h2, h3, h4, h5, h6,
        .brand-title,
        .menu-section-header,
        .layout-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        a {
            text-decoration: none;
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 999px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }

        .mobile-overlay {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.62);
            backdrop-filter: blur(4px);
            z-index: 1035;
            opacity: 0;
            visibility: hidden;
            transition: var(--transition-smooth);
        }

            .mobile-overlay.active {
                opacity: 1;
                visibility: visible;
            }

        .sidebar-wrapper {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: rgba(255, 255, 255, 0.96);
            border-right: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 2px 0 30px rgba(15, 23, 42, 0.04);
            z-index: 1040;
            display: flex;
            flex-direction: column;
            transition: width var(--transition-smooth), transform var(--transition-smooth);
            overflow: hidden;
        }

        .sidebar-brand {
            height: var(--header-height);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 18px;
            border-bottom: 1px solid #edf2f7;
            flex-shrink: 0;
        }

            .sidebar-brand a {
                display: flex;
                align-items: center;
                gap: 13px;
                color: var(--text-main);
                min-width: 0;
            }

        .brand-avatar {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            box-shadow: 0 12px 26px rgba(37, 99, 235, 0.25);
            flex: 0 0 auto;
        }

        .brand-text-wrap {
            min-width: 0;
        }

        .brand-title {
            margin: 0;
            font-size: 1.02rem;
            font-weight: 900;
            letter-spacing: -0.4px;
            line-height: 1.15;
            white-space: nowrap;
        }

        .brand-subtitle {
            margin: 3px 0 0;
            color: var(--primary-color);
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            padding: 18px 14px 28px;
        }

        .menu-top-card {
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(14, 165, 233, 0.04)), #ffffff;
            border: 1px solid #e6eefb;
            border-radius: var(--radius-lg);
            padding: 15px;
            margin-bottom: 16px;
            box-shadow: var(--shadow-soft);
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 0.55px;
            line-height: 1;
        }

        .role-admin {
            background: rgba(220, 38, 38, 0.08);
            color: #b91c1c;
            border: 1px solid rgba(220, 38, 38, 0.14);
        }

        .role-member {
            background: rgba(37, 99, 235, 0.09);
            color: var(--primary-color);
            border: 1px solid rgba(37, 99, 235, 0.16);
        }

        .menu-top-card .small-note {
            margin-top: 10px;
            color: var(--text-muted);
            font-size: 0.8rem;
            line-height: 1.55;
        }

        .menu-section {
            margin-bottom: 11px;
            border-radius: var(--radius-md);
        }

        .menu-section-header {
            width: 100%;
            border: 1px solid transparent;
            background: #f8fafc;
            color: #475569;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 12px 14px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: var(--transition-fast);
            font-size: 0.75rem;
            font-weight: 900;
            letter-spacing: 0.7px;
            text-transform: uppercase;
        }

            .menu-section-header:hover {
                color: var(--primary-color);
                background: #f1f5f9;
                border-color: #e2e8f0;
            }

            .menu-section-header[aria-expanded="true"] {
                color: var(--primary-color);
                background: #ffffff;
                border-color: #e2e8f0;
                border-bottom-left-radius: 0;
                border-bottom-right-radius: 0;
                box-shadow: 0 6px 12px rgba(15, 23, 42, 0.03);
            }

        .section-left {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

            .section-left i {
                font-size: 1.1rem;
                flex: 0 0 auto;
            }

        .section-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .section-toggle-icon {
            flex: 0 0 auto;
            transition: transform var(--transition-smooth);
        }

        .menu-section-header[aria-expanded="true"] .section-toggle-icon {
            transform: rotate(180deg);
        }

        .menu-list {
            padding: 8px;
            background: #ffffff;
            border: 1px solid var(--border-color);
            border-top: none;
            border-bottom-left-radius: var(--radius-md);
            border-bottom-right-radius: var(--radius-md);
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 11px;
            min-height: 44px;
            padding: 10px 12px;
            color: var(--text-body);
            border-radius: 11px;
            font-size: 0.9rem;
            font-weight: 700;
            transition: var(--transition-fast);
            position: relative;
        }

            .menu-item:hover {
                background: #f8fafc;
                color: var(--primary-color);
                transform: translateX(3px);
            }

            .menu-item.active {
                background: var(--primary-soft);
                color: var(--primary-color);
                box-shadow: inset 3px 0 0 var(--primary-color);
            }

        .menu-icon {
            width: 23px;
            text-align: center;
            font-size: 1.12rem;
            flex: 0 0 auto;
        }

        .menu-text {
            flex: 1;
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .menu-badge {
            margin-left: auto;
            min-width: 23px;
            height: 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 7px;
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 900;
        }

        .menu-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 8px;
            border-radius: 999px;
            background: #f8fafc;
            color: var(--text-muted);
            font-size: 0.68rem;
            font-weight: 900;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .menu-divider {
            margin: 16px 8px;
            border-color: #e2e8f0;
            opacity: 1;
        }

        .main-panel {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left var(--transition-smooth);
        }

        body.sidebar-collapsed .sidebar-wrapper {
            width: var(--sidebar-collapsed-width);
        }

        body.sidebar-collapsed .main-panel {
            margin-left: var(--sidebar-collapsed-width);
        }

        body.sidebar-collapsed .brand-title,
        body.sidebar-collapsed .brand-subtitle,
        body.sidebar-collapsed .role-badge,
        body.sidebar-collapsed .small-note,
        body.sidebar-collapsed .section-title,
        body.sidebar-collapsed .section-toggle-icon,
        body.sidebar-collapsed .menu-text,
        body.sidebar-collapsed .menu-badge,
        body.sidebar-collapsed .menu-chip {
            display: none !important;
        }

        body.sidebar-collapsed .menu-top-card {
            padding: 10px;
            background: transparent;
            border: none;
            box-shadow: none;
        }

        body.sidebar-collapsed .menu-section-header {
            justify-content: center;
            padding: 13px 0;
            border-radius: 14px;
        }

        body.sidebar-collapsed .section-left {
            justify-content: center;
        }

        body.sidebar-collapsed .menu-list {
            display: none !important;
        }

        body.sidebar-collapsed .menu-item {
            justify-content: center;
            padding: 12px 0;
        }

        body.sidebar-collapsed .menu-icon {
            width: auto;
            font-size: 1.35rem;
        }

        .top-header {
            height: var(--header-height);
            position: sticky;
            top: 0;
            z-index: 1030;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 0 28px;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
        }

        .btn-toggle-sidebar,
        .top-icon-btn {
            width: 43px;
            height: 43px;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            background: #ffffff;
            color: #475569;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition-fast);
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        }

            .btn-toggle-sidebar:hover,
            .top-icon-btn:hover {
                background: var(--primary-soft);
                color: var(--primary-color);
                border-color: var(--primary-border);
                transform: translateY(-1px);
            }

        .header-title h4 {
            margin: 0;
            color: var(--text-main);
            font-weight: 900;
            letter-spacing: -0.45px;
        }

        .header-title small {
            color: var(--text-muted);
            font-weight: 800;
            letter-spacing: 0.55px;
            text-transform: uppercase;
            font-size: 0.72rem;
        }

        .user-profile-pill {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 5px 6px 5px 14px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 999px;
            cursor: pointer;
            transition: var(--transition-fast);
            box-shadow: 0 8px 18px rgba(15, 23, 42, 0.04);
        }

            .user-profile-pill:hover {
                border-color: var(--primary-border);
                background: #f8fafc;
            }

            .user-profile-pill h6 {
                margin: 0;
                font-size: 0.92rem;
                font-weight: 900;
                line-height: 1.15;
            }

            .user-profile-pill small {
                color: var(--primary-color);
                font-size: 0.73rem;
                font-weight: 800;
            }

        .content-body {
            flex: 1;
            padding: 28px;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, max-content));
            gap: 12px;
            margin-bottom: 22px;
        }

        .btn-quick {
            border: 0;
            border-radius: 16px;
            padding: 12px 18px;
            color: #ffffff;
            font-size: 0.92rem;
            font-weight: 900;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            transition: var(--transition-smooth);
            box-shadow: 0 14px 24px rgba(15, 23, 42, 0.12);
        }

            .btn-quick:hover {
                color: #ffffff;
                transform: translateY(-2px);
                filter: brightness(1.02);
            }

        .btn-q-consult {
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .btn-q-chat {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
        }

        .btn-q-appt {
            background: linear-gradient(135deg, #10b981, #047857);
        }

        .bell-shake {
            animation: bellShake 2s infinite;
            transform-origin: top center;
            display: inline-block;
        }

        @@keyframes bellShake {
            0%, 100% {
                transform: rotate(0);
            }

            10%, 30%, 50% {
                transform: rotate(12deg);
            }

            20%, 40% {
                transform: rotate(-12deg);
            }

            60% {
                transform: rotate(0);
            }
        }

        @@media (max-width: 1199.98px) {
            .sidebar-wrapper {
                width: min(88vw, 330px);
                transform: translateX(-100%);
            }

                .sidebar-wrapper.show {
                    transform: translateX(0);
                }

            .main-panel,
            body.sidebar-collapsed .main-panel {
                margin-left: 0;
            }

            body.sidebar-collapsed .sidebar-wrapper {
                width: min(88vw, 330px);
                transform: translateX(-100%);
            }

                body.sidebar-collapsed .sidebar-wrapper.show {
                    transform: translateX(0);
                }

            body.sidebar-collapsed .brand-title,
            body.sidebar-collapsed .brand-subtitle,
            body.sidebar-collapsed .role-badge,
            body.sidebar-collapsed .small-note,
            body.sidebar-collapsed .section-title,
            body.sidebar-collapsed .section-toggle-icon,
            body.sidebar-collapsed .menu-text,
            body.sidebar-collapsed .menu-badge,
            body.sidebar-collapsed .menu-chip {
                display: inline-flex !important;
            }

            body.sidebar-collapsed .brand-title,
            body.sidebar-collapsed .brand-subtitle,
            body.sidebar-collapsed .small-note,
            body.sidebar-collapsed .section-title,
            body.sidebar-collapsed .menu-text {
                display: block !important;
            }

            body.sidebar-collapsed .menu-list {
                display: block !important;
            }

            body.sidebar-collapsed .menu-top-card {
                padding: 15px;
                background: linear-gradient(135deg, rgba(37, 99, 235, 0.08), rgba(14, 165, 233, 0.04)), #ffffff;
                border: 1px solid #e6eefb;
                box-shadow: var(--shadow-soft);
            }

            body.sidebar-collapsed .menu-section-header {
                justify-content: space-between;
                padding: 12px 14px;
            }

            body.sidebar-collapsed .menu-item {
                justify-content: flex-start;
                padding: 10px 12px;
            }

            body.sidebar-collapsed .menu-icon {
                width: 23px;
                font-size: 1.12rem;
            }
        }

        @@media (max-width: 767.98px) {
            .top-header {
                height: 70px;
                padding: 0 14px;
            }

            .content-body {
                padding: 18px 12px;
            }

            .header-title {
                display: none;
            }

            .user-profile-pill {
                padding: 5px;
            }

                .user-profile-pill .user-meta {
                    display: none;
                }

            .quick-actions {
                grid-template-columns: 1fr;
            }

            .btn-quick {
                width: 100%;
                padding: 14px;
            }
        }
    </style>
</head>
<body>
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <aside class="sidebar-wrapper" id="sidebar">
        <div class="sidebar-brand">
            <a href="/">
                <div class="brand-avatar">
                    <i class="bi bi-buildings-fill fs-5"></i>
                </div>
                <div class="brand-text-wrap">
                    <p class="brand-title">BĐS Khánh Hòa</p>
                    <p class="brand-subtitle">Member Center</p>
                </div>
            </a>
            <button type="button" class="btn-close d-xl-none bg-light p-2 rounded-circle border" id="btnCloseSidebar" aria-label="Đóng menu"></button>
        </div>

        <div class="sidebar-content">
            <div class="menu-top-card">
                @if (isAdminOrStaff)
                {
                    <span class="role-badge role-admin"><i class="bi bi-shield-check"></i> Quản trị hệ thống</span>
                    <div class="small-note">Trung tâm điều hành, kiểm duyệt tin đăng, dự án, người dùng và tương tác hệ thống.</div>
                }
                else
                {
                    <span class="role-badge role-member"><i class="bi bi-person-vcard"></i> Tài khoản cá nhân</span>
                    <div class="small-note">Một tài khoản dùng được cả hai vai trò: tìm mua, hỏi tư vấn, đăng bán và trả lời khách.</div>
                }
            </div>

            <div class="menu-section">
                <a href="/Dashboard/Index" class="menu-item @(currentController == "Dashboard" && currentAction == "Index" ? "active" : "")" title="Bảng điều khiển">
                    <i class="bi bi-grid-1x2-fill menu-icon text-primary"></i>
                    <span class="menu-text">Bảng điều khiển chung</span>
                </a>
            </div>

            <div class="menu-section">
                <button class="menu-section-header" type="button" data-bs-toggle="collapse" data-bs-target="#menuBuyer" aria-expanded="false" aria-controls="menuBuyer" data-default-state="open">
                    <span class="section-left">
                        <i class="bi bi-bag-heart-fill text-success"></i>
                        <span class="section-title">Tôi là người mua</span>
                    </span>
                    <i class="bi bi-chevron-down section-toggle-icon"></i>
                </button>

                <div class="collapse menu-list" id="menuBuyer">
                    <a href="/Property/Search" class="menu-item @(currentController == "Property" && currentAction == "Search" ? "active" : "")">
                        <i class="bi bi-search menu-icon text-success"></i>
                        <span class="menu-text">Tìm bất động sản</span>
                        <span class="menu-chip">Tìm mua</span>
                    </a>

                    <a href="/Appointments/Index?tab=outgoing" class="menu-item @(currentController == "Appointments" && currentTab == "outgoing" ? "active" : "")">
                        <i class="bi bi-calendar2-check-fill menu-icon text-success"></i>
                        <span class="menu-text">Lịch tôi hẹn đi xem</span>
                    </a>

                    <a href="/Favorite/Index" class="menu-item @(currentController == "Favorite" ? "active" : "")">
                        <i class="bi bi-heart-fill menu-icon text-danger"></i>
                        <span class="menu-text">BĐS tôi đã lưu</span>
                    </a>

                    <a href="/Consultations/MyRequests" class="menu-item @(currentController == "Consultations" && currentAction == "MyRequests" ? "active" : "")">
                        <i class="bi bi-question-circle-fill menu-icon text-warning"></i>
                        <span class="menu-text">Tư vấn tôi đã gửi</span>
                    </a>
                </div>
            </div>

            <div class="menu-section">
