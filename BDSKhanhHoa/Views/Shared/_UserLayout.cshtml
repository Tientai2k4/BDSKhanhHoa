                    </a>

                    <a href="/Consultations/Index" class="menu-item @(currentController == "Consultations" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-people-fill menu-icon text-success"></i>
                        <span class="menu-text">Khách hỏi tư vấn tin của tôi</span>
                        @if (newLeadsCount > 0)
                        {
                            <span class="badge bg-danger menu-badge">@newLeadsCount</span>
                        }
                    </a>

                    <a href="/Comments/MyPropertyComments" class="menu-item @(currentController == "Comments" && currentAction == "MyPropertyComments" ? "active" : "")">
                        <i class="bi bi-chat-left-quote-fill menu-icon text-info"></i>
                        <span class="menu-text">Bình luận trong tin của tôi</span>
                        @if (unreadComments > 0)
