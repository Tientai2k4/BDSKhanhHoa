                        }
                    </a>
                </div>
            </div>

            <div class="menu-section">
                <button class="menu-section-header" type="button" data-bs-toggle="collapse" data-bs-target="#menuInteraction" aria-expanded="false" aria-controls="menuInteraction" data-default-state="open">
                    <span class="section-left">
                        <i class="bi bi-chat-dots-fill text-info"></i>
                        <span class="section-title">Trung tâm trao đổi</span>
                    </span>
                    <i class="bi bi-chevron-down section-toggle-icon"></i>
                </button>

                <div class="collapse menu-list" id="menuInteraction">
                    <a href="/UserMessage/Index" class="menu-item @(currentController == "UserMessage" ? "active" : "")">
                        <i class="bi bi-envelope-paper-fill menu-icon text-primary"></i>
                        <span class="menu-text">Chat tư vấn mua/bán</span>
                        @if (unreadMessages > 0)
                        {
                            <span class="badge bg-danger menu-badge">@unreadMessages</span>
                        }
                    </a>

                    <a href="/Notification/Index" class="menu-item @(currentController == "Notification" ? "active" : "")">
                        <i class="bi bi-bell-fill menu-icon text-warning"></i>
                        <span class="menu-text">Thông báo của tôi</span>
                        @if (totalSystemAlerts > 0)
                        {
                            <span class="badge bg-danger menu-badge">@(totalSystemAlerts > 99 ? "99+" : totalSystemAlerts)</span>
                        }
