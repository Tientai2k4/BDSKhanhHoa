                        <i class="bi bi-shop text-primary"></i>
                        <span class="section-title">Tôi là người bán</span>
                    </span>
                    <i class="bi bi-chevron-down section-toggle-icon"></i>
                </button>

                <div class="collapse menu-list" id="menuSeller">
                    <a href="/Property/Create" class="menu-item @(currentController == "Property" && currentAction == "Create" ? "active" : "")">
                        <i class="bi bi-plus-square-fill menu-icon text-success"></i>
                        <span class="menu-text">Đăng tin rao bán mới</span>
                    </a>

                    <a href="/Property/MyAds" class="menu-item @(currentController == "Property" && currentAction == "MyAds" ? "active" : "")">
                        <i class="bi bi-card-list menu-icon text-primary"></i>
                        <span class="menu-text">Quản lý tin tôi đăng</span>
                    </a>

                    <a href="/Appointments/Index?tab=incoming" class="menu-item @(currentController == "Appointments" && currentTab == "incoming" ? "active" : "")">
                        <i class="bi bi-calendar-range-fill menu-icon text-warning"></i>
                        <span class="menu-text">Lịch khách hẹn đến xem</span>
                        @if (pendingAppointments > 0)
                        {
                            <span class="badge bg-danger menu-badge">@pendingAppointments</span>
