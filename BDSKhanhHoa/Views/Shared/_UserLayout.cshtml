                            <i class="bi bi-gem text-warning"></i>
                            <span class="section-title">Dịch vụ & VIP</span>
                        </span>
                        <i class="bi bi-chevron-down section-toggle-icon"></i>
                    </button>

                    <div class="collapse menu-list" id="menuVip">
                        <a href="/Package/Buy" class="menu-item @(currentController == "Package" ? "active" : "")">
                            <i class="bi bi-gem menu-icon text-warning"></i>
                            <span class="menu-text">Mua gói đăng tin</span>
                        </a>
                        <a href="/Voucher/MyVouchers" class="menu-item @(currentController == "Voucher" ? "active" : "")">
                            <i class="bi bi-ticket-detailed-fill menu-icon text-danger"></i>
                            <span class="menu-text">Kho Voucher của tôi</span>
