@*
    File: Views/Shared/_AiChatbotWidget.cshtml
    Chatbot AI BDSKhanhHoa - bản reset phiên mới:
    - Không phụ thuộc jQuery
    - Không lưu lịch sử chat vào localStorage
    - Đóng chatbot hoặc bấm Làm mới sẽ xóa nội dung cũ và tạo session mới
    - Trong lúc widget đang mở vẫn nhớ ngữ cảnh để hỏi/đáp liên tục
    - Hiển thị card bất động sản từ SuggestedProperties
*@

<div class="bds-ai-chatbot-btn" id="bdsAiChatbotToggle" title="Trợ lý AI BĐS Khánh Hòa" role="button" aria-label="Mở trợ lý AI">
    <i class="bi bi-robot"></i>
</div>

<div id="bdsAiChatWidget" class="bds-ai-chat-widget" aria-label="Trợ lý AI BĐS Khánh Hòa">
    <div class="bds-ai-chat-header">
        <div class="bds-ai-chat-header-left">
            <div class="bds-ai-avatar"><i class="bi bi-stars"></i></div>
            <div class="bds-ai-header-text">
                <h6>Trợ lý AI BĐS Khánh Hòa</h6>
                <small>Tư vấn BĐS · pháp lý · vay vốn · nguồn tham khảo</small>
            </div>
        </div>

        <div class="bds-ai-header-actions">
            <button type="button" class="bds-ai-header-btn" id="bdsAiChatReset" title="Làm mới phiên chat" aria-label="Làm mới phiên chat">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
            <button type="button" class="bds-ai-header-btn" id="bdsAiChatClose" title="Đóng chatbot" aria-label="Đóng chatbot">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div id="bdsAiChatBody" class="bds-ai-chat-body"></div>

    <div id="bdsAiSuggestedReplies" class="bds-ai-suggested-replies"></div>

    <div class="bds-ai-chat-footer">
        <div class="bds-ai-input-row">
            <input id="bdsAiChatInput"
                   type="text"
                   class="bds-ai-input"
                   placeholder="Nhập nhu cầu, ví dụ: Tôi muốn mua đất Nha Trang dưới 1 tỷ..."
                   autocomplete="off" />
            <button id="bdsAiChatSendBtn" class="bds-ai-send-btn" type="button" aria-label="Gửi tin nhắn">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
        <div class="bds-ai-note">
            AI chỉ hỗ trợ tư vấn ban đầu, không thay thế luật sư, ngân hàng, công chứng viên hoặc cơ quan nhà nước.
        </div>
    </div>
</div>

