<script>
    (function () {
        const toggle = document.getElementById('bdsAiChatbotToggle');
        const widget = document.getElementById('bdsAiChatWidget');
        const closeBtn = document.getElementById('bdsAiChatClose');
        const resetBtn = document.getElementById('bdsAiChatReset');
        const body = document.getElementById('bdsAiChatBody');
        const input = document.getElementById('bdsAiChatInput');
        const sendBtn = document.getElementById('bdsAiChatSendBtn');
        const repliesBox = document.getElementById('bdsAiSuggestedReplies');
        if (!toggle || !widget || !body || !input || !sendBtn) return;

        // Không lưu localStorage nữa. Xóa luôn dữ liệu cũ từ bản trước để tránh hiện lịch sử cũ.
        try {
            localStorage.removeItem('bds_ai_v2_session_id');
            localStorage.removeItem('bds_ai_v2_history');
            localStorage.removeItem('bds_ai_session_id');
            localStorage.removeItem('bds_ai_history');
        } catch (e) { }

        let sessionId = '';
        let sending = false;
        let initialized = false;

        resetConversation();

        toggle.addEventListener('click', function () {
            const willOpen = !widget.classList.contains('is-open');
            if (willOpen && !initialized) resetConversation();
            widget.classList.toggle('is-open');
            if (widget.classList.contains('is-open')) input.focus();
        });

        closeBtn.addEventListener('click', function () {
            widget.classList.remove('is-open');
            // Đóng chatbot là kết thúc phiên chat hiện tại. Mở lại sẽ bắt đầu phiên mới.
            resetConversation();
        });

        if (resetBtn) {
            resetBtn.addEventListener('click', function () {
                resetConversation();
                input.focus();
            });
        }

        sendBtn.addEventListener('click', function () { sendMessage(input.value); });
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage(input.value);
            }
        });

        function resetConversation() {
            sessionId = '';
            initialized = true;
            body.innerHTML = '';
            repliesBox.innerHTML = '';
            input.value = '';
            removeTyping();
            appendMessage('Chào Anh/Chị! Em là trợ lý AI BĐS Khánh Hòa. Anh/Chị có thể hỏi em về tìm mua, thuê, pháp lý, giao dịch, vay vốn, đăng tin hoặc phân tích tin đang xem.', 'bot');
            renderSuggestedReplies(['Tôi muốn mua đất', 'Tôi muốn thuê nhà', 'Mua đất cần kiểm tra gì?', 'Hướng dẫn đăng tin']);
        }

        function escapeHtml(value) {
            return String(value || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function renderMarkdown(text) {
            let html = escapeHtml(text || '');

            // Markdown cơ bản: **đậm**
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

            // Markdown link: [Tên nguồn](https://...)
            html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, function (_, label, url) {
                return '<a href="' + url + '" target="_blank" rel="noopener noreferrer nofollow">' + label + '</a>';
            });

            // Link thô nếu AI trả trực tiếp URL
            html = html.replace(/(^|\s)(https?:\/\/[^\s<]+)/g, function (_, prefix, url) {
                return prefix + '<a href="' + url + '" target="_blank" rel="noopener noreferrer nofollow">' + url + '</a>';
            });

            html = html.replace(/\n\s*\n/g, '</p><p>');
            html = html.replace(/\n/g, '<br>');
            return '<p>' + html + '</p>';
        }

        function scrollBottom() { body.scrollTop = body.scrollHeight; }

        function appendMessage(text, sender) {
            const wrapper = document.createElement('div');
            wrapper.className = 'bds-ai-message ' + sender;
            const bubble = document.createElement('div');
            bubble.className = 'bds-ai-bubble';
            bubble.innerHTML = sender === 'bot' ? renderMarkdown(text || '') : escapeHtml(text || '').replace(/\n/g, '<br>');
            wrapper.appendChild(bubble);
            body.appendChild(wrapper);
            scrollBottom();
        }

        function appendTyping() {
            removeTyping();
            const wrapper = document.createElement('div');
            wrapper.className = 'bds-ai-message bot bds-ai-typing-message';
            const bubble = document.createElement('div');
            bubble.className = 'bds-ai-bubble';
            bubble.innerHTML = '<div class="bds-ai-typing"><span></span><span></span><span></span></div>';
            wrapper.appendChild(bubble);
            body.appendChild(wrapper);
            scrollBottom();
        }

        function removeTyping() {
            body.querySelectorAll('.bds-ai-typing-message').forEach(function (item) { item.remove(); });
        }

        function renderPropertyCards(properties) {
            if (!Array.isArray(properties) || properties.length === 0) return;
            let html = '<div class="bds-ai-property-list">';
            properties.forEach(function (p) {
                const title = escapeHtml(p.title || p.Title || 'Bất động sản');
                const price = escapeHtml(p.price || p.Price || 'Thỏa thuận');
                const areaSize = escapeHtml(p.areaSize || p.AreaSize || '');
                const location = escapeHtml(p.location || p.Location || '');
                const propertyTypeName = escapeHtml(p.propertyTypeName || p.PropertyTypeName || '');
                const reason = escapeHtml(p.reasonMatched || p.ReasonMatched || '');
                const link = escapeHtml(p.link || p.Link || '#');
                const image = escapeHtml(p.image || p.Image || '/images/no-image.png');
                html += `
                    <div class="bds-ai-property-card">
                        <div class="bds-ai-property-img"><img src="${image}" alt="${title}" onerror="this.src='/images/no-image.png'"></div>
                        <div class="bds-ai-property-info">
                            <div class="bds-ai-property-title">${title}</div>
                            <div class="bds-ai-property-price">${price}</div>
                            ${areaSize ? `<div class="bds-ai-property-meta"><i class="bi bi-aspect-ratio"></i> ${areaSize}</div>` : ''}
                            ${location ? `<div class="bds-ai-property-meta"><i class="bi bi-geo-alt"></i> ${location}</div>` : ''}
                            ${propertyTypeName ? `<div class="bds-ai-property-meta"><i class="bi bi-house-door"></i> ${propertyTypeName}</div>` : ''}
                            ${reason ? `<div class="bds-ai-property-reason">Phù hợp vì: ${reason}</div>` : ''}
                            <a href="${link}" class="bds-ai-property-link">Xem chi tiết</a>
                        </div>
                    </div>`;
            });
            html += '</div>';
            body.insertAdjacentHTML('beforeend', html);
            scrollBottom();
        }

        function renderSuggestedReplies(replies) {
            repliesBox.innerHTML = '';
            if (!Array.isArray(replies) || replies.length === 0) return;
            replies.slice(0, 6).forEach(function (text) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'bds-ai-chip';
                btn.textContent = text;
                btn.addEventListener('click', function () { sendMessage(text); });
                repliesBox.appendChild(btn);
            });
        }

        function getMetaContent(name) {
            const el = document.querySelector(`meta[name="${name}"]`);
            return el ? (el.getAttribute('content') || '').trim() : '';
        }

        function detectPageType() {
            const path = (window.location.pathname || '').toLowerCase();
            const metaType = getMetaContent('chatbot-page-type');
            if (metaType) return metaType;
            if (path.includes('/property/details')) return 'PropertyDetail';
            if (path.includes('/project/details')) return 'ProjectDetail';
            if (path.includes('/batdongsan/nhadatban')) return 'PropertyListSale';
            if (path.includes('/batdongsan/nhadatchothue')) return 'PropertyListRent';
            if (path === '/project' || path.includes('/project/search')) return 'ProjectList';
            if (path.includes('/property/create')) return 'CreateProperty';
            if (path.includes('/property/myads')) return 'MyAds';
            if (path.includes('/account')) return 'Account';
            if (path.includes('/contact')) return 'Contact';
            if (path.includes('/admin')) return 'Admin';
            return 'General';
        }

        function buildPageContext() {
            const parts = [];
            const pageType = detectPageType();
            parts.push('[THÔNG TIN TRANG HIỆN TẠI]');
            parts.push('Loại trang: ' + pageType);
            parts.push('URL hiện tại: ' + (window.location.pathname || ''));
            parts.push('Tiêu đề trình duyệt: ' + (document.title || ''));

            const directContext = getMetaContent('chatbot-context');
            if (directContext) { parts.push(''); parts.push('[NGỮ CẢNH CHÍNH DO TRANG CUNG CẤP]'); parts.push(directContext); }

            const propFields = [
                ['ID tin', 'chatbot-property-id'], ['Tiêu đề tin', 'chatbot-property-title'], ['Giá', 'chatbot-property-price'], ['Diện tích', 'chatbot-property-area'],
                ['Đơn giá', 'chatbot-property-unit-price'], ['Vị trí', 'chatbot-property-location'], ['Khu vực', 'chatbot-property-region'], ['Phường/Xã', 'chatbot-property-ward'],
                ['Loại BĐS', 'chatbot-property-type'], ['Pháp lý', 'chatbot-property-legal'], ['Phòng ngủ', 'chatbot-property-bedrooms'], ['Phòng tắm', 'chatbot-property-bathrooms'],
                ['Hướng nhà', 'chatbot-property-direction'], ['Tiện ích', 'chatbot-property-utilities'], ['Tình trạng tin', 'chatbot-property-status'], ['Ngày đăng', 'chatbot-property-posted-date'],
                ['Người đăng', 'chatbot-property-owner'], ['Mô tả', 'chatbot-property-description']
            ];
            const propLines = propFields.map(function (f) { const v = getMetaContent(f[1]); return v ? f[0] + ': ' + v : ''; }).filter(Boolean);
            if (propLines.length) { parts.push(''); parts.push('[THÔNG TIN TIN BẤT ĐỘNG SẢN]'); parts.push(...propLines); }

            const projectFields = [
                ['ID dự án', 'chatbot-project-id'], ['Tên dự án', 'chatbot-project-name'], ['Chủ đầu tư', 'chatbot-project-investor'], ['Khu vực', 'chatbot-project-location'],
                ['Giá', 'chatbot-project-price'], ['Quy mô', 'chatbot-project-scale'], ['Loại sản phẩm', 'chatbot-project-product-type'], ['Tiến độ', 'chatbot-project-progress'],
                ['Pháp lý', 'chatbot-project-legal'], ['Trạng thái', 'chatbot-project-status'], ['Mô tả', 'chatbot-project-description']
            ];
            const projectLines = projectFields.map(function (f) { const v = getMetaContent(f[1]); return v ? f[0] + ': ' + v : ''; }).filter(Boolean);
            if (projectLines.length) { parts.push(''); parts.push('[THÔNG TIN DỰ ÁN]'); parts.push(...projectLines); }

            if ((pageType === 'PropertyDetail' || pageType === 'ProjectDetail') && !directContext) {
                const main = document.querySelector('main') || document.querySelector('.container') || document.body;
                let visibleText = main ? (main.innerText || '').replace(/\s+/g, ' ').trim() : '';
                visibleText = visibleText.replace(/Trợ lý AI BĐS Khánh Hòa.*$/i, '').trim();
                if (visibleText.length > 120) {
                    parts.push('');
                    parts.push('[VĂN BẢN HIỂN THỊ TRÊN TRANG - RÚT GỌN]');
                    parts.push(visibleText.substring(0, 3500));
                }
            }

            return parts.join('\n').substring(0, 10000);
        }

        async function sendMessage(rawText) {
            const text = (rawText || '').trim();
            if (!text || sending) return;
            input.value = '';
            repliesBox.innerHTML = '';
            appendMessage(text, 'user');
            appendTyping();
            sending = true;
            sendBtn.disabled = true;

            try {
                const response = await fetch('/api/chatbot/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: text,
                        sessionId: sessionId || '',
                        pageType: detectPageType(),
                        pageUrl: window.location.pathname + window.location.search,
                        pageTitle: document.title || '',
                        pageContext: buildPageContext()
                    })
                });
                removeTyping();
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const data = await response.json();
                if (data.sessionId || data.SessionId) sessionId = data.sessionId || data.SessionId;
                appendMessage(data.message || data.Message || 'Em chưa có phản hồi phù hợp.', 'bot');
                renderPropertyCards(data.suggestedProperties || data.SuggestedProperties || []);
                renderSuggestedReplies(data.suggestedReplies || data.SuggestedReplies || []);
            } catch (err) {
                removeTyping();
                appendMessage('Xin lỗi Anh/Chị, hiện chatbot phản hồi chưa thành công. Anh/Chị thử gửi lại câu hỏi hoặc kiểm tra kết nối giúp em nhé.', 'bot');
            } finally {
                sending = false;
                sendBtn.disabled = false;
                input.focus();
            }
        }
    })();
</script>
