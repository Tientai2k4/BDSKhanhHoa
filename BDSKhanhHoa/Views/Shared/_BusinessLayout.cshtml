@using BDSKhanhHoa.Data
@using BDSKhanhHoa.Models
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context

@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int currentUserId);

    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
    string pageTitle = ViewData["Title"]?.ToString() ?? "Cổng đối tác";

    User? currentUser = null;
    BusinessProfile? businessProfile = null;

    if (currentUserId > 0)
    {
        currentUser = _context.Users
            .AsNoTracking()
            .FirstOrDefault(u => u.UserID == currentUserId);

        businessProfile = _context.BusinessProfiles
            .AsNoTracking()
            .FirstOrDefault(b => b.UserID == currentUserId);
    }

    string userAvatar = User.FindFirst("Avatar")?.Value
        ?? currentUser?.Avatar
        ?? "/images/avatars/default-business.png";

    string businessName = businessProfile?.BusinessName
        ?? currentUser?.FullName
        ?? User.Identity?.Name
        ?? "Doanh nghiệp đối tác";

    string representativeName = businessProfile?.RepresentativeName
        ?? currentUser?.FullName
        ?? User.Identity?.Name
        ?? "Quản lý dự án";

    string representativePhone = businessProfile?.RepresentativePhone
        ?? currentUser?.Phone
        ?? "Chưa cập nhật";

    string businessEmail = businessProfile?.BusinessEmail
        ?? currentUser?.Email
        ?? "Chưa cập nhật";

    string verificationStatus = businessProfile?.VerificationStatus ?? "Pending";

    bool isVerifiedBusiness =
        verificationStatus == "Approved" ||
        verificationStatus == "Đã duyệt" ||
        verificationStatus == "Đã xác minh";

    bool isPendingBusiness =
        verificationStatus == "Pending" ||
        verificationStatus == "Chờ duyệt";

    bool isRejectedBusiness =
        verificationStatus == "Rejected" ||
        verificationStatus == "Từ chối" ||
        verificationStatus == "Bị từ chối";

    int projectCount = 0;
    int approvedProjectCount = 0;
    int pendingProjectCount = 0;
    int newLeadCount = 0;
    int totalLeadCount = 0;
    int appointmentCount = 0;
    int todayAppointmentCount = 0;
    int supportPendingCount = 0;
    int notificationCount = 0;

    if (currentUserId > 0)
    {
        projectCount = _context.Projects
            .AsNoTracking()
            .Count(p => p.OwnerUserID == currentUserId && !p.IsDeleted);

        approvedProjectCount = _context.Projects
            .AsNoTracking()
            .Count(p =>
                p.OwnerUserID == currentUserId &&
                !p.IsDeleted &&
                (
                    p.ApprovalStatus == "Approved" ||
                    p.ApprovalStatus == "Đã duyệt"
                ));

        pendingProjectCount = _context.Projects
            .AsNoTracking()
            .Count(p =>
                p.OwnerUserID == currentUserId &&
                !p.IsDeleted &&
                (
                    p.ApprovalStatus == "Pending" ||
                    p.ApprovalStatus == "Chờ duyệt"
                ));

        totalLeadCount = _context.ProjectLeads
            .AsNoTracking()
            .Include(l => l.Project)
            .Count(l =>
                l.Project != null &&
                l.Project.OwnerUserID == currentUserId);

        newLeadCount = _context.ProjectLeads
            .AsNoTracking()
            .Include(l => l.Project)
            .Count(l =>
                l.Project != null &&
                l.Project.OwnerUserID == currentUserId &&
                (
                    l.LeadStatus == "New" ||
                    l.LeadStatus == "Mới"
                ));

        DateTime today = DateTime.Now.Date;

        appointmentCount = _context.Appointments
            .AsNoTracking()
            .Count(a =>
                a.BuyerID == currentUserId ||
                a.SellerID == currentUserId);

        todayAppointmentCount = _context.Appointments
            .AsNoTracking()
            .Count(a =>
                (a.BuyerID == currentUserId || a.SellerID == currentUserId) &&
                a.AppointmentDate >= today &&
                a.AppointmentDate < today.AddDays(1));

        supportPendingCount = _context.ContactMessages
            .AsNoTracking()
            .Count(x =>
                x.UserID == currentUserId &&
                (
                    x.Status == "Pending" ||
                    x.Status == "Chưa xử lý" ||
                    x.Status == "Chờ xử lý" ||
                    x.Status == "Đang xử lý"
                ));

        notificationCount = _context.Notifications
            .AsNoTracking()
            .Count(n => n.UserID == currentUserId && !n.IsRead);
    }

    bool IsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(string controller, string? action = null)
    {
        return IsActive(controller, action)
            ? "partner-menu-link active"
            : "partner-menu-link";
    }

    string GetVerificationText()
    {
        if (isVerifiedBusiness)
        {
            return "Đã xác minh";
        }

        if (isRejectedBusiness)
        {
            return "Bị từ chối";
        }

        if (isPendingBusiness)
        {
            return "Chờ xác minh";
        }

        return "Chưa xác minh";
    }

    string GetVerificationClass()
    {
        if (isVerifiedBusiness)
        {
            return "verified";
        }

        if (isRejectedBusiness)
        {
            return "rejected";
        }

        if (isPendingBusiness)
        {
            return "pending";
        }

        return "pending";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Cổng đối tác dự án BĐS Khánh Hòa" />

    <title>@pageTitle | Cổng Đối Tác - BĐS Khánh Hòa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --partner-primary: #2563eb;
            --partner-primary-2: #1d4ed8;
            --partner-cyan: #06b6d4;
            --partner-purple: #7c3aed;
            --partner-pink: #db2777;
            --partner-success: #059669;
            --partner-warning: #d97706;
            --partner-danger: #dc2626;
            --partner-dark: #0f172a;
            --partner-muted: #64748b;
            --partner-border: #e2e8f0;
            --partner-soft: #f8fafc;
            --partner-body: #f3f7fd;
            --partner-card: #ffffff;
            --partner-sidebar-width: 288px;
            --partner-header-height: 78px;
            --partner-radius-xl: 28px;
            --partner-radius-lg: 22px;
            --partner-radius-md: 16px;
            --partner-shadow: 0 20px 55px rgba(15, 23, 42, .09);
            --partner-shadow-soft: 0 12px 28px rgba(15, 23, 42, .06);
            --partner-transition: all .24s ease;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            color: var(--partner-dark);
            font-family: 'Be Vietnam Pro', sans-serif;
            font-size: .95rem;
            overflow-x: hidden;
            background: radial-gradient(circle at top left, rgba(37, 99, 235, .14), transparent 34rem), radial-gradient(circle at top right, rgba(124, 58, 237, .11), transparent 32rem), radial-gradient(circle at bottom right, rgba(6, 182, 212, .10), transparent 34rem), var(--partner-body);
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .partner-brand-title,
        .partner-page-title {
            font-family: 'Plus Jakarta Sans', 'Be Vietnam Pro', sans-serif;
            letter-spacing: -.025em;
        }

        a {
            text-decoration: none;
        }

        .partner-app {
            min-height: 100vh;
        }

        .partner-mobile-overlay {
            display: none;
        }

        .partner-sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: var(--partner-sidebar-width);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            background: radial-gradient(circle at 20% 0%, rgba(59, 130, 246, .20), transparent 17rem), linear-gradient(180deg, #0f172a 0%, #111827 48%, #020617 100%);
            color: #e5e7eb;
            box-shadow: 20px 0 55px rgba(15, 23, 42, .22);
            transition: var(--partner-transition);
        }

        .partner-sidebar-header {
            height: var(--partner-header-height);
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255, 255, 255, .08);
            flex-shrink: 0;
        }

        .partner-logo {
            width: 48px;
            height: 48px;
            border-radius: 18px;
            display: grid;
            place-items: center;
            color: #ffffff;
            font-size: 1.45rem;
            background: linear-gradient(135deg, #38bdf8, #2563eb 45%, #7c3aed);
            box-shadow: 0 16px 30px rgba(37, 99, 235, .34);
            flex-shrink: 0;
        }

        .partner-brand-title {
            color: #ffffff;
            font-size: 1rem;
            font-weight: 950;
            line-height: 1.1;
            white-space: nowrap;
        }

        .partner-brand-sub {
            margin-top: 4px;
            color: #94a3b8;
            font-size: .7rem;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .partner-business-box {
            margin: 16px 16px 8px;
            padding: 15px;
            border-radius: 22px;
            background: rgba(255, 255, 255, .075);
            border: 1px solid rgba(255, 255, 255, .10);
            backdrop-filter: blur(14px);
        }

        .business-box-top {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .business-avatar {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            object-fit: cover;
            background: #e2e8f0;
            border: 2px solid rgba(255, 255, 255, .22);
            flex-shrink: 0;
        }

        .business-name {
            color: #ffffff;
            font-size: .88rem;
            font-weight: 900;
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .business-representative {
            color: #94a3b8;
            font-size: .73rem;
            font-weight: 700;
            line-height: 1.35;
            margin-top: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .verify-pill {
            margin-top: 13px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 32px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 950;
        }

            .verify-pill.verified {
                color: #bbf7d0;
                background: rgba(5, 150, 105, .18);
                border: 1px solid rgba(34, 197, 94, .28);
            }

            .verify-pill.pending {
                color: #fde68a;
                background: rgba(217, 119, 6, .17);
                border: 1px solid rgba(245, 158, 11, .28);
            }

            .verify-pill.rejected {
                color: #fecaca;
                background: rgba(220, 38, 38, .17);
                border: 1px solid rgba(248, 113, 113, .28);
            }

        .partner-sidebar-body {
            padding: 10px 16px 14px;
            overflow-y: auto;
            flex: 1;
            scrollbar-width: thin;
            scrollbar-color: rgba(148, 163, 184, .5) transparent;
        }

        .partner-menu-title {
            margin: 20px 0 10px 10px;
            color: #94a3b8;
            font-size: .68rem;
            font-weight: 950;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .partner-menu-link {
            position: relative;
            min-height: 50px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 13px;
            margin-bottom: 7px;
            border-radius: 17px;
            color: #cbd5e1;
            font-weight: 850;
            border: 1px solid transparent;
            transition: var(--partner-transition);
        }

            .partner-menu-link i {
                width: 25px;
                text-align: center;
                font-size: 1.18rem;
                color: #94a3b8;
                transition: var(--partner-transition);
            }

            .partner-menu-link span {
                min-width: 0;
            }

            .partner-menu-link:hover {
                color: #ffffff;
                background: rgba(255, 255, 255, .095);
                border-color: rgba(255, 255, 255, .10);
                transform: translateX(3px);
            }

                .partner-menu-link:hover i {
                    color: #38bdf8;
                }

            .partner-menu-link.active {
                color: #ffffff;
                background: linear-gradient(135deg, #2563eb, #7c3aed);
                box-shadow: 0 16px 30px rgba(37, 99, 235, .28);
            }

                .partner-menu-link.active i {
                    color: #ffffff;
                }

        .partner-badge {
            margin-left: auto;
            min-width: 24px;
            height: 24px;
            padding: 0 8px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #ef4444;
            color: #fff;
            font-size: .72rem;
            font-weight: 950;
            box-shadow: 0 8px 16px rgba(239, 68, 68, .22);
        }

            .partner-badge.soft {
                background: rgba(56, 189, 248, .16);
                color: #7dd3fc;
                box-shadow: none;
            }

        .partner-menu-link.active .partner-badge.soft {
            background: rgba(255, 255, 255, .20);
            color: #ffffff;
        }

        .partner-sidebar-note {
            margin-top: 18px;
            padding: 15px;
            border-radius: 20px;
            color: #bfdbfe;
            background: rgba(37, 99, 235, .14);
            border: 1px dashed rgba(147, 197, 253, .38);
            font-size: .78rem;
            line-height: 1.55;
            font-weight: 720;
        }

        .partner-sidebar-footer {
            padding: 15px 16px 18px;
            border-top: 1px solid rgba(255, 255, 255, .08);
            flex-shrink: 0;
        }

        .partner-logout-btn {
            width: 100%;
            min-height: 46px;
            border-radius: 16px;
            border: 1px solid rgba(248, 113, 113, .25);
            background: rgba(220, 38, 38, .12);
            color: #fecaca;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-weight: 900;
            transition: var(--partner-transition);
        }

            .partner-logout-btn:hover {
                color: #ffffff;
                background: #dc2626;
                border-color: #dc2626;
            }

        .partner-main {
            margin-left: var(--partner-sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: var(--partner-transition);
        }

        .partner-topbar {
            position: sticky;
            top: 0;
            height: var(--partner-header-height);
            z-index: 1000;
            background: rgba(255, 255, 255, .84);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(148, 163, 184, .16);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 0 30px;
        }

        .partner-icon-btn {
            width: 46px;
            height: 46px;
            border-radius: 17px;
            border: 1px solid var(--partner-border);
            background: #ffffff;
            color: #475569;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: var(--partner-transition);
            position: relative;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
        }

            .partner-icon-btn:hover {
                color: #2563eb;
                border-color: rgba(37, 99, 235, .28);
                background: #eff6ff;
                transform: translateY(-1px);
            }

        .partner-notify-dot {
            position: absolute;
            top: 8px;
            right: 8px;
            min-width: 14px;
            height: 14px;
            border-radius: 999px;
            background: #ef4444;
            border: 2px solid #fff;
            box-shadow: 0 0 0 4px rgba(239, 68, 68, .12);
        }

        .partner-page-title {
            margin: 0;
            color: var(--partner-dark);
            font-size: 1.09rem;
            font-weight: 950;
            line-height: 1.2;
        }

        .partner-breadcrumb {
            margin-top: 4px;
            color: var(--partner-muted);
            font-size: .78rem;
            font-weight: 750;
        }

        .partner-user-chip {
            min-height: 48px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 999px;
            padding: 6px 7px 6px 14px;
            background: #ffffff;
            border: 1px solid var(--partner-border);
            box-shadow: 0 8px 22px rgba(15, 23, 42, .05);
        }

            .partner-user-chip img {
                width: 38px;
                height: 38px;
                border-radius: 14px;
                object-fit: cover;
                border: 1px solid #e2e8f0;
                background: #f1f5f9;
            }

        .partner-content {
            flex: 1;
            padding: 30px;
        }

        .partner-page-shell {
            max-width: 1540px;
            width: 100%;
            margin: 0 auto;
        }

        .partner-alert {
            border: 0;
            border-radius: 20px;
            background: #ffffff;
            box-shadow: var(--partner-shadow-soft);
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
        }

            .partner-alert.success {
                border-left: 5px solid var(--partner-success);
            }

            .partner-alert.error {
                border-left: 5px solid var(--partner-danger);
            }

        .partner-status-strip {
            display: none;
            margin-bottom: 18px;
            border-radius: 22px;
            padding: 15px;
            background: #ffffff;
            border: 1px solid var(--partner-border);
            box-shadow: var(--partner-shadow-soft);
        }

            .partner-status-strip.show {
                display: block;
            }

        .status-strip-inner {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .status-strip-icon {
            width: 44px;
            height: 44px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            color: #ffffff;
            background: linear-gradient(135deg, #f59e0b, #d97706);
        }

        .status-strip-title {
            color: var(--partner-dark);
            font-weight: 950;
            margin-bottom: 3px;
        }

        .status-strip-desc {
            color: var(--partner-muted);
            font-size: .85rem;
            font-weight: 650;
            line-height: 1.45;
        }

        .partner-footer {
            background: rgba(255, 255, 255, .78);
            border-top: 1px solid rgba(148, 163, 184, .16);
            padding: 16px 30px;
            color: var(--partner-muted);
            font-size: .83rem;
        }

        .footer-dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: var(--partner-success);
            display: inline-block;
            margin: 0 7px;
        }

        @@media (max-width: 1199.98px) {
            :root {
                --partner-sidebar-width: 272px;
            }

            .partner-content {
                padding: 24px;
            }
        }

        @@media (max-width: 991.98px) {
            .partner-sidebar {
                transform: translateX(-106%);
                box-shadow: 26px 0 70px rgba(15, 23, 42, .32);
            }

                .partner-sidebar.show {
                    transform: translateX(0);
                }

            .partner-main {
                margin-left: 0;
            }

            .partner-topbar {
                padding: 0 16px;
            }

            .partner-content {
                padding: 18px;
            }

            .partner-mobile-overlay {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, .50);
                z-index: 1040;
                opacity: 0;
                visibility: hidden;
                transition: var(--partner-transition);
            }

                .partner-mobile-overlay.show {
                    opacity: 1;
                    visibility: visible;
                }

            .partner-status-strip {
                border-radius: 18px;
            }
        }

        @@media (max-width: 575.98px) {
            .partner-topbar {
                height: 68px;
            }

            .partner-page-title {
                font-size: .96rem;
            }

            .partner-breadcrumb,
            .partner-user-chip .user-meta {
                display: none;
            }

            .partner-user-chip {
                padding: 5px;
                border-radius: 16px;
            }

                .partner-user-chip img {
                    width: 36px;
                    height: 36px;
                }

            .partner-icon-btn {
                width: 42px;
                height: 42px;
                border-radius: 15px;
            }

            .partner-content {
                padding: 14px;
            }

            .partner-footer {
                padding: 14px;
                text-align: center;
            }

            .status-strip-inner {
                align-items: flex-start;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="partner-app">
        <div class="partner-mobile-overlay" id="partnerOverlay"></div>

        <aside class="partner-sidebar" id="partnerSidebar">
            <div class="partner-sidebar-header">
                <a href="/MemberProject/Index" class="partner-logo" title="Cổng đối tác BĐS Khánh Hòa">
                    <i class="bi bi-buildings-fill"></i>
                </a>

                <div class="overflow-hidden">
                    <div class="partner-brand-title">BĐS KHÁNH HÒA</div>
                    <div class="partner-brand-sub">Cổng đối tác dự án</div>
                </div>
            </div>

            <div class="partner-business-box">
                <div class="business-box-top">
                    <img src="@userAvatar"
                         class="business-avatar"
                         alt="Ảnh đại diện"
                         onerror="this.src='/images/avatars/default-business.png'" />

                    <div class="overflow-hidden">
                        <div class="business-name">@businessName</div>
                        <div class="business-representative">@representativeName</div>
                    </div>
                </div>

                <div class="verify-pill @GetVerificationClass()">
                    @if (isVerifiedBusiness)
                    {
                        <i class="bi bi-patch-check-fill"></i>
                    }
                    else if (isRejectedBusiness)
                    {
                        <i class="bi bi-x-octagon-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-hourglass-split"></i>
                    }

                    <span>@GetVerificationText()</span>
                </div>
            </div>

            <div class="partner-sidebar-body">
                <nav>
                    <div class="partner-menu-title">Khách hàng & CRM</div>

                    <a href="/MemberProject/Index" class="@NavClass("MemberProject", "Index")">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Phễu khách hàng</span>
                        @if (newLeadCount > 0)
                        {
                            <span class="partner-badge">@newLeadCount</span>
                        }
                    </a>

                    <a href="/Appointments/Index?mode=DoanhNghiep" class="@NavClass("Appointments")">
                        <i class="bi bi-calendar2-check-fill"></i>
                        <span>Lịch hẹn dự án</span>
                        @if (todayAppointmentCount > 0)
                        {
                            <span class="partner-badge">@todayAppointmentCount</span>
                        }
                        else if (appointmentCount > 0)
                        {
                            <span class="partner-badge soft">@appointmentCount</span>
                        }
                    </a>

                    <div class="partner-menu-title">Dự án & hiệu suất</div>
                    <a href="/MemberProject/MyProjects" class="@NavClass("MemberProject", "MyProjects")">
                        <i class="bi bi-buildings"></i>
                        <span>Dự án của tôi</span>
                        @if (projectCount > 0)
                        {
                            <span class="partner-badge soft">@projectCount</span>
                        }
                    </a>

                    <a href="/Analytics/Index" class="@NavClass("Analytics", "Index")">
                        <i class="bi bi-bar-chart-line-fill"></i>
                        <span>Báo cáo hiệu suất</span>
                    </a>

                    <a href="/Project/Search" class="partner-menu-link">
                        <i class="bi bi-globe2"></i>
                        <span>Xem dự án công khai</span>
                    </a>

                    <div class="partner-menu-title">Hồ sơ & hỗ trợ</div>

                    <a href="/Account/Profile" class="@NavClass("Account", "Profile")">
                        <i class="bi bi-person-vcard-fill"></i>
                        <span>Hồ sơ doanh nghiệp</span>
                    </a>

                    <a href="/SupportTickets/Index" class="@NavClass("SupportTickets", "Index")">
                        <i class="bi bi-headset"></i>
                        <span>Trung tâm hỗ trợ</span>
                        @if (supportPendingCount > 0)
                        {
                            <span class="partner-badge">@supportPendingCount</span>
                        }
                    </a>

                    <a href="/Notifications/Index" class="@NavClass("Notifications", "Index")">
                        <i class="bi bi-bell-fill"></i>
                        <span>Thông báo</span>
                        @if (notificationCount > 0)
                        {
                            <span class="partner-badge">@notificationCount</span>
                        }
                    </a>

                    <div class="partner-sidebar-note">
                        <i class="bi bi-stars me-1"></i>
                        <strong>Gợi ý:</strong> Ưu tiên xử lý lead mới trong ngày, ghi chú đầy đủ lịch sử chăm sóc và chuyển trạng thái đúng quy trình để báo cáo hiệu suất chính xác.
                    </div>
                </nav>
            </div>

            <div class="partner-sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="partner-logout-btn">
                        <i class="bi bi-box-arrow-right"></i>
                        Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <section class="partner-main">
            <header class="partner-topbar">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <button type="button" class="partner-icon-btn d-lg-none" id="btnPartnerSidebar" aria-label="Mở menu">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <div class="overflow-hidden">
                        <h1 class="partner-page-title text-truncate">@pageTitle</h1>
                        <div class="partner-breadcrumb">
                            Cổng đối tác / @currentController / @currentAction
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="/" class="partner-icon-btn d-none d-sm-inline-flex" title="Xem website">
                        <i class="bi bi-house-door-fill"></i>
                    </a>

                    <a href="/Project/Search" class="partner-icon-btn d-none d-md-inline-flex" title="Xem dự án công khai">
                        <i class="bi bi-globe2"></i>
                    </a>

                    <a href="/Notifications/Index" class="partner-icon-btn" title="Thông báo">
                        <i class="bi bi-bell-fill"></i>
                        @if (notificationCount > 0 || newLeadCount > 0 || supportPendingCount > 0)
                        {
                            <span class="partner-notify-dot"></span>
                        }
                    </a>

                    <div class="partner-user-chip">
                        <div class="user-meta text-end">
                            <div class="fw-bold text-dark" style="font-size:.84rem; line-height:1.15;">
                                @representativeName
                            </div>
                            <div class="text-muted fw-bold" style="font-size:.7rem;">
                                Quản lý dự án
                            </div>
                        </div>

                        <img src="@userAvatar"
                             alt="Ảnh tài khoản"
                             onerror="this.src='/images/avatars/default-business.png'" />
                    </div>
                </div>
            </header>

            <main class="partner-content">
                <div class="partner-page-shell">
                    @if (TempData["Success"] != null)
                    {
                        <div class="partner-alert success mb-4 animate__animated animate__fadeInDown animate__faster">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white flex-shrink-0" style="width:34px;height:34px;">
                                <i class="bi bi-check-lg"></i>
                            </span>

                            <div class="flex-grow-1">@TempData["Success"]</div>

                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="partner-alert error mb-4 animate__animated animate__fadeInDown animate__faster">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger text-white flex-shrink-0" style="width:34px;height:34px;">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </span>

                            <div class="flex-grow-1">@TempData["Error"]</div>

                            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Đóng"></button>
                        </div>
                    }

                    @if (businessProfile == null)
                    {
                        <div class="partner-status-strip show">
                            <div class="status-strip-inner">
                                <div class="status-strip-icon">
                                    <i class="bi bi-person-vcard-fill"></i>
                                </div>

                                <div class="flex-grow-1">
                                    <div class="status-strip-title">Bạn chưa có hồ sơ doanh nghiệp</div>
                                    <div class="status-strip-desc">
                                        Hãy tạo hồ sơ doanh nghiệp để được Admin xác minh và phân quyền quản lý dự án.
                                    </div>
                                </div>

                                <a href="/Account/Profile" class="@NavClass("Account", "Profile")">
                                    class="btn btn-primary rounded-pill fw-bold px-3">
                                    Tạo hồ sơ
                                </a>
                            </div>
                        </div>
                    }
                    else if (isPendingBusiness)
                    {
                        <div class="partner-status-strip show">
                            <div class="status-strip-inner">
                                <div class="status-strip-icon">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>

                                <div class="flex-grow-1">
                                    <div class="status-strip-title">Hồ sơ doanh nghiệp đang chờ xác minh</div>
                                    <div class="status-strip-desc">
                                        Trong thời gian chờ duyệt, bạn vẫn có thể xem thông tin cơ bản. Một số chức năng có thể cần Admin phân quyền.
                                    </div>
                                </div>

                                <a href="/Account/Profile" class="@NavClass("Account", "Profile")">
                                    class="btn btn-light border rounded-pill fw-bold px-3">
                                    Xem hồ sơ
                                </a>
                            </div>
                        </div>
                    }
                    else if (isRejectedBusiness)
                    {
                        <div class="partner-status-strip show">
                            <div class="status-strip-inner">
                                <div class="status-strip-icon" style="background:linear-gradient(135deg,#ef4444,#b91c1c);">
                                    <i class="bi bi-x-octagon-fill"></i>
                                </div>

                                <div class="flex-grow-1">
                                    <div class="status-strip-title">Hồ sơ doanh nghiệp bị từ chối</div>
                                    <div class="status-strip-desc">
                                        @(string.IsNullOrWhiteSpace(businessProfile.RejectionReason)
                                                                            ? "Vui lòng kiểm tra lại thông tin doanh nghiệp và giấy tờ xác minh."
                                                                            : businessProfile.RejectionReason)
                                </div>
                            </div>

                                <a href="/Account/Profile" class="@NavClass("Account", "Profile")">
                                    class="btn btn-danger rounded-pill fw-bold px-3">
                                    Cập nhật
                                </a>
                            </div>
                        </div>
                                        }

                    @RenderBody()
                </div>
            </main>

            <footer class="partner-footer">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <div>
                        © 2026 <strong>BĐS Khánh Hòa</strong>
                        <span class="footer-dot"></span>
                        Cổng quản trị dành cho đối tác dự án
                    </div>

                    <div class="d-flex align-items-center flex-wrap justify-content-center gap-2">
                        <span>
                            <i class="bi bi-buildings text-primary me-1"></i>
                            @projectCount dự án
                        </span>

                        <span class="d-none d-md-inline text-muted">•</span>

                        <span>
                            <i class="bi bi-funnel-fill text-danger me-1"></i>
                            @newLeadCount lead mới
                        </span>

                        <span class="d-none d-md-inline text-muted">•</span>

                        <span>
                            <i class="bi bi-calendar-check text-success me-1"></i>
                            @todayAppointmentCount lịch hôm nay
                        </span>
                    </div>
                </div>
            </footer>
        </section>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(function () {
            const sidebar = $('#partnerSidebar');
            const overlay = $('#partnerOverlay');
            const btnSidebar = $('#btnPartnerSidebar');

            function openSidebar() {
                sidebar.addClass('show');
                overlay.addClass('show');
                $('body').css('overflow', 'hidden');
            }

            function closeSidebar() {
                sidebar.removeClass('show');
                overlay.removeClass('show');
                $('body').css('overflow', '');
            }

            btnSidebar.on('click', function () {
                if (sidebar.hasClass('show')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            overlay.on('click', closeSidebar);

            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeSidebar();
                }
            });

            $('.partner-menu-link').on('click', function () {
                if ($(window).width() < 992) {
                    closeSidebar();
                }
            });

            $(window).on('resize', function () {
                if ($(window).width() >= 992) {
                    closeSidebar();
                }
            });

            setTimeout(function () {
                $('.partner-alert').fadeOut(350);
            }, 5200);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>