@using BDSKhanhHoa.Data
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context

@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int currentUserId);

    string userAvatar = User.FindFirst("Avatar")?.Value ?? "/images/avatars/default-business.png";

    var businessProfile = _context.BusinessProfiles
        .AsNoTracking()
        .FirstOrDefault(b => b.UserID == currentUserId);

    var currentUser = _context.Users
        .AsNoTracking()
        .FirstOrDefault(u => u.UserID == currentUserId);

    string businessName = businessProfile?.BusinessName
        ?? currentUser?.FullName
        ?? "Doanh nghiệp đối tác";

    string representativeName = businessProfile?.RepresentativeName
        ?? currentUser?.FullName
        ?? User.Identity?.Name
        ?? "Quản lý dự án";

    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    int projectCount = _context.Projects
        .AsNoTracking()
        .Count(p => p.OwnerUserID == currentUserId && !p.IsDeleted);

    int newLeadCount = _context.ProjectLeads
        .AsNoTracking()
        .Include(l => l.Project)
        .Count(l =>
            l.Project != null &&
            l.Project.OwnerUserID == currentUserId &&
            (l.LeadStatus == "New" || l.LeadStatus == "Mới"));

    int appointmentCount = _context.Appointments
        .AsNoTracking()
        .Count(a => a.BuyerID == currentUserId || a.SellerID == currentUserId);

    int supportPendingCount = _context.ContactMessages
        .AsNoTracking()
        .Count(x =>
            x.UserID == currentUserId &&
            (
                x.Status == "Pending" ||
                x.Status == "Chưa xử lý" ||
                x.Status == "Chờ xử lý" ||
                x.Status == "Đang xử lý"
            ));

    bool IsActive(string controller, string? action = null)
    {
        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }

    string NavClass(string controller, string? action = null)
    {
        return IsActive(controller, action) ? "partner-menu-link active" : "partner-menu-link";
    }

    string pageTitle = ViewData["Title"]?.ToString() ?? "Cổng đối tác";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Cổng quản trị đối tác dự án - BDS Khánh Hòa" />

    <title>@pageTitle | Cổng Đối Tác - BDS Khánh Hòa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --partner-primary: #2563eb;
            --partner-primary-dark: #1d4ed8;
            --partner-primary-soft: #eff6ff;
            --partner-purple: #4f46e5;
            --partner-success: #059669;
            --partner-warning: #d97706;
            --partner-danger: #dc2626;
            --partner-dark: #0f172a;
            --partner-muted: #64748b;
            --partner-border: #e2e8f0;
            --partner-soft: #f8fafc;
            --partner-body: #f3f6fb;
            --partner-card: #ffffff;
            --partner-sidebar-width: 270px;
            --partner-header-height: 74px;
            --partner-radius: 22px;
            --partner-radius-sm: 15px;
            --partner-shadow: 0 18px 45px rgba(15, 23, 42, .08);
            --partner-shadow-soft: 0 10px 25px rgba(15, 23, 42, .05);
            --partner-transition: all .25s ease;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top left, rgba(37, 99, 235, .08), transparent 32rem), radial-gradient(circle at bottom right, rgba(5, 150, 105, .07), transparent 28rem), var(--partner-body);
            color: var(--partner-dark);
            font-family: 'Inter', sans-serif;
            font-size: .95rem;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6,
        .partner-brand-title,
        .partner-page-title {
            font-family: 'Plus Jakarta Sans', sans-serif;
            letter-spacing: -.025em;
        }

        a {
            text-decoration: none;
        }

        .partner-app {
            min-height: 100vh;
        }

        .partner-sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: var(--partner-sidebar-width);
            background: rgba(255, 255, 255, .97);
            backdrop-filter: blur(18px);
            border-right: 1px solid rgba(148, 163, 184, .18);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            transition: var(--partner-transition);
            box-shadow: 12px 0 30px rgba(15, 23, 42, .03);
        }

        .partner-sidebar-header {
            height: var(--partner-header-height);
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 0 22px;
            border-bottom: 1px solid rgba(148, 163, 184, .13);
            flex-shrink: 0;
        }

        .partner-logo {
            width: 44px;
            height: 44px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--partner-primary), var(--partner-purple));
            color: #fff;
            font-size: 1.35rem;
            box-shadow: 0 12px 24px rgba(37, 99, 235, .25);
            flex-shrink: 0;
        }

        .partner-brand-title {
            font-size: .95rem;
            font-weight: 900;
            line-height: 1.1;
            color: var(--partner-dark);
        }

        .partner-brand-sub {
            margin-top: 3px;
            font-size: .68rem;
            font-weight: 800;
            color: var(--partner-muted);
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .partner-sidebar-body {
            padding: 16px 16px 12px;
            overflow-y: auto;
            flex: 1;
            scrollbar-width: thin;
        }

        .partner-menu-title {
            margin: 18px 0 9px 10px;
            font-size: .68rem;
            font-weight: 900;
            letter-spacing: .11em;
            color: #94a3b8;
            text-transform: uppercase;
        }

        .partner-menu-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 48px;
            padding: 11px 13px;
            border-radius: 16px;
            color: #475569;
            font-weight: 800;
            border: 1px solid transparent;
            transition: var(--partner-transition);
            margin-bottom: 6px;
        }

            .partner-menu-link i {
                width: 24px;
                text-align: center;
                font-size: 1.18rem;
                color: #64748b;
                transition: var(--partner-transition);
            }

            .partner-menu-link:hover {
                color: var(--partner-primary);
                background: var(--partner-primary-soft);
                border-color: rgba(37, 99, 235, .12);
                transform: translateX(3px);
            }

                .partner-menu-link:hover i {
                    color: var(--partner-primary);
                }

            .partner-menu-link.active {
                color: #fff;
                background: linear-gradient(135deg, var(--partner-primary), var(--partner-purple));
                box-shadow: 0 14px 28px rgba(37, 99, 235, .24);
            }

                .partner-menu-link.active i {
                    color: #fff;
                }

        .partner-badge {
            margin-left: auto;
            min-width: 24px;
            height: 24px;
            padding: 0 8px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--partner-danger);
            color: #fff;
            font-size: .72rem;
            font-weight: 900;
        }

            .partner-badge.soft {
                background: rgba(37, 99, 235, .12);
                color: var(--partner-primary);
            }

        .partner-menu-link.active .partner-badge.soft {
            background: rgba(255, 255, 255, .22);
            color: #fff;
        }

        .partner-sidebar-note {
            margin: 18px 0 0;
            padding: 14px;
            border-radius: 18px;
            border: 1px dashed #bfdbfe;
            background: #eff6ff;
            color: #1e40af;
            font-size: .78rem;
            line-height: 1.55;
            font-weight: 700;
        }

        .partner-sidebar-footer {
            padding: 14px 16px 18px;
            border-top: 1px solid rgba(148, 163, 184, .14);
            flex-shrink: 0;
        }

        .partner-main {
            margin-left: var(--partner-sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: var(--partner-transition);
        }

        .partner-topbar {
            position: sticky;
            top: 0;
            height: var(--partner-header-height);
            background: rgba(255, 255, 255, .82);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(148, 163, 184, .15);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 0 30px;
        }

        .partner-icon-btn {
            width: 44px;
            height: 44px;
            border-radius: 15px;
            border: 1px solid var(--partner-border);
            background: #fff;
            color: #475569;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: var(--partner-transition);
            position: relative;
        }

            .partner-icon-btn:hover {
                color: var(--partner-primary);
                border-color: rgba(37, 99, 235, .24);
                background: var(--partner-primary-soft);
                transform: translateY(-1px);
            }

        .partner-notify-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--partner-danger);
            border: 2px solid #fff;
        }

        .partner-page-title {
            margin: 0;
            font-size: 1.05rem;
            font-weight: 900;
            color: var(--partner-dark);
        }

        .partner-breadcrumb {
            margin: 3px 0 0;
            color: var(--partner-muted);
            font-size: .77rem;
            font-weight: 700;
        }

        .partner-user-chip {
            min-height: 46px;
            border-radius: 16px;
            background: #fff;
            border: 1px solid var(--partner-border);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 8px 6px 14px;
            box-shadow: 0 4px 12px rgba(15, 23, 42, .04);
        }

            .partner-user-chip img {
                width: 36px;
                height: 36px;
                border-radius: 13px;
                object-fit: cover;
            }

        .partner-content {
            flex: 1;
            padding: 28px;
        }

        .partner-footer {
            background: rgba(255, 255, 255, .78);
            border-top: 1px solid rgba(148, 163, 184, .16);
            padding: 16px 28px;
            color: var(--partner-muted);
            font-size: .83rem;
        }

        .partner-alert {
            border: 0;
            border-radius: 18px;
            background: #fff;
            box-shadow: var(--partner-shadow-soft);
            padding: 16px 18px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
        }

            .partner-alert.success {
                border-left: 5px solid var(--partner-success);
            }

            .partner-alert.error {
                border-left: 5px solid var(--partner-danger);
            }

        .partner-mobile-overlay {
            display: none;
        }

        @@media (max-width: 991.98px) {
            .partner-sidebar {
                transform: translateX(-105%);
                box-shadow: 24px 0 55px rgba(15, 23, 42, .18);
            }

                .partner-sidebar.show {
                    transform: translateX(0);
                }

            .partner-main {
                margin-left: 0;
            }

            .partner-topbar {
                padding: 0 16px;
            }

            .partner-content {
                padding: 18px;
            }

            .partner-mobile-overlay {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, .44);
                z-index: 1040;
                opacity: 0;
                visibility: hidden;
                transition: var(--partner-transition);
            }

                .partner-mobile-overlay.show {
                    opacity: 1;
                    visibility: visible;
                }
        }

        @@media (max-width: 575.98px) {
            .partner-topbar {
                height: 66px;
            }

            .partner-page-title {
                font-size: .95rem;
            }

            .partner-breadcrumb,
            .partner-user-chip .user-meta {
                display: none;
            }

            .partner-content {
                padding: 14px;
            }

            .partner-footer {
                padding: 14px;
                text-align: center;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="partner-app">
        <div class="partner-mobile-overlay" id="partnerOverlay"></div>

        <aside class="partner-sidebar" id="partnerSidebar">
            <div class="partner-sidebar-header">
                <a href="/MemberProject/Index" class="partner-logo" title="Cổng đối tác BDS Khánh Hòa">
                    <i class="bi bi-buildings-fill"></i>
                </a>

                <div class="overflow-hidden">
                    <div class="partner-brand-title">BDS KHÁNH HÒA</div>
                    <div class="partner-brand-sub">Cổng đối tác dự án</div>
                </div>
            </div>

            <div class="partner-sidebar-body">
                <nav>
                    <div class="partner-menu-title">Khách hàng</div>

                    <a href="/MemberProject/Index" class="@NavClass("MemberProject", "Index")">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Phễu khách hàng</span>
                        @if (newLeadCount > 0)
                        {
                            <span class="partner-badge">@newLeadCount</span>
                        }
                    </a>

                    <a href="/Appointments/Index?mode=DoanhNghiep" class="@NavClass("Appointments", "Index")">
                        <i class="bi bi-calendar2-check-fill"></i>
                        <span>Lịch hẹn xem dự án</span>
                        @if (appointmentCount > 0)
                        {
                            <span class="partner-badge soft">@appointmentCount</span>
                        }
                    </a>

                    <div class="partner-menu-title">Dự án được Admin gán</div>

                    <a href="/MemberProject/MyProjects" class="@NavClass("MemberProject", "MyProjects")">
                        <i class="bi bi-kanban-fill"></i>
                        <span>Danh mục dự án</span>
                        @if (projectCount > 0)
                        {
                            <span class="partner-badge soft">@projectCount</span>
                        }
                    </a>

                    <a href="/ProjectTimeline/Index" class="@NavClass("ProjectTimeline")">
                        <i class="bi bi-clock-history"></i>
                        <span>Tiến độ dự án</span>
                    </a>

                    <a href="/ProjectVault/Index" class="@NavClass("ProjectVault")">
                        <i class="bi bi-folder2-open"></i>
                        <span>Kho hồ sơ pháp lý</span>
                    </a>

                    <div class="partner-menu-title">Báo cáo & hỗ trợ</div>

                    <a href="/Analytics/Index" class="@NavClass("Analytics")">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Báo cáo hiệu suất</span>
                    </a>

                    <a href="/SupportTickets/Index" class="@NavClass("SupportTickets")">
                        <i class="bi bi-headset"></i>
                        <span>Yêu cầu hỗ trợ</span>
                        @if (supportPendingCount > 0)
                        {
                            <span class="partner-badge">@supportPendingCount</span>
                        }
                    </a>

                    <div class="partner-menu-title">Tài khoản</div>

                    <a href="/Account/Profile" class="@NavClass("Account", "Profile")">
                        <i class="bi bi-person-badge-fill"></i>
                        <span>Hồ sơ tài khoản</span>
                    </a>

                    <a href="/" class="partner-menu-link">
                        <i class="bi bi-globe2"></i>
                        <span>Về trang chủ</span>
                    </a>
                </nav>

                <div class="partner-sidebar-note">
                    <i class="bi bi-shield-check me-1"></i>
                    Tài khoản CĐT chỉ quản lý dự án được Admin phân quyền, không tự tạo dự án mới.
                </div>
            </div>

            <div class="partner-sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-light border text-danger fw-bold w-100 rounded-4 py-2">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Đăng xuất
                    </button>
                </form>
            </div>
        </aside>

        <div class="partner-main">
            <header class="partner-topbar">
                <div class="d-flex align-items-center gap-3 overflow-hidden">
                    <button type="button" class="partner-icon-btn d-lg-none" id="btnPartnerSidebar">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <div class="overflow-hidden">
                        <h1 class="partner-page-title text-truncate">@pageTitle</h1>
                        <div class="partner-breadcrumb">
                            Cổng đối tác / @currentController
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="/" class="partner-icon-btn d-none d-sm-inline-flex" title="Xem website">
                        <i class="bi bi-house-door-fill"></i>
                    </a>

                    <a href="/SupportTickets/Index" class="partner-icon-btn" title="Thông báo và hỗ trợ">
                        <i class="bi bi-bell-fill"></i>
                        @if (newLeadCount > 0 || supportPendingCount > 0)
                        {
                            <span class="partner-notify-dot"></span>
                        }
                    </a>

                    <div class="partner-user-chip">
                        <div class="user-meta text-end">
                            <div class="fw-bold text-dark" style="font-size:.84rem; line-height:1.15;">@representativeName</div>
                            <div class="text-muted fw-bold" style="font-size:.7rem;">Quản lý dự án</div>
                        </div>

                        <img src="@userAvatar" alt="Ảnh tài khoản" />
                    </div>
                </div>
            </header>

            <main class="partner-content">
                @if (TempData["Success"] != null)
                {
                    <div class="partner-alert success mb-4">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success text-white" style="width:34px;height:34px;">
                            <i class="bi bi-check-lg"></i>
                        </span>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="partner-alert error mb-4">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger text-white" style="width:34px;height:34px;">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                        </span>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <footer class="partner-footer">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                    <div>
                        © 2026 <strong>BDS Khánh Hòa</strong> — Cổng quản trị dành cho đối tác dự án.
                    </div>

                    <div class="d-flex gap-3">
                        <a href="/SupportTickets/Index" class="text-muted fw-bold">Hỗ trợ</a>
                        <a href="/" class="text-muted fw-bold">Website</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('partnerSidebar');
            const overlay = document.getElementById('partnerOverlay');
            const btnSidebar = document.getElementById('btnPartnerSidebar');

            function openSidebar() {
                sidebar.classList.add('show');
                overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            }

            btnSidebar?.addEventListener('click', openSidebar);
            overlay?.addEventListener('click', closeSidebar);

            document.querySelectorAll('.partner-menu-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                    }
                });
            });

            setTimeout(function () {
                document.querySelectorAll('.partner-alert').forEach(function (alert) {
                    alert.style.transition = 'all .25s ease';
                    alert.style.opacity = '0';
                    alert.style.transform = 'translateY(-8px)';
                    setTimeout(function () {
                        alert.remove();
                    }, 300);
                });
            }, 6500);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>