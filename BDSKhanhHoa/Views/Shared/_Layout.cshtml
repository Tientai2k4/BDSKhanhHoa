@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using BDSKhanhHoa.Models
@inject BDSKhanhHoa.Data.ApplicationDbContext _context

@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int currentUserId);

    var businessProfile = currentUserId > 0
        ? _context.BusinessProfiles.AsNoTracking().FirstOrDefault(b => b.UserID == currentUserId)
        : null;

    bool isBusinessVerified = businessProfile != null && businessProfile.VerificationStatus == "Approved";
    bool isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff");
    bool canPostSingleAd = User.Identity.IsAuthenticated && !isBusinessVerified && !isAdminOrStaff;

    int unreadCount = 0;
    var topNotifications = new List<Notification>();

    if (User.Identity.IsAuthenticated && currentUserId > 0)
    {
        unreadCount = _context.Notifications.Count(n => n.UserID == currentUserId && !n.IsRead);

        topNotifications = _context.Notifications
            .AsNoTracking()
            .Where(n => n.UserID == currentUserId)
            .OrderByDescending(n => n.CreatedAt)
            .Take(5)
            .ToList();
    }

    var avatarUrl = User.FindFirst("Avatar")?.Value ?? "/images/avatars/default-user.png";
    var userName = User.FindFirst("FullName")?.Value
                   ?? User.Identity?.Name
                   ?? "Tài khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BDSKhanhHoa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --bg: #f5f8fc;
            --surface: rgba(255,255,255,.96);
            --surface-2: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --border: #e5ecf4;
            --primary: #2563eb;
            --primary-2: #1d4ed8;
            --sea: #0ea5e9;
            --sea-2: #0284c7;
            --success: #16a34a;
            --danger: #ef4444;
            --shadow-sm: 0 8px 22px rgba(15, 23, 42, .06);
            --shadow-md: 0 16px 38px rgba(15, 23, 42, .10);
            --shadow-lg: 0 22px 60px rgba(15, 23, 42, .16);
            --radius: 18px;
            --radius-lg: 22px;
            --radius-xl: 28px;
            --transition: all .22s ease;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        body {
            min-height: 100vh;
            padding-top: 78px;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand, .btn, .nav-link {
            font-family: 'Sora', sans-serif;
        }

        a {
            text-decoration: none;
        }

        main {
            min-height: 60vh;
        }

        /* ═══════════════════════════════════
                                                   HEADER
                                        ═══════════════════════════════════ */
        .header-main {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            background: rgba(255,255,255,.94);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(230,237,245,.95);
            box-shadow: 0 8px 28px rgba(15,23,42,.08);
        }

        .navbar {
            padding: 0;
        }

            .navbar > .container {
                min-height: 78px;
                display: flex;
                align-items: center;
                gap: 14px;
            }

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 0;
            margin-right: 0;
            flex-shrink: 0;
            white-space: nowrap;
            min-width: 0;
        }

            .navbar-brand img {
                height: 46px;
                width: auto;
                object-fit: contain;
                display: block;
                flex-shrink: 0;
            }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
            min-width: 0;
        }

        .brand-title {
            font-size: 1rem;
            font-weight: 800;
            color: var(--text);
            margin: 0;
        }

        .brand-subtitle {
            font-size: .74rem;
            color: var(--muted);
            margin: 2px 0 0;
        }

        .desktop-shell {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
            flex: 1;
        }

        .navbar-nav {
            gap: 4px;
            align-items: center;
        }

        .nav-main-link, .nav-link {
            color: #475569 !important;
            font-weight: 700;
            font-size: .94rem;
            padding: 10px 12px !important;
            border-radius: 12px;
            transition: var(--transition);
            white-space: nowrap;
            line-height: 1;
        }

            .nav-link:hover, .nav-link.active, .nav-main-link:hover {
                color: var(--primary) !important;
                background: rgba(37,99,235,.08);
            }

        .nav-icon {
            font-size: 1rem;
            flex-shrink: 0;
        }

        .nav-text {
            white-space: nowrap;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            white-space: nowrap;
            margin-left: auto;
            min-width: 0;
        }

        .btn-post-ad {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: linear-gradient(135deg, var(--sea), var(--sea-2));
            color: #fff !important;
            border: none;
            border-radius: 999px;
            padding: 11px 18px;
            font-weight: 800;
            font-size: .88rem;
            box-shadow: 0 12px 26px rgba(14,165,233,.24);
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: .02em;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .btn-post-ad:hover {
                transform: translateY(-1px);
                box-shadow: 0 16px 30px rgba(14,165,233,.30);
                color: #fff !important;
            }

        .btn-post-ad-sm {
            width: 42px;
            height: 42px;
            padding: 0;
            border-radius: 50%;
        }

        .icon-btn {
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 50%;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #334155;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
            flex-shrink: 0;
            text-decoration: none;
            position: relative;
        }

            .icon-btn:hover {
                transform: translateY(-1px);
                color: var(--primary);
                border-color: rgba(37,99,235,.18);
            }

        .user-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            max-width: 240px;
            padding: 7px 12px 7px 8px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: #fff;
            box-shadow: var(--shadow-sm);
            white-space: nowrap;
        }

            .user-pill img {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid rgba(148,163,184,.35);
                flex-shrink: 0;
            }

            .user-pill .name {
                font-size: .92rem;
                font-weight: 700;
                color: #0f172a;
                max-width: 130px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .navbar-toggler {
            border: none;
            padding: 0;
            box-shadow: none !important;
            flex-shrink: 0;
            background: transparent;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            position: relative;
            z-index: 1050;
        }

            .navbar-toggler:focus {
                box-shadow: none !important;
            }

        .dropdown-menu {
            border: 1px solid rgba(230,237,245,.96);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            padding: 10px;
        }

        .dropdown-item {
            border-radius: 12px;
            font-weight: 600;
            padding-top: 10px;
            padding-bottom: 10px;
        }

            .dropdown-item:active {
                background: rgba(37,99,235,.1);
                color: var(--text);
            }

        /* ═══════════════════════════════════
                           DROPDOWN THÔNG BÁO HIỆN ĐẠI
                        ═══════════════════════════════════ */
        .notification-dropdown {
            width: min(390px, calc(100vw - 24px));
            border: 1px solid rgba(226,232,240,.95) !important;
            border-radius: 22px !important;
            overflow: hidden;
            padding: 0 !important;
            box-shadow: 0 24px 70px rgba(15,23,42,.18) !important;
            background: #fff;
        }

        .notification-head {
            position: relative;
            padding: 16px 16px 14px;
            color: #fff;
            background: radial-gradient(circle at top right, rgba(255,255,255,.26), transparent 34%), linear-gradient(135deg, var(--primary), #3b82f6);
        }

        .notification-head-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .notification-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Sora', sans-serif;
            font-weight: 800;
            font-size: .98rem;
            line-height: 1.2;
        }

            .notification-title i {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                background: rgba(255,255,255,.18);
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .notification-counter {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 26px;
            padding: 0 9px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.25);
            font-size: .78rem;
            font-weight: 800;
        }

        .notification-sub {
            margin-top: 8px;
            color: rgba(255,255,255,.84);
            font-size: .8rem;
            line-height: 1.45;
        }

        .notification-tools {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 10px 12px;
            background: #f8fafc;
            border-bottom: 1px solid #e5ecf4;
        }

            .notification-tools .small-action {
                border: none;
                background: transparent;
                color: var(--primary);
                font-size: .78rem;
                font-weight: 800;
                padding: 6px 8px;
                border-radius: 10px;
                transition: var(--transition);
            }

                .notification-tools .small-action:hover {
                    background: #eff6ff;
                }

        .notification-list {
            max-height: 380px;
            overflow-y: auto;
            background: #fff;
        }

        .notification-item {
            display: flex !important;
            align-items: flex-start;
            gap: 12px;
            padding: 13px 14px !important;
            border-radius: 0 !important;
            border-bottom: 1px solid #eef2f7;
            white-space: normal !important;
            transition: var(--transition);
            color: var(--text) !important;
        }

            .notification-item:hover {
                background: #f8fbff !important;
            }

            .notification-item.is-unread {
                background: linear-gradient(90deg, rgba(37,99,235,.075), #fff);
            }

                .notification-item.is-unread:hover {
                    background: linear-gradient(90deg, rgba(37,99,235,.11), #f8fbff) !important;
                }

        .notification-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            font-size: 1.05rem;
        }

        .notification-content {
            min-width: 0;
            flex: 1;
        }

        .notification-row-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 3px;
        }

        .notification-name {
            min-width: 0;
            flex: 1;
            font-weight: 800;
            color: #0f172a;
            font-size: .9rem;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .notification-dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #ef4444;
            box-shadow: 0 0 0 4px rgba(239,68,68,.11);
            flex-shrink: 0;
        }

        .notification-preview {
            color: #64748b;
            font-size: .8rem;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 7px;
        }

        .notification-meta {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .notification-type {
            display: inline-flex;
            align-items: center;
            height: 22px;
            padding: 0 8px;
            border-radius: 999px;
            background: #f1f5f9;
            color: #475569;
            font-size: .68rem;
            font-weight: 800;
        }

        .notification-time {
            color: #94a3b8;
            font-size: .72rem;
            font-weight: 700;
        }

        .notification-empty {
            padding: 34px 22px;
            text-align: center;
            color: #64748b;
        }

            .notification-empty .empty-icon {
                width: 58px;
                height: 58px;
                margin: 0 auto 12px;
                border-radius: 20px;
                background: #eff6ff;
                color: #2563eb;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.55rem;
            }

        .notification-footer {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
            padding: 12px;
            background: #f8fafc;
            border-top: 1px solid #e5ecf4;
        }

        .notification-view-all {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            min-height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff !important;
            font-family: 'Sora', sans-serif;
            font-weight: 800;
            font-size: .86rem;
            text-decoration: none;
            transition: var(--transition);
        }

            .notification-view-all:hover {
                transform: translateY(-1px);
                color: #fff !important;
                box-shadow: 0 12px 24px rgba(37,99,235,.22);
            }

        /* Badge chuông tự cập nhật */
        .js-notification-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Popup nhanh khi có thông báo mới */
        .notification-toast {
            position: fixed;
            top: 92px;
            right: 22px;
            width: min(360px, calc(100vw - 24px));
            z-index: 3060;
            display: none;
            border-radius: 20px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #dbeafe;
            box-shadow: 0 22px 60px rgba(15,23,42,.18);
        }

        .notification-toast-inner {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 15px;
        }

        .notification-toast-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notification-toast-title {
            font-weight: 800;
            color: #0f172a;
            font-size: .92rem;
            line-height: 1.35;
            margin-bottom: 3px;
        }

        .notification-toast-text {
            color: #64748b;
            font-size: .8rem;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin: 0;
        }

        .notification-toast-close {
            margin-left: auto;
            border: none;
            background: #f1f5f9;
            color: #64748b;
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        @@media (max-width: 575.98px) {
            .notification-toast {
                top: 74px;
                right: 12px;
            }

            .notification-dropdown {
                width: calc(100vw - 18px);
            }
        }

        /* ═══════════════════════════════════
                                                   MOBILE HEADER ACTIONS
                                        ═══════════════════════════════════ */
        .mobile-header-actions {
            display: none;
            align-items: center;
            gap: 8px;
            margin-left: auto;
            flex-shrink: 0;
            min-width: 0;
        }

            .mobile-header-actions .icon-btn {
                width: 42px;
                height: 42px;
            }

        .mobile-avatar-btn img {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #dbeafe;
            display: block;
        }

        .mobile-header-actions .btn-post-ad-sm {
            width: 42px;
            height: 42px;
            padding: 0;
        }

        .mobile-header-actions .menu-btn {
            width: 42px;
            height: 42px;
            background: #fff;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
        }

            .mobile-header-actions .menu-btn i {
                font-size: 1.55rem;
                line-height: 1;
                color: var(--primary);
            }

        /* ═══════════════════════════════════
                                                   MOBILE OFFCANVAS
                                        ═══════════════════════════════════ */
        .offcanvas-mobile {
            width: min(92vw, 400px);
            border-left: 1px solid rgba(229,234,242,.92);
            z-index: 1055;
        }

            .offcanvas-mobile .offcanvas-header {
                padding: 16px 20px;
                background: linear-gradient(135deg, #1d4ed8, #2563eb);
                color: #fff;
                flex-shrink: 0;
            }

            .offcanvas-mobile .offcanvas-body {
                padding: 0;
                background: #f0f4f9;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 0;
            }

        /* ── Block tài khoản ── */
        .mob-account-block {
            background: #fff;
            padding: 20px 20px 16px;
            border-bottom: 1px solid #e8eef6;
        }

        .mob-user-row {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 16px;
        }

            .mob-user-row img {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                object-fit: cover;
                border: 2.5px solid #dbeafe;
                flex-shrink: 0;
            }

        .mob-user-name {
            font-family: 'Sora', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: var(--text);
            margin: 0 0 5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mob-user-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: .74rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 100px;
        }

        .mob-badge-personal {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .mob-badge-business {
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

        .mob-badge-admin {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        /* Nút hành động */
        .mob-action-row {
            display: grid;
            gap: 10px;
        }

            .mob-action-row.two-col {
                grid-template-columns: 1fr 1fr;
            }

            .mob-action-row.one-col {
                grid-template-columns: 1fr;
            }

        .mob-action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 14px;
            border-radius: 12px;
            font-family: 'Sora', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            position: relative;
            white-space: nowrap;
        }

        .mob-btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff !important;
            box-shadow: 0 4px 14px rgba(37,99,235,.25);
        }

            .mob-btn-primary:hover {
                transform: translateY(-1px);
                color: #fff !important;
            }

        .mob-btn-outline {
            background: #fff;
            color: var(--primary) !important;
            border: 1.5px solid #bfdbfe;
        }

            .mob-btn-outline:hover {
                background: #eff6ff;
                color: var(--primary) !important;
            }

        /* ── Block section (nav group) ── */
        .mob-section {
            background: #fff;
            margin-top: 10px;
            border-top: 1px solid #e8eef6;
            border-bottom: 1px solid #e8eef6;
        }

        .mob-section-title {
            font-family: 'Sora', sans-serif;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #94a3b8;
            padding: 14px 20px 6px;
        }

        .chat-property-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 92%;
            align-self: flex-start;
        }

        .chat-property-card {
            display: grid;
            grid-template-columns: 92px minmax(0, 1fr);
            gap: 12px;
            background: #ffffff;
            border: 1px solid #dbeafe;
            border-left: 4px solid var(--primary);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
        }

        .chat-property-img-wrap {
