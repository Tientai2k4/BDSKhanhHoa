@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using BDSKhanhHoa.Models
@inject BDSKhanhHoa.Data.ApplicationDbContext _context

@{
    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int currentUserId);

    var businessProfile = currentUserId > 0
        ? _context.BusinessProfiles.AsNoTracking().FirstOrDefault(b => b.UserID == currentUserId)
        : null;

    bool isBusinessVerified = businessProfile != null && businessProfile.VerificationStatus == "Approved";
    bool isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff");
    bool canPostSingleAd = User.Identity.IsAuthenticated && !isBusinessVerified && !isAdminOrStaff;

    int unreadCount = 0;
    var topNotifications = new List<Notification>();

    if (User.Identity.IsAuthenticated && currentUserId > 0)
    {
        unreadCount = _context.Notifications.Count(n => n.UserID == currentUserId && !n.IsRead);

        topNotifications = _context.Notifications
            .AsNoTracking()
            .Where(n => n.UserID == currentUserId)
            .OrderByDescending(n => n.CreatedAt)
            .Take(5)
            .ToList();
    }

    var avatarUrl = User.FindFirst("Avatar")?.Value ?? "/images/avatars/default-user.png";
    var userName = User.FindFirst("FullName")?.Value
                   ?? User.Identity?.Name
                   ?? "Tài khoản";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BDSKhanhHoa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
        :root {
            --bg: #f5f8fc;
            --surface: rgba(255,255,255,.96);
            --surface-2: #ffffff;
            --text: #0f172a;
            --muted: #64748b;
            --border: #e5ecf4;
            --primary: #2563eb;
            --primary-2: #1d4ed8;
            --sea: #0ea5e9;
            --sea-2: #0284c7;
            --success: #16a34a;
            --danger: #ef4444;
            --shadow-sm: 0 8px 22px rgba(15, 23, 42, .06);
            --shadow-md: 0 16px 38px rgba(15, 23, 42, .10);
            --shadow-lg: 0 22px 60px rgba(15, 23, 42, .16);
            --radius: 18px;
            --radius-lg: 22px;
            --radius-xl: 28px;
            --transition: all .22s ease;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        body {
            min-height: 100vh;
            padding-top: 78px;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand, .btn, .nav-link {
            font-family: 'Sora', sans-serif;
        }

        a {
            text-decoration: none;
        }

        main {
            min-height: 60vh;
        }

        /* ═══════════════════════════════════
                                   HEADER
                        ═══════════════════════════════════ */
        .header-main {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1030;
            background: rgba(255,255,255,.94);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(230,237,245,.95);
            box-shadow: 0 8px 28px rgba(15,23,42,.08);
        }

        .navbar {
            padding: 0;
        }

            .navbar > .container {
                min-height: 78px;
                display: flex;
                align-items: center;
                gap: 14px;
            }

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 0;
            margin-right: 0;
            flex-shrink: 0;
            white-space: nowrap;
            min-width: 0;
        }

            .navbar-brand img {
                height: 46px;
                width: auto;
                object-fit: contain;
                display: block;
                flex-shrink: 0;
            }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
            min-width: 0;
        }

        .brand-title {
            font-size: 1rem;
            font-weight: 800;
            color: var(--text);
            margin: 0;
        }

        .brand-subtitle {
            font-size: .74rem;
            color: var(--muted);
            margin: 2px 0 0;
        }

        .desktop-shell {
            display: flex;
            align-items: center;
            gap: 14px;
            min-width: 0;
            flex: 1;
        }

        .navbar-nav {
            gap: 4px;
            align-items: center;
        }

        .nav-main-link, .nav-link {
            color: #475569 !important;
            font-weight: 700;
            font-size: .94rem;
            padding: 10px 12px !important;
            border-radius: 12px;
            transition: var(--transition);
            white-space: nowrap;
            line-height: 1;
        }

            .nav-link:hover, .nav-link.active, .nav-main-link:hover {
                color: var(--primary) !important;
                background: rgba(37,99,235,.08);
            }

        .nav-icon {
            font-size: 1rem;
            flex-shrink: 0;
        }

        .nav-text {
            white-space: nowrap;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            white-space: nowrap;
            margin-left: auto;
            min-width: 0;
        }

        .btn-post-ad {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: linear-gradient(135deg, var(--sea), var(--sea-2));
            color: #fff !important;
            border: none;
            border-radius: 999px;
            padding: 11px 18px;
            font-weight: 800;
            font-size: .88rem;
            box-shadow: 0 12px 26px rgba(14,165,233,.24);
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: .02em;
            white-space: nowrap;
            flex-shrink: 0;
        }

            .btn-post-ad:hover {
                transform: translateY(-1px);
                box-shadow: 0 16px 30px rgba(14,165,233,.30);
                color: #fff !important;
            }

        .btn-post-ad-sm {
            width: 42px;
            height: 42px;
            padding: 0;
            border-radius: 50%;
        }

        .icon-btn {
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 50%;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #334155;
            box-shadow: var(--shadow-sm);
            transition: var(--transition);
            flex-shrink: 0;
            text-decoration: none;
            position: relative;
        }

            .icon-btn:hover {
                transform: translateY(-1px);
                color: var(--primary);
                border-color: rgba(37,99,235,.18);
            }

        .user-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            max-width: 240px;
            padding: 7px 12px 7px 8px;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: #fff;
            box-shadow: var(--shadow-sm);
            white-space: nowrap;
        }

            .user-pill img {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid rgba(148,163,184,.35);
                flex-shrink: 0;
            }

            .user-pill .name {
                font-size: .92rem;
                font-weight: 700;
                color: #0f172a;
                max-width: 130px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .navbar-toggler {
            border: none;
            padding: 0;
            box-shadow: none !important;
            flex-shrink: 0;
            background: transparent;
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            position: relative;
            z-index: 1050;
        }

            .navbar-toggler:focus {
                box-shadow: none !important;
            }

        .dropdown-menu {
            border: 1px solid rgba(230,237,245,.96);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            padding: 10px;
        }

        .dropdown-item {
            border-radius: 12px;
            font-weight: 600;
            padding-top: 10px;
            padding-bottom: 10px;
        }

            .dropdown-item:active {
                background: rgba(37,99,235,.1);
                color: var(--text);
            }

        /* ═══════════════════════════════════
           DROPDOWN THÔNG BÁO HIỆN ĐẠI
        ═══════════════════════════════════ */
        .notification-dropdown {
            width: min(390px, calc(100vw - 24px));
            border: 1px solid rgba(226,232,240,.95) !important;
            border-radius: 22px !important;
            overflow: hidden;
            padding: 0 !important;
            box-shadow: 0 24px 70px rgba(15,23,42,.18) !important;
            background: #fff;
        }

        .notification-head {
            position: relative;
            padding: 16px 16px 14px;
            color: #fff;
            background: radial-gradient(circle at top right, rgba(255,255,255,.26), transparent 34%), linear-gradient(135deg, var(--primary), #3b82f6);
        }

        .notification-head-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .notification-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Sora', sans-serif;
            font-weight: 800;
            font-size: .98rem;
            line-height: 1.2;
        }

            .notification-title i {
                width: 34px;
                height: 34px;
                border-radius: 12px;
                background: rgba(255,255,255,.18);
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .notification-counter {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 26px;
            padding: 0 9px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
            border: 1px solid rgba(255,255,255,.25);
            font-size: .78rem;
            font-weight: 800;
        }

        .notification-sub {
            margin-top: 8px;
            color: rgba(255,255,255,.84);
            font-size: .8rem;
            line-height: 1.45;
        }

        .notification-tools {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 10px 12px;
            background: #f8fafc;
            border-bottom: 1px solid #e5ecf4;
        }

            .notification-tools .small-action {
                border: none;
                background: transparent;
                color: var(--primary);
                font-size: .78rem;
                font-weight: 800;
                padding: 6px 8px;
                border-radius: 10px;
                transition: var(--transition);
            }

                .notification-tools .small-action:hover {
                    background: #eff6ff;
                }

        .notification-list {
            max-height: 380px;
            overflow-y: auto;
            background: #fff;
        }

        .notification-item {
            display: flex !important;
            align-items: flex-start;
            gap: 12px;
            padding: 13px 14px !important;
            border-radius: 0 !important;
            border-bottom: 1px solid #eef2f7;
            white-space: normal !important;
            transition: var(--transition);
            color: var(--text) !important;
        }

            .notification-item:hover {
                background: #f8fbff !important;
            }

            .notification-item.is-unread {
                background: linear-gradient(90deg, rgba(37,99,235,.075), #fff);
            }

                .notification-item.is-unread:hover {
                    background: linear-gradient(90deg, rgba(37,99,235,.11), #f8fbff) !important;
                }

        .notification-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #2563eb;
            background: #eff6ff;
            border: 1px solid #dbeafe;
            font-size: 1.05rem;
        }

        .notification-content {
            min-width: 0;
            flex: 1;
        }

        .notification-row-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 3px;
        }

        .notification-name {
            min-width: 0;
            flex: 1;
            font-weight: 800;
            color: #0f172a;
            font-size: .9rem;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .notification-dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #ef4444;
            box-shadow: 0 0 0 4px rgba(239,68,68,.11);
            flex-shrink: 0;
        }

        .notification-preview {
            color: #64748b;
            font-size: .8rem;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-bottom: 7px;
        }

        .notification-meta {
            display: flex;
            align-items: center;
            gap: 7px;
            flex-wrap: wrap;
        }

        .notification-type {
            display: inline-flex;
            align-items: center;
            height: 22px;
            padding: 0 8px;
            border-radius: 999px;
            background: #f1f5f9;
            color: #475569;
            font-size: .68rem;
            font-weight: 800;
        }

        .notification-time {
            color: #94a3b8;
            font-size: .72rem;
            font-weight: 700;
        }

        .notification-empty {
            padding: 34px 22px;
            text-align: center;
            color: #64748b;
        }

            .notification-empty .empty-icon {
                width: 58px;
                height: 58px;
                margin: 0 auto 12px;
                border-radius: 20px;
                background: #eff6ff;
                color: #2563eb;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.55rem;
            }

        .notification-footer {
            display: grid;
            grid-template-columns: 1fr;
            gap: 8px;
            padding: 12px;
            background: #f8fafc;
            border-top: 1px solid #e5ecf4;
        }

        .notification-view-all {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            min-height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff !important;
            font-family: 'Sora', sans-serif;
            font-weight: 800;
            font-size: .86rem;
            text-decoration: none;
            transition: var(--transition);
        }

            .notification-view-all:hover {
                transform: translateY(-1px);
                color: #fff !important;
                box-shadow: 0 12px 24px rgba(37,99,235,.22);
            }

        /* Badge chuông tự cập nhật */
        .js-notification-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* Popup nhanh khi có thông báo mới */
        .notification-toast {
            position: fixed;
            top: 92px;
            right: 22px;
            width: min(360px, calc(100vw - 24px));
            z-index: 3060;
            display: none;
            border-radius: 20px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #dbeafe;
            box-shadow: 0 22px 60px rgba(15,23,42,.18);
        }

        .notification-toast-inner {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 15px;
        }

        .notification-toast-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notification-toast-title {
            font-weight: 800;
            color: #0f172a;
            font-size: .92rem;
            line-height: 1.35;
            margin-bottom: 3px;
        }

        .notification-toast-text {
            color: #64748b;
            font-size: .8rem;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin: 0;
        }

        .notification-toast-close {
            margin-left: auto;
            border: none;
            background: #f1f5f9;
            color: #64748b;
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        @@media (max-width: 575.98px) {
            .notification-toast {
                top: 74px;
                right: 12px;
            }

            .notification-dropdown {
                width: calc(100vw - 18px);
            }
        }

        /* ═══════════════════════════════════
                                   MOBILE HEADER ACTIONS
                        ═══════════════════════════════════ */
        .mobile-header-actions {
            display: none;
            align-items: center;
            gap: 8px;
            margin-left: auto;
            flex-shrink: 0;
            min-width: 0;
        }

            .mobile-header-actions .icon-btn {
                width: 42px;
                height: 42px;
            }

        .mobile-avatar-btn img {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #dbeafe;
            display: block;
        }
            .mobile-header-actions .btn-post-ad-sm {
                width: 42px;
                height: 42px;
                padding: 0;
            }

            .mobile-header-actions .menu-btn {
                width: 42px;
                height: 42px;
                background: #fff;
                border: 1px solid var(--border);
                box-shadow: var(--shadow-sm);
            }

                .mobile-header-actions .menu-btn i {
                    font-size: 1.55rem;
                    line-height: 1;
                    color: var(--primary);
                }

        /* ═══════════════════════════════════
                                   MOBILE OFFCANVAS
                        ═══════════════════════════════════ */
        .offcanvas-mobile {
            width: min(92vw, 400px);
            border-left: 1px solid rgba(229,234,242,.92);
            z-index: 1055;
        }

            .offcanvas-mobile .offcanvas-header {
                padding: 16px 20px;
                background: linear-gradient(135deg, #1d4ed8, #2563eb);
                color: #fff;
                flex-shrink: 0;
            }

            .offcanvas-mobile .offcanvas-body {
                padding: 0;
                background: #f0f4f9;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 0;
            }

        /* ── Block tài khoản ── */
        .mob-account-block {
            background: #fff;
            padding: 20px 20px 16px;
            border-bottom: 1px solid #e8eef6;
        }

        .mob-user-row {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 16px;
        }

            .mob-user-row img {
                width: 52px;
                height: 52px;
                border-radius: 50%;
                object-fit: cover;
                border: 2.5px solid #dbeafe;
                flex-shrink: 0;
            }

        .mob-user-name {
            font-family: 'Sora', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            color: var(--text);
            margin: 0 0 5px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mob-user-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: .74rem;
            font-weight: 600;
            padding: 3px 10px;
            border-radius: 100px;
        }

        .mob-badge-personal {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .mob-badge-business {
            background: #eff6ff;
            color: #2563eb;
            border: 1px solid #bfdbfe;
        }

        .mob-badge-admin {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #fecaca;
        }

        /* Nút hành động */
        .mob-action-row {
            display: grid;
            gap: 10px;
        }

            .mob-action-row.two-col {
                grid-template-columns: 1fr 1fr;
            }

            .mob-action-row.one-col {
                grid-template-columns: 1fr;
            }

        .mob-action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 14px;
            border-radius: 12px;
            font-family: 'Sora', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            position: relative;
            white-space: nowrap;
        }

        .mob-btn-primary {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff !important;
            box-shadow: 0 4px 14px rgba(37,99,235,.25);
        }

            .mob-btn-primary:hover {
                transform: translateY(-1px);
                color: #fff !important;
            }

        .mob-btn-outline {
            background: #fff;
            color: var(--primary) !important;
            border: 1.5px solid #bfdbfe;
        }

            .mob-btn-outline:hover {
                background: #eff6ff;
                color: var(--primary) !important;
            }

        /* ── Block section (nav group) ── */
        .mob-section {
            background: #fff;
            margin-top: 10px;
            border-top: 1px solid #e8eef6;
            border-bottom: 1px solid #e8eef6;
        }

        .mob-section-title {
            font-family: 'Sora', sans-serif;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #94a3b8;
            padding: 14px 20px 6px;
        }

        .chat-property-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-width: 92%;
            align-self: flex-start;
        }

        .chat-property-card {
            display: grid;
            grid-template-columns: 92px minmax(0, 1fr);
            gap: 12px;
            background: #ffffff;
            border: 1px solid #dbeafe;
            border-left: 4px solid var(--primary);
            border-radius: 18px;
            padding: 12px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .07);
        }

        .chat-property-img-wrap {
            width: 92px;
            height: 92px;
            border-radius: 14px;
            overflow: hidden;
            background: #f1f5f9;
        }

            .chat-property-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .chat-property-info {
            min-width: 0;
        }

        .chat-property-title {
            color: #0f172a;
            font-size: .9rem;
            font-weight: 850;
            line-height: 1.35;
            margin-bottom: 5px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .chat-property-price {
            color: #2563eb;
            font-size: .95rem;
            font-weight: 900;
            margin-bottom: 5px;
        }

        .chat-property-meta {
            color: #64748b;
            font-size: .76rem;
            font-weight: 650;
            line-height: 1.35;
            margin-bottom: 3px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .chat-property-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 34px;
            margin-top: 8px;
            border-radius: 11px;
            background: #eff6ff;
            color: #1d4ed8 !important;
            border: 1px solid #bfdbfe;
            font-size: .82rem;
            font-weight: 850;
            text-decoration: none;
        }

            .chat-property-link:hover {
                background: #2563eb;
                color: #ffffff !important;
            }

        @@media (max-width: 575.98px) {
            .chat-property-list

        {
            max-width: 100%;
            width: 100%;
        }

        .chat-property-card {
            grid-template-columns: 82px minmax(0, 1fr);
            padding: 10px;
        }

        .chat-property-img-wrap {
            width: 82px;
            height: 82px;
        }

        }

        /* Nav items */
        .mob-nav-list {
            list-style: none;
            margin: 0;
            padding: 0 10px 10px;
        }

            .mob-nav-list li {
                margin: 0;
            }

        .mob-nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            font-family: 'Sora', sans-serif;
            font-size: .93rem;
            font-weight: 600;
            color: var(--text) !important;
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
        }

            .mob-nav-item:hover {
                background: #eff6ff;
                color: var(--primary) !important;
            }

                .mob-nav-item:hover .mob-nav-icon {
                    color: var(--primary);
                }

            .mob-nav-item.danger {
                color: #dc2626 !important;
            }

                .mob-nav-item.danger:hover {
                    background: #fef2f2;
                    color: #dc2626 !important;
                }

        .mob-nav-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .95rem;
            flex-shrink: 0;
            transition: var(--transition);
        }

        .icon-home {
            background: #eff6ff;
            color: #2563eb;
        }

        .icon-sell {
            background: #fff7ed;
            color: #ea580c;
        }

        .icon-rent {
            background: #f0fdf4;
            color: #16a34a;
        }

        .icon-project {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .icon-news {
            background: #fef9c3;
            color: #ca8a04;
        }

        .icon-contact {
            background: #ecfeff;
            color: #0891b2;
        }

        .icon-profile {
            background: #eff6ff;
            color: #2563eb;
        }

        .icon-myads {
            background: #f0fdf4;
            color: #16a34a;
        }

        .icon-fav {
            background: #fff1f2;
            color: #e11d48;
        }

        .icon-admin {
            background: #fef2f2;
            color: #dc2626;
        }

        .icon-crm {
            background: #f0fdf4;
            color: #16a34a;
        }

        .icon-kyc {
            background: #eff6ff;
            color: #0284c7;
        }

        .icon-logout {
            background: #fff1f2;
            color: #e11d48;
        }

        .icon-login {
            background: #eff6ff;
            color: #2563eb;
        }

        .icon-register {
            background: #f0fdf4;
            color: #16a34a;
        }

        .back-to-top-btn {
            position: fixed;
            right: 22px;
            bottom: 88px;
            z-index: 3040;
            width: 46px;
            height: 46px;
            border: none;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 16px 34px rgba(37,99,235,.28);
            opacity: 0;
            visibility: hidden;
            transform: translateY(12px);
            transition: all .22s ease;
        }

            .back-to-top-btn.show {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .back-to-top-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 20px 42px rgba(37,99,235,.34);
            }

            .back-to-top-btn i {
                font-size: 1.2rem;
                line-height: 1;
            }

        @@media (max-width: 575.98px) {
            .back-to-top-btn

        {
            right: 14px;
            bottom: 78px;
            width: 42px;
            height: 42px;
        }

        }

        /* ── Shortcut block (cuối) ── */
        .mob-shortcuts {
            background: #fff;
            margin-top: 10px;
            margin-bottom: 10px;
            border-top: 1px solid #e8eef6;
            border-bottom: 1px solid #e8eef6;
            padding: 6px 10px 14px;
        }

        .mob-shortcuts-title {
            font-family: 'Sora', sans-serif;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: #94a3b8;
            padding: 14px 10px 10px;
        }

        .mob-shortcut-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .mob-shortcut-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 11px 12px;
            border-radius: 12px;
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            font-family: 'Sora', sans-serif;
            font-size: .82rem;
            font-weight: 700;
            color: var(--text) !important;
            text-decoration: none;
            transition: var(--transition);
        }

            .mob-shortcut-btn:hover {
                background: #eff6ff;
                border-color: #bfdbfe;
                color: var(--primary) !important;
            }

            .mob-shortcut-btn i {
                font-size: .9rem;
                flex-shrink: 0;
            }

        /* ═══════════════════════════════════
                                   FOOTER
                        ═══════════════════════════════════ */
        .footer-modern {
            background: radial-gradient(circle at top left,rgba(14,165,233,.16),transparent 28%), radial-gradient(circle at top right,rgba(37,99,235,.14),transparent 24%), linear-gradient(180deg,#0b1220 0%,#0f172a 100%);
            color: #cbd5e1;
            margin-top: 72px;
            position: relative;
            overflow: hidden;
        }

            .footer-modern::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg,rgba(255,255,255,.03),transparent 40%);
                pointer-events: none;
            }

        .footer-top {
            position: relative;
            padding: 56px 0 34px;
            border-bottom: 1px solid rgba(148,163,184,.14);
        }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }

            .footer-brand img {
                width: 56px;
                height: 56px;
                object-fit: contain;
                flex-shrink: 0;
            }

        .footer-brand-title {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            line-height: 1.2;
        }

        .footer-brand-subtitle {
            margin: 3px 0 0;
            color: #94a3b8;
            font-size: .88rem;
            line-height: 1.5;
        }

        .footer-desc {
            color: #cbd5e1;
            font-size: .94rem;
            line-height: 1.9;
            margin-bottom: 18px;
        }

        .footer-section-title {
            color: #fff;
            font-weight: 800;
            font-size: .95rem;
            margin-bottom: 18px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .footer-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: .92rem;
            padding: 7px 0;
            transition: all .2s ease;
        }

            .footer-link:hover {
                color: #fff;
                transform: translateX(4px);
            }

            .footer-link i {
                color: #60a5fa;
                flex-shrink: 0;
            }

        .footer-contact {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .footer-contact-item {
            display: flex;
            gap: 12px;
            align-items: flex-start;
        }

            .footer-contact-item .icon {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: rgba(255,255,255,.06);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #7dd3fc;
                flex-shrink: 0;
            }

            .footer-contact-item .info {
                min-width: 0;
            }

            .footer-contact-item .label {
                display: block;
                font-size: .74rem;
                color: #94a3b8;
                text-transform: uppercase;
                letter-spacing: .08em;
                margin-bottom: 4px;
            }

            .footer-contact-item .value {
                color: #fff;
                text-decoration: none;
                font-weight: 600;
                line-height: 1.5;
            }

                .footer-contact-item .value:hover {
                    color: #7dd3fc;
                }

        .footer-socials {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 16px;
        }

        .footer-social {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.06);
            color: #fff;
            text-decoration: none;
            transition: all .2s ease;
        }

            .footer-social:hover {
                background: linear-gradient(135deg,#0ea5e9,#2563eb);
                transform: translateY(-2px);
                color: #fff;
            }

        .footer-badges {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 10px;
            margin-top: 18px;
        }

        .footer-badge {
            padding: 12px 14px;
            border-radius: 16px;
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(148,163,184,.12);
            color: #e2e8f0;
            font-size: .86rem;
            line-height: 1.5;
        }

            .footer-badge strong {
                display: block;
                color: #fff;
                font-size: .92rem;
                margin-bottom: 2px;
            }

        .footer-newsletter {
            border-radius: 20px;
            padding: 18px;
            background: linear-gradient(135deg,rgba(14,165,233,.14),rgba(37,99,235,.10));
            border: 1px solid rgba(125,211,252,.16);
        }

            .footer-newsletter p {
                color: #dbeafe;
                font-size: .92rem;
                margin-bottom: 14px;
                line-height: 1.7;
            }

            .footer-newsletter .form-control {
                background: rgba(15,23,42,.55);
                color: #fff;
                border: 1px solid rgba(148,163,184,.22);
                border-radius: 14px;
                box-shadow: none !important;
            }

                .footer-newsletter .form-control::placeholder {
                    color: #94a3b8;
                }

            .footer-newsletter .btn {
                border-radius: 14px;
                font-weight: 700;
                padding-left: 16px;
                padding-right: 16px;
            }

        .footer-trustbar {
            position: relative;
            padding: 18px 0;
            border-bottom: 1px solid rgba(148,163,184,.12);
            background: rgba(255,255,255,.02);
        }

        .footer-trust-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #e2e8f0;
            font-size: .9rem;
            line-height: 1.5;
        }

            .footer-trust-item i {
                width: 34px;
                height: 34px;
                border-radius: 10px;
                background: rgba(255,255,255,.06);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #7dd3fc;
                flex-shrink: 0;
            }

        .footer-bottom {
            position: relative;
            padding: 18px 0;
            background: rgba(0,0,0,.18);
        }

        .footer-bottom-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }

        .footer-bottom p {
            margin: 0;
            font-size: .88rem;
            color: #94a3b8;
        }

        .footer-legal {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            align-items: center;
        }

            .footer-legal a {
                color: #cbd5e1;
                text-decoration: none;
                font-size: .88rem;
            }

                .footer-legal a:hover {
                    color: #fff;
                }

        /* ═══════════════════════════════════
                                   AI CHAT
                        ═══════════════════════════════════ */
        .ai-chatbot-btn {
            position: fixed;
            right: 24px;
            bottom: 24px;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            border: 3px solid rgba(255,255,255,.35);
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 14px 34px rgba(37,99,235,.28);
            cursor: pointer;
            z-index: 2000;
            transition: var(--transition);
        }

            .ai-chatbot-btn:hover {
                transform: scale(1.06);
            }

        .chat-widget {
            position: fixed;
            right: 24px;
            bottom: 94px;
            width: 380px;
            height: 580px;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(15,23,42,.18);
            overflow: hidden;
            display: none;
            flex-direction: column;
            z-index: 2001;
            border: 1px solid rgba(229,234,242,.95);
        }

        .chat-header {
            padding: 16px 18px;
            background: linear-gradient(135deg, var(--primary), #3b82f6);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .chat-header h6 {
                margin: 0;
                font-size: .96rem;
                font-weight: 800;
            }

            .chat-header small {
                opacity: .85;
            }

        .chat-body {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .chat-message {
            max-width: 86%;
        }

            .chat-message.user {
                align-self: flex-end;
            }

            .chat-message.bot {
                align-self: flex-start;
            }

        .bubble {
            padding: 10px 14px;
            border-radius: 16px;
            line-height: 1.5;
            font-size: .92rem;
        }

        .user .bubble {
            background: var(--primary);
            color: #fff;
            border-radius: 16px 16px 4px 16px;
        }

        /* ----- CSS MỚI ĐỂ HIỂN THỊ ĐẸP MARKDOWN CHO AI ----- */
        .bot .bubble {
            background: #fff;
            color: var(--text);
            border: 1px solid var(--border);
            border-radius: 16px 16px 16px 4px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

            .bot .bubble p {
                margin-bottom: 0.75rem;
            }

                .bot .bubble p:last-child {
                    margin-bottom: 0;
                }

            .bot .bubble ul, .bot .bubble ol {
                margin-bottom: 0.75rem;
                padding-left: 1.5rem;
            }

            .bot .bubble li {
                margin-bottom: 0.25rem;
            }

            .bot .bubble strong {
                color: #0f172a;
                font-weight: 700;
            }
        /* ------------------------------------------------ */

        .typing-dots {
            display: flex;
            gap: 5px;
            padding: 6px 2px;
        }

            .typing-dots span {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: #94a3b8;
                animation: bounce 1.3s infinite ease-in-out;
            }

                .typing-dots span:nth-child(2) {
                    animation-delay: .18s;
                }

                .typing-dots span:nth-child(3) {
                    animation-delay: .36s;
                }

        @@keyframes bounce {
            0%, 80%, 100% {
                transform: scale(0);
            }

            40% {
                transform: scale(1);
            }
        }

        .chat-footer {
            padding: 12px;
            background: #fff;
            border-top: 1px solid var(--border);
        }

            .chat-footer .form-control {
                border-radius: 14px 0 0 14px;
                border: 1px solid var(--border);
                box-shadow: none !important;
            }

            .chat-footer .btn {
                border-radius: 0 14px 14px 0;
            }

        /* ═══════════════════════════════════
                                   RESPONSIVE
                        ═══════════════════════════════════ */
        @@media (max-width: 1399.98px) {
            .navbar > .container {
                min-height: 72px;
            }

            .user-pill {
                max-width: 200px;
            }

                .user-pill .name {
                    max-width: 100px;
                }
        }

        @@media (max-width: 1199.98px) {
            .navbar > .container {
                min-height: 68px;
            }

            .desktop-shell {
                display: none !important;
            }

            .mobile-header-actions {
                display: flex !important;
            }

            .navbar-brand img {
                height: 42px;
            }

            .brand-subtitle {
                display: none;
            }
        }

        @@media (max-width: 991.98px) {
            .footer-top {
                padding: 44px 0 28px;
            }

            .footer-badges {
                grid-template-columns: 1fr;
            }

            .footer-bottom-inner {
                justify-content: center;
                text-align: center;
            }

            .footer-legal {
                justify-content: center;
            }

            .chat-widget {
                width: calc(100vw - 24px);
                right: 12px;
                left: 12px;
                height: 72vh;
            }

            .ai-chatbot-btn {
                right: 14px;
                bottom: 14px;
            }
        }
        @@media (max-width: 575.98px) {
            body

        {
            padding-top: 64px;
        }
        @@media (max-width: 575.98px) {
            .navbar > .container {
                min-height: 64px;
                gap: 10px;
            }

            .navbar-brand {
                max-width: calc(100% - 160px);
            }

                .navbar-brand img {
                    height: 38px;
                }

            .brand-text {
                display: none;
            }

            .mobile-header-actions {
                gap: 8px;
            }

                .mobile-header-actions .icon-btn,
                .mobile-header-actions .btn-post-ad-sm,
                .mobile-header-actions .menu-btn {
                    width: 40px;
                    height: 40px;
                }

            .footer-brand {
                align-items: flex-start;
            }

                .footer-brand img {
                    width: 48px;
                    height: 48px;
                }

            .footer-newsletter {
                padding: 16px;
            }

            .ai-chatbot-btn {
                width: 54px;
                height: 54px;
            }

            .mob-action-row.two-col {
                grid-template-columns: 1fr;
            }

            .mob-shortcut-grid {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
</head>
<body>
    @if (TempData["NewsletterSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3 position-fixed top-0 end-0 shadow"
             style="z-index:3000;max-width:360px;">
            @TempData["NewsletterSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["NewsletterError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3 position-fixed top-0 end-0 shadow"
             style="z-index:3000;max-width:360px;">
            @TempData["NewsletterError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <header class="header-main">
        <nav class="navbar navbar-expand-xl navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="Trang chủ BĐS Khánh Hòa">
                    <img src="/images/logo.png" alt="BDS Khánh Hòa Logo">
                    <div class="brand-text">
                        <p class="brand-title">BĐS Khánh Hòa</p>
                        <p class="brand-subtitle">Mua bán · Cho thuê · Dự án</p>
                    </div>
                </a>

                <div class="mobile-header-actions d-xl-none ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (!isAdminOrStaff)
                        {
                            <a href="/Notification/Index" class="icon-btn position-relative" title="Thông báo">
                                <i class="bi bi-bell-fill"></i>

                                <span id="mobileNotificationBadge"
                                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white js-notification-badge"
                                      style="font-size:.63rem;@(unreadCount > 0 ? "" : "display:none!important;")">
                                    @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                                </span>
                            </a>
                        }

                        @if (canPostSingleAd)
                        {
                            <a href="/Property/Create" class="btn-post-ad btn-post-ad-sm" title="Đăng tin">
                                <i class="bi bi-plus-lg"></i>
                            </a>
                        }
                        else
                        {
                            <a href="/Account/Profile" class="icon-btn mobile-avatar-btn" title="Tài khoản">
                                <img src="@avatarUrl" alt="Avatar">
                            </a>
                        }
                    }
                    else
                    {
                        <a href="/Account/Login" class="icon-btn" title="Đăng nhập">
                            <i class="bi bi-person-lock"></i>
                        </a>
                    }
                    <button class="navbar-toggler menu-btn" type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#mobileMenu"
                            aria-controls="mobileMenu"
                            aria-label="Mở menu">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="desktop-shell w-100 d-none d-xl-flex">
                    <ul class="navbar-nav mx-auto mb-0 flex-row">
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i><span class="nav-text">Trang chủ</span>
                            </a>
                        </li>
                        @await Component.InvokeAsync("NavbarMenu")
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" href="/Project">
                                <i class="bi bi-buildings me-1"></i><span class="nav-text">Dự án</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" href="/Blog">
                                <i class="bi bi-newspaper me-1"></i><span class="nav-text">Tin thị trường</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Contact" asp-action="Index">
                                <i class="bi bi-chat-dots me-1"></i><span class="nav-text">Liên hệ</span>
                            </a>
                        </li>
                    </ul>

                    <div class="header-actions">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (canPostSingleAd)
                            {
                                <a href="/Property/Create" class="btn-post-ad">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Đăng tin</span>
                                </a>
                            }
                            @if (!isAdminOrStaff)
                            {
                                <div class="dropdown" id="notificationDropdownWrap">
                                    <a href="#"
                                       class="icon-btn position-relative"
                                       id="notificationBellBtn"
                                       data-bs-toggle="dropdown"
                                       data-bs-auto-close="outside"
                                       aria-expanded="false"
                                       title="Thông báo">
                                        <i class="bi bi-bell-fill" id="notificationBellIcon"></i>

                                        <span id="notificationBadge"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white js-notification-badge"
                                              style="font-size:.63rem;@(unreadCount > 0 ? "" : "display:none!important;")">
                                            @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                                        </span>
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationBellBtn">
                                        <div class="notification-head">
                                            <div class="notification-head-row">
                                                <div class="notification-title">
                                                    <i class="bi bi-bell-fill"></i>
                                                    <span>Thông báo của bạn</span>
                                                </div>
                                                <span class="notification-counter" id="notificationHeaderCount">
                                                    @(unreadCount > 0 ? unreadCount.ToString() : "0")
                                                </span>
                                            </div>
                                            <div class="notification-sub">
                                                Cập nhật nhanh lịch hẹn, tư vấn, tin nhắn và cảnh báo hệ thống.
                                            </div>
                                        </div>

                                        <div class="notification-tools">
                                            <span class="small text-muted fw-bold">
                                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>
                                                Tự động cập nhật
                                            </span>

                                            <form id="notificationMarkReadForm" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="small-action" id="btnMarkAllNotificationsRead">
                                                    Đánh dấu đã đọc
                                                </button>
                                            </form>
                                        </div>

                                        <div class="notification-list" id="notificationList">
                                            @if (topNotifications.Any())
                                            {
                                                foreach (var noti in topNotifications)
                                                {
                                                    string notiText = $"{noti.Title} {noti.Content}".ToLower();
                                                    string iconClass = "bi-bell-fill";
                                                    string typeName = "Hệ thống";

                                                    if (notiText.Contains("lịch hẹn"))
                                                    {
                                                        iconClass = "bi-calendar-check-fill";
                                                        typeName = "Lịch hẹn";
                                                    }
                                                    else if (notiText.Contains("tư vấn") || notiText.Contains("khách chờ"))
                                                    {
                                                        iconClass = "bi-headset";
                                                        typeName = "Tư vấn";
                                                    }
                                                    else if (notiText.Contains("bình luận"))
                                                    {
                                                        iconClass = "bi-chat-left-text-fill";
                                                        typeName = "Bình luận";
                                                    }
                                                    else if (notiText.Contains("tin nhắn") || notiText.Contains("chat"))
                                                    {
                                                        iconClass = "bi-chat-dots-fill";
                                                        typeName = "Tin nhắn";
                                                    }
                                                    else if (notiText.Contains("cảnh báo") || notiText.Contains("vi phạm"))
                                                    {
                                                        iconClass = "bi-shield-exclamation";
                                                        typeName = "Cảnh báo";
                                                    }

                                                    <a href="@(string.IsNullOrWhiteSpace(noti.ActionUrl) ? $"/Notification/Details/{noti.NotificationID}" : $"/Notification/ProcessAction/{noti.NotificationID}")"
                                                       class="dropdown-item notification-item @(noti.IsRead ? "" : "is-unread")">
                                                        <span class="notification-icon">
                                                            <i class="bi @iconClass"></i>
                                                        </span>

                                                        <span class="notification-content">
                                                            <span class="notification-row-top">
                                                                <span class="notification-name">@noti.Title</span>
                                                                @if (!noti.IsRead)
                                                                {
                                                                    <span class="notification-dot"></span>
                                                                }
                                                            </span>

                                                            <span class="notification-preview">@noti.Content</span>

                                                            <span class="notification-meta">
                                                                <span class="notification-type">@typeName</span>
                                                                <span class="notification-time">@noti.CreatedAt.ToString("HH:mm dd/MM")</span>
                                                            </span>
                                                        </span>
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <div class="notification-empty">
                                                    <div class="empty-icon">
                                                        <i class="bi bi-bell-slash"></i>
                                                    </div>
                                                    <div class="fw-bold text-dark mb-1">Chưa có thông báo</div>
                                                    <div class="small">Khi có lịch hẹn, tư vấn hoặc tin nhắn mới, hệ thống sẽ hiển thị tại đây.</div>
                                                </div>
                                            }
                                        </div>

                                        <div class="notification-footer">
                                            <a href="/Notification/Index" class="notification-view-all">
                                                <i class="bi bi-list-check"></i>
                                                Xem tất cả thông báo
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="dropdown">
                                <button class="btn p-0 border-0 bg-transparent" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-pill">
                                        <img src="@avatarUrl" alt="Avatar">
                                        <span class="name">@userName</span>
                                        <i class="bi bi-chevron-down text-secondary ms-1"></i>
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (isAdminOrStaff)
                                    {
                                        <li><h6 class="dropdown-header text-danger">Hệ thống quản trị</h6></li>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li>
                                                <a class="dropdown-item" href="/Admin/Dashboard">
                                                    <i class="bi bi-speedometer2 me-2 text-danger"></i>Bảng điều khiển Admin
                                                </a>
                                            </li>
                                        }
                                        else if (User.IsInRole("Staff"))
                                        {
                                            <li>
                                                <a class="dropdown-item" href="/Admin/StaffDashboard">
                                                    <i class="bi bi-person-badge-fill me-2 text-success"></i>Không gian làm việc (Staff)
                                                </a>
                                            </li>
                                        }
                                    }
                                    else if (isBusinessVerified)
                                    {
                                        <li><h6 class="dropdown-header text-primary fw-bold text-uppercase small" style="letter-spacing:1px;">Dành Cho Đối Tác</h6></li>
                                        <li>
                                            <a class="dropdown-item py-2 fw-semibold text-primary bg-light rounded-2 mx-2 mb-1" style="width: auto;" href="/MemberProject/Index">
                                                <i class="bi bi-rocket-takeoff-fill me-2 text-accent"></i>Vào Cổng Quản Lý Dự Án
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li><h6 class="dropdown-header text-muted">Tài khoản cá nhân</h6></li>
                                        <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person-circle me-2 text-primary"></i>Hồ sơ của tôi</a></li>
                                        <li><a class="dropdown-item" href="/Property/MyAds"><i class="bi bi-card-checklist me-2 text-primary"></i>Trung tâm cá nhân</a></li>
                                        <li><a class="dropdown-item" href="/Favorite/Index"><i class="bi bi-heart-fill me-2 text-danger"></i>Tin đã yêu thích</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger fw-bold">
                                                <i class="bi bi-box-arrow-right me-2"></i>Thoát tài khoản
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn-post-ad">
                                <i class="bi bi-person-lock"></i><span>Đăng nhập</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

