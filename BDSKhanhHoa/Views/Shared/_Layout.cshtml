        /* ═══════════════════════════════════
                                                   FOOTER GỌN GÀNG - GIỮ ĐỦ HỖ TRỢ & PHÁP LÝ
                                        ═══════════════════════════════════ */
        .footer-modern {
            background: radial-gradient(circle at top left, rgba(14,165,233,.12), transparent 28%), linear-gradient(180deg, #0b1220 0%, #0f172a 100%);
            color: #cbd5e1;
            margin-top: 44px;
            border-top: 1px solid rgba(148, 163, 184, .14);
        }

        .footer-top {
            padding: 32px 0 20px;
        }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

            .footer-brand img {
                width: 46px;
                height: 46px;
                object-fit: contain;
                flex-shrink: 0;
            }

        .footer-brand-title {
            margin: 0;
            font-size: 1rem;
            font-weight: 800;
            color: #fff;
            line-height: 1.2;
        }

        .footer-brand-subtitle {
            margin: 3px 0 0;
            color: #94a3b8;
            font-size: .8rem;
            line-height: 1.4;
        }

        .footer-desc {
            color: #cbd5e1;
            font-size: .88rem;
            line-height: 1.62;
            margin: 0;
            max-width: 500px;
        }

        .footer-section-title {
            color: #fff;
            font-weight: 800;
            font-size: .82rem;
            margin-bottom: 9px;
            text-transform: uppercase;
            letter-spacing: .045em;
        }

        .footer-link-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 4px;
        }

        .footer-link {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #cbd5e1;
            text-decoration: none;
            font-size: .84rem;
            padding: 2px 0;
            line-height: 1.35;
            transition: color .18s ease, transform .18s ease;
        }

            .footer-link:hover {
                color: #fff;
                transform: translateX(3px);
            }

            .footer-link i {
                color: #60a5fa;
                flex-shrink: 0;
                font-size: .9rem;
            }

        .footer-contact {
            display: grid;
            gap: 8px;
        }

        .footer-contact-item {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
        }

            .footer-contact-item .icon {
                width: 32px;
                height: 32px;
                border-radius: 11px;
                background: rgba(255,255,255,.07);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: #7dd3fc;
                flex-shrink: 0;
            }

            .footer-contact-item .info {
                min-width: 0;
            }

            .footer-contact-item .label {
                display: block;
                font-size: .64rem;
                color: #94a3b8;
                text-transform: uppercase;
                letter-spacing: .07em;
                margin-bottom: 1px;
            }

            .footer-contact-item .value {
                color: #fff;
                text-decoration: none;
                font-size: .84rem;
                font-weight: 700;
                line-height: 1.32;
                word-break: break-word;
            }

        .footer-socials {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 12px;
        }

        .footer-social {
            width: 34px;
            height: 34px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.07);
            color: #fff;
            text-decoration: none;
            transition: all .18s ease;
        }

            .footer-social:hover {
                background: linear-gradient(135deg,#0ea5e9,#2563eb);
                color: #fff;
                transform: translateY(-1px);
            }

        .footer-newsletter {
            margin-top: 18px;
            border-radius: 16px;
            padding: 12px;
            background: rgba(14,165,233,.10);
            border: 1px solid rgba(125,211,252,.16);
        }

            .footer-newsletter h5 {
                font-size: .95rem;
                margin: 0 0 3px;
            }

            .footer-newsletter p {
                color: #dbeafe;
                font-size: .8rem;
                margin: 0;
                line-height: 1.5;
            }

            .footer-newsletter .form-control {
                min-height: 40px;
                background: rgba(15,23,42,.55);
                color: #fff;
                border: 1px solid rgba(148,163,184,.22);
                border-radius: 12px;
                box-shadow: none !important;
                font-size: .86rem;
            }

                .footer-newsletter .form-control::placeholder {
                    color: #94a3b8;
                }

            .footer-newsletter .btn {
                min-height: 40px;
                border-radius: 12px;
                font-weight: 800;
                white-space: nowrap;
                font-size: .86rem;
            }

        .footer-bottom {
            padding: 12px 0;
            background: rgba(0,0,0,.16);
            border-top: 1px solid rgba(148,163,184,.12);
        }

        .footer-bottom-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .footer-bottom p {
            margin: 0;
            font-size: .8rem;
            color: #94a3b8;
        }

        .footer-legal {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
        }

            .footer-legal a {
                color: #cbd5e1;
                text-decoration: none;
                font-size: .8rem;
            }

                .footer-legal a:hover {
                    color: #fff;
                }

        @@media (max-width: 991.98px) {
            .footer-modern {
                margin-top: 32px;
            }

            .footer-top {
                padding: 24px 0 16px;
            }

            .footer-bottom-inner {
                justify-content: center;
                text-align: center;
            }

            .footer-legal {
                justify-content: center;
            }
        }

        @@media (max-width: 575.98px) {
            .footer-modern {
                margin-top: 26px;
            }

            .footer-top {
                padding: 18px 0 14px;
            }

            .footer-brand {
                margin-bottom: 8px;
            }

                .footer-brand img {
                    width: 40px;
                    height: 40px;
                }

            .footer-desc {
                font-size: .8rem;
                line-height: 1.5;
            }

            .footer-section-title {
                margin: 12px 0 7px;
                font-size: .76rem;
            }

            .footer-link-list {
                gap: 3px;
            }

            .footer-link {
                font-size: .78rem;
                padding: 1px 0;
                gap: 6px;
            }

            .footer-contact {
                gap: 7px;
            }

            .footer-contact-item .icon {
                width: 29px;
                height: 29px;
                border-radius: 10px;
            }

            .footer-contact-item .value {
                font-size: .78rem;
            }

            .footer-social {
                width: 32px;
                height: 32px;
            }

            .footer-newsletter {
                margin-top: 14px;
                padding: 10px;
            }

                .footer-newsletter h5 {
                    font-size: .88rem;
                }

                .footer-newsletter p {
                    font-size: .76rem;
                }

                .footer-newsletter form {
                    display: grid !important;
                    grid-template-columns: 1fr auto;
                    gap: 7px !important;
                }

                .footer-newsletter .form-control,
                .footer-newsletter .btn {
                    min-height: 38px;
                    font-size: .8rem;
                }

            .footer-bottom {
                padding: 10px 0;
            }

                .footer-bottom p,
                .footer-legal a {
                    font-size: .74rem;
                }

            .footer-legal {
                gap: 6px 9px;
            }
        }

        /* ═══════════════════════════════════
                                                   RESPONSIVE
                                        ═══════════════════════════════════ */
        @@media (max-width: 1399.98px) {
            .navbar > .container {
                min-height: 72px;
            }

            .user-pill {
                max-width: 200px;
            }

                .user-pill .name {
                    max-width: 100px;
                }
        }

        @@media (max-width: 1199.98px) {
            .navbar > .container {
                min-height: 68px;
            }

            .desktop-shell {
                display: none !important;
            }

            .mobile-header-actions {
                display: flex !important;
            }

            .navbar-brand img {
                height: 42px;
            }

            .brand-subtitle {
                display: none;
            }
        }

        @@media (max-width: 991.98px) {
            .footer-top {
                padding: 44px 0 28px;
            }

            .footer-badges {
                grid-template-columns: 1fr;
            }

            .footer-bottom-inner {
                justify-content: center;
                text-align: center;
            }

            .footer-legal {
                justify-content: center;
            }

            .chat-widget {
                width: calc(100vw - 24px);
                right: 12px;
                left: 12px;
                height: 72vh;
            }

            .ai-chatbot-btn {
                right: 14px;
                bottom: 14px;
            }
        }

        @@media (max-width: 575.98px) {
            body {
                padding-top: 64px;
            }

            @@media (max-width: 575.98px) {
                .navbar > .container {
                    min-height: 64px;
                    gap: 10px;
                }

                .navbar-brand {
                    max-width: calc(100% - 160px);
                }

                    .navbar-brand img {
                        height: 38px;
                    }

                .brand-text {
                    display: none;
                }

                .mobile-header-actions {
                    gap: 8px;
                }

                    .mobile-header-actions .icon-btn,
                    .mobile-header-actions .btn-post-ad-sm,
                    .mobile-header-actions .menu-btn {
                        width: 40px;
                        height: 40px;
                    }

                .footer-brand {
                    align-items: flex-start;
                }

                    .footer-brand img {
                        width: 48px;
                        height: 48px;
                    }

                .footer-newsletter {
                    padding: 16px;
                }

                .ai-chatbot-btn {
                    width: 54px;
                    height: 54px;
                }

                .mob-action-row.two-col {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>
    @if (TempData["NewsletterSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3 position-fixed top-0 end-0 shadow"
             style="z-index:3000;max-width:360px;">
            @TempData["NewsletterSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["NewsletterError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3 position-fixed top-0 end-0 shadow"
             style="z-index:3000;max-width:360px;">
            @TempData["NewsletterError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    <header class="header-main">
        <nav class="navbar navbar-expand-xl navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index" aria-label="Trang chủ BĐS Khánh Hòa">
                    <img src="/images/logo.png" alt="BDS Khánh Hòa Logo">
                    <div class="brand-text">
                        <p class="brand-title">BĐS Khánh Hòa</p>
                        <p class="brand-subtitle">Mua bán · Cho thuê · Dự án</p>
                    </div>
                </a>

                <div class="mobile-header-actions d-xl-none ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (!isAdminOrStaff)
                        {
                            <a href="/Notification/Index" class="icon-btn position-relative" title="Thông báo">
                                <i class="bi bi-bell-fill"></i>

                                <span id="mobileNotificationBadge"
                                      class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white js-notification-badge"
                                      style="font-size:.63rem;@(unreadCount > 0 ? "" : "display:none!important;")">
                                    @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                                </span>
                            </a>
                        }

                        @if (canPostSingleAd)
                        {
                            <a href="/Property/Create" class="btn-post-ad btn-post-ad-sm" title="Đăng tin">
                                <i class="bi bi-plus-lg"></i>
                            </a>
                        }
                        else
                        {
                            <a href="/Account/Profile" class="icon-btn mobile-avatar-btn" title="Tài khoản">
                                <img src="@avatarUrl" alt="Avatar">
                            </a>
                        }
                    }
                    else
                    {
                        <a href="/Account/Login" class="icon-btn" title="Đăng nhập">
                            <i class="bi bi-person-lock"></i>
                        </a>
                    }
                    <button class="navbar-toggler menu-btn" type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#mobileMenu"
                            aria-controls="mobileMenu"
                            aria-label="Mở menu">
                        <i class="bi bi-list"></i>
                    </button>
                </div>

                <div class="desktop-shell w-100 d-none d-xl-flex">
                    <ul class="navbar-nav mx-auto mb-0 flex-row">
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i><span class="nav-text">Trang chủ</span>
                            </a>
                        </li>
                        @await Component.InvokeAsync("NavbarMenu")
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" href="/Project">
                                <i class="bi bi-buildings me-1"></i><span class="nav-text">Dự án</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" href="/Blog">
                                <i class="bi bi-newspaper me-1"></i><span class="nav-text">Tin thị trường</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-main-link" asp-controller="Contact" asp-action="Index">
                                <i class="bi bi-chat-dots me-1"></i><span class="nav-text">Liên hệ</span>
                            </a>
                        </li>
                    </ul>

                    <div class="header-actions">
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (canPostSingleAd)
                            {
                                <a href="/Property/Create" class="btn-post-ad">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Đăng tin</span>
                                </a>
                            }
                            @if (!isAdminOrStaff)
                            {
                                <div class="dropdown" id="notificationDropdownWrap">
                                    <a href="#"
                                       class="icon-btn position-relative"
                                       id="notificationBellBtn"
                                       data-bs-toggle="dropdown"
                                       data-bs-auto-close="outside"
                                       aria-expanded="false"
                                       title="Thông báo">
                                        <i class="bi bi-bell-fill" id="notificationBellIcon"></i>

                                        <span id="notificationBadge"
                                              class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white js-notification-badge"
                                              style="font-size:.63rem;@(unreadCount > 0 ? "" : "display:none!important;")">
                                            @(unreadCount > 9 ? "9+" : unreadCount.ToString())
                                        </span>
                                    </a>

                                    <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationBellBtn">
                                        <div class="notification-head">
                                            <div class="notification-head-row">
                                                <div class="notification-title">
                                                    <i class="bi bi-bell-fill"></i>
                                                    <span>Thông báo của bạn</span>
                                                </div>
                                                <span class="notification-counter" id="notificationHeaderCount">
                                                    @(unreadCount > 0 ? unreadCount.ToString() : "0")
                                                </span>
                                            </div>
                                            <div class="notification-sub">
                                                Cập nhật nhanh lịch hẹn, tư vấn, tin nhắn và cảnh báo hệ thống.
                                            </div>
                                        </div>

                                        <div class="notification-tools">
                                            <span class="small text-muted fw-bold">
                                                <i class="bi bi-lightning-charge-fill text-warning me-1"></i>
                                                Tự động cập nhật
                                            </span>

                                            <form id="notificationMarkReadForm" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="button" class="small-action" id="btnMarkAllNotificationsRead">
                                                    Đánh dấu đã đọc
                                                </button>
                                            </form>
                                        </div>

                                        <div class="notification-list" id="notificationList">
                                            @if (topNotifications.Any())
                                            {
                                                foreach (var noti in topNotifications)
                                                {
                                                    string notiText = $"{noti.Title} {noti.Content}".ToLower();
                                                    string iconClass = "bi-bell-fill";
                                                    string typeName = "Hệ thống";

                                                    if (notiText.Contains("lịch hẹn"))
                                                    {
                                                        iconClass = "bi-calendar-check-fill";
                                                        typeName = "Lịch hẹn";
                                                    }
                                                    else if (notiText.Contains("tư vấn") || notiText.Contains("khách chờ"))
                                                    {
                                                        iconClass = "bi-headset";
                                                        typeName = "Tư vấn";
                                                    }
                                                    else if (notiText.Contains("bình luận"))
                                                    {
                                                        iconClass = "bi-chat-left-text-fill";
                                                        typeName = "Bình luận";
                                                    }
                                                    else if (notiText.Contains("tin nhắn") || notiText.Contains("chat"))
                                                    {
                                                        iconClass = "bi-chat-dots-fill";
                                                        typeName = "Tin nhắn";
                                                    }
                                                    else if (notiText.Contains("cảnh báo") || notiText.Contains("vi phạm"))
