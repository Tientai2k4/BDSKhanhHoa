    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity.IsAuthenticated && !isAdminOrStaff)
    {
        <script>
            (function () {
                let lastLatestNotificationId = 0;
                let firstNotificationLoad = true;
                let notificationTimer = null;
                let toastTimer = null;

                const refreshUrl = '/Notification/GetLatest';
                const markAllReadUrl = '/Notification/MarkAllAsRead';

                function escapeHtml(value) {
                    if (value === null || value === undefined) return '';

                    return String(value)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#039;');
                }

                function formatBadge(count) {
                    count = parseInt(count || 0);
                    if (count <= 0) return '0';
                    return count > 9 ? '9+' : count.toString();
                }

                function setBadge(count) {
                    count = parseInt(count || 0);

                    const badgeText = formatBadge(count);

            $('#notificationBadge, #mobileNotificationBadge, #offcanvasNotificationBadge').text(badgeText);
            $('#notificationHeaderCount').text(count > 99 ? '99+' : count.toString());

                    if (count > 0) {
                                   $('#notificationBadge, #mobileNotificationBadge').attr('style', 'font-size:.63rem;');
            $('#offcanvasNotificationBadge').attr('style', 'font-size:.6rem;transform:translate(-60%,-30%)!important;');
                        $('#notificationBellIcon').addClass('text-primary');
                    } else {
                                   $('#notificationBadge, #mobileNotificationBadge').attr('style', 'font-size:.63rem;display:none!important;');
            $('#offcanvasNotificationBadge').attr('style', 'font-size:.6rem;transform:translate(-60%,-30%)!important;display:none!important;');
                        $('#notificationBellIcon').removeClass('text-primary');
                    }
                }

                function buildNotificationItem(item) {
                    const url = item.hasAction ? item.processUrl : item.detailUrl;
                    const unreadClass = item.isRead ? '' : 'is-unread';
                    const dotHtml = item.isRead ? '' : '<span class="notification-dot"></span>';

                    return `
                        <a href="${escapeHtml(url)}" class="dropdown-item notification-item ${unreadClass}">
                            <span class="notification-icon">
                                <i class="bi ${escapeHtml(item.icon || 'bi-bell-fill')}"></i>
                            </span>

                            <span class="notification-content">
                                <span class="notification-row-top">
                                    <span class="notification-name">${escapeHtml(item.title)}</span>
                                    ${dotHtml}
                                </span>

                                <span class="notification-preview">${escapeHtml(item.content)}</span>

                                <span class="notification-meta">
                                    <span class="notification-type">${escapeHtml(item.typeName || 'Hệ thống')}</span>
                                    <span class="notification-time">${escapeHtml(item.createdAt || '')}</span>
                                </span>
                            </span>
                        </a>
                    `;
                }

                function buildEmptyNotification() {
                    return `
                        <div class="notification-empty">
                            <div class="empty-icon">
                                <i class="bi bi-bell-slash"></i>
                            </div>
                            <div class="fw-bold text-dark mb-1">Chưa có thông báo</div>
                            <div class="small">Khi có lịch hẹn, tư vấn hoặc tin nhắn mới, hệ thống sẽ hiển thị tại đây.</div>
                        </div>
                    `;
                }

                function renderNotifications(items) {
                    const $list = $('#notificationList');

                    if (!Array.isArray(items) || items.length === 0) {
                        $list.html(buildEmptyNotification());
                        return;
                    }

                    let html = '';
                    items.forEach(function (item) {
                        html += buildNotificationItem(item);
                    });

                    $list.html(html);
                }

                function showNotificationToast(item) {
                    if (!item) return;

                    $('#notificationToastIcon').attr('class', 'bi ' + escapeHtml(item.icon || 'bi-bell-fill'));
                    $('#notificationToastTitle').text(item.title || 'Thông báo mới');
                    $('#notificationToastText').text(item.content || 'Bạn vừa có thông báo mới.');

                    clearTimeout(toastTimer);

                    $('#notificationToast')
                        .stop(true, true)
                        .fadeIn(180);

                    toastTimer = setTimeout(function () {
                        $('#notificationToast').fadeOut(220);
                    }, 5200);
                }

                function fetchNotifications(showToastWhenNew) {
                    $.ajax({
                        url: refreshUrl,
                        type: 'GET',
                        cache: false,
                        success: function (res) {
                            if (!res || !res.success) return;

                            setBadge(res.unreadCount);
                            renderNotifications(res.items);

                            const latestId = parseInt(res.latestId || 0);

                            if (firstNotificationLoad) {
                                lastLatestNotificationId = latestId;
                                firstNotificationLoad = false;
                                return;
                            }

                            if (showToastWhenNew && latestId > lastLatestNotificationId && Array.isArray(res.items) && res.items.length > 0) {
                                showNotificationToast(res.items[0]);
                            }

                            if (latestId > lastLatestNotificationId) {
                                lastLatestNotificationId = latestId;
                            }
                        }
                    });
                }

                function markAllAsRead() {
                    const token = $('#notificationMarkReadForm input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: markAllReadUrl,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: token
                        },
                        success: function (res) {
                            if (res && res.success) {
                                fetchNotifications(false);
                            }
                        }
                    });
                }

                $(document).on('click', '#btnMarkAllNotificationsRead', function (e) {
                    e.preventDefault();
                    markAllAsRead();
                });

                $(document).on('click', '#notificationToastClose', function () {
                    $('#notificationToast').fadeOut(160);
                });

                $('#notificationDropdownWrap').on('shown.bs.dropdown', function () {
                    fetchNotifications(false);
                });

                $(document).ready(function () {
                    fetchNotifications(false);

                    notificationTimer = setInterval(function () {
                        fetchNotifications(true);
                    }, 15000);
                });
            })();
        </script>
    }
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

    <script>
        $(function () {
            const $btn = $('#chatbotToggle');
            const $widget = $('#chatWidget');
            const $input = $('#chatInput');
            const $body = $('#chatBody');
            const $sendBtn = $('#chatSendBtn');

            if (typeof marked !== 'undefined') {
                marked.setOptions({
                    breaks: true,
                    gfm: true
                });
            }

            let chatHistory = JSON.parse(sessionStorage.getItem('bds_chat_history')) || [];

            function saveHistory() {
                sessionStorage.setItem('bds_chat_history', JSON.stringify(chatHistory));
            }

            function scrollBottom() {
                $body.scrollTop($body[0].scrollHeight);
            }

            function appendMessageHTML(text, sender, save = true) {
                let formattedText = text || '';

                if (sender === 'bot') {
                    formattedText = typeof marked !== 'undefined'
                        ? marked.parse(formattedText)
                        : formattedText.replace(/\n/g, '<br>');
                } else {
                    formattedText = $('<div>').text(formattedText).html().replace(/\n/g, '<br>');
                }

                const html = `
                    <div class="chat-message ${sender} animate__animated animate__fadeInUp animate__faster">
                        <div class="bubble">${formattedText}</div>
                    </div>
                `;

                $body.append(html);
                scrollBottom();

                if (save) {
                    chatHistory.push({
                        role: sender,
                        text: text,
                        isCard: false
                    });

                    saveHistory();
                }
            }

            function appendTyping() {
                const html = `
                    <div class="chat-message bot typing-message">
                        <div class="bubble">
                            <div class="typing-dots">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                `;

                $body.append(html);
                scrollBottom();
            }

            function removeTyping() {
                $('.typing-message').remove();
            }

            function escapeHtml(value) {
                return (value || '')
                    .toString()
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function renderPropertyCards(properties, save = true) {
                if (!Array.isArray(properties) || properties.length === 0) {
                    return;
                }

                let html = `<div class="chat-property-list animate__animated animate__fadeInUp animate__faster">`;

                properties.forEach(function (p) {
                    const title = escapeHtml(p.title);
                    const price = escapeHtml(p.price || 'Thỏa thuận');
                    const areaSize = escapeHtml(p.areaSize || '');
                    const location = escapeHtml(p.location || '');
                    const link = escapeHtml(p.link || '#');
                    const image = escapeHtml(p.image || '/images/no-image.png');

                    html += `
                        <div class="chat-property-card">
                            <div class="chat-property-img-wrap">
                                <img src="${image}" alt="${title}" onerror="this.src='/images/no-image.png'">
                            </div>

                            <div class="chat-property-info">
                                <div class="chat-property-title">${title}</div>

                                <div class="chat-property-price">${price}</div>

                                ${areaSize ? `<div class="chat-property-meta"><i class="bi bi-aspect-ratio"></i> ${areaSize}</div>` : ''}
                                ${location ? `<div class="chat-property-meta"><i class="bi bi-geo-alt"></i> ${location}</div>` : ''}

                                <a href="${link}" class="chat-property-link">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    `;
                });

                html += `</div>`;

                $body.append(html);
                scrollBottom();

                if (save) {
                    chatHistory.push({
                        role: 'bot',
                        text: html,
                        isCard: true
                    });

                    saveHistory();
                }
            }

            function renderHistory() {
                $body.empty();

                if (chatHistory.length === 0) {
                    const propTitleMeta = document.querySelector('meta[name="chatbot-property-title"]');

                    if (propTitleMeta) {
                        const title = propTitleMeta.getAttribute('content');

                        appendMessageHTML(
                            `Chào bạn! Mình thấy bạn đang quan tâm đến **${title}**.\n\nBạn cần tư vấn về **giá**, **pháp lý**, **vị trí**, **tiện ích** hay muốn **đặt lịch xem thực tế** không ạ?`,
                            'bot',
                            false
                        );
                    } else {
                        appendMessageHTML(
                            'Chào bạn! Mình là trợ lý AI của **BĐS Khánh Hòa**.\n\nBạn có thể hỏi mình về **đăng tin**, **gói VIP**, **pháp lý**, **liên hệ hỗ trợ**, hoặc nói rõ nhu cầu nếu muốn mình tìm bất động sản phù hợp.',
                            'bot',
                            false
                        );
                    }

                    return;
                }

                chatHistory.forEach(function (msg) {
                    if (msg.isCard) {
                        $body.append(msg.text);
                    } else {
                        appendMessageHTML(msg.text, msg.role, false);
                    }
                });

                scrollBottom();
            }

            renderHistory();

            if (sessionStorage.getItem('bds_chat_isOpen') === 'true') {
                $widget.show().css('display', 'flex');
            }

            $btn.on('click', function () {
                if ($widget.is(':visible')) {
                    $widget.fadeOut(180);
                    sessionStorage.setItem('bds_chat_isOpen', 'false');
                } else {
                    $widget.fadeIn(180).css('display', 'flex');
                    $input.trigger('focus');
                    sessionStorage.setItem('bds_chat_isOpen', 'true');
                    scrollBottom();
                }
            });

            $('#chatClose').on('click', function () {
                $widget.fadeOut(180);
                sessionStorage.setItem('bds_chat_isOpen', 'false');
            });

            function getPageContext() {
                let contextParts = [];

                const propTitle = document.querySelector('meta[name="chatbot-property-title"]');
                const propPrice = document.querySelector('meta[name="chatbot-property-price"]');
                const propArea = document.querySelector('meta[name="chatbot-property-area"]');
                const propLocation = document.querySelector('meta[name="chatbot-property-location"]');
                const propType = document.querySelector('meta[name="chatbot-property-type"]');

                if (propTitle) {
                    contextParts.push('Tiêu đề tin: ' + propTitle.getAttribute('content'));
                }

                if (propPrice) {
                    contextParts.push('Giá: ' + propPrice.getAttribute('content'));
                }

                if (propArea) {
                    contextParts.push('Diện tích: ' + propArea.getAttribute('content'));
                }

                if (propLocation) {
                    contextParts.push('Vị trí: ' + propLocation.getAttribute('content'));
                }

                if (propType) {
                    contextParts.push('Loại BĐS: ' + propType.getAttribute('content'));
                }

                const pageTitle = document.title || '';
                if (pageTitle) {
                    contextParts.push('Trang hiện tại: ' + pageTitle);
                }

                return contextParts.join('\n');
            }

            async function handleChat() {
                const message = ($input.val() || '').trim();

                if (!message) {
                    return;
                }

                appendMessageHTML(message, 'user', true);
                $input.val('');
                $sendBtn.prop('disabled', true);
                appendTyping();

                try {
                    const response = await fetch('/api/chatbot/send', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            message: message,
                            pageContext: getPageContext()
                        })
                    });

                    removeTyping();

                    if (!response.ok) {
                        appendMessageHTML('Mình chưa thể kết nối trợ lý AI lúc này. Bạn thử lại sau ít phút nhé.', 'bot', true);
                        return;
                    }

                    const data = await response.json();

                    appendMessageHTML(data.message || 'Mình chưa có phản hồi phù hợp. Bạn hỏi lại rõ hơn giúp mình nhé.', 'bot', true);

                    // QUAN TRỌNG:
                    // Chỉ render card khi backend trả shouldShowSuggestions = true.
                    // Nhờ vậy chatbot không tự động đề xuất BĐS ở mọi câu hỏi nữa.
                    if (data.shouldShowSuggestions === true &&
                        Array.isArray(data.suggestedProperties) &&
                        data.suggestedProperties.length > 0) {
                        renderPropertyCards(data.suggestedProperties, true);
                    }
                } catch (error) {
                    removeTyping();
                    appendMessageHTML('Có lỗi kết nối mạng khi gửi tin nhắn. Bạn vui lòng thử lại nhé.', 'bot', true);
                } finally {
                    $sendBtn.prop('disabled', false);
                    $input.trigger('focus');
                }
            }

            $sendBtn.on('click', handleChat);

            $input.on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleChat();
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
