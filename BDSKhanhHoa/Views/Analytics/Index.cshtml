@model IEnumerable<BDSKhanhHoa.Models.Project>

@{
    ViewData["Title"] = "Báo cáo hiệu suất";
    Layout = "~/Views/Shared/_BusinessLayout.cshtml";

    int totalProjects = ViewBag.TotalProjects ?? 0;

    int totalLeads = ViewBag.TotalLeads ?? 0;
    int newLeads = ViewBag.NewLeads ?? 0;
    int contactedLeads = ViewBag.ContactedLeads ?? 0;
    int resolvedLeads = ViewBag.ResolvedLeads ?? 0;
    int invalidLeads = ViewBag.InvalidLeads ?? 0;

    int totalAppointments = ViewBag.TotalAppointments ?? 0;
    int pendingAppointments = ViewBag.PendingAppointments ?? 0;
    int confirmedAppointments = ViewBag.ConfirmedAppointments ?? 0;
    int completedAppointments = ViewBag.CompletedAppointments ?? 0;
    int cancelledAppointments = ViewBag.CancelledAppointments ?? 0;

    int totalProjectViews = ViewBag.TotalProjectViews ?? 0;
    int totalPropertyViews = ViewBag.TotalPropertyViews ?? 0;
    int totalViews = ViewBag.TotalViews ?? 0;
    int totalProperties = ViewBag.TotalProperties ?? 0;

    int totalSupportTickets = ViewBag.TotalSupportTickets ?? 0;
    int openSupportTickets = ViewBag.OpenSupportTickets ?? 0;
    int closedSupportTickets = ViewBag.ClosedSupportTickets ?? 0;

    string businessName = ViewBag.BusinessName as string ?? "Doanh nghiệp đối tác";

    var leadMap = ViewBag.LeadMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var newLeadMap = ViewBag.NewLeadMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var resolvedLeadMap = ViewBag.ResolvedLeadMap as Dictionary<int, int> ?? new Dictionary<int, int>();

    var appointmentMap = ViewBag.AppointmentMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var completedAppointmentMap = ViewBag.CompletedAppointmentMap as Dictionary<int, int> ?? new Dictionary<int, int>();

    var projectViewMap = ViewBag.ProjectViewMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var propertyViewMap = ViewBag.PropertyViewMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var totalViewMap = ViewBag.TotalViewMap as Dictionary<int, int> ?? new Dictionary<int, int>();

    var propertyCountMap = ViewBag.PropertyCountMap as Dictionary<int, int> ?? new Dictionary<int, int>();
    var supportMap = ViewBag.SupportMap as Dictionary<int, int> ?? new Dictionary<int, int>();

    decimal leadConversionRate = totalLeads > 0
        ? Math.Round((decimal)resolvedLeads * 100 / totalLeads, 1)
        : 0;

    decimal appointmentCompletionRate = totalAppointments > 0
        ? Math.Round((decimal)completedAppointments * 100 / totalAppointments, 1)
        : 0;

    decimal viewToLeadRate = totalViews > 0
        ? Math.Round((decimal)totalLeads * 100 / totalViews, 2)
        : 0;

    int totalInteractions = totalLeads + totalAppointments + totalSupportTickets;
}

@section Styles {
    <style>
        :root {
            --ana-blue: #2563eb;
            --ana-indigo: #4f46e5;
            --ana-green: #059669;
            --ana-amber: #d97706;
            --ana-red: #dc2626;
            --ana-dark: #0f172a;
            --ana-muted: #64748b;
            --ana-border: #e2e8f0;
            --ana-soft: #f8fafc;
            --ana-card: #ffffff;
            --ana-shadow: 0 16px 38px rgba(15, 23, 42, .07);
        }

        .ana-hero {
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at top right, rgba(37, 99, 235, .16), transparent 320px), linear-gradient(135deg, #ffffff, #f8fbff);
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: 28px;
            padding: 28px;
            box-shadow: var(--ana-shadow);
            margin-bottom: 22px;
        }

        .ana-title {
            color: var(--ana-dark);
            font-size: clamp(1.45rem, 2.5vw, 2.25rem);
            font-weight: 950;
            letter-spacing: -.04em;
            margin-bottom: 8px;
        }

        .ana-subtitle {
            color: var(--ana-muted);
            font-weight: 650;
            line-height: 1.65;
            margin-bottom: 0;
        }

        .ana-business {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 13px;
            color: var(--ana-blue);
            font-weight: 900;
        }

        .ana-stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 22px;
        }

        .ana-stat {
            position: relative;
            overflow: hidden;
            min-height: 150px;
            border-radius: 24px;
            padding: 22px;
            color: #fff;
            box-shadow: 0 16px 34px rgba(15, 23, 42, .12);
        }

            .ana-stat::after {
                content: "";
                position: absolute;
                width: 140px;
                height: 140px;
                right: -52px;
                top: -56px;
                background: rgba(255,255,255,.16);
                border-radius: 999px;
            }

        .ana-stat-label {
            font-size: .75rem;
            font-weight: 950;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .92;
            margin-bottom: 12px;
        }

        .ana-stat-value {
            font-size: 2.25rem;
            line-height: 1;
            font-weight: 950;
            letter-spacing: -.045em;
        }

        .ana-stat-note {
            margin-top: 10px;
            font-size: .82rem;
            font-weight: 750;
            opacity: .88;
        }

        .grad-blue {
            background: linear-gradient(135deg, #1d4ed8, #60a5fa);
        }

        .grad-amber {
            background: linear-gradient(135deg, #b45309, #f59e0b);
        }

        .grad-indigo {
            background: linear-gradient(135deg, #4338ca, #818cf8);
        }

        .grad-green {
            background: linear-gradient(135deg, #047857, #34d399);
        }

        .ana-card {
            background: #fff;
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: 24px;
            padding: 22px;
            box-shadow: var(--ana-shadow);
            height: 100%;
        }

        .ana-card-title {
            color: var(--ana-dark);
            font-weight: 950;
            margin-bottom: 16px;
        }

        .ana-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 11px 0;
            border-bottom: 1px dashed var(--ana-border);
        }

            .ana-row:last-child {
                border-bottom: 0;
            }

            .ana-row span {
                color: #475569;
                font-weight: 750;
            }

            .ana-row strong {
                color: var(--ana-dark);
                font-weight: 950;
            }

        .ana-progress {
            height: 10px;
            border-radius: 999px;
            background: #e2e8f0;
            overflow: hidden;
        }

            .ana-progress div {
                height: 100%;
                border-radius: 999px;
            }

        .bar-blue {
            background: var(--ana-blue);
        }

        .bar-green {
            background: var(--ana-green);
        }

        .bar-amber {
            background: var(--ana-amber);
        }

        .ana-table-card {
            background: #fff;
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: 24px;
            box-shadow: var(--ana-shadow);
            overflow: hidden;
        }

        .ana-table-head {
            padding: 22px 24px;
            border-bottom: 1px solid var(--ana-border);
            background: linear-gradient(135deg, #ffffff, #f8fafc);
        }

        .ana-table-title {
            color: var(--ana-dark);
            font-weight: 950;
            margin-bottom: 5px;
        }

        .ana-table-sub {
            color: var(--ana-muted);
            font-size: .92rem;
            font-weight: 650;
        }

        .ana-table {
            width: 100%;
            margin: 0;
        }

            .ana-table thead th {
                background: #f8fafc;
                color: #475569;
                font-size: .74rem;
                text-transform: uppercase;
                letter-spacing: .06em;
                font-weight: 950;
                padding: 15px 16px;
                border-bottom: 1px solid var(--ana-border);
                white-space: nowrap;
            }

            .ana-table tbody td {
                padding: 16px;
                vertical-align: middle;
                border-bottom: 1px solid #f1f5f9;
            }

        .ana-project-name {
            color: var(--ana-dark);
            font-weight: 950;
            line-height: 1.4;
        }

        .ana-project-meta {
            color: var(--ana-muted);
            font-size: .84rem;
            font-weight: 650;
            margin-top: 4px;
        }

        .ana-number-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 42px;
            height: 34px;
            border-radius: 999px;
            background: #eff6ff;
            color: var(--ana-blue);
            font-weight: 950;
            padding: 0 12px;
            white-space: nowrap;
        }

            .ana-number-pill.green {
                background: #dcfce7;
                color: #047857;
            }

            .ana-number-pill.amber {
                background: #fef3c7;
                color: #b45309;
            }

            .ana-number-pill.gray {
                background: #f1f5f9;
                color: #475569;
            }

        .ana-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 7px 12px;
            font-size: .76rem;
            font-weight: 900;
            white-space: nowrap;
        }

        .ana-status-green {
            background: #dcfce7;
            color: #047857;
        }

        .ana-status-gray {
            background: #f1f5f9;
            color: #475569;
        }

        .ana-mobile-list {
            display: none;
            padding: 16px;
            background: #f8fafc;
        }

        .ana-mobile-card {
            background: #fff;
            border: 1px solid rgba(148, 163, 184, .22);
            border-radius: 20px;
            padding: 16px;
            margin-bottom: 14px;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
        }

        .ana-mobile-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 14px;
        }

        .ana-mobile-box {
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 12px;
            text-align: center;
        }

            .ana-mobile-box strong {
                display: block;
                font-size: 1.08rem;
                font-weight: 950;
                color: var(--ana-dark);
            }

            .ana-mobile-box span {
                font-size: .72rem;
                color: var(--ana-muted);
                font-weight: 850;
                text-transform: uppercase;
            }

        .ana-empty {
            padding: 60px 24px;
            text-align: center;
            background: #fff;
            border-radius: 24px;
            border: 1px dashed #cbd5e1;
        }

        @@media (max-width: 1199.98px) {
            .ana-stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 991.98px) {
            .desktop-table-wrap {
                display: none;
            }

            .ana-mobile-list {
                display: block;
            }
        }

        @@media (max-width: 575.98px) {
            .ana-hero,
            .ana-card,
            .ana-table-card {
                border-radius: 20px;
            }

            .ana-hero,
            .ana-card {
                padding: 18px;
            }

            .ana-stat-grid {
                grid-template-columns: 1fr;
            }

            .ana-mobile-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="ana-hero">
    <h1 class="ana-title">Báo cáo hiệu suất dự án</h1>

    <p class="ana-subtitle">
        Theo dõi hiệu quả dự án được Admin phân quyền: lượt xem dự án, lượt xem tin rao, khách tiềm năng, lịch hẹn và yêu cầu hỗ trợ.
    </p>

    <div class="ana-business">
        <i class="bi bi-patch-check-fill"></i>
        @businessName
    </div>
</div>

<div class="ana-stat-grid">
    <div class="ana-stat grad-blue">
        <div class="ana-stat-label">Tổng dự án</div>
        <div class="ana-stat-value">@totalProjects.ToString("N0")</div>
        <div class="ana-stat-note">Dự án được phân quyền quản lý</div>
    </div>

    <div class="ana-stat grad-green">
        <div class="ana-stat-label">Tổng lượt tiếp cận</div>
        <div class="ana-stat-value">@totalViews.ToString("N0")</div>
        <div class="ana-stat-note">@totalProjectViews.ToString("N0") lượt xem dự án · @totalPropertyViews.ToString("N0") lượt xem tin rao</div>
    </div>

    <div class="ana-stat grad-amber">
        <div class="ana-stat-label">Khách tiềm năng</div>
        <div class="ana-stat-value">@totalLeads.ToString("N0")</div>
        <div class="ana-stat-note">@newLeads.ToString("N0") khách mới cần xử lý</div>
    </div>

    <div class="ana-stat grad-indigo">
        <div class="ana-stat-label">Lịch hẹn</div>
        <div class="ana-stat-value">@totalAppointments.ToString("N0")</div>
        <div class="ana-stat-note">@confirmedAppointments.ToString("N0") lịch đã xác nhận</div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-xl-4">
        <div class="ana-card">
            <h5 class="ana-card-title">
                <i class="bi bi-funnel-fill text-primary me-1"></i>
                Phễu khách hàng
            </h5>

            <div class="ana-row">
                <span>Mới</span>
                <strong>@newLeads.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Đã liên hệ</span>
                <strong>@contactedLeads.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Đã chốt</span>
                <strong>@resolvedLeads.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Không hợp lệ</span>
                <strong>@invalidLeads.ToString("N0")</strong>
            </div>

            <div class="mt-3">
                <div class="d-flex justify-content-between small fw-bold text-muted mb-2">
                    <span>Tỷ lệ chốt lead</span>
                    <span>@leadConversionRate%</span>
                </div>

                <div class="ana-progress">
                    <div class="bar-green" style="width:@leadConversionRate%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="ana-card">
            <h5 class="ana-card-title">
                <i class="bi bi-calendar-check-fill text-success me-1"></i>
                Lịch hẹn dự án
            </h5>

            <div class="ana-row">
                <span>Chờ xác nhận / dời lịch</span>
                <strong>@pendingAppointments.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Đã xác nhận</span>
                <strong>@confirmedAppointments.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Đã hoàn tất</span>
                <strong>@completedAppointments.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Đã hủy / không đến</span>
                <strong>@cancelledAppointments.ToString("N0")</strong>
            </div>

            <div class="mt-3">
                <div class="d-flex justify-content-between small fw-bold text-muted mb-2">
                    <span>Tỷ lệ hoàn tất lịch</span>
                    <span>@appointmentCompletionRate%</span>
                </div>

                <div class="ana-progress">
                    <div class="bar-blue" style="width:@appointmentCompletionRate%"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="ana-card">
            <h5 class="ana-card-title">
                <i class="bi bi-speedometer2 text-warning me-1"></i>
                Chỉ số tương tác
            </h5>

            <div class="ana-row">
                <span>Tỷ lệ lead / lượt tiếp cận</span>
                <strong>@viewToLeadRate%</strong>
            </div>

            <div class="ana-row">
                <span>Tổng tương tác</span>
                <strong>@totalInteractions.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Tin rao thuộc dự án</span>
                <strong>@totalProperties.ToString("N0")</strong>
            </div>

            <div class="ana-row">
                <span>Hỗ trợ đang mở</span>
                <strong>@openSupportTickets.ToString("N0")</strong>
            </div>

            <div class="mt-3">
                <div class="d-flex justify-content-between small fw-bold text-muted mb-2">
                    <span>Tỷ trọng tương tác</span>
                    <span>@(totalInteractions > 0 ? "Có dữ liệu" : "Chưa có")</span>
                </div>

                <div class="ana-progress">
                    <div class="bar-amber" style="width:@(totalInteractions > 0 ? 100 : 0)%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ana-table-card">
    <div class="ana-table-head">
        <h5 class="ana-table-title">Hiệu suất theo từng dự án</h5>
        <div class="ana-table-sub">
            So sánh lead, lịch hẹn, lượt xem dự án, lượt xem tin rao, số tin rao và yêu cầu hỗ trợ.
        </div>
    </div>

    <div class="desktop-table-wrap table-responsive">
        <table class="table ana-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Dự án</th>
                    <th class="text-center">Lead</th>
                    <th class="text-center">Lead mới</th>
                    <th class="text-center">Lịch hẹn</th>
                    <th class="text-center">Xem dự án</th>
                    <th class="text-center">Xem tin rao</th>
                    <th class="text-center">Tin rao</th>
                    <th class="text-center">Hỗ trợ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        int leadCount = leadMap.ContainsKey(item.ProjectID) ? leadMap[item.ProjectID] : 0;
                        int newLeadCount = newLeadMap.ContainsKey(item.ProjectID) ? newLeadMap[item.ProjectID] : 0;
                        int appointmentCount = appointmentMap.ContainsKey(item.ProjectID) ? appointmentMap[item.ProjectID] : 0;
                        int projectViewCount = projectViewMap.ContainsKey(item.ProjectID) ? projectViewMap[item.ProjectID] : item.Views;
                        int propertyViewCount = propertyViewMap.ContainsKey(item.ProjectID) ? propertyViewMap[item.ProjectID] : 0;
                        int propertyCount = propertyCountMap.ContainsKey(item.ProjectID) ? propertyCountMap[item.ProjectID] : 0;
                        int supportCount = supportMap.ContainsKey(item.ProjectID) ? supportMap[item.ProjectID] : 0;

                        <tr>
                            <td>
                                <div class="ana-project-name">@item.ProjectName</div>
                                <div class="ana-project-meta">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                    @(item.Ward?.WardName ?? "Chưa có phường/xã"), @(item.Area?.AreaName ?? "Chưa có khu vực")
                                </div>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill">@leadCount.ToString("N0")</span>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill amber">@newLeadCount.ToString("N0")</span>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill">@appointmentCount.ToString("N0")</span>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill green">@projectViewCount.ToString("N0")</span>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill">@propertyViewCount.ToString("N0")</span>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill gray">@propertyCount.ToString("N0")</span>
                            </td>

                            <td class="text-center">
                                <span class="ana-number-pill gray">@supportCount.ToString("N0")</span>
                            </td>

                            <td>
                                <span class="ana-status @(item.ProjectStatus == "Đang mở bán" ? "ana-status-green" : "ana-status-gray")">
                                    <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                                    @(string.IsNullOrWhiteSpace(item.ProjectStatus) ? "Chưa cập nhật" : item.ProjectStatus)
                                </span>
                            </td>

                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    <a href="/MemberProject/Index?projectId=@item.ProjectID"
                                       class="btn btn-sm btn-outline-primary rounded-pill fw-bold">
                                        <i class="bi bi-funnel-fill me-1"></i>
                                        CRM
                                    </a>

                                    <a href="/Project/Details/@item.ProjectID"
                                       target="_blank"
                                       class="btn btn-sm btn-light border rounded-pill fw-bold">
                                        <i class="bi bi-eye-fill me-1"></i>
                                        Xem
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10">
                            <div class="ana-empty">
                                <i class="bi bi-bar-chart display-1 text-muted opacity-25 d-block mb-3"></i>
                                <h5 class="fw-bold text-dark">Chưa có dữ liệu thống kê</h5>
                                <div class="text-muted">
                                    Khi Admin gán dự án cho tài khoản này, báo cáo hiệu suất sẽ hiển thị tại đây.
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="ana-mobile-list">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                int leadCount = leadMap.ContainsKey(item.ProjectID) ? leadMap[item.ProjectID] : 0;
                int newLeadCount = newLeadMap.ContainsKey(item.ProjectID) ? newLeadMap[item.ProjectID] : 0;
                int appointmentCount = appointmentMap.ContainsKey(item.ProjectID) ? appointmentMap[item.ProjectID] : 0;
                int projectViewCount = projectViewMap.ContainsKey(item.ProjectID) ? projectViewMap[item.ProjectID] : item.Views;
                int propertyViewCount = propertyViewMap.ContainsKey(item.ProjectID) ? propertyViewMap[item.ProjectID] : 0;
                int propertyCount = propertyCountMap.ContainsKey(item.ProjectID) ? propertyCountMap[item.ProjectID] : 0;
                int supportCount = supportMap.ContainsKey(item.ProjectID) ? supportMap[item.ProjectID] : 0;

                <div class="ana-mobile-card">
                    <div class="ana-project-name">@item.ProjectName</div>
                    <div class="ana-project-meta">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                        @(item.Ward?.WardName ?? "Chưa có phường/xã"), @(item.Area?.AreaName ?? "Chưa có khu vực")
                    </div>

                    <div class="ana-mobile-grid">
                        <div class="ana-mobile-box">
                            <strong>@leadCount.ToString("N0")</strong>
                            <span>Lead</span>
                        </div>

                        <div class="ana-mobile-box">
                            <strong>@newLeadCount.ToString("N0")</strong>
                            <span>Lead mới</span>
                        </div>

                        <div class="ana-mobile-box">
                            <strong>@appointmentCount.ToString("N0")</strong>
                            <span>Lịch hẹn</span>
                        </div>

                        <div class="ana-mobile-box">
                            <strong>@projectViewCount.ToString("N0")</strong>
                            <span>Xem dự án</span>
                        </div>

                        <div class="ana-mobile-box">
                            <strong>@propertyViewCount.ToString("N0")</strong>
                            <span>Xem tin rao</span>
                        </div>

                        <div class="ana-mobile-box">
                            <strong>@propertyCount.ToString("N0")</strong>
                            <span>Tin rao</span>
                        </div>

                        <div class="ana-mobile-box">
                            <strong>@supportCount.ToString("N0")</strong>
                            <span>Hỗ trợ</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <a href="/MemberProject/Index?projectId=@item.ProjectID"
                           class="btn btn-outline-primary fw-bold rounded-pill">
                            <i class="bi bi-funnel-fill me-1"></i>
                            Mở CRM
                        </a>

                        <a href="/Project/Details/@item.ProjectID"
                           target="_blank"
                           class="btn btn-light border fw-bold rounded-pill">
                            <i class="bi bi-eye-fill me-1"></i>
                            Xem dự án
                        </a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="ana-empty">
                <i class="bi bi-bar-chart display-1 text-muted opacity-25 d-block mb-3"></i>
                <h5 class="fw-bold text-dark">Chưa có dữ liệu thống kê</h5>
                <div class="text-muted">
                    Khi Admin gán dự án cho tài khoản này, báo cáo sẽ hiển thị tại đây.
                </div>
            </div>
        }
    </div>
</div>