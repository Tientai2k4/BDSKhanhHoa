        flex: 1;
        min-width: 0;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 14px;
        padding: 11px 13px;
    }

    .pd-empty {
        text-align: center;
        border: 1px dashed var(--pd-border);
        background: var(--pd-soft);
        border-radius: 16px;
        padding: 28px 16px;
        color: var(--pd-muted);
        font-weight: 700;
    }

        .pd-empty i {
            display: block;
            font-size: 2rem;
            opacity: .45;
            margin-bottom: 8px;
        }

    .modal-content {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .24);
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: 1px solid var(--pd-border);
    }

    .form-control,
    .form-select {
