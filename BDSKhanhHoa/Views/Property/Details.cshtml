            background: #020617;
        }

        .pd-gallery-badges {
            left: 10px;
            top: 10px;
        }

        .pd-photo-count {
            right: 10px;
            bottom: 10px;
            min-height: 34px;
            font-size: .78rem;
        }

        .pd-thumb {
            width: 76px;
            height: 58px;
        }
