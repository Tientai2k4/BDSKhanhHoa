        color: var(--pd-primary);
        font-size: .82rem;
        font-weight: 850;
    }

    .pd-reply-form {
        display: none;
        margin: 10px 0 0 56px;
        padding: 12px;
        border: 1px dashed var(--pd-border);
        border-radius: 14px;
        background: #fff;
    }

        .pd-reply-form.active {
            display: block;
        }

    .pd-replies {
        margin: 12px 0 0 56px;
        padding-left: 18px;
        border-left: 2px solid var(--pd-border);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .pd-reply-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
