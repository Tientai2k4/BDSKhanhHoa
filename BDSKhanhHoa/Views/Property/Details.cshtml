</style>

<div class="pd-breadcrumb">
    <div class="container">
        <div class="pd-breadcrumb-inner">
            <a href="/"><i class="bi bi-house-door-fill me-1"></i>Trang chủ</a>
            <span class="pd-breadcrumb-sep">›</span>
            <a href="/BatDongSan/@(isRent ? "NhaDatChoThue" : "NhaDatBan")">@(isRent ? "Nhà đất cho thuê" : "Nhà đất bán")</a>
            <span class="pd-breadcrumb-sep">›</span>
            <a href="#">@Model.PropertyType?.TypeName</a>
            <span class="pd-breadcrumb-sep">›</span>
            <a href="#">@Model.Ward?.Area?.AreaName</a>
            <span class="pd-breadcrumb-sep">›</span>
            <span>@Model.Ward?.WardName</span>
        </div>
    </div>
</div>
@if (isLockedProperty)
{
    <div class="container py-3">
        <div class="pd-locked-detail-alert @(isExpiredProperty ? "pd-locked-expired" : "")">
            <div class="pd-locked-icon">
                <i class="bi @(isExpiredProperty ? "bi-clock-history" : "bi-lock-fill")"></i>
            </div>

            <div class="pd-locked-content">
                <h5>@lockedTitle</h5>
                <p>@lockedMessage</p>

                @if (Model.Status == "Expired")
                {
                    <div class="pd-locked-note">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        @(string.IsNullOrWhiteSpace(Model.RejectionReason)
                                        ? "Tin đã hết hạn hiển thị. Chủ tin cần đăng tin mới hoặc mua/gia hạn gói hiển thị mới nếu muốn tiếp tục quảng bá."
                                        : Model.RejectionReason)
            </div>
                        }
            </div>
        </div>
    </div>
}
<div class="pd-page">
    <div class="container my-4">
        @if (isLockedProperty)
        {
            <div class="pd-locked-alert">
                <div class="pd-locked-alert-icon"><i class="bi bi-shield-lock-fill"></i></div>
                <div>
                    <div class="pd-locked-alert-title">@lockedTitle</div>
                    <div class="pd-locked-alert-desc">
                        @lockedMessage
                        @if (Model.SoldAt.HasValue)
                        {
                            <span> Thời gian ghi nhận: <strong>@FormatDateTime(Model.SoldAt)</strong>.</span>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.Status == "Pending" && (isAdminOrStaff || isOwner))
        {
            <div class="pd-status-alert">
                <i class="bi bi-hourglass-split"></i>
                <div>
                    <strong>Tin đăng đang chờ kiểm duyệt.</strong>
                    Bài đăng chỉ hiển thị với bạn và Admin cho đến khi được phê duyệt.
                </div>
            </div>
        }

        <div class="pd-layout">
            <main>
                <div class="pd-gallery mb-2">
                    <div class="pd-gallery-badges">
                        @if (Model.PackageID != null && Model.PostServicePackage != null && Model.PostServicePackage.PackageType != "Tin Thường")
                        {
                            <span class="pd-badge pd-badge-vip">
                                <i class="bi bi-star-fill"></i>
                                VIP @Model.PostServicePackage.PackageType
                            </span>
                        }

                        @if (isLockedProperty)
                        {
                            <span class="pd-badge pd-locked-badge">
                                <i class="bi bi-lock-fill"></i>
                                @lockedTitle
                            </span>
                        }
                        else
                        {
                            <span class="pd-badge pd-badge-type">
                                <i class="bi bi-tag-fill"></i>
                                @(isRent ? "Cho thuê" : "Bán")
                            </span>
                        }
                    </div>

                    <img id="heroImg"
                         src="@GetSafeImage(mainImage)"
                         data-full="@GetSafeImage(mainImage)"
                         class="pd-hero-img"
                         alt="@Model.Title"
                         loading="eager"
                         decoding="async"
                         fetchpriority="high"
                         draggable="false"
                         onerror="this.onerror=null;this.src='/images/no-image.jpg';this.dataset.full='/images/no-image.jpg';"
                         data-bs-toggle="modal"
                         data-bs-target="#galleryModal" />

                    <div class="pd-gallery-gradient"></div>

                    <button type="button" class="pd-photo-count" data-bs-toggle="modal" data-bs-target="#galleryModal">
                        <i class="bi bi-images"></i>
                        @totalImages ảnh
                    </button>
                </div>

                @if (galleryImages.Count > 1)
                {
                    <div class="pd-thumbs">
                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            var imgUrl = GetSafeImage(galleryImages[i]);

                            <img src="@imgUrl"
                                 data-full="@imgUrl"
                                 class="pd-thumb @(i == 0 ? "active" : "")"
                                 onclick="switchImg(this)"
                                 loading="lazy"
                                 decoding="async"
                                 draggable="false"
                                 onerror="this.onerror=null;this.src='/images/no-image.jpg';this.dataset.full='/images/no-image.jpg';"
                                 alt="Ảnh bất động sản @(i + 1)" />
                        }
                    </div>
                }



                <section class="pd-card">
                    <div class="pd-card-body">
                        <div class="pd-title-row">
                            <div>
                                <h1 class="pd-title">@Model.Title</h1>
                                <div class="pd-address">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>@fullAddress</span>
                                </div>
                            </div>

                            @if (isOwner && !isLockedProperty)
                            {
                                <a href="/Property/Edit/@Model.PropertyID" class="pd-edit-btn">
                                    <i class="bi bi-pencil-square"></i>
                                    Sửa tin
                                </a>
                            }
                        </div>

                        <div class="pd-price-grid">
                            <div class="pd-price-cell">
                                <div class="pd-price-label">Mức giá</div>
                                <div class="pd-price-main">@priceDisplay</div>
                                @if (isRent)
                                {
                                    <div class="pd-price-unit">/ tháng</div>
                                }
                            </div>

                            <div class="pd-price-cell">
                                <div class="pd-price-label">Diện tích</div>
                                <div class="pd-price-value">@areaDisplay</div>
                            </div>

                            <div class="pd-price-cell">
                                <div class="pd-price-label">Đơn giá</div>
                                <div class="pd-price-value" style="font-size:1.05rem;">
                                    @(string.IsNullOrWhiteSpace(pricePerM2) ? "—" : pricePerM2)
                                </div>
                            </div>
                        </div>

                        <div class="pd-quick-list">
                            @if (!string.IsNullOrWhiteSpace(bed))
                            {
                                <span class="pd-pill"><i class="bi bi-door-closed"></i>@bed phòng ngủ</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(bath))
                            {
                                <span class="pd-pill"><i class="bi bi-droplet"></i>@bath phòng tắm</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(direction))
                            {
                                <span class="pd-pill"><i class="bi bi-compass"></i>Hướng @direction</span>
                            }

                            @if (!string.IsNullOrWhiteSpace(legal))
                            {
                                <span class="pd-pill"><i class="bi bi-patch-check"></i>@legal</span>
                            }

                            <span class="pd-pill"><i class="bi bi-eye"></i>@Model.Views lượt xem</span>
                            <span class="pd-pill"><i class="bi bi-calendar3"></i>Đăng @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </section>

                <section class="pd-card">
                    <div class="pd-card-body">
                        <div class="pd-section-title">
                            <i class="bi bi-list-ul"></i>
                            Thông tin chi tiết
                        </div>

                        <div class="pd-detail-grid">
                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-hash"></i>Mã tin</span>
                                <span class="pd-detail-val">#@Model.PropertyID</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-geo-alt"></i>Khu vực</span>
                                <span class="pd-detail-val">@Model.Ward?.Area?.AreaName</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-pin-map"></i>Phường/Xã</span>
                                <span class="pd-detail-val">@Model.Ward?.WardName</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-tag"></i>Loại hình</span>
                                <span class="pd-detail-val">@(Model.PropertyType?.TypeName ?? "Đang cập nhật")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-arrow-left-right"></i>Giao dịch</span>
                                <span class="pd-detail-val">@(isRent ? "Cho thuê" : "Mua bán")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-door-closed"></i>Phòng ngủ</span>
                                <span class="pd-detail-val">@(bed ?? "N/A")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-droplet"></i>Phòng tắm</span>
                                <span class="pd-detail-val">@(bath ?? "N/A")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-compass"></i>Hướng nhà</span>
                                <span class="pd-detail-val">@(direction ?? "N/A")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-arrows-expand"></i>Chiều ngang</span>
                                <span class="pd-detail-val">@(Model.Width.HasValue? Model.Width.Value.ToString("0.##", Vi) + " m" : "N/A")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-arrows-collapse"></i>Chiều dài</span>
                                <span class="pd-detail-val">@(Model.Length.HasValue? Model.Length.Value.ToString("0.##", Vi) + " m" : "N/A")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-patch-check"></i>Pháp lý</span>
                                <span class="pd-detail-val green">@(legal ?? "Đang cập nhật")</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-calendar-plus"></i>Ngày đăng</span>
                                <span class="pd-detail-val">@FormatShortDate(Model.CreatedAt)</span>
                            </div>

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-arrow-clockwise"></i>Cập nhật</span>
                                <span class="pd-detail-val green">@(Model.UpdatedAt.HasValue? FormatDateTime(Model.UpdatedAt) : FormatShortDate(Model.CreatedAt))</span>
                            </div>

                            @if (Model.VipExpiryDate.HasValue)
                            {
                                <div class="pd-detail-item">
                                    <span class="pd-detail-key"><i class="bi bi-clock-history"></i>Hết hạn VIP</span>
                                    <span class="pd-detail-val">@FormatShortDate(Model.VipExpiryDate)</span>
                                </div>
                            }

                            <div class="pd-detail-item">
                                <span class="pd-detail-key"><i class="bi bi-eye"></i>Lượt xem</span>
                                <span class="pd-detail-val">@Model.Views lượt</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pd-card">
                    <div class="pd-card-body">
                        <div class="pd-section-title">
                            <i class="bi bi-file-text"></i>
                            Mô tả bất động sản
                        </div>

                        <div id="descBody" class="pd-desc pd-desc-collapsed">@publicDescription</div>

                        <button id="readMoreBtn" type="button" class="pd-readmore" onclick="expandDesc()">
                            <i class="bi bi-chevron-down me-1"></i>
                            Xem thêm nội dung
                        </button>
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(amenities))
                {
                    <section class="pd-card">
                        <div class="pd-card-body">
                            <div class="pd-section-title">
                                <i class="bi bi-stars"></i>
                                Tiện ích nổi bật
                            </div>

                            <div class="pd-amenities">
                                @foreach (var am in amenities.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="pd-amenity">
                                        <i class="bi bi-check-circle-fill"></i>
                                        @am.Trim()
                                    </span>
                                }
                            </div>
                        </div>
                    </section>
                }

                <div class="pd-warning">
                    <i class="bi bi-shield-exclamation"></i>
                    <div>
                        <h6>Lưu ý an toàn giao dịch</h6>
                        <ul>
                            <li>Không chuyển khoản khi chưa gặp mặt trực tiếp và xác minh giấy tờ pháp lý bản gốc.</li>
                            <li>Luôn yêu cầu xem sổ đỏ/sổ hồng gốc và công chứng hợp đồng tại văn phòng công chứng.</li>
                            <li>Cẩn thận với các trường hợp yêu cầu đặt cọc trước khi ký hợp đồng chính thức.</li>
                            <li>Hệ thống không chịu trách nhiệm với các nội dung do người dùng tự đăng tải.</li>
                            <li>
                                Phát hiện tin giả / lừa đảo?
                                @if (canBuyerInteract)
                                {
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#reportModal" class="fw-bold text-danger">Báo cáo ngay tại đây</a>
                                }
                                else if (!isAuthenticated)
                                {
                                    <a href="@loginUrl" class="fw-bold text-primary">Đăng nhập để báo cáo</a>
                                }
                                else
                                {
                                    <span class="fw-bold text-muted">Chức năng báo cáo chỉ dành cho thành viên đang xem tin của người khác.</span>
                                }
                            </li>
                        </ul>
                    </div>
                </div>

                <section class="pd-card">
                    <div class="pd-card-body">
                        <div class="pd-section-title">
                            <i class="bi bi-map"></i>
                            Vị trí trên bản đồ
                        </div>

                        <div class="pd-map">
                            <iframe loading="lazy"
                                    allowfullscreen
                                    referrerpolicy="no-referrer-when-downgrade"
                                    src="https://maps.google.com/maps?q=@mapQuery&t=&z=15&ie=UTF8&iwloc=&output=embed"></iframe>
                        </div>
                    </div>
                </section>

                <section class="pd-card">
                    <div class="pd-card-body">
                        <div class="pd-section-title">
                            <i class="bi bi-chat-text"></i>
                            Bình luận & Hỏi đáp
                            <span class="badge bg-primary rounded-pill ms-1">@comments.Count()</span>
                        </div>

                        @if (isAuthenticated)
                        {
                            <div class="pd-comment-form">
                                <img src="@(User.FindFirst("Avatar")?.Value ?? "/images/avatars/default-user.png")"
                                     class="pd-avatar"
                                     alt="Avatar" />

                                <div class="flex-grow-1">
                                    <textarea id="commentContent"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Bạn có thắc mắc gì về bất động sản này? Hãy đặt câu hỏi..."></textarea>

                                    <div class="d-flex justify-content-between align-items-center mt-2 gap-2 flex-wrap">
                                        <small class="text-muted fw-semibold">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Bình luận sẽ hiển thị sau khi Admin duyệt.
                                        </small>

                                        <button id="btnComment" type="button" class="btn btn-primary rounded-pill px-4 fw-bold">
                                            <i class="bi bi-send-fill me-1"></i>
                                            Gửi câu hỏi
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pd-empty mb-3">
                                <i class="bi bi-lock"></i>
                                Vui lòng <a href="/Account/Login" class="fw-bold text-primary">đăng nhập</a> để tham gia bình luận.
                            </div>
                        }

                        @if (parentComments.Any())
                        {
                            foreach (var c in parentComments)
                            {
                                var replies = comments.Where(r => r.ParentID == c.CommentID)
                                .OrderBy(r => r.CreatedAt)
                                .ToList();

                                <div class="pd-comment-thread">
                                    <div class="pd-comment-item">
                                        <img src="@(c.User?.Avatar ?? "/images/avatars/default-user.png")"
                                             class="pd-avatar"
                                             alt="Avatar" />

                                        <div class="pd-comment-bubble">
                                            <div class="pd-comment-head">
                                                <span class="pd-comment-name">
                                                    @(c.User?.FullName ?? "Người dùng")
                                                    @if (c.UserID == Model.UserID)
                                                    {
                                                        <span class="pd-owner-badge">
                                                            <i class="bi bi-check-circle-fill"></i>
                                                            Người đăng
                                                        </span>
                                                    }
                                                </span>

                                                <span class="pd-comment-time">
                                                    <i class="bi bi-clock me-1"></i>
                                                    @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            </div>

                                            <p class="pd-comment-text">@c.Content</p>

                                            @if (isOwner || isAdminOrStaff)
                                            {
                                                <button type="button" class="pd-reply-toggle" onclick="toggleReplyForm(@c.CommentID)">
                                                    <i class="bi bi-reply-fill me-1"></i>
                                                    Trả lời câu hỏi này
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    @if (isOwner || isAdminOrStaff)
                                    {
                                        <div class="pd-reply-form" id="replyForm_@c.CommentID">
                                            <textarea id="replyContent_@c.CommentID"
                                          class="form-control mb-2"
                                          rows="2"
                                          placeholder="Nhập câu trả lời của bạn..."></textarea>

                                            <div class="text-end">
                                                <button type="button" class="btn btn-sm btn-light rounded-pill me-1 fw-bold" onclick="toggleReplyForm(@c.CommentID)">
                                                    Hủy
                                                </button>

                                                <button type="button" class="btn btn-sm btn-primary rounded-pill fw-bold px-3" onclick="submitReply(@c.CommentID)">
                                                    <i class="bi bi-send-fill me-1"></i>
                                                    Đăng trả lời
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    @if (replies.Any())
                                    {
                                        <div class="pd-replies">
                                            @foreach (var r in replies)
                                            {
                                                bool isReplyFromOwner = r.UserID == Model.UserID;

                                                <div class="pd-reply-item">
                                                    <img src="@(r.User?.Avatar ?? "/images/avatars/default-user.png")"
                                                         class="pd-reply-avatar"
                                                         alt="Avatar" />

                                                    <div class="pd-reply-bubble" style="@(!isReplyFromOwner ? "background:#f8fafc;border-color:#e2e8f0;" : "")">
                                                        <div class="pd-comment-head">
                                                            <span class="pd-comment-name">
                                                                @(r.User?.FullName ?? "Người dùng")
                                                                @if (isReplyFromOwner)
                                                                {
                                                                    <span class="pd-owner-badge">
                                                                        <i class="bi bi-check-circle-fill"></i>
                                                                        Người đăng
                                                                    </span>
                                                                }
                                                            </span>

                                                            <span class="pd-comment-time">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                                        </div>

                                                        <p class="pd-comment-text">@r.Content</p>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="pd-empty">
                                <i class="bi bi-chat-square-dots"></i>
                                Chưa có câu hỏi hay bình luận nào. Hãy là người đầu tiên!
                            </div>
                        }
                    </div>
                </section>
            </main>

            <aside>
                <div class="pd-contact-sticky">
                    <section class="pd-card pd-contact-card">
                        <div class="pd-contact-head">
                            <a href="/Nguoi-Dang-Tin/@Model.UserID" title="Xem hồ sơ người đăng">
                                <span class="pd-seller-avatar-wrap">
                                    <img src="@(Model.User?.Avatar ?? "/images/avatars/default-user.png")"
                                         class="pd-seller-avatar"
                                         alt="Avatar người đăng" />
                                    <span class="pd-online-dot"></span>
                                </span>
                            </a>

                            <a href="/Nguoi-Dang-Tin/@Model.UserID" class="pd-seller-name">
                                @(Model.User?.FullName ?? "Người dùng ẩn danh")
                            </a>

                            <span class="pd-seller-role">
                                <i class="bi bi-person-check-fill me-1"></i>
                                Người đăng tin
                            </span>
                        </div>

                        <div class="pd-contact-body">
                            @if (isLockedProperty)
                            {
                                <div class="pd-locked-small-box">
                                    <i class="bi @(isExpiredProperty ? "bi-clock-history" : "bi-lock-fill") me-1"></i>
                                    @if (isExpiredProperty)
                                    {
                                        <span>Tin đã hết hạn hiển thị. Hệ thống chỉ cho xem thông tin lưu trữ và khóa toàn bộ thao tác.</span>
                                    }
                                    else
                                    {
                                        <span>Tin đã hoàn tất giao dịch. Mọi chức năng liên hệ, chat, đặt lịch, lưu tin, báo cáo và bình luận đã bị khóa.</span>
                                    }
                                </div>
                            }

                            @if (isAuthenticated)
                            {
                                <div class="pd-phone-box" id="phoneBox">
                                    <button type="button" class="pd-phone-reveal @(isLockedProperty ? "pd-locked-disabled" : "")" id="btnReveal">
                                        <i class="bi bi-telephone-fill"></i>
                                        <span id="phoneText">
                                            @(!string.IsNullOrWhiteSpace(Model.User?.Phone)
                                                                                    ? Model.User.Phone.Substring(0, Math.Min(4, Model.User.Phone.Length)) + " *** *** – Bấm để hiện"
                                                                                    : "Chưa cập nhật SĐT")
                                    </span>
                                </button>

                                    <button type="button" class="pd-phone-copy" id="btnCopyPh" title="Sao chép">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>

                            @if (!string.IsNullOrWhiteSpace(zaloLink) || !string.IsNullOrWhiteSpace(fbLink))
                                {
                                    <div class="pd-social-row @((!string.IsNullOrWhiteSpace(zaloLink) && !string.IsNullOrWhiteSpace(fbLink)) ? "" : "one")">
                                        @if (!string.IsNullOrWhiteSpace(zaloLink))
                                        {
                                            <a href="@zaloLink" target="_blank" class="pd-social-btn pd-zalo @(isLockedProperty ? "pd-locked-disabled" : "")">
                                                <i class="bi bi-chat-dots-fill"></i>
                                                Zalo
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(fbLink))
                                        {
                                            <a href="@fbLink" target="_blank" class="pd-social-btn pd-facebook @(isLockedProperty ? "pd-locked-disabled" : "")">
                                                <i class="bi bi-facebook"></i>
                                                Facebook
                                            </a>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="pd-pending-box mb-3" style="background:#eff6ff;border-color:#bfdbfe;color:#1d4ed8;">
                                    <i class="bi bi-person-lock d-block fs-3 mb-2"></i>
                                    <div class="fw-bold mb-1">Khách vãng lai chỉ được xem thông tin bài đăng.</div>
                                    <div class="small mb-3">
                                        Đăng nhập tài khoản thành viên để liên hệ người đăng, gửi yêu cầu tư vấn, đặt lịch hẹn, lưu tin, báo cáo hoặc bình luận.
                                    </div>
                                    <a href="@loginUrl" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>
                                        Đăng nhập ngay
                                    </a>
                                </div>
                            }

                            <div class="pd-action-stack">
                                @if (!isAuthenticated)
                                {
                                    <div class="pd-pending-box" style="background:#eff6ff;border-color:#bfdbfe;color:#1d4ed8;">
                                        <i class="bi bi-lock-fill d-block fs-4 mb-1"></i>
                                        Khách vãng lai chưa đăng nhập chỉ được xem thông tin bài đăng.
                                    </div>
                                }
                                else if (Model.Status == "Pending")
                                {
                                    <div class="pd-pending-box">
                                        <i class="bi bi-lock-fill d-block fs-4 mb-1"></i>
                                        Tin đăng đang chờ duyệt. Các chức năng liên hệ tạm thời bị khóa.
                                    </div>
                                }
                                else if (isLockedProperty)
                                {
                                    <div class="pd-pending-box">
                                        <i class="bi bi-lock-fill d-block fs-4 mb-1"></i>
                                        @lockedMessage
                                    </div>
                                }
                                else if (isOwner)
                                {
                                    <div class="pd-pending-box" style="background:#f8fafc;border-color:#e2e8f0;color:#475569;">
                                        <i class="bi bi-person-check-fill d-block fs-4 mb-1"></i>
                                        Đây là tin đăng của bạn. Bạn không cần gửi tư vấn, đặt lịch hẹn hoặc chat với chính mình.
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="pd-main-action pd-action-consult"
                                            data-bs-toggle="modal"
                                            data-bs-target="#consultationModal">
                                        <i class="bi bi-headset fs-5"></i>
                                        Yêu cầu tư vấn miễn phí
                                    </button>

                                    <a href="/UserMessage/Index?receiverId=@Model.UserID&propertyId=@Model.PropertyID"
                                       class="pd-main-action pd-action-chat">
                                        <i class="bi bi-chat-dots-fill fs-5"></i>
                                        Chat trực tiếp ngay
                                    </a>

                                    <button type="button"
                                            class="pd-main-action pd-action-appt"
                                            data-bs-toggle="modal"
                                            data-bs-target="#appointmentModal">
                                        <i class="bi bi-calendar-check-fill fs-5"></i>
                                        Đặt lịch xem nhà
                                    </button>
                                }
                            </div>

                            <div class="pd-util-row">
                                @if (canBuyerInteract)
                                {
                                    <button type="button"
                                            class="pd-util-btn @(ViewBag.IsFavorited ? "saved" : "")"
                                            id="btnFav"
                                            data-id="@Model.PropertyID">
                                        <i class="bi @(ViewBag.IsFavorited ? "bi-heart-fill" : "bi-heart")"
                                           id="iconFav"
                                           style="color:@(ViewBag.IsFavorited ? "var(--pd-danger)" : "var(--pd-muted)")"></i>
                                        <span id="textFav">@(ViewBag.IsFavorited ? "Đã lưu" : "Lưu tin")</span>
                                    </button>
                                }
                                else if (!isAuthenticated)
                                {
                                    <button type="button" class="pd-util-btn" onclick="window.location.href='@loginUrl'">
                                        <i class="bi bi-lock"></i>
                                        <span>Đăng nhập</span>
                                    </button>
                                }

                                <button type="button" class="pd-util-btn" onclick="copyCurrentLink()">
                                    <i class="bi bi-share" style="color:var(--pd-primary);"></i>
                                    <span>Chia sẻ</span>
                                </button>

                                @if (canBuyerInteract)
                                {
                                    <button type="button" class="pd-util-btn" data-bs-toggle="modal" data-bs-target="#reportModal">
                                        <i class="bi bi-flag"></i>
                                        <span>Báo cáo</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </section>

                    @if (similarProps.Any())
                    {
                        <section class="pd-card">
                            <div class="pd-card-body">
                                <div class="pd-section-title" style="font-size:1rem;margin-bottom:14px;">
                                    <i class="bi bi-grid-3x3-gap"></i>
                                    Bất động sản tương tự
                                </div>

                                <div class="pd-mini-list">
                                    @foreach (var p in similarProps)
                                    {
                                        <a href="/Property/Details/@p.PropertyID" class="pd-mini-card">
                                            <img src="@GetSafeImage(p.MainImage)"
                                                 class="pd-mini-img"
                                                 alt="@p.Title"
                                                 loading="lazy"
                                                 decoding="async"
                                                 draggable="false"
                                                 onerror="this.onerror=null;this.src='/images/no-image.jpg'" />

                                            <div class="min-w-0">
                                                <div class="pd-mini-title">@p.Title</div>
                                                <div class="pd-mini-price">@FormatMiniPrice(p.Price)</div>
                                                <div class="pd-mini-meta">
                                                    <i class="bi bi-geo-alt me-1"></i>@p.Ward?.WardName
                                                    ·
                                                    <i class="bi bi-calendar3 me-1"></i>@p.CreatedAt.ToString("dd/MM/yy")
                                                </div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            </div>
                        </section>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>

@if (canBuyerInteract)
{
    <div class="pd-mobile-contact-bar">
        <button type="button" class="pd-main-action pd-action-consult @(isLockedProperty ? "pd-locked-disabled" : "")" data-bs-toggle="modal" data-bs-target="#consultationModal">
            <i class="bi bi-headset"></i>
            Tư vấn
        </button>

        <button type="button" class="pd-main-action pd-action-appt @(isLockedProperty ? "pd-locked-disabled" : "")" data-bs-toggle="modal" data-bs-target="#appointmentModal">
            <i class="bi bi-calendar-check-fill"></i>
            Xem nhà
        </button>
    </div>
}

<div class="modal fade" id="galleryModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark">
            <div class="modal-header bg-dark py-2 px-3">
                <span class="text-white fw-bold small text-truncate">@Model.Title</span>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center p-2" style="background:#020617;">
                <img id="galleryDisplayImg"
                     src="@GetSafeImage(mainImage)"
                     data-full="@GetSafeImage(mainImage)"
                     style="width:100%;max-width:100%;height:auto;max-height:85vh;object-fit:contain;border-radius:10px;background:#020617;display:block;margin:0 auto;"
                     loading="eager"
                     decoding="async"
                     draggable="false"
                     onerror="this.onerror=null;this.src='/images/no-image.jpg';this.dataset.full='/images/no-image.jpg';"
                     alt="@Model.Title" />

                @if (galleryImages.Count > 1)
                {
                    <div class="d-flex gap-2 overflow-auto justify-content-center flex-wrap mt-3 pb-1">
                        @for (int i = 0; i < galleryImages.Count; i++)
                        {
                            var gi = GetSafeImage(galleryImages[i]);

                            <img src="@gi"
                                 data-full="@gi"
                                 style="height:62px;width:82px;object-fit:cover;object-position:center;border-radius:9px;cursor:pointer;opacity:.78;border:2px solid transparent;background:#020617;"
                                 onclick="switchGallery(this)"
                                 loading="lazy"
                                 decoding="async"
                                 draggable="false"
                                 onerror="this.onerror=null;this.src='/images/no-image.jpg';this.dataset.full='/images/no-image.jpg';"
                                 alt="Ảnh chi tiết @(i + 1)" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@if (canBuyerInteract)
{
    <div class="modal fade" id="reportModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background:#fef2f2;">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="bi bi-flag-fill me-2"></i>
                        Báo cáo vi phạm
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-4">
                    <p class="text-muted small mb-4">Chọn lý do báo cáo. Chúng tôi sẽ xem xét và xử lý trong vòng 24 giờ.</p>

                    <div class="mb-3">
                        <label class="form-label">Lý do vi phạm <span class="text-danger">*</span></label>

                        @foreach (var reason in new[] { "Tin giả, lừa đảo tiền cọc", "Đã bán/cho thuê rồi", "Giá hoặc diện tích sai thực tế", "Hình ảnh giả / không đúng bất động sản", "Lý do khác" })
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="radio"
                                       name="repReason"
                                       value="@reason"
                                       id="rep_@reason.GetHashCode()"
                                       @(reason == "Tin giả, lừa đảo tiền cọc" ? "checked" : "") />
                                <label class="form-check-label fw-semibold" for="rep_@reason.GetHashCode()">@reason</label>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mô tả thêm</label>
                        <textarea class="form-control" id="repDesc" rows="3" placeholder="Mô tả chi tiết hơn về vấn đề..."></textarea>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" id="btnReport" class="btn btn-danger rounded-pill fw-bold px-4">
                        <i class="bi bi-send-fill me-1"></i>
                        Gửi báo cáo
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="appointmentModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header text-white" style="background:linear-gradient(135deg,#16a34a,#15803d);">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-calendar-check-fill me-2"></i>
                        Đặt lịch xem nhà
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-4">
                    <p class="text-muted small mb-4">Gửi yêu cầu hẹn gặp trực tiếp để tham quan bất động sản này.</p>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Họ và tên người đi xem <span class="text-danger">*</span></label>
                            <input type="text" id="apptName" class="form-control" placeholder="Nhập họ tên..." value="@autoName" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                            <input type="tel"
                                   id="apptPhone"
                                   class="form-control"
                                   placeholder="Ví dụ: 0987654321"
                                   value="@autoPhone"
                                   maxlength="10"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);"
                                   required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Địa điểm hẹn <span class="text-danger">*</span></label>
                            <input type="text" id="apptLocation" class="form-control" placeholder="Ví dụ: Tại BĐS hoặc quán cafe..." required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Thời gian hẹn <span class="text-danger">*</span></label>
                            <input type="datetime-local" id="apptDate" class="form-control" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Ghi chú thêm</label>
                            <textarea class="form-control"
                                  id="apptNote"
                                  rows="3"
                                  placeholder="Ví dụ: Tôi rảnh chiều các ngày trong tuần, gọi trước 30 phút..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" id="btnAppt" class="btn rounded-pill fw-bold px-4 text-white" style="background:var(--pd-success);">
                        <i class="bi bi-send-check me-1"></i>
                        Xác nhận đặt lịch
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="consultationModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header text-white" style="background:linear-gradient(135deg,#0ea5e9,#0284c7);">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-headset me-2"></i>
                        Yêu cầu tư vấn miễn phí
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body pt-4">
                    <p class="text-muted small mb-4">Để lại thông tin, chuyên viên sẽ gọi lại tư vấn trong thời gian sớm nhất.</p>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" id="csName" class="form-control" placeholder="Nhập họ tên của bạn" value="@autoName" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel"
                                   id="csPhone"
                                   class="form-control"
                                   placeholder="Ví dụ: 0987654321"
                                   value="@autoPhone"
                                   maxlength="10"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 10);"
                                   required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Email</label>
                            <input type="email" id="csEmail" class="form-control" placeholder="email@example.com" value="@autoEmail" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Lời nhắn</label>
                            <textarea id="csNote"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Ví dụ: Tôi muốn hỏi về giá chốt, pháp lý và tiến độ..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light rounded-pill fw-bold px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" id="btnConsult" class="btn rounded-pill fw-bold px-4 text-white" style="background:#0ea5e9;">
                        <i class="bi bi-send-fill me-1"></i>
                        Gửi yêu cầu
                    </button>
                </div>
            </div>
        </div>
    </div>

}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        const isLockedProperty = @Json.Serialize(isLockedProperty);
        const isAuthenticated = @Json.Serialize(isAuthenticated);
        const loginUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(loginUrl));

        function guardAuthAction() {
            if (isAuthenticated) return false;

            Swal.fire({
                icon: 'warning',
                title: 'Yêu cầu đăng nhập',
                text: 'Khách vãng lai chỉ được xem thông tin bài đăng. Vui lòng đăng nhập để sử dụng chức năng này.',
                confirmButtonText: 'Đăng nhập ngay',
                showCancelButton: true,
                cancelButtonText: 'Để sau',
                confirmButtonColor: 'var(--pd-primary)'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = loginUrl;
                }
            });

            return true;
        }

        function guardLockedAction() {
            if (!isLockedProperty) return false;
            Swal.fire({
                icon: 'warning',
                title: '@lockedTitle',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lockedMessage)),
                confirmButtonColor: 'var(--pd-danger)'
            });
            return true;
        }
        function showToast(msg, icon = 'success') {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon,
                title: msg,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        }

        function copyCurrentLink() {
            navigator.clipboard.writeText(window.location.href)
                .then(() => showToast('Đã copy link!', 'success'))
                .catch(() => showToast('Không thể copy link. Vui lòng thử lại.', 'error'));
        }

        function toggleReplyForm(commentId) {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;
            const formBox = document.getElementById('replyForm_' + commentId);
            if (!formBox) return;

            if (formBox.classList.contains('active')) {
                formBox.classList.remove('active');
            } else {
                document.querySelectorAll('.pd-reply-form').forEach(box => box.classList.remove('active'));
                formBox.classList.add('active');
                document.getElementById('replyContent_' + commentId)?.focus();
            }
        }

          async function submitReply(parentId) {
        if (guardAuthAction()) return;
            if (guardLockedAction()) return;

        const input = document.getElementById('replyContent_' + parentId);
            const content = input?.value.trim();

            if (!content) {
                Swal.fire('Lỗi', 'Vui lòng nhập nội dung trả lời!', 'warning');
                return;
            }

            const fd = new FormData();
            fd.append('propertyId', '@Model.PropertyID');
            fd.append('parentId', parentId);
            fd.append('content', content);

            try {
                const res = await fetch('/Property/SubmitReply', {
                    method: 'POST',
                    body: fd
                });

                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Đã trả lời!',
                        text: data.message,
                        timer: 1500,
                        showConfirmButton: false
                    });

                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    Swal.fire('Thông báo', data.message, 'info');
                }
            } catch (e) {
                Swal.fire('Lỗi mạng', 'Không thể gửi trả lời. Vui lòng thử lại.', 'error');
            }
        }

        (function initDescription() {
            const body = document.getElementById('descBody');
            const btn = document.getElementById('readMoreBtn');

            if (body && btn && body.scrollHeight > 240) {
                btn.style.display = 'inline-flex';
            }
        })();

        function expandDesc() {
            const body = document.getElementById('descBody');
            const btn = document.getElementById('readMoreBtn');

            body?.classList.remove('pd-desc-collapsed');
            if (btn) btn.style.display = 'none';
        }
        function getFullImageUrl(el) {
            if (!el) return '/images/no-image.jpg';
            return el.dataset.full || el.getAttribute('src') || '/images/no-image.jpg';
        }

        function setMainImage(url) {
            const hero = document.getElementById('heroImg');
            const modalImg = document.getElementById('galleryDisplayImg');

            if (!url || url.trim() === '') {
                url = '/images/no-image.jpg';
            }

            if (hero) {
                hero.src = url;
                hero.dataset.full = url;
            }

            if (modalImg) {
                modalImg.src = url;
                modalImg.dataset.full = url;
            }
        }

        function switchImg(el) {
            const fullUrl = getFullImageUrl(el);

            setMainImage(fullUrl);

            document.querySelectorAll('.pd-thumb').forEach(t => t.classList.remove('active'));
            if (el) el.classList.add('active');
        }

        function switchGallery(el) {
            const fullUrl = getFullImageUrl(el);

            setMainImage(fullUrl);

            document.querySelectorAll('.pd-thumb').forEach(t => {
                const thumbUrl = getFullImageUrl(t);
                t.classList.toggle('active', thumbUrl === fullUrl);
            });
        }

        const btnReveal = document.getElementById('btnReveal');
        const btnCopyPh = document.getElementById('btnCopyPh');
        const fullPhone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.User?.Phone ?? ""));

           if (btnReveal) {
        btnReveal.addEventListener('click', function () {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;

            if (!fullPhone) {
                    showToast('Người dùng chưa cập nhật số điện thoại', 'info');
                    return;
                }

                document.getElementById('phoneText').innerText = fullPhone;

                if (btnCopyPh) {
                    btnCopyPh.style.display = 'block';
                }

                this.style.cursor = 'default';
            });
        }

        if (btnCopyPh) {
         btnCopyPh.addEventListener('click', function () {
             if (guardAuthAction()) return;
            if (guardLockedAction()) return;
             if (!fullPhone) return;

                navigator.clipboard.writeText(fullPhone).then(() => {
                    this.innerHTML = '<i class="bi bi-check2-all"></i>';
                    setTimeout(() => {
                        this.innerHTML = '<i class="bi bi-copy"></i>';
                    }, 1800);
                });
            });
        }

        async function ajaxPost(url, fd, btn, loadingLabel, originalHtml, modalId) {
            if (!btn) return false;

            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span>${loadingLabel}`;
            btn.disabled = true;

            try {
                const res = await fetch(url, {
                    method: 'POST',
                    body: fd
                });

                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message,
                        confirmButtonColor: 'var(--pd-primary)'
                    });

                    if (modalId) {
                        bootstrap.Modal.getInstance(document.getElementById(modalId))?.hide();
                    }

                    return true;
                }

                if (data.message?.includes('đăng nhập')) {
                    if (modalId) {
                        bootstrap.Modal.getInstance(document.getElementById(modalId))?.hide();
                    }

                    Swal.fire({
                        icon: 'warning',
                        title: 'Yêu cầu đăng nhập',
                        text: data.message,
                        confirmButtonColor: 'var(--pd-primary)'
                    }).then(() => window.location.href = '/Account/Login');

                    return false;
                }

                Swal.fire({
                    icon: 'info',
                    title: 'Thông báo',
                    text: data.message,
                    confirmButtonColor: 'var(--pd-primary)'
                });

                return false;
            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi mạng',
                    text: 'Mất kết nối tới máy chủ. Vui lòng thử lại.',
                    confirmButtonColor: 'var(--pd-primary)'
                });

                return false;
            } finally {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
            }
        }

        document.getElementById('btnFav')?.addEventListener('click', async function () {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;
            try {
                const token = document.querySelector('#favoriteAntiForgeryForm input[name="__RequestVerificationToken"]')?.value;

                const res = await fetch('/Favorite/ToggleFavorite', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ propertyId: @Model.PropertyID })
                });

                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }

                const data = await res.json();

                if (data.success) {
                    const icon = document.getElementById('iconFav');
                    const text = document.getElementById('textFav');

                    showToast(data.message);

                    if (data.isSaved) {
                        this.classList.add('saved');
                        icon.className = 'bi bi-heart-fill';
                        icon.style.color = 'var(--pd-danger)';
                        text.innerText = 'Đã lưu';
                    } else {
                        this.classList.remove('saved');
                        icon.className = 'bi bi-heart';
                        icon.style.color = 'var(--pd-muted)';
                        text.innerText = 'Lưu tin';
                    }
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Yêu cầu đăng nhập',
                        text: data.message,
                        confirmButtonColor: 'var(--pd-primary)'
                    }).then(() => window.location.href = '/Account/Login');
                }
            } catch (e) {
                Swal.fire('Lỗi', 'Không thể cập nhật lưu tin. Vui lòng thử lại.', 'error');
            }
        });

        document.getElementById('btnReport')?.addEventListener('click', async function () {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;
            const fd = new FormData();

            fd.append('propertyId', '@Model.PropertyID');
            fd.append('reason', document.querySelector('input[name="repReason"]:checked')?.value ?? '');
            fd.append('description', document.getElementById('repDesc').value);

            if (await ajaxPost('/Property/SubmitReport', fd, this, 'Đang gửi...', '<i class="bi bi-send-fill me-1"></i>Gửi báo cáo', 'reportModal')) {
                document.getElementById('repDesc').value = '';
            }
        });

        document.getElementById('btnAppt')?.addEventListener('click', async function () {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;
            const name = document.getElementById('apptName').value.trim();
            const phone = document.getElementById('apptPhone').value.trim();
            const loc = document.getElementById('apptLocation').value.trim();
            const date = document.getElementById('apptDate').value;

            if (!name || !phone || !loc) {
                Swal.fire('Lỗi', 'Vui lòng nhập đầy đủ họ tên, số điện thoại và địa điểm hẹn!', 'warning');
                return;
            }

            const phoneRegex = /^[0-9]{10}$/;
            if (!phoneRegex.test(phone)) {
                Swal.fire('Lỗi', 'Số điện thoại không hợp lệ. Vui lòng nhập đủ 10 chữ số!', 'warning');
                return;
            }

            if (!date) {
                Swal.fire('Lỗi', 'Vui lòng chọn ngày và giờ hẹn!', 'warning');
                return;
            }

            const fd = new FormData();
            fd.append('propertyId', '@Model.PropertyID');
            fd.append('customerName', name);
            fd.append('customerPhone', phone);
            fd.append('meetingLocation', loc);
            fd.append('appointmentDate', date);
            fd.append('note', document.getElementById('apptNote').value);

            if (await ajaxPost('/Property/BookAppointment', fd, this, 'Đang đặt lịch...', '<i class="bi bi-send-check me-1"></i>Xác nhận đặt lịch', 'appointmentModal')) {
                document.getElementById('apptLocation').value = '';
                document.getElementById('apptDate').value = '';
                document.getElementById('apptNote').value = '';
            }
        });

        document.getElementById('btnConsult')?.addEventListener('click', async function () {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;
            const name = document.getElementById('csName').value.trim();
            const phone = document.getElementById('csPhone').value.trim();

            if (!name || !phone) {
                Swal.fire('Thiếu thông tin', 'Họ tên và số điện thoại là bắt buộc!', 'warning');
                return;
            }

            const phoneRegex = /^[0-9]{10}$/;
            if (!phoneRegex.test(phone)) {
                Swal.fire('Lỗi', 'Số điện thoại không hợp lệ. Vui lòng nhập đủ 10 chữ số!', 'warning');
                return;
            }

            const fd = new FormData();
            fd.append('propertyId', '@Model.PropertyID');
            fd.append('fullName', name);
            fd.append('phone', phone);
            fd.append('email', document.getElementById('csEmail').value);
            fd.append('note', document.getElementById('csNote').value);

            if (await ajaxPost('/Property/SubmitConsultation', fd, this, 'Đang gửi...', '<i class="bi bi-send-fill me-1"></i>Gửi yêu cầu', 'consultationModal')) {
                document.getElementById('csNote').value = '';
            }
        });

        document.getElementById('btnComment')?.addEventListener('click', async function () {
            if (guardAuthAction()) return;
            if (guardLockedAction()) return;
            const content = document.getElementById('commentContent').value.trim();

            if (!content) {
                Swal.fire('Lỗi', 'Vui lòng nhập nội dung bình luận!', 'warning');
                return;
            }

            const fd = new FormData();
            fd.append('propertyId', '@Model.PropertyID');
            fd.append('content', content);

            if (await ajaxPost('/Property/SubmitComment', fd, this, 'Đang đăng...', '<i class="bi bi-send-fill me-1"></i>Gửi câu hỏi', null)) {
                document.getElementById('commentContent').value = '';
                showToast('Bình luận đã gửi, chờ Admin duyệt!');
            }
        });
    </script>
}