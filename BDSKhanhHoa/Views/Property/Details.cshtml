        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 50%;
        border: 2px solid var(--pd-border);
        flex-shrink: 0;
    }

    .pd-comment-thread {
        padding-bottom: 16px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--pd-border);
    }

        .pd-comment-thread:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .pd-comment-item,
    .pd-reply-item {
        display: flex;
        gap: 12px;
