        font-weight: 850;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5px;
        transition: var(--pd-transition);
    }

        .pd-util-btn i {
            font-size: 1.1rem;
        }

        .pd-util-btn:hover {
            background: var(--pd-soft);
            border-color: #bfdbfe;
            color: var(--pd-primary);
        }

        .pd-util-btn.saved {
            background: #fff1f2;
            border-color: #fda4af;
            color: var(--pd-danger);
        }

    .pd-login-lock {
        position: relative;
        border-radius: var(--pd-radius);
        overflow: hidden;
        margin-bottom: 12px;
    }

    .pd-login-blur {
        filter: blur(6px);
        opacity: .45;
        pointer-events: none;
        user-select: none;
    }

    .pd-login-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, .72);
        backdrop-filter: blur(2px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-align: center;
        padding: 12px;
        font-weight: 850;
    }

    .pd-mini-list {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .pd-mini-card {
        display: flex;
        gap: 11px;
        padding: 10px;
