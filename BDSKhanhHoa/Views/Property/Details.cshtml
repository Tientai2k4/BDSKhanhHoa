    .pd-comment-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 7px;
    }

    .pd-comment-name {
        color: var(--pd-text);
        font-weight: 900;
        font-size: .9rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
    }

