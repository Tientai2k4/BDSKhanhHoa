        --pd-primary: #1a56db;
        --pd-primary-dark: #123f9f;
        --pd-primary-soft: #eaf2ff;
        --pd-danger: #e11d48;
        --pd-success: #16a34a;
        --pd-warning: #f59e0b;
        --pd-info: #0284c7;
        --pd-bg: #f3f6fb;
        --pd-card: #ffffff;
        --pd-border: #e2e8f0;
        --pd-text: #0f172a;
