@model BDSKhanhHoa.Models.Property
@using System.Security.Claims
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string FormatPrice(decimal? price)
    {
        if (!price.HasValue || price.Value <= 0) return "Thỏa thuận";

        var value = price.Value;

        if (value >= 1_000_000_000M)
            return (value / 1_000_000_000M).ToString("0.##", Vi) + " tỷ";

        if (value >= 1_000_000M)
            return (value / 1_000_000M).ToString("0.##", Vi) + " triệu";

        return value.ToString("N0", Vi) + " đ";
    }

    private string FormatArea(decimal? area)
    {
        if (!area.HasValue || area.Value <= 0) return "Đang cập nhật";
        return area.Value.ToString("0.##", Vi) + " m²";
    }

    private string FormatShortDate(DateTime? date)
    {
        if (!date.HasValue) return "Đang cập nhật";
        return date.Value.ToString("dd/MM/yyyy", Vi);
    }

    private string FormatDateTime(DateTime? date)
    {
        if (!date.HasValue) return "Đang cập nhật";
        return date.Value.ToString("dd/MM/yyyy HH:mm", Vi);
    }

    private string GetSafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/no-image.jpg";
        }

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
        {
            return image;
        }

        return "/" + image.TrimStart('/');
    }



    private string CleanPublicDescription(string? description)
    {
        if (string.IsNullOrWhiteSpace(description))
        {
            return string.Empty;
        }

        var text = description.Replace("\r\n", "\n").Replace("\r", "\n").Trim();

        // Ẩn ghi chú nội bộ của hệ thống như: [HẠ VIP - ...] Tin dùng gói ... đã hết hạn...
        // Chỉ làm sạch phần hiển thị ở view, không sửa dữ liệu trong SQL.
        text = Regex.Replace(
            text,
            @"(?is)\[(?:HẠ|HA|HẾT|HET|GIA HẠN|GIA HAN|VIP|SYSTEM|HỆ THỐNG|HE THONG)[^\]]*\]\s*Tin\s+dùng\s+gói.*?đến\s+\d{1,2}/\d{1,2}/\d{4}\s+\d{1,2}:\d{2}\s*\.",
            "").Trim();

        text = Regex.Replace(
            text,
            @"(?is)\[(?:HẠ|HA|HẾT|HET|GIA HẠN|GIA HAN|VIP|SYSTEM|HỆ THỐNG|HE THONG)[^\]]*\]",
            "").Trim();

        text = Regex.Replace(
            text,
            @"(?im)^\s*\[(?:HẠ|HA|HẾT|HET|GIA HẠN|GIA HAN|VIP|SYSTEM|HỆ THỐNG|HE THONG)[^\]]*\]\s*$",
            "").Trim();

        text = Regex.Replace(
            text,
            @"(?im)^\s*Tin\s+dùng\s+gói\s+['""].*?(?:đã\s+hết\s+hạn|hết\s+hạn|hạ\s+vip|chuyển\s+về\s+Tin\s+Thường).*?$",
            "").Trim();

        text = Regex.Replace(
            text,
            @"(?im)^\s*Hệ\s+thống\s+tự\s+chuyển.*?$",
            "").Trim();

        text = Regex.Replace(text, @"\n{3,}", "\n\n").Trim();
        return text;
    }

    private string FormatMiniPrice(decimal? price)
    {
        if (!price.HasValue || price.Value <= 0) return "Thỏa thuận";

        var value = price.Value;

        if (value >= 1_000_000_000M)
            return (value / 1_000_000_000M).ToString("0.##", Vi) + " tỷ";

        if (value >= 1_000_000M)
            return (value / 1_000_000M).ToString("0.##", Vi) + " tr";

        return value.ToString("N0", Vi) + " đ";
    }
}

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var similarProps = ViewBag.SimilarProperties as IEnumerable<BDSKhanhHoa.Models.Property> ?? new List<BDSKhanhHoa.Models.Property>();
    var userProps = ViewBag.UserProperties as IEnumerable<BDSKhanhHoa.Models.Property> ?? new List<BDSKhanhHoa.Models.Property>();
    var comments = ViewBag.Comments as IEnumerable<BDSKhanhHoa.Models.Comment> ?? new List<BDSKhanhHoa.Models.Comment>();
    var features = ViewBag.Features as List<BDSKhanhHoa.Models.PropertyFeature> ?? new List<BDSKhanhHoa.Models.PropertyFeature>();
    var propertyImages = ViewBag.PropertyImages as IEnumerable<BDSKhanhHoa.Models.PropertyImage> ?? new List<BDSKhanhHoa.Models.PropertyImage>();

    var bed = features.FirstOrDefault(f => f.FeatureName == "Phòng ngủ")?.FeatureValue;
    var bath = features.FirstOrDefault(f => f.FeatureName == "Phòng vệ sinh")?.FeatureValue;
    var direction = features.FirstOrDefault(f => f.FeatureName == "Hướng nhà")?.FeatureValue;
    var legal = features.FirstOrDefault(f => f.FeatureName == "Pháp lý")?.FeatureValue;
    var amenities = features.FirstOrDefault(f => f.FeatureName == "Tiện ích")?.FeatureValue;

    var isRent = Model.PropertyType?.ParentID == 2 || Model.TypeID == 2;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int currentUserId);
    bool isOwner = currentUserId > 0 && currentUserId == Model.UserID;
    bool isAdminOrStaff = User.IsInRole("Admin") || User.IsInRole("Staff");

    var currentUserInfo = ViewBag.CurrentUserInfo as BDSKhanhHoa.Models.User;
    string autoName = currentUserInfo?.FullName ?? (isAuthenticated ? (User.Identity?.Name ?? "") : "");
    string autoPhone = currentUserInfo?.Phone ?? "";
    string autoEmail = currentUserInfo?.Email ?? "";


    string zaloLink = !string.IsNullOrWhiteSpace(Model.User?.Zalo)
        ? (Model.User.Zalo.StartsWith("0") || Model.User.Zalo.StartsWith("+84") ? "https://zalo.me/" + Model.User.Zalo : Model.User.Zalo)
        : "";

    string fbLink = !string.IsNullOrWhiteSpace(Model.User?.Facebook)
        ? (Model.User.Facebook.StartsWith("http") ? Model.User.Facebook : "https://facebook.com/" + Model.User.Facebook)
        : "";

    string fullAddress = $"{(!string.IsNullOrWhiteSpace(Model.AddressDetail) ? Model.AddressDetail + ", " : "")}{Model.Ward?.WardName}, {Model.Ward?.Area?.AreaName}, Khánh Hòa";
    string mapQuery = Uri.EscapeDataString(fullAddress ?? "");

    string priceDisplay = FormatPrice(Model.Price);
    string areaDisplay = FormatArea(Model.AreaSize);

    string pricePerM2 = Model.Price.HasValue && Model.AreaSize.HasValue && Model.AreaSize.Value > 0
        ? ((Model.Price.Value / (decimal)Model.AreaSize.Value / 1_000_000M).ToString("0.##", Vi) + " tr/m²")
        : "";

    var parentComments = comments.Where(c => c.ParentID == null || c.ParentID == 0)
                                 .OrderByDescending(c => c.CreatedAt)
                                 .ToList();

    var galleryImages = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.MainImage))
    {
        galleryImages.Add(GetSafeImage(Model.MainImage));
    }

    galleryImages.AddRange(
        propertyImages
            .Select(x => GetSafeImage(x.ImageURL))
            .Where(x => !string.IsNullOrWhiteSpace(x))
    );

    galleryImages = galleryImages
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    if (!galleryImages.Any())
    {
        galleryImages.Add("/images/no-image.jpg");
    }

    string mainImage = galleryImages.FirstOrDefault() ?? "/images/no-image.jpg";
    var totalImages = galleryImages.Count;

    bool isExpiredProperty = Model.Status == "Expired";
    bool isLockedProperty = Model.Status == "Sold" || Model.Status == "Rented" || Model.Status == "Expired";
    bool isApprovedProperty = Model.Status == "Approved";
    bool canInteract = isAuthenticated && isApprovedProperty && !isLockedProperty;
    bool canBuyerInteract = canInteract && !isOwner;
    string returnUrl = Context.Request.Path.ToString() + Context.Request.QueryString.ToString();
    string loginUrl = Url.Action("Login", "Account", new { returnUrl = returnUrl }) ?? "/Account/Login";

    string lockedTitle = Model.Status switch
    {
        "Sold" => "TIN ĐÃ BÁN",
        "Rented" => "TIN ĐÃ CHO THUÊ",
        "Expired" => "TIN ĐÃ HẾT HẠN",
        _ => "TIN ĐANG BỊ KHÓA"
    };

    string lockedMessage = Model.Status switch
    {
        "Sold" => "Bất động sản này đã bán thành công. Hệ thống đã khóa toàn bộ thao tác liên hệ, chat, đặt lịch, lưu tin, báo cáo, bình luận và chỉnh sửa.",
        "Rented" => "Bất động sản này đã cho thuê thành công. Hệ thống đã khóa toàn bộ thao tác liên hệ, chat, đặt lịch, lưu tin, báo cáo, bình luận và chỉnh sửa.",
        "Expired" => "Tin đăng này đã hết hạn hiển thị. Hệ thống chỉ cho xem thông tin lưu trữ và khóa toàn bộ thao tác liên hệ, chat, đặt lịch, lưu tin, báo cáo, bình luận và chỉnh sửa.",
        _ => "Tin đăng này đang bị khóa thao tác."
    };

    string publicDescription = CleanPublicDescription(Model.Description);
    if (string.IsNullOrWhiteSpace(publicDescription))
    {
        publicDescription = "Chủ tin chưa cập nhật mô tả chi tiết.";
    }
}



<meta name="chatbot-page-type" content="PropertyDetail" />
<meta name="chatbot-property-title" content="@Model.Title" />
<meta name="chatbot-property-price" content="@priceDisplay" />
<meta name="chatbot-property-area" content="@areaDisplay" />
<meta name="chatbot-property-location" content="@fullAddress" />
<meta name="chatbot-property-type" content="@(isRent ? "Cho thuê" : "Bán") - @(Model.PropertyType?.TypeName ?? "Đang cập nhật")" />
<meta name="chatbot-property-legal" content="@(legal ?? "Chưa cập nhật")" />
<meta name="chatbot-property-description" content="@System.Net.WebUtility.HtmlEncode(publicDescription)" />
<meta name="chatbot-context" content="
Người dùng đang xem TRANG CHI TIẾT MỘT TIN BẤT ĐỘNG SẢN.
Khi người dùng hỏi: tin này, căn này, nhà này, đất này, lô này, ở đây, chỗ này, giá này, pháp lý này, có nên mua không, có nên thuê không, có nên đặt cọc không, cần kiểm tra gì, hãy hiểu là đang hỏi về tin hiện tại.

Tiêu đề: @Model.Title.
Loại giao dịch: @(isRent ? "Cho thuê" : "Mua bán").
Loại bất động sản: @(Model.PropertyType?.TypeName ?? "Đang cập nhật").
Giá: @priceDisplay.
Diện tích: @areaDisplay.
Đơn giá: @(string.IsNullOrWhiteSpace(pricePerM2) ? "Chưa tính được" : pricePerM2).
Vị trí: @fullAddress.
Khu vực: @(Model.Ward?.Area?.AreaName ?? "Đang cập nhật").
Phường/Xã: @(Model.Ward?.WardName ?? "Đang cập nhật").
Dự án liên quan: @(Model.Project?.ProjectName ?? "Không có").
Phòng ngủ: @(bed ?? "Chưa cập nhật").
Phòng tắm: @(bath ?? "Chưa cập nhật").
Hướng nhà: @(direction ?? "Chưa cập nhật").
Pháp lý: @(legal ?? "Chưa cập nhật").
Tiện ích: @(amenities ?? "Chưa cập nhật").
Tình trạng tin: @Model.Status.
Ngày đăng: @Model.CreatedAt.ToString("dd/MM/yyyy").
Mô tả người đăng: @System.Net.WebUtility.HtmlEncode(publicDescription).

Quy tắc trả lời khi phân tích tin này:
1. Không khẳng định pháp lý chắc chắn nếu chỉ có dữ liệu người đăng cung cấp.
2. Phân tích theo giá, diện tích, vị trí, pháp lý, tiện ích, mục đích mua/thuê, rủi ro và bước tiếp theo.
3. Nếu người dùng hỏi có nên mua/thuê, hãy hỏi thêm mục đích nếu chưa rõ, nhưng vẫn đưa checklist kiểm tra trước.
4. Nếu tin đã bán/đã thuê/hết hạn/chờ duyệt, phải nói rõ không nên liên hệ/giao dịch trực tiếp qua tin này.
" />

