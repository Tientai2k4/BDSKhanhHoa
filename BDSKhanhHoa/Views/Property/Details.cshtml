        text-decoration: none;
        font-weight: 900;
        transition: var(--pd-transition);
    }

        .pd-social-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .pd-zalo {
        background: #0068ff;
    }

    .pd-facebook {
        background: #1877f2;
    }

    .pd-action-stack {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .pd-main-action {
        min-height: 46px;
        border: none;
        border-radius: 14px;
        color: #fff;
        font-weight: 950;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        transition: var(--pd-transition);
    }

        .pd-main-action:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .pd-action-consult {
        background: linear-gradient(135deg, #0ea5e9, #0284c7);
    }

    .pd-action-chat {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .pd-action-appt {
        background: linear-gradient(135deg, #16a34a, #15803d);
    }

    .pd-pending-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #92400e;
        border-radius: var(--pd-radius);
