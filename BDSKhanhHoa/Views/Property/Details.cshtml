        background: var(--pd-soft);
        padding: 10px 13px;
        font-size: .92rem;
        font-weight: 650;
        box-shadow: none;
    }

        .form-control:focus,
        .form-select:focus {
            background: #fff;
            border-color: var(--pd-primary);
            box-shadow: 0 0 0 .22rem rgba(26, 86, 219, .10);
        }

    .form-label {
        color: var(--pd-text);
        font-weight: 850;
        font-size: .86rem;
    }

    .pd-mobile-contact-bar {
        display: none;
    }

    @@media (max-width: 1199.98px) {
        .pd-layout {
            grid-template-columns: minmax(0, 1fr) 330px;
            gap: 18px;
        }
    }

    @@media (max-width: 991.98px) {
        .pd-layout {
            display: block;
        }

        .pd-contact-sticky {
            position: static;
        }
    }

    @@media (max-width: 767.98px) {
        .pd-breadcrumb {
            display: none;
        }

        .pd-page .container {
            padding-left: 10px;
            padding-right: 10px;
        }



        .pd-gallery,
        .pd-card,
        .pd-warning {
            border-radius: 16px;
        }

        .pd-card-body {
            padding: 16px;
        }

        .pd-title-row {
            display: block;
        }

        .pd-edit-btn {
            margin-top: 10px;
        }

        .pd-address {
            font-size: .86rem;
        }

        .pd-price-grid {
            grid-template-columns: 1fr 1fr;
        }

        .pd-price-cell:first-child {
            grid-column: 1 / -1;
        }

        .pd-price-cell {
            padding: 14px;
        }

        .pd-detail-grid {
            grid-template-columns: 1fr;
        }

        .pd-detail-item {
            border-right: none !important;
        }

        .pd-detail-val {
            max-width: 52%;
        }

        .pd-section-title {
            font-size: 1rem;
        }

        .pd-map iframe {
            height: 300px;
        }

        .pd-comment-form {
            gap: 9px;
        }

            .pd-comment-form .pd-avatar {
                display: none;
            }

        .pd-comment-head {
            display: block;
        }

        .pd-comment-time {
            display: block;
            margin-top: 3px;
        }

        .pd-replies,
        .pd-reply-form {
            margin-left: 20px;
        }

        .pd-warning {
            padding: 15px;
        }

            .pd-warning ul {
                padding-left: 16px;
            }

        .pd-mobile-contact-bar {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 1040;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding: 10px;
            background: rgba(255, 255, 255, .94);
            border-top: 1px solid var(--pd-border);
            backdrop-filter: blur(12px);
            box-shadow: 0 -10px 30px rgba(15, 23, 42, .12);
        }

            .pd-mobile-contact-bar .pd-main-action {
                min-height: 44px;
                border-radius: 14px;
                font-size: .86rem;
            }

        body {
            padding-bottom: 72px;
        }
    }

    @@media (max-width: 575.98px) {
        .pd-page .container {
            margin-top: 10px !important;
        }



        .pd-gallery-badges {
            left: 10px;
            top: 10px;
        }

        .pd-photo-count {
            right: 10px;
            bottom: 10px;
            min-height: 34px;
            font-size: .78rem;
        }

        .pd-thumb {
            width: 76px;
            height: 58px;
        }

        .pd-title {
            font-size: 1.22rem;
        }

        .pd-price-main {
            font-size: 1.55rem;
        }

        .pd-price-value {
            font-size: 1.05rem;
        }

        .pd-quick-list {
            gap: 7px;
        }

        .pd-pill,
        .pd-amenity {
            font-size: .78rem;
            padding: 7px 10px;
        }

        .pd-detail-item {
            padding: 12px;
        }

        .pd-detail-key,
        .pd-detail-val {
            font-size: .8rem;
        }

        .pd-contact-body {
            padding: 16px;
        }

        .pd-util-row {
            gap: 7px;
        }

        .pd-util-btn {
            min-height: 56px;
            font-size: .72rem;
        }

        .modal-dialog {
            margin: 10px;
        }
    }

    @@media (max-width: 1199.98px) {
        .pd-hero-img {
            height: min(64vh, 560px);
            min-height: 390px;
        }
    }

    @@media (max-width: 991.98px) {
