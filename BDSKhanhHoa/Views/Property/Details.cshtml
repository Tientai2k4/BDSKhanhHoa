        transition: var(--pd-transition);
    }

        .pd-mini-card:hover {
            border-color: #bfdbfe;
            box-shadow: var(--pd-shadow-soft);
            transform: translateY(-1px);
        }

    .pd-mini-img {
        width: 84px;
