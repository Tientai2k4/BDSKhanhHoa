        text-align: center;
        background: #fff;
        border-radius: 14px;
        border: 1px dashed #cbd5e1;
    }

    .myads-empty-icon {
        width: 66px;
        height: 66px;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: var(--myads-primary);
        font-size: 2rem;
        margin-bottom: 14px;
    }

    .myads-empty h5 {
        font-weight: 900;
        margin-bottom: 6px;
        color: var(--myads-text);
    }

    .myads-empty p {
        color: var(--myads-muted);
        margin-bottom: 16px;
        font-weight: 600;
    }

    .myads-empty .btn {
        border-radius: 999px;
        font-weight: 850;
        padding-left: 20px;
        padding-right: 20px;
    }

    @@media (max-width: 1199.98px) {
        .myads-filterbar {
            grid-template-columns: 1fr 1fr;
        }

        .myads-count-pill,
        .myads-reset-btn {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 991.98px) {
        .myads-table thead {
            display: none;
        }

        .myads-table,
        .myads-table tbody,
        .myads-table tr,
        .myads-table td {
            display: block;
            width: 100%;
        }

        .myads-table {
            border-spacing: 0;
        }

            .myads-table tbody tr {
                background: #fff;
                border: 1px solid var(--myads-border);
                border-radius: 16px;
                padding: 12px;
                margin-bottom: 12px;
                box-shadow: 0 6px 18px rgba(15, 23, 42, .06);
            }

                .myads-table tbody tr:hover {
                    transform: none;
                }

            .myads-table tbody td {
                border: 0 !important;
                padding: 10px 0;
                background: transparent;
                border-radius: 0 !important;
            }

                .myads-table tbody td:not(:last-child) {
                    border-bottom: 1px dashed #e2e8f0 !important;
                }

                .myads-table tbody td::before {
                    content: attr(data-label);
                    display: block;
                    margin-bottom: 7px;
                    color: #94a3b8;
                    font-size: .7rem;
                    font-weight: 900;
                    text-transform: uppercase;
                    letter-spacing: .05em;
                }

                .myads-table tbody td.myads-main-cell::before {
                    display: none;
                }

        .myads-status-wrap {
            align-items: flex-start;
        }

        .myads-status-note {
            text-align: left;
        }

        .myads-actions {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 575.98px) {
        .myads-topbar {
            padding: 13px;
            border-radius: 14px;
        }

        .myads-page-title {
            font-size: 1.08rem;
        }

        .myads-page-subtitle {
            font-size: .78rem;
        }

        .myads-create-btn {
            width: 100%;
            min-height: 38px;
        }

        .myads-filterbar {
            grid-template-columns: 1fr;
            padding: 10px;
            border-radius: 14px;
        }

        .myads-quick-stats {
            gap: 6px;
            overflow-x: auto;
            flex-wrap: nowrap;
            padding-bottom: 2px;
            scrollbar-width: none;
        }

            .myads-quick-stats::-webkit-scrollbar {
                display: none;
            }

        .quick-stat {
            flex: 0 0 auto;
            font-size: .72rem;
            padding: 6px 9px;
        }

        .myads-table-wrap {
            padding: 8px;
        }

        .myads-prop {
            gap: 10px;
        }

        .myads-thumb-wrap {
            width: 86px;
            height: 86px;
        }

        .myads-prop-title {
            font-size: .9rem;
            -webkit-line-clamp: 3;
        }

        .myads-meta {
            font-size: .7rem;
            gap: 6px;
        }

        .myads-code,
        .myads-auto-badge,
        .myads-duplicate-badge {
            font-size: .66rem;
            padding: 3px 7px;
        }

        .myads-package-box {
            gap: 6px;
        }

        .myads-action-btn {
            flex: 1 1 calc(50% - 6px);
            min-height: 36px;
            font-size: .76rem;
        }

        .myads-empty {
            padding: 34px 14px;
        }
    }


    /* =====================================================
                   KHÓA TIN ĐÃ BÁN / ĐÃ CHO THUÊ
                ===================================================== */
    .myads-locked-row {
        opacity: .86;
    }

        .myads-locked-row td {
            background: #f8fafc !important;
        }

    .myads-locked-ribbon {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
        padding: 7px 10px;
        border-radius: 999px;
        border: 1px solid #fecaca;
        background: linear-gradient(135deg, #fff1f2, #fef2f2);
        color: #991b1b;
        font-size: .75rem;
        font-weight: 900;
    }

    .myads-action-disabled {
        opacity: .42 !important;
        filter: grayscale(1);
        pointer-events: none !important;
        cursor: not-allowed !important;
    }

    .myads-locked-note {
        min-width: 180px;
        border: 1px solid #fecaca;
        background: #fff1f2;
        color: #991b1b;
        border-radius: 12px;
        padding: 9px 10px;
        font-size: .75rem;
        font-weight: 850;
        line-height: 1.45;
        text-align: left;
    }

</style>

<div class="myads-page">
    <div class="myads-topbar">
        <div class="myads-title-wrap">
        </div>

        <a href="/Property/Create" class="myads-create-btn">
            <i class="bi bi-plus-circle-fill"></i>
            Đăng tin mới
        </a>
    </div>

    <div class="myads-filterbar">
        <div class="myads-count-pill">
            <i class="bi bi-funnel-fill"></i>
            Hiển thị: <span id="visibleCount">@totalAds</span>/<span>@totalAds</span>
        </div>

        <div class="myads-search">
            <i class="bi bi-search"></i>
            <input id="myAdsSearch"
                   type="search"
                   class="form-control"
                   placeholder="Tìm mã tin, tiêu đề, loại BĐS, gói tin..."
                   autocomplete="off" />
        </div>

        <select id="statusFilter" class="form-select myads-select" aria-label="Lọc trạng thái">
            <option value="All">Tất cả trạng thái</option>
            <option value="Approved">Đang hiển thị</option>
            <option value="Pending">Chờ duyệt</option>
            <option value="Rejected">Bị từ chối</option>
            <option value="Sold">Đã bán</option>
            <option value="Rented">Đã cho thuê</option>
        </select>

        <button type="button" class="myads-reset-btn" id="btnResetFilters">
            <i class="bi bi-arrow-counterclockwise me-1"></i>
            Làm mới
        </button>
    </div>

    <div class="myads-quick-stats">
        <span class="quick-stat">
            <i class="bi bi-collection-fill"></i>
            Tổng: <strong>@totalAds</strong>
        </span>

        <span class="quick-stat success">
            <i class="bi bi-eye-fill"></i>
            Hiển thị: <strong>@approvedCount</strong>
        </span>

        <span class="quick-stat warning">
            <i class="bi bi-hourglass-split"></i>
            Chờ duyệt: <strong>@pendingCount</strong>
        </span>

        <span class="quick-stat danger">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Cần xử lý: <strong>@rejectedCount</strong>
        </span>

        <span class="quick-stat purple">
            <i class="bi bi-gem"></i>
            VIP còn hạn: <strong>@vipActiveCount</strong>
        </span>

        <span class="quick-stat">
            <i class="bi bi-check2-circle"></i>
            Đã giao dịch: <strong>@(soldCount + rentedCount)</strong>
        </span>
    </div>

    <div class="myads-table-card">
        @if (!ads.Any())
        {
            <div class="p-3 p-md-4">
                <div class="myads-empty">
                    <div class="myads-empty-icon">
                        <i class="bi bi-clipboard-x"></i>
                    </div>
                    <h5>Bạn chưa có tin đăng nào</h5>
                    <p>Hãy tạo tin đầu tiên để bắt đầu tiếp cận khách hàng đang quan tâm bất động sản tại Khánh Hòa.</p>
                    <a href="/Property/Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Đăng tin ngay
                    </a>
                </div>
            </div>
        }
        else
        {
            <div id="adsTableWrap" class="myads-table-wrap">
                <table class="myads-table">
                    <thead>
                        <tr>
                            <th style="width: 42%;">Thông tin bất động sản</th>
                            <th style="width: 22%;">Gói tin & giá</th>
                            <th class="text-center" style="width: 14%;">Trạng thái</th>
                            <th class="text-center" style="width: 22%;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody id="myAdsBody">
                        @foreach (var item in ads)
                        {
                            var status = item.Status ?? "Unknown";
                            var packageName = item.PostServicePackage?.PackageName ?? "Tin thường";
                            var packageType = item.PostServicePackage?.PackageType ?? "";
                            var typeName = item.PropertyType?.TypeName ?? "Chưa phân loại";
                            var isSale = IsSaleProperty(item);
                            var isRent = IsRentProperty(item);
                            var isTransacted = IsLockedStatus(item.Status);

                            var searchText = $"{item.PropertyID} {item.Title} {status} {GetStatusText(status)} {packageName} {packageType} {typeName} {FormatPrice(item.Price)}".ToLowerInvariant();

                            int? vipDaysLeft = null;
                            if (item.VipExpiryDate.HasValue)
                            {
                                vipDaysLeft = (item.VipExpiryDate.Value.Date - DateTime.Now.Date).Days;
                            }

                            <tr class="@(isTransacted ? "myads-locked-row" : "")"
                                data-row="property"
                                data-status="@status"
                                data-search="@searchText">
                                <td class="myads-main-cell" data-label="Tin đăng">
                                    <div class="myads-prop">
                                        <a href="/Property/Details/@item.PropertyID"
                                           target="_blank"
                                           class="myads-thumb-wrap"
                                           title="Xem tin đăng">
                                            <img src="@(string.IsNullOrWhiteSpace(item.MainImage) ? "/images/no-image.jpg" : item.MainImage)"
                                                 class="myads-thumb"
                                                 alt="@item.Title"
                                                 loading="lazy"
                                                 onerror="this.src='/images/no-image.jpg'" />

                                            <span class="myads-deal-badge @GetTransactionTypeClass(item)">
                                                @GetTransactionTypeLabel(item)
                                            </span>
                                        </a>

                                        <div class="myads-prop-info">
                                            <div class="myads-code-row">
                                                <span class="myads-code">
                                                    <i class="bi bi-hash"></i>
                                                    @item.PropertyID
                                                </span>

                                                @if (item.IsAutoApproved)
                                                {
                                                    <span class="myads-auto-badge">
                                                        <i class="bi bi-lightning-charge-fill"></i>
                                                        Tự duyệt
                                                    </span>
                                                }

                                                @if (item.IsDuplicate)
                                                {
                                                    <span class="myads-duplicate-badge">
                                                        <i class="bi bi-intersect"></i>
                                                        Nghi trùng
                                                    </span>
                                                }
                                            </div>

                                            <a href="/Property/Details/@item.PropertyID"
                                               target="_blank"
                                               class="myads-prop-title"
                                               title="@item.Title">
                                                @item.Title
                                            </a>

                                            <div class="myads-meta">
                                                <span>
                                                    <i class="bi bi-calendar3"></i>
                                                    @FormatDate(item.CreatedAt, "Chưa rõ ngày đăng")
                                                </span>

                                                @if (item.UpdatedAt.HasValue)
                                                {
                                                    <span>
                                                        <i class="bi bi-pencil-square"></i>
                                                        Sửa: @FormatShortDate(item.UpdatedAt)
                                                    </span>
                                                }

                                                <span>
                                                    <i class="bi bi-eye"></i>
                                                    @FormatNumber(item.Views) lượt xem
                                                </span>
                                            </div>

                                            @if (item.Status == "Rejected" && !string.IsNullOrWhiteSpace(item.RejectionReason))
                                            {
                                                bool isReportRejected = item.RejectionReason.Contains("báo cáo", StringComparison.OrdinalIgnoreCase)
                                                || item.RejectionReason.Contains("vi phạm", StringComparison.OrdinalIgnoreCase)
                                                || item.RejectionReason.Contains("tạm dừng", StringComparison.OrdinalIgnoreCase);

                                                <div class="myads-alert myads-alert-danger">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>

                                                    @if (isReportRejected)
                                                    {
                                                        <strong>Tin đang tạm dừng hiển thị do báo cáo vi phạm:</strong>
                                                    }
                                                    else
                                                    {
                                                        <strong>Lý do từ chối:</strong>
                                                    }

                                                    @item.RejectionReason

                                                    <div class="mt-2 small fw-bold text-danger">
                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Vui lòng bấm “Sửa”, cập nhật lại thông tin. Sau khi lưu, tin sẽ được gửi lại Admin duyệt.
                                                    </div>
                                                </div>
                                            }

                                            @if (item.Status == "Expired")
                                            {
                                                <div class="myads-alert myads-alert-warning">
                                                    <i class="bi bi-clock-history me-1"></i>
                                                    <strong>Tin hết hạn:</strong>
                                                    @(string.IsNullOrWhiteSpace(item.RejectionReason)
                                                                                            ? "Tin đã hết hạn hiển thị và không còn xuất hiện công khai."
                                                                                            : item.RejectionReason)
                                    </div>
                                                                        }

                                            @if (item.IsDuplicate && !string.IsNullOrWhiteSpace(item.DuplicateReason))
                                            {
                                                <div class="myads-alert myads-alert-warning">
                                                    <i class="bi bi-info-circle-fill me-1"></i>
                                                    <strong>Cảnh báo trùng tin:</strong> @item.DuplicateReason
                                                </div>
                                            }


                                            @if (isTransacted)
                                            {
                                                <div class="myads-locked-ribbon">
                                                    <i class="bi bi-shield-lock-fill"></i>
                                                    <span>@GetLockedStatusText(item.Status)</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Gói tin & giá">
                                    <div class="myads-package-box">
                                        <span class="myads-package @GetPackageClass(packageName, packageType)">
                                            <i class="@GetPackageIcon(packageName, packageType)"></i>
                                            @packageName
                                        </span>

                                        <span class="myads-type-pill">
                                            <i class="bi bi-building"></i>
                                            @typeName
                                        </span>

                                        <div>
                                            <div class="myads-price">@FormatPrice(item.Price)</div>
                                            <div class="myads-area">
                                                <i class="bi bi-aspect-ratio"></i>
                                                @FormatArea(item.AreaSize)
                                            </div>
                                        </div>

                                        @if (item.VipExpiryDate.HasValue)
                                        {
                                            <span class="myads-vip-expiry">
                                                <i class="bi bi-clock-history"></i>
                                                @if (vipDaysLeft.HasValue && vipDaysLeft.Value >= 0)
                                                {
                                                    <text>VIP còn @vipDaysLeft ngày</text>
                                                }
                                                else
                                                {
                                                    <text>VIP đã hết hạn</text>
                                                }
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td class="text-md-center" data-label="Trạng thái">
                                    <div class="myads-status-wrap">
                                        <span class="myads-status @GetStatusClass(item.Status)">
                                            <i class="@GetStatusIcon(item.Status)"></i>
                                            @GetStatusText(item.Status)
                                        </span>

                                        @if (isTransacted)
                                        {
                                            <div class="myads-status-note">
                                                @FormatShortDate(item.SoldAt)
                                            </div>
                                        }
                                        else if (item.Status == "Pending")
                                        {
                                            <div class="myads-status-note">
                                                Đang chờ kiểm tra
                                            </div>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <div class="myads-status-note">
                                                Đang công khai
                                            </div>
                                        }
                                        else if (item.Status == "Rejected")
                                        {
                                            <div class="myads-status-note">
                                                Cần chỉnh sửa
                                            </div>
                                        }
                                    </div>
                                </td>

                                <td class="text-md-center" data-label="Thao tác">
                                    <div class="myads-actions">
                                        @if (isTransacted)
                                        {
                                            <div class="myads-locked-note">
                                                <i class="bi bi-lock-fill me-1"></i>
                                                Đã khóa sửa, xóa, đánh dấu giao dịch và mọi thao tác khác. Chỉ vào xem chi tiết để đọc cảnh báo.
                                            </div>
                                        }

                                        <a href="/Property/Details/@item.PropertyID"
                                           target="_blank"
                                           class="myads-action-btn btn-view"
                                           title="Xem tin đăng"
                                           data-bs-toggle="tooltip">
                                            <i class="bi bi-eye-fill"></i>
                                            <span>Xem</span>
                                        </a>

                                        <a href="/Property/Edit/@item.PropertyID"
                                           class="myads-action-btn btn-edit @(isTransacted ? "myads-action-disabled" : "")"
                                           title="Chỉnh sửa hoặc nâng cấp gói tin"
                                           data-bs-toggle="tooltip">
                                            <i class="bi bi-pencil-square"></i>
                                            <span>Sửa</span>
                                        </a>

                                        @if (item.Status == "Approved" && !isTransacted)
                                        {
                                            @if (isSale || (!isSale && !isRent))
                                            {
                                                <form action="/Property/MarkAsTransacted"
                                                      method="post"
                                                      class="m-0"
                                                      onsubmit="return confirmTransacted(this, 'Xác nhận đã bán?', 'Tin này sẽ chuyển sang trạng thái Đã bán.', 'Xác nhận');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.PropertyID" />
                                                    <input type="hidden" name="transactionStatus" value="Sold" />

                                                    <button type="submit"
                                                            class="myads-action-btn btn-sold"
                                                            title="Đánh dấu đã bán"
                                                            data-bs-toggle="tooltip">
                                                        <i class="bi bi-bag-check-fill"></i>
                                                        <span>Đã bán</span>
                                                    </button>
                                                </form>
                                            }

                                            @if (isRent || (!isSale && !isRent))
                                            {
                                                <form action="/Property/MarkAsTransacted"
                                                      method="post"
                                                      class="m-0"
                                                      onsubmit="return confirmTransacted(this, 'Xác nhận đã cho thuê?', 'Tin này sẽ chuyển sang trạng thái Đã cho thuê.', 'Xác nhận');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.PropertyID" />
                                                    <input type="hidden" name="transactionStatus" value="Rented" />

                                                    <button type="submit"
                                                            class="myads-action-btn btn-rented"
                                                            title="Đánh dấu đã cho thuê"
                                                            data-bs-toggle="tooltip">
                                                        <i class="bi bi-key-fill"></i>
                                                        <span>Đã thuê</span>
                                                    </button>
                                                </form>
                                            }
                                        }

                                        <form id="deleteForm-@item.PropertyID"
                                              action="/Property/DeleteMyAd"
                                              method="post"
                                              class="m-0"
                                              onsubmit="@(isTransacted ? "return false;" : "return confirmDelete(this);")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.PropertyID" />

                                            <button type="submit"
                                                    class="myads-action-btn btn-delete @(isTransacted ? "myads-action-disabled" : "")"
                                                    title="Gỡ tin đăng"
                                                    data-bs-toggle="tooltip">
                                                <i class="bi bi-trash3-fill"></i>
                                                <span>Xóa</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div id="clientEmptyState" class="myads-empty d-none">
                    <div class="myads-empty-icon">
                        <i class="bi bi-search"></i>
                    </div>
                    <h5>Không tìm thấy tin phù hợp</h5>
                    <p>Thử đổi từ khóa tìm kiếm hoặc chọn lại trạng thái khác.</p>
                    <button type="button" class="btn btn-outline-primary" onclick="resetMyAdsFilters()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Xóa bộ lọc
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString()));
        const errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString()));

        function showToast(message, icon = 'success') {
            if (!message) return;

            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: icon,
                title: message,
                showConfirmButton: false,
                timer: icon === 'success' ? 3000 : 4300,
                timerProgressBar: true
            });
        }

        function confirmTransacted(form, title, text, confirmText) {
            Swal.fire({
                title: title,
                text: text,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: confirmText,
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#64748b',
                reverseButtons: true,
                focusCancel: true
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });

            return false;
        }

        function confirmDelete(form) {
            Swal.fire({
                title: 'Bạn muốn xóa tin đăng này?',
                text: 'Tin sẽ được gỡ khỏi danh sách quản lý và không còn hiển thị trên hệ thống.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                reverseButtons: true,
                focusCancel: true
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });

            return false;
        }

        function applyMyAdsFilters() {
            const searchInput = document.getElementById('myAdsSearch');
            const statusFilter = document.getElementById('statusFilter');
            const visibleCount = document.getElementById('visibleCount');
            const emptyState = document.getElementById('clientEmptyState');
            const tableWrap = document.getElementById('adsTableWrap');
            const rows = document.querySelectorAll('#myAdsBody tr[data-row="property"]');

            if (!searchInput || !statusFilter || !visibleCount || !rows.length) return;

            const keyword = (searchInput.value || '').trim().toLowerCase();
            const status = statusFilter.value;
            let count = 0;

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status') || '';
                const rowSearch = row.getAttribute('data-search') || '';

                const matchStatus = status === 'All' || rowStatus === status;
                const matchKeyword = keyword === '' || rowSearch.includes(keyword);

                const shouldShow = matchStatus && matchKeyword;
                row.style.display = shouldShow ? '' : 'none';

                if (shouldShow) count++;
            });

            visibleCount.textContent = count.toString();

            if (emptyState && tableWrap) {
                const table = tableWrap.querySelector('table');

                if (count === 0) {
                    emptyState.classList.remove('d-none');
                    table?.classList.add('d-none');
                } else {
                    emptyState.classList.add('d-none');
                    table?.classList.remove('d-none');
                }
            }
        }

        function resetMyAdsFilters() {
            const searchInput = document.getElementById('myAdsSearch');
            const statusFilter = document.getElementById('statusFilter');

            if (searchInput) searchInput.value = '';
            if (statusFilter) statusFilter.value = 'All';

            applyMyAdsFilters();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));

            if (window.bootstrap && bootstrap.Tooltip) {
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }

            document.getElementById('myAdsSearch')?.addEventListener('input', applyMyAdsFilters);
            document.getElementById('statusFilter')?.addEventListener('change', applyMyAdsFilters);
            document.getElementById('btnResetFilters')?.addEventListener('click', resetMyAdsFilters);

            showToast(successMessage, 'success');
            showToast(errorMessage, 'error');
        });
    </script>
}