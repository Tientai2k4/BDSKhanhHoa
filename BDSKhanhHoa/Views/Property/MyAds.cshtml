@model IEnumerable<BDSKhanhHoa.Models.Property>
@using BDSKhanhHoa.Models
@using System.Globalization
@functions {
    private string HienThiTrangThai(string? status)
    {
        return status switch
        {
            "Approved" => "Đã duyệt",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Sold" => "Đã bán",
            "Rented" => "Đã cho thuê",
            "Expired" => "Tin hết hạn",
            "Draft" => "Bản nháp",
            null or "" => "Chưa xác định",
            _ => status
        };
    }

    private string BadgeTrangThai(string? status)
    {
        return status switch
        {
            "Approved" => "bg-success-subtle text-success border border-success-subtle",
            "Pending" => "bg-warning-subtle text-warning border border-warning-subtle",
            "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle",
            "Sold" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
            "Rented" => "bg-info-subtle text-info border border-info-subtle",
            "Expired" => "bg-dark-subtle text-dark border border-dark-subtle",
            _ => "bg-light text-muted border"
        };
    }
}
@functions {
    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string FormatPrice(decimal? price)
    {
        if (!price.HasValue || price.Value <= 0) return "Thỏa thuận";

        var value = price.Value;

        if (value >= 1_000_000_000M)
            return (value / 1_000_000_000M).ToString("0.##", Vi) + " tỷ";

        if (value >= 1_000_000M)
            return (value / 1_000_000M).ToString("0.##", Vi) + " triệu";

        return value.ToString("N0", Vi) + " đ";
    }

    private string FormatArea(decimal? area)
    {
        if (!area.HasValue || area.Value <= 0) return "Chưa cập nhật";
        return area.Value.ToString("0.##", Vi) + " m²";
    }

    private string FormatDate(DateTime? date, string fallback = "Chưa cập nhật")
    {
        if (!date.HasValue) return fallback;
        return date.Value.ToString("dd/MM/yyyy HH:mm", Vi);
    }

    private string FormatShortDate(DateTime? date, string fallback = "Chưa cập nhật")
    {
        if (!date.HasValue) return fallback;
        return date.Value.ToString("dd/MM/yyyy", Vi);
    }

    private string FormatNumber(int? value)
    {
        return (value ?? 0).ToString("N0", Vi);
    }

    private string GetStatusText(string? status)
    {
        return (status ?? "").Trim() switch
        {
            "Approved" => "Đang hiển thị",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Sold" => "Đã bán",
            "Rented" => "Đã cho thuê",
            "Expired" => "Tin hết hạn",
            _ => "Chưa xác định"
        };
    }

    private string GetStatusIcon(string? status)
    {
        return (status ?? "").Trim() switch
        {
            "Approved" => "bi bi-eye-fill",
            "Pending" => "bi bi-hourglass-split",
            "Rejected" => "bi bi-x-circle-fill",
            "Sold" => "bi bi-bag-check-fill",
            "Rented" => "bi bi-key-fill",
            "Expired" => "bi bi-clock-history",
            _ => "bi bi-question-circle-fill"
        };
    }

    private string GetStatusClass(string? status)
    {
        return (status ?? "").Trim() switch
        {
            "Approved" => "status-approved",
            "Pending" => "status-pending",
            "Rejected" => "status-rejected",
            "Sold" => "status-sold",
            "Rented" => "status-rented",
            "Expired" => "status-expired",
            _ => "status-unknown"
        };
    }


    private bool IsLockedStatus(string? status)
    {
        return status == "Sold" || status == "Rented" || status == "Expired";
    }

    private string GetLockedStatusText(string? status)
    {
        return status switch
        {
            "Sold" => "Tin này đã bán, hệ thống đã khóa toàn bộ thao tác.",
            "Rented" => "Tin này đã cho thuê, hệ thống đã khóa toàn bộ thao tác.",
            "Expired" => "Tin này đã hết hạn hiển thị. Hệ thống giữ lại để bạn theo dõi lịch sử.",
            _ => "Tin này đang bị khóa thao tác."
        };
    }

    private string GetPackageClass(string? packageName, string? packageType)
    {
        var text = $"{packageName} {packageType}".ToLowerInvariant();

        if (text.Contains("kim cương") || text.Contains("diamond")) return "pkg-diamond";
        if (text.Contains("vàng") || text.Contains("gold")) return "pkg-gold";
        if (text.Contains("bạc") || text.Contains("silver")) return "pkg-silver";
        if (text.Contains("thường") || text.Contains("free") || text.Contains("miễn phí")) return "pkg-normal";

        return "pkg-normal";
    }

    private string GetPackageIcon(string? packageName, string? packageType)
    {
        var text = $"{packageName} {packageType}".ToLowerInvariant();

        if (text.Contains("kim cương") || text.Contains("diamond")) return "bi bi-gem";
        if (text.Contains("vàng") || text.Contains("gold")) return "bi bi-stars";
        if (text.Contains("bạc") || text.Contains("silver")) return "bi bi-award-fill";

        return "bi bi-tag-fill";
    }

    private bool IsSaleProperty(Property item)
    {
        var typeName = item.PropertyType?.TypeName ?? "";
        return item.PropertyType?.ParentID == 1
               || item.TypeID == 1
               || typeName.Contains("Bán", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsRentProperty(Property item)
    {
        var typeName = item.PropertyType?.TypeName ?? "";
        return item.PropertyType?.ParentID == 2
               || item.TypeID == 2
               || typeName.Contains("Thuê", StringComparison.OrdinalIgnoreCase);
    }

    private string GetTransactionTypeLabel(Property item)
    {
        if (IsSaleProperty(item)) return "Bán";
        if (IsRentProperty(item)) return "Cho thuê";
        return "Tin đăng";
    }

    private string GetTransactionTypeClass(Property item)
    {
        if (IsSaleProperty(item)) return "deal-sale";
        if (IsRentProperty(item)) return "deal-rent";
        return "deal-normal";
    }
}

@{
    ViewData["Title"] = "Quản lý tin đăng của tôi";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var ads = (Model ?? Enumerable.Empty<Property>()).ToList();

    int totalAds = ads.Count;
    int approvedCount = ads.Count(x => x.Status == "Approved");
    int pendingCount = ads.Count(x => x.Status == "Pending");
    int rejectedCount = ads.Count(x => x.Status == "Rejected");
    int soldCount = ads.Count(x => x.Status == "Sold");
    int rentedCount = ads.Count(x => x.Status == "Rented");
    int expiredCount = ads.Count(x => x.Status == "Expired");
    int vipActiveCount = ads.Count(x => x.VipExpiryDate.HasValue && x.VipExpiryDate.Value >= DateTime.Now);
}

