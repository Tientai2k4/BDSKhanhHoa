@model BDSKhanhHoa.Models.Property
@functions {
    private string HienThiTrangThai(string? status)
    {
        return status switch
        {
            "Approved" => "Đã duyệt",
            "Pending" => "Chờ duyệt",
            "Rejected" => "Bị từ chối",
            "Sold" => "Đã bán",
            "Rented" => "Đã cho thuê",
            "Expired" => "Tin hết hạn",
            "Draft" => "Bản nháp",
            null or "" => "Chưa xác định",
            _ => status
        };
    }

    private string ClassTrangThai(string? status)
    {
        return status switch
        {
            "Approved" => "status-approved",
            "Pending" => "status-pending",
            "Rejected" => "status-rejected",
            "Sold" => "status-sold",
            "Rented" => "status-rented",
            "Expired" => "status-expired",
            _ => "status-unknown"
        };
    }
}
@{
    ViewData["Title"] = "Chỉnh sửa tin đăng";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var oldFeatures = ViewBag.OldFeatures as List<BDSKhanhHoa.Models.PropertyFeature> ?? new List<BDSKhanhHoa.Models.PropertyFeature>();

    var bed = oldFeatures.FirstOrDefault(f => f.FeatureName == "Phòng ngủ")?.FeatureValue;
    var bath = oldFeatures.FirstOrDefault(f => f.FeatureName == "Phòng vệ sinh")?.FeatureValue;
    var dir = oldFeatures.FirstOrDefault(f => f.FeatureName == "Hướng nhà")?.FeatureValue;
    var legal = oldFeatures.FirstOrDefault(f => f.FeatureName == "Pháp lý")?.FeatureValue;
    var amenityString = oldFeatures.FirstOrDefault(f => f.FeatureName == "Tiện ích")?.FeatureValue ?? "";

    var oldImages = ViewBag.OldImages as List<BDSKhanhHoa.Models.PropertyImage> ?? new List<BDSKhanhHoa.Models.PropertyImage>();

    // LẤY DỮ LIỆU GỐC TỪ ADMIN ĐỂ HIỂN THỊ
    var masterFeatures = ViewBag.MasterFeatures as List<BDSKhanhHoa.Models.PropertyFeature> ?? new List<BDSKhanhHoa.Models.PropertyFeature>();
    var huongNhaList = masterFeatures.Where(f => f.FeatureGroup == "Hướng nhà").ToList();
    var phapLyList = masterFeatures.Where(f => f.FeatureGroup == "Pháp lý").ToList();
    var tienIchList = masterFeatures.Where(f => f.FeatureGroup == "Tiện ích").ToList();
    var khacList = masterFeatures.Where(f => f.FeatureGroup == "Khác").ToList();
}

<style>
    :root {
        --edit-primary: #2563eb;
        --edit-primary-soft: #eff6ff;
        --edit-warning: #f59e0b;
        --edit-warning-soft: #fffbeb;
        --edit-success: #16a34a;
        --edit-danger: #ef4444;
        --edit-text: #0f172a;
        --edit-muted: #64748b;
        --edit-border: #e2e8f0;
        --edit-card: #ffffff;
        --edit-radius: 22px;
        --edit-shadow: 0 16px 45px rgba(15, 23, 42, .08);
        --edit-shadow-sm: 0 8px 24px rgba(15, 23, 42, .06);
        --edit-transition: all .22s ease;
    }

    .property-edit-page {
        max-width: 1380px;
        margin: 0 auto;
        padding-bottom: 36px;
    }

    .status-approved {
        border-color: #bbf7d0 !important;
        background: #f0fdf4 !important;
        color: #15803d !important;
    }

    .status-pending {
        border-color: #fde68a !important;
        background: #fffbeb !important;
        color: #92400e !important;
    }

    .status-rejected {
        border-color: #fecaca !important;
        background: #fef2f2 !important;
        color: #b91c1c !important;
    }

    .status-sold,
    .status-rented,
    .status-expired {
        border-color: #cbd5e1 !important;
        background: #f8fafc !important;
        color: #334155 !important;
    }

    .status-unknown {
        border-color: #e2e8f0 !important;
        background: #f8fafc !important;
        color: #64748b !important;
    }

    .property-edit-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px;
        border-radius: 26px;
        background: radial-gradient(circle at top right, rgba(245, 158, 11, .18), transparent 34%), linear-gradient(135deg, #ffffff, #fffaf0);
        border: 1px solid var(--edit-border);
        box-shadow: var(--edit-shadow-sm);
    }

    .property-edit-hero-left {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .property-edit-hero-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--edit-warning), #f97316);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 14px 30px rgba(245, 158, 11, .25);
        flex-shrink: 0;
    }

    .property-edit-title {
        margin: 0;
        font-size: 1.28rem;
        font-weight: 900;
        color: var(--edit-text);
        letter-spacing: -.03em;
    }

    .property-edit-subtitle {
        margin: 5px 0 0;
        color: var(--edit-muted);
        font-size: .9rem;
        line-height: 1.55;
    }

    .property-meta-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    .property-meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 28px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid #fed7aa;
        color: #9a3412;
        font-size: .75rem;
        font-weight: 800;
    }

    .property-back-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--edit-border);
        color: #334155;
        font-weight: 800;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
        transition: var(--edit-transition);
        white-space: nowrap;
    }

        .property-back-btn:hover {
            color: #ea580c;
            border-color: #fed7aa;
            background: #fff7ed;
            transform: translateY(-1px);
        }

    .property-layout {
        align-items: flex-start;
    }

    .property-section-card {
        background: var(--edit-card);
        border: 1px solid var(--edit-border);
        border-radius: var(--edit-radius);
        box-shadow: var(--edit-shadow-sm);
        overflow: hidden;
        margin-bottom: 22px;
    }

    .property-section-head {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f7;
        background: linear-gradient(135deg, rgba(37, 99, 235, .055), rgba(14, 165, 233, .025)), #fff;
    }

    .property-section-number {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: var(--edit-primary-soft);
        color: var(--edit-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        flex-shrink: 0;
    }

    .property-section-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 900;
        color: var(--edit-text);
    }

    .property-section-note {
        margin: 2px 0 0;
        color: var(--edit-muted);
        font-size: .8rem;
        line-height: 1.45;
    }

    .property-section-body {
        padding: 22px;
    }

    .form-label {
        color: #1e293b;
        margin-bottom: 8px;
    }

    .required-star {
        color: var(--edit-danger);
    }

    .property-edit-page .form-control,
    .property-edit-page .form-select {
        border: 1px solid #dbe4ef;
        border-radius: 14px;
        min-height: 46px;
        background-color: #f8fafc;
        color: var(--edit-text);
        font-weight: 600;
        box-shadow: none !important;
        transition: var(--edit-transition);
    }

    .property-edit-page textarea.form-control {
        min-height: 156px;
        line-height: 1.65;
        font-weight: 500;
    }

    .property-edit-page .form-control:focus,
    .property-edit-page .form-select:focus {
        border-color: #93c5fd;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
    }

    .input-group-modern {
        border: 1px solid #dbe4ef;
        border-radius: 14px;
        overflow: hidden;
        background: #f8fafc;
        transition: var(--edit-transition);
    }

        .input-group-modern:focus-within {
            border-color: #93c5fd;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
        }

        .input-group-modern .form-control {
            border: none !important;
            border-radius: 0 !important;
            background: transparent !important;
        }

        .input-group-modern .input-group-text {
            border: none;
            background: #fff;
            color: #475569;
            font-weight: 900;
            min-width: 62px;
            justify-content: center;
        }

    .radio-toolbar,
    .amenity-checkbox {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

        .radio-toolbar input[type="radio"],
        .amenity-checkbox input[type="checkbox"] {
            display: none;
        }

        .radio-toolbar label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            background-color: #f8fafc;
            border: 1.5px solid #dbe4ef;
            padding: 10px 18px;
            font-weight: 800;
            border-radius: 999px;
            cursor: pointer;
            transition: var(--edit-transition);
            color: #475569;
            margin: 0;
        }

            .radio-toolbar label:hover {
                background: #eff6ff;
                border-color: #bfdbfe;
                color: var(--edit-primary);
                transform: translateY(-1px);
            }

        .radio-toolbar input[type="radio"]:checked + label {
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border-color: var(--edit-primary);
            color: var(--edit-primary);
            box-shadow: 0 10px 22px rgba(37, 99, 235, .14);
        }

        .amenity-checkbox label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background-color: #ffffff;
            border: 1px solid #dbe4ef;
            padding: 9px 15px;
            font-size: .88rem;
            font-weight: 750;
            border-radius: 999px;
            cursor: pointer;
            transition: var(--edit-transition);
            color: #475569;
            margin: 0;
        }

            .amenity-checkbox label:hover {
                border-color: #bbf7d0;
                background: #f0fdf4;
                color: var(--edit-success);
                transform: translateY(-1px);
            }

        .amenity-checkbox input[type="checkbox"]:checked + label {
            background-color: #dcfce7;
            border-color: var(--edit-success);
            color: var(--edit-success);
            box-shadow: 0 8px 18px rgba(22, 163, 74, .14);
        }

    .mini-field {
        border: 1px solid #edf2f7;
        border-radius: 18px;
        padding: 14px;
        background: #fbfdff;
        height: 100%;
    }

    .sidebar-sticky-card {
        position: sticky;
        top: 20px;
        background: #fff;
        border: 1px solid var(--edit-border);
        border-radius: var(--edit-radius);
        box-shadow: var(--edit-shadow);
        overflow: hidden;
    }

    .sidebar-card-head {
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f7;
        background: radial-gradient(circle at top right, rgba(245, 158, 11, .18), transparent 34%), linear-gradient(135deg, #fff, #fffaf0);
    }

        .sidebar-card-head h5 {
            margin: 0;
            font-size: 1rem;
            font-weight: 900;
            color: var(--edit-text);
        }

    .sidebar-card-body {
        padding: 22px;
    }

    .img-upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 20px;
        height: 235px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        cursor: pointer;
        overflow: hidden;
        position: relative;
        transition: var(--edit-transition);
    }

        .img-upload-zone:hover {
            border-color: var(--edit-primary);
            background: #f1f5f9;
            transform: translateY(-1px);
        }

    #imgPreview {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .change-img-overlay {
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 12px;
        border-radius: 14px;
        background: rgba(15, 23, 42, .78);
        backdrop-filter: blur(10px);
        color: white;
        padding: 10px 12px;
        text-align: center;
        font-weight: 900;
        font-size: .86rem;
        z-index: 2;
        transform: translateY(120%);
        transition: transform .24s ease;
    }

    .img-upload-zone:hover .change-img-overlay {
        transform: translateY(0);
    }

    .gallery-wrapper {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(86px, 1fr));
        gap: 14px;
    }

    .img-thumb-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        border-radius: 18px;
    }

    .sub-img-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 18px;
        border: 2px solid #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .10);
        transition: var(--edit-transition);
    }

    .img-thumb-container.new-img .sub-img-thumb {
        border-color: #93c5fd;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .16);
    }

    .btn-remove-img {
        position: absolute;
        top: -8px;
        right: -8px;
        background: var(--edit-danger);
        color: white;
        border: none;
        border-radius: 50%;
        width: 28px;
        height: 28px;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(239, 68, 68, .30);
        transition: var(--edit-transition);
        z-index: 3;
    }

        .btn-remove-img:hover {
            transform: scale(1.12);
            background: #dc2626;
        }

    .img-deleted {
        opacity: .42;
        filter: grayscale(100%);
        pointer-events: none;
    }

    .warning-soft-box {
        border: 1px solid #fde68a;
        background: #fffbeb;
        color: #92400e;
        border-radius: 18px;
        padding: 14px;
    }

    .submit-area {
        display: grid;
        gap: 10px;
    }

    .btn-submit-edit {
        min-height: 52px;
        border-radius: 999px;
        font-weight: 900;
        letter-spacing: .02em;
        box-shadow: 0 14px 28px rgba(245, 158, 11, .20);
    }

    @@media (max-width: 991.98px) {
        .property-edit-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
            border-radius: 22px;
        }

        .property-back-btn {
            width: 100%;
        }

        .sidebar-sticky-card {
            position: static;
        }

        .property-section-body,
        .sidebar-card-body {
            padding: 18px;
        }
    }

    @@media (max-width: 575.98px) {
        .property-edit-page {
            padding-bottom: 24px;
        }

        .property-edit-hero-left {
            align-items: flex-start;
        }

        .property-edit-hero-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            font-size: 1.25rem;
        }

        .property-edit-title {
            font-size: 1.08rem;
        }

        .property-edit-subtitle {
            font-size: .82rem;
        }

        .property-section-head,
        .sidebar-card-head {
            padding: 16px;
        }

        .property-section-body,
        .sidebar-card-body {
            padding: 16px;
        }

        .radio-toolbar {
            display: grid;
            grid-template-columns: 1fr;
        }

            .radio-toolbar label {
                width: 100%;
            }

        .amenity-checkbox label {
            width: 100%;
            justify-content: flex-start;
        }

        .img-upload-zone {
            height: 210px;
        }

        .gallery-wrapper {
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }
    }
</style>

<div class="property-edit-page">
    <div class="property-edit-hero">
        <div class="property-edit-hero-left">
            <div class="property-edit-hero-icon">
                <i class="bi bi-pencil-square"></i>
            </div>

            <div>
                <h4 class="property-edit-title">Chỉnh sửa bất động sản</h4>
                <p class="property-edit-subtitle">
                    Cập nhật thông tin tin đăng. Sau khi lưu, bài viết sẽ chuyển về trạng thái chờ duyệt.
                </p>

                <div class="property-meta-row">
                    <span class="property-meta-pill">
                        <i class="bi bi-hash"></i>
                        Mã tin: @Model.PropertyID
                    </span>
                    <span class="property-meta-pill @ClassTrangThai(Model.Status)">
                        <i class="bi bi-activity"></i>
                        Trạng thái: @HienThiTrangThai(Model.Status)
                    </span>
                </div>
            </div>
        </div>

        <a href="/Property/MyAds" class="property-back-btn">
            <i class="bi bi-arrow-left"></i>
            Trở về
        </a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="frmEditProp">
        <input type="hidden" asp-for="PropertyID" />
        <div id="deletedImagesContainer"></div>

        <div class="row g-4 property-layout">
            <div class="col-lg-8">
                <div class="property-section-card">
                    <div class="property-section-head">
                        <div class="property-section-number">1</div>
                        <div>
                            <h5 class="property-section-title">Thông tin cơ bản</h5>
                            <p class="property-section-note">Cập nhật hình thức, loại bất động sản, tiêu đề và mô tả.</p>
                        </div>
                    </div>

                    <div class="property-section-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold d-block">
                                Hình thức giao dịch <span class="required-star">*</span>
                            </label>

                            <div class="radio-toolbar" id="parentTypeContainer">
                                @foreach (var parent in ViewBag.ParentTypes)
                                {
                                    bool isChecked = (Model.PropertyType?.ParentID == parent.TypeID || Model.TypeID == parent.TypeID);
                                    <input type="radio" id="parent_@parent.TypeID" name="ParentTypeSelector" value="@parent.TypeID" onchange="filterSubTypes(this.value)" @(isChecked ? "checked" : "")>
                                    <label for="parent_@parent.TypeID">
                                        <i class="bi bi-check-circle"></i>
                                        @parent.TypeName
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Loại bất động sản <span class="required-star">*</span>
                                </label>
                                <select asp-for="TypeID" id="subTypeSelect" class="form-select form-select-lg" required>
                                    <option value="@Model.TypeID">@Model.PropertyType?.TypeName</option>
                                </select>
                                <span asp-validation-for="TypeID" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Tiêu đề tin đăng <span class="required-star">*</span>
                                </label>
                                <input asp-for="Title" class="form-control form-control-lg" required />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    Mô tả chi tiết <span class="required-star">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="7" required></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="property-section-card">
                    <div class="property-section-head">
                        <div class="property-section-number">2</div>
                        <div>
                            <h5 class="property-section-title">Địa điểm & kích thước</h5>
                            <p class="property-section-note">Cập nhật vị trí, giá bán/thuê và thông số diện tích.</p>
                        </div>
                    </div>

                    <div class="property-section-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Khu vực <span class="required-star">*</span>
                                </label>
                                <select id="areaSelect" class="form-select" asp-items="ViewBag.Areas" onchange="loadWards(this.value)" required>
                                    <option value="">-- Chọn khu vực --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Phường / Xã <span class="required-star">*</span>
                                </label>
                                <select asp-for="WardID" id="wardSelect" class="form-select" asp-items="ViewBag.Wards" required>
                                    <option value="">-- Vui lòng chọn Khu vực trước --</option>
                                </select>
                                <span asp-validation-for="WardID" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Địa chỉ chi tiết</label>
                                <input asp-for="AddressDetail" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mức giá</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="Price" type="number" class="form-control" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Diện tích đất</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="AreaSize" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">m²</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Chiều ngang</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="Width" type="number" step="0.01" class="form-control" placeholder="Ví dụ: 5.5" />
                                    <span class="input-group-text">m</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Chiều dài</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="Length" type="number" step="0.01" class="form-control" placeholder="Ví dụ: 20" />
                                    <span class="input-group-text">m</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="property-section-card">
                    <div class="property-section-head">
                        <div class="property-section-number">3</div>
                        <div>
                            <h5 class="property-section-title">Thông tin chi tiết & tiện ích</h5>
                            <p class="property-section-note">Các thông số phụ giúp khách hàng hiểu rõ hơn về bất động sản.</p>
                        </div>
                    </div>

                    <div class="property-section-body">
                        <div class="row g-3 mb-4">
                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Phòng ngủ</label>
                                    <input type="number"
                                           name="Bedrooms"
                                           value="@(string.IsNullOrWhiteSpace(bed) ? "0" : bed)"
                                           class="form-control fw-bold text-center"
                                           min="0"
                                           max="20" />
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Phòng tắm</label>
                                    <input type="number"
                                           name="Bathrooms"
                                           value="@(string.IsNullOrWhiteSpace(bath) ? "0" : bath)"
                                           class="form-control fw-bold text-center"
                                           min="0"
                                           max="20" />
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Hướng nhà</label>
                                    <select name="Direction" class="form-select">
                                        <option value="">-- Không rõ --</option>
                                        @foreach (var item in huongNhaList)
                                        {
                                            if (dir == item.FeatureName)
                                            {
                                                <option value="@item.FeatureName" selected>@item.FeatureName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.FeatureName">@item.FeatureName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Pháp lý</label>
                                    <select name="LegalStatus" class="form-select">
                                        <option value="">-- Trạng thái --</option>
                                        @foreach (var item in phapLyList)
                                        {
                                            if (legal == item.FeatureName)
                                            {
                                                <option value="@item.FeatureName" selected>@item.FeatureName</option>
                                            }
                                            else
                                            {
                                                <option value="@item.FeatureName">@item.FeatureName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <label class="form-label fw-bold mb-3 d-block">Tiện ích nổi bật</label>
                        <div class="amenity-checkbox">
                            @if (!tienIchList.Any())
                            {
                                <p class="text-muted small mb-0"><i>Hệ thống chưa cấu hình tiện ích mẫu.</i></p>
                            }
                            else
                            {
                                int count = 1;
                                foreach (var item in tienIchList)
                                {
                                    bool isChecked = amenityString.Contains(item.FeatureName);
                                    <input type="checkbox" id="am_@count" name="Amenities" value="@item.FeatureName" @(isChecked ? "checked" : "")>
                                    <label for="am_@count">
                                        <i class="bi bi-check2-square"></i>
                                        @item.FeatureName
                                    </label>
                                    count++;
                                }
                            }
                        </div>

                        <label class="form-label fw-bold mb-3 d-block mt-4">Đặc điểm khác</label>
                        <div class="amenity-checkbox">
                            @if (!khacList.Any())
                            {
                                <p class="text-muted small mb-0"><i>Hệ thống chưa cấu hình đặc điểm khác.</i></p>
                            }
                            else
                            {
                                int countKhac = 1;
                                foreach (var item in khacList)
                                {
                                    bool isChecked = amenityString.Contains(item.FeatureName);
                                    <input type="checkbox" id="khac_@countKhac" name="Amenities" value="@item.FeatureName" @(isChecked ? "checked" : "")>
                                    <label for="khac_@countKhac">
                                        <i class="bi bi-check2-square"></i>
                                        @item.FeatureName
                                    </label>
                                    countKhac++;
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-sticky-card">
                    <div class="sidebar-card-head">
                        <h5>
                            <i class="bi bi-camera text-primary me-2"></i>
                            Media & gói tin
                        </h5>
                    </div>

                    <div class="sidebar-card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Ảnh đại diện</label>
                            <label for="MainImageFile" class="img-upload-zone w-100 d-block">
                                <img id="imgPreview" src="@(string.IsNullOrEmpty(Model.MainImage) ? "/images/no-image.jpg" : Model.MainImage)" alt="Ảnh đại diện" />
                                <div class="change-img-overlay">
                                    <i class="bi bi-cloud-upload"></i>
                                    Nhấp để tải ảnh mới
                                </div>
                            </label>
                            <input type="file" id="MainImageFile" name="MainImageFile" class="d-none" accept="image/*" onchange="previewMainImage(event)" />
                            <div class="small text-muted mt-2">
                                Bỏ qua nếu muốn giữ nguyên ảnh hiện tại.
                            </div>
                        </div>

                        <div class="mb-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                <label class="form-label fw-bold mb-0">Thư viện ảnh phụ</label>
                                <label for="AdditionalImagesFile" class="btn btn-sm btn-outline-primary fw-bold rounded-pill mb-0">
                                    <i class="bi bi-plus-circle"></i>
                                    Thêm ảnh
                                </label>
                                <input type="file" id="AdditionalImagesFile" name="AdditionalImages" class="d-none" accept="image/*" multiple onchange="handleNewImagesSelection(event)" />
                            </div>

                            <div class="gallery-wrapper" id="combinedGalleryContainer">
                                @foreach (var img in oldImages)
                                {
                                    <div class="img-thumb-container" id="oldImg_@img.ImageID">
                                        <img src="@img.ImageURL" class="sub-img-thumb" alt="Ảnh phụ" />
                                        <button type="button" class="btn-remove-img" onclick="markOldImageDeleted(@img.ImageID)" title="Xóa ảnh cũ">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-4 pt-3 border-top">
                            <label class="form-label fw-bold mb-3 text-dark d-flex justify-content-between">
                                Gói tin áp dụng <span class="required-star">*</span>
                            </label>

                            <div class="alert alert-info bg-opacity-10 border-info border-opacity-25 small mb-3 p-3 rounded-4">
                                <i class="bi bi-info-circle-fill text-info me-1"></i>
                                Khi chỉ sửa nội dung tin hoặc gửi lại duyệt, hệ thống <strong>không trừ thêm lượt gói</strong>.
                                Chỉ khi bạn chủ động <strong>nâng cấp lên gói VIP cao hơn</strong>, hệ thống mới trừ 1 lượt từ ví.
                                <div class="mt-1 text-danger fw-bold">
                                    Không được hạ VIP xuống gói thấp hơn hoặc đổi ngang sang gói cùng hạng khác.
                                </div>
                            </div>

                            <select asp-for="PackageID" id="packageSelect" class="form-select form-select-lg border-primary shadow-sm mb-3 fw-bold text-primary" required>
                                <option value="@Model.PackageID">Đang tải dữ liệu ví...</option>
                            </select>
                        </div>

                        <div class="warning-soft-box mb-3">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                            Sau khi lưu, tin đăng sẽ chuyển về trạng thái <strong>Chờ duyệt</strong>.
                            Kể cả tin VIP Kim Cương cũng cần Admin kiểm tra thủ công sau khi chỉnh sửa.
                        </div>

                        <div class="submit-area">
                            <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark btn-submit-edit">
                                <i class="bi bi-floppy-fill me-2"></i>
                                Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ==========================================
        // LOGIC DANH MỤC & ĐỊA CHỈ
        // ==========================================
        const subTypesData = @Html.Raw(ViewBag.SubTypesJson);
        const subTypeSelect = document.getElementById('subTypeSelect');

        function filterSubTypes(parentId) {
            if (!subTypeSelect) return;

            let oldSelected = subTypeSelect.value;
            subTypeSelect.innerHTML = '<option value="">-- Chọn loại bất động sản --</option>';

            const filteredTypes = subTypesData.filter(t => String(t.ParentID) === String(parentId));

            filteredTypes.forEach(t => {
                let opt = new Option(t.TypeName, t.TypeID);
                if (String(t.TypeID) === String(oldSelected)) opt.selected = true;
                subTypeSelect.add(opt);
            });
        }

        async function loadWards(areaId) {
            const wardSelect = document.getElementById('wardSelect');
            if (!wardSelect) return;

            let oldWard = wardSelect.value;
            wardSelect.innerHTML = '<option value="">Đang tải...</option>';

            if (!areaId) {
                wardSelect.innerHTML = '<option value="">-- Vui lòng chọn Khu vực trước --</option>';
                return;
            }

            try {
                const response = await fetch(`/Home/GetWardsByArea?areaId=${areaId}`);
                const data = await response.json();

                wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã --</option>';

                data.forEach(w => {
                    let opt = new Option(w.wardName, w.wardId);
                    if (String(w.wardId) === String(oldWard)) opt.selected = true;
                    wardSelect.add(opt);
                });
            } catch (error) {
                wardSelect.innerHTML = '<option value="">Lỗi kết nối</option>';
            }
        }

        // ==========================================
        // LOGIC ẢNH ĐẠI DIỆN
        // ==========================================
        function previewMainImage(event) {
            const file = event.target.files && event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function () {
                document.getElementById('imgPreview').src = reader.result;
            };
            reader.readAsDataURL(file);
        }

        // ==========================================
        // LOGIC ẢNH PHỤ
        // ==========================================
        const dataTransfer = new DataTransfer();
        const galleryContainer = document.getElementById('combinedGalleryContainer');
        const fileInput = document.getElementById('AdditionalImagesFile');

        function markOldImageDeleted(imageId) {
            const container = document.getElementById('oldImg_' + imageId);
            if (!container || container.classList.contains('img-deleted')) return;

            container.classList.add('img-deleted');
            const removeBtn = container.querySelector('.btn-remove-img');
            if (removeBtn) removeBtn.style.display = 'none';

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'DeletedImageIds';
            input.value = imageId;
            document.getElementById('deletedImagesContainer').appendChild(input);
        }

        function handleNewImagesSelection(event) {
            const files = event.target.files;

            for (let i = 0; i < files.length; i++) {
                if (!files[i].type.startsWith('image/')) continue;

                if (dataTransfer.items.length >= 10) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vượt quá số ảnh',
                        text: 'Chỉ được tải lên tối đa 10 ảnh phụ mới.',
                        confirmButtonText: 'Đã hiểu',
                        customClass: { popup: 'rounded-4' }
                    });
                    break;
                }

                dataTransfer.items.add(files[i]);
            }

            syncFileInputAndRender();
        }

        function removeNewImage(indexToRemove) {
            const tempDt = new DataTransfer();

            for (let i = 0; i < dataTransfer.files.length; i++) {
                if (i !== indexToRemove) {
                    tempDt.items.add(dataTransfer.files[i]);
                }
            }

            dataTransfer.items.clear();

            for (let i = 0; i < tempDt.files.length; i++) {
                dataTransfer.items.add(tempDt.files[i]);
            }

            syncFileInputAndRender();
        }

        function syncFileInputAndRender() {
            if (!fileInput || !galleryContainer) return;

            fileInput.files = dataTransfer.files;
            document.querySelectorAll('.new-img').forEach(el => el.remove());

            const files = dataTransfer.files;

            for (let i = 0; i < files.length; i++) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    const div = document.createElement('div');
                    div.className = 'img-thumb-container new-img';

                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'sub-img-thumb';
                    img.alt = 'Ảnh phụ mới';

                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn-remove-img';
                    btn.title = 'Hủy chọn ảnh này';
                    btn.innerHTML = '<i class="bi bi-x-lg"></i>';
                    btn.onclick = function () { removeNewImage(i); };

                    div.appendChild(img);
                    div.appendChild(btn);
                    galleryContainer.appendChild(div);
                };

                reader.readAsDataURL(files[i]);
            }
        }

        // ==========================================
        // LOGIC GÓI TIN KHI SỬA
        // ==========================================
        async function loadMyPackages() {
            const selectEl = document.getElementById('packageSelect');
            if (!selectEl) return;

            const currentPackageId = Number('@Model.PackageID');
            const currentPackagePriority = Number('@(ViewBag.CurrentPackagePriority ?? 9999)');
            const currentPackageName = '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Convert.ToString(ViewBag.CurrentPackageName ?? "Gói hiện tại")))';

            selectEl.innerHTML = '';

            const currentOption = new Option(
                `[Đang dùng] ${currentPackageName} - Giữ nguyên gói, không trừ lượt`,
                currentPackageId
            );
            currentOption.selected = true;
            currentOption.style.color = '#2563eb';
            currentOption.style.fontWeight = 'bold';
            selectEl.add(currentOption);

            try {
                const response = await fetch('/Property/GetAvailablePackages');
                const result = await response.json();

                if (result.success && Array.isArray(result.data)) {
                    result.data.forEach(pkg => {
                        const pkgId = Number(pkg.id);
                        const pkgPriority = Number(pkg.priority || 9999);

                        if (pkgId === currentPackageId) return;

                        // Chỉ hiện gói cao hơn để nâng cấp.
                        // PriorityLevel càng nhỏ thì gói càng cao.
                        if (pkgPriority >= currentPackagePriority) return;

                        const textStr = `[Nâng cấp] ${pkg.name} - Còn: ${pkg.availableCount} lượt`;
                        const option = new Option(textStr, pkg.id);
                        option.style.color = '#dc2626';
                        option.style.fontWeight = 'bold';
                        selectEl.add(option);
                    });
                }

                if (selectEl.options.length === 1) {
                    const noUpgradeOption = new Option(
                        'Không có gói VIP cao hơn trong ví để nâng cấp',
                        ''
                    );
                    noUpgradeOption.disabled = true;
                    noUpgradeOption.style.color = '#64748b';
                    selectEl.add(noUpgradeOption);
                }
            } catch (error) {
                const errorOption = new Option(
                    'Không tải được ví gói. Hệ thống vẫn giữ nguyên gói hiện tại.',
                    ''
                );
                errorOption.disabled = true;
                errorOption.style.color = '#64748b';
                selectEl.add(errorOption);
            }
        }

        document.addEventListener('change', function (e) {
            if (e.target && e.target.id === 'packageSelect') {
                const currentPackageId = Number('@Model.PackageID');
                const selectedPackageId = Number(e.target.value || 0);

                if (selectedPackageId > 0 && selectedPackageId !== currentPackageId) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Xác nhận nâng cấp gói',
                        html: `
                            <div class="text-start">
                                <p class="mb-2">Bạn đang chọn gói VIP cao hơn gói hiện tại.</p>
                                <div class="alert alert-warning rounded-4 mb-0">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Khi lưu thay đổi, hệ thống sẽ trừ <strong>1 lượt</strong> của gói nâng cấp từ ví.
                                    Tin đăng sẽ chuyển về trạng thái <strong>Chờ duyệt</strong>.
                                </div>
                            </div>
                        `,
                        confirmButtonText: 'Tôi đã hiểu',
                        confirmButtonColor: '#f59e0b',
                        customClass: { popup: 'rounded-4' }
                    });
                }
            }
        });

        // ==========================================
        // INIT
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            const checkedRadio = document.querySelector('input[name="ParentTypeSelector"]:checked');
            if (checkedRadio) {
                filterSubTypes(checkedRadio.value);
                const subSelect = document.getElementById('subTypeSelect');
                if (subSelect) subSelect.value = '@Model.TypeID';
            }

            loadMyPackages();
        });
    </script>
}
