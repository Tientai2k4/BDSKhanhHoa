@model IEnumerable<BDSKhanhHoa.Models.Property>
@using System.Linq
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var filters = ViewBag.CurrentFilters;

    string transactionType = Convert.ToString(filters?.transactionType) == "rent" ? "rent" : "buy";
    bool isBuy = transactionType == "buy";

    int totalItems = ViewBag.TotalItems != null ? Convert.ToInt32(ViewBag.TotalItems) : 0;
    int totalPages = ViewBag.TotalPages != null ? Convert.ToInt32(ViewBag.TotalPages) : 1;
    int currentPage = ViewBag.CurrentPage != null ? Convert.ToInt32(ViewBag.CurrentPage) : 1;

    string subTypesJson = ViewBag.SubTypesJson ?? "[]";

    int buyRootId = ViewBag.BuyRootId != null ? Convert.ToInt32(ViewBag.BuyRootId) : 1;
    int rentRootId = ViewBag.RentRootId != null ? Convert.ToInt32(ViewBag.RentRootId) : 2;

    string currentTypeId = filters?.typeId != null ? Convert.ToString(filters.typeId) : "";
    string currentAreaId = filters?.areaId != null ? Convert.ToString(filters.areaId) : "";
    string currentWardId = filters?.wardId != null ? Convert.ToString(filters.wardId) : "";
    string currentSort = filters?.sortOrder != null ? Convert.ToString(filters.sortOrder) : "";
    string currentKeyword = filters?.keyword != null ? Convert.ToString(filters.keyword) : "";

    var currentAmenities = (filters?.amenities as string[]) ?? Array.Empty<string>();

    decimal priceMinLimit = 0m;
    decimal priceMaxLimit = ViewBag.PriceMaxLimit != null ? Convert.ToDecimal(ViewBag.PriceMaxLimit) : 50000m;

    decimal areaMinLimit = 0m;
    decimal areaMaxLimit = ViewBag.AreaMaxLimit != null ? Convert.ToDecimal(ViewBag.AreaMaxLimit) : 1000m;

    decimal currentMinPrice = filters?.minPrice != null ? Convert.ToDecimal(filters.minPrice) : priceMinLimit;
    decimal currentMaxPrice = filters?.maxPrice != null ? Convert.ToDecimal(filters.maxPrice) : priceMaxLimit;

    decimal currentMinArea = filters?.minSize != null ? Convert.ToDecimal(filters.minSize) : areaMinLimit;
    decimal currentMaxArea = filters?.maxSize != null ? Convert.ToDecimal(filters.maxSize) : areaMaxLimit;

    ViewData["Title"] = transactionType == "rent"
        ? "Cho thuê bất động sản Khánh Hòa"
        : "Mua bán bất động sản Khánh Hòa";
}

@functions {
    public string FormatPrice(decimal value)
    {
        if (value >= 1000m)
        {
            return $"{(value / 1000m):0.##} tỷ";
        }

        return $"{value:0.##} triệu";
    }

    public string FormatArea(decimal value)
    {
        return $"{value:0.##} m²";
    }
}

<style>
    :root {
        --bds-bg: #f5f7fb;
        --bds-card: #ffffff;
        --bds-text: #0f172a;
        --bds-muted: #64748b;
        --bds-border: #e5e7eb;
        --bds-primary: #2563eb;
        --bds-primary-dark: #1d4ed8;
        --bds-red: #ef4444;
        --bds-green: #10b981;
        --bds-shadow-sm: 0 4px 14px rgba(15, 23, 42, .06);
        --bds-shadow-md: 0 14px 34px rgba(15, 23, 42, .10);
        --bds-radius: 22px;
    }

    body {
        background: radial-gradient(circle at top left, rgba(37,99,235,.08), transparent 28%), radial-gradient(circle at top right, rgba(16,185,129,.07), transparent 24%), var(--bds-bg);
    }

    .search-page {
        padding: 18px 0 40px;
    }

    .filter-shell {
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(229,231,235,.95);
        border-radius: var(--bds-radius);
        box-shadow: var(--bds-shadow-md);
        overflow: hidden;
    }

    .filter-header {
        padding: 16px 16px 14px;
        border-bottom: 1px solid var(--bds-border);
        background: linear-gradient(180deg, #ffffff, #f8fafc);
    }

    .filter-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 900;
        color: var(--bds-text);
    }

    .filter-subtitle {
        margin-top: 3px;
        font-size: .84rem;
        color: var(--bds-muted);
        font-weight: 600;
    }

    .filter-body {
        padding: 16px;
    }

    .filter-group {
        margin-bottom: 14px;
        position: relative;
    }

    .filter-label {
        display: block;
        margin-bottom: 7px;
        font-size: .88rem;
        font-weight: 800;
        color: var(--bds-text);
    }

    .soft-input,
    .soft-select {
        width: 100%;
        border: 1px solid var(--bds-border) !important;
        border-radius: 15px !important;
        background: #ffffff !important;
        padding: 11px 13px !important;
        font-size: .94rem;
        font-weight: 650;
        color: var(--bds-text) !important;
        box-shadow: none !important;
    }

        .soft-input:focus,
        .soft-select:focus {
            border-color: rgba(37,99,235,.45) !important;
            box-shadow: 0 0 0 .22rem rgba(37,99,235,.11) !important;
        }

    .mode-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 6px;
        border-radius: 18px;
        background: #eef2ff;
        margin-bottom: 15px;
    }

    .mode-tab {
        border: 0;
        border-radius: 14px;
        padding: 11px 8px;
        font-size: .92rem;
        font-weight: 900;
        color: #475569;
        background: transparent;
        transition: all .22s ease;
    }

        .mode-tab.active {
            color: #ffffff;
            background: linear-gradient(135deg, var(--bds-primary), var(--bds-primary-dark));
            box-shadow: 0 8px 20px rgba(37,99,235,.22);
        }

    .range-card {
        border: 1px solid var(--bds-border);
        border-radius: 17px;
        background: #ffffff;
        padding: 12px;
        box-shadow: var(--bds-shadow-sm);
    }

    .range-values {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 10px;
        font-size: .82rem;
        font-weight: 800;
        color: var(--bds-muted);
    }

        .range-values strong {
            color: var(--bds-text);
        }

    .double-range {
        position: relative;
        height: 34px;
    }

        .double-range input[type="range"] {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 34px;
            margin: 0;
            background: transparent;
            pointer-events: none;
            appearance: none;
        }

            .double-range input[type="range"]::-webkit-slider-thumb {
                appearance: none;
                width: 21px;
                height: 21px;
                border-radius: 50%;
                background: #ffffff;
                border: 4px solid var(--bds-primary);
                box-shadow: 0 6px 14px rgba(37,99,235,.26);
                cursor: pointer;
                pointer-events: auto;
                position: relative;
                z-index: 3;
            }

            .double-range input[type="range"]::-webkit-slider-runnable-track {
                height: 7px;
                border-radius: 999px;
                background: transparent;
            }

    .range-line {
        position: absolute;
        left: 0;
        right: 0;
        top: 14px;
        height: 7px;
        border-radius: 999px;
        background: #e2e8f0;
        pointer-events: none;
    }

    .pill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .pill-list .btn-check:checked + .pill-item {
            color: #ffffff;
            border-color: transparent;
            background: linear-gradient(135deg, var(--bds-primary), var(--bds-primary-dark));
            box-shadow: 0 8px 18px rgba(37,99,235,.18);
        }

    .pill-item {
        border: 1px solid var(--bds-border);
        border-radius: 999px;
        background: #ffffff;
        padding: 8px 12px;
        font-size: .86rem;
        font-weight: 800;
        color: #334155;
        cursor: pointer;
        transition: all .2s ease;
    }

    .amenity-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        padding: 0;
        margin: 0;
        list-style: none;
    }

    .amenity-box {
        border: 1px solid var(--bds-border);
        border-radius: 14px;
        background: #ffffff;
        padding: 9px 11px;
    }

        .amenity-box.active {
            border-color: rgba(37,99,235,.38);
            background: rgba(37,99,235,.07);
        }

    .amenity-label {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        cursor: pointer;
        font-size: .87rem;
        font-weight: 800;
        color: #334155;
    }

        .amenity-label input {
            width: 16px;
            height: 16px;
            accent-color: var(--bds-primary);
        }

    .filter-actions {
        display: grid;
        grid-template-columns: 1fr;
        gap: 9px;
        margin-top: 15px;
    }

    .btn-clear-filter {
        border: 1px solid var(--bds-border);
        background: #ffffff;
        color: #475569;
        border-radius: 15px;
        padding: 11px 14px;
        font-weight: 900;
    }

    .btn-apply-mobile {
        border: 0;
        background: linear-gradient(135deg, var(--bds-primary), var(--bds-primary-dark));
        color: #ffffff;
        border-radius: 15px;
        padding: 12px 14px;
        font-weight: 900;
    }

    .result-card {
        position: relative;
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(229,231,235,.95);
        border-radius: var(--bds-radius);
        box-shadow: var(--bds-shadow-sm);
        padding: 16px;
        min-height: 520px;
    }

    .result-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .result-title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 950;
        letter-spacing: -.035em;
        color: var(--bds-text);
    }

    .result-meta {
        margin: 4px 0 0;
        color: var(--bds-muted);
        font-weight: 650;
    }

    .sort-box {
        min-width: 235px;
    }

    .mobile-filter-btn {
        width: 100%;
        border: 0;
        border-radius: 18px;
        padding: 13px 16px;
        color: #ffffff;
        font-weight: 900;
        background: linear-gradient(135deg, var(--bds-primary), var(--bds-primary-dark));
        box-shadow: 0 12px 26px rgba(37,99,235,.22);
    }

    #loadingOverlay {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: none;
        align-items: center;
        justify-content: center;
        border-radius: var(--bds-radius);
        background: rgba(255,255,255,.72);
        backdrop-filter: blur(3px);
    }

    .spinner {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 4px solid #e2e8f0;
        border-top-color: var(--bds-primary);
        animation: spin .75s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .property-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        border: 1px solid rgba(229,231,235,.95);
        border-radius: 22px;
        background: #ffffff;
        box-shadow: var(--bds-shadow-sm);
        transition: all .24s ease;
    }

        .property-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--bds-shadow-md);
            border-color: rgba(37,99,235,.25);
        }

    .property-media {
        position: relative;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #e2e8f0;
    }

        .property-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

    .property-card:hover .property-media img {
        transform: scale(1.045);
    }

    .property-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(15,23,42,0) 35%, rgba(15,23,42,.24) 100%);
    }

    .property-badge {
        position: absolute;
        left: 11px;
        top: 11px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
        box-shadow: 0 8px 16px rgba(15,23,42,.12);
    }

    .badge-diamond {
        color: #ffffff;
        background: linear-gradient(135deg, #06b6d4, #2563eb);
    }

    .badge-gold {
        color: #ffffff;
        background: linear-gradient(135deg, #f59e0b, #ea580c);
    }

    .badge-silver {
        color: #ffffff;
        background: linear-gradient(135deg, #94a3b8, #475569);
    }

    .badge-bronze {
        color: #ffffff;
        background: linear-gradient(135deg, #d97706, #92400e);
    }

    .badge-normal {
        color: #475569;
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(226,232,240,.9);
    }

    .prop-trans-tag {
        position: absolute;
        right: 11px;
        bottom: 11px;
        z-index: 3;
        border-radius: 9px;
        padding: 6px 10px;
        font-size: .72rem;
        font-weight: 950;
        color: #ffffff;
        letter-spacing: .04em;
        box-shadow: 0 8px 16px rgba(15,23,42,.14);
    }

    .tag-buy {
        background: linear-gradient(135deg, #ef4444, #dc2626);
    }

    .tag-rent {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .prop-fav {
        position: absolute;
        top: 11px;
        right: 11px;
        z-index: 5;
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 50%;
        background: rgba(255,255,255,.96);
        color: #64748b;
        box-shadow: 0 8px 18px rgba(15,23,42,.12);
        transition: all .2s ease;
    }

        .prop-fav:hover {
            transform: scale(1.08);
        }

            .prop-fav.active i,
            .prop-fav:hover i {
                color: #ef4444;
            }

    .property-body {
        padding: 15px;
    }

    .property-price {
        margin-bottom: 7px;
        color: var(--bds-red);
        font-size: 1.13rem;
        font-weight: 950;
    }

    .property-title {
        min-height: 44px;
        margin: 0 0 12px;
        color: var(--bds-text);
        font-size: 1rem;
        font-weight: 900;
        line-height: 1.38;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .property-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 9px;
        padding-top: 12px;
        border-top: 1px solid var(--bds-border);
        color: var(--bds-muted);
        font-size: .84rem;
        font-weight: 750;
    }

        .property-meta span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            min-width: 0;
        }

        .property-meta .text-truncate {
            max-width: 55%;
        }

    .pagination-wrap {
        margin-top: 26px;
    }

    .pagination {
        gap: 7px;
        flex-wrap: wrap;
    }

    .page-item .page-link {
        min-width: 40px;
        border: 1px solid var(--bds-border);
        border-radius: 13px !important;
        color: #334155;
        font-weight: 900;
        box-shadow: var(--bds-shadow-sm);
    }

    .page-item.active .page-link {
        color: #ffffff;
        border-color: transparent;
        background: linear-gradient(135deg, var(--bds-primary), var(--bds-primary-dark));
    }

    .empty-state {
        border: 1px solid var(--bds-border);
        border-radius: 24px;
        background: #ffffff;
        padding: 48px 20px;
        box-shadow: var(--bds-shadow-sm);
    }

        .empty-state img {
            width: 148px;
            max-width: 100%;
            opacity: .72;
            margin-bottom: 14px;
        }

    .suggest-box {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 50;
        display: none;
        max-height: 240px;
        overflow-y: auto;
        border: 1px solid var(--bds-border);
        border-radius: 0 0 15px 15px;
        background: #ffffff;
        box-shadow: var(--bds-shadow-md);
    }

    .suggest-item {
        padding: 10px 13px;
        border-bottom: 1px solid #f1f5f9;
        font-size: .9rem;
        font-weight: 750;
        color: var(--bds-text);
        cursor: pointer;
    }

        .suggest-item:hover {
            color: var(--bds-primary);
            background: #eef2ff;
        }

    @@media (min-width: 992px) {
        .filter-sticky {
            position: sticky;
            top: 92px;
            max-height: calc(100vh - 110px);
            overflow-y: auto;
            border-radius: var(--bds-radius);
        }

            .filter-sticky::-webkit-scrollbar {
                width: 6px;
            }

            .filter-sticky::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 999px;
            }
    }

    @@media (max-width: 991.98px) {
        .search-page {
            padding-top: 12px;
        }

        .result-card {
            padding: 13px;
        }

        .result-title {
            font-size: 1.15rem;
        }

        .sort-box {
            width: 100%;
            min-width: 100%;
        }
    }
</style>

<div class="container search-page">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="filter-sticky">
                <div class="offcanvas-lg offcanvas-start" tabindex="-1" id="filterPanel" aria-labelledby="filterPanelLabel">
                    <div class="offcanvas-header d-lg-none border-bottom">
                        <h5 class="offcanvas-title fw-bold" id="filterPanelLabel">
                            <i class="bi bi-sliders2 text-primary me-2"></i>
                            Bộ lọc tìm kiếm
                        </h5>
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="offcanvas"
                                data-bs-target="#filterPanel"
                                aria-label="Đóng"></button>
                    </div>

                    <div class="offcanvas-body p-0">
                        <div class="filter-shell">
                            <div class="filter-header d-none d-lg-block">
                                <h3 class="filter-title">
                                    <i class="bi bi-sliders2 text-primary me-2"></i>
                                    Bộ lọc bất động sản
                                </h3>
                                <div class="filter-subtitle">
                                    Lọc đúng nhóm mua bán / cho thuê
                                </div>
                            </div>

                            <div class="filter-body">
                                <form id="filterForm" action="/Property/Search" method="get">
                                    <input type="hidden" name="transactionType" id="transTypeInput" value="@transactionType" />
                                    <input type="hidden" name="page" id="pageInput" value="@currentPage" />
                                    <input type="hidden" name="sortOrder" id="sortInput" value="@currentSort" />

                                    <div class="mode-tabs">
                                        <button type="button"
                                                class="mode-tab @(isBuy ? "active" : "")"
                                                data-trans="buy">
                                            <i class="bi bi-house-door me-1"></i>
                                            Mua bán
                                        </button>

                                        <button type="button"
                                                class="mode-tab @(!isBuy ? "active" : "")"
                                                data-trans="rent">
                                            <i class="bi bi-key me-1"></i>
                                            Cho thuê
                                        </button>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label" for="keywordInput">Từ khóa</label>
                                        <input type="text"
                                               id="keywordInput"
                                               name="keyword"
                                               class="form-control soft-input"
                                               placeholder="Nhập tên tin, địa chỉ, dự án..."
                                               value="@currentKeyword"
                                               autocomplete="off" />
                                        <div id="suggestBox" class="suggest-box"></div>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label" for="subTypeSelect">Loại bất động sản</label>
                                        <select name="typeId" id="subTypeSelect" class="form-select soft-select">
                                            <option value="">Tất cả loại hình</option>
                                        </select>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label" for="areaSelect">Khu vực</label>
                                        <select name="areaId" id="areaSelect" class="form-select soft-select">
                                            <option value="">Toàn tỉnh Khánh Hòa</option>
                                            @foreach (var area in ViewBag.Areas)
                                            {
                                                <option value="@area.AreaID" selected="@(currentAreaId == Convert.ToString(area.AreaID) ? "selected" : null)">
                                                    @area.AreaName
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label" for="wardSelect">Phường / Xã</label>
                                        <select name="wardId" id="wardSelect" class="form-select soft-select">
                                            <option value="">Tất cả Phường / Xã</option>
                                            @if (!string.IsNullOrWhiteSpace(currentWardId))
                                            {
                                                <option value="@currentWardId" selected>Đang chọn</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label">Mức giá</label>
                                        <div class="range-card">
                                            <div class="range-values">
                                                <span>Từ: <strong id="priceMinLabel">@FormatPrice(currentMinPrice)</strong></span>
                                                <span>Đến: <strong id="priceMaxLabel">@FormatPrice(currentMaxPrice)</strong></span>
                                            </div>

                                            <div class="double-range">
                                                <div class="range-line" id="priceTrack"></div>

                                                <input type="range"
                                                       id="priceMinRange"
                                                       name="minPrice"
                                                       min="@priceMinLimit"
                                                       max="@priceMaxLimit"
                                                       step="10"
                                                       value="@currentMinPrice" />

                                                <input type="range"
                                                       id="priceMaxRange"
                                                       name="maxPrice"
                                                       min="@priceMinLimit"
                                                       max="@priceMaxLimit"
                                                       step="10"
                                                       value="@currentMaxPrice" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label">Diện tích</label>
                                        <div class="range-card">
                                            <div class="range-values">
                                                <span>Từ: <strong id="areaMinLabel">@FormatArea(currentMinArea)</strong></span>
                                                <span>Đến: <strong id="areaMaxLabel">@FormatArea(currentMaxArea)</strong></span>
                                            </div>

                                            <div class="double-range">
                                                <div class="range-line" id="areaTrack"></div>

                                                <input type="range"
                                                       id="areaMinRange"
                                                       name="minSize"
                                                       min="@areaMinLimit"
                                                       max="@areaMaxLimit"
                                                       step="1"
                                                       value="@currentMinArea" />

                                                <input type="range"
                                                       id="areaMaxRange"
                                                       name="maxSize"
                                                       min="@areaMinLimit"
                                                       max="@areaMaxLimit"
                                                       step="1"
                                                       value="@currentMaxArea" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label">Phòng ngủ</label>
                                        <div class="pill-list">
                                            @foreach (var n in new[] { "1", "2", "3", "4", "5" })
                                            {
                                                string id = "bed_" + n;
                                                bool isChecked = filters?.bedrooms != null && Convert.ToString(filters.bedrooms) == n;

                                                <input class="btn-check" type="radio" name="bedrooms" id="@id" value="@n" @(isChecked ? "checked" : "") />
                                                <label class="pill-item" for="@id">@(n == "5" ? "5+" : n)</label>
                                            }
                                        </div>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label">Phòng tắm</label>
                                        <div class="pill-list">
                                            @foreach (var n in new[] { "1", "2", "3", "4" })
                                            {
                                                string id = "bath_" + n;
                                                bool isChecked = filters?.bathrooms != null && Convert.ToString(filters.bathrooms) == n;

                                                <input class="btn-check" type="radio" name="bathrooms" id="@id" value="@n" @(isChecked ? "checked" : "") />
                                                <label class="pill-item" for="@id">@(n == "4" ? "4+" : n)</label>
                                            }
                                        </div>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label" for="directionSelect">Hướng nhà</label>
                                        <select name="direction" id="directionSelect" class="form-select soft-select">
                                            <option value="">Tất cả hướng</option>
                                            @foreach (var direction in new[] { "Đông", "Đông Nam", "Nam", "Tây Nam", "Tây", "Tây Bắc", "Bắc", "Đông Bắc" })
                                            {
                                                <option value="@direction" selected="@(filters?.direction != null && Convert.ToString(filters.direction) == direction ? "selected" : null)">
                                                    @direction
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label" for="legalStatusSelect">Pháp lý</label>
                                        <select name="legalStatus" id="legalStatusSelect" class="form-select soft-select">
                                            <option value="">Tất cả pháp lý</option>
                                            @foreach (var legal in new[] { "Sổ hồng", "Sổ đỏ", "Giấy tờ hợp lệ", "Đang chờ sổ", "Hợp đồng mua bán" })
                                            {
                                                <option value="@legal" selected="@(filters?.legalStatus != null && Convert.ToString(filters.legalStatus) == legal ? "selected" : null)">
                                                    @legal
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <div class="filter-group">
                                        <label class="filter-label">Tiện ích</label>

                                        <ul class="amenity-grid">
                                            @foreach (var item in new[] { "Gần biển", "Gần chợ", "Gần trường học", "Hẻm xe hơi", "Có gara", "Nội thất", "Thang máy", "Hồ bơi" })
                                            {
                                                bool checkedAmenity = currentAmenities.Contains(item);
                                                string id = "amenity_" + item.Replace(" ", "_").Replace("ầ", "a").Replace("ư", "u");

                                                <li class="amenity-box @(checkedAmenity ? "active" : "")">
                                                    <label class="amenity-label" for="@id">
                                                        <input type="checkbox"
                                                               name="amenities"
                                                               id="@id"
                                                               value="@item"
                                                               @(checkedAmenity ? "checked" : "") />
                                                        <span>@item</span>
                                                    </label>
                                                </li>
                                            }
                                        </ul>
                                    </div>

                                    <div class="filter-actions">
                                        <button type="button" class="btn-clear-filter" onclick="resetFilters()">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                            Xóa bộ lọc
                                        </button>

                                        <button type="button" class="btn-apply-mobile d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#filterPanel">
                                            <i class="bi bi-check2-circle me-1"></i>
                                            Xem kết quả
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-lg-none mb-3">
                <button class="mobile-filter-btn"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#filterPanel"
                        aria-controls="filterPanel">
                    <i class="bi bi-sliders2 me-2"></i>
                    Mở bộ lọc tìm kiếm
                </button>
            </div>

            <div class="result-card">
                <div id="loadingOverlay">
                    <div class="spinner"></div>
                </div>

                <div class="result-top">
                    <div>
                        <h1 class="result-title" id="resultTitle">
                            @ViewData["Title"]
                        </h1>

                        <p class="result-meta">
                            Có <strong class="text-primary" id="totalItemsCountUI">@totalItems</strong> kết quả phù hợp.
                        </p>
                    </div>

                    <div class="sort-box">
                        <select id="sortSelect" class="form-select soft-select">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(currentSort) ? "selected" : null)">Tin mới nhất, VIP ưu tiên</option>
                            <option value="price_asc" selected="@(currentSort == "price_asc" ? "selected" : null)">Giá tăng dần</option>
                            <option value="price_desc" selected="@(currentSort == "price_desc" ? "selected" : null)">Giá giảm dần</option>
                            <option value="area_asc" selected="@(currentSort == "area_asc" ? "selected" : null)">Diện tích tăng dần</option>
                            <option value="area_desc" selected="@(currentSort == "area_desc" ? "selected" : null)">Diện tích giảm dần</option>
                        </select>
                    </div>
                </div>

                <div id="partialRenderArea">
                    @await Html.PartialAsync("_PropertyGridPartial", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const subTypes = @Html.Raw(string.IsNullOrWhiteSpace(subTypesJson) ? "[]" : subTypesJson);

    const buyRootId = Number('@buyRootId');
    const rentRootId = Number('@rentRootId');

    const initialTransaction = '@transactionType';
    const initialTypeId = '@currentTypeId';
    const initialAreaId = '@currentAreaId';
    const initialWardId = '@currentWardId';

    const filterForm = document.getElementById('filterForm');
    const transTypeInput = document.getElementById('transTypeInput');
    const pageInput = document.getElementById('pageInput');
    const sortInput = document.getElementById('sortInput');

    const subTypeSelect = document.getElementById('subTypeSelect');
    const areaSelect = document.getElementById('areaSelect');
    const wardSelect = document.getElementById('wardSelect');
    const sortSelect = document.getElementById('sortSelect');

    const priceMinRange = document.getElementById('priceMinRange');
    const priceMaxRange = document.getElementById('priceMaxRange');
    const priceMinLabel = document.getElementById('priceMinLabel');
    const priceMaxLabel = document.getElementById('priceMaxLabel');
    const priceTrack = document.getElementById('priceTrack');

    const areaMinRange = document.getElementById('areaMinRange');
    const areaMaxRange = document.getElementById('areaMaxRange');
    const areaMinLabel = document.getElementById('areaMinLabel');
    const areaMaxLabel = document.getElementById('areaMaxLabel');
    const areaTrack = document.getElementById('areaTrack');

    const suggestBox = document.getElementById('suggestBox');
    const keywordInput = document.getElementById('keywordInput');

    let filterTimer = null;
    let suggestTimer = null;

    function getRootIdByTransaction(transaction) {
        return transaction === 'rent' ? rentRootId : buyRootId;
    }

    function formatPrice(value) {
        const numberValue = Number(value);

        if (numberValue >= 1000) {
            return (numberValue / 1000).toLocaleString('vi-VN', {
                maximumFractionDigits: 2
            }) + ' tỷ';
        }

        return numberValue.toLocaleString('vi-VN', {
            maximumFractionDigits: 0
        }) + ' triệu';
    }

    function formatArea(value) {
        return Number(value).toLocaleString('vi-VN', {
            maximumFractionDigits: 0
        }) + ' m²';
    }

    function updateRange(minInput, maxInput, minLabel, maxLabel, track, formatter) {
        let minValue = Number(minInput.value);
        let maxValue = Number(maxInput.value);

        const minLimit = Number(minInput.min);
        const maxLimit = Number(minInput.max);
        const gap = Number(minInput.step || 1);

        if (minValue > maxValue - gap) {
            minValue = maxValue - gap;
            minInput.value = minValue;
        }

        if (maxValue < minValue + gap) {
            maxValue = minValue + gap;
            maxInput.value = maxValue;
        }

        minLabel.innerText = formatter(minInput.value);
        maxLabel.innerText = formatter(maxInput.value);

        const left = ((Number(minInput.value) - minLimit) / (maxLimit - minLimit)) * 100;
        const right = ((Number(maxInput.value) - minLimit) / (maxLimit - minLimit)) * 100;

        track.style.background = `linear-gradient(
            90deg,
            #e2e8f0 0%,
            #e2e8f0 ${left}%,
            #2563eb ${left}%,
            #2563eb ${right}%,
            #e2e8f0 ${right}%,
            #e2e8f0 100%
        )`;
    }

    function updateAllRanges() {
        updateRange(priceMinRange, priceMaxRange, priceMinLabel, priceMaxLabel, priceTrack, formatPrice);
        updateRange(areaMinRange, areaMaxRange, areaMinLabel, areaMaxLabel, areaTrack, formatArea);
    }

    function fillSubTypes(transaction, selectedTypeId) {
        const rootId = getRootIdByTransaction(transaction);

        subTypeSelect.innerHTML = '<option value="">Tất cả loại hình</option>';

        const filtered = subTypes.filter(x => Number(x.ParentID) === rootId);

        filtered.forEach(item => {
            const option = document.createElement('option');
            option.value = item.TypeID;
            option.textContent = item.TypeName;

            if (selectedTypeId && String(item.TypeID) === String(selectedTypeId)) {
                option.selected = true;
            }

            subTypeSelect.appendChild(option);
        });
    }

    function setActiveTransactionButton(transaction) {
        document.querySelectorAll('.mode-tab').forEach(button => {
            button.classList.toggle('active', button.dataset.trans === transaction);
        });

        const title = document.getElementById('resultTitle');

        if (title) {
            title.innerText = transaction === 'rent'
                ? 'Cho thuê bất động sản Khánh Hòa'
                : 'Mua bán bất động sản Khánh Hòa';
        }
    }

    function buildRequestUrl() {
        const formData = new FormData(filterForm);
        const params = new URLSearchParams(formData);

        params.set('transactionType', transTypeInput.value);
        params.set('sortOrder', sortSelect.value || '');
        params.set('page', pageInput.value || '1');

        if (!params.get('typeId')) {
            params.delete('typeId');
        }

        if (!params.get('areaId')) {
            params.delete('areaId');
        }

        if (!params.get('wardId')) {
            params.delete('wardId');
        }

        if (!params.get('keyword')) {
            params.delete('keyword');
        }

        return '/Property/Search?' + params.toString();
    }

    async function triggerFilter(delay = 450) {
        clearTimeout(filterTimer);

        filterTimer = setTimeout(async () => {
            const overlay = document.getElementById('loadingOverlay');
            const url = buildRequestUrl();

            if (overlay) {
                overlay.style.display = 'flex';
            }

            history.pushState(null, '', url);

            try {
                const response = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const html = await response.text();

                document.getElementById('partialRenderArea').innerHTML = html;

                const hiddenTotal = document.getElementById('hiddenTotalCount');
                const totalUi = document.getElementById('totalItemsCountUI');

                if (hiddenTotal && totalUi) {
                    totalUi.innerText = hiddenTotal.innerText;
                }
            } catch (error) {
                console.error('Lỗi lọc bất động sản:', error);
            } finally {
                if (overlay) {
                    overlay.style.display = 'none';
                }
            }
        }, delay);
    }

    function submitPage(pageNumber) {
        pageInput.value = pageNumber;
        triggerFilter(0);

        window.scrollTo({
            top: 150,
            behavior: 'smooth'
        });
    }

    function resetFilters() {
        transTypeInput.value = 'buy';
        pageInput.value = '1';
        sortSelect.value = '';
        sortInput.value = '';

        filterForm.reset();

        transTypeInput.value = 'buy';
        pageInput.value = '1';

        setActiveTransactionButton('buy');
        fillSubTypes('buy', '');

        document.querySelectorAll('.amenity-box').forEach(box => {
            box.classList.remove('active');
        });

        updateAllRanges();
        triggerFilter(0);
    }

    async function loadWardsByArea(areaId, selectedWardId) {
        if (!wardSelect) {
            return;
        }

        wardSelect.innerHTML = '<option value="">Tất cả Phường / Xã</option>';

        if (!areaId) {
            return;
        }

        try {
            const response = await fetch('/Location/GetWardsByArea?areaId=' + encodeURIComponent(areaId));

            if (!response.ok) {
                return;
            }

            const wards = await response.json();

            wards.forEach(ward => {
                const option = document.createElement('option');

                option.value = ward.wardID || ward.WardID || ward.id;
                option.textContent = ward.wardName || ward.WardName || ward.name;

                if (selectedWardId && String(option.value) === String(selectedWardId)) {
                    option.selected = true;
                }

                wardSelect.appendChild(option);
            });
        } catch (error) {
            console.warn('Không tải được danh sách phường/xã:', error);
        }
    }

    async function toggleFav(propertyId, btnElement) {
        try {
            const response = await fetch('/Home/ToggleFavorite', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: `propertyId=${propertyId}`
            });

            const result = await response.json();

            if (result.success) {
                const icon = btnElement.querySelector('i');

                if (result.isSaved) {
                    btnElement.classList.add('active');
                    icon.className = 'bi bi-heart-fill text-danger';
                } else {
                    btnElement.classList.remove('active');
                    icon.className = 'bi bi-heart';
                }
            } else {
                alert(result.message || 'Bạn cần đăng nhập để lưu tin.');
            }
        } catch (error) {
            console.error('Lỗi lưu tin:', error);
        }
    }

    function bindEvents() {
        document.querySelectorAll('.mode-tab').forEach(button => {
            button.addEventListener('click', () => {
                const transaction = button.dataset.trans;

                transTypeInput.value = transaction;
                pageInput.value = '1';

                // Rất quan trọng:
                // Đổi Mua bán / Cho thuê thì phải xóa loại cũ.
                // Nếu không, typeId của bán sẽ đi qua thuê gây sai kết quả.
                fillSubTypes(transaction, '');
                subTypeSelect.value = '';

                setActiveTransactionButton(transaction);
                triggerFilter(0);
            });
        });

        filterForm.querySelectorAll('input, select').forEach(element => {
            if (element.id === 'transTypeInput' || element.id === 'pageInput' || element.id === 'sortInput') {
                return;
            }

            if (element.type === 'range' || element.type === 'text') {
                element.addEventListener('input', () => {
                    pageInput.value = '1';
                    updateAllRanges();
                    triggerFilter();
                });
            } else {
                element.addEventListener('change', () => {
                    pageInput.value = '1';
                    triggerFilter();
                });
            }
        });

        if (sortSelect) {
            sortSelect.addEventListener('change', () => {
                pageInput.value = '1';
                sortInput.value = sortSelect.value;
                triggerFilter(0);
            });
        }

        if (areaSelect) {
            areaSelect.addEventListener('change', async () => {
                pageInput.value = '1';
                await loadWardsByArea(areaSelect.value, '');
                triggerFilter(0);
            });
        }

        document.querySelectorAll('.amenity-box input[type="checkbox"]').forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                this.closest('.amenity-box').classList.toggle('active', this.checked);
            });
        });

        if (keywordInput) {
            keywordInput.addEventListener('input', () => {
                clearTimeout(suggestTimer);

                const keyword = keywordInput.value.trim();

                if (keyword.length < 2) {
                    suggestBox.style.display = 'none';
                    suggestBox.innerHTML = '';
                    return;
                }

                suggestTimer = setTimeout(async () => {
                    try {
                        const response = await fetch('/Property/Suggest?keyword=' + encodeURIComponent(keyword));
                        const data = await response.json();

                        suggestBox.innerHTML = '';

                        if (!data || data.length === 0) {
                            suggestBox.style.display = 'none';
                            return;
                        }

                        data.forEach(text => {
                            const item = document.createElement('div');
                            item.className = 'suggest-item';
                            item.textContent = text;

                            item.addEventListener('click', () => {
                                keywordInput.value = text;
                                suggestBox.style.display = 'none';
                                pageInput.value = '1';
                                triggerFilter(0);
                            });

                            suggestBox.appendChild(item);
                        });

                        suggestBox.style.display = 'block';
                    } catch (error) {
                        suggestBox.style.display = 'none';
                    }
                }, 250);
            });

            document.addEventListener('click', event => {
                if (!keywordInput.contains(event.target) && !suggestBox.contains(event.target)) {
                    suggestBox.style.display = 'none';
                }
            });
        }
    }

    document.addEventListener('DOMContentLoaded', async () => {
        fillSubTypes(initialTransaction, initialTypeId);
        setActiveTransactionButton(initialTransaction);
        updateAllRanges();
        bindEvents();

        if (initialAreaId) {
            await loadWardsByArea(initialAreaId, initialWardId);
        }
    });
</script>