@model BDSKhanhHoa.Models.Property
@{
    ViewData["Title"] = "Đăng tin bất động sản mới";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // LẤY DỮ LIỆU GỐC TỪ ADMIN ĐỂ HIỂN THỊ
    var masterFeatures = ViewBag.MasterFeatures as List<BDSKhanhHoa.Models.PropertyFeature> ?? new List<BDSKhanhHoa.Models.PropertyFeature>();
    var huongNhaList = masterFeatures.Where(f => f.FeatureGroup == "Hướng nhà").ToList();
    var phapLyList = masterFeatures.Where(f => f.FeatureGroup == "Pháp lý").ToList();
    var tienIchList = masterFeatures.Where(f => f.FeatureGroup == "Tiện ích").ToList();
    var khacList = masterFeatures.Where(f => f.FeatureGroup == "Khác").ToList();
}

<style>
    :root {
        --create-primary: #2563eb;
        --create-primary-soft: #eff6ff;
        --create-success: #16a34a;
        --create-warning: #f59e0b;
        --create-danger: #ef4444;
        --create-text: #0f172a;
        --create-muted: #64748b;
        --create-border: #e2e8f0;
        --create-bg: #f5f8fc;
        --create-card: #ffffff;
        --create-radius: 22px;
        --create-shadow: 0 16px 45px rgba(15, 23, 42, .08);
        --create-shadow-sm: 0 8px 24px rgba(15, 23, 42, .06);
        --create-transition: all .22s ease;
    }

    .property-form-page {
        max-width: 1380px;
        margin: 0 auto;
        padding-bottom: 36px;
    }

    .property-form-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
        padding: 22px;
        border-radius: 26px;
        background: radial-gradient(circle at top right, rgba(37, 99, 235, .16), transparent 32%), linear-gradient(135deg, #ffffff, #f8fbff);
        border: 1px solid var(--create-border);
        box-shadow: var(--create-shadow-sm);
    }

    .property-form-hero-left {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .property-form-hero-icon {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        background: linear-gradient(135deg, var(--create-primary), #3b82f6);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        box-shadow: 0 14px 30px rgba(37, 99, 235, .22);
        flex-shrink: 0;
    }

    .property-form-title {
        margin: 0;
        font-size: 1.28rem;
        font-weight: 900;
        color: var(--create-text);
        letter-spacing: -.03em;
    }

    .property-form-subtitle {
        margin: 4px 0 0;
        color: var(--create-muted);
        font-size: .92rem;
        line-height: 1.55;
    }

    .property-back-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--create-border);
        color: #334155;
        font-weight: 800;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
        transition: var(--create-transition);
        white-space: nowrap;
    }

        .property-back-btn:hover {
            color: var(--create-primary);
            border-color: #bfdbfe;
            background: var(--create-primary-soft);
            transform: translateY(-1px);
        }

    .property-layout {
        align-items: flex-start;
    }

    .property-section-card {
        background: var(--create-card);
        border: 1px solid var(--create-border);
        border-radius: var(--create-radius);
        box-shadow: var(--create-shadow-sm);
        overflow: hidden;
        margin-bottom: 22px;
    }

    .property-section-head {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f7;
        background: linear-gradient(135deg, rgba(37, 99, 235, .055), rgba(14, 165, 233, .025)), #fff;
    }

    .property-section-number {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        background: var(--create-primary-soft);
        color: var(--create-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        flex-shrink: 0;
    }

    .property-section-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 900;
        color: var(--create-text);
    }

    .property-section-note {
        margin: 2px 0 0;
        color: var(--create-muted);
        font-size: .8rem;
        line-height: 1.45;
    }

    .property-section-body {
        padding: 22px;
    }

    .form-label {
        color: #1e293b;
        margin-bottom: 8px;
    }

    .required-star {
        color: var(--create-danger);
    }

    .property-form-page .form-control,
    .property-form-page .form-select {
        border: 1px solid #dbe4ef;
        border-radius: 14px;
        min-height: 46px;
        background-color: #f8fafc;
        color: var(--create-text);
        font-weight: 600;
        box-shadow: none !important;
        transition: var(--create-transition);
    }

    .property-form-page textarea.form-control {
        min-height: 156px;
        line-height: 1.65;
        font-weight: 500;
    }

    .property-form-page .form-control:focus,
    .property-form-page .form-select:focus {
        border-color: #93c5fd;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .10) !important;
    }

    .input-group-modern {
        border: 1px solid #dbe4ef;
        border-radius: 14px;
        overflow: hidden;
        background: #f8fafc;
        transition: var(--create-transition);
    }

        .input-group-modern:focus-within {
            border-color: #93c5fd;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
        }

        .input-group-modern .form-control {
            border: none !important;
            border-radius: 0 !important;
            background: transparent !important;
        }

        .input-group-modern .input-group-text {
            border: none;
            background: #fff;
            color: #475569;
            font-weight: 900;
            min-width: 62px;
            justify-content: center;
        }

    .radio-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

        .radio-toolbar input[type="radio"] {
            display: none;
        }

        .radio-toolbar label {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 46px;
            background-color: #f8fafc;
            border: 1.5px solid #dbe4ef;
            padding: 10px 18px;
            font-weight: 800;
            border-radius: 999px;
            cursor: pointer;
            transition: var(--create-transition);
            color: #475569;
            margin: 0;
        }

            .radio-toolbar label:hover {
                background: #eff6ff;
                border-color: #bfdbfe;
                color: var(--create-primary);
                transform: translateY(-1px);
            }

        .radio-toolbar input[type="radio"]:checked + label {
            background: linear-gradient(135deg, #eff6ff, #dbeafe);
            border-color: var(--create-primary);
            color: var(--create-primary);
            box-shadow: 0 10px 22px rgba(37, 99, 235, .14);
        }

    .amenity-checkbox {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

        .amenity-checkbox input[type="checkbox"] {
            display: none;
        }

        .amenity-checkbox label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background-color: #ffffff;
            border: 1px solid #dbe4ef;
            padding: 9px 15px;
            font-size: .88rem;
            font-weight: 750;
            border-radius: 999px;
            cursor: pointer;
            transition: var(--create-transition);
            color: #475569;
            margin: 0;
        }

            .amenity-checkbox label:hover {
                border-color: #bbf7d0;
                background: #f0fdf4;
                color: var(--create-success);
                transform: translateY(-1px);
            }

        .amenity-checkbox input[type="checkbox"]:checked + label {
            background-color: #dcfce7;
            border-color: var(--create-success);
            color: var(--create-success);
            box-shadow: 0 8px 18px rgba(22, 163, 74, .14);
        }

    .mini-field {
        border: 1px solid #edf2f7;
        border-radius: 18px;
        padding: 14px;
        background: #fbfdff;
        height: 100%;
    }

    .sidebar-sticky-card {
        position: sticky;
        top: 20px;
        background: #fff;
        border: 1px solid var(--create-border);
        border-radius: var(--create-radius);
        box-shadow: var(--create-shadow);
        overflow: hidden;
    }

    .sidebar-card-head {
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f7;
        background: radial-gradient(circle at top right, rgba(245, 158, 11, .16), transparent 34%), linear-gradient(135deg, #fff, #fffaf0);
    }

        .sidebar-card-head h5 {
            margin: 0;
            font-size: 1rem;
            font-weight: 900;
            color: var(--create-text);
        }

    .sidebar-card-body {
        padding: 22px;
    }

    .img-upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 20px;
        height: 235px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at center, rgba(37, 99, 235, .08), transparent 46%), #f8fafc;
        cursor: pointer;
        overflow: hidden;
        position: relative;
        transition: var(--create-transition);
    }

        .img-upload-zone:hover {
            border-color: var(--create-primary);
            background: #f1f5f9;
            transform: translateY(-1px);
        }

    #imgPreview {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .upload-placeholder {
        text-align: center;
        color: #64748b;
        padding: 18px;
    }

        .upload-placeholder i {
            font-size: 3rem;
            color: var(--create-primary);
            opacity: .85;
        }

    .upload-placeholder-title {
        margin: 10px 0 2px;
        font-weight: 900;
        color: var(--create-text);
    }

    .upload-placeholder-sub {
        color: var(--create-muted);
        font-size: .82rem;
    }

    .img-upload-zone .overlay-text {
        position: absolute;
        left: 12px;
        right: 12px;
        bottom: 12px;
        border-radius: 14px;
        background: rgba(15, 23, 42, .78);
        backdrop-filter: blur(10px);
        color: #fff;
        text-align: center;
        padding: 10px 12px;
        font-size: .85rem;
        font-weight: 900;
        z-index: 2;
        display: none;
    }

    .img-upload-zone:hover .overlay-text {
        display: block;
    }

    .gallery-preview-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .sub-img-thumb {
        width: 78px;
        height: 78px;
        object-fit: cover;
        border-radius: 16px;
        border: 2px solid #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .10);
        transition: var(--create-transition);
    }

        .sub-img-thumb:hover {
            transform: scale(1.045);
            border-color: #bfdbfe;
        }

    .wallet-box {
        padding: 14px;
        border-radius: 18px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .submit-area {
        display: grid;
        gap: 10px;
    }

    .btn-submit-property {
        min-height: 52px;
        border-radius: 999px;
        font-weight: 900;
        letter-spacing: .02em;
        box-shadow: 0 14px 28px rgba(37, 99, 235, .20);
    }

    .btn-cancel-property {
        min-height: 46px;
        border-radius: 999px;
        font-weight: 800;
    }

    @@media (max-width: 991.98px) {
        .property-form-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
            border-radius: 22px;
        }

        .property-back-btn {
            width: 100%;
        }

        .sidebar-sticky-card {
            position: static;
        }

        .property-section-body,
        .sidebar-card-body {
            padding: 18px;
        }
    }

    @@media (max-width: 575.98px) {
        .property-form-page {
            padding-bottom: 24px;
        }

        .property-form-hero-left {
            align-items: flex-start;
        }

        .property-form-hero-icon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            font-size: 1.25rem;
        }

        .property-form-title {
            font-size: 1.08rem;
        }

        .property-form-subtitle {
            font-size: .82rem;
        }

        .property-section-head,
        .sidebar-card-head {
            padding: 16px;
        }

        .property-section-body,
        .sidebar-card-body {
            padding: 16px;
        }

        .radio-toolbar {
            display: grid;
            grid-template-columns: 1fr;
        }

            .radio-toolbar label {
                width: 100%;
            }

        .amenity-checkbox label {
            width: 100%;
            justify-content: flex-start;
        }

        .img-upload-zone {
            height: 210px;
        }

        .sub-img-thumb {
            width: 72px;
            height: 72px;
        }
    }
</style>

<div class="property-form-page">
    <div class="property-form-hero">
        <div class="property-form-hero-left">
            <div class="property-form-hero-icon">
                <i class="bi bi-pencil-square"></i>
            </div>
            <div>
                <h4 class="property-form-title">Đăng tin bất động sản mới</h4>
                <p class="property-form-subtitle">
                    Điền đầy đủ thông tin để tin đăng rõ ràng, dễ duyệt và tiếp cận khách hàng tốt hơn.
                </p>
            </div>
        </div>

        <a href="/Property/MyAds" class="property-back-btn">
            <i class="bi bi-arrow-left"></i>
            Trở về
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="frmCreateProp">
        <div class="row g-4 property-layout">
            <div class="col-lg-8">
                <div class="property-section-card">
                    <div class="property-section-head">
                        <div class="property-section-number">1</div>
                        <div>
                            <h5 class="property-section-title">Thông tin cơ bản</h5>
                            <p class="property-section-note">Chọn hình thức, loại bất động sản và mô tả rõ nội dung tin.</p>
                        </div>
                    </div>

                    <div class="property-section-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold d-block">
                                Hình thức giao dịch <span class="required-star">*</span>
                            </label>
                            <div class="radio-toolbar" id="parentTypeContainer">
                                @foreach (var parent in ViewBag.ParentTypes)
                                {
                                    <input type="radio" id="parent_@parent.TypeID" name="ParentTypeSelector" value="@parent.TypeID" onchange="filterSubTypes(this.value)">
                                    <label for="parent_@parent.TypeID">
                                        <i class="bi bi-check-circle"></i>
                                        @parent.TypeName
                                    </label>
                                }
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Loại bất động sản <span class="required-star">*</span>
                                </label>
                                <select asp-for="TypeID" id="subTypeSelect" class="form-select form-select-lg" required>
                                    <option value="">-- Vui lòng chọn Hình thức trước --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Tiêu đề tin đăng <span class="required-star">*</span>
                                </label>
                                <input asp-for="Title" class="form-control form-control-lg" placeholder="Ví dụ: Bán nhà mặt tiền trung tâm Nha Trang..." required />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">
                                    Mô tả chi tiết <span class="required-star">*</span>
                                </label>
                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="7"
                                          placeholder="Mô tả vị trí, tiện ích xung quanh, nội thất, pháp lý, khu dân cư, đường vào, tiềm năng đầu tư..."
                                          required></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="property-section-card">
                    <div class="property-section-head">
                        <div class="property-section-number">2</div>
                        <div>
                            <h5 class="property-section-title">Địa điểm & kích thước</h5>
                            <p class="property-section-note">Thông tin vị trí và diện tích giúp khách tìm kiếm chính xác hơn.</p>
                        </div>
                    </div>

                    <div class="property-section-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Khu vực <span class="required-star">*</span>
                                </label>
                                <select id="areaSelect" class="form-select" asp-items="ViewBag.Areas" onchange="loadWards(this.value)" required>
                                    <option value="">-- Chọn khu vực --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">
                                    Phường / Xã <span class="required-star">*</span>
                                </label>
                                <select asp-for="WardID" id="wardSelect" class="form-select" required>
                                    <option value="">-- Vui lòng chọn Khu vực trước --</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold">Địa chỉ chi tiết</label>
                                <input asp-for="AddressDetail" class="form-control" placeholder="Ví dụ: Số 02 Nguyễn Đình Chiểu" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mức giá</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="Price" type="number" class="form-control" placeholder="Để trống nếu thỏa thuận" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Diện tích đất</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="AreaSize" type="number" step="0.01" class="form-control" placeholder="Ví dụ: 100" />
                                    <span class="input-group-text">m²</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Chiều ngang</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="Width" type="number" step="0.01" class="form-control" placeholder="Ví dụ: 5.5" />
                                    <span class="input-group-text">m</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold">Chiều dài</label>
                                <div class="input-group input-group-modern">
                                    <input asp-for="Length" type="number" step="0.01" class="form-control" placeholder="Ví dụ: 20" />
                                    <span class="input-group-text">m</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="property-section-card">
                    <div class="property-section-head">
                        <div class="property-section-number">3</div>
                        <div>
                            <h5 class="property-section-title">Thông tin chi tiết & tiện ích</h5>
                            <p class="property-section-note">Bổ sung đặc điểm nổi bật để tin đăng chuyên nghiệp hơn.</p>
                        </div>
                    </div>

                    <div class="property-section-body">
                        <div class="row g-3 mb-4">
                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Phòng ngủ</label>
                                    <input type="number"
                                           name="Bedrooms"
                                           class="form-control fw-bold text-center"
                                           placeholder="0"
                                           min="0"
                                           max="20"
                                           value="0" />
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Phòng tắm</label>
                                    <input type="number"
                                           name="Bathrooms"
                                           class="form-control fw-bold text-center"
                                           placeholder="0"
                                           min="0"
                                           max="20"
                                           value="0" />
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Hướng nhà</label>
                                    <select name="Direction" class="form-select">
                                        <option value="">-- Không rõ --</option>
                                        @foreach (var item in huongNhaList)
                                        {
                                            <option value="@item.FeatureName">@item.FeatureName</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3 col-6">
                                <div class="mini-field">
                                    <label class="form-label fw-bold text-muted small text-uppercase">Pháp lý</label>
                                    <select name="LegalStatus" class="form-select">
                                        <option value="">-- Trạng thái --</option>
                                        @foreach (var item in phapLyList)
                                        {
                                            <option value="@item.FeatureName">@item.FeatureName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <label class="form-label fw-bold mb-3 d-block">Tiện ích nổi bật</label>
                        <div class="amenity-checkbox">
                            @if (!tienIchList.Any())
                            {
                                <p class="text-muted small mb-0"><i>Hệ thống chưa cấu hình tiện ích mẫu.</i></p>
                            }
                            else
                            {
                                int count = 1;
                                foreach (var item in tienIchList)
                                {
                                    <input type="checkbox" id="am_@count" name="Amenities" value="@item.FeatureName">
                                    <label for="am_@count">
                                        <i class="bi bi-check2-square"></i>
                                        @item.FeatureName
                                    </label>
                                    count++;
                                }
                            }
                        </div>

                        <label class="form-label fw-bold mb-3 d-block mt-4">Đặc điểm khác</label>
                        <div class="amenity-checkbox">
                            @if (!khacList.Any())
                            {
                                <p class="text-muted small mb-0"><i>Hệ thống chưa cấu hình đặc điểm khác.</i></p>
                            }
                            else
                            {
                                int countKhac = 1;
                                foreach (var item in khacList)
                                {
                                    <input type="checkbox" id="khac_@countKhac" name="Amenities" value="@item.FeatureName">
                                    <label for="khac_@countKhac">
                                        <i class="bi bi-check2-square"></i>
                                        @item.FeatureName
                                    </label>
                                    countKhac++;
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sidebar-sticky-card">
                    <div class="sidebar-card-head">
                        <h5>
                            <i class="bi bi-camera text-primary me-2"></i>
                            Ảnh & gói tin
                        </h5>
                    </div>

                    <div class="sidebar-card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Ảnh đại diện <span class="required-star">*</span>
                            </label>
                            <label for="MainImageFile" class="img-upload-zone w-100 d-block">
                                <div id="uploadPlaceholder" class="upload-placeholder">
                                    <i class="bi bi-cloud-arrow-up"></i>
                                    <p class="upload-placeholder-title">Tải ảnh chính lên</p>
                                    <span class="upload-placeholder-sub">Khuyên dùng tỷ lệ 16:9, ảnh rõ và đẹp.</span>
                                </div>
                                <img id="imgPreview" src="" alt="Ảnh đại diện" />
                                <div class="overlay-text">
                                    <i class="bi bi-pencil-square"></i>
                                    Đổi ảnh khác
                                </div>
                            </label>
                            <input type="file" id="MainImageFile" name="MainImageFile" class="d-none" accept="image/*" onchange="previewImage(event)" required />
                        </div>

                        <div class="mb-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                <label class="form-label fw-bold mb-0">Ảnh phụ</label>
                                <span class="badge rounded-pill text-bg-secondary">Tối đa 10 ảnh</span>
                            </div>

                            <label for="AdditionalImagesFile" class="btn btn-light border w-100 fw-bold text-secondary mb-3 py-2 rounded-4">
                                <i class="bi bi-images me-2 text-primary fs-5 align-middle"></i>
                                Chọn danh sách ảnh phụ
                            </label>
                            <input type="file" id="AdditionalImagesFile" name="AdditionalImages" class="d-none" accept="image/*" multiple onchange="previewGallery(event)" />

                            <div class="gallery-preview-grid" id="galleryPreviewContainer"></div>
                        </div>

                        <div class="mb-4 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                                <label class="form-label fw-bold mb-0 text-dark">
                                    Áp dụng lượt đăng <span class="required-star">*</span>
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill fw-bold" onclick="loadMyPackages()" title="Cập nhật lại ví gói tin">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>

                            <div id="freeGiftAlert" class="alert alert-success bg-opacity-10 border-success border-opacity-25 small mb-3 p-3 rounded-4" style="display: none;">
                                <i class="bi bi-gift-fill text-success fs-5 me-1 align-middle"></i>
                                Bạn đang có <strong class="text-danger" id="freeCountSpan"></strong> lượt đăng <strong>Miễn phí</strong>.
                            </div>

                            <select asp-for="PackageID" id="packageSelect" class="form-select form-select-lg border-primary shadow-sm mb-3 fw-bold text-primary" required>
                                <option value="">Đang tải dữ liệu ví...</option>
                            </select>

                            <div class="wallet-box text-center">
                                <span class="d-block small text-muted mb-2">Hết lượt đăng hoặc muốn hiển thị nổi bật hơn?</span>
                                <a href="/Package/Buy" target="_blank" class="btn btn-warning fw-bold text-dark rounded-pill w-100 shadow-sm">
                                    <i class="bi bi-cart-plus-fill me-1"></i>
                                    Mua thêm gói VIP
                                </a>
                            </div>
                        </div>

                        <div class="submit-area pt-2">
                            <button type="submit" class="btn btn-primary btn-lg btn-submit-property" onclick="clearDraftStorage()">
                                <i class="bi bi-check2-circle me-2"></i>
                                Hoàn tất đăng tin
                            </button>
                            <a href="/Property/MyAds" class="btn btn-light border text-secondary btn-cancel-property">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const subTypesData = @Html.Raw(ViewBag.SubTypesJson);
        const subTypeSelect = document.getElementById('subTypeSelect');

        function filterSubTypes(parentId) {
            subTypeSelect.innerHTML = '<option value="">-- Chọn loại bất động sản --</option>';
            const filteredTypes = subTypesData.filter(t => t.ParentID == parentId);
            filteredTypes.forEach(t => {
                let opt = new Option(t.TypeName, t.TypeID);
                subTypeSelect.add(opt);
            });
        }

        async function loadWards(areaId) {
            const wardSelect = document.getElementById('wardSelect');
            wardSelect.innerHTML = '<option value="">Đang tải...</option>';
            if (!areaId) {
                wardSelect.innerHTML = '<option value="">-- Vui lòng chọn Khu vực trước --</option>';
                return;
            }
            try {
                const response = await fetch(`/Home/GetWardsByArea?areaId=${areaId}`);
                const data = await response.json();
                wardSelect.innerHTML = '<option value="">-- Chọn Phường / Xã --</option>';
                data.forEach(w => wardSelect.add(new Option(w.wardName, w.wardId)));
            } catch (error) {
                wardSelect.innerHTML = '<option value="">Lỗi kết nối</option>';
            }
        }

        function previewImage(event) {
            var reader = new FileReader();
            reader.onload = function() {
                var output = document.getElementById('imgPreview');
                var placeholder = document.getElementById('uploadPlaceholder');
                output.src = reader.result;
                output.style.display = 'block';
                placeholder.style.display = 'none';
            };
            if(event.target.files[0]){
                reader.readAsDataURL(event.target.files[0]);
            }
        }

        function previewGallery(event) {
            const container = document.getElementById('galleryPreviewContainer');
            container.innerHTML = '';

            const files = event.target.files;
            if(files.length > 10) {
                alert('Chỉ được chọn tối đa 10 ảnh phụ!');
                event.target.value = '';
                return;
            }

            for(let i = 0; i < files.length; i++) {
                const file = files[i];
                if(!file.type.startsWith('image/')) continue;

                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'sub-img-thumb shadow-sm border border-2 border-white';
                    container.appendChild(img);
                }
                reader.readAsDataURL(file);
            }
        }

        async function loadMyPackages() {
            const selectEl = document.getElementById('packageSelect');
            const alertGift = document.getElementById('freeGiftAlert');
            const spanCount = document.getElementById('freeCountSpan');

            selectEl.innerHTML = '<option value="">Đang tải dữ liệu ví...</option>';
            try {
                const response = await fetch('/Property/GetAvailablePackages');
                const result = await response.json();

                if (result.success && result.data.length > 0) {
                    selectEl.innerHTML = '<option value="">-- Click để chọn gói đăng --</option>';
                    let totalFreeCount = 0;

                    result.data.forEach(pkg => {
                        let isFree = (pkg.price == 0);
                        let typeLabel = isFree ? "Miễn phí" : "VIP " + pkg.type;
                        let textStr = `[${typeLabel}] ${pkg.name} - (Còn: ${pkg.availableCount} Lượt)`;

                        let option = new Option(textStr, pkg.id);

                        if(isFree) {
                            option.style.color = "#16a34a";
                            option.style.fontWeight = "bold";
                            totalFreeCount += parseInt(pkg.availableCount);
                        } else {
                            option.style.color = "#e81c2e";
                            option.style.fontWeight = "bold";
                        }

                        selectEl.add(option);
                    });

                    if(totalFreeCount > 0) {
                        spanCount.innerText = totalFreeCount;
                        alertGift.style.display = 'block';
                    } else {
                        alertGift.style.display = 'none';
                    }

                } else {
                    selectEl.innerHTML = '<option value="">Ví của bạn đã hết lượt đăng. Vui lòng mua thêm!</option>';
                    alertGift.style.display = 'none';
                }
            } catch (error) {
                selectEl.innerHTML = '<option value="">Lỗi tải dữ liệu gói</option>';
                alertGift.style.display = 'none';
            }
        }

        const FORM_STORAGE_KEY = "bds_draft_form";

        function saveFormDraft() {
            const form = document.getElementById('frmCreateProp');
            const formData = new FormData(form);
            let obj = {};

            for (let [key, value] of formData.entries()) {
                if(key !== "MainImageFile" && key !== "AdditionalImages" && !key.includes("RequestVerificationToken")) {
                    if(obj[key] !== undefined) {
                        if(!Array.isArray(obj[key])) obj[key] = [obj[key]];
                        obj[key].push(value);
                    } else {
                        obj[key] = value;
                    }
                }
            }
            localStorage.setItem(FORM_STORAGE_KEY, JSON.stringify(obj));
        }

        function restoreFormDraft() {
            const draft = localStorage.getItem(FORM_STORAGE_KEY);
            if (!draft) return;
            const obj = JSON.parse(draft);

            for (let key in obj) {
                const inputList = document.querySelectorAll(`[name="${key}"]`);
                if (!inputList || inputList.length === 0) continue;

                const input = inputList[0];
                if (input.type === 'radio' || input.type === 'checkbox') {
                    let values = Array.isArray(obj[key]) ? obj[key] : [obj[key]];
                    inputList.forEach(el => { el.checked = values.includes(el.value); });
                } else {
                    input.value = obj[key];
                }
            }

            const selectedRadio = document.querySelector('input[name="ParentTypeSelector"]:checked');
            if (selectedRadio) {
                filterSubTypes(selectedRadio.value);
                if (obj["TypeID"]) document.getElementById('subTypeSelect').value = obj["TypeID"];
            }

            const areaSelect = document.getElementById('areaSelect');
            if(areaSelect && areaSelect.value) {
                loadWards(areaSelect.value).then(() => {
                    if (obj["WardID"]) document.getElementById('wardSelect').value = obj["WardID"];
                });
            }
        }

        function clearDraftStorage() {
            localStorage.removeItem(FORM_STORAGE_KEY);
        }

        document.addEventListener("DOMContentLoaded", () => {
            loadMyPackages();
            restoreFormDraft();

            const formElement = document.getElementById('frmCreateProp');
            formElement.addEventListener('input', saveFormDraft);
            formElement.addEventListener('change', saveFormDraft);

            const firstRadio = document.querySelector('input[name="ParentTypeSelector"]');
            const checkedRadio = document.querySelector('input[name="ParentTypeSelector"]:checked');
            if(firstRadio && !checkedRadio) firstRadio.click();
        });
    </script>
}