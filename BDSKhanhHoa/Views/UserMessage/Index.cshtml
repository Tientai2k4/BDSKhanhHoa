@model IEnumerable<BDSKhanhHoa.Models.UserMessage>
@{
    Layout = null;
    ViewData["Title"] = "Hộp thư tư vấn";

    int currentUserId = ViewBag.CurrentUserId ?? 0;
    string openReceiverId = Convert.ToString(ViewBag.OpenReceiverId ?? "");
    string openPropertyId = Convert.ToString(ViewBag.OpenPropertyId ?? "");

    string NameOf(BDSKhanhHoa.Models.User? user)
    {
        return user?.FullName ?? user?.Username ?? "Người dùng";
    }

    string AvatarOf(BDSKhanhHoa.Models.User? user)
    {
        return string.IsNullOrWhiteSpace(user?.Avatar)
            ? "/images/avatars/default-user.png"
            : user!.Avatar!;
    }

    string PreviewOf(BDSKhanhHoa.Models.UserMessage message)
    {
        if (message.MessageType == "Image") return "[Ảnh] Người dùng đã gửi hình ảnh";
        if (message.MessageType == "File") return "[Tệp] Người dùng đã gửi tài liệu";

        return string.IsNullOrWhiteSpace(message.MessageContent)
            ? "Không có nội dung"
            : message.MessageContent!;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - BĐS Khánh Hòa</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --chat-primary: #2563eb;
            --chat-primary-dark: #1d4ed8;
            --chat-success: #16a34a;
            --chat-danger: #dc2626;
            --chat-warning: #f97316;
            --chat-dark: #0f172a;
            --chat-muted: #64748b;
            --chat-soft: #f8fafc;
            --chat-soft-2: #f1f5f9;
            --chat-border: #e2e8f0;
            --chat-border-2: #cbd5e1;
            --chat-card: #ffffff;
            --chat-shadow: 0 22px 60px rgba(15, 23, 42, .10);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: radial-gradient(circle at top left, rgba(37, 99, 235, .13), transparent 28rem), radial-gradient(circle at bottom right, rgba(14, 165, 233, .10), transparent 28rem), #eef4ff;
            color: var(--chat-dark);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
        }

        button,
        input,
        textarea,
        select {
            font-family: inherit;
        }

        .chat-page {
            width: 100%;
            height: 100dvh;
            padding: 14px;
            overflow: hidden;
        }

        .chat-shell {
            width: 100%;
            height: calc(100dvh - 28px);
            min-height: 0;
            display: grid;
            grid-template-columns: 365px minmax(0, 1fr);
            background: #fff;
            border: 1px solid var(--chat-border);
            border-radius: 26px;
            box-shadow: var(--chat-shadow);
            overflow: hidden;
        }

        .chat-left {
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--chat-border);
            background: #f8fafc;
        }

        .chat-left-head {
            flex: 0 0 auto;
            padding: 16px;
            background: rgba(255, 255, 255, .98);
            border-bottom: 1px solid var(--chat-border);
        }

        .chat-title-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

            .chat-title-row h5 {
                margin: 0;
                color: var(--chat-dark);
                font-size: 1.05rem;
                line-height: 1.25;
                font-weight: 900;
                letter-spacing: -.02em;
            }

        .chat-count {
            flex: 0 0 auto;
            min-height: 28px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #eff6ff;
            color: var(--chat-primary);
            border: 1px solid #bfdbfe;
            padding: 5px 10px;
            font-size: .72rem;
            font-weight: 900;
            white-space: nowrap;
        }

        .chat-search {
            position: relative;
            margin-top: 12px;
        }

            .chat-search i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 1rem;
            }

            .chat-search input {
                width: 100%;
                height: 44px;
                border: 1px solid var(--chat-border);
                background: #fff;
                border-radius: 15px;
                padding: 0 14px 0 42px;
                color: var(--chat-dark);
                font-size: .9rem;
                font-weight: 700;
                outline: 0;
                transition: .18s ease;
            }

                .chat-search input:focus {
                    border-color: #93c5fd;
                    box-shadow: 0 0 0 4px rgba(37, 99, 235, .08);
                }

        .conversation-list {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px;
        }

            .conversation-list::-webkit-scrollbar,
            .chat-messages::-webkit-scrollbar,
            .quick-replies::-webkit-scrollbar {
                width: 7px;
            }

            .conversation-list::-webkit-scrollbar-thumb,
            .chat-messages::-webkit-scrollbar-thumb,
            .quick-replies::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 999px;
            }

        .conversation-item {
            width: 100%;
            min-width: 0;
            display: flex;
            gap: 11px;
            text-align: left;
            border: 1px solid transparent;
            background: transparent;
            color: #334155;
            padding: 11px;
            border-radius: 17px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: .18s ease;
        }

            .conversation-item:hover,
            .conversation-item.active {
                background: #fff;
                border-color: var(--chat-border);
                box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
            }

            .conversation-item.active {
                background: #eff6ff;
                border-color: #bfdbfe;
                box-shadow: inset 4px 0 0 var(--chat-primary), 0 10px 24px rgba(37, 99, 235, .08);
            }

        .cv-avatar {
            width: 50px;
            height: 50px;
            flex: 0 0 auto;
            border-radius: 17px;
            object-fit: cover;
            background: #e2e8f0;
            border: 2px solid #fff;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .08);
        }

        .cv-info {
            flex: 1 1 auto;
            min-width: 0;
        }

        .cv-name {
            display: block;
            color: var(--chat-dark);
            font-size: .92rem;
            font-weight: 900;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cv-property {
            display: block;
            margin-top: 3px;
            color: var(--chat-primary);
            font-size: .77rem;
            font-weight: 850;
            line-height: 1.35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cv-preview {
            display: block;
            margin-top: 3px;
            color: var(--chat-muted);
            font-size: .8rem;
            font-weight: 600;
            line-height: 1.35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cv-time {
            display: block;
            margin-top: 5px;
            color: #94a3b8;
            font-size: .7rem;
            font-weight: 800;
        }

        .cv-role {
            display: inline-flex;
            margin-top: 5px;
            min-height: 23px;
            align-items: center;
            border-radius: 999px;
            padding: 0 8px;
            font-size: .65rem;
            font-weight: 900;
            background: #ecfdf5;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

            .cv-role.seller {
                background: #eff6ff;
                color: #1d4ed8;
                border-color: #bfdbfe;
            }

        .chat-right {
            position: relative;
            min-width: 0;
            min-height: 0;
            display: flex;
            flex-direction: column;
            background: #fff;
            overflow: hidden;
        }

        .empty-chat {
            height: 100%;
            display: grid;
            place-items: center;
            text-align: center;
            padding: 30px;
            background: radial-gradient(circle at center, rgba(37, 99, 235, .08), transparent 38%), #fff;
        }

            .empty-chat i {
                font-size: 4rem;
                color: #bfdbfe;
                margin-bottom: 12px;
            }

            .empty-chat h4 {
                color: var(--chat-dark);
                font-size: 1.25rem;
                font-weight: 900;
                margin: 0 0 7px;
            }

            .empty-chat p {
                max-width: 420px;
                margin: 0 auto;
                color: var(--chat-muted);
                font-size: .92rem;
                font-weight: 600;
                line-height: 1.55;
            }

        .active-chat {
            display: none;
            height: 100%;
            min-height: 0;
            flex-direction: column;
            overflow: hidden;
        }

        .chat-header {
            flex: 0 0 auto;
            min-width: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 13px 15px;
            background: #fff;
            border-bottom: 1px solid var(--chat-border);
            z-index: 5;
        }

        .chat-head-main {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .btn-back-mobile {
            display: none;
            width: 40px;
            height: 40px;
            flex: 0 0 auto;
            border: 0;
            border-radius: 13px;
            background: #f1f5f9;
            color: var(--chat-dark);
            font-size: 1.15rem;
        }

        .head-avatar {
            width: 46px;
            height: 46px;
            flex: 0 0 auto;
            border-radius: 16px;
            object-fit: cover;
            background: #e2e8f0;
            border: 2px solid #fff;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .09);
        }

        .head-info {
            min-width: 0;
        }

        .head-name {
            color: var(--chat-dark);
            font-size: .96rem;
            font-weight: 900;
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .head-sub {
            margin-top: 2px;
            color: var(--chat-muted);
            font-size: .76rem;
            font-weight: 800;
            line-height: 1.35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .head-property {
            flex: 0 1 340px;
            max-width: 340px;
            min-width: 0;
            text-align: right;
        }

        .head-property-title {
            color: var(--chat-primary);
            font-size: .82rem;
            font-weight: 900;
            line-height: 1.35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .head-price {
            color: var(--chat-danger);
            font-size: .9rem;
            font-weight: 900;
            line-height: 1.35;
        }

        .head-actions {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .btn-chat-action {
            min-height: 38px;
            border-radius: 13px;
            padding: 0 11px;
            border: 1px solid var(--chat-border);
            background: #fff;
            color: #334155;
            font-size: .8rem;
            font-weight: 900;
            white-space: nowrap;
        }

            .btn-chat-action.report {
                color: #b91c1c;
                background: #fef2f2;
                border-color: #fecaca;
            }

            .btn-chat-action.delete {
                color: #475569;
                background: #f8fafc;
            }

            .btn-chat-action:hover {
                filter: brightness(.98);
            }

        .safety-box {
            display: none;
            position: absolute;
            top: 76px;
            left: 16px;
            right: 16px;
            z-index: 10;
            border: 1px solid #fed7aa;
            background: #fff7ed;
            color: #9a3412;
            border-radius: 16px;
            padding: 11px 13px;
            box-shadow: 0 16px 38px rgba(249, 115, 22, .16);
            font-size: .84rem;
            font-weight: 700;
            line-height: 1.5;
        }

            .safety-box.show {
                display: flex;
                gap: 9px;
                align-items: flex-start;
            }

            .safety-box i {
                color: #ea580c;
                font-size: 1.15rem;
                margin-top: 1px;
            }

        .chat-messages {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background: #f8fafc;
        }

        .message-row {
            display: flex;
            gap: 9px;
            max-width: min(78%, 760px);
        }

            .message-row.mine {
                align-self: flex-end;
                flex-direction: row-reverse;
            }

            .message-row.theirs {
                align-self: flex-start;
            }

        .message-avatar {
            width: 30px;
            height: 30px;
            flex: 0 0 auto;
            border-radius: 11px;
            object-fit: cover;
            background: #e2e8f0;
            margin-top: 17px;
        }

        .message-body {
            min-width: 0;
        }

        .message-label {
            margin-bottom: 4px;
            color: var(--chat-muted);
            font-size: .7rem;
            font-weight: 900;
            line-height: 1.25;
        }

        .message-row.mine .message-label {
            color: var(--chat-primary);
            text-align: right;
        }

        .message-bubble {
            max-width: 100%;
            padding: 11px 14px;
            border-radius: 17px;
            font-size: .9rem;
            line-height: 1.55;
            font-weight: 650;
            word-break: break-word;
            white-space: pre-wrap;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .06);
        }

        .message-row.mine .message-bubble {
            background: linear-gradient(135deg, var(--chat-primary), var(--chat-primary-dark));
            color: #fff;
            border-bottom-right-radius: 6px;
        }

        .message-row.theirs .message-bubble {
            background: #fff;
            color: #334155;
            border: 1px solid var(--chat-border);
            border-bottom-left-radius: 6px;
        }

        .message-time {
            margin-top: 5px;
            color: #94a3b8;
            font-size: .68rem;
            font-weight: 800;
        }

        .message-row.mine .message-time {
            text-align: right;
        }

        .message-image {
            max-width: min(320px, 70vw);
            border-radius: 17px;
            border: 2px solid #fff;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .12);
        }

        .message-file {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            border: 1px solid #1d4ed8;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff !important;
            padding: 11px 13px;
            border-radius: 15px;
            font-size: .86rem;
            font-weight: 900;
            text-decoration: none;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .22);
        }

            .message-file:hover {
                color: #fff !important;
                background: linear-gradient(135deg, #1d4ed8, #1e40af);
            }

            .message-file i {
                color: #fff !important;
            }

        .message-row.mine .message-file {
            background: linear-gradient(135deg, #0f172a, #334155);
            color: #fff !important;
            border-color: #334155;
        }

        .quick-replies {
            flex: 0 0 auto;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 8px;
            padding: 9px 14px;
            border-top: 1px solid var(--chat-border);
            background: #fff;
            max-height: 92px;
            overflow-y: auto;
        }

            .quick-replies button {
                min-width: 0;
                min-height: 36px;
                border: 1px solid #cbd5e1;
                background: #fff;
                color: var(--chat-primary);
                border-radius: 13px;
                padding: 7px 9px;
                font-size: .76rem;
                font-weight: 900;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                transition: .18s ease;
            }

                .quick-replies button:hover {
                    background: #eff6ff;
                    border-color: #93c5fd;
                }

        .file-preview {
            display: none;
            flex: 0 0 auto;
            padding: 8px 15px;
            background: #eff6ff;
            border-top: 1px solid #bfdbfe;
            color: #1e40af;
            font-size: .8rem;
            font-weight: 850;
        }

        .chat-input-area {
            flex: 0 0 auto;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 11px 15px;
            border-top: 1px solid var(--chat-border);
            background: #fff;
        }

        .btn-tool,
        .btn-send {
            width: 41px;
            height: 41px;
            flex: 0 0 auto;
            border: 0;
            border-radius: 14px;
            display: grid;
            place-items: center;
            font-size: 1.05rem;
        }

        .btn-tool {
            background: #f1f5f9;
            color: #475569;
        }

            .btn-tool:hover {
                background: #e2e8f0;
                color: var(--chat-dark);
            }

        .chat-input {
            flex: 1 1 auto;
            min-width: 0;
            height: 41px;
            border: 1px solid var(--chat-border);
            background: #f8fafc;
            border-radius: 14px;
            padding: 0 13px;
            color: var(--chat-dark);
            font-size: .9rem;
            font-weight: 700;
            outline: 0;
            transition: .18s ease;
        }

            .chat-input:focus {
                background: #fff;
                border-color: #93c5fd;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .08);
            }

        .btn-send {
            background: linear-gradient(135deg, var(--chat-primary), var(--chat-primary-dark));
            color: #fff;
        }

            .btn-send:hover {
                filter: brightness(.97);
            }

        .toast-box {
            display: none;
            position: fixed;
            right: 18px;
            bottom: 18px;
            z-index: 3000;
            max-width: 360px;
            border-radius: 16px;
            padding: 12px 14px;
            background: #0f172a;
            color: #fff;
            font-size: .88rem;
            font-weight: 750;
            box-shadow: 0 20px 50px rgba(15, 23, 42, .25);
        }

            .toast-box.show {
                display: block;
            }

            .toast-box.ok {
                background: #166534;
            }

            .toast-box.err {
                background: #991b1b;
            }

        .fw-black {
            font-weight: 900;
        }

        @@media (max-width: 1199.98px) {
            .chat-shell {
                grid-template-columns: 340px minmax(0, 1fr);
            }

            .head-property {
                max-width: 260px;
            }
        }

        @@media (max-width: 991.98px) {
            .chat-page {
                padding: 8px;
            }

            .chat-shell {
                height: calc(100dvh - 16px);
                grid-template-columns: 1fr;
                border-radius: 22px;
            }

            .chat-left {
                width: 100%;
                border-right: 0;
            }

            .chat-right {
                position: absolute;
                inset: 0;
                z-index: 20;
                width: 100%;
                transform: translateX(100%);
                transition: transform .25s ease;
            }

                .chat-right.mobile-active {
                    transform: translateX(0);
                }

            .btn-back-mobile {
                display: grid;
                place-items: center;
            }

            .head-property {
                display: none;
            }

            .message-row {
                max-width: 88%;
            }

            .quick-replies {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 575.98px) {
            .chat-page {
                padding: 0;
            }

            .chat-shell {
                height: 100dvh;
                border: 0;
                border-radius: 0;
            }

            .chat-left-head {
                padding: 12px;
            }

            .chat-title-row h5 {
                font-size: .98rem;
            }

            .chat-count {
                font-size: .66rem;
                padding: 4px 8px;
            }

            .conversation-list {
                padding: 8px;
            }

            .conversation-item {
                padding: 10px;
                border-radius: 15px;
            }

            .cv-avatar {
                width: 46px;
                height: 46px;
                border-radius: 15px;
            }

            .chat-header {
                padding: 9px;
                gap: 8px;
            }

            .head-avatar {
                width: 41px;
                height: 41px;
                border-radius: 14px;
            }

            .head-name {
                font-size: .9rem;
            }

            .head-sub {
                max-width: 190px;
                font-size: .72rem;
            }

            .btn-chat-action {
                min-height: 36px;
                padding: 0 9px;
                font-size: .75rem;
            }

                .btn-chat-action.report span {
                    display: none;
                }

            .safety-box {
                top: 66px;
                left: 10px;
                right: 10px;
                font-size: .78rem;
                border-radius: 14px;
            }

            .chat-messages {
                padding: 11px;
                gap: 11px;
            }

            .message-avatar {
                display: none;
            }

            .message-row {
                max-width: 94%;
            }

            .message-bubble {
                padding: 10px 12px;
                font-size: .86rem;
            }

            .quick-replies {
                grid-template-columns: 1fr;
                max-height: 103px;
                padding: 8px 10px;
                gap: 7px;
            }

                .quick-replies button {
                    min-height: 34px;
                    font-size: .74rem;
                }

            .chat-input-area {
                padding: 8px;
                gap: 7px;
            }

            .btn-tool,
            .btn-send {
                width: 38px;
                height: 38px;
                border-radius: 13px;
            }

            .chat-input {
                height: 38px;
                border-radius: 13px;
                font-size: .86rem;
            }
        }
    </style>
</head>

<body>
    <div class="chat-page">
        @Html.AntiForgeryToken()

        <div class="chat-shell">
            <aside class="chat-left">
                <div class="chat-left-head">
                    <div class="chat-title-row">
                        <h5>
                            <i class="bi bi-chat-dots-fill text-primary me-1"></i>
                            Hộp thư tư vấn
                        </h5>
                        <span class="chat-count">@Model.Count() cuộc trò chuyện</span>
                    </div>

                    <div class="chat-search">
                        <i class="bi bi-search"></i>
                        <input id="searchBox" placeholder="Tìm theo tên, tin đăng, nội dung..." />
                    </div>
                </div>

                <div class="conversation-list" id="conversationList">
                    @if (!Model.Any())
                    {
                        <div class="text-center p-4 text-secondary fw-bold">
                            Chưa có cuộc trò chuyện nào.
                        </div>
                    }

                    @foreach (var m in Model)
                    {
                        var partner = m.SenderID == currentUserId ? m.Receiver : m.Sender;
                        int partnerId = m.SenderID == currentUserId ? m.ReceiverID : m.SenderID;
                        bool isSeller = m.Property?.UserID == currentUserId;

                        <button type="button"
                                class="conversation-item"
                                data-partner-id="@partnerId"
                                data-property-id="@m.PropertyID"
                                data-search="@(NameOf(partner) + " " + (m.Property?.Title ?? "") + " " + PreviewOf(m)).ToLower()">
                            <img class="cv-avatar" src="@AvatarOf(partner)" alt="Ảnh đại diện" />

                            <span class="cv-info">
                                <span class="cv-name">@NameOf(partner)</span>
                                <span class="cv-property">@m.Property?.Title</span>
                                <span class="cv-preview">@PreviewOf(m)</span>
                                <span class="cv-time">@m.CreatedAt.ToString("HH:mm dd/MM/yyyy")</span>
                                <span class="cv-role @(isSeller ? "seller" : "")">
                                    @(isSeller ? "Bạn là người bán" : "Bạn là người mua")
                                </span>
                            </span>
                        </button>
                    }
                </div>
            </aside>

            <main class="chat-right" id="rightPanel">
                <div class="empty-chat" id="emptyChat">
                    <div>
                        <i class="bi bi-shield-check"></i>
                        <h4>Chọn một cuộc trò chuyện</h4>
                        <p>
                            Không chuyển tiền, đặt cọc hoặc cung cấp mã OTP khi chưa xác minh thông tin người nhận.
                        </p>
                    </div>
                </div>

                <section class="active-chat" id="activeChat">
                    <div class="chat-header">
                        <div class="chat-head-main">
                            <button class="btn-back-mobile" id="btnBack" type="button">
                                <i class="bi bi-chevron-left"></i>
                            </button>

                            <img class="head-avatar" id="headAvatar" src="/images/avatars/default-user.png" alt="Ảnh đại diện" />

                            <div class="head-info">
                                <div class="head-name" id="headName">Người dùng</div>
                                <div class="head-sub" id="headSub">Đang tải...</div>
                            </div>
                        </div>

                        <div class="head-property">
                            <div class="head-property-title" id="headProperty">Bất động sản</div>
                            <div class="head-price" id="headPrice">Đang cập nhật</div>
                        </div>

                        <div class="head-actions">
                            <button type="button" class="btn-chat-action report" id="btnOpenReport">
                                <i class="bi bi-flag-fill"></i>
                                <span>Báo cáo</span>
                            </button>

                            <button type="button" class="btn-chat-action delete" id="btnDelete" title="Xóa cuộc trò chuyện khỏi hộp thư">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>

                    <div class="safety-box" id="safetyBox">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <div>
                            <b>Cảnh báo an toàn:</b>
                            Không đặt cọc, chuyển tiền, gửi mã OTP hoặc giấy tờ cá nhân qua tin nhắn.
                            Hãy kiểm tra pháp lý, gặp trực tiếp và xác minh chủ thể trước mọi giao dịch.
                        </div>
                    </div>

                    <div class="chat-messages" id="messages"></div>

                    <div class="quick-replies">
                        <button type="button" data-text="Bất động sản này còn không ạ?">
                            BĐS này còn không?
                        </button>

                        <button type="button" data-text="Tôi muốn xem nhà trực tiếp, mình hẹn lịch được không?">
                            Hẹn xem trực tiếp
                        </button>

                        <button type="button" data-text="Bạn cho tôi xin thêm thông tin pháp lý và vị trí chính xác được không?">
                            Hỏi pháp lý/vị trí
                        </button>
                    </div>

                    <div class="file-preview" id="filePreview"></div>

                    <form class="chat-input-area" id="sendForm" enctype="multipart/form-data">
                        <input type="hidden" name="receiverId" id="receiverId" />
                        <input type="hidden" name="propertyId" id="propertyId" />
                        <input type="file" name="attachment" id="attachment" hidden />

                        <button type="button" class="btn-tool" id="btnAttach" title="Đính kèm tệp">
                            <i class="bi bi-paperclip"></i>
                        </button>

                        <input class="chat-input"
                               name="messageContent"
                               id="messageInput"
                               maxlength="3000"
                               autocomplete="off"
                               placeholder="Nhập tin nhắn..." />

                        <button type="submit" class="btn-send" title="Gửi tin nhắn">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </form>
                </section>
            </main>
        </div>
    </div>

    <div class="modal fade" id="reportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content border-0 rounded-4" id="reportForm">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-black">
                        <i class="bi bi-flag-fill text-danger me-1"></i>
                        Báo cáo cuộc trò chuyện
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="reportedUserId" id="reportedUserId" />
                    <input type="hidden" name="propertyId" id="reportPropertyId" />

                    <label class="form-label fw-bold">Lý do báo cáo</label>
                    <select class="form-select rounded-3 fw-semibold" name="reason" required>
                        <option value="Lừa đảo, yêu cầu đặt cọc/chuyển tiền đáng ngờ">
                            Lừa đảo, yêu cầu đặt cọc/chuyển tiền đáng ngờ
                        </option>
                        <option value="Spam hoặc quảng cáo không phù hợp">
                            Spam hoặc quảng cáo không phù hợp
                        </option>
                        <option value="Ngôn từ xúc phạm, quấy rối">
                            Ngôn từ xúc phạm, quấy rối
                        </option>
                        <option value="Gửi thông tin sai sự thật">
                            Gửi thông tin sai sự thật
                        </option>
                        <option value="Khác">
                            Khác
                        </option>
                    </select>

                    <label class="form-label fw-bold mt-3">Mô tả thêm</label>
                    <textarea class="form-control rounded-3"
                              name="description"
                              rows="4"
                              maxlength="2000"
                              placeholder="Ghi rõ nội dung vi phạm, thời điểm, dấu hiệu đáng ngờ..."></textarea>

                    <div class="alert alert-warning mt-3 mb-0 rounded-3 small fw-semibold">
                        Báo cáo sẽ gửi cho Admin/Staff xem lịch sử tin nhắn làm căn cứ xử lý.
                        Không gửi báo cáo sai sự thật.
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill fw-bold" data-bs-dismiss="modal">
                        Đóng
                    </button>

                    <button type="submit" class="btn btn-danger rounded-pill fw-bold">
                        Gửi báo cáo
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="toast-box" id="toastBox"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : "";

        const currentUserId = @currentUserId;
        const openReceiverId = '@openReceiverId';
        const openPropertyId = '@openPropertyId';

        let activePartnerId = 0;
        let activePropertyId = 0;
        let safetyTimer = null;

        const reportModalElement = document.getElementById('reportModal');
        const reportModal = new bootstrap.Modal(reportModalElement);

        function toast(message, ok = true) {
            const box = document.getElementById('toastBox');

            box.textContent = message || 'Đã xử lý.';
            box.className = 'toast-box show ' + (ok ? 'ok' : 'err');

            setTimeout(() => {
                box.className = 'toast-box';
                box.textContent = '';
            }, 3200);
        }

        function showSafety() {
            const box = document.getElementById('safetyBox');

            box.classList.add('show');
            clearTimeout(safetyTimer);

            safetyTimer = setTimeout(() => {
                box.classList.remove('show');
            }, 6500);
        }

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>'"]/g, function (char) {
                return {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    "'": '&#39;',
                    '"': '&quot;'
                }[char];
            });
        }

        function renderMessage(message) {
            const side = message.isMine ? 'mine' : 'theirs';

            let contentHtml = '';

            if (message.messageType === 'Image' && message.attachmentUrl) {
                contentHtml = `<img class="message-image" src="${message.attachmentUrl}" alt="Ảnh trong tin nhắn" />`;
            }
            else if (message.messageType === 'File' && message.attachmentUrl) {
                contentHtml = `
                    <a class="message-file" href="${message.attachmentUrl}" target="_blank">
                        <i class="bi bi-file-earmark-arrow-down"></i>
                        Tệp đính kèm
                    </a>`;
            }
            else {
                contentHtml = `<div class="message-bubble">${escapeHtml(message.messageContent || '')}</div>`;
            }

            return `
                <div class="message-row ${side}">
                    <img class="message-avatar" src="${message.senderAvatar || '/images/avatars/default-user.png'}" alt="Ảnh đại diện" />
                    <div class="message-body">
                        <div class="message-label">${escapeHtml(message.directionText || message.senderName || '')}</div>
                        ${contentHtml}
                        <div class="message-time">${escapeHtml(message.time || '')}</div>
                    </div>
                </div>`;
        }

        async function openChat(partnerId, propertyId) {
            activePartnerId = Number(partnerId);
            activePropertyId = Number(propertyId);

            document.getElementById('receiverId').value = activePartnerId;
            document.getElementById('propertyId').value = activePropertyId;

            document.getElementById('reportedUserId').value = activePartnerId;
            document.getElementById('reportPropertyId').value = activePropertyId;

            document.getElementById('emptyChat').style.display = 'none';
            document.getElementById('activeChat').style.display = 'flex';
            document.getElementById('rightPanel').classList.add('mobile-active');

            showSafety();

            document.querySelectorAll('.conversation-item').forEach(item => {
                const isActive = item.dataset.partnerId == partnerId && item.dataset.propertyId == propertyId;
                item.classList.toggle('active', isActive);
            });

            try {
                const headerResponse = await fetch(`/UserMessage/GetChatHeader?partnerId=${partnerId}&propertyId=${propertyId}`);

                if (!headerResponse.ok) {
                    toast('Không tải được thông tin cuộc trò chuyện.', false);
                    return;
                }

                const header = await headerResponse.json();

                document.getElementById('headAvatar').src = header.partnerAvatar || '/images/avatars/default-user.png';
                document.getElementById('headName').textContent = header.partnerName || 'Người dùng';
                document.getElementById('headSub').textContent = header.currentRoleText || '';
                document.getElementById('headProperty').textContent = header.propertyTitle || 'Bất động sản';
                document.getElementById('headPrice').textContent = header.propertyPrice || 'Đang cập nhật';

                const historyResponse = await fetch(`/UserMessage/GetChatHistory?partnerId=${partnerId}&propertyId=${propertyId}`);

                if (!historyResponse.ok) {
                    toast('Không tải được lịch sử tin nhắn.', false);
                    return;
                }

                const data = await historyResponse.json();
                const messagesBox = document.getElementById('messages');

                if (data.length > 0) {
                    messagesBox.innerHTML = data.map(renderMessage).join('');
                }
                else {
                    messagesBox.innerHTML = '<div class="text-center text-secondary fw-bold p-4">Chưa có tin nhắn.</div>';
                }

                messagesBox.scrollTop = messagesBox.scrollHeight;
            }
            catch {
                toast('Có lỗi khi tải cuộc trò chuyện.', false);
            }
        }

        document.querySelectorAll('.conversation-item').forEach(button => {
            button.addEventListener('click', function () {
                openChat(this.dataset.partnerId, this.dataset.propertyId);
            });
        });

        document.getElementById('btnBack').addEventListener('click', function () {
            document.getElementById('rightPanel').classList.remove('mobile-active');
        });

        document.getElementById('btnAttach').addEventListener('click', function () {
            document.getElementById('attachment').click();
        });

        document.getElementById('attachment').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('filePreview');

            if (file) {
                preview.style.display = 'block';
                preview.textContent = 'Đã chọn: ' + file.name;
            }
            else {
                preview.style.display = 'none';
                preview.textContent = '';
            }
        });

        document.querySelectorAll('.quick-replies button').forEach(button => {
            button.addEventListener('click', function () {
                document.getElementById('messageInput').value = this.dataset.text || '';
                document.getElementById('messageInput').focus();
            });
        });

        document.getElementById('searchBox').addEventListener('input', function () {
            const keyword = this.value.trim().toLowerCase();

            document.querySelectorAll('.conversation-item').forEach(item => {
                const searchText = item.dataset.search || '';
                item.style.display = searchText.includes(keyword) ? 'flex' : 'none';
            });
        });

        document.getElementById('btnOpenReport').addEventListener('click', function () {
            if (!activePartnerId || !activePropertyId) {
                toast('Vui lòng chọn cuộc trò chuyện cần báo cáo.', false);
                return;
            }

            reportModal.show();
        });

        document.getElementById('sendForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            if (!activePartnerId || !activePropertyId) {
                toast('Vui lòng chọn cuộc trò chuyện.', false);
                return;
            }

            const messageInput = document.getElementById('messageInput');
            const attachmentInput = document.getElementById('attachment');

            if (!messageInput.value.trim() && attachmentInput.files.length === 0) {
                toast('Vui lòng nhập tin nhắn hoặc chọn tệp đính kèm.', false);
                return;
            }

            const formData = new FormData(this);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/UserMessage/SendMessage', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                if (!result.success) {
                    toast(result.message || 'Gửi tin nhắn thất bại.', false);
                    return;
                }

                messageInput.value = '';
                attachmentInput.value = '';

                const filePreview = document.getElementById('filePreview');
                filePreview.style.display = 'none';
                filePreview.textContent = '';

                await openChat(activePartnerId, activePropertyId);
            }
            catch {
                toast('Có lỗi khi gửi tin nhắn.', false);
            }
        });

        document.getElementById('reportForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            if (!activePartnerId || !activePropertyId) {
                toast('Vui lòng chọn cuộc trò chuyện cần báo cáo.', false);
                return;
            }

            const formData = new FormData(this);
            formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/UserMessage/ReportConversation', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                toast(result.message || (result.success ? 'Đã gửi báo cáo.' : 'Không gửi được báo cáo.'), !!result.success);

                if (result.success) {
                    reportModal.hide();
                }
            }
            catch {
                toast('Có lỗi khi gửi báo cáo.', false);
            }
        });

        document.getElementById('btnDelete').addEventListener('click', async function () {
            if (!activePartnerId || !activePropertyId) {
                toast('Vui lòng chọn cuộc trò chuyện cần xóa.', false);
                return;
            }

            const ok = confirm('Bạn muốn xóa cuộc trò chuyện khỏi hộp thư của mình? Hệ thống vẫn lưu lịch sử để phục vụ xử lý vi phạm khi cần.');

            if (!ok) return;

            const formData = new FormData();
            formData.append('__RequestVerificationToken', token);
            formData.append('partnerId', activePartnerId);
            formData.append('propertyId', activePropertyId);

            try {
                const response = await fetch('/UserMessage/DeleteConversationForMe', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();

                toast(result.message || 'Đã xử lý.', !!result.success);

                if (result.success) {
                    setTimeout(() => location.reload(), 800);
                }
            }
            catch {
                toast('Có lỗi khi xóa cuộc trò chuyện.', false);
            }
        });

        if (openReceiverId && openPropertyId) {
            const target = document.querySelector(`.conversation-item[data-partner-id="${openReceiverId}"][data-property-id="${openPropertyId}"]`);

            if (target) {
                openChat(openReceiverId, openPropertyId);
            }
        }
    </script>
</body>
</html>