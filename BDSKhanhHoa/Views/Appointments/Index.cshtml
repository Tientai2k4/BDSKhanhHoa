        background: #ecfdf5;
        border: 1px solid #bbf7d0;
        color: #065f46;
        font-size: .8rem;
        font-weight: 750;
        line-height: 1.55;
    }

    .staff-box-title {
        font-weight: 950;
        color: #047857;
        margin-bottom: 4px;
    }

    .ket-qua-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid var(--lich-border);
        color: #334155;
        font-size: .76rem;
        font-weight: 850;
    }

    .action-stack {
        display: grid;
        gap: 8px;
        width: 100%;
        max-width: 230px;
        margin: 0 auto;
    }

    .nut-thao-tac, .btn-more-action {
        border-radius: 12px;
        font-weight: 850;
        min-height: 39px;
        padding: 8px 12px;
        font-size: .82rem;
    }

    .lich-empty {
        padding: 54px 20px;
        text-align: center;
        color: #64748b;
    }

    .lich-mobile-list {
        display: none;
    }

    .lich-mobile-card {
        background: #fff;
        border-radius: 19px;
        border: 1px solid rgba(148,163,184,.24);
        padding: 14px;
        box-shadow: 0 10px 24px rgba(15,23,42,.055);
        margin-bottom: 13px;
    }

    .mobile-line {
        display: flex;
        gap: 9px;
        align-items: flex-start;
        color: #475569;
        font-size: .84rem;
        line-height: 1.48;
        margin-top: 8px;
    }

    .phan-trang .page-link {
        border: 1px solid #dbe3ef;
        color: #334155;
        font-weight: 900;
        border-radius: 12px;
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 3px;
    }

    .phan-trang .page-item.active .page-link {
        background: linear-gradient(135deg,var(--lich-primary),var(--lich-primary-dark));
        color: #fff;
        border-color: transparent;
    }

    .modal-content {
        border-radius: 22px;
        overflow: hidden;
    }

    @@media (max-width: 991.98px) {
        .desktop-table-wrap {
            display: none;
        }

        .lich-mobile-list {
            display: block;
            padding: 12px;
            background: #f8fafc;
        }

        .action-stack {
            max-width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .lich-page {
            padding: 6px 8px 24px !important;
            font-size: 13px;
        }

        .lich-hero, .lich-filter {
            border-radius: 16px;
            padding: 12px;
            margin-bottom: 10px;
        }

        .lich-title {
            font-size: 1.08rem;
        }

        .lich-subtitle {
            display: none;
        }

        .lich-quick {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            width: 100%;
            margin-top: 8px;
        }

        .lich-chip {
            justify-content: center;
            min-height: 32px;
            padding: 5px 8px;
            font-size: .72rem;
            border-radius: 11px;
        }

        .lich-stats {
            display: grid !important;
            grid-template-columns: repeat(3,minmax(0,1fr));
            gap: 7px;
            margin-bottom: 10px;
        }

            .lich-stats > [class*="col-"] {
                width: auto !important;
                max-width: none !important;
                flex: initial !important;
                padding: 0 !important;
            }

        .lich-stat {
            min-height: 58px;
            border-radius: 14px;
            padding: 8px 9px;
        }

        .lich-stat-label {
            font-size: .5rem;
            margin-bottom: 4px;
            white-space: nowrap;
        }

        .lich-stat-value {
            font-size: 1.24rem;
        }

        .lich-filter .col-xl-2, .lich-filter .col-lg-3, .lich-filter .col-md-6 {
            width: 50% !important;
            flex: 0 0 50% !important;
        }

            .lich-filter .col-xl-5, .lich-filter .col-lg-9, .lich-filter .col-md-12, .lich-filter .col-xl-1, .lich-filter .col-lg-3.d-grid {
                width: 100% !important;
                flex: 0 0 100% !important;
            }

        .lich-input, .btn-loc {
            min-height: 38px;
            font-size: .78rem;
        }

        .lich-card-box {
            border-radius: 17px;
            box-shadow: none;
        }

        .lich-mobile-list {
            padding: 8px;
        }

        .lich-mobile-card {
            padding: 10px;
            border-radius: 15px;
            margin-bottom: 8px;
        }

        .action-stack {
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 6px;
        }

            .action-stack > .full-action, .action-stack > .text-muted {
                grid-column: 1 / -1;
            }
    }

    @@media (max-width: 390px) {
        .lich-stats {
            grid-template-columns: repeat(2,minmax(0,1fr)) !important;
        }
    }
</style>

<div class="container lich-page">
    <div class="lich-hero">
        <div>
            <h1 class="lich-title">@(isBusinessMode ? "Lịch hẹn xem dự án" : "Lịch hẹn của tôi")</h1>
            <p class="lich-subtitle">
                @(isBusinessMode
                                ? "Quy trình xử lý: điều phối/xác nhận → gặp khách → cập nhật kết quả → hoàn tất. Sau khi đã xác nhận, hệ thống không còn cho dời lịch hoặc từ chối để tránh quay ngược bước."
                                : "Theo dõi lịch hẹn xem bất động sản. Mỗi lịch chỉ hiển thị đúng thao tác theo trạng thái hiện tại, giúp quy trình rõ ràng khi demo và phản biện.")
            </p>
        </div>

        <div class="lich-quick">
            <span class="lich-chip"><i class="bi bi-diagram-3-fill text-primary"></i> Quy trình một chiều</span>
            <span class="lich-chip"><i class="bi bi-lock-fill text-success"></i> Hoàn tất là khóa lịch</span>
        </div>
    </div>

    <div class="row g-3 lich-stats">
        <div class="col-xl-2 col-lg-4 col-md-6 col-6"><div class="lich-stat nen-tong"><div class="lich-stat-label">Tổng lịch</div><div class="lich-stat-value">@totalAppointments</div></div></div>
        <div class="col-xl-2 col-lg-4 col-md-6 col-6"><div class="lich-stat nen-cho"><div class="lich-stat-label">Chờ xử lý</div><div class="lich-stat-value">@pendingAppointments</div></div></div>
        <div class="col-xl-2 col-lg-4 col-md-6 col-6"><div class="lich-stat nen-xac-nhan"><div class="lich-stat-label">Đã xác nhận</div><div class="lich-stat-value">@confirmedAppointments</div></div></div>
        <div class="col-xl-2 col-lg-4 col-md-6 col-6"><div class="lich-stat nen-hoan-tat"><div class="lich-stat-label">Hoàn tất</div><div class="lich-stat-value">@completedAppointments</div></div></div>
        <div class="col-xl-2 col-lg-4 col-md-6 col-6"><div class="lich-stat nen-huy"><div class="lich-stat-label">Đã hủy</div><div class="lich-stat-value">@cancelledAppointments</div></div></div>
        <div class="col-xl-2 col-lg-4 col-md-6 col-6"><div class="lich-stat nen-tong"><div class="lich-stat-label">Hôm nay</div><div class="lich-stat-value">@todayAppointments</div></div></div>
    </div>

    <details class="lich-filter" open>
        <summary class="d-sm-none fw-bold mb-3"><i class="bi bi-funnel-fill text-primary me-1"></i> Bộ lọc lịch hẹn</summary>
        <form method="get" asp-action="Index" asp-controller="Appointments" class="row g-3 align-items-end">
            <input type="hidden" name="mode" value="@appointmentMode" />

            <div class="col-xl-2 col-lg-3 col-md-6">
                <label class="form-label lich-label">Phân loại</label>
                <select name="tab" class="form-select lich-input">
                    <option value="tat-ca" selected="@(activeTab == "tat-ca" || activeTab == "all" ? "selected" : null)">Tất cả lịch</option>
                    <option value="lich-den" selected="@(activeTab == "lich-den" || activeTab == "incoming" ? "selected" : null)">Khách hẹn mình</option>
                    @if (!isBusinessMode)
                    {
                        <option value="lich-di" selected="@(activeTab == "lich-di" || activeTab == "outgoing" ? "selected" : null)">Mình đặt lịch</option>
                    }
                    <option value="sap-toi" selected="@(activeTab == "sap-toi" || activeTab == "upcoming" ? "selected" : null)">Cần xử lý</option>
                    <option value="hoan-tat" selected="@(activeTab == "hoan-tat" || activeTab == "completed" ? "selected" : null)">Hoàn tất</option>
                    <option value="da-huy" selected="@(activeTab == "da-huy" || activeTab == "cancelled" ? "selected" : null)">Đã hủy</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-6">
                <label class="form-label lich-label">Trạng thái</label>
                <select name="statusFilter" class="form-select lich-input">
                    <option value="Tất cả" selected="@(statusFilter == "Tất cả" || statusFilter == "All" ? "selected" : null)">Tất cả</option>
                    <option value="Chờ xác nhận" selected="@(statusFilter == "Chờ xác nhận" || statusFilter == "Pending" ? "selected" : null)">Chờ xác nhận</option>
                    <option value="Đang dời lịch" selected="@(statusFilter == "Đang dời lịch" || statusFilter == "Rescheduled" ? "selected" : null)">Đang dời lịch</option>
                    <option value="Đã xác nhận" selected="@(statusFilter == "Đã xác nhận" || statusFilter == "Confirmed" ? "selected" : null)">Đã xác nhận</option>
                    <option value="Đã hoàn tất" selected="@(statusFilter == "Đã hoàn tất" || statusFilter == "Completed" ? "selected" : null)">Đã hoàn tất</option>
                    <option value="Đã hủy" selected="@(statusFilter == "Đã hủy" || statusFilter == "Cancelled" ? "selected" : null)">Đã hủy</option>
                    <option value="Khách không đến" selected="@(statusFilter == "Khách không đến" || statusFilter == "NoShow" ? "selected" : null)">Khách không đến</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-6">
                <label class="form-label lich-label">Thời gian</label>
                <select name="dateRange" class="form-select lich-input">
                    <option value="tat-ca" selected="@(dateRange == "tat-ca" || dateRange == "all" ? "selected" : null)">Toàn thời gian</option>
                    <option value="hom-nay" selected="@(dateRange == "hom-nay" || dateRange == "today" ? "selected" : null)">Hôm nay</option>
                    <option value="7-ngay" selected="@(dateRange == "7-ngay" || dateRange == "week" ? "selected" : null)">7 ngày qua</option>
                    <option value="30-ngay" selected="@(dateRange == "30-ngay" || dateRange == "month" ? "selected" : null)">30 ngày qua</option>
                </select>
            </div>

            <div class="col-xl-5 col-lg-9 col-md-12">
                <label class="form-label lich-label">Từ khóa</label>
                <input type="text" name="keyword" value="@keyword" class="form-control lich-input" placeholder="Tên khách, SĐT, nhân viên, điểm hẹn, dự án..." />
            </div>

            <div class="col-xl-1 col-lg-3 col-md-12 d-grid">
                <button type="submit" class="btn btn-loc"><i class="bi bi-search"></i> Lọc</button>
            </div>
        </form>
    </details>

    <div class="lich-card-box mb-5">
        <div class="desktop-table-wrap table-responsive">
            <table class="table lich-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 24%;">Thời gian & nguồn</th>
                        <th style="width: 25%;">Khách hàng & điều phối</th>
                        <th style="width: 31%;">Trạng thái & ghi chú</th>
                        <th style="width: 20%;" class="text-center">Thao tác đúng bước</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var a in Model)
                        {
                            bool isSeller = a.SellerID == currentUserId;
                            bool isBuyer = a.BuyerID == currentUserId;
                            string customerName = GetCustomerName(a);
                            string sourceName = GetSourceName(a);
                            string sourceUrl = GetSourceUrl(a);
                            bool hasSourceLink = !string.IsNullOrWhiteSpace(sourceUrl);
                            string statusText = GetStatusText(a.Status);
                            string statusClass = GetStatusClass(a.Status);
                            string statusIcon = GetStatusIcon(a.Status);
                            string resultText = GetResultText(a.ResultStatus);
                            bool hasResult = !string.IsNullOrWhiteSpace(resultText);
                            bool isClosed = IsClosedStatus(statusText);
                            bool hasStaff = !string.IsNullOrWhiteSpace(a.AssignedStaffName) || !string.IsNullOrWhiteSpace(a.AssignedStaffPhone);
                            bool canDispatch = CanDispatch(statusText, isSeller);
                            string buyerVisibleNote = GetBuyerVisibleAppointmentNote(a.Note);
                            string sellerInternalNoteFromNote = GetSellerInternalAppointmentNote(a.Note);

                            <tr>
                                <td>
                                    <div class="appointment-highlight">
                                        <i class="bi bi-alarm-fill me-1"></i>
                                        Khách hẹn lúc @a.AppointmentDate.ToString("HH:mm", vi), ngày @a.AppointmentDate.ToString("dd/MM/yyyy", vi)
                                    </div>
                                    <div class="lich-created"><i class="bi bi-plus-circle me-1"></i>Tạo lúc: @a.CreatedAt.ToString("HH:mm - dd/MM/yyyy", vi)</div>
                                    @if (a.UpdatedAt.HasValue)
                                    {
                                        <div class="lich-created"><i class="bi bi-clock-history me-1"></i>Cập nhật: @a.UpdatedAt.Value.ToString("HH:mm - dd/MM/yyyy", vi)</div>
                                    }
                                    @if (a.ProposedAppointmentDate.HasValue)
                                    {
                                        <div class="mt-2 text-danger small fw-bold"><i class="bi bi-arrow-right-circle"></i> Giờ mới: @a.ProposedAppointmentDate.Value.ToString("HH:mm - dd/MM/yyyy", vi)</div>
                                    }
                                    <div class="lich-source">
                                        <div class="lich-source-label">Nguồn lịch hẹn</div>
                                        <div class="lich-source-name">
                                            @if (hasSourceLink)
                                            {
                                                <a href="@sourceUrl" class="lich-source-link" title="Bấm để xem chi tiết tin/dự án">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                    <span>@sourceName</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span>@sourceName</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="lich-person">@customerName</div>
                                    <div class="lich-small"><i class="bi bi-telephone-fill text-success me-1"></i>@(string.IsNullOrWhiteSpace(a.CustomerPhone) ? "Chưa có số điện thoại" : a.CustomerPhone)</div>
                                    <div class="lich-small mt-1"><i class="bi bi-envelope-fill text-primary me-1"></i>@(string.IsNullOrWhiteSpace(a.CustomerEmail) ? "Chưa có email" : a.CustomerEmail)</div>
                                    <div class="lich-small mt-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrWhiteSpace(a.MeetingLocation) ? "Chưa cung cấp điểm hẹn" : a.MeetingLocation)</div>
                                    @if (hasStaff)
                                    {
                                        <div class="staff-box">
                                            <div class="staff-box-title"><i class="bi bi-person-badge-fill me-1"></i>Nhân viên phụ trách</div>
                                            <div>@(string.IsNullOrWhiteSpace(a.AssignedStaffName) ? "Chưa rõ tên" : a.AssignedStaffName)</div>
                                            @if (!string.IsNullOrWhiteSpace(a.AssignedStaffPhone))
                                            {
                                                <div><i class="bi bi-telephone me-1"></i>@a.AssignedStaffPhone</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(a.AssignedStaffEmail))
                                            {
                                                <div><i class="bi bi-envelope me-1"></i>@a.AssignedStaffEmail</div>
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(buyerVisibleNote))
                                    {
                                        <div class="lich-note-card note-customer"><div class="lich-note-icon"><i class="bi bi-chat-left-text"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú khách đặt lịch</span><span class="lich-note-text">@buyerVisibleNote</span></div></div>
                                    }
                                    @if (isSeller && !string.IsNullOrWhiteSpace(sellerInternalNoteFromNote))
                                    {
                                        <div class="lich-note-card note-private"><div class="lich-note-icon"><i class="bi bi-shield-lock-fill"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú nội bộ điều phối</span><span class="lich-note-text">@sellerInternalNoteFromNote</span></div></div>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                        <span class="trang-thai @statusClass"><i class="bi @statusIcon"></i>@statusText</span>
                                        <span class="vai-tro @GetRoleClass(isSeller, isBuyer)">@GetRoleText(isSeller, isBuyer)</span>
                                    </div>
                                    <div class="flow-box"><i class="bi bi-signpost-split-fill me-1"></i>Luồng: Chờ xác nhận → Đã xác nhận → Cập nhật kết quả → Hoàn tất/Khách không đến.</div>
                                    <div class="next-box"><i class="bi bi-info-circle-fill me-1"></i>@GetNextActionText(statusText, isSeller, isBuyer, hasResult, hasStaff)</div>
                                    @if (isSeller && !string.IsNullOrWhiteSpace(a.NegotiationNote))
                                    {
                                        <div class="lich-note-card note-private"><div class="lich-note-icon"><i class="bi bi-shield-lock-fill"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú nội bộ xử lý lịch hẹn</span><span class="lich-note-text">@a.NegotiationNote</span></div></div>
                                    }
                                    @if (hasResult)
                                    {
                                        <div class="mt-2">
                                            <span class="ket-qua-pill"><i class="bi bi-bookmark-check-fill text-success"></i>Kết quả: @resultText</span>
                                            @if (isSeller && !string.IsNullOrWhiteSpace(a.ResultNote))
                                            {
                                                <div class="lich-note-card note-result"><div class="lich-note-icon"><i class="bi bi-journal-text"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú nội bộ</span><span class="lich-note-text">@a.ResultNote</span></div></div>
                                            }
                                            @if (isBuyer)
                                            {
                                                <div class="text-muted small mt-2">Người mua chỉ thấy kết quả tổng quát, không thấy ghi chú nội bộ của người bán.</div>
                                            }
                                        </div>
                                    }
                                    @if (a.CompletedAt.HasValue)
                                    {
                                        <div class="lich-created mt-2"><i class="bi bi-check2-circle me-1"></i>Đóng lúc: @a.CompletedAt.Value.ToString("HH:mm - dd/MM/yyyy", vi)</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="action-stack">
                                        @if (canDispatch)
                                        {
                                            <button type="button"
                                                    class="btn btn-primary nut-thao-tac full-action"
                                                    onclick="openDispatchModal(@a.AppointmentID, '@Html.Raw(JavaScriptEncoder.Default.Encode(a.AssignedStaffName ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(a.AssignedStaffPhone ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(a.AssignedStaffEmail ?? ""))')">
                                                <i class="bi bi-person-plus-fill"></i>
                                                @(statusText == "Chờ xác nhận" ? "Điều phối & xác nhận" : (hasStaff ? "Đổi nhân viên" : "Điều phối"))
                                            </button>
                                        }

                                        @if (isSeller)
                                        {
                                            if (statusText == "Chờ xác nhận" && !isBusinessMode)
                                            {
                                                <button type="button" class="btn btn-success nut-thao-tac" onclick="postAction('@Url.Action("SellerAccept", "Appointments")', @a.AppointmentID, 'Xác nhận lịch hẹn này? Sau khi xác nhận, hệ thống sẽ khóa thao tác dời lịch và từ chối.')">
                                                    <i class="bi bi-check-circle-fill"></i> Xác nhận
                                                </button>
                                            }

                                            if (statusText == "Chờ xác nhận")
                                            {
                                                <button type="button" class="btn btn-warning text-dark nut-thao-tac" onclick="openRescheduleModal(@a.AppointmentID)">
                                                    <i class="bi bi-clock-history"></i> Đề xuất giờ khác
                                                </button>
                                                <button type="button" class="btn btn-outline-danger nut-thao-tac" onclick="openReasonModal(@a.AppointmentID, 'Từ chối lịch hẹn', '@Url.Action("SellerReject", "Appointments")', 'Nhập lý do từ chối lịch hẹn khi lịch còn chờ xác nhận.')">
                                                    <i class="bi bi-x-circle-fill"></i> Từ chối
                                                </button>
                                            }
                                            else if (statusText == "Đã xác nhận")
                                            {
                                                <button type="button" class="btn btn-outline-primary nut-thao-tac full-action" data-bs-toggle="modal" data-bs-target="#feedbackModal" data-id="@a.AppointmentID" data-result-status="@GetResultText(a.ResultStatus)" data-result-note="@(a.ResultNote ?? "")">
                                                    <i class="bi bi-clipboard-check"></i> @(hasResult ? "Sửa kết quả" : "Cập nhật kết quả")
                                                </button>

                                                @if (hasResult)
                                                {
                                                    <button type="button" class="btn btn-success nut-thao-tac" onclick="postAction('@Url.Action("SellerComplete", "Appointments")', @a.AppointmentID, 'Hoàn tất lịch hẹn này? Sau khi hoàn tất, lịch sẽ bị khóa để lưu lịch sử.')">
                                                        <i class="bi bi-check2-circle"></i> Hoàn tất
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-success nut-thao-tac" disabled title="Cần cập nhật kết quả trước khi hoàn tất"><i class="bi bi-check2-circle"></i> Hoàn tất</button>
                                                }

                                                <button type="button" class="btn btn-outline-secondary nut-thao-tac" onclick="openReasonModal(@a.AppointmentID, 'Khách không đến', '@Url.Action("SellerNoShow", "Appointments")', 'Nhập ghi chú nếu khách không đến buổi hẹn.')">
                                                    <i class="bi bi-person-x-fill"></i> Khách không đến
                                                </button>

                                                <span class="text-muted small fw-bold full-action"><i class="bi bi-lock-fill"></i> Đã xác nhận nên đã khóa dời lịch và từ chối.</span>
                                            }
                                            else if (statusText == "Đang dời lịch")
                                            {
                                                <span class="text-muted small fw-bold text-center full-action"><i class="bi bi-hourglass-split"></i> Chờ khách xác nhận giờ mới</span>
                                            }
                                        }

                                        @if (isBuyer && !isBusinessMode)
                                        {
                                            if (statusText == "Chờ xác nhận")
                                            {
                                                <button type="button" class="btn btn-outline-danger nut-thao-tac full-action" onclick="openReasonModal(@a.AppointmentID, 'Hủy yêu cầu lịch hẹn', '@Url.Action("BuyerCancel", "Appointments")', 'Nhập lý do hủy yêu cầu lịch hẹn.')"><i class="bi bi-trash-fill"></i> Hủy yêu cầu</button>
                                            }
                                            else if (statusText == "Đang dời lịch")
                                            {
                                                <button type="button" class="btn btn-success nut-thao-tac" onclick="postAction('@Url.Action("BuyerAcceptReschedule", "Appointments")', @a.AppointmentID, 'Bạn đồng ý với giờ dời lịch do người bán đề xuất?')"><i class="bi bi-check-circle-fill"></i> Đồng ý giờ mới</button>
                                                <button type="button" class="btn btn-danger nut-thao-tac" onclick="openReasonModal(@a.AppointmentID, 'Không đồng ý giờ dời lịch', '@Url.Action("BuyerRejectReschedule", "Appointments")', 'Nhập lý do không đồng ý giờ dời lịch.')"><i class="bi bi-x-circle-fill"></i> Không đồng ý</button>
                                            }
                                            else if (statusText == "Đã xác nhận")
                                            {
                                                <span class="text-muted small fw-bold full-action"><i class="bi bi-calendar-check"></i> Lịch đã xác nhận. Vui lòng đến đúng giờ.</span>
                                            }
                                        }

                                        @if (isClosed)
                                        {
                                            <span class="text-muted small fw-bold text-center full-action"><i class="bi bi-lock-fill"></i> Lịch đã đóng</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4"><div class="lich-empty"><i class="bi bi-calendar-x display-1 opacity-25 d-block mb-3"></i><h5 class="fw-bold">Chưa có lịch hẹn phù hợp</h5><div>Hãy thử đổi bộ lọc hoặc kiểm tra lại từ khóa tìm kiếm.</div></div></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="lich-mobile-list">
            @if (Model != null && Model.Any())
            {
                foreach (var a in Model)
                {
                    bool isSeller = a.SellerID == currentUserId;
                    bool isBuyer = a.BuyerID == currentUserId;
                    string customerName = GetCustomerName(a);
                    string sourceName = GetSourceName(a);
                    string sourceUrl = GetSourceUrl(a);
                    bool hasSourceLink = !string.IsNullOrWhiteSpace(sourceUrl);
                    string statusText = GetStatusText(a.Status);
                    string statusClass = GetStatusClass(a.Status);
                    string statusIcon = GetStatusIcon(a.Status);
                    string resultText = GetResultText(a.ResultStatus);
                    bool hasResult = !string.IsNullOrWhiteSpace(resultText);
                    bool isClosed = IsClosedStatus(statusText);
                    bool hasStaff = !string.IsNullOrWhiteSpace(a.AssignedStaffName) || !string.IsNullOrWhiteSpace(a.AssignedStaffPhone);
                    bool canDispatch = CanDispatch(statusText, isSeller);
                    string buyerVisibleNote = GetBuyerVisibleAppointmentNote(a.Note);
                    string sellerInternalNoteFromNote = GetSellerInternalAppointmentNote(a.Note);

                    <div class="lich-mobile-card">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <div class="lich-person mb-1">@customerName</div>
                                <div class="appointment-highlight"><i class="bi bi-alarm-fill me-1"></i>Khách hẹn lúc @a.AppointmentDate.ToString("HH:mm", vi), ngày @a.AppointmentDate.ToString("dd/MM/yyyy", vi)</div>
                            </div>
                            <span class="trang-thai @statusClass"><i class="bi @statusIcon"></i>@statusText</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mb-2"><span class="vai-tro @GetRoleClass(isSeller, isBuyer)">@GetRoleText(isSeller, isBuyer)</span></div>
                        <div class="mobile-line">
                            <i class="bi bi-house-door text-primary"></i>
                            <div>
                                <strong>Nguồn:</strong>
                                @if (hasSourceLink)
                                {
                                    <a href="@sourceUrl" class="mobile-source-link" title="Bấm để xem chi tiết tin/dự án">
                                        @sourceName <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                }
                                else
                                {
                                    <span>@sourceName</span>
                                }
                            </div>
                        </div>
                        <div class="mobile-line"><i class="bi bi-telephone-fill text-success"></i><div><strong>SĐT:</strong> @(string.IsNullOrWhiteSpace(a.CustomerPhone) ? "Chưa có" : a.CustomerPhone)</div></div>
                        <div class="mobile-line"><i class="bi bi-envelope-fill text-primary"></i><div><strong>Email:</strong> @(string.IsNullOrWhiteSpace(a.CustomerEmail) ? "Chưa có" : a.CustomerEmail)</div></div>
                        <div class="mobile-line"><i class="bi bi-geo-alt-fill text-danger"></i><div><strong>Điểm hẹn:</strong> @(string.IsNullOrWhiteSpace(a.MeetingLocation) ? "Chưa cung cấp" : a.MeetingLocation)</div></div>
                        @if (hasStaff)
                        {
                            <div class="staff-box">
                                <div class="staff-box-title"><i class="bi bi-person-badge-fill me-1"></i>Nhân viên phụ trách</div><div>@(string.IsNullOrWhiteSpace(a.AssignedStaffName) ? "Chưa rõ tên" : a.AssignedStaffName)</div>@if (!string.IsNullOrWhiteSpace(a.AssignedStaffPhone)) {
                                <div><i class="bi bi-telephone me-1"></i>@a.AssignedStaffPhone</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(a.AssignedStaffEmail))
                            {
                                <div><i class="bi bi-envelope me-1"></i>@a.AssignedStaffEmail</div>
                            }
                        </div>
                    }
                    @if (a.ProposedAppointmentDate.HasValue)
                    {
                        <div class="lich-note-card"><div class="lich-note-icon"><i class="bi bi-arrow-right-circle"></i></div><div class="lich-note-body"><span class="lich-note-title">Giờ hẹn mới đề xuất</span><span class="lich-note-text">@a.ProposedAppointmentDate.Value.ToString("HH:mm - dd/MM/yyyy", vi)</span></div></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(buyerVisibleNote))
                    {
                        <div class="lich-note-card note-customer"><div class="lich-note-icon"><i class="bi bi-chat-left-text"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú khách đặt lịch</span><span class="lich-note-text">@buyerVisibleNote</span></div></div>
                    }
                    @if (isSeller && !string.IsNullOrWhiteSpace(sellerInternalNoteFromNote))
                    {
                        <div class="lich-note-card note-private"><div class="lich-note-icon"><i class="bi bi-shield-lock-fill"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú nội bộ điều phối</span><span class="lich-note-text">@sellerInternalNoteFromNote</span></div></div>
                    }
                    <div class="flow-box"><i class="bi bi-signpost-split-fill me-1"></i>Chờ xác nhận → Đã xác nhận → Cập nhật kết quả → Hoàn tất.</div>
                    <div class="next-box"><i class="bi bi-info-circle-fill me-1"></i>@GetNextActionText(statusText, isSeller, isBuyer, hasResult, hasStaff)</div>
                    @if (isSeller && !string.IsNullOrWhiteSpace(a.NegotiationNote))
                    {
                        <div class="lich-note-card note-private"><div class="lich-note-icon"><i class="bi bi-shield-lock-fill"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú nội bộ xử lý lịch hẹn</span><span class="lich-note-text">@a.NegotiationNote</span></div></div>
                    }
                    @if (hasResult)
                    {
                        <div class="mt-3">
                            <span class="ket-qua-pill"><i class="bi bi-bookmark-check-fill text-success"></i>Kết quả: @resultText</span>@if (isSeller && !string.IsNullOrWhiteSpace(a.ResultNote)) {
                            <div class="lich-note-card note-result"><div class="lich-note-icon"><i class="bi bi-journal-text"></i></div><div class="lich-note-body"><span class="lich-note-title">Ghi chú nội bộ</span><span class="lich-note-text">@a.ResultNote</span></div></div>
                        }
                    </div>
                }
                <div class="mt-3">
                    <div class="action-stack">
                        @if (canDispatch)
                        {
                            <button type="button"
                                    class="btn btn-primary nut-thao-tac full-action"
                                    onclick="openDispatchModal(@a.AppointmentID, '@Html.Raw(JavaScriptEncoder.Default.Encode(a.AssignedStaffName ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(a.AssignedStaffPhone ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(a.AssignedStaffEmail ?? ""))')">
                                <i class="bi bi-person-plus-fill"></i>
                                @(statusText == "Chờ xác nhận" ? "Điều phối & xác nhận" : (hasStaff ? "Đổi nhân viên" : "Điều phối"))
                            </button>
                        }

                        @if (isSeller)
                        {
                            if (statusText == "Chờ xác nhận" && !isBusinessMode)
                            {
                                <button type="button" class="btn btn-success nut-thao-tac" onclick="postAction('@Url.Action("SellerAccept", "Appointments")', @a.AppointmentID, 'Xác nhận lịch hẹn này? Sau khi xác nhận, hệ thống sẽ khóa thao tác dời lịch và từ chối.')">
                                    <i class="bi bi-check-circle-fill"></i> Xác nhận
                                </button>
                            }

                            if (statusText == "Chờ xác nhận")
                            {
                                <button type="button" class="btn btn-warning text-dark nut-thao-tac" onclick="openRescheduleModal(@a.AppointmentID)">
                                    <i class="bi bi-clock-history"></i> Đề xuất giờ khác
                                </button>
                                <button type="button" class="btn btn-outline-danger nut-thao-tac" onclick="openReasonModal(@a.AppointmentID, 'Từ chối lịch hẹn', '@Url.Action("SellerReject", "Appointments")', 'Nhập lý do từ chối lịch hẹn khi lịch còn chờ xác nhận.')">
                                    <i class="bi bi-x-circle-fill"></i> Từ chối
                                </button>
                            }
                            else if (statusText == "Đã xác nhận")
                            {
                                <button type="button" class="btn btn-outline-primary nut-thao-tac full-action" data-bs-toggle="modal" data-bs-target="#feedbackModal" data-id="@a.AppointmentID" data-result-status="@GetResultText(a.ResultStatus)" data-result-note="@(a.ResultNote ?? "")">
                                    <i class="bi bi-clipboard-check"></i> @(hasResult ? "Sửa kết quả" : "Cập nhật kết quả")
                                </button>

                                @if (hasResult)
                                {
                                    <button type="button" class="btn btn-success nut-thao-tac" onclick="postAction('@Url.Action("SellerComplete", "Appointments")', @a.AppointmentID, 'Hoàn tất lịch hẹn này? Sau khi hoàn tất, lịch sẽ bị khóa để lưu lịch sử.')">
                                        <i class="bi bi-check2-circle"></i> Hoàn tất
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success nut-thao-tac" disabled title="Cần cập nhật kết quả trước khi hoàn tất"><i class="bi bi-check2-circle"></i> Hoàn tất</button>
                                }

                                <button type="button" class="btn btn-outline-secondary nut-thao-tac" onclick="openReasonModal(@a.AppointmentID, 'Khách không đến', '@Url.Action("SellerNoShow", "Appointments")', 'Nhập ghi chú nếu khách không đến buổi hẹn.')">
                                    <i class="bi bi-person-x-fill"></i> Khách không đến
                                </button>

                                <span class="text-muted small fw-bold full-action"><i class="bi bi-lock-fill"></i> Đã xác nhận nên đã khóa dời lịch và từ chối.</span>
                            }
                            else if (statusText == "Đang dời lịch")
                            {
                                <span class="text-muted small fw-bold text-center full-action"><i class="bi bi-hourglass-split"></i> Chờ khách xác nhận giờ mới</span>
                            }
                        }

                        @if (isBuyer && !isBusinessMode)
                        {
                            if (statusText == "Chờ xác nhận")
                            {
                                <button type="button" class="btn btn-outline-danger nut-thao-tac full-action" onclick="openReasonModal(@a.AppointmentID, 'Hủy yêu cầu lịch hẹn', '@Url.Action("BuyerCancel", "Appointments")', 'Nhập lý do hủy yêu cầu lịch hẹn.')"><i class="bi bi-trash-fill"></i> Hủy yêu cầu</button>
                            }
                            else if (statusText == "Đang dời lịch")
                            {
                                <button type="button" class="btn btn-success nut-thao-tac" onclick="postAction('@Url.Action("BuyerAcceptReschedule", "Appointments")', @a.AppointmentID, 'Bạn đồng ý với giờ dời lịch do người bán đề xuất?')"><i class="bi bi-check-circle-fill"></i> Đồng ý giờ mới</button>
                                <button type="button" class="btn btn-danger nut-thao-tac" onclick="openReasonModal(@a.AppointmentID, 'Không đồng ý giờ dời lịch', '@Url.Action("BuyerRejectReschedule", "Appointments")', 'Nhập lý do không đồng ý giờ dời lịch.')"><i class="bi bi-x-circle-fill"></i> Không đồng ý</button>
                            }
                            else if (statusText == "Đã xác nhận")
                            {
                                <span class="text-muted small fw-bold full-action"><i class="bi bi-calendar-check"></i> Lịch đã xác nhận. Vui lòng đến đúng giờ.</span>
                            }
                        }

                        @if (isClosed)
                        {
                            <span class="text-muted small fw-bold text-center full-action"><i class="bi bi-lock-fill"></i> Lịch đã đóng</span>
                        }
                    </div>
                </div>
            </div>
                        }
                        }
                        else
            {
                <div class="lich-empty"><i class="bi bi-calendar-x display-1 opacity-25 d-block mb-3"></i><h5 class="fw-bold">Chưa có lịch hẹn phù hợp</h5><div>Hãy thử đổi bộ lọc hoặc kiểm tra lại từ khóa tìm kiếm.</div></div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="p-4 border-top">
                <nav class="d-flex justify-content-center">
                    <ul class="pagination phan-trang mb-0 flex-wrap justify-content-center">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, tab = activeTab, statusFilter, keyword, dateRange, mode = appointmentMode })"><i class="bi bi-chevron-left"></i></a></li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")"><a class="page-link" href="@Url.Action("Index", new { page = i, tab = activeTab, statusFilter, keyword, dateRange, mode = appointmentMode })">@i</a></li>
                        }
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, tab = activeTab, statusFilter, keyword, dateRange, mode = appointmentMode })"><i class="bi bi-chevron-right"></i></a></li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="dispatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Điều phối nhân viên đi gặp khách</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="frmDispatch" asp-action="DispatchStaff" asp-controller="Appointments" method="post">
                <div class="modal-body p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="dispatchAppointmentId" />
                    <div class="alert alert-info border-0 rounded-4 small fw-bold mb-4"><i class="bi bi-info-circle-fill me-1"></i>Nếu lịch đang “Chờ xác nhận”, khi lưu điều phối hệ thống tự chuyển sang “Đã xác nhận”. Sau đó không còn dời lịch hoặc từ chối.</div>
                    <div class="mb-3"><label class="form-label fw-bold text-dark">Tên nhân viên phụ trách <span class="text-danger">*</span></label><input type="text" name="assignedStaffName" id="dispatchStaffName" class="form-control lich-input" required maxlength="255" placeholder="VD: Nguyễn Văn A" /></div>
                    <div class="mb-3"><label class="form-label fw-bold text-dark">Số điện thoại nhân viên <span class="text-danger">*</span></label><input type="tel" name="assignedStaffPhone" id="dispatchStaffPhone" class="form-control lich-input" required maxlength="20" placeholder="VD: 0901234567" /></div>
                    <div class="mb-3"><label class="form-label fw-bold text-dark">Email nhân viên</label><input type="email" name="assignedStaffEmail" id="dispatchStaffEmail" class="form-control lich-input" maxlength="255" placeholder="VD: nhanvien@congty.com" /></div>
                    <div><label class="form-label fw-bold text-dark">Ghi chú điều phối</label><textarea name="note" id="dispatchNote" class="form-control lich-input" rows="4" placeholder="VD: Nhân viên gọi khách trước 30 phút, chuẩn bị bảng giá..."></textarea></div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0"><button type="button" class="btn btn-light border rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Lưu điều phối</button></div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="reasonModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-danger text-white border-0"><h5 class="modal-title fw-bold" id="reasonModalTitle"><i class="bi bi-x-octagon-fill me-2"></i>Xác nhận thao tác</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <form id="frmReason" method="post">
                <div class="modal-body p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="reasonAppointmentId" />
                    <label class="form-label fw-bold text-dark">Lý do / ghi chú <span class="text-danger">*</span></label>
                    <textarea name="reason" id="reasonText" class="form-control lich-input bg-light" rows="4" required placeholder="Nhập lý do hoặc ghi chú xử lý..."></textarea>
                    <div class="form-text mt-2">Nội dung này dùng để lưu lịch sử xử lý và thông báo cho bên liên quan khi cần.</div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0"><button type="button" class="btn btn-light border rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Xác nhận</button></div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="rescheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark border-0"><h5 class="modal-title fw-bold"><i class="bi bi-clock-history me-2"></i>Đề xuất giờ hẹn khác</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <form id="frmReschedule" asp-action="SellerReschedule" asp-controller="Appointments" method="post">
                <div class="modal-body p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="rescheduleId" />
                    <div class="alert alert-warning border-0 rounded-4 small fw-bold mb-4"><i class="bi bi-info-circle-fill me-1"></i>Chỉ dùng khi lịch còn “Chờ xác nhận”. Sau khi đã xác nhận, hệ thống không cho dời lịch nữa.</div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label fw-bold text-dark">Ngày mới <span class="text-danger">*</span></label><input type="date" name="proposedDate" class="form-control lich-input" required /></div>
                        <div class="col-6"><label class="form-label fw-bold text-dark">Giờ mới <span class="text-danger">*</span></label><input type="time" name="proposedTime" class="form-control lich-input" required /></div>
                        <div class="col-12"><label class="form-label fw-bold text-dark">Lý do đề xuất giờ khác <span class="text-danger">*</span></label><textarea name="reason" class="form-control lich-input" rows="4" required placeholder="Ví dụ: Người phụ trách bận lịch khác, đề xuất khách sang khung giờ mới..."></textarea></div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0"><button type="button" class="btn btn-light border rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold text-dark">Gửi đề xuất</button></div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="feedbackModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0"><h5 class="modal-title fw-bold"><i class="bi bi-clipboard-data-fill me-2"></i>Cập nhật kết quả sau buổi hẹn</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <form id="frmFeedback" asp-action="UpdateOutcome" asp-controller="Appointments" method="post">
                <div class="modal-body p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="feedbackAppointmentId" />
                    <div class="alert alert-info border-0 rounded-4 small fw-bold mb-4"><i class="bi bi-info-circle-fill me-1"></i>Lưu kết quả không khóa lịch. Chỉ khi bấm “Hoàn tất lịch hẹn” thì lịch mới bị khóa và không sửa tiếp.</div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Kết quả sau buổi hẹn <span class="text-danger">*</span></label>
                        <select name="resultStatus" id="feedbackResultStatus" class="form-select lich-input bg-light" required>
                            <option value="Khách quan tâm">1. Khách quan tâm / muốn trao đổi thêm</option>
                            <option value="Cần chăm sóc thêm">2. Cần chăm sóc, tư vấn thêm</option>
                            <option value="Chờ đặt cọc">3. Chờ đặt cọc / chờ làm hợp đồng</option>
                            <option value="Khách không quan tâm">Kết thúc: Khách không quan tâm / không tiếp tục</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label fw-bold text-dark">Ghi chú nội bộ của người phụ trách</label>
                        <textarea name="resultNote" id="feedbackResultNote" class="form-control lich-input" rows="4" placeholder="Ví dụ: Khách thích vị trí nhưng cần thương lượng giá, muốn xem thêm căn khác..."></textarea>
                        <div class="form-text mt-2">Ghi chú này là ghi chú nội bộ, chỉ người bán/chủ đầu tư xem được. Người mua chỉ thấy kết quả tổng quát, không thấy ghi chú xử lý và không thấy ghi chú nội bộ.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0"><button type="button" class="btn btn-light border rounded-pill fw-bold px-4" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-primary rounded-pill fw-bold px-4">Lưu kết quả</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function layTokenChongGiaMao() {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            return tokenInput ? tokenInput.value : '';
        }

        function safeParseJsonResponse(res) {
            return res.text().then(function (text) {
                let data = null;

                try {
                    data = text ? JSON.parse(text) : null;
                } catch {
                    data = null;
                }

                if (!res.ok) {
                    let message = data && data.message
                        ? data.message
                        : 'Máy chủ trả về lỗi ' + res.status + '. Vui lòng kiểm tra lại Controller.';

                    if (!data && text) {
                        const plainText = text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                        if (plainText.length > 0) {
                            message += ' Chi tiết: ' + plainText.substring(0, 250);
                        }
                    }

                    throw new Error(message);
                }

                if (!data) {
                    throw new Error('Máy chủ không trả về dữ liệu JSON hợp lệ. Có thể action đang trả về View/HTML thay vì Json.');
                }

                return data;
            });
        }

        function postAction(url, id, message) {
            Swal.fire({
                title: 'Xác nhận thao tác',
                text: message,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Đóng'
            }).then((result) => {
                if (!result.isConfirmed) return;
                const formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', layTokenChongGiaMao());
                Swal.fire({ title: 'Đang xử lý...', text: 'Vui lòng chờ trong giây lát.', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading() });
                fetch(url, { method: 'POST', body: formData, headers: { 'Accept': 'application/json' } })
                    .then(safeParseJsonResponse)
                    .then(data => {
                        Swal.close();
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Thành công', text: data.message || 'Đã xử lý thành công.', confirmButtonText: 'OK' }).then(() => location.reload());
                        } else {
                            Swal.fire('Không thành công', data.message || 'Thao tác thất bại.', 'error');
                        }
                    })
                    .catch(err => { Swal.close(); Swal.fire('Lỗi', err.message || 'Lỗi máy chủ, vui lòng thử lại sau.', 'error'); });
            });
        }

        function openDispatchModal(id, staffName, staffPhone, staffEmail) {
            document.getElementById('dispatchAppointmentId').value = id;
            document.getElementById('dispatchStaffName').value = staffName || '';
            document.getElementById('dispatchStaffPhone').value = staffPhone || '';
            document.getElementById('dispatchStaffEmail').value = staffEmail || '';
            document.getElementById('dispatchNote').value = '';
            const modal = new bootstrap.Modal(document.getElementById('dispatchModal'));
            modal.show();
            setTimeout(() => document.getElementById('dispatchStaffName').focus(), 250);
        }

        function openReasonModal(id, title, actionUrl, placeholder) {
            const titleEl = document.getElementById('reasonModalTitle');
            const idEl = document.getElementById('reasonAppointmentId');
            const textEl = document.getElementById('reasonText');
            const form = document.getElementById('frmReason');
            titleEl.innerHTML = '<i class="bi bi-x-octagon-fill me-2"></i>' + title;
            idEl.value = id;
            textEl.value = '';
            textEl.placeholder = placeholder || 'Nhập lý do hoặc ghi chú xử lý.';
            form.action = actionUrl;
            new bootstrap.Modal(document.getElementById('reasonModal')).show();
        }

        function openRescheduleModal(id) {
            document.getElementById('rescheduleId').value = id;
            new bootstrap.Modal(document.getElementById('rescheduleModal')).show();
        }

        function handleModalFormAjax(formId) {
            const form = document.getElementById(formId);
            if (!form) return;
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const submitButton = form.querySelector('button[type="submit"]');
                const originalHtml = submitButton ? submitButton.innerHTML : '';
                if (submitButton) { submitButton.disabled = true; submitButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...'; }
                const formData = new FormData(form);
                fetch(form.action, { method: 'POST', body: formData, headers: { 'Accept': 'application/json' } })
                    .then(safeParseJsonResponse)
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ icon: 'success', title: 'Thành công', text: data.message || 'Đã lưu thành công.', confirmButtonText: 'OK' }).then(() => location.reload());
                        } else {
                            Swal.fire('Không thành công', data.message || 'Thao tác thất bại.', 'error');
                            if (submitButton) { submitButton.innerHTML = originalHtml; submitButton.disabled = false; }
                        }
                    })
                    .catch(err => {
                        Swal.fire('Lỗi', err.message || 'Lỗi máy chủ, vui lòng thử lại sau.', 'error');
                        if (submitButton) { submitButton.innerHTML = originalHtml; submitButton.disabled = false; }
                    });
            });
        }

        function getOutcomeRank(value) {
            if (!value) return 0;

            const text = value.trim();

            if (text === 'Khách quan tâm') return 1;
            if (text === 'Cần chăm sóc thêm') return 2;
            if (text === 'Chờ đặt cọc') return 3;
            if (text === 'Khách không quan tâm') return 4;

            return 0;
        }

        function applyOutcomeFlowRule(selectEl, currentResult) {
            if (!selectEl) return;

            const currentRank = getOutcomeRank(currentResult);

            Array.from(selectEl.options).forEach(function (option) {
                option.disabled = false;

                const optionRank = getOutcomeRank(option.value);

                if (currentRank === 0) {
                    option.disabled = false;
                    return;
                }

                // Khách không quan tâm là bước kết thúc cơ hội trong lịch hẹn này.
                // Không cho đổi ngược lại các bước quan tâm trong cùng một lịch hẹn.
                if (currentRank === 4 && option.value !== 'Khách không quan tâm') {
                    option.disabled = true;
                    return;
                }

                // Chờ đặt cọc là bước cao hơn quan tâm/chăm sóc thêm.
                // Không cho quay về Khách quan tâm hoặc Cần chăm sóc thêm.
                // Nếu khách đổi ý không tiếp tục thì vẫn cho chọn Khách không quan tâm.
                if (currentRank === 3 && optionRank < 3) {
                    option.disabled = true;
                    return;
                }

                // Cần chăm sóc thêm không quay lại Khách quan tâm.
                if (currentRank === 2 && optionRank < 2) {
                    option.disabled = true;
                    return;
                }
            });

            if (selectEl.selectedOptions.length > 0 && selectEl.selectedOptions[0].disabled) {
                const firstEnabled = Array.from(selectEl.options).find(function (option) {
                    return !option.disabled;
                });

                if (firstEnabled) {
                    firstEnabled.selected = true;
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            handleModalFormAjax('frmDispatch');
            handleModalFormAjax('frmReason');
            handleModalFormAjax('frmReschedule');
            handleModalFormAjax('frmFeedback');

            const feedbackModal = document.getElementById('feedbackModal');
            if (feedbackModal) {
                feedbackModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const id = button.getAttribute('data-id') || '';
                    const resultStatus = button.getAttribute('data-result-status') || '';
                    const resultNote = button.getAttribute('data-result-note') || '';
                    document.getElementById('feedbackAppointmentId').value = id;
                    document.getElementById('feedbackResultNote').value = resultNote || '';
                    const selectEl = document.getElementById('feedbackResultStatus');
                    if (selectEl) {
                        Array.from(selectEl.options).forEach(function (option) {
                            option.disabled = false;
                        });

                        if (resultStatus) {
                            let matched = false;

                            Array.from(selectEl.options).forEach(function (option) {
                                if (option.value === resultStatus) {
                                    option.selected = true;
                                    matched = true;
                                }
                            });

                            if (!matched) {
                                selectEl.selectedIndex = 0;
                            }
                        } else {
                            selectEl.selectedIndex = 0;
                        }

                        applyOutcomeFlowRule(selectEl, resultStatus);
                    }
                });
            }

            const filterBox = document.querySelector('.lich-filter');
            if (filterBox && window.matchMedia('(max-width: 575.98px)').matches) filterBox.removeAttribute('open');
        });
    </script>
}
