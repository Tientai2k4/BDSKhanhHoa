@model IEnumerable<BDSKhanhHoa.Models.Appointment>
@using System.Globalization
@using System.Text.Encodings.Web

@{
    var appointmentMode = (ViewBag.AppointmentMode as string ?? "CaNhan").Trim();

    bool isBusinessMode = appointmentMode.Equals("DoanhNghiep", StringComparison.OrdinalIgnoreCase)
                       || appointmentMode.Equals("Business", StringComparison.OrdinalIgnoreCase);

    Layout = isBusinessMode
        ? "~/Views/Shared/_BusinessLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = isBusinessMode ? "Lịch hẹn xem dự án" : "Lịch hẹn của tôi";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int currentUserId = ViewBag.CurrentUserId ?? 0;

    int totalAppointments = ViewBag.TotalAppointments ?? 0;
    int pendingAppointments = ViewBag.PendingAppointments ?? 0;
    int confirmedAppointments = ViewBag.ConfirmedAppointments ?? 0;
    int completedAppointments = ViewBag.CompletedAppointments ?? 0;
    int cancelledAppointments = ViewBag.CancelledAppointments ?? 0;
    int todayAppointments = ViewBag.TodayAppointments ?? 0;

    string activeTab = ViewBag.ActiveTab as string ?? "tat-ca";
    string statusFilter = ViewBag.StatusFilter as string ?? "Tất cả";
    string keyword = ViewBag.Keyword as string ?? "";
    string dateRange = ViewBag.DateRange as string ?? "tat-ca";

    var vi = CultureInfo.GetCultureInfo("vi-VN");

    string GetStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Chờ xác nhận";

        return status.Trim() switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Cancelled" => "Đã hủy",
            "Completed" => "Đã hoàn tất",
            "Rescheduled" => "Đang dời lịch",
            "NoShow" => "Khách không đến",
            "Chờ xác nhận" => "Chờ xác nhận",
            "Đã xác nhận" => "Đã xác nhận",
            "Đã hủy" => "Đã hủy",
            "Đã hoàn tất" => "Đã hoàn tất",
            "Đang dời lịch" => "Đang dời lịch",
            "Khách không đến" => "Khách không đến",
            _ => "Chờ xác nhận"
        };
    }

    string GetStatusClass(string? status)
    {
        return GetStatusText(status) switch
        {
            "Chờ xác nhận" => "st-pending",
            "Đã xác nhận" => "st-confirmed",
            "Đang dời lịch" => "st-reschedule",
            "Đã hoàn tất" => "st-completed",
            "Đã hủy" => "st-cancelled",
            "Khách không đến" => "st-noshow",
            _ => "st-pending"
        };
    }

    string GetStatusIcon(string? status)
    {
        return GetStatusText(status) switch
        {
            "Chờ xác nhận" => "bi-hourglass-split",
            "Đã xác nhận" => "bi-calendar-check-fill",
            "Đang dời lịch" => "bi-clock-history",
            "Đã hoàn tất" => "bi-check-circle-fill",
            "Đã hủy" => "bi-x-circle-fill",
            "Khách không đến" => "bi-person-x-fill",
            _ => "bi-hourglass-split"
        };
    }

    string GetResultText(string? resultStatus)
    {
        if (string.IsNullOrWhiteSpace(resultStatus)) return "";

        return resultStatus.Trim() switch
        {
            "Interested" => "Khách quan tâm",
            "NotInterested" => "Khách không quan tâm",
            "DepositPending" => "Chờ đặt cọc",
            "FollowUp" => "Cần chăm sóc thêm",
            "Khách quan tâm" => "Khách quan tâm",
            "Khách không quan tâm" => "Khách không quan tâm",
            "Chờ đặt cọc" => "Chờ đặt cọc",
            "Cần chăm sóc thêm" => "Cần chăm sóc thêm",
            _ => ""
        };
    }

    string GetSourceName(Appointment a)
    {
        return a.Property?.Title
            ?? a.Project?.ProjectName
            ?? a.Lead?.Project?.ProjectName
            ?? "Bất động sản / dự án";
    }

    string GetSourceUrl(Appointment a)
    {
        if (a.PropertyID.HasValue && a.PropertyID.Value > 0)
        {
            return $"/Property/Details/{a.PropertyID.Value}";
        }

        if (a.ProjectID.HasValue && a.ProjectID.Value > 0)
        {
            return $"/Project/Details/{a.ProjectID.Value}";
        }

        if (a.Lead?.Project != null && a.Lead.Project.ProjectID > 0)
        {
            return $"/Project/Details/{a.Lead.Project.ProjectID}";
        }

        return string.Empty;
    }

    string GetCustomerName(Appointment a)
    {
        return !string.IsNullOrWhiteSpace(a.CustomerName)
            ? a.CustomerName
            : (a.Buyer?.Username ?? "Khách chưa rõ tên");
    }

    string GetRoleText(bool isSeller, bool isBuyer)
    {
        if (isSeller && isBuyer) return "Lịch nội bộ dự án";
        if (isSeller) return isBusinessMode ? "Khách hẹn dự án" : "Khách hẹn bạn";
        if (isBuyer) return "Bạn đặt lịch";
        return "Lịch hẹn";
    }

    string GetRoleClass(bool isSeller, bool isBuyer)
    {
        if (isSeller) return "role-in";
        if (isBuyer) return "role-out";
        return "role-mid";
    }

    bool IsClosedStatus(string statusText)
    {
        return statusText == "Đã hoàn tất"
            || statusText == "Đã hủy"
            || statusText == "Khách không đến";
    }

    bool CanDispatch(string statusText, bool isSeller)
    {
        return isBusinessMode
            && isSeller
            && (statusText == "Chờ xác nhận" || statusText == "Đã xác nhận");
    }

    string GetNextActionText(string statusText, bool isSeller, bool isBuyer, bool hasResult, bool hasStaff)
    {
        if (isSeller)
        {
            if (isBusinessMode)
            {
                return statusText switch
                {
                    "Chờ xác nhận" => hasStaff
                        ? "Đã có nhân viên phụ trách. Có thể bấm Điều phối lại hoặc xác nhận theo lịch đã hẹn."
                        : "Bước 1: Điều phối nhân viên. Nếu điều phối khi lịch còn chờ, hệ thống tự chuyển sang Đã xác nhận.",
                    "Đã xác nhận" when !hasResult => "Bước 2: Khách đến xem theo giờ hẹn, sau đó cập nhật kết quả buổi hẹn. Không còn dời lịch hoặc từ chối.",
                    "Đã xác nhận" => "Bước 3: Đã có kết quả. Có thể sửa kết quả nếu cần hoặc bấm Hoàn tất để khóa lịch.",
                    "Đang dời lịch" => "Đang chờ khách phản hồi giờ mới. Người phụ trách tạm thời không xử lý lùi trạng thái.",
                    "Đã hoàn tất" => "Lịch đã hoàn tất và bị khóa để lưu lịch sử.",
                    "Đã hủy" => "Lịch đã hủy và bị khóa.",
                    "Khách không đến" => "Lịch đã đóng do khách không đến.",
                    _ => "Cần kiểm tra lại trạng thái lịch hẹn."
                };
            }

            return statusText switch
            {
                "Chờ xác nhận" => "Bước 1: Xác nhận nếu đi xem được. Nếu chưa xác nhận thì có thể dời lịch hoặc từ chối.",
                "Đã xác nhận" when !hasResult => "Bước 2: Sau khi gặp khách, cập nhật kết quả buổi hẹn. Dời lịch và từ chối đã bị khóa.",
                "Đã xác nhận" => "Bước 3: Đã có kết quả. Có thể sửa kết quả hoặc bấm Hoàn tất để khóa lịch.",
                "Đang dời lịch" => "Đang chờ khách xác nhận giờ mới. Không xử lý lùi trạng thái.",
                "Đã hoàn tất" => "Lịch đã hoàn tất và bị khóa để lưu lịch sử.",
                "Đã hủy" => "Lịch đã hủy và bị khóa.",
                "Khách không đến" => "Lịch đã đóng do khách không đến.",
                _ => "Cần kiểm tra lại trạng thái lịch hẹn."
            };
        }

        if (isBuyer)
        {
            return statusText switch
            {
                "Chờ xác nhận" => "Bạn đã gửi lịch hẹn. Có thể hủy yêu cầu nếu không còn nhu cầu.",
                "Đã xác nhận" => "Lịch đã được xác nhận. Hãy đến đúng giờ hoặc liên hệ người bán nếu có thay đổi.",
                "Đang dời lịch" => "Người bán đề xuất giờ mới. Bạn cần đồng ý hoặc không đồng ý.",
                "Đã hoàn tất" => "Lịch đã hoàn tất.",
                "Đã hủy" => "Lịch đã hủy.",
                "Khách không đến" => "Lịch được ghi nhận khách không đến.",
                _ => "Theo dõi trạng thái lịch hẹn."
            };
        }

        return "Theo dõi trạng thái lịch hẹn.";
    }

    bool IsSellerInternalNoteLine(string? line)
    {
        if (string.IsNullOrWhiteSpace(line))
        {
            return false;
        }

        string value = line.Trim();

        return value.Contains("Điều phối nhân viên:", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Ghi chú điều phối", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Chủ đầu tư", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Người bán", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Người phụ trách", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Cập nhật kết quả", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Đổi kết quả", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Đánh dấu khách không đến", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Từ chối lịch", StringComparison.OrdinalIgnoreCase)
            || value.Contains("Đề xuất giờ", StringComparison.OrdinalIgnoreCase);
    }

    string GetBuyerVisibleAppointmentNote(string? note)
    {
        if (string.IsNullOrWhiteSpace(note))
        {
            return string.Empty;
        }

        var lines = note
            .Replace("\r", "")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Where(x => !IsSellerInternalNoteLine(x))
            .ToList();

        return string.Join(Environment.NewLine, lines);
    }

    string GetSellerInternalAppointmentNote(string? note)
    {
        if (string.IsNullOrWhiteSpace(note))
        {
            return string.Empty;
        }

        var lines = note
            .Replace("\r", "")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Where(IsSellerInternalNoteLine)
            .ToList();

        return string.Join(Environment.NewLine, lines);
    }

}

