                            <i class="bi bi-telephone-fill text-success"></i>
                            <div>
                                <strong>SĐT:</strong>
                                @(string.IsNullOrWhiteSpace(a.CustomerPhone) ? "Chưa có" : a.CustomerPhone)
                            </div>
                        </div>

                        <div class="mobile-line">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <div>
                                <strong>Điểm hẹn:</strong>
                                @(string.IsNullOrWhiteSpace(a.MeetingLocation) ? "Chưa cung cấp" : a.MeetingLocation)
                            </div>
                        </div>

                        @if (a.ProposedAppointmentDate.HasValue)
                        {
                            <div class="lich-note">
                                <i class="bi bi-arrow-right-circle"></i>
                                Giờ đề xuất mới:
                                @a.ProposedAppointmentDate.Value.ToString("HH:mm - dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
