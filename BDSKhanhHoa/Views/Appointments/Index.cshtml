                                    <button type="button"
                                            class="btn btn-outline-danger nut-thao-tac"
                                            onclick="openRejectModal(@a.AppointmentID, 'Hủy lịch đã đặt')">
                                        <i class="bi bi-trash-fill"></i>
                                        Hủy yêu cầu
                                    </button>
                                }
                                else if (statusText == "Đang dời lịch")
                                {
                                    <button type="button"
                                            class="btn btn-success nut-thao-tac"
                                            onclick="postAction('@Url.Action("BuyerAcceptReschedule", "Appointments")', @a.AppointmentID, 'Bạn đồng ý với giờ dời lịch do người bán đề xuất?')">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Đồng ý giờ mới
                                    </button>

                                    <button type="button"
                                            class="btn btn-danger nut-thao-tac"
                                            onclick="openRejectModal(@a.AppointmentID, 'Từ chối giờ dời lịch')">
                                        <i class="bi bi-x-circle-fill"></i>
                                        Không đồng ý
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="lich-empty">
                    <i class="bi bi-calendar-x display-1 opacity-25 d-block mb-3"></i>
                    <h5 class="fw-bold">Chưa có lịch hẹn phù hợp</h5>
                    <div>Hãy thử đổi bộ lọc hoặc kiểm tra lại từ khóa tìm kiếm.</div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="p-4 border-top">
                <nav class="d-flex justify-content-center">
                    <ul class="pagination phan-trang mb-0 flex-wrap justify-content-center">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new { page = currentPage - 1, tab = activeTab, statusFilter = statusFilter, keyword = keyword, dateRange = dateRange, mode = appointmentMode })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new { page = i, tab = activeTab, statusFilter = statusFilter, keyword = keyword, dateRange = dateRange, mode = appointmentMode })">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new { page = currentPage + 1, tab = activeTab, statusFilter = statusFilter, keyword = keyword, dateRange = dateRange, mode = appointmentMode })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
