@model IEnumerable<BDSKhanhHoa.Models.Appointment>
@using System.Globalization

@{
    var appointmentMode = (ViewBag.AppointmentMode as string ?? "CaNhan").Trim();
    bool isBusinessMode = appointmentMode.Equals("DoanhNghiep", StringComparison.OrdinalIgnoreCase)
                       || appointmentMode.Equals("Business", StringComparison.OrdinalIgnoreCase);

    Layout = isBusinessMode
        ? "~/Views/Shared/_BusinessLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = isBusinessMode ? "Quản lý lịch hẹn dự án" : "Lịch hẹn của tôi";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int currentUserId = ViewBag.CurrentUserId ?? 0;

    int totalAppointments = ViewBag.TotalAppointments ?? 0;
    int pendingAppointments = ViewBag.PendingAppointments ?? 0;
    int confirmedAppointments = ViewBag.ConfirmedAppointments ?? 0;
    int completedAppointments = ViewBag.CompletedAppointments ?? 0;
    int cancelledAppointments = ViewBag.CancelledAppointments ?? 0;
    int todayAppointments = ViewBag.TodayAppointments ?? 0;

    string activeTab = ViewBag.ActiveTab as string ?? "tat-ca";
    string statusFilter = ViewBag.StatusFilter as string ?? "Tất cả";
    string keyword = ViewBag.Keyword as string ?? "";
    string dateRange = ViewBag.DateRange as string ?? "tat-ca";

    string GetStatusText(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "Chờ xác nhận";

        return status.Trim() switch
        {
            "Pending" => "Chờ xác nhận",
            "Confirmed" => "Đã xác nhận",
            "Cancelled" => "Đã hủy",
            "Completed" => "Đã hoàn tất",
            "Rescheduled" => "Đang dời lịch",
            "NoShow" => "Khách không đến",

            "Chờ xác nhận" => "Chờ xác nhận",
            "Đã xác nhận" => "Đã xác nhận",
            "Đã hủy" => "Đã hủy",
            "Đã hoàn tất" => "Đã hoàn tất",
            "Đang dời lịch" => "Đang dời lịch",
            "Khách không đến" => "Khách không đến",

            _ => "Chờ xác nhận"
        };
    }

    string GetStatusClass(string? status)
    {
        string text = GetStatusText(status);

        return text switch
        {
            "Chờ xác nhận" => "trang-thai-cho",
            "Đã xác nhận" => "trang-thai-xac-nhan",
            "Đã hủy" => "trang-thai-huy",
            "Đã hoàn tất" => "trang-thai-hoan-tat",
            "Đang dời lịch" => "trang-thai-doi-lich",
            "Khách không đến" => "trang-thai-huy",
            _ => "trang-thai-cho"
        };
    }

    string GetResultText(string? resultStatus)
    {
        if (string.IsNullOrWhiteSpace(resultStatus)) return "";

        return resultStatus.Trim() switch
        {
            "Interested" => "Khách quan tâm",
            "NotInterested" => "Khách không quan tâm",
            "DepositPending" => "Chờ đặt cọc",
            "FollowUp" => "Cần chăm sóc thêm",

            "Khách quan tâm" => "Khách quan tâm",
            "Khách không quan tâm" => "Khách không quan tâm",
            "Chờ đặt cọc" => "Chờ đặt cọc",
            "Cần chăm sóc thêm" => "Cần chăm sóc thêm",

            _ => ""
        };
    }
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    :root {
        --lich-primary: #2563eb;
        --lich-primary-dark: #1d4ed8;
        --lich-success: #059669;
        --lich-warning: #d97706;
        --lich-danger: #dc2626;
        --lich-muted: #64748b;
        --lich-dark: #0f172a;
        --lich-border: #e2e8f0;
        --lich-soft: #f8fafc;
        --lich-card: #ffffff;
    }

    .lich-page {
        padding: 24px 0 40px;
    }

    .lich-hero,
    .lich-filter,
    .lich-card-box {
        background: var(--lich-card);
        border: 1px solid rgba(148, 163, 184, .18);
        box-shadow: 0 14px 40px rgba(15, 23, 42, .06);
        border-radius: 24px;
    }

    .lich-hero {
        padding: 26px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
    }

    .lich-title {
        font-size: clamp(1.35rem, 2.4vw, 2rem);
        font-weight: 900;
        color: var(--lich-dark);
        margin: 0 0 6px;
        letter-spacing: -.03em;
    }

    .lich-subtitle {
        color: var(--lich-muted);
        margin: 0;
        font-size: .98rem;
        line-height: 1.6;
    }

    .lich-quick {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .lich-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid var(--lich-border);
        color: #334155;
        font-weight: 800;
        white-space: nowrap;
    }

    .lich-stats {
        margin-bottom: 24px;
    }

    .lich-stat {
        height: 100%;
        min-height: 132px;
        border-radius: 24px;
        padding: 22px;
        color: #fff;
        overflow: hidden;
        position: relative;
        box-shadow: 0 16px 34px rgba(15, 23, 42, .10);
    }

        .lich-stat::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -35px;
            top: -35px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .16);
        }

    .lich-stat-label {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-weight: 900;
        opacity: .92;
        margin-bottom: 14px;
    }

    .lich-stat-value {
        font-size: 2.6rem;
        font-weight: 950;
        line-height: 1;
    }

    .nen-tong {
        background: linear-gradient(135deg, #1d4ed8, #60a5fa);
    }

    .nen-cho {
        background: linear-gradient(135deg, #b45309, #f59e0b);
    }

    .nen-xac-nhan {
        background: linear-gradient(135deg, #0f766e, #2dd4bf);
    }

    .nen-hoan-tat {
        background: linear-gradient(135deg, #047857, #34d399);
    }

    .nen-huy {
        background: linear-gradient(135deg, #475569, #94a3b8);
    }

    .lich-filter {
        padding: 24px;
        margin-bottom: 24px;
    }

    .lich-label {
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #475569;
        margin-bottom: 8px;
    }

    .lich-input {
        min-height: 50px;
        border-radius: 15px;
        border: 1px solid #dbe3ef;
        box-shadow: none !important;
        font-weight: 700;
        color: #1e293b;
    }

        .lich-input:focus {
            border-color: var(--lich-primary);
        }

    .btn-loc {
        min-height: 50px;
        border-radius: 15px;
        border: 0;
        font-weight: 900;
        background: linear-gradient(135deg, var(--lich-primary), var(--lich-primary-dark));
        color: #fff;
    }

    .lich-card-box {
        overflow: hidden;
    }

    .lich-table {
        margin-bottom: 0;
    }

        .lich-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            font-weight: 900;
            padding: 18px;
            border-bottom: 1px solid var(--lich-border);
            white-space: nowrap;
        }

        .lich-table tbody td {
            padding: 18px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .lich-table tbody tr:hover {
            background: #f8fafc;
        }

    .lich-time {
        font-weight: 900;
        color: var(--lich-primary);
        font-size: 1rem;
    }

    .lich-source {
        margin-top: 10px;
        padding: 10px 12px;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .lich-source-label {
        font-size: .76rem;
        font-weight: 900;
        text-transform: uppercase;
        color: #64748b;
        margin-bottom: 4px;
    }

    .lich-source-name {
        font-weight: 850;
        color: #0f172a;
        line-height: 1.45;
    }

    .lich-person {
        font-size: 1.02rem;
        color: var(--lich-dark);
        font-weight: 900;
        margin-bottom: 6px;
    }

    .lich-small {
        color: #64748b;
        font-size: .9rem;
        line-height: 1.55;
    }

    .trang-thai {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: .78rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .trang-thai-cho {
        background: #fff7ed;
        color: #c2410c;
    }

    .trang-thai-xac-nhan {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .trang-thai-doi-lich {
        background: #fef3c7;
        color: #b45309;
    }

    .trang-thai-hoan-tat {
        background: #dcfce7;
        color: #047857;
    }

    .trang-thai-huy {
        background: #f1f5f9;
        color: #64748b;
        text-decoration: line-through;
    }

    .vai-tro {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 900;
        margin-left: 6px;
    }

    .vai-tro-den {
        background: #e0f2fe;
        color: #0369a1;
    }

    .vai-tro-di {
        background: #f0fdf4;
        color: #047857;
    }

    .lich-note {
        margin-top: 10px;
        padding: 10px 12px;
        border-radius: 14px;
        background: #fffbeb;
        border: 1px solid #fde68a;
        color: #78350f;
        font-size: .88rem;
        font-weight: 700;
        line-height: 1.55;
    }

    .ket-qua-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid var(--lich-border);
        color: #334155;
        font-size: .82rem;
        font-weight: 850;
    }

    .nut-thao-tac {
        border-radius: 13px;
        font-weight: 850;
        min-height: 42px;
        padding-left: 14px;
        padding-right: 14px;
    }

    .lich-empty {
        padding: 70px 24px;
        text-align: center;
        color: #64748b;
    }

    .lich-mobile-list {
        display: none;
    }

    .lich-mobile-card {
        background: #fff;
        border-radius: 22px;
        border: 1px solid rgba(148, 163, 184, .22);
        padding: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, .06);
        margin-bottom: 16px;
    }

    .mobile-line {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        color: #475569;
        font-size: .92rem;
        line-height: 1.55;
        margin-top: 9px;
    }

    .phan-trang .page-link {
        border: 1px solid #dbe3ef;
        color: #334155;
        font-weight: 900;
        border-radius: 14px;
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 4px;
    }

    .phan-trang .page-item.active .page-link {
        background: linear-gradient(135deg, var(--lich-primary), var(--lich-primary-dark));
        color: #fff;
        border-color: transparent;
    }

    .modal-content {
        border-radius: 24px;
        overflow: hidden;
    }

    @@media (max-width: 991.98px) {
        .lich-hero {
            padding: 22px;
        }

        .lich-quick {
            width: 100%;
        }

        .lich-chip {
            flex: 1 1 auto;
            justify-content: center;
        }

        .lich-stat {
            min-height: 112px;
        }

        .lich-stat-value {
            font-size: 2.2rem;
        }

        .desktop-table-wrap {
            display: none;
        }

        .lich-mobile-list {
            display: block;
            padding: 16px;
            background: #f8fafc;
        }
    }

    @@media (max-width: 575.98px) {
        .lich-page {
            padding-top: 14px;
        }

        .lich-hero,
        .lich-filter {
            border-radius: 20px;
            padding: 18px;
        }

        .lich-title {
            font-size: 1.35rem;
        }

        .lich-subtitle {
            font-size: .9rem;
        }

        .lich-chip {
            width: 100%;
        }

        .lich-stat {
            border-radius: 20px;
            padding: 18px;
        }

        .lich-mobile-list {
            padding: 12px;
        }

        .lich-mobile-card {
            border-radius: 20px;
            padding: 16px;
        }

        .nut-thao-tac {
            width: 100%;
        }
    }
</style>

<div class="container lich-page">

    <div class="lich-hero">
        <div>
            <h1 class="lich-title">@(isBusinessMode ? "Quản lý lịch hẹn dự án" : "Lịch hẹn của tôi")</h1>
            <p class="lich-subtitle">
                Theo dõi lịch hẹn, xác nhận khách xem nhà, đề xuất dời lịch và cập nhật kết quả sau buổi gặp.
            </p>
        </div>

        <div class="lich-quick">
            <span class="lich-chip">
                <i class="bi bi-calendar2-week text-primary"></i>
                @totalAppointments lịch hẹn
            </span>
            <span class="lich-chip">
                <i class="bi bi-clock-history text-warning"></i>
                @todayAppointments hôm nay
            </span>
        </div>
    </div>

    <div class="row g-3 lich-stats">
        <div class="col-xl-2 col-lg-4 col-md-6 col-6">
            <div class="lich-stat nen-tong">
                <div class="lich-stat-label">Tổng lịch</div>
                <div class="lich-stat-value">@totalAppointments</div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-6 col-6">
            <div class="lich-stat nen-cho">
                <div class="lich-stat-label">Chờ xử lý</div>
                <div class="lich-stat-value">@pendingAppointments</div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-6 col-6">
            <div class="lich-stat nen-xac-nhan">
                <div class="lich-stat-label">Đã xác nhận</div>
                <div class="lich-stat-value">@confirmedAppointments</div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-6 col-6">
            <div class="lich-stat nen-hoan-tat">
                <div class="lich-stat-label">Hoàn tất</div>
                <div class="lich-stat-value">@completedAppointments</div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-6 col-6">
            <div class="lich-stat nen-huy">
                <div class="lich-stat-label">Đã hủy</div>
                <div class="lich-stat-value">@cancelledAppointments</div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-4 col-md-6 col-6">
            <div class="lich-stat nen-tong">
                <div class="lich-stat-label">Hôm nay</div>
                <div class="lich-stat-value">@todayAppointments</div>
            </div>
        </div>
    </div>

    <div class="lich-filter">
        <form method="get" asp-action="Index" asp-controller="Appointments" class="row g-3 align-items-end">
            <input type="hidden" name="mode" value="@appointmentMode" />

            <div class="col-xl-2 col-lg-3 col-md-6">
                <label class="form-label lich-label">Phân loại</label>
                <select name="tab" class="form-select lich-input">
                    <option value="tat-ca" selected="@(activeTab == "tat-ca" || activeTab == "all")">Tất cả lịch</option>
                    <option value="lich-den" selected="@(activeTab == "lich-den" || activeTab == "incoming")">Khách hẹn mình</option>
                    <option value="lich-di" selected="@(activeTab == "lich-di" || activeTab == "outgoing")">Mình đặt lịch</option>
                    <option value="sap-toi" selected="@(activeTab == "sap-toi" || activeTab == "upcoming")">Sắp tới</option>
                    <option value="hoan-tat" selected="@(activeTab == "hoan-tat" || activeTab == "completed")">Hoàn tất</option>
                    <option value="da-huy" selected="@(activeTab == "da-huy" || activeTab == "cancelled")">Đã hủy</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-6">
                <label class="form-label lich-label">Trạng thái</label>
                <select name="statusFilter" class="form-select lich-input">
                    <option value="Tất cả" selected="@(statusFilter == "Tất cả" || statusFilter == "All")">Tất cả</option>
                    <option value="Chờ xác nhận" selected="@(statusFilter == "Chờ xác nhận" || statusFilter == "Pending")">Chờ xác nhận</option>
                    <option value="Đang dời lịch" selected="@(statusFilter == "Đang dời lịch" || statusFilter == "Rescheduled")">Đang dời lịch</option>
                    <option value="Đã xác nhận" selected="@(statusFilter == "Đã xác nhận" || statusFilter == "Confirmed")">Đã xác nhận</option>
                    <option value="Đã hoàn tất" selected="@(statusFilter == "Đã hoàn tất" || statusFilter == "Completed")">Đã hoàn tất</option>
                    <option value="Đã hủy" selected="@(statusFilter == "Đã hủy" || statusFilter == "Cancelled")">Đã hủy</option>
                </select>
            </div>

            <div class="col-xl-2 col-lg-3 col-md-6">
                <label class="form-label lich-label">Thời gian</label>
                <select name="dateRange" class="form-select lich-input">
                    <option value="tat-ca" selected="@(dateRange == "tat-ca" || dateRange == "all")">Toàn thời gian</option>
                    <option value="hom-nay" selected="@(dateRange == "hom-nay" || dateRange == "today")">Hôm nay</option>
                    <option value="7-ngay" selected="@(dateRange == "7-ngay" || dateRange == "week")">7 ngày qua</option>
                    <option value="30-ngay" selected="@(dateRange == "30-ngay" || dateRange == "month")">30 ngày qua</option>
                </select>
            </div>

            <div class="col-xl-5 col-lg-9 col-md-12">
                <label class="form-label lich-label">Từ khóa</label>
                <input type="text"
                       name="keyword"
                       value="@keyword"
                       class="form-control lich-input"
                       placeholder="Nhập tên khách, số điện thoại, điểm hẹn, ghi chú, tiêu đề BĐS..." />
            </div>

            <div class="col-xl-1 col-lg-3 col-md-12 d-grid">
                <button type="submit" class="btn btn-loc">
                    <i class="bi bi-search"></i>
                    Lọc
                </button>
            </div>
        </form>
    </div>

    <div class="lich-card-box mb-5">

        <div class="desktop-table-wrap table-responsive">
            <table class="table lich-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 25%;">Thời gian & nguồn</th>
                        <th style="width: 25%;">Khách hàng & điểm hẹn</th>
                        <th style="width: 30%;">Trạng thái & ghi chú</th>
                        <th style="width: 20%;" class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var a in Model)
                        {
                            bool isSeller = a.SellerID == currentUserId;
                            bool isBuyer = a.BuyerID == currentUserId;

                            string customerName = !string.IsNullOrWhiteSpace(a.CustomerName)
                            ? a.CustomerName
                            : (a.Buyer?.Username ?? "Khách chưa rõ tên");

                            string sourceName = a.Property?.Title
                            ?? a.Project?.ProjectName
                            ?? a.Lead?.Project?.ProjectName
                            ?? "Bất động sản";

                            string statusText = GetStatusText(a.Status);
                            string statusClass = GetStatusClass(a.Status);
                            string resultText = GetResultText(a.ResultStatus);

                            <tr>
                                <td>
                                    <div class="lich-time">
                                        <i class="bi bi-calendar-check me-1"></i>
                                        @a.AppointmentDate.ToString("HH:mm - dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
                                    </div>

                                    @if (a.ProposedAppointmentDate.HasValue)
                                    {
                                        <div class="mt-2 text-danger small fw-bold">
                                            <i class="bi bi-arrow-right-circle"></i>
                                            Giờ đề xuất mới:
                                            @a.ProposedAppointmentDate.Value.ToString("HH:mm - dd/MM/yyyy", CultureInfo.GetCultureInfo("vi-VN"))
                                        </div>
                                    }

                                    <div class="lich-source">
                                        <div class="lich-source-label">Nguồn lịch hẹn</div>
                                        <div class="lich-source-name">@sourceName</div>
                                    </div>
                                </td>

                                <td>
                                    <div class="lich-person">@customerName</div>

                                    <div class="lich-small">
                                        <i class="bi bi-telephone-fill text-success me-1"></i>
                                        @(string.IsNullOrWhiteSpace(a.CustomerPhone) ? "Chưa có số điện thoại" : a.CustomerPhone)
                                    </div>

                                    <div class="lich-small mt-1">
                                        <i class="bi bi-envelope-fill text-primary me-1"></i>
                                        @(string.IsNullOrWhiteSpace(a.CustomerEmail) ? "Chưa có email" : a.CustomerEmail)
                                    </div>

                                    <div class="lich-small mt-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        @(string.IsNullOrWhiteSpace(a.MeetingLocation) ? "Chưa cung cấp điểm hẹn" : a.MeetingLocation)
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(a.Note))
                                    {
                                        <div class="mt-2 text-muted small fst-italic">
                                            “@a.Note”
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                                        <span class="trang-thai @statusClass">
                                            <i class="bi bi-circle-fill" style="font-size:.45rem;"></i>
                                            @statusText
                                        </span>

                                        @if (isSeller)
                                        {
                                            <span class="vai-tro vai-tro-den">Khách hẹn bạn</span>
                                        }

                                        @if (isBuyer)
                                        {
                                            <span class="vai-tro vai-tro-di">Bạn đặt lịch</span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(a.NegotiationNote))
                                    {
                                        <div class="lich-note">
                                            <i class="bi bi-chat-left-dots-fill me-1"></i>
                                            @a.NegotiationNote
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(resultText))
                                    {
                                        <div class="mt-2">
                                            <span class="ket-qua-pill">
                                                <i class="bi bi-bookmark-check-fill text-success"></i>
