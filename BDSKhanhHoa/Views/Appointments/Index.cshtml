                                        @if (isBuyer)
                                        {
                                            if (statusText == "Chờ xác nhận")
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger nut-thao-tac w-100"
                                                        onclick="openRejectModal(@a.AppointmentID, 'Hủy lịch đã đặt')">
                                                    <i class="bi bi-trash-fill"></i>
                                                    Hủy yêu cầu
                                                </button>
                                            }
                                            else if (statusText == "Đang dời lịch")
                                            {
                                                <button type="button"
                                                        class="btn btn-success nut-thao-tac w-100"
                                                        onclick="postAction('@Url.Action("BuyerAcceptReschedule", "Appointments")', @a.AppointmentID, 'Bạn đồng ý với giờ dời lịch do người bán đề xuất?')">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Đồng ý giờ mới
                                                </button>

                                                <button type="button"
                                                        class="btn btn-danger nut-thao-tac w-100"
                                                        onclick="openRejectModal(@a.AppointmentID, 'Từ chối giờ dời lịch')">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    Không đồng ý
                                                </button>
                                            }
                                            else if (statusText == "Đã xác nhận")
                                            {
                                                <span class="text-success small fw-bold">
                                                    <i class="bi bi-shield-fill-check"></i>
                                                    Đã được xác nhận
                                                </span>
                                            }
                                        }

                                        @if (statusText == "Đã hoàn tất" || statusText == "Đã hủy" || statusText == "Khách không đến")
                                        {
                                            <span class="text-muted small fw-bold">
                                                <i class="bi bi-lock-fill"></i>
                                                Lịch đã đóng
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">
                                <div class="lich-empty">
                                    <i class="bi bi-calendar-x display-1 opacity-25 d-block mb-3"></i>
                                    <h5 class="fw-bold">Chưa có lịch hẹn phù hợp</h5>
                                    <div>Hãy thử đổi bộ lọc hoặc kiểm tra lại từ khóa tìm kiếm.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="lich-mobile-list">
            @if (Model != null && Model.Any())
            {
                foreach (var a in Model)
                {
                    bool isSeller = a.SellerID == currentUserId;
                    bool isBuyer = a.BuyerID == currentUserId;

                    string customerName = !string.IsNullOrWhiteSpace(a.CustomerName)
                    ? a.CustomerName
                    : (a.Buyer?.Username ?? "Khách chưa rõ tên");

                    string sourceName = a.Property?.Title
                    ?? a.Project?.ProjectName
                    ?? a.Lead?.Project?.ProjectName
                    ?? "Bất động sản";

                    string statusText = GetStatusText(a.Status);
                    string statusClass = GetStatusClass(a.Status);
                    string resultText = GetResultText(a.ResultStatus);

                    <div class="lich-mobile-card">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
