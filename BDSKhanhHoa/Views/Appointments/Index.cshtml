                                            </span>

                                            @if (!string.IsNullOrWhiteSpace(a.ResultNote))
                                            {
                                                <div class="text-muted small mt-2">@a.ResultNote</div>
                                            }
                                        </div>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="d-flex flex-column gap-2 align-items-center">

                                        @if (isSeller)
                                        {
                                            if (statusText == "Chờ xác nhận")
                                            {
                                                <button type="button"
                                                        class="btn btn-success nut-thao-tac w-100"
                                                        onclick="postAction('@Url.Action("SellerAccept", "Appointments")', @a.AppointmentID, 'Bạn có chắc muốn xác nhận lịch hẹn này?')">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Xác nhận
                                                </button>

                                                <button type="button"
                                                        class="btn btn-warning text-dark nut-thao-tac w-100"
                                                        onclick="openRescheduleModal(@a.AppointmentID)">
                                                    <i class="bi bi-clock-history"></i>
                                                    Dời lịch
                                                </button>

                                                <button type="button"
                                                        class="btn btn-danger nut-thao-tac w-100"
                                                        onclick="openRejectModal(@a.AppointmentID, 'Từ chối lịch hẹn')">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                    Từ chối
                                                </button>
                                            }
                                            else if (statusText == "Đã xác nhận")
                                            {
                                                <button type="button"
                                                        class="btn btn-primary nut-thao-tac w-100"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#feedbackModal"
                                                        data-id="@a.AppointmentID">
                                                    <i class="bi bi-clipboard-check"></i>
                                                    Chốt kết quả
                                                </button>
                                            }
                                            else if (statusText == "Đang dời lịch")
                                            {
                                                <span class="text-muted small fw-bold">
                                                    <i class="bi bi-hourglass-split"></i>
                                                    Chờ khách xác nhận giờ mới
                                                </span>
                                            }
