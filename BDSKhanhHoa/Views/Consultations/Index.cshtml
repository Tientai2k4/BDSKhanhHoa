            white-space: normal;
            text-align: left;
        }
    }

</style>

<div class="container-fluid px-0 crm-page">
    <div class="crm-hero mb-4">
        <div class="position-relative" style="z-index:2;">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-bold">
                    <i class="bi bi-headset me-1"></i> CRM tư vấn
                </span>
                <span class="badge bg-success bg-opacity-25 text-white rounded-pill px-3 py-2 fw-bold">
                    Tự động nhận khách
                </span>
            </div>

            <h2 class="crm-hero-title">Quản lý khách hàng cần tư vấn</h2>

            <p class="crm-hero-sub mb-0">
                Theo dõi toàn bộ khách quan tâm tin đăng/dự án, cập nhật trạng thái gọi điện, ghi chú chăm sóc và khóa các lead đã hủy để tránh xử lý sai.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="crm-stat-card p-3">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="crm-stat-label">Tổng lead</div>
                        <div class="crm-stat-value mt-2">@totalLeads</div>
                    </div>
                    <div class="crm-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="crm-stat-card p-3">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="crm-stat-label">Mới gửi</div>
                        <div class="crm-stat-value mt-2">@newLeads</div>
                    </div>
                    <div class="crm-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="crm-stat-card p-3">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="crm-stat-label">Đã xử lý</div>
                        <div class="crm-stat-value mt-2">@processedLeads</div>
                    </div>
                    <div class="crm-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="crm-stat-card p-3">
                <div class="d-flex justify-content-between gap-3">
                    <div>
                        <div class="crm-stat-label">Tỷ lệ phản hồi</div>
                        <div class="crm-stat-value mt-2">@responseRate%</div>
                    </div>
                    <div class="crm-stat-icon bg-dark bg-opacity-10 text-dark">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="crm-filter-card mb-4">
        <div class="p-3 p-lg-4">
            <form method="get" action="/Consultations/Index" class="row g-3 align-items-center">
                <div class="col-lg-5">
                    <div class="input-group input-group-lg crm-search-input">
                        <span class="input-group-text">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text"
                               name="searchString"
                               class="form-control fs-6"
                               placeholder="Tìm tên khách, SĐT, email, lời nhắn, tin đăng..."
                               value="@searchString" />
                    </div>
                </div>

                <div class="col-lg-3 col-12">
                    <select name="statusFilter" class="form-select form-select-lg rounded-4 fs-6 fw-bold border">
                        <option value="All" selected="@(statusFilter == "All")">Tất cả trạng thái</option>
                        <option value="New" selected="@(statusFilter == "New")">Mới gửi</option>
                        <option value="Contacted" selected="@(statusFilter == "Contacted")">Đã liên hệ</option>
                        <option value="Closed" selected="@(statusFilter == "Closed")">Hoàn tất tư vấn</option>
                        <option value="Spam" selected="@(statusFilter == "Spam")">Spam / Lead rác</option>
                        <option value="Cancelled" selected="@(statusFilter == "Cancelled")">Khách đã hủy</option>
                    </select>
                </div>

                <div class="col-lg-4 col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-4 fw-bold w-100">
                        <i class="bi bi-funnel-fill me-1"></i> Lọc dữ liệu
                    </button>
                    <a href="/Consultations/Index" class="btn btn-light btn-lg rounded-4 fw-bold border px-4">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="crm-list-card">
        <div class="p-3 p-lg-4 border-bottom bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="fw-black mb-1">
                        <i class="bi bi-list-check text-primary me-2"></i>Danh sách khách hàng tiềm năng
                    </h5>
                    <div class="text-muted small">
                        Lead mới được ưu tiên hiển thị trước. Lead Hoàn tất tư vấn, Spam hoặc khách đã hủy sẽ bị khóa xử lý.
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning px-3 py-2">Mới: @newLeads</span>
                    <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">Chốt: @closedLeads</span>
                    <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger px-3 py-2">Hủy: @cancelledLeads</span>
                </div>
            </div>
        </div>

        <div class="desktop-table-wrap table-responsive">
            <table class="table crm-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Khách hàng</th>
                        <th>Nguồn quan tâm</th>
                        <th>Lời nhắn / ghi chú</th>
                        <th>Trạng thái</th>
                        <th class="text-center pe-4">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            bool locked = IsLocked(item.Status);
                            bool canDelete = CanDelete(item.Status);

                            string customerInitial = !string.IsNullOrWhiteSpace(item.FullName)
                            ? item.FullName.Trim().Substring(0, 1).ToUpper()
                            : "K";

                            <tr id="row-@item.ConsultID">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="customer-avatar">@customerInitial</div>

                                        <div class="min-w-0">
                                            <div class="fw-black text-dark truncate-1" style="max-width:210px;">
                                                @(string.IsNullOrWhiteSpace(item.FullName) ? "Khách hàng" : item.FullName)
                                            </div>

                                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                                <a href="tel:@item.Phone" class="text-success text-decoration-none small fw-bold">
                                                    <i class="bi bi-telephone-fill"></i> @item.Phone
                                                </a>
                                            </div>

                                            <div class="crm-time-line">
                                                <span>
                                                    <i class="bi bi-send-check me-1"></i>Gửi: @item.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                                                </span>

                                                @if (item.UpdatedAt.HasValue)
                                                {
                                                    <span>
                                                        <i class="bi bi-clock-history me-1"></i>Xử lý: @item.UpdatedAt.Value.ToString("HH:mm dd/MM/yyyy")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        <i class="bi bi-hourglass-split me-1"></i>Chưa xử lý
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (item.Property != null)
                                    {
                                        <a href="/Property/Details/@item.PropertyID" class="source-link truncate-1" target="_blank">
                                            @item.Property.Title
                                        </a>
                                        <div class="mt-1">
                                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary">Nhà đất</span>
                                        </div>
                                    }
                                    else if (item.Project != null)
                                    {
                                        <a href="/Project/Details/@item.ProjectID" class="source-link truncate-1" target="_blank">
                                            @item.Project.ProjectName
                                        </a>
                                        <div class="mt-1">
                                            <span class="badge rounded-pill bg-info bg-opacity-10 text-info">Dự án</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Nguồn đã bị xóa</span>
                                    }
                                </td>

                                <td>
                                    <div class="crm-note-preview">
                                        <i class="bi bi-chat-left-text"></i>
                                        <span class="truncate-2">@(string.IsNullOrWhiteSpace(item.Note) ? "Khách không để lại lời nhắn." : item.Note)</span>
                                    </div>

                                    @{
                                        string sellerNoteClean = CleanSellerNote(item.SellerNote);
                                    }

                                    @if (!string.IsNullOrWhiteSpace(sellerNoteClean))
                                    {
                                        <div class="crm-seller-note-preview">
                                            <i class="bi bi-journal-text"></i>
                                            <span class="truncate-2">@sellerNoteClean</span>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex flex-column align-items-start gap-2">
                                        <span class="status-pill @GetStatusClass(item.Status)">
                                            <i class="bi @GetStatusIcon(item.Status)"></i>@GetStatusText(item.Status)
                                        </span>

                                        <span class="next-pill @GetNextActionClass(item.Status, item.UpdatedAt)">
                                            <i class="bi bi-flag-fill"></i>
                                            @GetNextActionText(item.Status, item.UpdatedAt)
                                        </span>
                                    </div>
                                </td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button type="button"
                                                class="crm-action-btn"
                                                onclick="openCRMModal(@item.ConsultID)"
                                                title="Xem / xử lý lead">
                                            <i class="bi @(locked ? "bi-eye-fill" : "bi-pencil-square")"></i>
                                        </button>

                                        <form class="m-0" id="frmDel-@item.ConsultID">
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="crm-action-btn danger"
                                                    onclick="deleteLead(@item.ConsultID)"
                                                    title="Chỉ xóa lead spam hoặc đã hủy"
                                                    disabled="@(!canDelete)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-inbox display-4 text-muted opacity-50"></i>
                                <h5 class="fw-black mt-3 mb-1">Chưa có yêu cầu tư vấn nào</h5>
                                <p class="text-muted mb-0">Khi khách gửi tư vấn từ tin đăng hoặc dự án, lead sẽ xuất hiện tại đây.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mobile-lead-card p-3">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    bool locked = IsLocked(item.Status);
                    bool canDelete = CanDelete(item.Status);

                    string customerInitial = !string.IsNullOrWhiteSpace(item.FullName)
                    ? item.FullName.Trim().Substring(0, 1).ToUpper()
                    : "K";

                    <div class="mobile-card-item" id="mobile-row-@item.ConsultID">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div class="d-flex gap-3 min-w-0">
                                <div class="customer-avatar">@customerInitial</div>

                                <div class="min-w-0">
                                    <div class="fw-black text-dark truncate-1">
                                        @(string.IsNullOrWhiteSpace(item.FullName) ? "Khách hàng" : item.FullName)
                                    </div>
                                    <a href="tel:@item.Phone" class="text-success text-decoration-none small fw-bold">
                                        <i class="bi bi-telephone-fill"></i> @item.Phone
                                    </a>
                                </div>
                            </div>

                            <div class="d-flex flex-column align-items-end gap-2">
                                <span class="status-pill @GetStatusClass(item.Status)">
                                    <i class="bi @GetStatusIcon(item.Status)"></i>@GetStatusText(item.Status)
                                </span>

                                <span class="next-pill @GetNextActionClass(item.Status, item.UpdatedAt)">
                                    <i class="bi bi-flag-fill"></i>
                                    @GetNextActionText(item.Status, item.UpdatedAt)
                                </span>
                            </div>
                        </div>

                        <div class="mb-3">
                            @if (item.Property != null)
                            {
                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary mb-2">Nhà đất</span>
                                <a href="/Property/Details/@item.PropertyID" class="source-link d-block" target="_blank">
                                    @item.Property.Title
                                </a>
                            }
                            else if (item.Project != null)
                            {
                                <span class="badge rounded-pill bg-info bg-opacity-10 text-info mb-2">Dự án</span>
                                <a href="/Project/Details/@item.ProjectID" class="source-link d-block" target="_blank">
                                    @item.Project.ProjectName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Nguồn đã bị xóa</span>
                            }
                        </div>

                        <div class="bg-light rounded-4 border p-3 mb-3">
                            <div class="small text-muted fw-bold mb-1">Lời nhắn</div>
                            <div class="small text-dark">
                                @(string.IsNullOrWhiteSpace(item.Note) ? "Khách không để lại lời nhắn." : item.Note)
                            </div>
                        </div>

                        @{
                            string sellerNoteCleanMobile = CleanSellerNote(item.SellerNote);
                        }

                        @if (!string.IsNullOrWhiteSpace(sellerNoteCleanMobile))
                        {
                            <div class="bg-warning bg-opacity-10 rounded-4 border border-warning border-opacity-25 p-3 mb-3">
                                <div class="small text-warning-emphasis fw-bold mb-1">
                                    <i class="bi bi-journal-text me-1"></i>Ghi chú chăm sóc
                                </div>
                                <div class="small text-dark" style="white-space:pre-wrap;">@sellerNoteCleanMobile</div>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="small text-muted fw-bold">
                                <div>
                                    <i class="bi bi-send-check me-1"></i>
                                    Gửi: @item.CreatedAt.ToString("HH:mm dd/MM/yyyy")
                                </div>

                                @if (item.UpdatedAt.HasValue)
                                {
                                    <div class="mt-1">
                                        <i class="bi bi-clock-history me-1"></i>
                                        Xử lý: @item.UpdatedAt.Value.ToString("HH:mm dd/MM/yyyy")
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-1">
                                        <i class="bi bi-hourglass-split me-1"></i>
                                        Chưa xử lý
                                    </div>
                                }

                                <div class="mt-2">
                                    <span class="next-pill @GetNextActionClass(item.Status, item.UpdatedAt)">
                                        <i class="bi bi-flag-fill"></i>
                                        @GetNextActionText(item.Status, item.UpdatedAt)
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-primary btn-sm rounded-pill fw-bold px-3" onclick="openCRMModal(@item.ConsultID)">
                                    <i class="bi @(locked ? "bi-eye-fill" : "bi-pencil-square") me-1"></i>@(locked ? "Xem" : "Xử lý")
                                </button>

                                <form class="m-0" id="frmDelMobile-@item.ConsultID">
                                    @Html.AntiForgeryToken()
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-3"
                                            onclick="deleteLead(@item.ConsultID)"
                                            disabled="@(!canDelete)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-4 text-muted opacity-50"></i>
                    <h5 class="fw-black mt-3 mb-1">Chưa có yêu cầu tư vấn nào</h5>
                    <p class="text-muted mb-0">Lead mới sẽ xuất hiện tại đây.</p>
                </div>
            }
        </div>

        @if (Convert.ToInt32(ViewBag.TotalPages ?? 1) > 1)
        {
            <div class="p-4 border-top bg-white">
                <nav class="d-flex justify-content-center">
                    <ul class="pagination mb-0 flex-wrap gap-1">
                        @for (int i = 1; i <= Convert.ToInt32(ViewBag.TotalPages); i++)
                        {
                            <li class="page-item @(Convert.ToInt32(ViewBag.CurrentPage) == i ? "active" : "")">
                                <a class="page-link rounded-3 border-0 shadow-sm @(Convert.ToInt32(ViewBag.CurrentPage) == i ? "bg-primary text-white" : "bg-light text-dark")"
                                   href="/Consultations/Index?page=@i&searchString=@Uri.EscapeDataString(searchString)&statusFilter=@statusFilter">
                                    @i
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade"
     id="crmModal"
     tabindex="-1"
     aria-hidden="true"
     data-bs-backdrop="false"
     data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header text-white border-0 px-4 py-3">
                <div>
                    <h5 class="modal-title fw-black mb-0">
                        <i class="bi bi-person-lines-fill me-2"></i>Chi tiết chăm sóc khách hàng
                    </h5>
                    <div class="small text-white-50">Cập nhật trạng thái đúng với thực tế xử lý.</div>
                </div>
                <button type="button" class="btn-close btn-close-white" onclick="closeCRMModal()" aria-label="Đóng"></button>
            </div>

            <div class="modal-body p-3 p-lg-4">
                <div class="lead-info-box mb-3">
                    <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                        <div>
                            <h5 id="md-name" class="fw-black text-primary mb-1">Khách hàng</h5>
                            <div class="d-flex flex-wrap gap-3">
                                <a href="#" id="md-phone" class="fw-bold text-success text-decoration-none">
                                    <i class="bi bi-telephone-fill"></i> <span></span>
                                </a>
                                <span id="md-email" class="text-muted fw-semibold">
                                    <i class="bi bi-envelope"></i> <span></span>
                                </span>
                            </div>
                        </div>

                        <div class="text-lg-end">
                            <span id="md-current-status" class="status-pill st-new">
                                <i class="bi bi-lightning-charge-fill"></i>Mới gửi
                            </span>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <div class="bg-light border rounded-4 p-3 h-100">
                                <div class="small text-muted fw-bold">Nguồn quan tâm</div>
                                <div id="md-source" class="fw-black text-dark mt-1"></div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bg-light border rounded-4 p-3 h-100">
                                <div class="small text-muted fw-bold">Ngày gửi</div>
                                <div id="md-created" class="fw-bold text-dark mt-1"></div>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="bg-light border rounded-4 p-3 h-100">
                                <div class="small text-muted fw-bold">Cập nhật</div>
                                <div id="md-updated" class="fw-bold text-dark mt-1"></div>
                            </div>
                        </div>
                    </div>

                    <div class="note-box">
                        <div class="small fw-black text-warning-emphasis mb-1">
                            <i class="bi bi-chat-left-quote me-1"></i>Lời nhắn từ khách
                        </div>
                        <div id="md-note" class="text-dark fw-medium"></div>
                    </div>
                </div>

                <div id="lockedBox" class="locked-box mb-3">
                    <i class="bi bi-lock-fill me-1"></i>
                    Khách đã hủy yêu cầu. Lead này bị khóa xử lý để tránh gọi nhầm hoặc cập nhật sai.
                </div>
                <div id="nextActionBox" class="crm-next-box mb-3">
                    <strong><i class="bi bi-flag-fill me-1"></i>Việc cần làm:</strong>
                    <span id="md-next-action">Đang tải...</span>
                </div>
                <form id="frmUpdateLead" method="post" action="/Consultations/SellerUpdateStatus">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="md-id" />

                    <div class="crm-process-box mb-3">
                        <div class="crm-process-title">
                            <i class="bi bi-diagram-3-fill text-primary"></i>
                            Quy trình chăm sóc lead
                        </div>

                        <div class="crm-status-flow" id="crmStatusFlow">
                            <div class="crm-flow-step" data-flow="New">
                                <div class="crm-flow-icon">
                                    <i class="bi bi-lightning-charge-fill"></i>
                                </div>
                                <div class="crm-flow-name">Mới gửi</div>
                                <div class="crm-flow-desc">Khách vừa để lại thông tin, chưa gọi.</div>
                            </div>

                            <div class="crm-flow-step" data-flow="Contacted">
                                <div class="crm-flow-icon">
                                    <i class="bi bi-telephone-inbound-fill"></i>
                                </div>
                                <div class="crm-flow-name">Đã tiếp nhận</div>
                                <div class="crm-flow-desc">Đã gọi, đang tư vấn hoặc theo dõi.</div>
                            </div>

                            <div class="crm-flow-step" data-flow="Closed">
                                <div class="crm-flow-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>
                                <div class="crm-flow-name">Hoàn tất</div>
                                <div class="crm-flow-desc">Đã tư vấn xong, kết thúc xử lý.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-black text-dark">
                            Chọn thao tác xử lý <span class="text-danger">*</span>
                        </label>

                        <input type="hidden" name="newStatus" id="md-status-select" value="New" />

                        <div class="crm-quick-actions" id="crmQuickActions">
                            <button type="button"
                                    class="crm-action-card"
                                    data-status-action="Contacted">
                                <span class="act-icon">
                                    <i class="bi bi-telephone-inbound-fill"></i>
                                </span>
                                <span>
                                    <span class="crm-action-title">Đã gọi / tiếp nhận</span>
                                    <span class="crm-action-desc">Dùng khi đã gọi khách hoặc đang theo dõi.</span>
                                </span>
                            </button>

                            <button type="button"
                                    class="crm-action-card success"
                                    data-status-action="Closed">
                                <span class="act-icon">
                                    <i class="bi bi-check-circle-fill"></i>
                                </span>
                                <span>
                                    <span class="crm-action-title">Hoàn tất tư vấn</span>
                                    <span class="crm-action-desc">Dùng khi đã tư vấn xong hoặc kết thúc chăm sóc.</span>
                                </span>
                            </button>

                            <button type="button"
                                    class="crm-action-card danger"
                                    data-status-action="Spam">
                                <span class="act-icon">
                                    <i class="bi bi-shield-x"></i>
                                </span>
                                <span>
                                    <span class="crm-action-title">Spam / không phù hợp</span>
                                    <span class="crm-action-desc">Sai số, lead rác, không liên hệ được.</span>
                                </span>
                            </button>

                            <button type="button"
                                    class="crm-action-card warning"
                                    data-status-action="Keep">
                                <span class="act-icon">
                                    <i class="bi bi-journal-text"></i>
                                </span>
                                <span>
                                    <span class="crm-action-title">Lưu thêm ghi chú</span>
                                    <span class="crm-action-desc">Không đổi trạng thái, chỉ cập nhật nội dung chăm sóc.</span>
                                </span>
                            </button>
                        </div>

                        <div class="crm-helper-box mt-3" id="crmRuleBox">
                            <strong>Quy tắc:</strong> Lead mới phải chuyển qua “Đã gọi/tiếp nhận” trước khi hoàn tất. Người bán không được tự đặt “Khách hủy”.
                        </div>

                        <div class="crm-call-row">
                            <a href="#" id="md-call-btn" class="btn btn-success btn-sm px-3">
                                <i class="bi bi-telephone-fill me-1"></i> Gọi khách
                            </a>

                            <a href="#" id="md-source-btn" class="btn btn-outline-primary btn-sm px-3" target="_blank">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Mở nguồn quan tâm
                            </a>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-black text-dark">
                            Ghi chú chăm sóc <span id="noteRequiredStar" class="text-danger">*</span>
                        </label>

                        <textarea name="sellerNote"
                                  id="md-sellerNote"
                                  class="form-control rounded-4"
                                  rows="5"
                                  maxlength="3000"
                                  placeholder="Ví dụ: Đã gọi khách lúc 9h sáng. Khách quan tâm giá, pháp lý và muốn xem nhà vào cuối tuần."></textarea>

                        <div id="noteRequiredBox" class="crm-note-required">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>
                            Khi chuyển trạng thái, bạn cần nhập ghi chú để lưu lại lịch sử chăm sóc.
                        </div>

                        <div class="form-text">
                            Ghi chú giúp bạn nhớ lịch sử chăm sóc khách và tránh gọi trùng, gọi nhầm hoặc xử lý sai.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" id="btnSaveLead" class="btn btn-primary btn-lg rounded-pill fw-black">
                            <i class="bi bi-save2 me-1"></i>Cập nhật & lưu chăm sóc
                        </button>
                        <button type="button" class="btn btn-light border btn-lg rounded-pill fw-bold" onclick="closeCRMModal()">
                            Đóng cửa sổ
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let crmModalInstance = null;
        let currentLeadStatus = 'New';
        let currentLeadSourceUrl = '#';

        function cleanupModalOverlay() {
            document.querySelectorAll('.modal-backdrop').forEach(function (el) {
                el.remove();
            });

            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
        }

        function getCrmModal() {
            const el = document.getElementById('crmModal');

            if (!crmModalInstance) {
                crmModalInstance = new bootstrap.Modal(el, {
                    backdrop: false,
                    keyboard: true,
                    focus: true
                });
            }

            return crmModalInstance;
        }

        function closeCRMModal() {
            const modal = getCrmModal();
            modal.hide();

            setTimeout(function () {
                cleanupModalOverlay();
            }, 150);
        }

        function getStatusView(status) {
            switch (status) {
                case 'Contacted':
                    return { cls: 'st-contacted', icon: 'bi-telephone-inbound-fill', text: 'Đã liên hệ' };
                case 'Closed':
                    return { cls: 'st-closed', icon: 'bi-check-circle-fill', text: 'Hoàn tất tư vấn' };
                case 'Spam':
                    return { cls: 'st-spam', icon: 'bi-shield-x', text: 'Spam/Rác' };
                case 'Cancelled':
                    return { cls: 'st-cancelled', icon: 'bi-x-circle-fill', text: 'Khách hủy' };
                default:
                    return { cls: 'st-new', icon: 'bi-lightning-charge-fill', text: 'Mới gửi' };
            }
        }

        function isFinalStatus(status) {
            return status === 'Closed' || status === 'Spam' || status === 'Cancelled';
        }

        function sanitizeSystemTokens(value) {
            if (!value) return '';

            return String(value)
                .replaceAll('[REMIND_SELLER]', '')
                .replaceAll('REMIND_SELLER', '')
                .replace(/^\s*(\d{1,2}:\d{2}\s+\d{1,2}\/\d{1,2}\/\d{4})\s*-\s*.*?đã gửi thông báo nhắc người phụ trách\s*:\s*.*?\.?\s*$/gmi, '$1 - Quản trị viên/nhân viên quản lý đã gửi thông báo: Vui lòng liên hệ và chăm sóc khách hàng.')
                .replace(/^\s*.*?đã gửi thông báo nhắc người phụ trách\s*:\s*.*?\.?\s*$/gmi, 'Quản trị viên/nhân viên quản lý đã gửi thông báo: Vui lòng liên hệ và chăm sóc khách hàng.')
                .replace(/nhắc người phụ trách/gi, 'nhắc chăm sóc khách hàng')
                .replace(/\n{3,}/g, '\n\n')
                .trim();
        }

        function setActionVisibility(action, visible) {
            const btn = document.querySelector(`[data-status-action="${action}"]`);
            if (!btn) return;

            btn.classList.toggle('is-hidden-by-rule', !visible);
        }

        function resolveActionStatus(action) {
            if (action === 'Keep') {
                return currentLeadStatus || 'New';
            }

            return action || currentLeadStatus || 'New';
        }

        function setSelectedAction(action) {
            const hiddenStatus = document.getElementById('md-status-select');
            const actionButtons = document.querySelectorAll('[data-status-action]');
            const noteRequiredBox = document.getElementById('noteRequiredBox');
            const noteRequiredStar = document.getElementById('noteRequiredStar');

            const actualStatus = resolveActionStatus(action);

            if (hiddenStatus) {
                hiddenStatus.value = actualStatus;
            }

            actionButtons.forEach(function (btn) {
                btn.classList.toggle('active', btn.dataset.statusAction === action);
            });

            const noteRequired = actualStatus !== currentLeadStatus
                && (actualStatus === 'Contacted' || actualStatus === 'Closed' || actualStatus === 'Spam');

            if (noteRequiredBox) {
                noteRequiredBox.style.display = noteRequired ? 'block' : 'none';
            }

            if (noteRequiredStar) {
                noteRequiredStar.style.display = noteRequired ? 'inline' : 'none';
            }
        }

        function updateStatusFlow(status) {
            const steps = document.querySelectorAll('.crm-flow-step');

            steps.forEach(function (step) {
                step.classList.remove('active', 'done', 'locked', 'danger');

                const flow = step.dataset.flow;

                if (status === 'Cancelled') {
                    step.classList.add('locked');
                    return;
                }

                if (status === 'Spam') {
                    step.classList.add('danger');
                    return;
                }

                if (status === 'New') {
                    if (flow === 'New') {
                        step.classList.add('active');
                    }
                    return;
                }

                if (status === 'Contacted') {
                    if (flow === 'New') {
                        step.classList.add('done');
                    }

                    if (flow === 'Contacted') {
                        step.classList.add('active');
                    }

                    return;
                }

                if (status === 'Closed') {
                    if (flow === 'New' || flow === 'Contacted') {
                        step.classList.add('done');
                    }

                    if (flow === 'Closed') {
                        step.classList.add('active');
                    }
                }
            });
        }

        function updateRuleBox(status) {
            const ruleBox = document.getElementById('crmRuleBox');
            if (!ruleBox) return;

            if (status === 'New') {
                ruleBox.innerHTML = '<strong>Quy tắc:</strong> Lead mới chỉ được chuyển sang “Đã gọi/tiếp nhận” hoặc “Spam”. Không được hoàn tất khi chưa gọi khách.';
                return;
            }

            if (status === 'Contacted') {
                ruleBox.innerHTML = '<strong>Quy tắc:</strong> Lead đã được tiếp nhận nên không được lùi về “Mới gửi”. Bạn có thể lưu thêm ghi chú, hoàn tất tư vấn hoặc đánh dấu Spam nếu không phù hợp.';
                return;
            }

            if (status === 'Closed') {
                ruleBox.innerHTML = '<strong>Đã khóa:</strong> Lead đã hoàn tất tư vấn nên không thể lùi hoặc chuyển sang trạng thái khác.';
                return;
            }

            if (status === 'Spam') {
                ruleBox.innerHTML = '<strong>Đã khóa:</strong> Lead đã đánh dấu Spam/Rác nên không thể lùi hoặc chuyển trạng thái khác.';
                return;
            }

            if (status === 'Cancelled') {
                ruleBox.innerHTML = '<strong>Đã khóa:</strong> Khách đã tự rút yêu cầu. Người bán chỉ được xem lại, không xử lý tiếp.';
                return;
            }

            ruleBox.innerHTML = '<strong>Quy tắc:</strong> Cần kiểm tra lại trạng thái lead.';
        }

        function updateNextActionBox(status, text) {
            const box = document.getElementById('nextActionBox');
            const textEl = document.getElementById('md-next-action');

            if (!box || !textEl) return;

            textEl.innerText = text || 'Cần kiểm tra lại lead.';

            box.classList.remove('d-none');

            if (status === 'Closed' || status === 'Spam' || status === 'Cancelled') {
                box.classList.add('opacity-75');
            } else {
                box.classList.remove('opacity-75');
            }
        }

        function disableAction(status, disabled) {
            const btn = document.querySelector(`[data-status-action="${status}"]`);

            if (btn) {
                btn.disabled = disabled;
            }
        }

        function applyStatusTransitionRules(status) {
            currentLeadStatus = status || 'New';

            const sellerNote = document.getElementById('md-sellerNote');
            const saveBtn = document.getElementById('btnSaveLead');
            const lockedBox = document.getElementById('lockedBox');
            const actionButtons = document.querySelectorAll('[data-status-action]');

            updateStatusFlow(currentLeadStatus);
            updateRuleBox(currentLeadStatus);

            if (lockedBox) {
                lockedBox.style.display = 'none';
            }

            if (sellerNote) {
                sellerNote.disabled = false;
                sellerNote.placeholder = 'Nhập ghi chú sau khi gọi/tư vấn khách. Ví dụ: Đã gọi 2 lần, khách quan tâm giá và pháp lý...';
            }

            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.classList.remove('crm-save-hidden');
                saveBtn.innerHTML = '<i class="bi bi-save2 me-1"></i>Cập nhật chăm sóc';
            }

            actionButtons.forEach(function (btn) {
                btn.disabled = false;
                btn.classList.remove('active', 'is-hidden-by-rule');
            });

            /*
                Quy trình đúng:
                - New: chưa gọi -> không cho lưu thêm ghi chú, không cho hoàn tất.
                  Chỉ cho "Đã gọi / tiếp nhận" hoặc "Spam".
                - Contacted: đã gọi -> cho lưu thêm ghi chú, hoàn tất, spam.
                - Closed/Spam/Cancelled: khóa.
            */
            if (currentLeadStatus === 'New') {
                setActionVisibility('Contacted', true);
                setActionVisibility('Spam', true);
                setActionVisibility('Keep', false);
                setActionVisibility('Closed', false);

                setSelectedAction('Contacted');

                if (sellerNote) {
                    sellerNote.placeholder = 'Sau khi đã gọi hoặc tiếp nhận khách, nhập ghi chú ngắn tại đây. Ví dụ: Đã gọi khách, khách muốn xem nhà cuối tuần.';
                }

                if (saveBtn) {
                    saveBtn.innerHTML = '<i class="bi bi-telephone-inbound-fill me-1"></i>Lưu đã gọi / tiếp nhận';
                }

                return;
            }

            if (currentLeadStatus === 'Contacted') {
                setActionVisibility('Contacted', false);
                setActionVisibility('Keep', true);
                setActionVisibility('Closed', true);
                setActionVisibility('Spam', true);

                setSelectedAction('Keep');

                if (saveBtn) {
                    saveBtn.innerHTML = '<i class="bi bi-journal-plus me-1"></i>Lưu thêm ghi chú';
                }

                return;
            }

            if (isFinalStatus(currentLeadStatus)) {
                actionButtons.forEach(function (btn) {
                    btn.disabled = true;
                    btn.classList.add('is-hidden-by-rule');
                });

                if (sellerNote) {
                    sellerNote.disabled = true;
                }

                if (saveBtn) {
                    saveBtn.disabled = true;
                    saveBtn.classList.add('crm-save-hidden');
                }

                if (lockedBox) {
                    lockedBox.style.display = 'block';

                    if (currentLeadStatus === 'Closed') {
                        lockedBox.innerHTML = '<i class="bi bi-lock-fill me-1"></i>Lead đã hoàn tất tư vấn. Trạng thái này đã khóa để tránh cập nhật sai.';
                    } else if (currentLeadStatus === 'Spam') {
                        lockedBox.innerHTML = '<i class="bi bi-lock-fill me-1"></i>Lead đã được đánh dấu Spam/Rác. Trạng thái này đã khóa để tránh xử lý lại.';
                    } else {
                        lockedBox.innerHTML = '<i class="bi bi-lock-fill me-1"></i>Khách đã hủy yêu cầu. Lead này chỉ được xem lại.';
                    }
                }

                setSelectedAction('Keep');
            }
        }

        function setSaveButtonLoading(isLoading) {
            const btn = document.getElementById('btnSaveLead');
            if (!btn) return;

            if (isLoading) {
                btn.dataset.originalHtml = btn.innerHTML;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu...';
                btn.disabled = true;
            } else {
                btn.innerHTML = btn.dataset.originalHtml || '<i class="bi bi-save2 me-1"></i>Cập nhật & lưu chăm sóc';

                if (!isFinalStatus(currentLeadStatus)) {
                    btn.disabled = false;
                }
            }
        }

        function safeParseJsonResponse(res) {
            return res.text().then(function (text) {
                let data = null;

                try {
                    data = text ? JSON.parse(text) : null;
                } catch {
                    data = null;
                }

                if (!res.ok) {
                    const message = data && data.message
                        ? data.message
                        : 'Máy chủ trả về lỗi ' + res.status + '. Vui lòng kiểm tra lại Controller hoặc log server.';

                    throw new Error(message);
                }

                if (!data) {
                    throw new Error('Máy chủ không trả về dữ liệu JSON hợp lệ.');
                }

                return data;
            });
        }

        function openCRMModal(id) {
            cleanupModalOverlay();

            Swal.fire({
                title: 'Đang tải lead...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: function () {
                    Swal.showLoading();
                }
            });

            fetch(`/Consultations/GetDetails?id=${id}`, {
                method: 'GET',
                headers: { 'Accept': 'application/json' }
            })
                .then(safeParseJsonResponse)
                .then(function (data) {
                    Swal.close();
                    cleanupModalOverlay();

                    if (!data.success) {
                        Swal.fire('Không thể mở lead', data.message || 'Không tải được dữ liệu.', 'error');
                        return;
                    }

                    const d = data.data;
                    const statusView = getStatusView(d.status);

                    currentLeadStatus = d.status || 'New';
                    currentLeadSourceUrl = d.sourceUrl || '#';

                    document.getElementById('md-id').value = d.id || '';
                    document.getElementById('md-name').innerText = d.fullName || 'Khách hàng';

                    const phoneLink = document.getElementById('md-phone');
                    phoneLink.href = d.phone ? ('tel:' + d.phone) : '#';
                    phoneLink.querySelector('span').innerText = d.phone || 'Không có';

                    const callBtn = document.getElementById('md-call-btn');
                    if (callBtn) {
                        callBtn.href = d.phone ? ('tel:' + d.phone) : '#';
                        callBtn.classList.toggle('disabled', !d.phone);
                    }

                    const sourceBtn = document.getElementById('md-source-btn');
                    if (sourceBtn) {
                        sourceBtn.href = currentLeadSourceUrl;
                        sourceBtn.classList.toggle('disabled', currentLeadSourceUrl === '#');
                    }

                    document.getElementById('md-email').querySelector('span').innerText = d.email || 'Không có';
                    document.getElementById('md-note').innerText = d.note || 'Không có lời nhắn';
                    document.getElementById('md-source').innerText = `${d.sourceType || 'Nguồn'} - ${d.sourceTitle || 'Không xác định'}`;
                    document.getElementById('md-created').innerText = d.createdAt || '';
                    document.getElementById('md-updated').innerText = d.updatedAt || 'Chưa xử lý';
                    document.getElementById('md-sellerNote').value = sanitizeSystemTokens(d.sellerNote || '');

                    const currentStatus = document.getElementById('md-current-status');
                    currentStatus.className = `status-pill ${statusView.cls}`;
                    currentStatus.innerHTML = `<i class="bi ${statusView.icon}"></i>${statusView.text}`;

                    updateNextActionBox(currentLeadStatus, d.nextAction);
                    applyStatusTransitionRules(currentLeadStatus);

                    getCrmModal().show();

                    setTimeout(function () {
                        cleanupModalOverlay();
                    }, 100);
                })
                .catch(function (err) {
                    Swal.close();
                    cleanupModalOverlay();
                    Swal.fire('Lỗi', err.message || 'Không thể kết nối máy chủ.', 'error');
                });
        }

        document.querySelectorAll('[data-status-action]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (btn.disabled) return;

                const action = btn.dataset.statusAction;
                const selectedStatus = resolveActionStatus(action);

                if (currentLeadStatus === 'New' && selectedStatus === 'Closed') {
                    Swal.fire('Chưa đúng quy trình', 'Lead mới phải được gọi/tiếp nhận trước khi hoàn tất tư vấn.', 'warning');
                    return;
                }

                if (currentLeadStatus === 'Contacted' && selectedStatus === 'New') {
                    Swal.fire('Không thể lùi trạng thái', 'Lead đã gọi không được chuyển về Mới gửi.', 'warning');
                    return;
                }

                setSelectedAction(action);
            });
        });

        const updateLeadForm = document.getElementById('frmUpdateLead');

        if (updateLeadForm) {
            updateLeadForm.addEventListener('submit', function (e) {
                e.preventDefault();

                const selectedStatus = document.getElementById('md-status-select')?.value || currentLeadStatus || 'New';
                const sellerNote = document.getElementById('md-sellerNote')?.value.trim() || '';
                const isStatusChanged = selectedStatus !== currentLeadStatus;

                const noteRequired = isStatusChanged
                    && (selectedStatus === 'Contacted' || selectedStatus === 'Closed' || selectedStatus === 'Spam');

                if (noteRequired && sellerNote.length < 5) {
                    Swal.fire(
                        'Thiếu ghi chú chăm sóc',
                        'Bạn cần nhập ghi chú ngắn trước khi chuyển trạng thái để lưu lại lịch sử xử lý.',
                        'warning'
                    );

                    document.getElementById('md-sellerNote')?.focus();
                    return;
                }

                if (!isStatusChanged && currentLeadStatus === 'New') {
                    Swal.fire(
                        'Chưa thể lưu ghi chú',
                        'Lead mới chưa được gọi hoặc tiếp nhận nên chưa cho phép lưu thêm ghi chú. Sau khi gọi khách, hãy chọn “Đã gọi / tiếp nhận”.',
                        'warning'
                    );
                    return;
                }

                if (!isStatusChanged && sellerNote.length < 5) {
                    Swal.fire(
                        'Chưa có ghi chú mới',
                        'Bạn đang chọn lưu thêm ghi chú nhưng nội dung ghi chú còn trống hoặc quá ngắn.',
                        'warning'
                    );

                    document.getElementById('md-sellerNote')?.focus();
                    return;
                }

                let confirmTitle = isStatusChanged ? 'Cập nhật trạng thái?' : 'Lưu thêm ghi chú?';
                let confirmText = isStatusChanged
                    ? 'Hệ thống sẽ lưu trạng thái mới và ghi chú chăm sóc cho lead này.'
                    : 'Hệ thống sẽ giữ nguyên trạng thái hiện tại và chỉ cập nhật ghi chú chăm sóc.';
                let confirmIcon = 'question';

                if (selectedStatus === 'Closed') {
                    confirmTitle = 'Hoàn tất tư vấn lead này?';
                    confirmText = 'Sau khi hoàn tất, lead sẽ bị khóa và không thể lùi trạng thái.';
                    confirmIcon = 'success';
                }

                if (selectedStatus === 'Spam') {
                    confirmTitle = 'Đánh dấu lead là Spam/Rác?';
                    confirmText = 'Sau khi đánh dấu Spam, lead sẽ bị khóa xử lý.';
                    confirmIcon = 'warning';
                }

                Swal.fire({
                    title: confirmTitle,
                    text: confirmText,
                    icon: confirmIcon,
                    showCancelButton: true,
                    confirmButtonText: 'Đồng ý lưu',
                    cancelButtonText: 'Kiểm tra lại',
                    confirmButtonColor: '#2563eb',
                    cancelButtonColor: '#64748b'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    const formData = new FormData(updateLeadForm);
                    setSaveButtonLoading(true);

                    fetch(updateLeadForm.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'Accept': 'application/json' }
                    })
                        .then(safeParseJsonResponse)
                        .then(function (data) {
                            if (data.success) {
                                closeCRMModal();

                                Swal.fire({
                                    icon: 'success',
                                    title: 'Đã lưu',
                                    text: data.message || 'Đã cập nhật lead.',
                                    confirmButtonText: 'OK'
                                }).then(function () {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Không thể cập nhật', data.message || 'Cập nhật thất bại.', 'error');
                                setSaveButtonLoading(false);
                            }
                        })
                        .catch(function (err) {
                            Swal.fire('Lỗi', err.message || 'Không thể kết nối máy chủ.', 'error');
                            setSaveButtonLoading(false);
                        });
                });
            });
        }

        function getDeleteToken(id) {
            const desktopToken = document.querySelector(`#frmDel-${id} input[name="__RequestVerificationToken"]`);
            const mobileToken = document.querySelector(`#frmDelMobile-${id} input[name="__RequestVerificationToken"]`);

            if (desktopToken) return desktopToken.value;
            if (mobileToken) return mobileToken.value;

            return '';
        }

        function deleteLead(id) {
            cleanupModalOverlay();

            Swal.fire({
                title: 'Xóa lead này?',
                text: 'Chỉ nên xóa lead spam hoặc lead khách đã hủy. Lead đang chăm sóc/hoàn tất nên giữ lại lịch sử.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Xóa lead',
                cancelButtonText: 'Đóng'
            }).then(function (result) {
                if (!result.isConfirmed) return;

                const token = getDeleteToken(id);

                const formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', token);

                fetch('/Consultations/Delete', {
                    method: 'POST',
                    body: formData,
                    headers: { 'Accept': 'application/json' }
                })
                    .then(safeParseJsonResponse)
                    .then(function (data) {
                        if (data.success) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message || 'Đã xóa lead.',
                                showConfirmButton: false,
                                timer: 1800
                            });

                            const row = document.getElementById(`row-${id}`);
                            const mobileRow = document.getElementById(`mobile-row-${id}`);

                            if (row) row.remove();
                            if (mobileRow) mobileRow.remove();
                        } else {
                            Swal.fire('Không thể xóa', data.message || 'Xóa thất bại.', 'error');
                        }
                    })
                    .catch(function (err) {
                        Swal.fire('Lỗi', err.message || 'Không thể kết nối máy chủ.', 'error');
                    });
            });
        }

        document.addEventListener('hidden.bs.modal', function () {
            cleanupModalOverlay();
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                const modalEl = document.getElementById('crmModal');

                if (modalEl && modalEl.classList.contains('show')) {
                    closeCRMModal();
                }
            }
        });
    </script>
}