@model IEnumerable<BDSKhanhHoa.Models.Consultation>

@{
    ViewData["Title"] = "Quản lý khách tư vấn";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    int totalLeads = Convert.ToInt32(ViewBag.TotalLeads ?? 0);
    int newLeads = Convert.ToInt32(ViewBag.NewLeads ?? 0);
    int contactedLeads = Convert.ToInt32(ViewBag.ContactedLeads ?? 0);
    int closedLeads = Convert.ToInt32(ViewBag.ClosedLeads ?? 0);
    int spamLeads = Convert.ToInt32(ViewBag.SpamLeads ?? 0);
    int cancelledLeads = Convert.ToInt32(ViewBag.CancelledLeads ?? 0);

    int processedLeads = contactedLeads + closedLeads;
    int responseRate = totalLeads > 0 ? (processedLeads * 100 / totalLeads) : 0;

    string searchString = ViewBag.SearchString as string ?? "";
    string statusFilter = ViewBag.StatusFilter as string ?? "All";

    string GetStatusClass(string? status)
    {
        return status switch
        {
            "New" => "st-new",
            "Contacted" => "st-contacted",
            "Closed" => "st-closed",
            "Spam" => "st-spam",
            "Cancelled" => "st-cancelled",
            _ => "st-new"
        };
    }

    string GetStatusText(string? status)
    {
        return status switch
        {
            "New" => "Mới gửi",
            "Contacted" => "Đã liên hệ",
            "Closed" => "Hoàn tất tư vấn",
            "Spam" => "Spam/Rác",
            "Cancelled" => "Khách hủy",
            _ => "Mới gửi"
        };
    }

    string GetStatusIcon(string? status)
    {
        return status switch
        {
            "New" => "bi-lightning-charge-fill",
            "Contacted" => "bi-telephone-inbound-fill",
            "Closed" => "bi-check-circle-fill",
            "Spam" => "bi-shield-x",
            "Cancelled" => "bi-x-circle-fill",
            _ => "bi-lightning-charge-fill"
        };
    }

    bool CanDelete(string? status)
    {
        return status == "Spam" || status == "Cancelled";
    }

    bool IsLocked(string? status)
    {
        return status == "Closed" || status == "Spam" || status == "Cancelled";
    }

    string CleanSellerNote(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        string cleaned = value
            .Replace("[REMIND_SELLER]", "", StringComparison.OrdinalIgnoreCase)
            .Replace("REMIND_SELLER", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

        cleaned = System.Text.RegularExpressions.Regex.Replace(
            cleaned,
            @"(?im)^\s*(\d{1,2}:\d{2}\s+\d{1,2}/\d{1,2}/\d{4})\s*-\s*.*?đã gửi thông báo nhắc người phụ trách\s*:\s*.*?\.?\s*$",
            "$1 - Quản trị viên/nhân viên quản lý đã gửi thông báo: Vui lòng liên hệ và chăm sóc khách hàng.");

        cleaned = System.Text.RegularExpressions.Regex.Replace(
            cleaned,
            @"(?im)^\s*.*?đã gửi thông báo nhắc người phụ trách\s*:\s*.*?\.?\s*$",
            "Quản trị viên/nhân viên quản lý đã gửi thông báo: Vui lòng liên hệ và chăm sóc khách hàng.");

        cleaned = cleaned.Replace("nhắc người phụ trách", "nhắc chăm sóc khách hàng", StringComparison.OrdinalIgnoreCase);

        while (cleaned.Contains("\n\n\n"))
        {
            cleaned = cleaned.Replace("\n\n\n", "\n\n");
        }

        return cleaned.Trim();
    }
    string GetNextActionText(string? status, DateTime? updatedAt)
    {
        if (status == "New")
        {
            return "Cần gọi / tiếp nhận";
        }

        if (status == "Contacted")
        {
            if (!updatedAt.HasValue)
            {
                return "Đang theo dõi";
            }

            var hours = (DateTime.Now - updatedAt.Value).TotalHours;

            if (hours >= 24)
            {
                return "Nên chăm sóc lại";
            }

            return "Đang theo dõi";
        }

        if (status == "Closed")
        {
            return "Đã hoàn tất";
        }

        if (status == "Spam")
        {
            return "Đã loại";
        }

        if (status == "Cancelled")
        {
            return "Khách đã hủy";
        }

        return "Cần kiểm tra";
    }

    string GetNextActionClass(string? status, DateTime? updatedAt)
    {
        if (status == "New")
        {
            return "next-hot";
        }

        if (status == "Contacted")
        {
            if (updatedAt.HasValue && (DateTime.Now - updatedAt.Value).TotalHours >= 24)
            {
                return "next-warning";
            }

            return "next-follow";
        }

        if (status == "Closed")
        {
            return "next-done";
        }

        if (status == "Spam" || status == "Cancelled")
        {
            return "next-locked";
        }

        return "next-follow";
    }
}

