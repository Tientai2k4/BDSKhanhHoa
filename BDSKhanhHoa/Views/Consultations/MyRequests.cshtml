            list-style: none;
            cursor: pointer;
            padding: 13px 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: var(--req-dark);
            font-weight: 950;
            user-select: none;
        }

            .guide-panel summary::-webkit-details-marker {
                display: none;
            }

    .guide-summary-left {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

        .guide-summary-left i {
            color: var(--req-primary);
        }

    .guide-summary-hint {
        color: var(--req-muted);
        font-weight: 800;
        font-size: .78rem;
        white-space: nowrap;
    }

    .guide-flow {
        border-top: 1px solid #eef2f7;
        padding: 12px 14px 14px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

    .guide-step {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 15px;
        padding: 10px;
    }

    .guide-step-title {
        color: var(--req-dark);
        font-weight: 950;
        font-size: .78rem;
        line-height: 1.25;
        margin-bottom: 2px;
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .guide-step-title i {
            width: 24px;
            height: 24px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #0ea5e9);
            font-size: .72rem;
            flex-shrink: 0;
        }

    .guide-step-text {
        color: var(--req-muted);
        font-size: .72rem;
        line-height: 1.35;
        font-weight: 650;
        margin: 0;
    }

    .request-list {
        display: grid;
        gap: 12px;
    }

    .request-card {
        border: 1px solid var(--req-border);
        border-radius: 22px;
        background: var(--req-card);
        overflow: hidden;
        box-shadow: var(--req-shadow);
    }

    .request-head {
        padding: 13px 15px;
        border-bottom: 1px solid #eef2f7;
        background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .request-code {
        color: #64748b;
        font-size: .76rem;
        font-weight: 850;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 7px 11px;
        font-size: .73rem;
        font-weight: 950;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .st-new {
        background: #fff7ed;
        color: #ea580c;
        border-color: #fed7aa;
    }

    .st-contacted {
        background: #eff6ff;
        color: #2563eb;
        border-color: #bfdbfe;
    }

    .st-closed {
        background: #f0fdf4;
        color: #16a34a;
        border-color: #bbf7d0;
    }

    .st-spam {
        background: #f1f5f9;
        color: #475569;
        border-color: #cbd5e1;
    }

    .st-cancelled {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .request-body {
        padding: 15px;
    }

    .source-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
    }

    .source-type {
        width: 38px;
        height: 38px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .src-property {
        background: #eff6ff;
        color: #2563eb;
    }

    .src-project {
        background: #ecfeff;
        color: #0891b2;
    }

    .src-unknown {
        background: #f1f5f9;
        color: #64748b;
    }

    .source-kind {
        display: block;
        color: var(--req-primary);
        font-size: .72rem;
        font-weight: 950;
        margin-bottom: 3px;
    }

    .source-title {
        color: #0f172a;
        text-decoration: none;
        font-weight: 950;
        font-size: 1rem;
        line-height: 1.35;
        display: block;
    }

        .source-title:hover {
            color: var(--req-primary);
            text-decoration: underline;
        }

        .source-title.is-disabled {
            color: #64748b;
            text-decoration: none;
            cursor: default;
        }

    .compact-info {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 12px;
    }

    .compact-info-row {
        display: grid;
        grid-template-columns: 118px minmax(0, 1fr);
        gap: 8px;
        padding: 9px 11px;
        border-bottom: 1px solid #e7edf5;
        font-size: .8rem;
        line-height: 1.35;
    }

        .compact-info-row:last-child {
            border-bottom: 0;
        }

    .compact-label {
        color: #64748b;
        font-weight: 950;
        text-transform: uppercase;
        font-size: .68rem;
        letter-spacing: .035em;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .compact-value {
        color: #0f172a;
        font-weight: 750;
        word-break: break-word;
    }

    .status-compact {
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        background: #fff;
        padding: 11px;
    }

    .status-compact-title {
        color: #0f172a;
        font-size: .88rem;
        font-weight: 950;
        margin-bottom: 9px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .mini-timeline {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    .mini-step {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 14px;
        padding: 9px 8px;
        min-height: 76px;
    }

        .mini-step.done {
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .mini-step.active {
            background: #eff6ff;
            border-color: #bfdbfe;
        }

        .mini-step.danger {
            background: #fef2f2;
            border-color: #fecaca;
        }

    .mini-step-top {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #0f172a;
        font-size: .76rem;
        font-weight: 950;
        line-height: 1.25;
        margin-bottom: 4px;
    }

    .mini-dot {
        width: 24px;
        height: 24px;
        border-radius: 9px;
        background: #e2e8f0;
        color: #64748b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        flex-shrink: 0;
    }

    .mini-step.done .mini-dot {
        background: #dcfce7;
        color: #16a34a;
    }

    .mini-step.active .mini-dot {
        background: #dbeafe;
        color: #2563eb;
    }

    .mini-step.danger .mini-dot {
        background: #fee2e2;
        color: #dc2626;
    }

    .mini-step-desc {
        color: #64748b;
        font-size: .7rem;
        line-height: 1.3;
        margin: 0;
        font-weight: 650;
    }

    .next-box {
        margin-top: 9px;
        color: #475569;
        font-size: .78rem;
        line-height: 1.45;
        font-weight: 750;
    }

        .next-box strong {
            color: #0f172a;
        }

    .request-footer {
        border-top: 1px solid #eef2f7;
        padding: 12px 15px;
        background: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .time-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 11px;
        color: #64748b;
        font-size: .74rem;
        font-weight: 800;
    }

        .time-meta span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        justify-content: flex-end;
    }

    .btn-req {
        border-radius: 999px;
        font-weight: 900;
        font-size: .8rem;
        padding: 8px 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .empty-panel {
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 24px;
        box-shadow: var(--req-shadow);
        text-align: center;
        padding: 42px 18px;
    }

        .empty-panel i {
            font-size: 3.4rem;
            color: #94a3b8;
            opacity: .55;
            display: block;
            margin-bottom: 12px;
        }

    .empty-title {
        color: #0f172a;
        font-weight: 950;
        font-size: 1.18rem;
        margin-bottom: 8px;
    }

    .empty-text {
        color: #64748b;
        font-size: .9rem;
        margin-bottom: 18px;
    }

    @@media (max-width: 767.98px) {
        .myreq-page {
            font-size: 13.5px;
        }

        .myreq-hero {
            padding: 14px;
            border-radius: 18px;
            margin-bottom: 10px;
        }

        .myreq-hero-row {
            align-items: stretch;
            flex-direction: column;
            gap: 10px;
        }

        .myreq-kicker {
            padding: 5px 10px;
            font-size: .72rem;
            margin-bottom: 6px;
        }

        .myreq-title {
            font-size: 1.18rem;
        }

        .myreq-sub {
            display: none;
        }

        .myreq-search-btn {
            width: 100%;
            min-width: 0;
            padding: 9px 14px;
        }

        .guide-panel {
            border-radius: 16px;
            margin-bottom: 10px;
        }

            .guide-panel summary {
                padding: 11px 12px;
                font-size: .88rem;
            }

        .guide-summary-hint {
            font-size: .7rem;
        }

        .guide-flow {
            grid-template-columns: 1fr;
            max-height: 210px;
            overflow-y: auto;
            padding: 10px 11px 12px;
        }

        .guide-step {
            padding: 9px;
            border-radius: 13px;
        }

        .guide-step-text {
            display: none;
        }

        .request-list {
            gap: 10px;
        }

        .request-card {
            border-radius: 18px;
        }

        .request-head {
            padding: 11px 12px;
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

        .request-code {
