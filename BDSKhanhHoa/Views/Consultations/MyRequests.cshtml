        }

        .source-row {
            margin-bottom: 10px;
        }

        .source-type {
            width: 34px;
            height: 34px;
            border-radius: 12px;
        }

        .source-title {
            font-size: .93rem;
        }

        .compact-info {
            margin-bottom: 10px;
        }

        .compact-info-row {
            grid-template-columns: 92px minmax(0, 1fr);
            padding: 8px 10px;
            font-size: .78rem;
        }

        .compact-label {
            font-size: .62rem;
        }

        .status-compact {
            padding: 10px;
            border-radius: 15px;
        }

