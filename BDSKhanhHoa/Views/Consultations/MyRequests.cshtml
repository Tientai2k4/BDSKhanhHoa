            font-size: .82rem;
            margin-bottom: 8px;
        }

        .mini-timeline {
            grid-template-columns: 1fr;
            gap: 7px;
        }

        .mini-step {
            min-height: auto;
            padding: 8px;
            display: grid;
            grid-template-columns: minmax(0, 1fr);
        }

        .mini-step-desc {
            display: none;
        }

        .next-box {
            font-size: .74rem;
            margin-top: 8px;
        }

        .request-footer {
            padding: 11px 12px;
            display: block;
        }

        .time-meta {
            display: grid;
            gap: 4px;
            font-size: .72rem;
        }

        .action-group {
            margin-top: 10px;
            display: grid;
            grid-template-columns: 1fr;
        }

        .btn-req {
            width: 100%;
            padding: 9px 12px;
        }
    }
</style>

<div class="container-fluid px-0 myreq-page">
    <div class="myreq-hero">
        <div class="myreq-hero-row">
            <div>
                <div class="myreq-kicker">
                    <i class="bi bi-clock-history"></i>
                    Lịch sử tư vấn
                </div>
                <h2 class="myreq-title">Yêu cầu tư vấn của bạn</h2>
                <p class="myreq-sub">
                    Theo dõi trạng thái xử lý, thời gian cập nhật và thao tác tiếp theo của từng yêu cầu.
                </p>
            </div>

            <a href="/Property/Search" class="btn btn-light myreq-search-btn">
                <i class="bi bi-search me-1"></i>
                Tìm BĐS mới
            </a>
        </div>
    </div>

    <details class="guide-panel">
        <summary>
            <span class="guide-summary-left">
                <i class="bi bi-diagram-3-fill"></i>
                Quy trình tư vấn
            </span>
            <span class="guide-summary-hint">Bấm để xem 4 bước</span>
        </summary>

        <div class="guide-flow">
            <div class="guide-step">
                <div class="guide-step-title"><i class="bi bi-send-check-fill"></i>1. Gửi yêu cầu</div>
                <p class="guide-step-text">Hệ thống ghi nhận thông tin liên hệ và bất động sản/dự án bạn quan tâm.</p>
            </div>
            <div class="guide-step">
                <div class="guide-step-title"><i class="bi bi-hourglass-split"></i>2. Chờ tiếp nhận</div>
                <p class="guide-step-text">Khi còn chờ phản hồi, bạn vẫn có thể rút yêu cầu nếu không còn nhu cầu.</p>
            </div>
            <div class="guide-step">
                <div class="guide-step-title"><i class="bi bi-telephone-inbound-fill"></i>3. Người bán liên hệ</div>
                <p class="guide-step-text">Người bán hoặc chuyên viên tiếp nhận và liên hệ theo thông tin bạn đã gửi.</p>
            </div>
            <div class="guide-step">
                <div class="guide-step-title"><i class="bi bi-check-circle-fill"></i>4. Hoàn tất</div>
                <p class="guide-step-text">Yêu cầu được hoàn tất, từ chối hoặc dừng xử lý nếu bạn đã rút lại.</p>
            </div>
        </div>
    </details>

    @if (Model != null && Model.Any())
    {
        <div class="request-list">
            @foreach (var item in Model)
            {
                bool canCancel = item.Status == "New";
                bool canOpenSource = CanOpenSource(item);
                string sourceUrl = GetSourceUrl(item);
                string sourceTitle = GetSourceTitle(item);

                <div class="request-card" id="card-req-@item.ConsultID">
                    <div class="request-head">
                        <div class="request-code">
                            <span><i class="bi bi-receipt-cutoff"></i> #@item.ConsultID</span>
                            <span><i class="bi bi-calendar-event"></i> @item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>

                        <span id="badge-@item.ConsultID" class="status-badge @GetStatusClass(item.Status)">
                            <i class="bi @GetStatusIcon(item.Status)"></i>
                            @GetStatusText(item.Status)
                        </span>
                    </div>

                    <div class="request-body">
                        <div class="source-row">
                            <span class="source-type @GetSourceTypeClass(item)">
                                <i class="bi @(item.Property != null ? "bi-house-door-fill" : item.Project != null ? "bi-buildings-fill" : "bi-question-circle-fill")"></i>
                            </span>
                            <div class="min-w-0">
                                <span class="source-kind">@GetSourceTypeText(item)</span>
                                @if (canOpenSource)
                                {
                                    <a href="@sourceUrl" class="source-title" target="_blank">@sourceTitle</a>
                                }
                                else
                                {
                                    <div class="source-title is-disabled">@sourceTitle</div>
                                }
                            </div>
                        </div>

                        <div class="compact-info">
                            <div class="compact-info-row">
                                <div class="compact-label"><i class="bi bi-telephone"></i>SĐT</div>
                                <div class="compact-value">@item.Phone</div>
                            </div>
                            <div class="compact-info-row">
                                <div class="compact-label"><i class="bi bi-envelope"></i>Email</div>
                                <div class="compact-value">@(string.IsNullOrWhiteSpace(item.Email) ? "Không cung cấp" : item.Email)</div>
                            </div>
                            <div class="compact-info-row">
                                <div class="compact-label"><i class="bi bi-chat-left-text"></i>Lời nhắn</div>
                                <div class="compact-value">
                                    @(string.IsNullOrWhiteSpace(item.Note) ? "Không có lời nhắn thêm." : item.Note)
                                </div>
                            </div>
                        </div>

                        <div class="status-compact">
                            <div class="status-compact-title">
                                <i class="bi bi-list-check text-primary"></i>
                                Tình trạng xử lý
                            </div>

                            <div class="mini-timeline">
                                <div class="mini-step @GetProcessClass(item.Status, "Sent")">
                                    <div class="mini-step-top">
                                        <span class="mini-dot"><i class="bi bi-send-check-fill"></i></span>
                                        Đã gửi
                                    </div>
                                    <p class="mini-step-desc">Hệ thống đã ghi nhận yêu cầu.</p>
                                </div>

                                <div class="mini-step @GetProcessClass(item.Status, "Received")">
                                    <div class="mini-step-top">
                                        <span class="mini-dot"><i class="bi bi-telephone-inbound-fill"></i></span>
                                        Tiếp nhận
                                    </div>
                                    <p class="mini-step-desc">@GetBuyerStatusMessage(item.Status)</p>
                                </div>

                                <div class="mini-step @GetProcessClass(item.Status, "Result")">
                                    <div class="mini-step-top">
                                        <span class="mini-dot">
                                            <i class="bi @(item.Status == "Closed" ? "bi-check-circle-fill" : item.Status == "Spam" || item.Status == "Cancelled" ? "bi-x-circle-fill" : "bi-circle")"></i>
                                        </span>
                                        @GetResultText(item.Status)
                                    </div>
                                    <p class="mini-step-desc">@GetNextStepText(item.Status)</p>
                                </div>
                            </div>

                            <div class="next-box">
                                <strong><i class="bi bi-info-circle-fill me-1"></i>Ghi chú:</strong>
                                @if (item.Status == "New")
                                {
                                    <span>Bạn có thể rút yêu cầu khi người bán/chuyên viên chưa tiếp nhận.</span>
                                }
                                else if (item.Status == "Contacted")
                                {
                                    <span>Yêu cầu đã được tiếp nhận nên không thể rút trực tiếp trên hệ thống.</span>
                                }
                                else if (item.Status == "Closed")
                                {
                                    <span>Yêu cầu đã hoàn tất và được lưu lại trong lịch sử tư vấn.</span>
                                }
                                else if (item.Status == "Spam")
                                {
                                    <span>Yêu cầu đã bị từ chối hoặc không thể xử lý tiếp.</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span>Bạn đã chủ động rút lại yêu cầu này.</span>
                                }
                                else
                                {
                                    <span>Vui lòng theo dõi cập nhật mới từ hệ thống.</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="request-footer">
                        <div class="time-meta">
                            <span><i class="bi bi-send-check"></i> Gửi: @item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</span>
                            @if (item.UpdatedAt.HasValue)
                            {
                                <span><i class="bi bi-clock-history"></i> Cập nhật: @item.UpdatedAt.Value.ToString("HH:mm - dd/MM/yyyy")</span>
                            }
                            else
                            {
                                <span><i class="bi bi-hourglass-split"></i> Chưa có cập nhật</span>
                            }
                        </div>

                        <div class="action-group" id="action-box-@item.ConsultID">
                            @if (canOpenSource)
                            {
                                <a href="@sourceUrl" target="_blank" class="btn btn-outline-primary btn-req">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    Xem lại tin
                                </a>
                            }

                            @if (canCancel)
                            {
                                <form class="m-0" id="frmCancel-@item.ConsultID">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="btn btn-outline-danger btn-req" onclick="cancelRequest(@item.ConsultID)">
                                        <i class="bi bi-x-circle"></i>
                                        Rút yêu cầu
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-light border btn-req text-muted" disabled>
                                    <i class="bi bi-lock-fill"></i>
                                    Không thể hủy
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-panel">
            <i class="bi bi-headset"></i>
            <div class="empty-title">Bạn chưa gửi yêu cầu tư vấn nào</div>
            <p class="empty-text">
                Hãy tìm bất động sản phù hợp rồi gửi yêu cầu để chủ nhà, môi giới hoặc chuyên viên dự án liên hệ lại.
            </p>
            <a href="/Property/Search" class="btn btn-primary rounded-pill fw-black px-5 py-3">
                <i class="bi bi-search me-1"></i>
                Khám phá bất động sản
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function getCancelToken(id) {
            const tokenEl = document.querySelector(`#frmCancel-${id} input[name="__RequestVerificationToken"]`);
            return tokenEl ? tokenEl.value : '';
        }

        function safeParseJsonResponse(res) {
            return res.text().then(function (text) {
                let data = null;

                try {
                    data = text ? JSON.parse(text) : null;
                } catch {
                    data = null;
                }

                if (!res.ok) {
                    const message = data && data.message
                        ? data.message
                        : 'Máy chủ trả về lỗi ' + res.status + '. Vui lòng thử lại.';

                    throw new Error(message);
                }

                if (!data) {
                    throw new Error('Máy chủ không trả về dữ liệu hợp lệ.');
                }

                return data;
            });
        }

        function cancelRequest(id) {
            Swal.fire({
                title: 'Rút lại yêu cầu tư vấn?',
                text: 'Bạn chỉ nên hủy nếu không còn nhu cầu. Sau khi hủy, người bán/chuyên viên sẽ không xử lý tiếp yêu cầu này.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Giữ lại'
            }).then(function (result) {
                if (!result.isConfirmed) {
                    return;
                }

                const token = getCancelToken(id);

                const formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', token);

                Swal.fire({
                    title: 'Đang xử lý...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: function () {
                        Swal.showLoading();
                    }
                });

                fetch('/Consultations/CancelRequest', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'Accept': 'application/json'
                    }
                })
                    .then(safeParseJsonResponse)
                    .then(function (data) {
                        Swal.close();

                        if (data.success) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message || 'Đã hủy yêu cầu.',
                                showConfirmButton: false,
                                timer: 2200
                            });

                            const badge = document.getElementById(`badge-${id}`);

                            if (badge) {
                                badge.className = 'status-badge st-cancelled';
                                badge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Đã hủy';
                            }

                            const actionBox = document.getElementById(`action-box-${id}`);

                            if (actionBox) {
                                const viewButton = actionBox.querySelector('a')?.outerHTML || '';

                                actionBox.innerHTML =
                                    viewButton +
                                    '<button type="button" class="btn btn-light border btn-req text-muted" disabled>' +
                                    '<i class="bi bi-lock-fill"></i> Đã hủy' +
                                    '</button>';
                            }

                            setTimeout(function () {
                                location.reload();
                            }, 900);
                        } else {
                            Swal.fire('Không thể hủy', data.message || 'Hủy yêu cầu thất bại.', 'error');
                        }
                    })
                    .catch(function (err) {
                        Swal.close();
                        Swal.fire('Lỗi', err.message || 'Không thể kết nối máy chủ.', 'error');
                    });
            });
        }
    </script>
}