@model IEnumerable<BDSKhanhHoa.Models.Consultation>

@{
    ViewData["Title"] = "Lịch sử yêu cầu tư vấn";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    string GetStatusClass(string? status)
    {
        return status switch
        {
            "New" => "st-new",
            "Contacted" => "st-contacted",
            "Closed" => "st-closed",
            "Spam" => "st-spam",
            "Cancelled" => "st-cancelled",
            _ => "st-new"
        };
    }

    string GetStatusText(string? status)
    {
        return status switch
        {
            "New" => "Chờ người bán phản hồi",
            "Contacted" => "Đã được tiếp nhận",
            "Closed" => "Đã hoàn tất",
            "Spam" => "Bị từ chối",
            "Cancelled" => "Bạn đã hủy",
            _ => "Chờ phản hồi"
        };
    }

    string GetStatusIcon(string? status)
    {
        return status switch
        {
            "New" => "bi-hourglass-split",
            "Contacted" => "bi-telephone-inbound-fill",
            "Closed" => "bi-check-circle-fill",
            "Spam" => "bi-shield-x",
            "Cancelled" => "bi-x-circle-fill",
            _ => "bi-hourglass-split"
        };
    }

    string GetStatusDescription(string? status)
    {
        return status switch
        {
            "New" => "Yêu cầu đã gửi thành công. Bạn có thể hủy trước khi người bán tiếp nhận.",
            "Contacted" => "Người bán hoặc chuyên viên đã tiếp nhận yêu cầu của bạn.",
            "Closed" => "Quy trình tư vấn đã hoàn tất.",
            "Spam" => "Yêu cầu bị từ chối do thông tin không phù hợp hoặc không liên hệ được.",
            "Cancelled" => "Bạn đã rút lại yêu cầu này. Người bán sẽ không xử lý tiếp.",
            _ => "Yêu cầu đang được ghi nhận."
        };
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<style>
    .myreq-page {
        --req-primary: #2563eb;
        --req-success: #16a34a;
        --req-danger: #dc2626;
        --req-warning: #f59e0b;
        --req-dark: #0f172a;
        --req-muted: #64748b;
        --req-border: #e2e8f0;
        --req-soft: #f8fafc;
    }

    .myreq-hero {
        border-radius: 28px;
        padding: 26px;
        color: #fff;
        background: radial-gradient(circle at top left, rgba(255,255,255,0.15), transparent 24%), linear-gradient(135deg, #0f172a 0%, #1e293b 52%, #2563eb 100%);
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.16);
        margin-bottom: 24px;
    }

    .myreq-title {
        font-weight: 950;
        letter-spacing: -0.04em;
        margin-bottom: 6px;
    }

    .myreq-sub {
        color: rgba(255,255,255,0.78);
        margin-bottom: 0;
    }

    .request-card {
        border: 1px solid var(--req-border);
        border-radius: 24px;
        background: #fff;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.055);
        transition: 0.22s ease;
        height: 100%;
    }

        .request-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10);
            border-color: #cbd5e1;
        }

    .request-head {
        padding: 16px 18px;
        border-bottom: 1px solid #f1f5f9;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .request-body {
        padding: 18px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: 0.74rem;
        font-weight: 950;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .st-new {
        background: #fff7ed;
        color: #ea580c;
        border-color: #fed7aa;
    }

    .st-contacted {
        background: #eff6ff;
        color: #2563eb;
        border-color: #bfdbfe;
    }

    .st-closed {
        background: #f0fdf4;
        color: #16a34a;
        border-color: #bbf7d0;
    }

    .st-spam {
        background: #f1f5f9;
        color: #475569;
        border-color: #cbd5e1;
    }

    .st-cancelled {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .source-title {
        color: #0f172a;
        text-decoration: none;
        font-weight: 950;
        font-size: 1.05rem;
        line-height: 1.35;
        display: block;
    }

        .source-title:hover {
            color: #2563eb;
            text-decoration: underline;
        }

    .info-box {
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 18px;
        padding: 14px;
    }

    .timeline {
        position: relative;
        display: grid;
        gap: 10px;
        margin-top: 16px;
    }

    .timeline-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .timeline-dot {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        font-size: 0.82rem;
    }

    .empty-panel {
        border: 1px solid #e2e8f0;
        background: #fff;
        border-radius: 28px;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
    }

    @@media (max-width: 767.98px) {
        .myreq-hero {
            padding: 22px;
            border-radius: 24px;
        }

        .myreq-actions {
            width: 100%;
        }

            .myreq-actions .btn {
                width: 100%;
            }

        .request-head {
            display: block !important;
        }

            .request-head .status-badge {
                margin-top: 10px;
            }
    }
</style>

<div class="container-fluid px-0 myreq-page">
    <div class="myreq-hero">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-bold mb-2">
                    <i class="bi bi-clock-history me-1"></i> Lịch sử tư vấn
                </span>
                <h2 class="myreq-title">Yêu cầu tư vấn của bạn</h2>
                <p class="myreq-sub">
                    Theo dõi những bất động sản/dự án bạn đã gửi yêu cầu. Bạn chỉ có thể hủy khi người bán chưa tiếp nhận.
                </p>
            </div>

            <div class="myreq-actions">
                <a href="/Property/Search" class="btn btn-light rounded-pill fw-black px-4 py-2">
                    <i class="bi bi-search me-1"></i> Tìm BĐS mới
                </a>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-3">
            @foreach (var item in Model)
            {
                bool canCancel = item.Status == "New";

                <div class="col-xl-6 col-lg-12" id="card-req-@item.ConsultID">
                    <div class="request-card">
                        <div class="request-head d-flex justify-content-between align-items-center gap-3">
                            <div class="text-muted small fw-bold">
                                <i class="bi bi-calendar-event me-1"></i>
                                Gửi lúc @item.CreatedAt.ToString("HH:mm - dd/MM/yyyy")
                            </div>

                            <span id="badge-@item.ConsultID" class="status-badge @GetStatusClass(item.Status)">
                                <i class="bi @GetStatusIcon(item.Status)"></i>
                                @GetStatusText(item.Status)
                            </span>
                        </div>

                        <div class="request-body">
                            <div class="mb-3">
                                @if (item.Property != null)
                                {
                                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2">
                                        <i class="bi bi-house-door me-1"></i> Nhà đất
                                    </span>
                                    <a href="/Property/Details/@item.PropertyID" class="source-title" target="_blank">
                                        @item.Property.Title
                                    </a>
                                }
                                else if (item.Project != null)
                                {
                                    <span class="badge rounded-pill bg-info bg-opacity-10 text-info mb-2 px-3 py-2">
                                        <i class="bi bi-buildings me-1"></i> Dự án
                                    </span>
                                    <a href="/Project/Details/@item.ProjectID" class="source-title" target="_blank">
                                        @item.Project.ProjectName
                                    </a>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary mb-2 px-3 py-2">
                                        <i class="bi bi-question-circle me-1"></i> Không xác định
                                    </span>
                                    <div class="source-title text-muted fst-italic">
                                        Bất động sản hoặc dự án đã bị gỡ khỏi hệ thống.
                                    </div>
                                }
                            </div>

                            <div class="info-box mb-3">
                                <div class="small text-muted fw-black text-uppercase mb-1">
                                    <i class="bi bi-chat-left-text me-1"></i> Lời nhắn của bạn
                                </div>
                                <div class="text-dark fw-medium">
                                    @(string.IsNullOrWhiteSpace(item.Note) ? "Bạn chỉ để lại thông tin liên hệ, không có lời nhắn thêm." : item.Note)
                                </div>
                            </div>

                            <div class="info-box bg-white mb-3">
                                <div class="small text-muted fw-black text-uppercase mb-1">
                                    <i class="bi bi-telephone me-1"></i> Thông tin người bán nhận được
                                </div>
                                <div class="fw-bold text-dark">
                                    SĐT: @item.Phone
                                </div>
                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <div class="fw-semibold text-muted">
                                        Email: @item.Email
                                    </div>
                                }
                            </div>

                            <div class="timeline">
                                <div class="timeline-row">
                                    <div class="timeline-dot bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-send-check-fill"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">Đã gửi yêu cầu</div>
                                        <div class="text-muted small">Hệ thống đã ghi nhận yêu cầu tư vấn của bạn.</div>
                                    </div>
                                </div>

                                <div class="timeline-row">
                                    <div class="timeline-dot @((item.Status == "Contacted" || item.Status == "Closed") ? "bg-primary bg-opacity-10 text-primary" : "bg-light text-muted")">
                                        <i class="bi bi-telephone-inbound-fill"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">Người bán tiếp nhận</div>
                                        <div class="text-muted small">@GetStatusDescription(item.Status)</div>
                                    </div>
                                </div>

                                <div class="timeline-row">
                                    <div class="timeline-dot @(item.Status == "Closed" ? "bg-success bg-opacity-10 text-success" : item.Status == "Cancelled" || item.Status == "Spam" ? "bg-danger bg-opacity-10 text-danger" : "bg-light text-muted")">
                                        <i class="bi @(item.Status == "Closed" ? "bi-check-circle-fill" : item.Status == "Cancelled" || item.Status == "Spam" ? "bi-x-circle-fill" : "bi-circle")"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark small">Kết quả</div>
                                        <div class="text-muted small">
                                            @if (item.Status == "Closed")
                                            {
                                                <span>Yêu cầu đã hoàn tất.</span>
                                            }
                                            else if (item.Status == "Cancelled")
                                            {
                                                <span>Bạn đã hủy yêu cầu này.</span>
                                            }
                                            else if (item.Status == "Spam")
                                            {
                                                <span>Yêu cầu bị từ chối hoặc không thể liên hệ.</span>
                                            }
                                            else
                                            {
                                                <span>Chưa có kết quả cuối cùng.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="small text-muted fw-bold">
                                    @if (item.UpdatedAt.HasValue)
                                    {
                                        <span>Cập nhật: @item.UpdatedAt.Value.ToString("HH:mm - dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>Chưa có cập nhật mới</span>
                                    }
                                </div>

                                <div id="action-box-@item.ConsultID">
                                    @if (canCancel)
                                    {
                                        <form class="m-0" id="frmCancel-@item.ConsultID">
                                            @Html.AntiForgeryToken()
                                            <button type="button"
                                                    class="btn btn-outline-danger rounded-pill fw-black px-4"
                                                    onclick="cancelRequest(@item.ConsultID)">
                                                <i class="bi bi-x-circle me-1"></i> Rút lại yêu cầu
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-light border rounded-pill fw-black px-4 text-muted" disabled>
                                            <i class="bi bi-lock-fill me-1"></i> Không thể hủy
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-panel text-center py-5 px-3">
            <i class="bi bi-headset display-1 d-block mb-3 text-muted opacity-50"></i>
            <h4 class="fw-black text-dark mb-2">Bạn chưa gửi yêu cầu tư vấn nào</h4>
            <p class="text-muted fs-6 mb-4">
                Hãy tìm bất động sản phù hợp rồi gửi yêu cầu để chủ nhà hoặc môi giới liên hệ lại.
            </p>
            <a href="/Property/Search" class="btn btn-primary rounded-pill fw-black px-5 py-3">
                <i class="bi bi-search me-1"></i> Khám phá bất động sản
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function cancelRequest(id) {
            Swal.fire({
                title: 'Rút lại yêu cầu tư vấn?',
                text: 'Bạn chỉ nên hủy nếu không còn nhu cầu. Sau khi hủy, người bán sẽ không xử lý tiếp yêu cầu này.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý hủy',
                cancelButtonText: 'Giữ lại'
            }).then((result) => {
                if (!result.isConfirmed) return;

                const tokenEl = document.querySelector(`#frmCancel-${id} input[name="__RequestVerificationToken"]`);
                const token = tokenEl ? tokenEl.value : '';

                const formData = new FormData();
                formData.append('id', id);
                formData.append('__RequestVerificationToken', token);

                Swal.fire({
                    title: 'Đang xử lý...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => Swal.showLoading()
                });

                fetch('/Consultations/CancelRequest', {
                    method: 'POST',
                    body: formData
                })
                    .then(res => res.json())
                    .then(data => {
                        Swal.close();

                        if (data.success) {
                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: data.message || 'Đã hủy yêu cầu.',
                                showConfirmButton: false,
                                timer: 2200
                            });

                            const badge = document.getElementById(`badge-${id}`);

                            if (badge) {
                                badge.className = 'status-badge st-cancelled';
                                badge.innerHTML = '<i class="bi bi-x-circle-fill"></i> Bạn đã hủy';
                            }

                            const actionBox = document.getElementById(`action-box-${id}`);

                            if (actionBox) {
                                actionBox.innerHTML =
                                    '<button type="button" class="btn btn-light border rounded-pill fw-black px-4 text-muted" disabled>' +
                                    '<i class="bi bi-lock-fill me-1"></i> Đã hủy' +
                                    '</button>';
                            }
                        } else {
                            Swal.fire('Không thể hủy', data.message || 'Hủy yêu cầu thất bại.', 'error');
                        }
                    })
                    .catch(() => {
                        Swal.close();
                        Swal.fire('Lỗi', 'Không thể kết nối máy chủ.', 'error');
                    });
            });
        }
    </script>
}