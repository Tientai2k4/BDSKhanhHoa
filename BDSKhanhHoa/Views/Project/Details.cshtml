@section Scripts {
    <script>
           /* =========================
           LOAN CALCULATOR - SAFE INPUT
           Không dùng onkeyup để tránh nhảy số khi gõ tiếng Việt
        ========================= */

        function formatCurrencyDisplay(value) {
            const number = Number(value || 0);

            if (!Number.isFinite(number) || number <= 0) {
                return '0 đ';
            }

            return new Intl.NumberFormat('vi-VN').format(Math.round(number)) + ' đ';
        }

        function formatShortMoney(value) {
            const number = Number(value || 0);

            if (!Number.isFinite(number) || number <= 0) {
                return '0 đ';
            }

            if (number >= 1000000000) {
                return (number / 1000000000)
                    .toFixed(2)
                    .replace('.', ',')
                    .replace(',00', '') + ' tỷ';
            }

            if (number >= 1000000) {
                return (number / 1000000)
                    .toFixed(0)
                    .replace('.', ',') + ' triệu';
            }

            return formatCurrencyDisplay(number);
        }

        function onlyDigits(value) {
            return (value || '').toString().replace(/[^\d]/g, '');
        }

        function parseCurrencyInput(value) {
            const digits = onlyDigits(value);

            if (!digits) {
                return 0;
            }

            return Number(digits) || 0;
        }

        function parseDecimalInput(value) {
            if (!value) {
                return 0;
            }

            const normalized = value
                .toString()
                .replace(',', '.')
                .replace(/[^\d.]/g, '');

            const number = Number(normalized);

            if (!Number.isFinite(number)) {
                return 0;
            }

            return number;
        }

        function clampNumber(value, min, max) {
            let number = Number(value || 0);

            if (!Number.isFinite(number)) {
                number = min;
            }

            if (number < min) {
                number = min;
            }

            if (number > max) {
                number = max;
            }

            return number;
        }

        function formatCurrencyInputOnBlur(input) {
            if (!input) {
                return;
            }

            const value = parseCurrencyInput(input.value);

            if (value <= 0) {
                input.value = '';
                return;
            }

            input.value = new Intl.NumberFormat('vi-VN').format(value);
        }

        function updateRangeBackground(range) {
            if (!range) {
                return;
            }

            const min = Number(range.min || 0);
            const max = Number(range.max || 100);
            const value = Number(range.value || 0);
            const percent = max > min ? ((value - min) * 100 / (max - min)) : 0;

            range.style.background = `linear-gradient(90deg, #2563eb 0%, #2563eb ${percent}%, #dbeafe ${percent}%, #dbeafe 100%)`;
        }

        function resetLoanResult() {
            const ids = [
                'resOwnCapital',
                'resLoanAmount',
                'resPrincipalMonth',
                'resTotalInterest',
                'resFirstMonth',
                'resTotalPay'
            ];

            ids.forEach(function (id) {
                const el = document.getElementById(id);

                if (el) {
                    el.innerText = '0 đ';
                }
            });
        }

        function calculateLoan() {
            const loanPrice = document.getElementById('loanPrice');
            const loanRatioRange = document.getElementById('loanRatioRange');
            const loanYearsRange = document.getElementById('loanYearsRange');
            const loanInterest = document.getElementById('loanInterest');

            if (!loanPrice || !loanRatioRange || !loanYearsRange || !loanInterest) {
                return;
            }

            const propertyValue = parseCurrencyInput(loanPrice.value);

            let ratio = clampNumber(parseCurrencyInput(loanRatioRange.value), 10, 90);
            let years = clampNumber(parseCurrencyInput(loanYearsRange.value), 1, 35);
            let interestRate = clampNumber(parseDecimalInput(loanInterest.value), 0, 30);

            loanRatioRange.value = ratio;
            loanYearsRange.value = years;

            updateRangeBackground(loanRatioRange);
            updateRangeBackground(loanYearsRange);

            const lblPropertyValue = document.getElementById('lblPropertyValue');
            const lblLoanRatio = document.getElementById('lblLoanRatio');
            const lblLoanYears = document.getElementById('lblLoanYears');
            const lblLoanInterest = document.getElementById('lblLoanInterest');

            if (lblPropertyValue) {
                lblPropertyValue.innerText = formatShortMoney(propertyValue);
            }

            if (lblLoanRatio) {
                lblLoanRatio.innerText = ratio + '%';
            }

            if (lblLoanYears) {
                lblLoanYears.innerText = years + ' năm';
            }

            if (lblLoanInterest) {
                lblLoanInterest.innerText = interestRate.toString().replace('.', ',') + '%/năm';
            }

            const months = years * 12;

            if (propertyValue <= 0 || months <= 0) {
                resetLoanResult();
                return;
            }

            const loanAmount = propertyValue * ratio / 100;
            const ownCapital = propertyValue - loanAmount;
            const monthlyInterestRate = interestRate / 100 / 12;
            const principalPerMonth = loanAmount / months;

            /*
               Dư nợ giảm dần:
               - Gốc trả đều mỗi tháng
               - Lãi tháng đầu = số tiền vay * lãi suất tháng
               - Tổng lãi = lãi giảm đều theo dư nợ còn lại
            */
            const firstMonthInterest = loanAmount * monthlyInterestRate;
            const firstMonthTotal = principalPerMonth + firstMonthInterest;
            const totalInterest = loanAmount * monthlyInterestRate * (months + 1) / 2;
            const totalToPay = loanAmount + totalInterest;

            document.getElementById('resOwnCapital').innerText = formatCurrencyDisplay(ownCapital);
            document.getElementById('resLoanAmount').innerText = formatCurrencyDisplay(loanAmount);
            document.getElementById('resPrincipalMonth').innerText = formatCurrencyDisplay(principalPerMonth);
            document.getElementById('resTotalInterest').innerText = formatCurrencyDisplay(totalInterest);
            document.getElementById('resFirstMonth').innerText = formatCurrencyDisplay(firstMonthTotal);
            document.getElementById('resTotalPay').innerText = formatCurrencyDisplay(totalToPay);
        }

        function initLoanCalculator() {
            const loanPrice = document.getElementById('loanPrice');
            const loanRatioRange = document.getElementById('loanRatioRange');
            const loanYearsRange = document.getElementById('loanYearsRange');
            const loanInterest = document.getElementById('loanInterest');

            if (!loanPrice || !loanRatioRange || !loanYearsRange || !loanInterest) {
                return;
            }

            const safeInput = function (input, callback) {
                let isComposing = false;

                input.addEventListener('compositionstart', function () {
                    isComposing = true;
                });

                input.addEventListener('compositionend', function () {
                    isComposing = false;
                    callback();
                });

                input.addEventListener('input', function () {
                    if (isComposing) {
                        return;
                    }

                    callback();
                });
            };

            safeInput(loanPrice, calculateLoan);
            safeInput(loanInterest, calculateLoan);

            loanPrice.addEventListener('blur', function () {
                formatCurrencyInputOnBlur(loanPrice);
                calculateLoan();
            });

            loanInterest.addEventListener('blur', function () {
                const value = clampNumber(parseDecimalInput(loanInterest.value), 0, 30);
                loanInterest.value = value.toString().replace('.', ',');
                calculateLoan();
            });

            loanRatioRange.addEventListener('input', calculateLoan);
            loanYearsRange.addEventListener('input', calculateLoan);

            formatCurrencyInputOnBlur(loanPrice);
            calculateLoan();
        }

        document.addEventListener('DOMContentLoaded', initLoanCalculator);
        function showToast(message, type) {
            const toast = document.getElementById('pjToast');
            const toastText = document.getElementById('pjToastText');

            if (!toast || !toastText) {
                alert(message);
                return;
            }

            toastText.innerText = message || 'Thành công';

            if (type === 'error') {
                toast.style.background = 'linear-gradient(135deg,#991b1b,#ef4444)';
                toast.querySelector('i').className = 'bi bi-exclamation-triangle-fill';
            } else {
                toast.style.background = 'linear-gradient(135deg,#0f172a,#1e293b)';
                toast.querySelector('i').className = 'bi bi-check-circle-fill';
            }

            toast.classList.add('show');

            setTimeout(function () {
                toast.classList.remove('show');
            }, 3600);
        }

        async function postAjaxForm(form, onSuccess) {
            const button = form.querySelector('button[type="submit"]');

            if (!button) {
                form.submit();
                return;
            }

            const originalHtml = button.innerHTML;

            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý...';
            button.disabled = true;

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    if (typeof onSuccess === 'function') {
                        onSuccess(data);
                    }
                } else {
                    showToast(data.message || 'Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.', 'error');
                }
            } catch (error) {
                console.error(error);
                showToast('Hệ thống đang bận, vui lòng thử lại sau.', 'error');
            } finally {
                button.innerHTML = originalHtml;
                button.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            calculateLoan();

            const contactModal = document.getElementById('contactModal');

            contactModal?.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const tab = button?.getAttribute('data-tab') || 'lead';

                const leadTab = document.getElementById('lead-tab');
                const bookingTab = document.getElementById('booking-tab');
                const leadPane = document.getElementById('lead-pane');
                const bookingPane = document.getElementById('booking-pane');

                if (tab === 'booking' && bookingTab && !bookingTab.classList.contains('disabled')) {
                    leadTab?.classList.remove('active');
                    leadPane?.classList.remove('show', 'active');

                    bookingTab.classList.add('active');
                    bookingPane?.classList.add('show', 'active');
                } else {
                    bookingTab?.classList.remove('active');
                    bookingPane?.classList.remove('show', 'active');

                    leadTab?.classList.add('active');
                    leadPane?.classList.add('show', 'active');
                }
            });

            const frmLead = document.getElementById('frmLead');

            frmLead?.addEventListener('submit', function (event) {
                event.preventDefault();

                postAjaxForm(frmLead, function (data) {
                    showToast(data.message || 'Gửi yêu cầu tư vấn thành công!');

                    const messageInput = frmLead.querySelector('textarea[name="Message"]');

                    if (messageInput) {
                        messageInput.value = '';
                    }

                    const modal = bootstrap.Modal.getInstance(contactModal);

                    if (modal) {
                        modal.hide();
                    }
                });
            });

            const frmBooking = document.getElementById('frmBooking');

            frmBooking?.addEventListener('submit', function (event) {
                event.preventDefault();

                postAjaxForm(frmBooking, function (data) {
                    showToast(data.message || 'Tạo lịch hẹn thành công! Vui lòng chờ chúng tôi xác nhận.');

                    const appointmentDate = frmBooking.querySelector('input[name="appointmentDate"]');
                    const appointmentTime = frmBooking.querySelector('input[name="appointmentTime"]');
                    const note = frmBooking.querySelector('textarea[name="note"]');

                    if (appointmentDate) {
                        appointmentDate.value = '';
                    }

                    if (appointmentTime) {
                        appointmentTime.value = '';
                    }

                    if (note) {
                        note.value = '';
                    }

                    const modal = bootstrap.Modal.getInstance(contactModal);

                    if (modal) {
                        modal.hide();
                    }
                });
            });

            document.querySelectorAll('a[href^="#"]').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    const targetId = this.getAttribute('href');

                    if (!targetId || targetId === '#') {
                        return;
                    }

                    const target = document.querySelector(targetId);

                    if (!target) {
                        return;
                    }

                    event.preventDefault();

                    const offset = 110;
                    const top = target.getBoundingClientRect().top + window.pageYOffset - offset;

                    window.scrollTo({
                        top: top,
                        behavior: 'smooth'
                    });
                });
            });
        });
    </script>
}