    /* ===== PATCH: Clean project image + compact overview moved below image ===== */
    .pj-hero-clean {
        min-height: auto !important;
        aspect-ratio: 21 / 9;
        border-radius: 34px !important;
        margin: 22px 0 22px !important;
        background: #07111f !important;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .20) !important;
    }

        .pj-hero-clean::before,
        .pj-hero-clean::after {
            display: none !important;
        }

        .pj-hero-clean .pj-hero-media {
            position: absolute;
            inset: 0;
            display: block;
            overflow: hidden;
            background: linear-gradient(135deg, #0f172a, #111827);
        }

        .pj-hero-clean .pj-hero-bg {
            inset: -36px;
            width: calc(100% + 72px);
            height: calc(100% + 72px);
            object-fit: cover;
            filter: blur(30px) saturate(1.15) brightness(.78);
            transform: scale(1.08);
            opacity: .88;
        }

        .pj-hero-clean .pj-hero-img {
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain !important;
            object-position: center center !important;
            filter: none !important;
            background: transparent;
        }

    .pj-overview-section {
        overflow: hidden;
        border-radius: 34px;
        background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(248,250,252,.98));
        border: 1px solid rgba(226,232,240,.98);
        box-shadow: 0 20px 55px rgba(15,23,42,.08);
    }

    .pj-overview-hero {
