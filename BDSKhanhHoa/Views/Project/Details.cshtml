                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert pj-alert pj-alert-danger alert-dismissible fade show mt-4 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <section class="pj-hero">
            <img src="@image"
                 class="pj-hero-img"
                 alt="@Model.ProjectName"
                 loading="eager"
                 decoding="async"
                 fetchpriority="high"
                 draggable="false"
                 onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

            <div class="pj-hero-content">
                <div class="pj-hero-grid">
                    <div>
                        <div class="pj-topline">
                            <span class="pj-pill pj-pill-status">
                                <i class="bi bi-check-circle-fill"></i>
                                @statusText
                            </span>

                            <span class="pj-pill">
                                <i class="bi bi-building-fill"></i>
                                @projectTypeText
                            </span>

                            <span class="pj-pill pj-pill-price">
                                <i class="bi bi-cash-stack"></i>
                                @priceText
                            </span>

                            <span class="pj-pill">
                                <i class="bi bi-shield-check"></i>
                                Đã phê duyệt
                            </span>
                        </div>

                        <h1 class="pj-hero-title">@Model.ProjectName</h1>

                        <div class="pj-hero-address">
                            <i class="bi bi-geo-alt-fill"></i>
                            <span>@detailAddress</span>
                        </div>

                        <div class="pj-hero-actions">
                            @if (isAuthenticated)
                            {
                                <button type="button" class="pj-btn pj-btn-primary" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="booking">
                                    <i class="bi bi-calendar2-week-fill"></i>
                                    Đặt lịch xem dự án
                                </button>
                            }
                            else
                            {
                                <a href="/Account/Login" class="pj-btn pj-btn-primary">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Đăng nhập để đặt lịch
                                </a>
                            }

                            <button type="button" class="pj-btn pj-btn-glass" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="lead">
                                <i class="bi bi-headset"></i>
                                Nhận bảng giá
                            </button>

                            <a href="@googleMapUrl" target="_blank" rel="noopener" class="pj-btn pj-btn-glass">
                                <i class="bi bi-map-fill"></i>
                                Xem bản đồ
                            </a>

                            <a href="tel:@hotlineHref" class="pj-btn pj-btn-glass">
                                <i class="bi bi-telephone-fill"></i>
                                Gọi ngay
                            </a>
                        </div>
                    </div>

                    <aside class="pj-hero-panel">
                        <div class="pj-hero-panel-label">Giá dự kiến</div>
                        <div class="pj-hero-price">@priceText</div>

                        <div class="pj-hero-panel-row">
                            <i class="bi bi-person-badge-fill"></i>
                            <div>
                                <div class="small opacity-75">Chủ đầu tư</div>
                                <div>@investorText</div>
                            </div>
                        </div>

                        <div class="pj-hero-panel-row">
                            <i class="bi bi-aspect-ratio-fill"></i>
                            <div>
                                <div class="small opacity-75">Diện tích</div>
                                <div>@areaText</div>
                            </div>
                        </div>

                        <div class="pj-hero-panel-row">
                            <i class="bi bi-geo-fill"></i>
                            <div>
                                <div class="small opacity-75">Khu vực</div>
                                <div>@(Model.Area?.AreaName ?? "Khánh Hòa")</div>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </section>

        <div class="pj-nav-strip">
            <nav class="pj-nav-inner">
                <a class="pj-nav-link" href="#overview"><i class="bi bi-stars"></i>Tổng quan</a>
                <a class="pj-nav-link" href="#intro"><i class="bi bi-journal-text"></i>Giới thiệu</a>
                <a class="pj-nav-link" href="#loan-calculator"><i class="bi bi-calculator"></i>Tính khoản vay</a>
                <a class="pj-nav-link" href="#timeline"><i class="bi bi-clock-history"></i>Tiến độ</a>
                <a class="pj-nav-link" href="#legal"><i class="bi bi-shield-check"></i>Pháp lý</a>
                <a class="pj-nav-link" href="#lead-form"><i class="bi bi-headset"></i>Tư vấn</a>
            </nav>
        </div>

        <div class="pj-layout">
            <main class="pj-main">

                <section class="pj-stat-grid" id="overview">
                    <div class="pj-stat-card">
                        <div class="pj-stat-icon">
                            <i class="bi bi-eye-fill"></i>
                        </div>
                        <div class="pj-stat-label">Lượt xem</div>
                        <div class="pj-stat-value">@FormatInteger(totalViews)</div>
                    </div>

                    <div class="pj-stat-card">
                        <div class="pj-stat-icon" style="background:linear-gradient(135deg,#f97316,#f59e0b);">
                            <i class="bi bi-chat-dots-fill"></i>
                        </div>
                        <div class="pj-stat-label">Khách quan tâm</div>
                        <div class="pj-stat-value">@FormatInteger(leadCount)</div>
                    </div>

                    <div class="pj-stat-card">
                        <div class="pj-stat-icon" style="background:linear-gradient(135deg,#16a34a,#10b981);">
                            <i class="bi bi-house-door-fill"></i>
                        </div>
                        <div class="pj-stat-label">Tin trong dự án</div>
                        <div class="pj-stat-value">@FormatInteger(totalProperties)</div>
                    </div>
                </section>

                <section class="pj-section">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>
                                <div class="pj-section-kicker">Project overview</div>
                                <h2 class="pj-section-title">Thông tin tổng quan dự án</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-grid-1x2-fill"></i>
                            </div>
                        </div>

                        <div class="pj-spec-grid">
                            <div class="pj-spec-card">
                                <div class="pj-spec-icon pj-icon-blue">
                                    <i class="bi bi-building-check"></i>
                                </div>
                                <div class="pj-spec-label">Chủ đầu tư</div>
                                <div class="pj-spec-value text-primary" title="@investorText">@investorText</div>
                            </div>

                            <div class="pj-spec-card">
                                <div class="pj-spec-icon pj-icon-red">
                                    <i class="bi bi-tags-fill"></i>
                                </div>
                                <div class="pj-spec-label">Giá dự kiến</div>
                                <div class="pj-spec-value text-danger">@priceText</div>
                            </div>

                            <div class="pj-spec-card">
                                <div class="pj-spec-icon pj-icon-green">
                                    <i class="bi bi-aspect-ratio-fill"></i>
                                </div>
                                <div class="pj-spec-label">Quy mô</div>
                                <div class="pj-spec-value">@scaleText</div>
                            </div>

                            <div class="pj-spec-card">
                                <div class="pj-spec-icon pj-icon-purple">
                                    <i class="bi bi-rulers"></i>
                                </div>
                                <div class="pj-spec-label">Diện tích</div>
                                <div class="pj-spec-value">@areaText</div>
                            </div>

                            <div class="pj-spec-card">
                                <div class="pj-spec-icon pj-icon-gold">
                                    <i class="bi bi-pie-chart-fill"></i>
                                </div>
                                <div class="pj-spec-label">Mật độ xây dựng</div>
                                <div class="pj-spec-value">@densityText</div>
                            </div>

                            <div class="pj-spec-card">
                                <div class="pj-spec-icon pj-icon-slate">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                                <div class="pj-spec-label">Pháp lý</div>
                                <div class="pj-spec-value text-success">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Đã phê duyệt
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pj-section" id="intro">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>
                                <div class="pj-section-kicker">Introduction</div>
                                <h2 class="pj-section-title">Giới thiệu chi tiết dự án</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-journal-richtext"></i>
                            </div>
                        </div>

                        <div class="pj-content-reader">
                            @if (!string.IsNullOrWhiteSpace(Model.ContentHtml))
                            {
                                @Html.Raw(Model.ContentHtml)
                            }
                            else
                            {
                                <p>@descriptionText</p>
                            }
                        </div>

                        <div class="pj-utility-box mt-4">
                            <div class="pj-utility-title">
                                <i class="bi bi-stars"></i>
                                Hệ thống tiện ích
                            </div>
                            <p class="pj-utility-text">@utilitiesText</p>
                        </div>
                    </div>
                </section>

                <section class="pj-section" id="loan-calculator">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>
                                <div class="pj-section-kicker">Finance planner</div>
                                <h2 class="pj-section-title">Ước tính khoản vay mua @Model.ProjectName</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-calculator-fill"></i>
                            </div>
                        </div>

                        <div class="pj-loan-grid">
                            <div class="pj-loan-form">
                                <div class="pj-loan-group">
                                    <label class="pj-loan-label">
                                        <span>Giá trị nhà đất</span>
                                        <span id="lblPropertyValue" class="pj-loan-value">@FormatMoney(defaultLoanPrice)</span>
                                    </label>
                                    <input type="text"
                                           id="loanPrice"
                                           class="pj-control"
                                           value="@defaultLoanPrice.ToString("N0", Vi)"
                                           inputmode="numeric"
                                           onkeyup="formatCurrencyInput(this); calculateLoan();" />
                                </div>

                                <div class="pj-loan-group">
                                    <label class="pj-loan-label">
                                        <span>Tỉ lệ vay</span>
                                        <span id="lblLoanRatio" class="pj-loan-value">50%</span>
                                    </label>
                                    <input type="range"
                                           id="loanRatioRange"
                                           class="pj-range"
                                           min="10"
                                           max="100"
                                           value="50"
                                           step="5"
                                           oninput="syncRangeToInput('loanRatioRange','loanRatio'); calculateLoan();" />
                                    <input type="number"
                                           id="loanRatio"
                                           class="pj-control"
                                           value="50"
                                           min="0"
                                           max="100"
                                           oninput="syncInputToRange('loanRatio','loanRatioRange'); calculateLoan();" />
                                </div>

                                <div class="pj-loan-group">
                                    <label class="pj-loan-label">
                                        <span>Thời hạn vay</span>
                                        <span id="lblLoanYears" class="pj-loan-value">5 năm</span>
                                    </label>
                                    <input type="range"
                                           id="loanYearsRange"
                                           class="pj-range"
                                           min="1"
                                           max="35"
                                           value="5"
                                           step="1"
                                           oninput="syncRangeToInput('loanYearsRange','loanYears'); calculateLoan();" />
                                    <input type="number"
                                           id="loanYears"
                                           class="pj-control"
                                           value="5"
                                           min="1"
                                           max="35"
                                           oninput="syncInputToRange('loanYears','loanYearsRange'); calculateLoan();" />
                                </div>

                                <div class="pj-loan-group">
                                    <label class="pj-loan-label">
                                        <span>Lãi suất ngân hàng</span>
                                        <span class="pj-loan-value text-muted">Dư nợ giảm dần</span>
                                    </label>
                                    <input type="number"
                                           id="loanInterest"
                                           class="pj-control"
                                           value="6.0"
                                           min="0"
                                           max="30"
                                           step="0.1"
                                           oninput="calculateLoan();" />
                                </div>
                            </div>

                            <div class="pj-loan-result">
                                <div class="pj-loan-result-title">
                                    Kế hoạch tài chính
                                </div>

                                <div class="pj-loan-row">
                                    <span>Vốn tự có</span>
                                    <span id="resOwnCapital">0 đ</span>
                                </div>

                                <div class="pj-loan-row">
                                    <span>Gốc cần vay</span>
                                    <span id="resLoanAmount">0 đ</span>
                                </div>

                                <div class="pj-loan-row">
                                    <span>Tổng lãi cần trả</span>
                                    <span id="resTotalInterest">0 đ</span>
                                </div>

                                <div class="pj-loan-row">
                                    <span>Tháng đầu tiên</span>
                                    <span id="resFirstMonth" style="color:#fde68a;">0 đ</span>
                                </div>

                                <div class="pj-loan-highlight">
                                    <div class="pj-loan-highlight-label">Tổng số tiền cần trả</div>
                                    <span class="pj-loan-highlight-value" id="resTotalPay">0 đ</span>
                                    <p class="pj-loan-note">
                                        Kết quả chỉ mang tính tham khảo, lãi suất và chính sách vay thực tế có thể thay đổi theo từng ngân hàng.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pj-section" id="timeline">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>
                                <div class="pj-section-kicker">Construction progress</div>
                                <h2 class="pj-section-title">Nhật ký & tiến độ thi công</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-clock-history"></i>
                            </div>
                        </div>

                        <div class="pj-timeline">
                            @if (milestones.Any())
                            {
                                foreach (var m in milestones)
                                {
                                    <div class="pj-timeline-item">
                                        <div class="pj-timeline-dot">
                                            <i class="bi bi-wrench-adjustable"></i>
                                        </div>

                                        <div class="pj-timeline-card">
                                            <span class="pj-timeline-date">
                                                <i class="bi bi-calendar-event"></i>
                                                @FormatDateTime(m.Date)
                                            </span>
                                            <div class="pj-timeline-title">@m.Title</div>
                                            <p class="pj-timeline-desc">@m.Description</p>
                                        </div>
                                    </div>
                                }
                            }

                            <div class="pj-timeline-item">
                                <div class="pj-timeline-dot pj-timeline-dot-start">
                                    <i class="bi bi-flag-fill"></i>
                                </div>

                                <div class="pj-timeline-card">
                                    <span class="pj-timeline-date" style="background:#ecfdf5;color:#15803d;">
                                        <i class="bi bi-rocket-takeoff-fill"></i>
                                        @FormatShortDate(Model.CreatedAt)
                                    </span>
                                    <div class="pj-timeline-title text-success">Khởi tạo & công bố dự án</div>
                                    <p class="pj-timeline-desc">Dự án chính thức được phê duyệt và hiển thị công khai trên Cổng thông tin BĐS Khánh Hòa.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pj-section" id="legal">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>
                                <div class="pj-section-kicker">Legal profile</div>
                                <h2 class="pj-section-title">Thông tin pháp lý & hồ sơ</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-shield-check"></i>
                            </div>
                        </div>

                        <div class="pj-info-grid">
                            <div class="pj-info-row">
                                <div class="pj-info-key">
                                    <i class="bi bi-activity"></i>
                                    Trạng thái
                                </div>
                                <div class="pj-info-value">@statusText</div>
                            </div>

                            <div class="pj-info-row">
                                <div class="pj-info-key">
                                    <i class="bi bi-map-fill"></i>
                                    Khu vực
                                </div>
                                <div class="pj-info-value">@(Model.Area?.AreaName ?? "Khánh Hòa")</div>
                            </div>

                            <div class="pj-info-row">
                                <div class="pj-info-key">
                                    <i class="bi bi-pin-map-fill"></i>
                                    Phường/Xã
                                </div>
                                <div class="pj-info-value">@(Model.Ward?.WardName ?? "Đang cập nhật")</div>
                            </div>

                            <div class="pj-info-row">
                                <div class="pj-info-key">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    Bản đồ
                                </div>
                                <div class="pj-info-value">
                                    <a href="@googleMapUrl" target="_blank" rel="noopener">
                                        Mở Google Maps
                                        <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="pj-info-row">
                                <div class="pj-info-key">
                                    <i class="bi bi-file-earmark-pdf-fill"></i>
                                    Hồ sơ pháp lý
                                </div>
                                <div class="pj-info-value">
                                    @if (!string.IsNullOrWhiteSpace(Model.LegalDocs))
                                    {
                                        <a href="@Model.LegalDocs" target="_blank" rel="noopener" class="text-success">
                                            Tải / Xem file đính kèm
                                            <i class="bi bi-download ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span>Chưa cập nhật tài liệu công khai</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                @if (relatedProjects.Any())
                {
                    <section class="pj-section">
                        <div class="pj-section-inner">
                            <div class="pj-section-head">
                                <div>
                                    <div class="pj-section-kicker">Related projects</div>
                                    <h2 class="pj-section-title">Dự án liên quan</h2>
                                </div>
                                <a href="/Project/Search" class="pj-btn pj-btn-dark">
                                    Xem thêm
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>

                            <div class="pj-related-grid">
                                @foreach (var item in relatedProjects)
                                {
                                    var relatedImage = GetSafeImage(
                                    !string.IsNullOrWhiteSpace(item.MainImage)
                                    ? item.MainImage
                                    : (!string.IsNullOrWhiteSpace(item.Thumbnail) ? item.Thumbnail : "/images/no-image.jpg")
                                    );

                                    <a href="/Project/Details/@item.ProjectID" class="pj-related-card">
                                        <div class="pj-related-img-wrap">
                                            <img src="@relatedImage"
                                                 alt="@item.ProjectName"
                                                 loading="lazy"
                                                 decoding="async"
                                                 draggable="false"
                                                 onerror="this.onerror=null;this.src='/images/no-image.jpg';" />
                                            <span class="pj-related-badge">
                                                @(string.IsNullOrWhiteSpace(item.ProjectStatus) ? "Dự án" : item.ProjectStatus)
                                            </span>
                                        </div>

                                        <div class="pj-related-body">
                                            <div class="pj-related-title">@item.ProjectName</div>
                                            <div class="pj-related-meta">
                                                <i class="bi bi-geo-alt-fill"></i>
                                                <span>@item.Ward?.WardName, @item.Area?.AreaName</span>
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                        </div>
                    </section>
                }
            </main>

            <aside class="pj-sidebar">
                <div class="pj-sticky">
                    <section class="pj-lead-card" id="lead-form">
                        <div class="pj-lead-head">
                            <div class="pj-lead-icon">
                                <i class="bi bi-headset"></i>
                            </div>
                            <div class="pj-lead-title">Đăng ký tư vấn</div>
                            <p class="pj-lead-sub">
                                Nhận bảng giá, mặt bằng, chính sách ưu đãi và lịch xem dự án mới nhất.
                            </p>
                        </div>

                        <div class="pj-lead-body">
                            <div class="pj-side-summary">
                                <div class="pj-side-line">
                                    <span>Giá</span>
                                    <span>@priceText</span>
                                </div>

                                <div class="pj-side-line">
                                    <span>Diện tích</span>
                                    <span>@areaText</span>
                                </div>

                                <div class="pj-side-line">
                                    <span>Khu vực</span>
                                    <span>@(Model.Area?.AreaName ?? "Khánh Hòa")</span>
                                </div>
                            </div>

                            <button type="button" class="pj-btn pj-btn-primary w-100" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="lead">
                                <i class="bi bi-send-fill"></i>
                                Mở form tư vấn nhanh
                            </button>

                            @if (isAuthenticated)
                            {
                                <button type="button" class="pj-btn pj-btn-dark w-100 mt-2" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="booking">
                                    <i class="bi bi-calendar-check-fill"></i>
                                    Đặt lịch xem dự án
                                </button>
                            }
                            else
                            {
                                <a href="/Account/Login" class="pj-btn pj-btn-dark w-100 mt-2">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Đăng nhập để đặt lịch
                                </a>
                            }

                            <div class="pj-call-card">
                                <div class="pj-call-title">Hotline tư vấn</div>
                                <a href="tel:@hotlineHref" class="pj-call-number">
                                    <i class="bi bi-telephone-inbound-fill me-1"></i>
                                    @hotlineRaw
                                </a>
                            </div>
                        </div>
                    </section>

                    <section class="pj-legal-side">
                        <h6>
                            <i class="bi bi-shield-check me-1"></i>
                            Pháp lý minh bạch
                        </h6>
                        <p>Dự án đã được kiểm duyệt theo hồ sơ hệ thống và thông tin công khai.</p>

                        @if (!string.IsNullOrWhiteSpace(Model.LegalDocs))
                        {
                            <a href="@Model.LegalDocs" target="_blank" rel="noopener" class="pj-btn pj-btn-dark w-100">
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                Xem hồ sơ pháp lý
                            </a>
                        }
                    </section>
                </div>
            </aside>
        </div>
    </div>

    <div class="pj-mobile-bar">
        <button type="button" class="pj-btn pj-btn-primary" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="lead">
            <i class="bi bi-headset"></i>
            Tư vấn
        </button>

        @if (isAuthenticated)
        {
            <button type="button" class="pj-btn pj-btn-dark" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="booking">
                <i class="bi bi-calendar-check-fill"></i>
                Xem dự án
            </button>
        }
        else
        {
            <a href="/Account/Login" class="pj-btn pj-btn-dark">
                <i class="bi bi-box-arrow-in-right"></i>
                Đăng nhập
            </a>
        }
    </div>
</div>

<div class="modal fade pj-modal" id="contactModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="pj-modal-header">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h4 class="pj-modal-title">@Model.ProjectName</h4>
                        <p class="pj-modal-sub">Chọn hình thức phù hợp để gửi yêu cầu hoặc đặt lịch xem dự án.</p>
                    </div>

                    <button type="button" class="btn-close mt-1" data-bs-dismiss="modal"></button>
                </div>
            </div>

            <div class="pj-modal-body">
                <ul class="nav nav-pills pj-tabs" id="contactTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active"
                                id="lead-tab"
                                data-bs-toggle="pill"
                                data-bs-target="#lead-pane"
                                type="button"
                                role="tab">
                            <i class="bi bi-headset me-1"></i>
                            Tư vấn nhanh
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(isAuthenticated ? "" : "disabled")"
                                id="booking-tab"
                                data-bs-toggle="pill"
                                data-bs-target="#booking-pane"
                                type="button"
                                role="tab">
                            <i class="bi bi-calendar2-week me-1"></i>
                            Đặt lịch xem
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="lead-pane" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-lg-5">
                                <div class="pj-modal-summary">
                                    <div class="pj-section-kicker">Project summary</div>
                                    <h5 class="fw-black mb-3">Tóm tắt dự án</h5>

                                    <div class="pj-info-grid">
                                        <div class="pj-info-row">
                                            <div class="pj-info-key">
                                                <i class="bi bi-building"></i>
                                                Chủ đầu tư
                                            </div>
                                            <div class="pj-info-value text-primary">@investorText</div>
                                        </div>

                                        <div class="pj-info-row">
                                            <div class="pj-info-key">
                                                <i class="bi bi-tags"></i>
                                                Giá
                                            </div>
                                            <div class="pj-info-value text-danger">@priceText</div>
                                        </div>

                                        <div class="pj-info-row">
                                            <div class="pj-info-key">
                                                <i class="bi bi-aspect-ratio"></i>
                                                Diện tích
                                            </div>
                                            <div class="pj-info-value">@areaText</div>
                                        </div>
                                    </div>

                                    @if (!isAuthenticated)
                                    {
                                        <div class="alert alert-info mt-4 mb-0 small rounded-4 border-0">
                                            <i class="bi bi-info-circle-fill me-1"></i>
                                            <a href="/Account/Login" class="fw-bold">Đăng nhập</a> để hệ thống tự động điền thông tin của bạn.
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-7">
                                <form id="frmLead" asp-controller="Project" asp-action="SubmitLead" method="post" class="row g-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProjectID" value="@Model.ProjectID" />

                                    <div class="col-md-6">
                                        <label class="pj-form-label">Họ và tên</label>
                                        <input type="text"
                                               name="Name"
                                               class="form-control pj-soft-input"
                                               required
                                               placeholder="VD: Nguyễn Văn A"
                                               value="@currentName" />
                                    </div>

                                    <div class="col-md-6">
                                        <label class="pj-form-label">Số điện thoại</label>
                                        <input type="tel"
                                               name="Phone"
                                               class="form-control pj-soft-input"
                                               required
                                               placeholder="VD: 0912345678"
                                               value="@currentPhone"
                                               maxlength="10"
                                               minlength="10"
                                               pattern="^0[0-9]{9}$"
                                               title="Số điện thoại phải bắt đầu bằng số 0 và có chính xác 10 chữ số"
                                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                                    </div>

                                    <div class="col-12">
                                        <label class="pj-form-label">Email</label>
                                        <input type="email"
                                               name="Email"
                                               class="form-control pj-soft-input"
                                               placeholder="name@example.com"
                                               value="@currentEmail" />
                                    </div>

                                    <div class="col-12">
                                        <label class="pj-form-label">Nhu cầu</label>
                                        <textarea name="Message"
                                                  class="form-control pj-soft-input"
                                                  rows="4"
                                                  placeholder="Ví dụ: Tôi quan tâm căn hộ 2 phòng ngủ, cần báo giá chi tiết..."></textarea>
                                    </div>

                                    <div class="col-12 mt-2">
                                        <button type="submit" class="pj-submit">
                                            <i class="bi bi-send-fill"></i>
                                            Gửi yêu cầu ngay
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="booking-pane" role="tabpanel">
                        @if (isAuthenticated)
                        {
                            <form id="frmBooking" asp-controller="Appointments" asp-action="Create" method="post" class="row g-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="projectId" value="@Model.ProjectID" />

                                <div class="col-md-4">
                                    <label class="pj-form-label">Họ và tên</label>
                                    <input type="text"
                                           name="customerName"
                                           class="form-control pj-soft-input"
                                           required
                                           placeholder="Họ tên người đi xem"
                                           value="@currentName" />
                                </div>

                                <div class="col-md-4">
                                    <label class="pj-form-label">Số điện thoại</label>
                                    <input type="tel"
                                           name="customerPhone"
                                           class="form-control pj-soft-input"
                                           required
                                           placeholder="VD: 0912345678"
                                           value="@currentPhone"
                                           maxlength="10"
                                           minlength="10"
                                           pattern="^0[0-9]{9}$"
                                           title="Số điện thoại phải bắt đầu bằng số 0 và có chính xác 10 chữ số"
                                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                                </div>

                                <div class="col-md-4">
                                    <label class="pj-form-label">Email</label>
                                    <input type="email"
                                           name="customerEmail"
                                           class="form-control pj-soft-input"
                                           placeholder="name@example.com"
                                           value="@currentEmail" />
                                </div>

                                <div class="col-md-4">
                                    <label class="pj-form-label">Ngày hẹn</label>
                                    <input type="date"
                                           name="appointmentDate"
                                           class="form-control pj-soft-input"
                                           required />
                                </div>

                                <div class="col-md-4">
                                    <label class="pj-form-label">Giờ hẹn</label>
                                    <input type="time"
                                           name="appointmentTime"
                                           class="form-control pj-soft-input"
                                           required />
                                </div>

                                <div class="col-md-4">
                                    <label class="pj-form-label">Điểm gặp</label>
                                    <input type="text"
                                           name="meetingLocation"
                                           class="form-control pj-soft-input"
                                           value="Khu dự án @Model.ProjectName" />
                                </div>

                                <div class="col-12">
                                    <label class="pj-form-label">Ghi chú thêm</label>
                                    <textarea name="note"
                                          class="form-control pj-soft-input"
                                          rows="3"
                                          placeholder="Ví dụ: Tôi muốn xem nhà mẫu thực tế, liên hệ trước khi đến..."></textarea>
                                </div>

                                <div class="col-12 mt-2">
                                    <button type="submit" class="pj-submit">
                                        <i class="bi bi-calendar-check-fill"></i>
                                        Xác nhận đặt lịch
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 rounded-4 mb-0 text-center py-5">
                                <i class="bi bi-lock-fill display-4 text-warning mb-3 d-block"></i>
                                <h5 class="fw-black">Bạn cần đăng nhập để sử dụng tính năng đặt lịch</h5>
                                <p class="text-muted mb-4">Hệ thống cần lưu lại lịch hẹn để chuyên viên liên hệ chính xác nhất.</p>
                                <a href="/Account/Login" class="pj-btn pj-btn-primary">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Đăng nhập ngay
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="pjToast" class="pj-toast">
    <i class="bi bi-check-circle-fill"></i>
    <span id="pjToastText">Thành công</span>
</div>

@section Scripts {
    <script>
        function formatCurrencyDisplay(num) {
            num = Number(num || 0);
            return new Intl.NumberFormat('vi-VN').format(Math.round(num)) + ' đ';
        }

        function formatCurrencyInput(input) {
            let value = input.value.replace(/\D/g, '');

            if (value === '') {
                value = '0';
            }

            input.value = new Intl.NumberFormat('vi-VN').format(Number(value));
        }

        function getNumberFromInput(value) {
            if (!value) {
                return 0;
            }

            return Number(value.toString().replace(/\./g, '').replace(/,/g, '').replace(/\D/g, '')) || 0;
        }

        function syncRangeToInput(rangeId, inputId) {
            const range = document.getElementById(rangeId);
            const input = document.getElementById(inputId);

            if (!range || !input) {
                return;
            }

            input.value = range.value;
        }

        function syncInputToRange(inputId, rangeId) {
            const input = document.getElementById(inputId);
            const range = document.getElementById(rangeId);

            if (!input || !range) {
                return;
            }

            let value = Number(input.value || 0);
            const min = Number(range.min || 0);
            const max = Number(range.max || 100);

            if (value < min) {
                value = min;
            }

            if (value > max) {
                value = max;
            }

            range.value = value;
        }

        function calculateLoan() {
            const loanPrice = document.getElementById('loanPrice');
            const loanRatio = document.getElementById('loanRatio');
            const loanRatioRange = document.getElementById('loanRatioRange');
            const loanYears = document.getElementById('loanYears');
            const loanYearsRange = document.getElementById('loanYearsRange');
            const loanInterest = document.getElementById('loanInterest');

            if (!loanPrice || !loanRatio || !loanYears || !loanInterest) {
                return;
            }

            let propertyValue = getNumberFromInput(loanPrice.value);
            let ratio = Number(loanRatio.value || 0);
            let years = Number(loanYears.value || 0);
            let interestRate = Number(loanInterest.value || 0);

            if (ratio < 0) {
                ratio = 0;
            }

            if (ratio > 100) {
                ratio = 100;
            }

            if (years < 1) {
                years = 1;
            }

            if (years > 35) {
                years = 35;
            }

            loanRatio.value = ratio;
            loanYears.value = years;

            if (loanRatioRange) {
                loanRatioRange.value = ratio;
            }

            if (loanYearsRange) {
                loanYearsRange.value = years;
            }

            document.getElementById('lblPropertyValue').innerText = formatCurrencyDisplay(propertyValue);
            document.getElementById('lblLoanRatio').innerText = ratio + '%';
            document.getElementById('lblLoanYears').innerText = years + ' năm';

            const months = years * 12;

            if (months <= 0 || propertyValue <= 0) {
                resetLoanResult();
                return;
            }

            const loanAmount = propertyValue * ratio / 100;
            const ownCapital = propertyValue - loanAmount;
            const monthlyInterestRate = interestRate / 100 / 12;
            const principalPerMonth = loanAmount / months;
            const firstMonthInterest = loanAmount * monthlyInterestRate;
            const firstMonthTotal = principalPerMonth + firstMonthInterest;
            const totalInterest = (months + 1) * loanAmount * monthlyInterestRate / 2;
            const totalToPay = loanAmount + totalInterest;

            document.getElementById('resOwnCapital').innerText = formatCurrencyDisplay(ownCapital);
            document.getElementById('resLoanAmount').innerText = formatCurrencyDisplay(loanAmount);
            document.getElementById('resTotalInterest').innerText = formatCurrencyDisplay(totalInterest);
            document.getElementById('resFirstMonth').innerText = formatCurrencyDisplay(firstMonthTotal);

            if (totalToPay >= 1000000000) {
                document.getElementById('resTotalPay').innerText = (totalToPay / 1000000000).toFixed(2).replace('.', ',') + ' tỷ';
            } else {
                document.getElementById('resTotalPay').innerText = formatCurrencyDisplay(totalToPay);
            }
        }

        function resetLoanResult() {
            document.getElementById('resOwnCapital').innerText = '0 đ';
            document.getElementById('resLoanAmount').innerText = '0 đ';
            document.getElementById('resTotalInterest').innerText = '0 đ';
            document.getElementById('resFirstMonth').innerText = '0 đ';
            document.getElementById('resTotalPay').innerText = '0 đ';
        }

        function showToast(message, type) {
            const toast = document.getElementById('pjToast');
            const toastText = document.getElementById('pjToastText');

            if (!toast || !toastText) {
                alert(message);
                return;
            }

            toastText.innerText = message || 'Thành công';

            if (type === 'error') {
                toast.style.background = 'linear-gradient(135deg,#991b1b,#ef4444)';
                toast.querySelector('i').className = 'bi bi-exclamation-triangle-fill';
            } else {
                toast.style.background = 'linear-gradient(135deg,#0f172a,#1e293b)';
                toast.querySelector('i').className = 'bi bi-check-circle-fill';
            }

            toast.classList.add('show');

            setTimeout(function () {
                toast.classList.remove('show');
            }, 3600);
        }

        async function postAjaxForm(form, onSuccess) {
            const button = form.querySelector('button[type="submit"]');

            if (!button) {
                form.submit();
                return;
            }

            const originalHtml = button.innerHTML;

            button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý...';
            button.disabled = true;

            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const data = await response.json();

                if (data.success) {
                    if (typeof onSuccess === 'function') {
                        onSuccess(data);
                    }
                } else {
                    showToast(data.message || 'Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.', 'error');
                }
            } catch (error) {
                console.error(error);
                showToast('Hệ thống đang bận, vui lòng thử lại sau.', 'error');
            } finally {
                button.innerHTML = originalHtml;
                button.disabled = false;
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            calculateLoan();

            const contactModal = document.getElementById('contactModal');

            contactModal?.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const tab = button?.getAttribute('data-tab') || 'lead';

                const leadTab = document.getElementById('lead-tab');
                const bookingTab = document.getElementById('booking-tab');
                const leadPane = document.getElementById('lead-pane');
                const bookingPane = document.getElementById('booking-pane');

                if (tab === 'booking' && bookingTab && !bookingTab.classList.contains('disabled')) {
                    leadTab?.classList.remove('active');
                    leadPane?.classList.remove('show', 'active');

                    bookingTab.classList.add('active');
                    bookingPane?.classList.add('show', 'active');
                } else {
                    bookingTab?.classList.remove('active');
                    bookingPane?.classList.remove('show', 'active');

                    leadTab?.classList.add('active');
                    leadPane?.classList.add('show', 'active');
                }
            });

            const frmLead = document.getElementById('frmLead');

            frmLead?.addEventListener('submit', function (event) {
                event.preventDefault();

                postAjaxForm(frmLead, function (data) {
                    showToast(data.message || 'Gửi yêu cầu tư vấn thành công!');

                    const messageInput = frmLead.querySelector('textarea[name="Message"]');

                    if (messageInput) {
                        messageInput.value = '';
                    }

                    const modal = bootstrap.Modal.getInstance(contactModal);

                    if (modal) {
                        modal.hide();
                    }
                });
            });

            const frmBooking = document.getElementById('frmBooking');

            frmBooking?.addEventListener('submit', function (event) {
                event.preventDefault();

                postAjaxForm(frmBooking, function (data) {
                    showToast(data.message || 'Tạo lịch hẹn thành công! Vui lòng chờ chúng tôi xác nhận.');

                    const appointmentDate = frmBooking.querySelector('input[name="appointmentDate"]');
                    const appointmentTime = frmBooking.querySelector('input[name="appointmentTime"]');
                    const note = frmBooking.querySelector('textarea[name="note"]');

                    if (appointmentDate) {
                        appointmentDate.value = '';
                    }

                    if (appointmentTime) {
                        appointmentTime.value = '';
                    }

                    if (note) {
                        note.value = '';
                    }

                    const modal = bootstrap.Modal.getInstance(contactModal);

                    if (modal) {
                        modal.hide();
                    }
                });
            });

            document.querySelectorAll('a[href^="#"]').forEach(function (link) {
                link.addEventListener('click', function (event) {
                    const targetId = this.getAttribute('href');

                    if (!targetId || targetId === '#') {
                        return;
                    }

                    const target = document.querySelector(targetId);

                    if (!target) {
                        return;
                    }

                    event.preventDefault();

                    const offset = 110;
                    const top = target.getBoundingClientRect().top + window.pageYOffset - offset;

                    window.scrollTo({
                        top: top,
                        behavior: 'smooth'
                    });
                });
            });
        });
    </script>
}