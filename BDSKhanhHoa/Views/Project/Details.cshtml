@model BDSKhanhHoa.Models.Project
@using System.Globalization
@using System.Text.Json
@using System.Security.Claims

@functions {
    public class MilestoneDto
    {
        public string Id { get; set; } = "";
        public DateTime Date { get; set; }
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string GetSafeImage(string image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/no-image.jpg";
        }

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
        {
            return image;
        }

        return "/" + image.TrimStart('/');
    }

    private string FormatDecimal(decimal? value)
    {
        if (!value.HasValue)
        {
            return "--";
        }

        return value.Value.ToString("0.##", Vi);
    }

    private string FormatInteger(int value)
    {
        return value.ToString("N0", Vi);
    }

    private string FormatMoney(decimal value)
    {
        return value.ToString("N0", Vi) + " đ";
    }

    private string FormatShortDate(DateTime date)
    {
        return date.ToString("dd/MM/yyyy", Vi);
    }

    private string FormatDateTime(DateTime date)
    {
        return date.ToString("dd/MM/yyyy HH:mm", Vi);
    }
}

@{
    ViewData["Title"] = Model.ProjectName + " - Tổng quan, Tiến độ & Bảng giá";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var relatedProjects = ViewBag.RelatedProjects as IEnumerable<BDSKhanhHoa.Models.Project> ?? new List<BDSKhanhHoa.Models.Project>();

    int leadCount = ViewBag.LeadCount is int lc ? lc : 0;
    int totalViews = ViewBag.TotalViews is int tv ? tv : 0;
    int totalProperties = ViewBag.TotalProperties is int tp ? tp : 0;

    bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;

    string currentName = "";
    string currentPhone = "";
    string currentEmail = "";

    if (isAuthenticated)
    {
        currentName = User.FindFirst(ClaimTypes.Name)?.Value ?? User.FindFirst("FullName")?.Value ?? "";
        currentEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
        currentPhone = User.FindFirst(ClaimTypes.MobilePhone)?.Value ?? User.FindFirst("Phone")?.Value ?? "";
    }

    string image = GetSafeImage(
        !string.IsNullOrWhiteSpace(Model.MainImage)
            ? Model.MainImage
            : (!string.IsNullOrWhiteSpace(Model.Thumbnail) ? Model.Thumbnail : "/images/no-image.jpg")
    );

    string detailAddress = $"{Model.AddressDetail}, {Model.Ward?.WardName}, {Model.Area?.AreaName}, Tỉnh Khánh Hòa";

    string priceText = Model.PriceMin.HasValue && Model.PriceMax.HasValue
        ? $"{Model.PriceMin.Value.ToString("0.##", Vi)} - {Model.PriceMax.Value.ToString("0.##", Vi)} {Model.PriceUnit}"
        : Model.PriceMin.HasValue
            ? $"{Model.PriceMin.Value.ToString("0.##", Vi)} {Model.PriceUnit}"
            : "Đang cập nhật";

    string areaText = Model.AreaMin.HasValue && Model.AreaMax.HasValue
        ? $"{Model.AreaMin.Value.ToString("0.##", Vi)} - {Model.AreaMax.Value.ToString("0.##", Vi)} m²"
        : Model.AreaMin.HasValue
            ? $"Từ {Model.AreaMin.Value.ToString("0.##", Vi)} m²"
            : "Đang cập nhật";

    decimal defaultLoanPrice = (Model.PriceMin ?? 2m) *
        (string.Equals(Model.PriceUnit, "Tỷ", StringComparison.OrdinalIgnoreCase) ? 1000000000m : 1000000m);

    if (defaultLoanPrice <= 0)
    {
        defaultLoanPrice = 2000000000m;
    }

    string mapQuery = Uri.EscapeDataString($"{Model.AddressDetail} {Model.Ward?.WardName} {Model.Area?.AreaName} Khánh Hòa");
    string googleMapUrl = $"https://www.google.com/maps/search/?api=1&query={mapQuery}";

    string hotlineRaw = !string.IsNullOrWhiteSpace(Model.Owner?.Phone) ? Model.Owner.Phone : "1900 88 99";
    string hotlineHref = hotlineRaw.Replace(" ", "").Replace(".", "").Replace("-", "");

    var milestones = new List<MilestoneDto>();

    if (!string.IsNullOrWhiteSpace(Model.TimelineJson))
    {
        try
        {
            milestones = JsonSerializer.Deserialize<List<MilestoneDto>>(
                Model.TimelineJson,
                new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }
            ) ?? new List<MilestoneDto>();

            milestones = milestones
                .Where(m => !string.IsNullOrWhiteSpace(m.Title))
                .OrderByDescending(m => m.Date)
                .ToList();
        }
        catch
        {
            milestones = new List<MilestoneDto>();
        }
    }

    string statusText = string.IsNullOrWhiteSpace(Model.ProjectStatus) ? "Đang cập nhật" : Model.ProjectStatus;
    string projectTypeText = string.IsNullOrWhiteSpace(Model.ProjectType) ? "Dự án bất động sản" : Model.ProjectType;
    string investorText = string.IsNullOrWhiteSpace(Model.Investor) ? "Đang cập nhật" : Model.Investor;
    string scaleText = string.IsNullOrWhiteSpace(Model.Scale) ? "Đang cập nhật" : Model.Scale;
    string densityText = string.IsNullOrWhiteSpace(Model.ConstructionDensity) ? "Đang cập nhật" : Model.ConstructionDensity;
    string utilitiesText = string.IsNullOrWhiteSpace(Model.Utilities) ? "Đang cập nhật tiện ích dự án." : Model.Utilities;
    string descriptionText = string.IsNullOrWhiteSpace(Model.Description) ? "Thông tin mô tả dự án đang được cập nhật." : Model.Description;
}

<meta name="chatbot-context" content="Khách hàng đang xem chi tiết Dự án tên là: '@Model.ProjectName'. Giá bán: @priceText. Chủ đầu tư: @investorText. Vị trí: @detailAddress. Quy mô: @scaleText. Mật độ xây dựng: @densityText." />

