</style>

<div class="project-detail-page">
    <div class="project-shell">

        @if (TempData["Success"] != null)
        {
            <div class="alert pj-alert pj-alert-success alert-dismissible fade show mt-4 mb-0">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert pj-alert pj-alert-danger alert-dismissible fade show mt-4 mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <section class="pj-hero pj-hero-clean" aria-label="Ảnh dự án @Model.ProjectName">
            <div class="pj-hero-media">
                <img src="@image"
                     class="pj-hero-bg"
                     alt=""
                     aria-hidden="true"
                     loading="eager"
                     decoding="async"
                     draggable="false"
                     onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                <img src="@image"
                     class="pj-hero-img"
                     alt="@Model.ProjectName"
                     loading="eager"
                     decoding="async"
                     fetchpriority="high"
                     draggable="false"
                     onerror="this.onerror=null;this.src='/images/no-image.jpg';" />
            </div>
        </section>

        <div class="pj-nav-strip">
            <nav class="pj-nav-inner">
                <a class="pj-nav-link" href="#overview"><i class="bi bi-stars"></i>Tổng quan</a>
                <a class="pj-nav-link" href="#intro"><i class="bi bi-journal-text"></i>Giới thiệu</a>
                <a class="pj-nav-link" href="#loan-calculator"><i class="bi bi-calculator"></i>Tính khoản vay</a>
                <a class="pj-nav-link" href="#timeline"><i class="bi bi-clock-history"></i>Tiến độ</a>
                <a class="pj-nav-link" href="#legal"><i class="bi bi-shield-check"></i>Pháp lý</a>
                <a class="pj-nav-link" href="#lead-form"><i class="bi bi-headset"></i>Tư vấn</a>
            </nav>
        </div>

        <div class="pj-layout">
            <main class="pj-main">

                <section class="pj-section pj-overview-section" id="overview">
                    <div class="pj-overview-hero">
                        <div class="pj-overview-main">
                            <div class="pj-overview-kicker">
                                <i class="bi bi-stars"></i>
                                Tổng quan dự án
                            </div>
                            <h1 class="pj-overview-title">@Model.ProjectName</h1>
                            <div class="pj-overview-address">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@detailAddress</span>
                            </div>

                            <div class="pj-overview-badges">
                                <span class="pj-overview-badge is-success">
                                    <i class="bi bi-check-circle-fill"></i>
                                    @statusText
                                </span>
                                <span class="pj-overview-badge">
                                    <i class="bi bi-building-fill"></i>
                                    @projectTypeText
                                </span>
                                <span class="pj-overview-badge is-gold">
                                    <i class="bi bi-cash-stack"></i>
                                    @priceText
                                </span>
                                <span class="pj-overview-badge is-blue">
                                    <i class="bi bi-shield-check"></i>
                                    Đã phê duyệt
                                </span>
                            </div>
                        </div>

                        <div class="pj-overview-price-card">
                            <div class="pj-overview-price-label">Giá dự kiến</div>
                            <div class="pj-overview-price-value">@priceText</div>
                            <div class="pj-overview-price-note">Thông tin giá chỉ mang tính tham khảo, vui lòng liên hệ tư vấn để nhận bảng giá mới nhất.</div>
                        </div>
                    </div>

                    <div class="pj-overview-actions">
                        @if (isAuthenticated)
                        {
                            <button type="button" class="pj-btn pj-btn-primary" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="booking">
                                <i class="bi bi-calendar2-week-fill"></i>
                                Đặt lịch xem dự án
                            </button>
                        }
                        else
                        {
                            <a href="/Account/Login" class="pj-btn pj-btn-primary">
                                <i class="bi bi-box-arrow-in-right"></i>
                                Đăng nhập để đặt lịch
                            </a>
                        }

                        <button type="button" class="pj-btn pj-btn-dark" data-bs-toggle="modal" data-bs-target="#contactModal" data-tab="lead">
                            <i class="bi bi-headset"></i>
                            Nhận bảng giá
                        </button>

                        <a href="@googleMapUrl" target="_blank" rel="noopener" class="pj-btn pj-btn-soft-blue">
                            <i class="bi bi-map-fill"></i>
                            Xem bản đồ
                        </a>

                        <a href="tel:@hotlineHref" class="pj-btn pj-btn-soft-green">
                            <i class="bi bi-telephone-fill"></i>
                            Gọi ngay
                        </a>
                    </div>

                    <div class="pj-overview-stats">
                        <div class="pj-overview-stat">
                            <span class="pj-overview-stat-icon"><i class="bi bi-eye-fill"></i></span>
                            <span class="pj-overview-stat-label">Lượt xem</span>
                            <strong>@FormatInteger(totalViews)</strong>
                        </div>

                        <div class="pj-overview-stat">
                            <span class="pj-overview-stat-icon is-orange"><i class="bi bi-chat-dots-fill"></i></span>
                            <span class="pj-overview-stat-label">Khách quan tâm</span>
                            <strong>@FormatInteger(leadCount)</strong>
                        </div>

                        <div class="pj-overview-stat">
                            <span class="pj-overview-stat-icon is-green"><i class="bi bi-house-door-fill"></i></span>
                            <span class="pj-overview-stat-label">Tin trong dự án</span>
                            <strong>@FormatInteger(totalProperties)</strong>
                        </div>
                    </div>

                    <div class="pj-section-inner pj-overview-inner">
                        <div class="pj-section-head pj-overview-head">
                            <div>
                                <div class="pj-section-kicker">Project overview</div>
                                <h2 class="pj-section-title">Thông tin tổng quan dự án</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-grid-1x2-fill"></i>
                            </div>
                        </div>

                        <div class="pj-overview-grid">
                            <div class="pj-overview-item is-wide">
                                <div class="pj-overview-item-icon pj-icon-blue">
                                    <i class="bi bi-building-check"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Chủ đầu tư</div>
                                    <div class="pj-overview-item-value">@investorText</div>
                                </div>
                            </div>

                            <div class="pj-overview-item is-price">
                                <div class="pj-overview-item-icon pj-icon-red">
                                    <i class="bi bi-tags-fill"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Giá dự kiến</div>
                                    <div class="pj-overview-item-value">@priceText</div>
                                </div>
                            </div>

                            <div class="pj-overview-item">
                                <div class="pj-overview-item-icon pj-icon-green">
                                    <i class="bi bi-aspect-ratio-fill"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Quy mô</div>
                                    <div class="pj-overview-item-value">@scaleText</div>
                                </div>
                            </div>

                            <div class="pj-overview-item">
                                <div class="pj-overview-item-icon pj-icon-purple">
                                    <i class="bi bi-rulers"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Diện tích</div>
                                    <div class="pj-overview-item-value">@areaText</div>
                                </div>
                            </div>

                            <div class="pj-overview-item">
                                <div class="pj-overview-item-icon pj-icon-gold">
                                    <i class="bi bi-pie-chart-fill"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Mật độ xây dựng</div>
                                    <div class="pj-overview-item-value">@densityText</div>
                                </div>
                            </div>

                            <div class="pj-overview-item">
                                <div class="pj-overview-item-icon pj-icon-slate">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Pháp lý</div>
                                    <div class="pj-overview-item-value text-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>
                                        Đã phê duyệt
                                    </div>
                                </div>
                            </div>

                            <div class="pj-overview-item">
                                <div class="pj-overview-item-icon pj-icon-blue">
                                    <i class="bi bi-map-fill"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Khu vực</div>
                                    <div class="pj-overview-item-value">@(Model.Area?.AreaName ?? "Khánh Hòa")</div>
                                </div>
                            </div>

                            <div class="pj-overview-item is-address">
                                <div class="pj-overview-item-icon pj-icon-red">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                                <div>
                                    <div class="pj-overview-item-label">Vị trí dự án</div>
                                    <div class="pj-overview-item-value">@detailAddress</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pj-section" id="intro">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>

                                <h2 class="pj-section-title">Giới thiệu chi tiết dự án</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-journal-richtext"></i>
                            </div>
                        </div>

                        <div class="pj-content-reader">
                            @if (!string.IsNullOrWhiteSpace(Model.ContentHtml))
                            {
                                @Html.Raw(Model.ContentHtml)
                            }
                            else
                            {
                                <p>@descriptionText</p>
                            }
                        </div>

                        <div class="pj-utility-box mt-4">
                            <div class="pj-utility-title">
                                <i class="bi bi-stars"></i>
                                Hệ thống tiện ích
                            </div>
                            <p class="pj-utility-text">@utilitiesText</p>
                        </div>
                    </div>
                </section>

                <section class="pj-section" id="loan-calculator">
                    <div class="pj-section-inner">
                        <div class="pj-section-head">
                            <div>
                                <div class="pj-section-kicker">Finance planner</div>
                                <h2 class="pj-section-title">Ước tính khoản vay mua @Model.ProjectName</h2>
                            </div>
                            <div class="pj-section-icon">
                                <i class="bi bi-calculator-fill"></i>
                            </div>
                        </div>

                        <div class="pj-loan-grid">
                            <div class="pj-loan-form">
                                <div class="pj-loan-intro">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <div>
                                        <div class="pj-loan-intro-title">Công cụ ước tính nhanh</div>
                                        <p class="pj-loan-intro-text">
                                            Nhập giá trị nhà đất, kéo chọn tỉ lệ vay, thời hạn vay và lãi suất ngân hàng để ước tính nhanh khoản tiền cần chuẩn bị.
                                            Kết quả được tính theo phương án dư nợ giảm dần.
                                        </p>
                                    </div>
                                </div>

                                <div class="pj-loan-group">
                                    <label class="pj-loan-label" for="loanPrice">
                                        <span><i class="bi bi-house-check-fill"></i> Giá trị nhà đất</span>
                                        <span id="lblPropertyValue" class="pj-loan-value">@FormatMoney(defaultLoanPrice)</span>
                                    </label>

                                    <div class="pj-input-wrap">
                                        <input type="text"
                                               id="loanPrice"
                                               class="pj-control"
                                               value="@defaultLoanPrice.ToString("N0", Vi)"
                                               inputmode="numeric"
                                               autocomplete="off"
                                               spellcheck="false"
                                               placeholder="Ví dụ: 2.000.000.000" />
                                        <span class="pj-input-suffix">đ</span>
                                    </div>
                                </div>

