<div class="project-page-2026">
    <div class="project-shell">
        <div class="filter-floating-wrap">
            <div class="filter-box-2026">
                <details class="filter-details-2026" @(hasActiveFilter ? "open" : "")>
                    <summary class="filter-summary-2026">
                        <div class="filter-summary-main">
                            <span class="filter-summary-icon">
                                <i class="bi bi-sliders2"></i>
                            </span>

                            <div class="filter-summary-text">
                                <div class="filter-summary-title">Bộ lọc dự án</div>
                                <div class="filter-summary-sub">
                                    @GetAreaFilterText() · @GetStatusFilterText() · @GetSortFilterText()
                                </div>
                            </div>
                        </div>

                        <div class="filter-summary-right">
                            @if (hasActiveFilter)
                            {
                                <span class="filter-active-dot" title="Đang có bộ lọc"></span>
                            }
                            <i class="bi bi-chevron-down chev"></i>
                        </div>
                    </summary>

                    <div class="filter-body-2026">
                        <div class="filter-title-row">
                            <div>
                                <h2 class="filter-title">
                                    <i class="bi bi-sliders2"></i>
                                    Bộ lọc dự án
                                </h2>
                            </div>

                            <p class="filter-note">
                                Tìm nhanh dự án theo từ khóa, khu vực, tiến độ và sắp xếp.
                            </p>
                        </div>

                        <form action="/Project/Search" method="get">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4">
                                    <label class="field-label-2026">Từ khóa tìm kiếm</label>
                                    <div class="input-shell-2026">
                                        <i class="bi bi-search input-icon"></i>
                                        <input type="text"
                                               name="keyword"
                                               value="@keyword"
                                               class="control-2026"
                                               placeholder="Tên dự án, chủ đầu tư, khu vực..." />
                                    </div>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="field-label-2026">Khu vực</label>
                                    <select name="areaId" class="control-2026">
                                        <option value="">Tất cả vị trí</option>
                                        @foreach (var a in areas)
                                        {
                                            <option value="@a.AreaID" selected="@(areaId.HasValue && areaId.Value == a.AreaID)">
                                                @a.AreaName
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="field-label-2026">Trạng thái</label>
                                    <select name="status" class="control-2026">
                                        <option value="" selected="@statusAllSelected">Mọi tiến độ</option>
                                        <option value="Sắp mở bán" selected="@statusComingSelected">Sắp mở bán</option>
                                        <option value="Đang mở bán" selected="@statusSellingSelected">Đang mở bán</option>
                                        <option value="Đã bàn giao" selected="@statusDoneSelected">Đã bàn giao</option>
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <label class="field-label-2026">Sắp xếp</label>
                                    <select name="sort" class="control-2026">
                                        <option value="newest" selected="@sortNewestSelected">Mới cập nhật</option>
                                        <option value="price_asc" selected="@sortPriceAscSelected">Giá thấp → cao</option>
                                        <option value="price_desc" selected="@sortPriceDescSelected">Giá cao → thấp</option>
                                        <option value="area_desc" selected="@sortAreaDescSelected">Diện tích lớn</option>
                                    </select>
                                </div>

                                <div class="col-lg-2 col-md-6">
                                    <button type="submit" class="btn-search-2026">
                                        <i class="bi bi-funnel-fill"></i>
                                        Lọc dự án
                                    </button>
                                </div>
                                <div class="col-12 filter-clear-mobile-wrap">
                                    <a href="/Project" class="filter-clear-mobile">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                        Xóa bộ lọc
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </details>
            </div>
        </div>

        <section class="result-head">
            <div>
                <h2 class="result-title">Danh sách dự án</h2>
                <p class="result-sub">
                    Tìm thấy <strong>@FormatNumber(totalResults)</strong> dự án phù hợp với điều kiện lọc.
                </p>
            </div>

            <div class="view-chip-row">
                <span class="view-chip">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                    @FormatNumber(totalResults) dự án
                </span>
            </div>
        </section>

        @if (Model != null && Model.Any())
        {
            <section class="project-grid-2026">
                @foreach (var item in Model)
                {
                    string projectImage = GetSafeImage(!string.IsNullOrWhiteSpace(item.MainImage) ? item.MainImage : "/images/no-image.jpg");
                    string location = $"{item.Ward?.WardName}, {item.Area?.AreaName}";
                    string projectPriceText = FormatProjectPrice(item.PriceMin, item.PriceMax, item.PriceUnit);
                    string projectStatus = string.IsNullOrWhiteSpace(item.ProjectStatus) ? "Đang cập nhật" : item.ProjectStatus;
                    string projectType = string.IsNullOrWhiteSpace(item.ProjectType) ? "Dự án" : item.ProjectType;
                    string investor = string.IsNullOrWhiteSpace(item.Investor) ? "Đang cập nhật chủ đầu tư" : item.Investor;
                    string statusClass = GetStatusClass(item.ProjectStatus);
                    string statusIcon = GetStatusIcon(item.ProjectStatus);
                    string description = string.IsNullOrWhiteSpace(item.Description) ? "Thông tin mô tả dự án đang được cập nhật." : item.Description;

                    <article class="project-card-2026">
                        <div class="project-img-wrap-2026">
                            <img src="@projectImage"
                                 alt="@item.ProjectName"
                                 loading="lazy"
                                 decoding="async"
                                 draggable="false"
                                 onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                            <span class="status-badge-2026 @statusClass">
                                <i class="bi @statusIcon"></i>
                                @projectStatus
                            </span>

                            <span class="price-tag-2026" title="@projectPriceText">
                                <i class="bi bi-cash-coin"></i>
                                @projectPriceText
                            </span>
                        </div>

                        <div class="project-body-2026">
                            <h3 class="project-title-2026">
                                <a href="/Project/Details/@item.ProjectID">
                                    @item.ProjectName
                                </a>
                            </h3>

                            <div class="project-location-2026" title="@location">
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>@location</span>
                            </div>

                            <div class="spec-row-2026">
                                <span class="spec-pill-2026">
                                    <i class="bi bi-building"></i>
                                    @projectType
                                </span>


                            </div>

                            <p class="project-desc-2026">
                                @description
                            </p>

                            <div class="project-footer-2026">
                                <div class="investor-2026" title="@investor">
                                    <i class="bi bi-patch-check-fill"></i>
                                    <span>@investor</span>
                                </div>

                                <div class="action-row-2026">
                                    <a href="/Project/Details/@item.ProjectID" class="btn-card-2026 btn-detail-2026">
                                        <i class="bi bi-info-circle"></i>
                                        Chi tiết
                                    </a>

                                    <button type="button"
                                            class="btn-card-2026 btn-contact-2026"
                                            data-bs-toggle="modal"
                                            data-bs-target="#quickLeadModal"
                                            data-projectid="@item.ProjectID"
                                            data-projectname="@item.ProjectName">
                                        <i class="bi bi-headset"></i>
                                        Tư vấn
                                    </button>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="empty-box-2026">
                <div class="empty-icon-2026">
                    <i class="bi bi-search"></i>
                </div>

                <h3 class="fw-black text-dark mb-2">Không tìm thấy dự án phù hợp</h3>

                <p class="text-muted mb-4 fs-6">
                    Hãy thử thay đổi từ khóa, khu vực, trạng thái hoặc xóa bộ lọc hiện tại.
                </p>

                <a href="/Project" class="btn-card-2026 btn-contact-2026 d-inline-flex px-4">
                    <i class="bi bi-arrow-clockwise"></i>
                    Xóa bộ lọc
                </a>
            </section>
        }

        @if (totalPages > 1)
        {
            <div class="pagination-wrap-2026">
                <nav class="pagination-2026">
                    <a class="page-link-2026 @(currentPage <= 1 ? "disabled" : "")"
                       href="@Url.Action("Search", "Project", new { keyword, areaId, status, sort, page = currentPage - 1 })">
                        <i class="bi bi-chevron-left"></i>
                    </a>

                    @if (startPage > 1)
                    {
                        <a class="page-link-2026" href="@Url.Action("Search", "Project", new { keyword, areaId, status, sort, page = 1 })">1</a>

                        @if (startPage > 2)
                        {
                            <span class="page-link-2026 disabled">...</span>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <a class="page-link-2026 @(currentPage == i ? "active" : "")"
                           href="@Url.Action("Search", "Project", new { keyword, areaId, status, sort, page = i })">
                            @i
                        </a>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <span class="page-link-2026 disabled">...</span>
                        }

                        <a class="page-link-2026" href="@Url.Action("Search", "Project", new { keyword, areaId, status, sort, page = totalPages })">@totalPages</a>
                    }

                    <a class="page-link-2026 @(currentPage >= totalPages ? "disabled" : "")"
                       href="@Url.Action("Search", "Project", new { keyword, areaId, status, sort, page = currentPage + 1 })">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </nav>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="quickLeadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-2026">
            <div class="modal-header modal-head-2026">
                <div class="pe-3">
                    <h5 class="modal-title-2026">
                        <i class="bi bi-headset me-2"></i>
                        Nhận tư vấn dự án
                    </h5>
                    <p class="modal-sub-2026">
                        Chuyên viên sẽ liên hệ và gửi thông tin chi tiết cho bạn.
                    </p>
                </div>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body-2026">
                <div class="modal-project-chip">
                    <i class="bi bi-building-check"></i>
                    <span id="modalProjectName">Đang tải tên dự án...</span>
                </div>

                @if (!isAuth)
                {
                    <div class="alert alert-info border-0 rounded-4 mb-4 small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <a href="/Account/Login" class="fw-bold text-decoration-none">Đăng nhập</a>
                        để hệ thống tự động điền sẵn thông tin của bạn.
                    </div>
                }

                <form id="frmQuickLead" asp-controller="Project" asp-action="SubmitLead" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="ProjectID" id="modalProjectId" value="" />

                    <div class="mb-3">
                        <label class="modal-label-2026">Họ và tên của bạn</label>
                        <input type="text"
                               name="Name"
                               class="form-control modal-input-2026"
                               required
                               placeholder="Nhập họ và tên"
                               value="@currentName" />
                    </div>

                    <div class="mb-3">
                        <label class="modal-label-2026">Số điện thoại liên hệ</label>
                        <input type="tel"
                               name="Phone"
                               class="form-control modal-input-2026"
                               required
                               placeholder="VD: 0912345678"
                               value="@currentPhone"
                               maxlength="10"
                               minlength="10"
                               pattern="^0[0-9]{9}$"
                               title="Số điện thoại phải bắt đầu bằng số 0 và có chính xác 10 chữ số"
                               oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" />
                    </div>

                    <div class="mb-3">
                        <label class="modal-label-2026">Email</label>
                        <input type="email"
                               name="Email"
                               class="form-control modal-input-2026"
                               placeholder="Nhập địa chỉ email"
                               value="@currentEmail" />
                    </div>

                    <div class="mb-4">
                        <label class="modal-label-2026">Nhu cầu tư vấn</label>
                        <textarea name="Message"
                                  class="form-control modal-input-2026"
                                  rows="3"
                                  placeholder="Ví dụ: Tôi muốn nhận báo giá căn 2 phòng ngủ, chính sách thanh toán, lịch xem dự án..."></textarea>
                    </div>

                    <button type="submit" class="btn-submit-2026" id="btnSubmitLead">
                        <i class="bi bi-send-fill"></i>
                        Gửi yêu cầu tư vấn
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="toast2026" class="toast-2026">
    <i class="bi bi-check-circle-fill"></i>
    <span id="toast2026Text">Gửi yêu cầu thành công.</span>
</div>

@section Scripts {
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            const filterDetails = document.querySelector('.filter-details-2026');
            const mobileQuery = window.matchMedia('(max-width: 767.98px)');

            function syncProjectFilterState() {
                if (!filterDetails) return;

                const hasActiveFilter = filterDetails.hasAttribute('open') && @hasActiveFilter.ToString().ToLowerInvariant();

                if (mobileQuery.matches) {
                    if (!@hasActiveFilter.ToString().ToLowerInvariant()) {
                        filterDetails.removeAttribute('open');
                    }
                } else {
                    filterDetails.setAttribute('open', 'open');
                }
            }

            syncProjectFilterState();

            if (mobileQuery.addEventListener) {
                mobileQuery.addEventListener('change', syncProjectFilterState);
            } else if (mobileQuery.addListener) {
                mobileQuery.addListener(syncProjectFilterState);
            }
        });

        function showToast2026(message, type) {
            const toast = document.getElementById('toast2026');
            const text = document.getElementById('toast2026Text');

            if (!toast || !text) {
                alert(message || 'Đã xử lý xong.');
                return;
            }

            text.innerText = message || 'Đã xử lý xong.';

            if (type === 'error') {
                toast.style.background = 'linear-gradient(135deg,#991b1b,#ef4444)';
                toast.querySelector('i').className = 'bi bi-exclamation-triangle-fill';
            } else {
                toast.style.background = 'linear-gradient(135deg,#0f172a,#1e293b)';
                toast.querySelector('i').className = 'bi bi-check-circle-fill';
            }

            toast.classList.add('show');

            setTimeout(function () {
                toast.classList.remove('show');
            }, 3600);
        }

        document.addEventListener('DOMContentLoaded', function () {
            const leadModal = document.getElementById('quickLeadModal');
            const frmQuickLead = document.getElementById('frmQuickLead');
            const btnSubmitLead = document.getElementById('btnSubmitLead');

            if (leadModal) {
                leadModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;

                    if (!button) {
                        return;
                    }

                    const projectId = button.getAttribute('data-projectid') || '';
                    const projectName = button.getAttribute('data-projectname') || 'Dự án đang chọn';

                    const modalProjectId = document.getElementById('modalProjectId');
                    const modalProjectName = document.getElementById('modalProjectName');

                    if (modalProjectId) {
                        modalProjectId.value = projectId;
                    }

                    if (modalProjectName) {
                        modalProjectName.textContent = projectName;
                    }
                });
            }

            if (frmQuickLead && btnSubmitLead) {
                frmQuickLead.addEventListener('submit', async function (event) {
                    event.preventDefault();

                    const originalText = btnSubmitLead.innerHTML;

                    btnSubmitLead.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang gửi...';
                    btnSubmitLead.disabled = true;

                    const formData = new FormData(frmQuickLead);

                    try {
                        const response = await fetch(frmQuickLead.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await response.json();

                        if (data.success) {
                            showToast2026(data.message || 'Gửi yêu cầu tư vấn thành công! Chuyên viên sẽ sớm liên hệ cho bạn.');

                            const modalInstance = bootstrap.Modal.getInstance(leadModal);

                            if (modalInstance) {
                                modalInstance.hide();
                            }

                            const messageBox = frmQuickLead.querySelector('textarea[name="Message"]');

                            if (messageBox) {
                                messageBox.value = '';
                            }
                        } else {
                            showToast2026(data.message || 'Có lỗi xảy ra, vui lòng kiểm tra lại thông tin.', 'error');
                        }
                    } catch (error) {
                        console.error(error);
                        showToast2026('Hệ thống đang bận, vui lòng thử lại sau.', 'error');
                    } finally {
                        btnSubmitLead.innerHTML = originalText;
                        btnSubmitLead.disabled = false;
                    }
                });
            }
        });
    </script>
}