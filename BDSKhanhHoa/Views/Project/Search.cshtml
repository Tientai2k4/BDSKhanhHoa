@model IEnumerable<BDSKhanhHoa.Models.Project>
@using System.Security.Claims
@using System.Globalization

@functions {
    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string GetSafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/no-image.jpg";
        }

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
        {
            return image;
        }

        return "/" + image.TrimStart('/');
    }

    private string FormatProjectPrice(decimal? priceMin, decimal? priceMax, string? unit)
    {
        string priceUnit = string.IsNullOrWhiteSpace(unit) ? "" : unit.Trim();

        if (priceMin.HasValue && priceMax.HasValue)
        {
            return $"{priceMin.Value.ToString("0.##", Vi)} - {priceMax.Value.ToString("0.##", Vi)} {priceUnit}".Trim();
        }

        if (priceMin.HasValue)
        {
            return $"Từ {priceMin.Value.ToString("0.##", Vi)} {priceUnit}".Trim();
        }

        if (priceMax.HasValue)
        {
            return $"Đến {priceMax.Value.ToString("0.##", Vi)} {priceUnit}".Trim();
        }

        return "Đang cập nhật";
    }

    private string FormatAreaRange(decimal? areaMin, decimal? areaMax)
    {
        if (areaMin.HasValue && areaMax.HasValue)
        {
            return $"{areaMin.Value.ToString("0.##", Vi)} - {areaMax.Value.ToString("0.##", Vi)} m²";
        }

        if (areaMin.HasValue)
        {
            return $"Từ {areaMin.Value.ToString("0.##", Vi)} m²";
        }

        if (areaMax.HasValue)
        {
            return $"Đến {areaMax.Value.ToString("0.##", Vi)} m²";
        }

        return "Đang cập nhật";
    }

    private string GetStatusClass(string? status)
    {
        status = status?.Trim() ?? "";

        return status switch
        {
            "Đang mở bán" => "status-selling",
            "Sắp mở bán" => "status-coming",
            "Đã bàn giao" => "status-done",
            _ => "status-updating"
        };
    }

    private string GetStatusIcon(string? status)
    {
        status = status?.Trim() ?? "";

        return status switch
        {
            "Đang mở bán" => "bi-lightning-charge-fill",
            "Sắp mở bán" => "bi-hourglass-split",
            "Đã bàn giao" => "bi-patch-check-fill",
            _ => "bi-info-circle-fill"
        };
    }

    private string FormatNumber(int value)
    {
        return value.ToString("N0", Vi);
    }
}

@{
    ViewData["Title"] = "Danh sách Dự án Bất động sản Khánh Hòa";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var areas = ViewBag.Areas as IEnumerable<BDSKhanhHoa.Models.Area> ?? new List<BDSKhanhHoa.Models.Area>();

    string keyword = ViewBag.Keyword as string ?? "";
    int? areaId = ViewBag.AreaId as int?;
    string status = ViewBag.Status as string ?? "";
    string sort = ViewBag.Sort as string ?? "newest";

    int totalResults = ViewBag.TotalResults is int tr ? tr : 0;
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;

    if (currentPage < 1)
    {
        currentPage = 1;
    }

    if (totalPages < 1)
    {
        totalPages = 1;
    }

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);

    bool isAuth = User.Identity?.IsAuthenticated ?? false;

    string currentName = "";
    string currentPhone = "";
    string currentEmail = "";

    if (isAuth)
    {
        currentName = User.FindFirst(ClaimTypes.Name)?.Value ?? User.FindFirst("FullName")?.Value ?? "";
        currentEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
        currentPhone = User.FindFirst(ClaimTypes.MobilePhone)?.Value ?? User.FindFirst("Phone")?.Value ?? "";
    }

    bool statusAllSelected = string.IsNullOrWhiteSpace(status);
    bool statusComingSelected = status == "Sắp mở bán";
    bool statusSellingSelected = status == "Đang mở bán";
    bool statusDoneSelected = status == "Đã bàn giao";

    bool sortNewestSelected = sort == "newest";
    bool sortPriceAscSelected = sort == "price_asc";
    bool sortPriceDescSelected = sort == "price_desc";
    bool sortAreaDescSelected = sort == "area_desc";

    string GetAreaFilterText()
    {
        if (!areaId.HasValue)
        {
            return "Tất cả vị trí";
        }

        var selectedArea = areas.FirstOrDefault(a => a.AreaID == areaId.Value);
        return selectedArea?.AreaName ?? "Khu vực đã chọn";
    }

    string GetStatusFilterText()
    {
        return string.IsNullOrWhiteSpace(status) ? "Mọi tiến độ" : status;
    }

    string GetSortFilterText()
    {
        return sort switch
        {
            "price_asc" => "Giá thấp → cao",
            "price_desc" => "Giá cao → thấp",
            "area_desc" => "Diện tích lớn",
            _ => "Mới cập nhật"
        };
    }

    bool hasActiveFilter = !string.IsNullOrWhiteSpace(keyword)
        || areaId.HasValue
        || !string.IsNullOrWhiteSpace(status)
        || !string.Equals(sort, "newest", StringComparison.OrdinalIgnoreCase);
}

