@model IEnumerable<BDSKhanhHoa.Models.Favorite>

@{
    ViewData["Title"] = "Bất động sản đã lưu";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    int total = Model?.Count() ?? 0;
}

<style>
    .favorite-page {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 22px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
    }

    .favorite-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 18px;
        margin-bottom: 24px;
        border-bottom: 1px solid #eef2f7;
    }

    .favorite-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    .favorite-title-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #fff1f2;
        color: #e11d48;
        flex-shrink: 0;
    }

    .favorite-subtitle {
        margin: 8px 0 0;
        color: #64748b;
        font-size: 0.95rem;
    }

    .favorite-count {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #eff6ff;
        color: #1d4ed8;
        border-radius: 999px;
        padding: 9px 14px;
        font-weight: 800;
        white-space: nowrap;
    }

    .favorite-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .favorite-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: #fff;
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
        height: 100%;
    }

        .favorite-card:hover {
            transform: translateY(-4px);
            border-color: #cbd5e1;
            box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
        }

    .favorite-link {
        display: flex;
        flex-direction: column;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .favorite-image {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 10;
        background: #f1f5f9;
        overflow: hidden;
    }

        .favorite-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

    .favorite-card:hover .favorite-image img {
        transform: scale(1.04);
    }

    .favorite-status {
        position: absolute;
        left: 12px;
        top: 12px;
        z-index: 2;
        border-radius: 999px;
        padding: 6px 11px;
        font-size: 0.75rem;
        font-weight: 800;
        color: #fff;
        box-shadow: 0 8px 18px rgba(15, 23, 42, 0.22);
    }

        .favorite-status.active {
            background: #16a34a;
        }

        .favorite-status.hidden-status {
            background: #64748b;
        }

    .favorite-remove-form {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 4;
        margin: 0;
    }

    .favorite-remove-btn {
        width: 39px;
        height: 39px;
        border: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.94);
        color: #e11d48;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.18);
        transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
    }

        .favorite-remove-btn:hover {
            transform: scale(1.08);
            background: #e11d48;
            color: #fff;
        }

    .favorite-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .favorite-name {
        min-height: 44px;
        margin: 0 0 10px;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
        line-height: 1.35;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .favorite-price {
        margin-bottom: 12px;
        color: #dc2626;
        font-weight: 900;
        font-size: 1.15rem;
    }

    .favorite-meta {
        display: grid;
        grid-template-columns: 1fr 1.35fr;
        gap: 10px;
        margin-top: auto;
        padding-top: 14px;
        border-top: 1px solid #eef2f7;
        color: #64748b;
        font-size: 0.88rem;
        font-weight: 650;
    }

        .favorite-meta span {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .favorite-meta .location {
            justify-content: flex-end;
            text-align: right;
        }

        .favorite-meta .location-text {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .favorite-empty {
        text-align: center;
        padding: 60px 22px;
        border: 1px dashed #cbd5e1;
        border-radius: 22px;
        background: linear-gradient(180deg, #f8fafc, #ffffff);
    }

    .favorite-empty-icon {
        width: 84px;
        height: 84px;
        margin: 0 auto 18px;
        border-radius: 28px;
        background: #fff1f2;
        color: #e11d48;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
    }

    .favorite-empty h5 {
        color: #0f172a;
        font-weight: 850;
        margin-bottom: 8px;
    }

    .favorite-empty p {
        max-width: 520px;
        margin: 0 auto 22px;
        color: #64748b;
    }

    @@media (max-width: 1199.98px) {
        .favorite-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .favorite-page {
            padding: 18px;
            border-radius: 18px;
        }

        .favorite-header {
            flex-direction: column;
            align-items: stretch;
            gap: 14px;
            margin-bottom: 18px;
        }

        .favorite-count {
            justify-content: center;
            width: 100%;
        }

        .favorite-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .favorite-title {
            font-size: 1.08rem;
        }

        .favorite-title-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
        }

        .favorite-body {
            padding: 14px;
        }

        .favorite-name {
            min-height: auto;
            font-size: 0.98rem;
        }

        .favorite-meta {
            grid-template-columns: 1fr;
            gap: 8px;
        }

            .favorite-meta .location {
                justify-content: flex-start;
                text-align: left;
            }

        .favorite-empty {
            padding: 44px 16px;
        }
    }
</style>

<div class="favorite-page">
    <div class="favorite-header">
        <div>
            <h4 class="favorite-title">
                <span class="favorite-title-icon">
                    <i class="bi bi-heart-fill"></i>
                </span>
                <span>Bất động sản đã lưu</span>
            </h4>
            <p class="favorite-subtitle">
                Quản lý nhanh các tin bạn đã quan tâm để xem lại khi cần.
            </p>
        </div>

        <div class="favorite-count">
            <i class="bi bi-bookmark-heart-fill"></i>
            <span>@total tin đã lưu</span>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="favorite-grid">
            @foreach (var item in Model)
            {
                var p = item.Property;
                if (p == null)
                {
                    continue;
                }

                string imageUrl = string.IsNullOrWhiteSpace(p.MainImage)
                ? "/images/no-image.jpg"
                : p.MainImage;

                string priceText = "Thỏa thuận";
                if (p.Price.HasValue && p.Price.Value > 0)
                {
                    priceText = p.Price.Value >= 1_000_000_000
                    ? (p.Price.Value / 1_000_000_000).ToString("0.##") + " tỷ"
                    : (p.Price.Value / 1_000_000).ToString("0.##") + " triệu";
                }

                string areaText = p.AreaSize.HasValue
                ? p.AreaSize.Value.ToString("0.##") + " m²"
                : "Chưa cập nhật";

                string locationText = p.Ward?.Area?.AreaName ?? "Khánh Hòa";

                bool isActive = string.Equals(p.Status, "Approved", StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Status, "Active", StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Status, "Published", StringComparison.OrdinalIgnoreCase)
                || string.Equals(p.Status, "Đã duyệt", StringComparison.OrdinalIgnoreCase);

                <article class="favorite-card">
                    <form asp-action="Remove"
                          asp-controller="Favorite"
                          method="post"
                          class="favorite-remove-form"
                          onsubmit="return confirm('Bạn muốn bỏ lưu tin này khỏi danh sách yêu thích?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.FavoriteID" />
                        <button type="submit" class="favorite-remove-btn" title="Bỏ lưu tin">
                            <i class="bi bi-trash3-fill"></i>
                        </button>
                    </form>

                    <a href="/Property/Details/@p.PropertyID" class="favorite-link">
                        <div class="favorite-image">
                            <img src="@imageUrl"
                                 alt="@p.Title"
                                 loading="lazy"
                                 onerror="this.src='/images/no-image.jpg'" />

                            @if (isActive)
                            {
                                <span class="favorite-status active">Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="favorite-status hidden-status">Tạm ẩn/Hết hạn</span>
                            }
                        </div>

                        <div class="favorite-body">
                            <h6 class="favorite-name">@p.Title</h6>

                            <div class="favorite-price">@priceText</div>

                            <div class="favorite-meta">
                                <span>
                                    <i class="bi bi-rulers"></i>
                                    @areaText
                                </span>

                                <span class="location">
                                    <i class="bi bi-geo-alt"></i>
                                    <span class="location-text">@locationText</span>
                                </span>
                            </div>
                        </div>
                    </a>
                </article>
            }
        </div>
    }
    else
    {
        <div class="favorite-empty">
            <div class="favorite-empty-icon">
                <i class="bi bi-heart"></i>
            </div>

            <h5>Danh sách yêu thích đang trống</h5>
            <p>
                Bạn chưa lưu bất động sản nào. Hãy xem danh sách tin rao và bấm biểu tượng trái tim
                để lưu lại những tin phù hợp với nhu cầu.
            </p>

            <a href="/Property/Search" class="btn btn-primary fw-bold px-4 py-2 rounded-pill">
                <i class="bi bi-search me-1"></i>
                Khám phá bất động sản
            </a>
        </div>
    }
</div>