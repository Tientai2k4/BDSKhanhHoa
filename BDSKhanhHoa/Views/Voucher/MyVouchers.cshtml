@model IEnumerable<BDSKhanhHoa.Models.Voucher>
@{
    ViewData["Title"] = "Kho Voucher Của Tôi";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var usedCodes = ViewBag.UsedCodes as List<string> ?? new List<string>();
}

<style>
    :root {
        --voucher-primary: #2563eb;
        --voucher-primary-2: #0ea5e9;
        --voucher-primary-soft: #eff6ff;
        --voucher-success: #16a34a;
        --voucher-warning: #f59e0b;
        --voucher-danger: #ef4444;
        --voucher-text: #0f172a;
        --voucher-body: #334155;
        --voucher-muted: #64748b;
        --voucher-border: #e2e8f0;
        --voucher-bg: #f5f8fc;
        --voucher-card: #ffffff;
        --voucher-radius: 22px;
        --voucher-shadow: 0 14px 35px rgba(15, 23, 42, .08);
        --voucher-shadow-sm: 0 8px 20px rgba(15, 23, 42, .055);
        --voucher-transition: all .22s ease;
    }

    .voucher-page {
        max-width: 1320px;
        margin: 0 auto;
        padding: 10px 0 38px;
    }

    .voucher-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
        padding: 20px 22px;
        border: 1px solid var(--voucher-border);
        border-radius: 26px;
        background: radial-gradient(circle at top right, rgba(37, 99, 235, .13), transparent 34%), linear-gradient(135deg, #ffffff, #f8fbff);
        box-shadow: var(--voucher-shadow-sm);
    }

    .voucher-hero-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .voucher-hero-icon {
        width: 54px;
        height: 54px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        color: #fff;
        background: linear-gradient(135deg, var(--voucher-primary), var(--voucher-primary-2));
        box-shadow: 0 14px 28px rgba(37, 99, 235, .22);
        font-size: 1.45rem;
    }

    .voucher-title {
        margin: 0;
        color: var(--voucher-text);
        font-size: 1.32rem;
        font-weight: 900;
        letter-spacing: -.035em;
        line-height: 1.2;
    }

    .voucher-subtitle {
        margin: 5px 0 0;
        color: var(--voucher-muted);
        font-size: .92rem;
        line-height: 1.45;
        font-weight: 500;
    }

    .voucher-buy-btn {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 999px;
        background: linear-gradient(135deg, var(--voucher-primary), var(--voucher-primary-2));
        color: #fff;
        font-weight: 900;
        border: 0;
        box-shadow: 0 12px 24px rgba(37, 99, 235, .22);
        transition: var(--voucher-transition);
        white-space: nowrap;
    }

        .voucher-buy-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            filter: brightness(1.02);
        }

    .voucher-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid var(--voucher-border);
        border-radius: 20px;
        background: rgba(255,255,255,.82);
        box-shadow: var(--voucher-shadow-sm);
    }

    .voucher-count-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        padding: 8px 13px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--voucher-border);
        color: var(--voucher-body);
        font-size: .86rem;
        font-weight: 850;
    }

    .voucher-tip {
        margin: 0;
        color: var(--voucher-muted);
        font-size: .84rem;
        font-weight: 600;
        text-align: right;
    }

    .voucher-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .voucher-card {
        position: relative;
        display: grid;
        grid-template-columns: minmax(190px, 34%) minmax(0, 1fr);
        overflow: hidden;
        min-height: 190px;
        border: 1px solid var(--voucher-border);
        border-radius: var(--voucher-radius);
        background: var(--voucher-card);
        box-shadow: var(--voucher-shadow-sm);
        transition: var(--voucher-transition);
    }

        .voucher-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--voucher-shadow);
            border-color: #bfdbfe;
        }

        .voucher-card.is-disabled {
            filter: grayscale(100%);
            opacity: .68;
        }

    .voucher-discount-side {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        padding: 22px 18px;
        color: #fff;
        background: radial-gradient(circle at top left, rgba(255,255,255,.24), transparent 38%), linear-gradient(135deg, #3b82f6, #2563eb);
        border-right: 2px dashed rgba(255,255,255,.50);
        text-align: center;
    }

    .voucher-card.is-disabled .voucher-discount-side {
        background: linear-gradient(135deg, #94a3b8, #64748b);
    }

    .voucher-discount-side::before,
    .voucher-discount-side::after {
        content: "";
        position: absolute;
        right: -13px;
        width: 26px;
        height: 26px;
        background: var(--voucher-bg);
        border-radius: 999px;
        z-index: 2;
    }

    .voucher-discount-side::before {
        top: -13px;
    }

    .voucher-discount-side::after {
        bottom: -13px;
    }

    .discount-number {
        margin: 0;
        font-size: clamp(1.75rem, 2.3vw, 2.45rem);
        font-weight: 950;
        letter-spacing: -.04em;
        line-height: 1;
    }

    .discount-min {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,.20);
        color: #fff;
        font-size: .86rem;
        font-weight: 900;
        line-height: 1.1;
    }

    .voucher-info-side {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 20px;
    }

    .voucher-top-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 9px;
    }

    .voucher-code {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        min-width: 0;
        color: var(--voucher-text);
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 1.08rem;
        font-weight: 950;
        letter-spacing: -.02em;
        word-break: break-word;
    }

    .voucher-left-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex: 0 0 auto;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid var(--voucher-border);
        color: var(--voucher-body);
        font-size: .78rem;
        font-weight: 850;
        white-space: nowrap;
    }

    .voucher-desc {
        margin: 0;
        color: var(--voucher-muted);
        font-size: .9rem;
        line-height: 1.55;
        font-weight: 600;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .voucher-bottom-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
        margin-top: 18px;
        padding-top: 15px;
        border-top: 1px solid var(--voucher-border);
    }

    .voucher-date-list {
        display: grid;
        gap: 5px;
        min-width: 0;
    }

    .voucher-date {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--voucher-danger);
        font-size: .82rem;
        font-weight: 850;
        line-height: 1.25;
    }

        .voucher-date.is-waiting {
            color: var(--voucher-warning);
        }

    .btn-copy-code {
        flex: 0 0 auto;
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid #bfdbfe;
        border-radius: 14px;
        background: var(--voucher-primary-soft);
        color: var(--voucher-primary);
        font-weight: 900;
        font-size: .88rem;
        transition: var(--voucher-transition);
        white-space: nowrap;
    }

        .btn-copy-code:hover {
            color: #fff;
            background: var(--voucher-primary);
            border-color: var(--voucher-primary);
            transform: translateY(-1px);
        }

    .voucher-watermark {
        position: absolute;
        top: 18px;
        right: 18px;
        z-index: 5;
        transform: rotate(-10deg);
        padding: 6px 13px;
        border: 3px solid rgba(239, 68, 68, .23);
        border-radius: 12px;
        color: rgba(185, 28, 28, .42);
        background: rgba(255,255,255,.52);
        font-size: 1rem;
        font-weight: 950;
        letter-spacing: .04em;
        pointer-events: none;
    }

    .voucher-empty {
        display: grid;
        place-items: center;
        min-height: 320px;
        padding: 36px 20px;
        border: 1px dashed #cbd5e1;
        border-radius: 26px;
        background: #fff;
        box-shadow: var(--voucher-shadow-sm);
        text-align: center;
    }

    .voucher-empty-icon {
        width: 82px;
        height: 82px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
        border-radius: 26px;
        color: var(--voucher-primary);
        background: var(--voucher-primary-soft);
        font-size: 2.2rem;
    }

    .voucher-empty h5 {
        margin: 0 0 6px;
        color: var(--voucher-text);
        font-weight: 900;
    }

    .voucher-empty p {
        margin: 0;
        color: var(--voucher-muted);
        font-weight: 600;
    }

    @@media (max-width: 1199.98px) {
        .voucher-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 767.98px) {
        .voucher-page {
            padding: 0 0 24px;
        }

        .voucher-hero {
            align-items: flex-start;
            padding: 16px;
            margin-bottom: 14px;
            border-radius: 22px;
        }

        .voucher-hero-left {
            gap: 12px;
        }

        .voucher-hero-icon {
            width: 46px;
            height: 46px;
            border-radius: 16px;
            font-size: 1.25rem;
        }

        .voucher-title {
            font-size: 1.12rem;
        }

        .voucher-subtitle {
            font-size: .82rem;
            line-height: 1.4;
        }

        .voucher-buy-btn {
            display: none;
        }

        .voucher-toolbar {
            align-items: flex-start;
            flex-direction: column;
            padding: 10px;
            border-radius: 18px;
        }

        .voucher-tip {
            text-align: left;
            font-size: .78rem;
        }

        .voucher-card {
            grid-template-columns: 1fr;
            min-height: 0;
            border-radius: 22px;
        }

        .voucher-discount-side {
            min-height: 118px;
            padding: 18px 16px;
            border-right: 0;
            border-bottom: 2px dashed rgba(255,255,255,.50);
        }

            .voucher-discount-side::before,
            .voucher-discount-side::after {
                top: auto;
                bottom: -13px;
                background: var(--voucher-bg);
            }

            .voucher-discount-side::before {
                left: -13px;
                right: auto;
            }

            .voucher-discount-side::after {
                right: -13px;
            }

        .discount-number {
            font-size: 2rem;
        }

        .discount-min {
            font-size: .8rem;
            padding: 6px 11px;
        }

        .voucher-info-side {
            padding: 16px;
        }

        .voucher-code {
            font-size: 1rem;
        }

        .voucher-left-badge {
            font-size: .74rem;
            padding: 5px 9px;
        }

        .voucher-desc {
            font-size: .84rem;
            -webkit-line-clamp: 2;
        }

        .voucher-bottom-row {
            align-items: stretch;
            flex-direction: column;
            gap: 12px;
            margin-top: 14px;
            padding-top: 13px;
        }

        .btn-copy-code {
            width: 100%;
            min-height: 44px;
        }

        .voucher-watermark {
            top: 12px;
            right: 12px;
            font-size: .84rem;
            padding: 5px 10px;
            border-width: 2px;
        }
    }

    @@media (max-width: 420px) {
        .voucher-hero {
            padding: 14px;
        }

        .voucher-top-row {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

        .voucher-left-badge {
            align-self: flex-start;
        }
    }
</style>

<div class="voucher-page">
    <div class="voucher-hero animate__animated animate__fadeInDown">
        <div class="voucher-hero-left">
            <div class="voucher-hero-icon">
                <i class="bi bi-ticket-perforated-fill"></i>
            </div>
            <div class="min-w-0">
                <h2 class="voucher-title">Kho Voucher Của Tôi</h2>
                <p class="voucher-subtitle">Lưu mã ưu đãi và nhập ở bước thanh toán để giảm chi phí mua gói đăng tin.</p>
            </div>
        </div>

        <a href="/Package/Buy" class="voucher-buy-btn">
            <i class="bi bi-cart-plus-fill"></i>
            Mua dịch vụ
        </a>
    </div>

    <div class="voucher-toolbar animate__animated animate__fadeIn">
        <div class="voucher-count-pill">
            <i class="bi bi-wallet2 text-primary"></i>
            <span>Tổng voucher: <strong>@Model.Count()</strong></span>
        </div>
        <p class="voucher-tip">
            Mỗi mã chỉ nên dùng 1 lần cho tài khoản của bạn. Voucher hết hạn hoặc hết lượt sẽ tự khóa.
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="voucher-empty animate__animated animate__fadeInUp">
            <div>
                <div class="voucher-empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <h5>Chưa có chương trình khuyến mãi nào</h5>
                <p>Khi có voucher mới, hệ thống sẽ hiển thị tại đây.</p>
                <a href="/Package/Buy" class="voucher-buy-btn mt-3 d-inline-flex">
                    <i class="bi bi-cart-plus-fill"></i>
                    Xem gói dịch vụ
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="voucher-grid">
            @foreach (var v in Model)
            {
                bool isUsed = usedCodes.Contains(v.Code.ToUpper());
                bool isExpired = !v.IsActive || v.ExpiryDate < DateTime.Now;
                bool isWaiting = v.StartDate > DateTime.Now;
                bool isOutOfStock = v.UsedCount >= v.Quantity;
                bool isDisabled = isUsed || isExpired || isOutOfStock;
                int remaining = Math.Max(0, v.Quantity - v.UsedCount);

                <article class="voucher-card @(isDisabled ? "is-disabled" : "") animate__animated animate__fadeInUp">
                    @if (isUsed)
                    {
                        <div class="voucher-watermark">ĐÃ SỬ DỤNG</div>
                    }
                    else if (isExpired)
                    {
                        <div class="voucher-watermark">HẾT HẠN</div>
                    }
                    else if (isOutOfStock)
                    {
                        <div class="voucher-watermark">HẾT LƯỢT</div>
                    }

                    <div class="voucher-discount-side">
                        <h3 class="discount-number">Giảm @v.DiscountPercent.ToString("0.##")%</h3>
                        <div class="discount-min">
                            <i class="bi bi-bag-check-fill"></i>
                            Đơn từ @v.MinOrderAmount.ToString("N0")đ
                        </div>
                    </div>

                    <div class="voucher-info-side">
                        <div>
                            <div class="voucher-top-row">
                                <h5 class="voucher-code">
                                    <i class="bi bi-upc-scan text-primary"></i>
                                    @v.Code.ToUpper()
                                </h5>
                                <span class="voucher-left-badge">
                                    <i class="bi bi-people-fill text-muted"></i>
                                    Còn @remaining lượt
                                </span>
                            </div>

                            <p class="voucher-desc">
                                @if (!string.IsNullOrEmpty(v.Description))
                                {
                                    @v.Description
                                }
                                else
                                {
                                    <text>Giảm @v.DiscountPercent.ToString("0.##")% cho tổng giá trị đơn hàng, tối đa @v.MaxDiscountAmount.ToString("N0")đ. Mỗi tài khoản sử dụng 1 lần.</text>
                                }
                            </p>
                        </div>

                        <div class="voucher-bottom-row">
                            <div class="voucher-date-list">
                                @if (isWaiting)
                                {
                                    <span class="voucher-date is-waiting">
                                        <i class="bi bi-hourglass-split"></i>
                                        Bắt đầu: @v.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                                <span class="voucher-date">
                                    <i class="bi bi-clock-history"></i>
                                    HSD: @v.ExpiryDate.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>

                            @if (!isDisabled)
                            {
                                <button type="button" class="btn-copy-code" onclick="copyVoucherCode('@v.Code.ToUpper()')">
                                    <i class="bi bi-copy"></i>
                                    Sao chép mã
                                </button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function copyVoucherCode(code) {
            const showSuccess = function () {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: 'Đã sao chép mã: ' + code,
                    showConfirmButton: false,
                    timer: 2000,
                    customClass: { popup: 'rounded-4' }
                });
            };

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(code).then(showSuccess).catch(function () {
                    fallbackCopyVoucherCode(code, showSuccess);
                });
            } else {
                fallbackCopyVoucherCode(code, showSuccess);
            }
        }

        function fallbackCopyVoucherCode(code, callback) {
            const tempInput = document.createElement('input');
            tempInput.value = code;
            tempInput.setAttribute('readonly', 'readonly');
            tempInput.style.position = 'fixed';
            tempInput.style.left = '-9999px';
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            callback();
        }
    </script>
}
