@model BDSKhanhHoa.Models.Blog
@using System.Globalization

@functions {
    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string GetSafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "/images/no-image.jpg";

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
            return image;

        return "/" + image.TrimStart('/');
    }

    private string GetSafeText(string? value, string fallback = "Đang cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString("dd/MM/yyyy", Vi);
    }

    private string FormatDateTime(DateTime date)
    {
        return date.ToString("dd/MM/yyyy HH:mm", Vi);
    }

    private string FormatNumber(int value)
    {
        return value.ToString("N0", Vi);
    }
}

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    var recentBlogs = ViewBag.RecentBlogs as IEnumerable<BDSKhanhHoa.Models.Blog> ?? new List<BDSKhanhHoa.Models.Blog>();
    var relatedBlogs = ViewBag.RelatedBlogs as IEnumerable<BDSKhanhHoa.Models.Blog> ?? new List<BDSKhanhHoa.Models.Blog>();
    var categories = ViewBag.Categories as IEnumerable<string> ?? new List<string>();
    var categoryCounts = ViewBag.CategoryCounts as Dictionary<string, int> ?? new Dictionary<string, int>();

    string imageUrl = GetSafeImage(Model.ImageURL);
    string categoryName = GetSafeText(Model.Category, "Tin tức");
    string authorName = Model.User?.FullName ?? "Ban biên tập";
    string summary = GetSafeText(Model.Summary, "");
    string currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}{Context.Request.QueryString}";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap');

    :root {
        --article-bg: #f4f8fc;
        --article-card: #ffffff;
        --article-soft: #f8fafc;
        --article-soft-blue: #eaf6ff;
        --article-border: #e2e8f0;
        --article-text: #111827;
        --article-muted: #64748b;
        --article-primary: #0b8ed8;
        --article-primary-dark: #086fb0;
        --article-radius: 20px;
        --article-radius-lg: 24px;
        --article-shadow: 0 12px 32px rgba(15, 23, 42, .08);
        --article-shadow-hover: 0 18px 42px rgba(15, 23, 42, .13);
    }

    body {
        font-family: 'Roboto', Arial, sans-serif !important;
        background: var(--article-bg);
        color: var(--article-text);
    }

    .article-page {
        min-height: 100vh;
        padding: 18px 0 56px;
        background: radial-gradient(circle at top left, rgba(14, 165, 233, .10), transparent 340px), linear-gradient(180deg, #f7fbff 0%, #f4f8fc 42%, #f4f8fc 100%);
    }

    .article-container {
        width: calc(100% - 56px);
        max-width: 1500px;
        margin: 0 auto;
    }

    .article-breadcrumb {
        min-height: 44px;
        padding: 9px 14px;
        margin-bottom: 16px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        color: var(--article-muted);
        background: rgba(255,255,255,.92);
        border: 1px solid var(--article-border);
        box-shadow: 0 8px 20px rgba(15,23,42,.05);
        font-size: .9rem;
        font-weight: 500;
    }

        .article-breadcrumb a {
            color: var(--article-muted);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: .2s ease;
        }

            .article-breadcrumb a:hover {
                color: var(--article-primary-dark);
            }

    .breadcrumb-current {
        max-width: 620px;
        color: var(--article-text);
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-weight: 700;
    }

    .article-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 24px;
        align-items: start;
    }

    .article-main {
        min-width: 0;
    }

    .article-card {
        overflow: hidden;
        border-radius: 24px;
        background: #ffffff;
        border: 1px solid var(--article-border);
        box-shadow: var(--article-shadow);
    }

    .article-header {
        padding: 26px 30px 22px;
        background: radial-gradient(circle at top right, rgba(14, 142, 216, .10), transparent 34%), linear-gradient(135deg, #ffffff, #f8fbff);
        border-bottom: 1px solid var(--article-border);
    }

    .article-category {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        height: 32px;
        padding: 0 13px;
        margin-bottom: 14px;
        border-radius: 999px;
        color: var(--article-primary-dark);
        background: var(--article-soft-blue);
        border: 1px solid #bae6fd;
        font-size: .78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .article-title {
        max-width: 980px;
        margin: 0 0 16px;
        color: #0f172a;
        font-size: clamp(1.9rem, 3vw, 3.35rem);
        line-height: 1.18;
        letter-spacing: -.035em;
        font-weight: 900;
    }

    .article-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        color: var(--article-muted);
        font-size: .88rem;
        font-weight: 500;
    }

        .article-meta span {
            min-height: 32px;
            padding: 0 12px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: #f1f5f9;
            border: 1px solid var(--article-border);
        }

        .article-meta i {
            color: var(--article-primary);
        }

    .article-body {
        padding: 26px 30px 30px;
    }

    .article-summary {
        margin-bottom: 22px;
        padding: 16px 18px;
        border-radius: 0 18px 18px 0;
        color: #1e293b;
        background: linear-gradient(135deg, #eaf6ff, #ffffff);
        border: 1px solid #bae6fd;
        border-left: 5px solid var(--article-primary);
        font-size: 1.02rem;
        line-height: 1.7;
        font-weight: 700;
    }

    .article-cover-wrap {
        overflow: hidden;
        margin-bottom: 24px;
        border-radius: 22px;
        background: var(--article-soft);
        border: 1px solid var(--article-border);
        box-shadow: 0 8px 20px rgba(15,23,42,.05);
    }

    .article-cover {
        width: 100%;
        height: 390px;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .article-content {
        max-width: 100%;
        color: #334155;
        font-size: 1rem;
        line-height: 1.82;
        font-weight: 400;
        word-break: break-word;
    }

        .article-content p {
            margin: 0 0 1.1em;
            text-align: justify;
        }

        .article-content h1,
        .article-content h2,
        .article-content h3,
        .article-content h4 {
            color: #111827;
            font-weight: 900;
            line-height: 1.3;
            letter-spacing: -.015em;
            margin: 1.45em 0 .65em;
        }

        .article-content h1 {
            font-size: 1.75rem;
        }

        .article-content h2 {
            font-size: 1.42rem;
        }

        .article-content h3 {
            font-size: 1.2rem;
        }

        .article-content ul,
        .article-content ol {
            padding-left: 1.25rem;
            margin-bottom: 1.1em;
        }

        .article-content li {
            margin-bottom: .42em;
        }

        .article-content img {
            max-width: 100%;
            height: auto;
            display: block;
            margin: 22px auto;
            border-radius: 20px;
            box-shadow: 0 8px 20px rgba(15,23,42,.08);
        }

        .article-content blockquote {
            margin: 22px 0;
            padding: 16px 18px;
            border-radius: 0 16px 16px 0;
            border-left: 5px solid var(--article-primary);
            color: #1e3a8a;
            background: var(--article-soft-blue);
            font-weight: 700;
        }

        .article-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            overflow: hidden;
            border-radius: 14px;
            font-size: .94rem;
        }

        .article-content th,
        .article-content td {
            padding: 11px;
            border: 1px solid var(--article-border);
        }

        .article-content th {
            color: #111827;
            background: #f1f5f9;
            font-weight: 800;
        }

    .article-share {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid var(--article-border);
    }

    .share-title {
        color: #111827;
        font-weight: 800;
    }

    .share-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .share-btn {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        text-decoration: none;
        transition: .2s ease;
    }

        .share-btn:hover {
            color: #fff;
            transform: translateY(-2px);
        }

    .share-facebook {
        background: #1877f2;
    }

    .share-copy {
        background: #475569;
    }

    .article-related {
        margin-top: 20px;
        padding: 20px;
        border-radius: 24px;
        background: #fff;
        border: 1px solid var(--article-border);
        box-shadow: var(--article-shadow);
    }

    .related-head {
        margin-bottom: 14px;
    }

    .related-title {
        margin: 0;
        color: #111827;
        font-size: 1.12rem;
        font-weight: 900;
    }

    .related-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .related-card {
        overflow: hidden;
        border-radius: 18px;
        color: inherit;
        text-decoration: none;
        background: #fff;
        border: 1px solid var(--article-border);
        transition: .2s ease;
    }

        .related-card:hover {
            color: inherit;
            border-color: #bae6fd;
            box-shadow: var(--article-shadow-hover);
            transform: translateY(-3px);
        }

        .related-card img {
            width: 100%;
            height: 135px;
            object-fit: cover;
            display: block;
            background: var(--article-soft);
        }

    .related-card-body {
        padding: 12px;
    }

    .related-card-title {
        margin: 0 0 7px;
        color: #111827;
        font-size: .94rem;
        line-height: 1.42;
        font-weight: 800;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: .2s ease;
    }

    .related-card:hover .related-card-title {
        color: var(--article-primary-dark);
    }

    .related-date {
        color: var(--article-muted);
        font-size: .78rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .sidebar {
        min-width: 0;
    }

    .sidebar-sticky {
        position: sticky;
        top: 86px;
    }

    .sidebar-widget {
        margin-bottom: 16px;
        padding: 18px;
        border-radius: 22px;
        background: #fff;
        border: 1px solid var(--article-border);
        box-shadow: var(--article-shadow);
    }

    .widget-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 14px;
        padding-bottom: 13px;
        border-bottom: 1px solid var(--article-border);
        color: #111827;
        font-size: 1.02rem;
        font-weight: 900;
    }

        .widget-title i {
            width: 36px;
            height: 36px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: var(--article-primary);
        }

    .sidebar-search {
        display: flex;
        overflow: hidden;
        border-radius: 15px;
        background: #fff;
        border: 1.5px solid var(--article-border);
    }

        .sidebar-search input {
            flex: 1;
            min-width: 0;
            height: 48px;
            padding: 0 14px;
            border: none;
            outline: none;
            color: #111827;
            font-size: .94rem;
            font-weight: 500;
        }

        .sidebar-search button {
            width: 50px;
            border: none;
            color: #fff;
            background: var(--article-primary);
        }

    .category-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 8px;
    }

        .category-list a {
            min-height: 40px;
            padding: 0 12px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            color: #334155;
            background: #f8fafc;
            border: 1px solid var(--article-border);
            text-decoration: none;
            font-size: .9rem;
            font-weight: 700;
            transition: .2s ease;
        }

            .category-list a:hover {
                color: var(--article-primary-dark);
                background: var(--article-soft-blue);
                border-color: #bae6fd;
                transform: translateX(2px);
            }

        .category-list small {
            color: var(--article-muted);
            font-size: .76rem;
            font-weight: 700;
        }

    .recent-list {
        display: grid;
        gap: 10px;
    }

    .recent-post {
        display: grid;
        grid-template-columns: 82px minmax(0, 1fr);
        gap: 11px;
        padding: 8px;
        border-radius: 16px;
        color: inherit;
        text-decoration: none;
        background: #fff;
        border: 1px solid var(--article-border);
        transition: .2s ease;
    }

        .recent-post:hover {
            color: inherit;
            border-color: #bae6fd;
            box-shadow: 0 8px 20px rgba(15,23,42,.07);
            transform: translateY(-2px);
        }

        .recent-post img {
            width: 82px;
            height: 64px;
            border-radius: 12px;
            object-fit: cover;
            background: var(--article-soft);
        }

    .recent-title {
        margin: 0 0 5px;
        color: #111827;
        font-size: .85rem;
        line-height: 1.38;
        font-weight: 800;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: .2s ease;
    }

    .recent-post:hover .recent-title {
        color: var(--article-primary-dark);
    }

    .recent-date {
        color: var(--article-muted);
        font-size: .76rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .back-box {
        padding: 17px;
        border-radius: 22px;
        background: linear-gradient(135deg, var(--article-primary), #147eea);
        color: #fff;
    }

    .back-box-title {
        margin-bottom: 8px;
        font-size: 1.02rem;
        font-weight: 900;
    }

    .back-box-text {
        margin-bottom: 14px;
        color: rgba(255,255,255,.9);
        font-size: .9rem;
        line-height: 1.62;
    }

    .back-box a {
        height: 40px;
        padding: 0 14px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--article-primary-dark);
        background: #fff;
        text-decoration: none;
        font-size: .86rem;
        font-weight: 800;
    }

    .copy-toast {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 2000;
        display: none;
        align-items: center;
        gap: 9px;
        max-width: 340px;
        padding: 13px 15px;
        border-radius: 18px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a, #1e293b);
        box-shadow: 0 18px 45px rgba(15,23,42,.24);
        font-size: .9rem;
        font-weight: 700;
    }

        .copy-toast.show {
            display: flex;
        }

    @@media (max-width: 1199.98px) {
        .article-layout {
            grid-template-columns: minmax(0, 1fr) 310px;
            gap: 20px;
        }

        .article-title {
            font-size: 2.35rem;
        }
    }

    @@media (max-width: 991.98px) {
        .article-container {
            width: calc(100% - 32px);
        }

        .article-layout {
            display: block;
        }

        .sidebar {
            margin-top: 20px;
        }

        .sidebar-sticky {
            position: static;
        }

        .article-cover {
            height: 350px;
        }
    }

    @@media (max-width: 767.98px) {
        .article-page {
            padding-top: 10px;
        }

        .article-container {
            width: calc(100% - 20px);
        }

        .article-breadcrumb {
            display: none;
        }

        .article-card {
            border-radius: 20px;
        }

        .article-header {
            padding: 18px 16px 16px;
        }

        .article-title {
            font-size: 1.45rem;
            line-height: 1.25;
            letter-spacing: -.02em;
        }

        .article-meta span {
            min-height: 30px;
            padding: 0 10px;
            font-size: .78rem;
        }

        .article-body {
            padding: 16px;
        }

        .article-summary {
            margin-bottom: 18px;
            padding: 14px;
            border-radius: 0 15px 15px 0;
            font-size: .95rem;
            line-height: 1.68;
        }

        .article-cover-wrap {
            margin-bottom: 18px;
            border-radius: 17px;
        }

        .article-cover {
            height: auto;
            aspect-ratio: 4 / 3;
        }

        .article-content {
            font-size: .95rem;
            line-height: 1.75;
        }

            .article-content p {
                text-align: left;
            }

            .article-content h1 {
                font-size: 1.42rem;
            }

            .article-content h2 {
                font-size: 1.25rem;
            }

            .article-content h3 {
                font-size: 1.12rem;
            }

        .article-share {
            align-items: flex-start;
            flex-direction: column;
            margin-top: 24px;
        }

        .related-grid {
            grid-template-columns: 1fr;
        }

        .sidebar-widget {
            padding: 16px;
            border-radius: 20px;
        }

        .recent-post {
            grid-template-columns: 82px minmax(0, 1fr);
        }

        .copy-toast {
            left: 10px;
            right: 10px;
            bottom: 10px;
            max-width: none;
        }
    }

    @@media (max-width: 575.98px) {
        .article-title {
            font-size: 1.28rem;
        }

        .article-category {
            height: 30px;
            padding: 0 11px;
            font-size: .72rem;
        }

        .article-cover {
            aspect-ratio: 1 / 1;
        }

        .share-btn {
            width: 38px;
            height: 38px;
        }

        .related-card img {
            height: 128px;
        }
    }
</style>

<div class="article-page">
    <div class="article-container">
        <nav class="article-breadcrumb" aria-label="breadcrumb">
            <a href="/">
                <i class="bi bi-house-door-fill"></i>
                Trang chủ
            </a>

            <span>/</span>

            <a asp-controller="Blog" asp-action="Index">
                Tin tức BĐS
            </a>

            <span>/</span>

            <span class="breadcrumb-current">@Model.Title</span>
        </nav>

        <div class="article-layout">
            <main class="article-main">
                <article class="article-card">
                    <header class="article-header">
                        <span class="article-category">
                            <i class="bi bi-tag-fill"></i>
                            @categoryName
                        </span>

                        <h1 class="article-title">@Model.Title</h1>

                        <div class="article-meta">
                            <span>
                                <i class="bi bi-person-circle"></i>
                                @authorName
                            </span>

                            <span>
                                <i class="bi bi-calendar3"></i>
                                @FormatDateTime(Model.CreatedAt)
                            </span>

                            <span>
                                <i class="bi bi-eye"></i>
                                @FormatNumber(Model.Views) lượt xem
                            </span>
                        </div>
                    </header>

                    <div class="article-body">
                        @if (!string.IsNullOrWhiteSpace(summary))
                        {
                            <div class="article-summary">
                                @summary
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.ImageURL))
                        {
                            <div class="article-cover-wrap">
                                <img src="@imageUrl"
                                     class="article-cover"
                                     alt="@Model.Title"
                                     loading="eager"
                                     decoding="async"
                                     fetchpriority="high"
                                     draggable="false"
                                     onerror="this.onerror=null;this.style.display='none';" />
                            </div>
                        }

                        <div class="article-content">
                            @Html.Raw(Model.Content)
                        </div>

                        <div class="article-share">
                            <div class="share-title">
                                <i class="bi bi-share-fill text-primary me-1"></i>
                                Chia sẻ bài viết
                            </div>

                            <div class="share-actions">
                                <button type="button"
                                        class="share-btn share-facebook"
                                        title="Chia sẻ Facebook"
                                        onclick="shareFacebook()">
                                    <i class="bi bi-facebook"></i>
                                </button>

                                <button type="button"
                                        class="share-btn share-copy"
                                        title="Sao chép liên kết"
                                        onclick="copyArticleLink()">
                                    <i class="bi bi-link-45deg"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </article>

                @if (relatedBlogs.Any())
                {
                    <section class="article-related">
                        <div class="related-head">
                            <h2 class="related-title">Bài viết liên quan</h2>
                        </div>

                        <div class="related-grid">
                            @foreach (var r in relatedBlogs)
                            {
                                string relatedImage = GetSafeImage(r.ImageURL);

                                <a asp-controller="Blog"
                                   asp-action="Details"
                                   asp-route-id="@r.BlogID"
                                   class="related-card">
                                    <img src="@relatedImage"
                                         alt="@r.Title"
                                         loading="lazy"
                                         decoding="async"
                                         draggable="false"
                                         onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                                    <div class="related-card-body">
                                        <h3 class="related-card-title">@r.Title</h3>

                                        <span class="related-date">
                                            <i class="bi bi-calendar3"></i>
                                            @FormatDate(r.CreatedAt)
                                        </span>
                                    </div>
                                </a>
                            }
                        </div>
                    </section>
                }
            </main>

            <aside class="sidebar">
                <div class="sidebar-sticky">
                    <section class="sidebar-widget">
                        <h4 class="widget-title">
                            <i class="bi bi-search"></i>
                            Tìm kiếm
                        </h4>

                        <form asp-controller="Blog" asp-action="Index" method="get">
                            <div class="sidebar-search">
                                <input type="text"
                                       name="keyword"
                                       placeholder="Nhập từ khóa..." />

                                <button type="submit" aria-label="Tìm kiếm">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </form>
                    </section>

                    @if (categories.Any())
                    {
                        <section class="sidebar-widget">
                            <h4 class="widget-title">
                                <i class="bi bi-tags-fill"></i>
                                Chuyên mục
                            </h4>

                            <ul class="category-list">
                                @foreach (var cat in categories)
                                {
                                    int count = categoryCounts.ContainsKey(cat) ? categoryCounts[cat] : 0;

                                    <li>
                                        <a asp-controller="Blog"
                                           asp-action="Index"
                                           asp-route-category="@cat">
                                            <span>@cat</span>
                                            <small>@FormatNumber(count)</small>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </section>
                    }

                    @if (recentBlogs.Any())
                    {
                        <section class="sidebar-widget">
                            <h4 class="widget-title">
                                <i class="bi bi-clock-history"></i>
                                Bài viết mới nhất
                            </h4>

                            <div class="recent-list">
                                @foreach (var r in recentBlogs)
                                {
                                    string recentImage = GetSafeImage(r.ImageURL);

                                    <a asp-controller="Blog"
                                       asp-action="Details"
                                       asp-route-id="@r.BlogID"
                                       class="recent-post">
                                        <img src="@recentImage"
                                             alt="@r.Title"
                                             loading="lazy"
                                             decoding="async"
                                             draggable="false"
                                             onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                                        <div>
                                            <h6 class="recent-title">@r.Title</h6>

                                            <span class="recent-date">
                                                <i class="bi bi-calendar3"></i>
                                                @FormatDate(r.CreatedAt)
                                            </span>
                                        </div>
                                    </a>
                                }
                            </div>
                        </section>
                    }

                    <section class="back-box">
                        <div class="back-box-title">
                            Khám phá thêm kiến thức BĐS
                        </div>

                        <p class="back-box-text">
                            Xem thêm tin tức, pháp lý, kinh nghiệm mua bán và xu hướng thị trường tại Khánh Hòa.
                        </p>

                        <a asp-controller="Blog" asp-action="Index">
                            <i class="bi bi-arrow-left"></i>
                            Về trang tin tức
                        </a>
                    </section>
                </div>
            </aside>
        </div>
    </div>
</div>

<div id="copyToast" class="copy-toast">
    <i class="bi bi-check-circle-fill"></i>
    <span>Đã sao chép liên kết bài viết.</span>
</div>

@section Scripts {
    <script>
        const articleUrl = '@currentUrl';

        function shareFacebook() {
            const shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(articleUrl);
            window.open(shareUrl, '_blank', 'width=720,height=520');
        }

        function showCopyToast() {
            const toast = document.getElementById('copyToast');

            if (!toast) {
                return;
            }

            toast.classList.add('show');

            setTimeout(function () {
                toast.classList.remove('show');
            }, 2300);
        }

        async function copyArticleLink() {
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(articleUrl);
                } else {
                    const tempInput = document.createElement('input');
                    tempInput.value = articleUrl;
                    tempInput.style.position = 'fixed';
                    tempInput.style.left = '-9999px';

                    document.body.appendChild(tempInput);
                    tempInput.focus();
                    tempInput.select();

                    document.execCommand('copy');
                    document.body.removeChild(tempInput);
                }

                showCopyToast();
            } catch (error) {
                alert('Không thể sao chép liên kết. Vui lòng copy trực tiếp trên thanh địa chỉ.');
            }
        }
    </script>
}