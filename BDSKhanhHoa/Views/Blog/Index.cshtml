@model IEnumerable<BDSKhanhHoa.Models.Blog>
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string GetSafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
            return "/images/no-image.jpg";

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
            return image;

        return "/" + image.TrimStart('/');
    }

    private string GetSafeText(string? value, string fallback = "Đang cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString("dd/MM/yyyy", Vi);
    }

    private string FormatNumber(int value)
    {
        return value.ToString("N0", Vi);
    }

    private string StripHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
            return "";

        string text = Regex.Replace(html, "<.*?>", " ");
        text = Regex.Replace(text, @"\s+", " ").Trim();
        return text;
    }

    private string GetExcerpt(BDSKhanhHoa.Models.Blog item, int maxLength = 135)
    {
        string text = !string.IsNullOrWhiteSpace(item.Summary)
            ? item.Summary!.Trim()
            : StripHtml(item.Content);

        if (string.IsNullOrWhiteSpace(text))
            return "Nội dung bài viết đang được cập nhật.";

        if (text.Length <= maxLength)
            return text;

        return text.Substring(0, maxLength).Trim() + "...";
    }
}

@{
    ViewData["Title"] = "Tin tức & Kiến thức Bất động sản";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string keyword = ViewBag.Keyword as string ?? "";
    string currentCategory = ViewBag.CurrentCategory as string ?? "";

    var categories = ViewBag.Categories as IEnumerable<string> ?? new List<string>();
    var categoryCounts = ViewBag.CategoryCounts as Dictionary<string, int> ?? new Dictionary<string, int>();

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : 0;

    if (currentPage < 1) currentPage = 1;
    if (totalPages < 1) totalPages = 1;

    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap');

    :root {
        --blog-bg: #f4f8fc;
        --blog-card: #ffffff;
        --blog-soft: #f8fafc;
        --blog-text: #111827;
        --blog-muted: #64748b;
        --blog-border: #e2e8f0;
        --blog-primary: #0b8ed8;
        --blog-primary-dark: #086fb0;
        --blog-radius: 18px;
        --blog-radius-lg: 24px;
        --blog-shadow: 0 10px 28px rgba(15, 23, 42, .07);
        --blog-shadow-hover: 0 18px 42px rgba(15, 23, 42, .13);
    }

    body {
        font-family: 'Roboto', Arial, sans-serif !important;
        background: var(--blog-bg);
        color: var(--blog-text);
    }

    .blog-page {
        min-height: 100vh;
        padding: 22px 0 52px;
        background: radial-gradient(circle at top left, rgba(14, 165, 233, .08), transparent 330px), linear-gradient(180deg, #f7fbff 0%, #f4f8fc 42%, #f4f8fc 100%);
    }

    .blog-container {
        width: calc(100% - 56px);
        max-width: 1500px;
        margin: 0 auto;
    }

    .blog-filter-card {
        margin-bottom: 22px;
        padding: 18px;
        border-radius: 24px;
        background: rgba(255,255,255,.96);
        border: 1px solid var(--blog-border);
        box-shadow: var(--blog-shadow);
    }

    .filter-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding-bottom: 14px;
        margin-bottom: 14px;
        border-bottom: 1px solid var(--blog-border);
    }

    .filter-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        color: #111827;
        font-size: 1.08rem;
        font-weight: 900;
    }

        .filter-title i {
            width: 40px;
            height: 40px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: var(--blog-primary);
        }

    .filter-note {
        margin: 0;
        color: var(--blog-muted);
        font-size: .95rem;
        font-weight: 500;
    }

    .form-label-blog {
        display: block;
        margin-bottom: 7px;
        color: #64748b;
        font-size: .82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .blog-input-wrap {
        position: relative;
    }

        .blog-input-wrap i {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }

    .blog-control {
        width: 100%;
        height: 50px;
        padding: 0 14px;
        border-radius: 15px;
        border: 1.5px solid var(--blog-border);
        background: #fff;
        color: #111827;
        outline: none;
        font-size: .98rem;
        font-weight: 500;
        transition: .2s ease;
    }

    .blog-input-wrap .blog-control {
        padding-left: 42px;
    }

    .blog-control:focus {
        border-color: var(--blog-primary);
        box-shadow: 0 0 0 4px rgba(14, 142, 216, .12);
    }

    .blog-btn-primary {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        background: linear-gradient(135deg, var(--blog-primary), #147eea);
        font-size: .98rem;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 10px 22px rgba(14, 142, 216, .23);
        transition: .2s ease;
    }

        .blog-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(14, 142, 216, .30);
        }

    .category-scroll {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 8px;
        overflow: visible;
        padding: 2px 0 0;
    }

    .category-chip {
        width: 100%;
        min-height: 38px;
        padding: 8px 12px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        color: #334155;
        background: #fff;
        border: 1px solid var(--blog-border);
        text-decoration: none;
        font-size: .86rem;
        line-height: 1.25;
        font-weight: 800;
        transition: .2s ease;
        min-width: 0;
        white-space: normal;
        overflow-wrap: anywhere;
    }

        .category-chip span {
            margin-left: auto;
            min-width: 26px;
            height: 24px;
            padding: 0 8px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--blog-primary-dark);
            background: #eaf6ff;
            font-size: .78rem;
            font-weight: 900;
            flex: 0 0 auto;
        }

        .category-chip:hover,
        .category-chip.active {
            color: #fff;
            background: var(--blog-primary);
            border-color: var(--blog-primary);
        }

            .category-chip:hover span,
            .category-chip.active span {
                color: var(--blog-primary-dark);
                background: #fff;
            }

    .section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--blog-primary-dark);
        font-size: .78rem;
        font-weight: 900;
        letter-spacing: .10em;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

        .section-kicker::before {
            content: "";
            width: 24px;
            height: 2px;
            border-radius: 99px;
            background: var(--blog-primary);
        }

    .section-title {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 1.65rem;
        line-height: 1.25;
        letter-spacing: -.02em;
        font-weight: 900;
    }

    .section-sub {
        margin: 0;
        color: var(--blog-muted);
        font-size: .95rem;
        font-weight: 400;
    }

        .section-sub strong {
            color: var(--blog-primary-dark);
            font-weight: 900;
        }

    .reset-link {
        height: 38px;
        padding: 0 14px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--blog-primary-dark);
        background: #eaf6ff;
        border: 1px solid #bae6fd;
        text-decoration: none;
        font-size: .88rem;
        font-weight: 700;
        transition: .2s ease;
    }

        .reset-link:hover {
            color: #fff;
            background: var(--blog-primary);
        }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .blog-card {
        height: 100%;
        overflow: hidden;
        border-radius: 22px;
        display: flex;
        flex-direction: column;
        color: inherit;
        text-decoration: none;
        background: #fff;
        border: 1px solid var(--blog-border);
        box-shadow: 0 8px 20px rgba(15, 23, 42, .05);
        transition: .22s ease;
    }

        .blog-card:hover {
            color: inherit;
            transform: translateY(-5px);
            border-color: #bae6fd;
            box-shadow: var(--blog-shadow-hover);
        }

    .blog-card-image {
        position: relative;
        height: 195px;
        overflow: hidden;
        background: var(--blog-soft);
    }

        .blog-card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: .4s ease;
        }

    .blog-card:hover .blog-card-image img {
        transform: scale(1.05);
    }

    .blog-card-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(15,23,42,.06), transparent 42%, rgba(15,23,42,.30));
        pointer-events: none;
    }

    .blog-card-category {
        position: absolute;
        left: 12px;
        top: 12px;
        z-index: 2;
        max-width: calc(100% - 24px);
        height: 30px;
        padding: 0 11px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #fff;
        background: rgba(14, 142, 216, .94);
        border: 1px solid rgba(255,255,255,.28);
        backdrop-filter: blur(10px);
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 16px;
    }

    .blog-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        margin-bottom: 9px;
        color: var(--blog-muted);
        font-size: .8rem;
        font-weight: 500;
    }

        .blog-meta span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .blog-meta i {
            color: var(--blog-primary);
        }

    .blog-card-title {
        margin: 0 0 8px;
        color: #111827;
        font-size: 1.02rem;
        line-height: 1.42;
        letter-spacing: -.01em;
        font-weight: 900;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: .2s ease;
    }

    .blog-card:hover .blog-card-title {
        color: var(--blog-primary-dark);
    }

    .blog-card-desc {
        margin: 0 0 14px;
        color: #475569;
        font-size: .92rem;
        line-height: 1.62;
        font-weight: 400;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-card-footer {
        margin-top: auto;
        padding-top: 13px;
        border-top: 1px dashed var(--blog-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .read-more {
        color: var(--blog-primary-dark);
        font-size: .82rem;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .read-circle {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--blog-primary-dark);
        background: #eaf6ff;
        transition: .2s ease;
    }

    .blog-card:hover .read-circle {
        color: #fff;
        background: var(--blog-primary);
        transform: translateX(2px);
    }

    .empty-card {
        padding: 42px 20px;
        border-radius: 24px;
        text-align: center;
        background: #fff;
        border: 2px dashed #cbd5e1;
        box-shadow: var(--blog-shadow);
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        border-radius: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--blog-primary);
        background: #eaf6ff;
        font-size: 2.1rem;
    }

    .empty-title {
        color: #111827;
        font-size: 1.15rem;
        font-weight: 900;
        margin-bottom: 7px;
    }

    .empty-text {
        color: var(--blog-muted);
        margin-bottom: 18px;
        line-height: 1.65;
    }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 34px;
    }

    .pagination-blog {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 6px;
        padding: 7px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--blog-border);
        box-shadow: var(--blog-shadow);
    }

    .page-link-blog,
    .page-dots {
        width: 39px;
        height: 39px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #111827;
        text-decoration: none;
        font-size: .9rem;
        font-weight: 800;
        transition: .2s ease;
    }

        .page-link-blog:hover {
            color: var(--blog-primary);
            background: #eaf6ff;
        }

        .page-link-blog.active {
            color: #fff;
            background: var(--blog-primary);
        }

    .page-dots {
        color: var(--blog-muted);
    }

    @@media (max-width: 1199.98px) {
        .blog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 991.98px) {
        .blog-container {
            width: calc(100% - 32px);
        }

        .blog-page {
            padding-top: 16px;
        }

        .blog-filter-card {
            border-radius: 22px;
        }

        .filter-top {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 767.98px) {
        .blog-container {
            width: calc(100% - 20px);
        }

        .blog-page {
            padding-top: 10px;
        }

        .filter-top {
            display: none;
        }

        .blog-filter-card {
            padding: 14px;
            margin-bottom: 18px;
        }

        .blog-control,
        .blog-btn-primary {
            height: 48px;
            border-radius: 14px;
        }

        .category-scroll {
            margin-top: 12px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 7px;
        }

        .category-chip {
            min-height: 38px;
            border-radius: 13px;
            padding: 7px 9px;
            font-size: .8rem;
        }

            .category-chip span {
                min-width: 23px;
                height: 22px;
                padding: 0 7px;
                font-size: .72rem;
            }

        .section-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .section-title {
            font-size: 1.38rem;
        }

        .blog-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .blog-card {
            border-radius: 20px;
        }

        .blog-card-image {
            height: 205px;
        }

        .blog-card-body {
            padding: 15px;
        }

        .pagination-blog {
            border-radius: 18px;
        }

        .page-link-blog,
        .page-dots {
            width: 36px;
            height: 36px;
        }
    }

    @@media (max-width: 575.98px) {
        .category-scroll {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .category-chip {
            font-size: .76rem;
        }

        .blog-card-image {
            height: 190px;
        }

        .blog-card-title {
            font-size: .98rem;
        }

        .blog-card-desc {
            font-size: .88rem;
        }
    }


    @@media (max-width: 360px) {
        .category-scroll {
            grid-template-columns: 1fr;
        }
    }

</style>

<div class="blog-page">
    <main class="blog-container">
        <section class="blog-filter-card">
            <div class="filter-top">
                <h2 class="filter-title">
                    <i class="bi bi-funnel-fill"></i>
                    Tìm kiếm bài viết
                </h2>

                <p class="filter-note">
                    Lọc nhanh theo từ khóa hoặc chuyên mục bạn đang quan tâm.
                </p>
            </div>

            <form asp-controller="Blog" asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="form-label-blog">Từ khóa</label>
                        <div class="blog-input-wrap">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   name="keyword"
                                   value="@keyword"
                                   class="blog-control"
                                   placeholder="Ví dụ: pháp lý, quy hoạch, kinh nghiệm mua bán..." />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="form-label-blog">Danh mục</label>
                        <select name="category" class="blog-control">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var cat in categories)
                            {
                                if (string.Equals(currentCategory, cat, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@cat" selected>@cat</option>
                                }
                                else
                                {
                                    <option value="@cat">@cat</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-3">
                        <button type="submit" class="blog-btn-primary">
                            <i class="bi bi-search"></i>
                            Tìm bài viết
                        </button>
                    </div>
                </div>
            </form>

            @if (categories.Any())
            {
                <div class="category-scroll mt-3">
                    <a class="category-chip @(string.IsNullOrWhiteSpace(currentCategory) ? "active" : "")"
                       href="@Url.Action("Index", "Blog", new { keyword = keyword })">
                        <i class="bi bi-grid-fill"></i>
                        Tất cả
                    </a>

                    @foreach (var cat in categories)
                    {
                        int count = categoryCounts.ContainsKey(cat) ? categoryCounts[cat] : 0;

                        <a class="category-chip @(string.Equals(currentCategory, cat, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                           href="@Url.Action("Index", "Blog", new { category = cat, keyword = keyword })">
                            @cat
                            <span>@FormatNumber(count)</span>
                        </a>
                    }
                </div>
            }
        </section>

        <section class="section-head">
            <div>
                <div class="section-kicker">Bài viết mới nhất</div>
                <h2 class="section-title">Tin tức & kiến thức nổi bật</h2>
                <p class="section-sub">
                    Tìm thấy <strong>@FormatNumber(totalItems)</strong> bài viết phù hợp.
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(keyword) || !string.IsNullOrWhiteSpace(currentCategory))
            {
                <a href="@Url.Action("Index", "Blog")" class="reset-link">
                    <i class="bi bi-arrow-clockwise"></i>
                    Xóa bộ lọc
                </a>
            }
        </section>

        @if (Model != null && Model.Any())
        {
            <section class="blog-grid">
                @foreach (var item in Model)
                {
                    string imageUrl = GetSafeImage(item.ImageURL);
                    string categoryName = GetSafeText(item.Category, "Tin tức");
                    string excerpt = GetExcerpt(item);

                    <a asp-controller="Blog"
                       asp-action="Details"
                       asp-route-id="@item.BlogID"
                       class="blog-card">
                        <div class="blog-card-image">
                            <img src="@imageUrl"
                                 alt="@item.Title"
                                 loading="lazy"
                                 decoding="async"
                                 draggable="false"
                                 onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                            <span class="blog-card-category" title="@categoryName">
                                <i class="bi bi-tag-fill"></i>
                                @categoryName
                            </span>
                        </div>

                        <div class="blog-card-body">
                            <div class="blog-meta">
                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @FormatDate(item.CreatedAt)
                                </span>

                                <span>
                                    <i class="bi bi-eye"></i>
                                    @FormatNumber(item.Views) lượt xem
                                </span>
                            </div>

                            <h2 class="blog-card-title">@item.Title</h2>

                            <p class="blog-card-desc">@excerpt</p>

                            <div class="blog-card-footer">
                                <span class="read-more">Đọc tiếp</span>

                                <span class="read-circle">
                                    <i class="bi bi-arrow-right"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </section>

            @if (totalPages > 1)
            {
                <div class="pagination-wrap">
                    <nav class="pagination-blog" aria-label="Phân trang bài viết">
                        @if (currentPage > 1)
                        {
                            <a class="page-link-blog"
                               title="Trang trước"
                               href="@Url.Action("Index", "Blog", new { page = currentPage - 1, keyword = keyword, category = currentCategory })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }

                        @if (startPage > 1)
                        {
                            <a class="page-link-blog"
                               href="@Url.Action("Index", "Blog", new { page = 1, keyword = keyword, category = currentCategory })">1</a>

                            @if (startPage > 2)
                            {
                                <span class="page-dots">...</span>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <a class="page-link-blog @(currentPage == i ? "active" : "")"
                               href="@Url.Action("Index", "Blog", new { page = i, keyword = keyword, category = currentCategory })">
                                @i
                            </a>
                        }

                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <span class="page-dots">...</span>
                            }

                            <a class="page-link-blog"
                               href="@Url.Action("Index", "Blog", new { page = totalPages, keyword = keyword, category = currentCategory })">
                                @totalPages
                            </a>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a class="page-link-blog"
                               title="Trang sau"
                               href="@Url.Action("Index", "Blog", new { page = currentPage + 1, keyword = keyword, category = currentCategory })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </nav>
                </div>
            }
        }
        else
        {
            <section class="empty-card">
                <div class="empty-icon">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h3 class="empty-title">Không tìm thấy bài viết phù hợp</h3>

                <p class="empty-text">
                    Hãy thử nhập từ khóa ngắn hơn hoặc chọn lại chuyên mục khác.
                </p>

                <a href="@Url.Action("Index", "Blog")" class="blog-btn-primary" style="width:auto;padding:0 22px;">
                    <i class="bi bi-arrow-clockwise"></i>
                    Xóa bộ lọc
                </a>
            </section>
        }
    </main>
</div>