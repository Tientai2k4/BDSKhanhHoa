@model IEnumerable<BDSKhanhHoa.Models.Blog>
@using System.Globalization

@functions {
    private static readonly CultureInfo Vi = new CultureInfo("vi-VN");

    private string GetSafeImage(string? image)
    {
        if (string.IsNullOrWhiteSpace(image))
        {
            return "/images/no-image.jpg";
        }

        image = image.Trim();

        if (image.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            image.StartsWith("/"))
        {
            return image;
        }

        return "/" + image.TrimStart('/');
    }

    private string GetSafeText(string? value, string fallback = "Đang cập nhật")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString("dd/MM/yyyy", Vi);
    }

    private string FormatNumber(int value)
    {
        return value.ToString("N0", Vi);
    }
}

@{
    ViewData["Title"] = "Tin tức & Kiến thức Bất động sản";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string keyword = ViewBag.Keyword as string ?? "";
    string currentCategory = ViewBag.CurrentCategory as string ?? "";

    var categories = ViewBag.Categories as IEnumerable<string> ?? new List<string>();

    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;

    if (currentPage < 1)
    {
        currentPage = 1;
    }

    if (totalPages < 1)
    {
        totalPages = 1;
    }

    int totalPosts = Model != null ? Model.Count() : 0;
    int startPage = Math.Max(1, currentPage - 2);
    int endPage = Math.Min(totalPages, currentPage + 2);
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');

    :root {
        --blog-bg: #f7f9fc;
        --blog-surface: #ffffff;
        --blog-soft: #f1f5f9;
        --blog-soft-2: #eef4ff;
        --blog-border: #e2e8f0;
        --blog-border-strong: #cbd5e1;
        --blog-text: #0f172a;
        --blog-muted: #64748b;
        --blog-blue: #2563eb;
        --blog-blue-dark: #1d4ed8;
        --blog-sky: #0ea5e9;
        --blog-green: #16a34a;
        --blog-orange: #f97316;
        --blog-red: #ef4444;
        --blog-yellow: #f59e0b;
        --blog-radius-sm: 14px;
        --blog-radius: 20px;
        --blog-radius-lg: 28px;
        --blog-shadow-sm: 0 8px 22px rgba(15, 23, 42, .05);
        --blog-shadow: 0 18px 45px rgba(15, 23, 42, .10);
        --blog-transition: all .24s cubic-bezier(.4, 0, .2, 1);
    }

    body {
        background: radial-gradient(circle at 8% 0%, rgba(37, 99, 235, .08), transparent 30%), radial-gradient(circle at 90% 4%, rgba(14, 165, 233, .08), transparent 28%), var(--blog-bg);
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--blog-text);
    }

    .fw-black {
        font-weight: 900 !important;
    }

    .blog-page {
        min-height: 100vh;
        padding-bottom: 70px;
    }

    .blog-shell {
        max-width: 1180px;
        margin: 0 auto;
        padding-left: 16px;
        padding-right: 16px;
    }

    .blog-hero-2026 {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(239, 246, 255, .96), rgba(255, 255, 255, .96)), radial-gradient(circle at 12% 20%, rgba(37, 99, 235, .16), transparent 30%), radial-gradient(circle at 84% 6%, rgba(245, 158, 11, .14), transparent 28%);
        border-bottom: 1px solid var(--blog-border);
        padding: 70px 0 98px;
        margin-bottom: -52px;
    }

    .blog-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 330px;
        gap: 28px;
        align-items: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 36px;
        padding: 0 14px;
        border-radius: 999px;
        color: var(--blog-blue);
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        font-size: .8rem;
        font-weight: 900;
        margin-bottom: 18px;
    }

    .hero-title {
        color: var(--blog-text);
        font-size: clamp(2rem, 4.5vw, 4rem);
        line-height: 1.08;
        letter-spacing: -.045em;
        font-weight: 950;
        margin-bottom: 16px;
    }

        .hero-title span {
            color: var(--blog-blue);
        }

    .hero-sub {
        max-width: 720px;
        color: var(--blog-muted);
        font-size: clamp(.98rem, 1.35vw, 1.12rem);
        line-height: 1.8;
        font-weight: 600;
        margin-bottom: 0;
    }

    .hero-side-card {
        background: rgba(255, 255, 255, .82);
        border: 1px solid rgba(226, 232, 240, .9);
        border-radius: 28px;
        padding: 22px;
        box-shadow: var(--blog-shadow-sm);
        backdrop-filter: blur(16px);
    }

    .hero-side-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px;
        border-radius: 18px;
        background: #fff;
        border: 1px solid var(--blog-border);
        margin-bottom: 10px;
    }

        .hero-side-row:last-child {
            margin-bottom: 0;
        }

    .hero-side-icon {
        width: 42px;
        height: 42px;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, var(--blog-blue), var(--blog-sky));
        flex-shrink: 0;
        font-size: 1.12rem;
    }

    .hero-side-label {
        color: var(--blog-muted);
        font-size: .74rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 2px;
    }

    .hero-side-value {
        color: var(--blog-text);
        font-weight: 950;
        line-height: 1.25;
    }

    .search-box-2026 {
        position: relative;
        z-index: 10;
        background: rgba(255, 255, 255, .94);
        border: 1px solid rgba(255, 255, 255, .9);
        border-radius: 28px;
        padding: 22px;
        box-shadow: 0 20px 55px rgba(15, 23, 42, .10);
        backdrop-filter: blur(18px);
        margin-bottom: 36px;
    }

    .filter-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding-bottom: 16px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--blog-border);
    }

    .filter-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--blog-text);
        font-size: 1.02rem;
        font-weight: 950;
        margin: 0;
    }

        .filter-title i {
            width: 38px;
            height: 38px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            background: linear-gradient(135deg, var(--blog-blue), var(--blog-sky));
        }

    .filter-note {
        color: var(--blog-muted);
        font-size: .86rem;
        font-weight: 650;
        margin: 0;
    }

    .field-label {
        color: var(--blog-muted);
        font-size: .76rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 8px;
    }

    .input-wrap {
        position: relative;
    }

        .input-wrap i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            pointer-events: none;
        }

    .control-2026 {
        width: 100%;
        min-height: 52px;
        border-radius: 16px;
        border: 1.5px solid var(--blog-border);
        background: #fff;
        color: var(--blog-text);
        font-weight: 750;
        padding: 0 14px;
        outline: none;
        transition: var(--blog-transition);
        box-shadow: none;
    }

    .input-wrap .control-2026 {
        padding-left: 42px;
    }

    .control-2026:focus {
        border-color: var(--blog-blue);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
    }

    .btn-filter {
        width: 100%;
        min-height: 52px;
        border: none;
        border-radius: 16px;
        background: linear-gradient(135deg, var(--blog-blue), var(--blog-sky));
        color: #fff;
        font-weight: 950;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: var(--blog-transition);
        box-shadow: 0 12px 28px rgba(37, 99, 235, .24);
    }

        .btn-filter:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 34px rgba(37, 99, 235, .32);
        }

    .result-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .section-kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--blog-blue);
        font-size: .75rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .12em;
        margin-bottom: 8px;
    }

        .section-kicker::before {
            content: "";
            width: 24px;
            height: 2px;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--blog-blue), var(--blog-sky));
        }

    .result-title {
        color: var(--blog-text);
        font-size: clamp(1.45rem, 3vw, 2.1rem);
        font-weight: 950;
        letter-spacing: -.035em;
        margin: 0 0 6px;
    }

    .result-sub {
        color: var(--blog-muted);
        font-weight: 650;
        margin: 0;
    }

        .result-sub strong {
            color: var(--blog-blue);
            font-weight: 950;
        }

    .quick-chip-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .quick-chip {
        min-height: 38px;
        padding: 0 13px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--blog-muted);
        background: #fff;
        border: 1px solid var(--blog-border);
        font-size: .82rem;
        font-weight: 850;
        box-shadow: var(--blog-shadow-sm);
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .blog-card-2026 {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        border-radius: 26px;
        background: #fff;
        border: 1px solid var(--blog-border);
        box-shadow: var(--blog-shadow-sm);
        transition: var(--blog-transition);
        text-decoration: none;
        color: inherit;
    }

        .blog-card-2026:hover {
            transform: translateY(-7px);
            box-shadow: var(--blog-shadow);
            border-color: #bfdbfe;
        }

    .blog-img-wrap-2026 {
        position: relative;
        height: 218px;
        overflow: hidden;
        background: var(--blog-soft);
    }

        .blog-img-wrap-2026::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(15, 23, 42, .20), transparent 48%, rgba(15, 23, 42, .40));
            pointer-events: none;
            z-index: 1;
        }

        .blog-img-wrap-2026 img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center center;
            display: block;
            transition: transform .45s ease;
        }

    .blog-card-2026:hover .blog-img-wrap-2026 img {
        transform: scale(1.06);
    }

    .blog-cat-badge-2026 {
        position: absolute;
        top: 13px;
        left: 13px;
        z-index: 2;
        max-width: calc(100% - 26px);
        min-height: 32px;
        padding: 0 12px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #fff;
        background: rgba(37, 99, 235, .94);
        border: 1px solid rgba(255,255,255,.26);
        backdrop-filter: blur(12px);
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .05em;
        box-shadow: 0 10px 22px rgba(15, 23, 42, .18);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-card-body-2026 {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .blog-meta-2026 {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
        color: var(--blog-muted);
        font-size: .78rem;
        font-weight: 750;
        margin-bottom: 11px;
    }

        .blog-meta-2026 span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .blog-meta-2026 i {
            color: var(--blog-blue);
        }

    .blog-title-2026 {
        color: var(--blog-text);
        font-size: 1.08rem;
        line-height: 1.48;
        font-weight: 950;
        letter-spacing: -.02em;
        margin: 0 0 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: var(--blog-transition);
    }

    .blog-card-2026:hover .blog-title-2026 {
        color: var(--blog-blue);
    }

    .blog-summary-2026 {
        color: #475569;
        font-size: .9rem;
        line-height: 1.72;
        font-weight: 550;
        margin: 0 0 18px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-card-footer-2026 {
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px dashed var(--blog-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .readmore-2026 {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--blog-blue);
        font-size: .82rem;
        font-weight: 950;
        text-transform: uppercase;
        letter-spacing: .08em;
    }

    .read-icon {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--blog-blue);
        background: #eff6ff;
        transition: var(--blog-transition);
    }

    .blog-card-2026:hover .read-icon {
        color: #fff;
        background: var(--blog-blue);
        transform: translateX(2px);
    }

    .empty-box-2026 {
        border-radius: 28px;
        border: 2px dashed var(--blog-border-strong);
        background: #fff;
        text-align: center;
        padding: 56px 22px;
        box-shadow: var(--blog-shadow-sm);
    }

    .empty-icon-2026 {
        width: 84px;
        height: 84px;
        border-radius: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--blog-blue);
        background: #eff6ff;
        font-size: 2.5rem;
        margin-bottom: 18px;
    }

    .btn-reset {
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #fff;
        background: linear-gradient(135deg, var(--blog-blue), var(--blog-sky));
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 12px 26px rgba(37,99,235,.22);
    }

    .pagination-wrap {
        display: flex;
        justify-content: center;
        margin-top: 42px;
    }

    .pagination-2026 {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        justify-content: center;
        padding: 8px;
        border-radius: 999px;
        background: rgba(255,255,255,.86);
        border: 1px solid var(--blog-border);
        box-shadow: var(--blog-shadow-sm);
    }

    .page-link-2026 {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--blog-text);
        background: transparent;
        text-decoration: none;
        font-weight: 950;
        transition: var(--blog-transition);
    }

        .page-link-2026:hover {
            color: var(--blog-blue);
            background: #eff6ff;
        }

        .page-link-2026.active {
            color: #fff;
            background: linear-gradient(135deg, var(--blog-blue), var(--blog-sky));
            box-shadow: 0 10px 22px rgba(37,99,235,.22);
        }

    @@media (max-width: 1199.98px) {
        .blog-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .blog-hero-grid {
            grid-template-columns: 1fr;
        }

        .hero-side-card {
            max-width: 520px;
        }
    }

    @@media (max-width: 991.98px) {
        .blog-hero-2026 {
            padding: 58px 0 90px;
            margin-bottom: -44px;
        }

        .search-box-2026 {
            padding: 18px;
            border-radius: 24px;
        }

        .filter-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .blog-img-wrap-2026 {
            height: 210px;
        }
    }

    @@media (max-width: 767.98px) {
        .blog-shell {
            padding-left: 10px;
            padding-right: 10px;
        }

        .blog-hero-2026 {
            padding: 46px 0 78px;
        }

        .hero-title {
            font-size: 2rem;
        }

        .hero-sub {
            font-size: .94rem;
        }

        .hero-side-card {
            display: none;
        }

        .filter-head {
            display: none;
        }

        .control-2026,
        .btn-filter {
            min-height: 50px;
            border-radius: 15px;
        }

        .result-head {
            margin-top: 4px;
        }

        .quick-chip-row {
            width: 100%;
        }

        .quick-chip {
            flex: 1;
            justify-content: center;
        }

        .blog-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .blog-card-2026 {
            border-radius: 22px;
        }

        .blog-img-wrap-2026 {
            height: 220px;
        }

        .blog-card-body-2026 {
            padding: 17px;
        }

        .pagination-2026 {
            border-radius: 22px;
        }

        .page-link-2026 {
            width: 38px;
            height: 38px;
        }
    }

    @@media (max-width: 575.98px) {
        .blog-hero-2026 {
            padding-top: 36px;
            padding-bottom: 70px;
        }

        .hero-badge {
            min-height: 32px;
            padding: 0 11px;
            font-size: .72rem;
            margin-bottom: 14px;
        }

        .hero-title {
            font-size: 1.72rem;
        }

        .blog-img-wrap-2026 {
            height: 205px;
        }

        .blog-meta-2026 {
            font-size: .74rem;
        }

        .blog-title-2026 {
            font-size: 1rem;
        }

        .blog-summary-2026 {
            font-size: .86rem;
        }

        .empty-box-2026 {
            padding: 42px 18px;
            border-radius: 22px;
        }
    }
</style>

<div class="blog-page">
    <section class="blog-hero-2026">
        <div class="blog-shell">
            <div class="blog-hero-grid">
                <div>
                    <div class="hero-badge">
                        <i class="bi bi-stars"></i>
                        Tin tức BĐS Khánh Hòa 2026
                    </div>

                    <h1 class="hero-title">
                        Tin tức & kiến thức <br class="d-none d-md-block" />
                        <span>bất động sản</span>
                    </h1>

                    <p class="hero-sub">
                        Cập nhật thông tin thị trường, pháp lý, kinh nghiệm mua bán, đầu tư và các xu hướng bất động sản mới nhất tại Khánh Hòa.
                    </p>
                </div>

                <aside class="hero-side-card">
                    <div class="hero-side-row">
                        <div class="hero-side-icon">
                            <i class="bi bi-newspaper"></i>
                        </div>
                        <div>
                            <div class="hero-side-label">Bài viết hiển thị</div>
                            <div class="hero-side-value">@FormatNumber(totalPosts) bài</div>
                        </div>
                    </div>

                    <div class="hero-side-row">
                        <div class="hero-side-icon" style="background:linear-gradient(135deg,#16a34a,#10b981);">
                            <i class="bi bi-tags-fill"></i>
                        </div>
                        <div>
                            <div class="hero-side-label">Danh mục</div>
                            <div class="hero-side-value">@(categories.Any() ? FormatNumber(categories.Count()) + " chuyên mục" : "Đang cập nhật")</div>
                        </div>
                    </div>

                    <div class="hero-side-row">
                        <div class="hero-side-icon" style="background:linear-gradient(135deg,#f59e0b,#f97316);">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <div>
                            <div class="hero-side-label">Bộ lọc</div>
                            <div class="hero-side-value">Tìm nhanh theo nhu cầu</div>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <div class="blog-shell">
        <div class="search-box-2026">
            <div class="filter-head">
                <h2 class="filter-title">
                    <i class="bi bi-funnel-fill"></i>
                    Tìm kiếm bài viết
                </h2>

                <p class="filter-note">
                    Lọc nhanh theo từ khóa và chuyên mục bạn quan tâm.
                </p>
            </div>

            <form action="/Blog/Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-lg-5">
                        <label class="field-label">Từ khóa</label>
                        <div class="input-wrap">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   name="keyword"
                                   value="@keyword"
                                   class="control-2026"
                                   placeholder="Nhập từ khóa bài viết..." />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <label class="field-label">Danh mục</label>
                        <select name="category" class="control-2026">
                            <option value="">Tất cả danh mục</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat" selected="@(string.Equals(currentCategory, cat, StringComparison.OrdinalIgnoreCase))">
                                    @cat
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-3">
                        <button type="submit" class="btn-filter">
                            <i class="bi bi-search"></i>
                            Lọc bài viết
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="result-head">
            <div>
                <div class="section-kicker">Market insights</div>
                <h2 class="result-title">Bài viết mới nhất</h2>
                <p class="result-sub">
                    Đang hiển thị <strong>@FormatNumber(totalPosts)</strong> bài viết phù hợp.
                </p>
            </div>

           
        </div>

        @if (Model != null && Model.Any())
        {
            <section class="blog-grid">
                @foreach (var item in Model)
                {
                    string imageUrl = GetSafeImage(item.ImageURL);
                    string categoryName = GetSafeText(item.Category, "Tin tức");
                    string summary = GetSafeText(item.Summary, "Nội dung tóm tắt bài viết đang được cập nhật.");

                    <a asp-action="Details" asp-route-id="@item.BlogID" class="blog-card-2026">
                        <div class="blog-img-wrap-2026">
                            <img src="@imageUrl"
                                 alt="@item.Title"
                                 loading="lazy"
                                 decoding="async"
                                 draggable="false"
                                 onerror="this.onerror=null;this.src='/images/no-image.jpg';" />

                            <span class="blog-cat-badge-2026" title="@categoryName">
                                <i class="bi bi-tag-fill"></i>
                                @categoryName
                            </span>
                        </div>

                        <div class="blog-card-body-2026">
                            <div class="blog-meta-2026">
                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    @FormatDate(item.CreatedAt)
                                </span>

                                <span>
                                    <i class="bi bi-eye"></i>
                                    @FormatNumber(item.Views) lượt xem
                                </span>
                            </div>

                            <h2 class="blog-title-2026">@item.Title</h2>

                            <p class="blog-summary-2026">@summary</p>

                            <div class="blog-card-footer-2026">
                                <span class="readmore-2026">
                                    Đọc tiếp
                                </span>

                                <span class="read-icon">
                                    <i class="bi bi-arrow-right"></i>
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </section>

            @if (totalPages > 1)
            {
                <div class="pagination-wrap">
                    <nav class="pagination-2026">
                        @if (currentPage > 1)
                        {
                            <a class="page-link-2026"
                               href="@Url.Action("Index", "Blog", new { page = currentPage - 1, keyword = keyword, category = currentCategory })">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        }

                        @if (startPage > 1)
                        {
                            <a class="page-link-2026"
                               href="@Url.Action("Index", "Blog", new { page = 1, keyword = keyword, category = currentCategory })">1</a>

                            @if (startPage > 2)
                            {
                                <span class="page-link-2026">...</span>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <a class="page-link-2026 @(currentPage == i ? "active" : "")"
                               href="@Url.Action("Index", "Blog", new { page = i, keyword = keyword, category = currentCategory })">
                                @i
                            </a>
                        }

                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <span class="page-link-2026">...</span>
                            }

                            <a class="page-link-2026"
                               href="@Url.Action("Index", "Blog", new { page = totalPages, keyword = keyword, category = currentCategory })">@totalPages</a>
                        }

                        @if (currentPage < totalPages)
                        {
                            <a class="page-link-2026"
                               href="@Url.Action("Index", "Blog", new { page = currentPage + 1, keyword = keyword, category = currentCategory })">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </nav>
                </div>
            }
        }
        else
        {
            <section class="empty-box-2026">
                <div class="empty-icon-2026">
                    <i class="bi bi-journal-x"></i>
                </div>

                <h3 class="fw-black text-dark mb-2">Không tìm thấy bài viết nào</h3>

                <p class="text-muted mb-4">
                    Hãy thử tìm kiếm với từ khóa khác hoặc xóa bộ lọc danh mục hiện tại.
                </p>

                <a href="/Blog/Index" class="btn-reset">
                    <i class="bi bi-arrow-clockwise"></i>
                    Xóa bộ lọc
                </a>
            </section>
        }
    </div>
</div>