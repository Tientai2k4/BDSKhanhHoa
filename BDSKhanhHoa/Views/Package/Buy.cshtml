                <div>
                    <h3 class="helper-title">Tăng tốc tiếp cận</h3>
                    <p class="helper-desc">Gói ưu tiên giúp tin đăng nổi bật hơn trong danh sách tìm kiếm.</p>
                </div>
            </div>

            <div class="helper-card">
                <div class="helper-icon">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h3 class="helper-title">Quản lý minh bạch</h3>
                    <p class="helper-desc">Mỗi lượt mua đều được ghi nhận trong lịch sử giao dịch và hóa đơn.</p>
                </div>
            </div>

            <div class="helper-card">
                <div class="helper-icon">
                    <i class="bi bi-cart-check-fill"></i>
                </div>
                <div>
                    <h3 class="helper-title">Mua nhiều gói dễ dàng</h3>
                    <p class="helper-desc">Thêm nhiều gói vào giỏ, sau đó thanh toán một lần nhanh gọn.</p>
                </div>
            </div>
        </section>

        <section id="pricingList" class="pricing-grid">
            @if (!packages.Any())
            {
                <div class="empty-pricing">
                    <div class="empty-pricing-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>

                    <h3 class="fw-black text-dark mb-2">Chưa có gói dịch vụ</h3>
                    <p class="text-muted fw-semibold mb-0">
                        Hiện hệ thống chưa cấu hình bảng giá. Vui lòng quay lại sau.
                    </p>
                </div>
            }
            else
            {
                foreach (var pkg in packages)
                {
                    string themeClass = ThemeClass(pkg.PackageType);
                    string iconClass = IconClass(pkg.PackageType);
                    string shortText = PackageShortText(pkg.PackageType);
                    bool isDiamond = pkg.PackageType == "Kim Cương";
                    bool isFree = pkg.Price <= 0;

                    <article class="pricing-card @themeClass">
                        @if (isDiamond)
                        {
                            <div class="popular-ribbon">
                                Nổi bật
                            </div>
                        }

                        <div class="pricing-card-inner">
                            <div class="pricing-top">
                                <div class="icon-box">
                                    <i class="bi @iconClass"></i>
                                </div>

                                <span class="package-type-pill">
                                    <i class="bi bi-award-fill"></i>
                                    @(string.IsNullOrWhiteSpace(pkg.PackageType) ? "Dịch vụ" : pkg.PackageType)
                                </span>
                            </div>

                            <h3 class="package-name">@pkg.PackageName</h3>

                            <p class="package-short">
                                @shortText
                            </p>

                            <div class="pricing-price">
                                <span class="price-main">@FormatMoney(pkg.Price)</span>
                                @if (!isFree)
                                {
                                    <span class="price-unit">/ gói</span>
                                }
                            </div>

                            <ul class="pricing-features">
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>
                                        Hiển thị liên tục trong
                                        <span class="feature-strong">@pkg.DurationDays ngày</span>
                                    </span>
                                </li>

                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span>
                                        Mức ưu tiên hiển thị:
                                        <span class="feature-strong">Top @pkg.PriorityLevel</span>
                                    </span>
                                </li>

                                @if (pkg.PackageType == "Kim Cương")
                                {
                                    <li>
                                        <i class="bi bi-check-circle-fill"></i>
                                        <span>
                                            Tin đăng mới được hỗ trợ
                                            <span class="feature-strong">duyệt tự động</span>
                                        </span>
                                    </li>
                                }

                                @if (!string.IsNullOrWhiteSpace(pkg.Description))
                                {
                                    foreach (var line in pkg.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <li>
                                            <i class="bi bi-check-circle-fill"></i>
                                            <span>@line.Trim()</span>
                                        </li>
                                    }
                                }
                            </ul>

                            <div class="pricing-actions">
                                <button type="button"
                                        onclick="addToCart(@pkg.PackageID, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(pkg.PackageName))')"
                                        class="btn-buy">
                                    <i class="bi bi-cart-plus-fill"></i>
                                    @(isFree ? "Thêm gói miễn phí" : "Thêm vào giỏ")
                                </button>

                                @if (!isFree)
                                {
                                    <a href="/Payment/Checkout?packageId=@pkg.PackageID" class="btn-pay-now">
                                        <i class="bi bi-credit-card-fill"></i>
                                        Thanh toán ngay
                                    </a>
                                }
                            </div>
                        </div>
                    </article>
                }
            }
        </section>
    </div>
</div>

<div class="cart-mini-panel" id="cartMiniPanel">
    <h5 class="cart-mini-title">
        <i class="bi bi-bag-heart-fill text-primary me-1"></i>
        Giỏ gói dịch vụ
    </h5>
    <p class="cart-mini-desc" id="cartMiniDesc">
        Bạn đang có 0 gói trong giỏ.
    </p>

    <div class="cart-mini-actions">
        <a href="/Payment/Checkout" class="cart-checkout-btn">
            Thanh toán
        </a>

        <button type="button" class="cart-clear-btn" onclick="clearCart()">
            Xóa
        </button>
    </div>
</div>

<a href="/Payment/Checkout" class="floating-cart" id="floatingCart" title="Xem giỏ hàng">
    <i class="bi bi-bag-heart-fill"></i>
    <span class="cart-badge" id="cartBadgeCount">0</span>
</a>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
                const activePackageIds = new Set([
        @foreach (var p in packages)
        {
                <text>@p.PackageID,</text>
        }
                ]);

                let bdsCart = [];

                try {
                    bdsCart = JSON.parse(localStorage.getItem('bds_cart')) || [];
                } catch {
                    bdsCart = [];
                }

                // Dọn giỏ hàng cũ: nếu Admin đã ngừng dùng gói thì xóa khỏi giỏ của trình duyệt.
                bdsCart = bdsCart
                    .filter(x => activePackageIds.has(Number(x.PackageId)))
                    .map(x => ({
                        PackageId: Number(x.PackageId),
                        Quantity: Math.max(1, Number(x.Quantity || 1))
                    }));

                localStorage.setItem('bds_cart', JSON.stringify(bdsCart));

                function saveCart() {
                    localStorage.setItem('bds_cart', JSON.stringify(bdsCart));
                }

                function getCartCount() {
                    return bdsCart.reduce((sum, item) => sum + Number(item.Quantity || 0), 0);
                }

                function updateCartUI() {
                    const count = getCartCount();
                    const cartElement = document.getElementById('floatingCart');
                    const badgeElement = document.getElementById('cartBadgeCount');
                    const miniPanel = document.getElementById('cartMiniPanel');
                    const miniDesc = document.getElementById('cartMiniDesc');

                    badgeElement.innerText = count;
                    miniDesc.innerText = count > 0
                        ? `Bạn đang có ${count} gói trong giỏ.`
                        : 'Bạn đang có 0 gói trong giỏ.';

                    if (count > 0) {
                        cartElement.style.display = 'flex';
                    } else {
                        cartElement.style.display = 'none';
                        miniPanel.classList.remove('show');
                    }
                }

                function addToCart(pkgId, pkgName) {
                    pkgId = Number(pkgId);

                    if (!activePackageIds.has(pkgId)) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Gói đã ngừng sử dụng',
                            text: 'Gói này hiện không còn được mở bán. Vui lòng chọn gói khác.',
                            confirmButtonText: 'Đã hiểu',
                            confirmButtonColor: '#2563eb',
                            customClass: {
                                popup: 'rounded-4'
                            }
                        });
                        return;
                    }

                    let item = bdsCart.find(x => Number(x.PackageId) === pkgId);

                    if (item) {
                        item.Quantity = Number(item.Quantity || 0) + 1;
                    } else {
                        bdsCart.push({
                            PackageId: pkgId,
                            Quantity: 1
                        });
                    }

                    saveCart();
                    updateCartUI();

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: `Đã thêm ${pkgName} vào giỏ`,
                        showConfirmButton: false,
                        timer: 2200,
                        timerProgressBar: true,
                        customClass: {
                            popup: 'rounded-4'
                        }
                    });
                }

                function clearCart() {
                    if (!bdsCart.length) {
                        updateCartUI();
                        return;
                    }

                    Swal.fire({
                        title: 'Xóa giỏ hàng?',
                        text: 'Toàn bộ gói dịch vụ trong giỏ sẽ được xóa.',
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Xóa giỏ',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#94a3b8',
                        customClass: {
                            confirmButton: 'rounded-pill px-4',
                            cancelButton: 'rounded-pill px-4'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            bdsCart = [];
                            saveCart();
                            updateCartUI();

                            Swal.fire({
                                toast: true,
                                position: 'top-end',
                                icon: 'success',
                                title: 'Đã xóa giỏ hàng',
                                showConfirmButton: false,
                                timer: 1800
                            });
                        }
                    });
                }

                document.addEventListener('DOMContentLoaded', function () {
                    updateCartUI();

                    const cartElement = document.getElementById('floatingCart');
                    const miniPanel = document.getElementById('cartMiniPanel');

                    cartElement.addEventListener('mouseenter', function () {
                        if (getCartCount() > 0) {
                            miniPanel.classList.add('show');
                        }
                    });

                    miniPanel.addEventListener('mouseleave', function () {
                        miniPanel.classList.remove('show');
                    });
                });
    </script>
}