@model IEnumerable<BDSKhanhHoa.Models.PostServicePackage>

@{
    ViewData["Title"] = "Bảng giá dịch vụ";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // Chỉ hiển thị gói đang dùng.
    // Admin bấm Ngừng dùng thì gói sẽ không xuất hiện để người dùng thêm giỏ hàng/thanh toán mới.
    var packages = Model?
        .Where(p => p.IsActive)
        .OrderBy(p => p.PriorityLevel)
        .ThenBy(p => p.Price)
        .ToList() ?? new List<BDSKhanhHoa.Models.PostServicePackage>();

    var diamond = packages.FirstOrDefault(p => p.PackageType == "Kim Cương");
    decimal minPrice = packages.Any() ? packages.Min(p => p.Price) : 0;
}

@functions {
    public string ThemeClass(string? packageType)
    {
        return packageType switch
        {
            "Kim Cương" => "theme-diamond",
            "Vàng" => "theme-gold",
            "Bạc" => "theme-silver",
            "Đồng" => "theme-bronze",
            "Tin Thường" => "theme-basic",
            _ => "theme-basic"
        };
    }

    public string IconClass(string? packageType)
    {
        return packageType switch
        {
            "Kim Cương" => "bi-gem",
            "Vàng" => "bi-star-fill",
            "Bạc" => "bi-shield-check",
            "Đồng" => "bi-award-fill",
            "Tin Thường" => "bi-box-seam",
            _ => "bi-rocket-takeoff"
        };
    }

    public string PackageShortText(string? packageType)
    {
        return packageType switch
        {
            "Kim Cương" => "Tự động duyệt tin mới",
            "Vàng" => "Ưu tiên hiển thị cao",
            "Bạc" => "Tăng khả năng tiếp cận",
            "Đồng" => "VIP cơ bản tiết kiệm",
            "Tin Thường" => "Phù hợp đăng cơ bản",
            _ => "Gói dịch vụ đăng tin"
        };
    }

    public string FormatMoney(decimal price)
    {
        if (price <= 0)
        {
            return "Miễn phí";
        }

        return price.ToString("N0") + " đ";
    }
}

